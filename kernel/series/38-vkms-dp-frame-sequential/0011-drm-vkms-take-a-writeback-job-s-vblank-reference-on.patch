@@ -509,7 +537,6 @@ static int vkms_stereo_test_check_update(struct kunit *test,
 	int ret;
 
 	fb = vkms_stereo_test_create_fb(test, width, height);
-	wb_fb = vkms_stereo_test_create_fb(test, wb_width, wb_height);
 
 	drm_modeset_acquire_init(&ctx, 0);
 
@@ -538,14 +565,17 @@ static int vkms_stereo_test_check_update(struct kunit *test,
 	plane_state->src_w = width << 16;
 	plane_state->src_h = height << 16;
 
-	wb_state = drm_atomic_get_connector_state(state, &priv->wb_connector->base);
-	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, wb_state);
-	ret = drm_atomic_set_crtc_for_connector(wb_state, priv->crtc);
-	KUNIT_ASSERT_EQ(test, ret, 0);
-	ret = drm_writeback_set_fb(wb_state, wb_fb);
-	KUNIT_ASSERT_EQ(test, ret, 0);
+	if (wb_width) {
+		wb_fb = vkms_stereo_test_create_fb(test, wb_width, wb_height);
+		wb_state = drm_atomic_get_connector_state(state, &priv->wb_connector->base);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, wb_state);
+		ret = drm_atomic_set_crtc_for_connector(wb_state, priv->crtc);
+		KUNIT_ASSERT_EQ(test, ret, 0);
+		ret = drm_writeback_set_fb(wb_state, wb_fb);
+		KUNIT_ASSERT_EQ(test, ret, 0);
+	}
 
-	ret = drm_atomic_check_only(state);
+	ret = commit ? drm_atomic_commit(state) : drm_atomic_check_only(state);
 
 	drm_modeset_drop_locks(&ctx);
 	drm_modeset_acquire_fini(&ctx);
@@ -553,6 +583,14 @@ static int vkms_stereo_test_check_update(struct kunit *test,
 	return ret;
 }
 
+static int vkms_stereo_test_check_update(struct kunit *test,
+					 const struct drm_display_mode *mode,
+					 int width, int height,
+					 int wb_width, int wb_height)
+{
+	return vkms_stereo_test_update(test, mode, width, height, wb_width, wb_height, false);
+}
+
 /*
  * The writeback connector takes a buffer of the frame size, so it receives
  * both eyes, and refuses any other size.
@@ -577,6 +615,106 @@ static void vkms_stereo_test_writeback_frame(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
 }
 
+/*
+ * A writeback job completes, whether the CRTC was off or already on when it
+ * was committed: the composer runs from the vblank timer, which has to be
+ * running for the job. A job is prepared before the CRTC is enabled, so it
+ * cannot take the vblank reference then.
+ */
+static bool vkms_stereo_test_writeback_done(struct kunit *test)
+{
+	struct vkms_stereo_test_priv *priv = test->priv;
+	unsigned long end = jiffies + 2 * HZ;
+	unsigned long flags;
+	bool empty = false;
+
+	while (!empty && time_before(jiffies, end)) {
+		spin_lock_irqsave(&priv->wb_connector->job_lock, flags);
+		empty = list_empty(&priv->wb_connector->job_queue);
+		spin_unlock_irqrestore(&priv->wb_connector->job_lock, flags);
+		if (!empty)
+			msleep(10);
+	}
+
+	return empty;
+}
+
+/* The job is cleaned up from a worker, which the device must outlive */
+static void vkms_stereo_test_writeback_cleaned(struct kunit *test)
+{
+	struct vkms_stereo_test_priv *priv = test->priv;
+	struct vkms_output *output = drm_crtc_to_vkms_output(priv->crtc);
+	unsigned long end = jiffies + 2 * HZ;
+	unsigned int users;
+
+	do {
+		spin_lock_irq(&output->lock);
+		users = output->composer_users;
+		spin_unlock_irq(&output->lock);
+		if (users)
+			msleep(10);
+	} while (users && time_before(jiffies, end));
+
+	KUNIT_EXPECT_EQ(test, users, 0);
+	msleep(10);
+}
+
+/* The planes keep their buffers mapped until they are disabled */
+static void vkms_stereo_test_disable_all(struct kunit *test)
+{
+	struct vkms_stereo_test_priv *priv = test->priv;
+	struct drm_modeset_acquire_ctx ctx;
+	int ret;
+
+	drm_modeset_acquire_init(&ctx, 0);
+	ret = drm_atomic_helper_disable_all(&priv->vkmsdev->drm, &ctx);
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+
+	KUNIT_EXPECT_EQ(test, ret, 0);
+}
+
+static void vkms_stereo_test_writeback_commit(struct kunit *test, bool crtc_on)
+{
+	const struct vkms_stereo_test_frame_case *t = test->param_value;
+	struct vkms_stereo_test_priv *priv = test->priv;
+	const struct drm_display_mode *mode;
+	int ret;
+
+	vkms_stereo_test_probe(test);
+
+	mode = vkms_stereo_test_find_mode(test, &t->mode);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+
+	if (crtc_on) {
+		ret = vkms_stereo_test_update(test, mode, t->width, t->height, 0, 0, true);
+		KUNIT_ASSERT_EQ(test, ret, 0);
+	}
+
+	ret = vkms_stereo_test_update(test, mode, t->width, t->height, t->width, t->height,
+				      true);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	if (!vkms_stereo_test_writeback_done(test)) {
+		KUNIT_FAIL(test, "the writeback job never completed");
+		/* Let the job go, or its buffer is still mapped when the test ends */
+		drm_writeback_signal_completion(priv->wb_connector, -ETIMEDOUT);
+	}
+
+	vkms_stereo_test_writeback_cleaned(test);
+	vkms_stereo_test_disable_all(test);
+}
+
+static void vkms_stereo_test_writeback_from_off(struct kunit *test)
+{
+	vkms_stereo_test_writeback_commit(test, false);
+}
+
+static void vkms_stereo_test_writeback_from_on(struct kunit *test)
+{
+	vkms_stereo_test_writeback_commit(test, true);
+}
+
 /*
  * The frame of each structure the 3D EDID above adds (HDMI 1.4a, Figures
  * H-2 to H-6): twice the lines for line alternative, one vtotal more for
@@ -615,6 +753,10 @@ static struct kunit_case vkms_stereo_test_cases[] = {
 	KUNIT_CASE(vkms_stereo_test_edid_modes),
 	KUNIT_CASE_PARAM(vkms_stereo_test_writeback_frame,
 			 vkms_stereo_test_frame_gen_params),
+	KUNIT_CASE_PARAM(vkms_stereo_test_writeback_from_off,
+			 vkms_stereo_test_frame_gen_params),
+	KUNIT_CASE_PARAM(vkms_stereo_test_writeback_from_on,
+			 vkms_stereo_test_frame_gen_params),
 	{}
 };
 
diff --git a/drivers/gpu/drm/vkms/vkms_composer.c b/drivers/gpu/drm/vkms/vkms_composer.c
index 5cee3d4..24fc21c 100644
--- a/drivers/gpu/drm/vkms/vkms_composer.c
+++ b/drivers/gpu/drm/vkms/vkms_composer.c
@@ -731,27 +731,39 @@ int vkms_verify_crc_source(struct drm_crtc *crtc, const char *src_name,
  * The composer runs while it has a user: the CRC source while it is set, and
  * each writeback job from its preparation to its cleanup. A job is cleaned up
  * after its completion is signalled, so the job of the next commit can be
- * prepared before the previous one is cleaned up: each user holds the composer
- * and a vblank reference of its own.
+ * prepared before the previous one is cleaned up: each user is counted on its
+ * own.
+ * Returns false when there was no user to remove.
  */
-void vkms_set_composer(struct vkms_output *out, bool enabled)
+bool vkms_composer_user(struct vkms_output *out, bool add)
 {
-	bool put = false;
-
-	if (enabled)
-		drm_crtc_vblank_get(&out->crtc);
+	bool ok = true;
 
 	spin_lock_irq(&out->lock);
-	if (enabled) {
+	if (add) {
 		out->composer_users++;
 	} else if (!WARN_ON(!out->composer_users)) {
 		out->composer_users--;
-		put = true;
+	} else {
+		ok = false;
 	}
 	out->composer_enabled = out->composer_users > 0;
 	spin_unlock_irq(&out->lock);
 
-	if (put)
+	return ok;
+}
+
+/*
+ * The CRC source is a composer user that holds a vblank reference of its own.
+ * A writeback job takes its reference when it is committed, see
+ * vkms_wb_atomic_commit().
+ */
+void vkms_set_composer(struct vkms_output *out, bool enabled)
+{
+	if (enabled)
+		drm_crtc_vblank_get(&out->crtc);
+
+	if (vkms_composer_user(out, enabled) && !enabled)
 		drm_crtc_vblank_put(&out->crtc);
 }
 
