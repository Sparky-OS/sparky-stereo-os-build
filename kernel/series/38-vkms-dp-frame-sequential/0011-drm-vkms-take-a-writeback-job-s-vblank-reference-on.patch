+	vkms_composer_user(vkms_output, false);
 	kfree(vkmsjob);
 }
 
@@ -145,6 +148,7 @@ static void vkms_wb_atomic_commit(struct drm_connector *conn,
 	struct vkms_frame_info *wb_frame_info;
 	u32 wb_format = fb->format->format;
 	int crtc_width, crtc_height;
+	int ret;
 
 	if (!conn_state)
 		return;
@@ -154,6 +158,21 @@ static void vkms_wb_atomic_commit(struct drm_connector *conn,
 	active_wb = conn_state->writeback_job->priv;
 	wb_frame_info = &active_wb->wb_frame_info;
 
+	/*
+	 * The composer runs from the vblank timer, which runs while the vblank
+	 * has a reference. A job is prepared before the CRTC is enabled, when
+	 * its vblank cannot be referenced yet, so the reference is taken here,
+	 * once the CRTC is on, and released by vkms_wb_cleanup_job().
+	 */
+	ret = drm_crtc_vblank_get(&output->crtc);
+	if (ret) {
+		drm_err(output->crtc.dev, "No vblank for the writeback job: %d\n", ret);
+		drm_writeback_queue_job(wb_conn, connector_state);
+		drm_writeback_signal_completion(wb_conn, ret);
+		return;
+	}
+	active_wb->vblank_held = true;
+
 	spin_lock_irq(&output->composer_lock);
 	crtc_state->active_writeback = active_wb;
 	crtc_state->wb_pending = true;
