From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Egorov <begeebe@gmail.com>
Date: Tue, 28 Jul 2026 11:35:28 +0300
Subject: platform/x86: oxpec: Distinguish OneXPlayer Super X board

The Super X currently shares the oxp_g1_a board identifier because its
existing EC functionality matches the G1 AMD.

Give it a dedicated identifier so model-specific functionality can be
selected without also enabling it on the G1. Preserve the existing G1
AMD behavior for the new identifier.

Assisted-by: Codex:gpt-5.6
Signed-off-by: Alexander Egorov <begeebe@gmail.com>
(cherry picked from commit 7da0102aed5cd28c6a3eca6e0595aeedcfa2f8b9)

OGC-tag: FROM-ML
[ORDER 636: ported to v7.3.4: upstream 8b6c2c832 ("platform/x86: oxpec: Fix Apex charge limit control", Antheas Kapenekakis, 7.3.2) added the board oxp_apex and a "case oxp_apex:" after each "case oxp_g1_a:"; the port keeps this patch's rule, oxp_super_x at the end of the enum and "case oxp_super_x:" right after each of the ten "case oxp_g1_a:", so the Super X still behaves as the G1 AMD; the Apex-only charge cases are not G1 ones and get none. The changed lines are the original ones, only their context moved.]
---
--- a/drivers/platform/x86/oxpec.c
+++ b/drivers/platform/x86/oxpec.c
@@ -51,6 +51,7 @@
 	oxp_g1_i,
 	oxp_g1_a,
 	oxp_apex,
+	oxp_super_x,
 };
 
 static enum oxp_board board;
@@ -214,7 +215,7 @@
 			DMI_MATCH(DMI_BOARD_VENDOR, "ONE-NETBOOK"),
 			DMI_EXACT_MATCH(DMI_BOARD_NAME, "ONEXPLAYER SUPER X"),
 		},
-		.driver_data = (void *)oxp_g1_a,
+		.driver_data = (void *)oxp_super_x,
 	},
 	{
 		.matches = {
@@ -356,6 +357,7 @@
 	case oxp_x1:
 	case oxp_g1_i:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		return attr->mode;
 	default:
@@ -386,6 +388,7 @@
 	case oxp_fly:
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		reg = OXP_TURBO_SWITCH_REG;
 		mask = OXP_TURBO_TAKE_VAL;
@@ -433,6 +436,7 @@
 	case oxp_fly:
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		reg = OXP_TURBO_SWITCH_REG;
 		mask = OXP_TURBO_TAKE_VAL;
@@ -530,6 +534,7 @@
 	case oxp_x1:
 	case oxp_g1_i:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_fly:
 	case oxp_apex:
 		return true;
@@ -688,6 +693,7 @@
 	case oxp_x1:
 	case oxp_g1_i:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		return write_to_ec(OXP_SENSOR_PWM_ENABLE_REG, PWM_MODE_MANUAL);
 	default:
@@ -709,6 +715,7 @@
 	case oxp_x1:
 	case oxp_g1_i:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		return write_to_ec(OXP_SENSOR_PWM_ENABLE_REG, PWM_MODE_AUTO);
 	default:
@@ -730,6 +737,7 @@
 	case oxp_x1:
 	case oxp_g1_i:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		return read_from_ec(OXP_SENSOR_PWM_ENABLE_REG, 1, val);
 	default:
@@ -767,6 +775,7 @@
 	case oxp_mini_amd_a07:
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		return read_from_ec(OXP_SENSOR_FAN_REG, 2, val);
 	default:
@@ -800,6 +809,7 @@
 	case oxp_fly:
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 		return write_to_ec(OXP_SENSOR_PWM_REG, val);
 	default:
@@ -840,6 +850,7 @@
 	case oxp_fly:
 	case oxp_mini_amd_pro:
 	case oxp_g1_a:
+	case oxp_super_x:
 	case oxp_apex:
 	default:
 		ret = read_from_ec(OXP_SENSOR_PWM_REG, 1, val);
