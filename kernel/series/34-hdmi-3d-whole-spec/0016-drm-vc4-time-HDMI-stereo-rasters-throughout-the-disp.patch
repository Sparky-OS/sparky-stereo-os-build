--- /dev/null
+++ b/drivers/gpu/drm/vc4/tests/vc4_test_hdmi_stereo.c
@@ -0,0 +1,343 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <drm/drm_edid.h>
+#include <drm/drm_kunit_helpers.h>
+#include <drm/display/drm_hdmi_helper.h>
+#include <kunit/test.h>
+
+#include "../vc4_hdmi.h"
+
+struct vc4_stereo_case {
+	const char *name;
+	unsigned int vic;
+	u32 layout;
+	enum vc4_gen gen;
+	bool keep_blanking;
+	int error;
+	int clock;
+	int h[4];
+	int v[4];
+};
+
+/* CTA timings and HDMI 1.4b 8.2.3.2 / Appendix H, not helper-derived values. */
+static const struct vc4_stereo_case vc4_stereo_cases[] = {
+	{ "2d-1080p60", 16, 0, VC4_GEN_5, false, 0,
+	  148500, { 1920, 2008, 2052, 2200 }, { 1080, 1084, 1089, 1125 } },
+	{ "2d-1080i60", 5, 0, VC4_GEN_5, false, 0,
+	  74250, { 1920, 2008, 2052, 2200 }, { 540, 542, 547, 562 } },
+	{ "frame-packing-1080p24-vc4", 32, DRM_MODE_FLAG_3D_FRAME_PACKING,
+	  VC4_GEN_4, false, 0,
+	  148500, { 1920, 2558, 2602, 2750 }, { 2205, 2209, 2214, 2250 } },
+	{ "frame-packing-720p60", 4, DRM_MODE_FLAG_3D_FRAME_PACKING,
+	  VC4_GEN_5, false, 0,
+	  148500, { 1280, 1390, 1430, 1650 }, { 1470, 1475, 1480, 1500 } },
+	{ "frame-packing-720p50", 19, DRM_MODE_FLAG_3D_FRAME_PACKING,
+	  VC4_GEN_5, false, 0,
+	  148500, { 1280, 1720, 1760, 1980 }, { 1470, 1475, 1480, 1500 } },
+	{ "line-alternative", 16, DRM_MODE_FLAG_3D_LINE_ALTERNATIVE,
+	  VC4_GEN_5, false, 0,
+	  297000, { 1920, 2008, 2052, 2200 }, { 2160, 2168, 2178, 2250 } },
+	{ "sbs-full", 16, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL,
+	  VC4_GEN_5, false, 0,
+	  297000, { 3840, 4016, 4104, 4400 }, { 1080, 1084, 1089, 1125 } },
+	{ "sbs-full-keep-blanking", 16, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL,
+	  VC4_GEN_5, true, 0,
+	  278100, { 3840, 3928, 3972, 4120 }, { 1080, 1084, 1089, 1125 } },
+	{ "sbs-full-interlace", 5, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL,
+	  VC4_GEN_5, false, 0,
+	  148500, { 3840, 4016, 4104, 4400 }, { 540, 542, 547, 562 } },
+	{ "l-depth", 19, DRM_MODE_FLAG_3D_L_DEPTH,
+	  VC4_GEN_5, false, 0,
+	  148500, { 1280, 1720, 1760, 1980 }, { 1470, 1475, 1480, 1500 } },
+	{ "l-depth-gfx", 19, DRM_MODE_FLAG_3D_L_DEPTH_GFX_GFX_DEPTH,
+	  VC4_GEN_5, false, 0,
+	  297000, { 1280, 1720, 1760, 1980 }, { 2970, 2975, 2980, 3000 } },
+	{ "top-bottom", 16, DRM_MODE_FLAG_3D_TOP_AND_BOTTOM,
+	  VC4_GEN_5, false, 0,
+	  148500, { 1920, 2008, 2052, 2200 }, { 1080, 1084, 1089, 1125 } },
+	{ "sbs-half-interlace", 5, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF,
+	  VC4_GEN_5, false, 0,
+	  74250, { 1920, 2008, 2052, 2200 }, { 540, 542, 547, 562 } },
+	{ "vc6-frame-packing", 32, DRM_MODE_FLAG_3D_FRAME_PACKING,
+	  VC4_GEN_6_C, false, 0,
+	  148500, { 1920, 2558, 2602, 2750 }, { 2205, 2209, 2214, 2250 } },
+	{ "vc6d-sbs", 16, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL,
+	  VC4_GEN_6_D, true, 0,
+	  278100, { 3840, 3928, 3972, 4120 }, { 1080, 1084, 1089, 1125 } },
+	{ "field-alternative-needs-blanking", 5, DRM_MODE_FLAG_3D_FIELD_ALTERNATIVE,
+	  VC4_GEN_5, false, -EINVAL },
+	{ "interlaced-frame-packing-needs-frame-sync", 5, DRM_MODE_FLAG_3D_FRAME_PACKING,
+	  VC4_GEN_5, false, -EINVAL },
+	{ "invalid-progressive-field-alternative", 16, DRM_MODE_FLAG_3D_FIELD_ALTERNATIVE,
+	  VC4_GEN_5, false, -EINVAL },
+	{ "invalid-interlaced-line-alternative", 5, DRM_MODE_FLAG_3D_LINE_ALTERNATIVE,
+	  VC4_GEN_5, false, -EINVAL },
+	{ "invalid-interlaced-depth", 5, DRM_MODE_FLAG_3D_L_DEPTH,
+	  VC4_GEN_5, false, -EINVAL },
+	{ "invalid-interlaced-gfx", 5, DRM_MODE_FLAG_3D_L_DEPTH_GFX_GFX_DEPTH,
+	  VC4_GEN_5, false, -EINVAL },
+	{ "vc4-hvs-height-overflow", 32, DRM_MODE_FLAG_3D_L_DEPTH_GFX_GFX_DEPTH,
+	  VC4_GEN_4, false, -EINVAL },
+};
+
+static void vc4_stereo_desc(const struct vc4_stereo_case *t, char *desc)
+{
+	strscpy(desc, t->name, KUNIT_PARAM_DESC_SIZE);
+}
+
+KUNIT_ARRAY_PARAM(vc4_stereo, vc4_stereo_cases, vc4_stereo_desc);
+
+struct vc4_stereo_priv {
+	struct vc4_dev *vc4;
+	struct vc4_hdmi *hdmi;
+	struct vc4_hdmi_variant variant;
+	struct drm_crtc_state crtc;
+	struct drm_connector_state conn;
+};
+
+static int vc4_stereo_init(struct kunit *test)
+{
+	struct vc4_stereo_priv *priv;
+	struct device *dev;
+
+	priv = kunit_kzalloc(test, sizeof(*priv), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	priv->vc4 = drm_kunit_helper_alloc_drm_device(test, dev,
+						      struct vc4_dev, base, DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv->vc4);
+	priv->hdmi = kunit_kzalloc(test, sizeof(*priv->hdmi), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, priv->hdmi);
+	priv->hdmi->variant = &priv->variant;
+	priv->hdmi->encoder.base.dev = &priv->vc4->base;
+	test->priv = priv;
+	return 0;
+}
+
+static void vc4_test_hdmi_stereo(struct kunit *test)
+{
+	struct vc4_stereo_priv *priv = test->priv;
+	const struct vc4_stereo_case *t = test->param_value;
+	struct drm_display_mode *mode, *adjusted = &priv->crtc.adjusted_mode;
+	unsigned long long rate;
+	int ret, i, adjust_flags;
+
+	priv->vc4->gen = t->gen;
+	priv->variant.unsupported_odd_h_timings = t->gen == VC4_GEN_5;
+	priv->conn.hdmi.sbs_full_timing = t->keep_blanking ?
+		DRM_HDMI_SBS_FULL_TIMING_KEEP_BLANKING : DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE;
+	adjust_flags = drm_connector_stereo_crtc_flags(&priv->conn);
+	mode = drm_display_mode_from_cea_vic(&priv->vc4->base, t->vic);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	KUNIT_ASSERT_EQ(test, drm_kunit_add_mode_destroy_action(test, mode), 0);
+	mode->flags |= t->layout;
+	drm_mode_set_crtcinfo(mode, CRTC_INTERLACE_HALVE_V);
+	drm_mode_copy(adjusted, mode);
+
+	/* The real encoder check must also be safe when atomic checks repeat. */
+	for (i = 0; i < 2; i++) {
+		ret = vc4_hdmi_encoder_atomic_check(&priv->hdmi->encoder.base,
+						    &priv->crtc, &priv->conn);
+		KUNIT_ASSERT_EQ(test, ret, t->error);
+		if (ret)
+			return;
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_clock, t->clock);
+		rate = drm_hdmi_compute_stereo_mode_clock(adjusted, 8,
+							  DRM_OUTPUT_COLOR_FORMAT_RGB444,
+							  adjust_flags);
+		KUNIT_EXPECT_EQ(test, rate, t->clock * 1000ULL);
+		rate = drm_hdmi_compute_stereo_mode_clock(adjusted, 12,
+							  DRM_OUTPUT_COLOR_FORMAT_RGB444,
+							  adjust_flags);
+		KUNIT_EXPECT_EQ(test, rate, t->clock * 1500ULL);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_hdisplay, t->h[0]);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_hsync_start, t->h[1]);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_hsync_end, t->h[2]);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_htotal, t->h[3]);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_vdisplay, t->v[0]);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_vsync_start, t->v[1]);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_vsync_end, t->v[2]);
+		KUNIT_EXPECT_EQ(test, adjusted->crtc_vtotal, t->v[3]);
+		/* AVI/VSIF must still identify the original VIC and structure. */
+		KUNIT_EXPECT_EQ(test, drm_match_cea_mode(adjusted), t->vic);
+		KUNIT_EXPECT_EQ(test, adjusted->flags, mode->flags);
+		KUNIT_EXPECT_EQ(test, adjusted->clock, mode->clock);
+		KUNIT_EXPECT_EQ(test, adjusted->hdisplay, mode->hdisplay);
+		KUNIT_EXPECT_EQ(test, adjusted->vdisplay, mode->vdisplay);
+	}
+}
+
+enum vc4_stereo_mutation {
+	CLOCK_OVERFLOW, HTOTAL_OVERFLOW, VTOTAL_OVERFLOW, HVS_WIDTH,
+	HFRONT, HSYNC, HBACK, VFRONT, VSYNC, VBACK, ODD_HSYNC,
+	DOUBLESCAN, VSCAN, RESERVED, MARGINS, EMPTY_ACTIVE, REVERSED_SYNC,
+};
+
+struct vc4_stereo_limit {
+	const char *name;
+	enum vc4_stereo_mutation mutation;
+	enum vc4_gen gen;
+	bool keep_blanking;
+	int error;
+};
+
+static const struct vc4_stereo_limit vc4_stereo_limits[] = {
+	{ "clock-overflow", CLOCK_OVERFLOW, VC4_GEN_5, false, -EINVAL },
+	{ "htotal-overflow", HTOTAL_OVERFLOW, VC4_GEN_5, false, -EINVAL },
+	{ "vtotal-overflow", VTOTAL_OVERFLOW, VC4_GEN_5, false, -EINVAL },
+	{ "hvs5-width-limit", HVS_WIDTH, VC4_GEN_5, false, -EINVAL },
+	{ "hvs6-width-limit", HVS_WIDTH, VC4_GEN_6_C, false, 0 },
+	{ "hdmi4-front-limit", HFRONT, VC4_GEN_4, false, -EINVAL },
+	{ "hdmi5-front-fits", HFRONT, VC4_GEN_5, false, 0 },
+	{ "hdmi5-sync-limit", HSYNC, VC4_GEN_5, false, -EINVAL },
+	{ "hdmi4-back-limit", HBACK, VC4_GEN_4, false, -EINVAL },
+	{ "hdmi5-back-fits", HBACK, VC4_GEN_5, false, 0 },
+	{ "vertical-front-limit", VFRONT, VC4_GEN_5, false, -EINVAL },
+	{ "vertical-sync-limit", VSYNC, VC4_GEN_5, false, -EINVAL },
+	{ "vertical-back-limit", VBACK, VC4_GEN_5, false, -EINVAL },
+	{ "odd-sync-doubled-fits", ODD_HSYNC, VC4_GEN_5, false, 0 },
+	{ "odd-sync-kept-rejected", ODD_HSYNC, VC4_GEN_5, true, -EINVAL },
+	{ "doublescan-rejected", DOUBLESCAN, VC4_GEN_5, false, -EINVAL },
+	{ "vscan-rejected", VSCAN, VC4_GEN_5, false, -EINVAL },
+	{ "reserved-layout", RESERVED, VC4_GEN_5, false, -EINVAL },
+	{ "packed-frame-margins", MARGINS, VC4_GEN_5, false, -EINVAL },
+	{ "empty-active", EMPTY_ACTIVE, VC4_GEN_5, false, -EINVAL },
+	{ "reversed-sync", REVERSED_SYNC, VC4_GEN_5, false, -EINVAL },
+};
+
+static void vc4_stereo_limit_desc(const struct vc4_stereo_limit *t, char *desc)
+{
+	strscpy(desc, t->name, KUNIT_PARAM_DESC_SIZE);
+}
+
+KUNIT_ARRAY_PARAM(vc4_stereo_limit, vc4_stereo_limits, vc4_stereo_limit_desc);
+
+static void vc4_test_hdmi_stereo_limits(struct kunit *test)
+{
+	struct vc4_stereo_priv *priv = test->priv;
+	const struct vc4_stereo_limit *t = test->param_value;
+	struct drm_display_mode *mode;
+
+	priv->vc4->gen = t->gen;
+	priv->variant.unsupported_odd_h_timings = t->gen == VC4_GEN_5;
+	priv->conn.hdmi.sbs_full_timing = t->keep_blanking ?
+		DRM_HDMI_SBS_FULL_TIMING_KEEP_BLANKING : DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE;
+	mode = drm_display_mode_from_cea_vic(&priv->vc4->base, 16);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	KUNIT_ASSERT_EQ(test, drm_kunit_add_mode_destroy_action(test, mode), 0);
+	mode->flags |= DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL;
+	switch (t->mutation) {
+	case CLOCK_OVERFLOW:
+		mode->clock = INT_MAX / 2 + 1;
+		break;
+	case HTOTAL_OVERFLOW:
+		mode->htotal = 40000;
+		break;
+	case VTOTAL_OVERFLOW:
+		mode->vtotal = 20000;
+		break;
+	case HVS_WIDTH:
+		mode->hdisplay = 4096;
+		mode->hsync_start = 4104;
+		mode->hsync_end = 4120;
+		mode->htotal = 4140;
+		break;
+	case HFRONT:
+		mode->hsync_start = 2520;
+		mode->hsync_end = 2564;
+		mode->htotal = 2712;
+		break;
+	case HSYNC:
+		mode->hsync_end = 3108;
+		mode->htotal = 3256;
+		break;
+	case HBACK:
+		mode->htotal = 2652;
+		break;
+	case VFRONT:
+		mode->vsync_start = 1210;
+		mode->vsync_end = 1215;
+		mode->vtotal = 1250;
+		break;
+	case VSYNC:
+		mode->vsync_end = 1120;
+		mode->vtotal = 1150;
+		break;
+	case VBACK:
+		mode->vtotal = 1601;
+		break;
+	case ODD_HSYNC:
+		mode->hsync_end++;
+		break;
+	case DOUBLESCAN:
+		mode->flags |= DRM_MODE_FLAG_DBLSCAN;
+		break;
+	case VSCAN:
+		mode->vscan = 2;
+		break;
+	case RESERVED:
+		mode->flags |= DRM_MODE_FLAG_3D_MASK;
+		break;
+	case MARGINS:
+		priv->conn.tv.margins.left = 1;
+		break;
+	case EMPTY_ACTIVE:
+		mode->hdisplay = 0;
+		break;
+	case REVERSED_SYNC:
+		mode->hsync_end = mode->hsync_start - 1;
+		break;
+	}
+	drm_mode_copy(&priv->crtc.adjusted_mode, mode);
+	KUNIT_EXPECT_EQ(test, vc4_hdmi_encoder_atomic_check(&priv->hdmi->encoder.base,
+							    &priv->crtc, &priv->conn), t->error);
+}
+
+static void vc4_test_hdmi_stereo_dblclk(struct kunit *test)
+{
+	struct vc4_stereo_priv *priv = test->priv;
+	struct drm_display_mode *mode, *adjusted = &priv->crtc.adjusted_mode;
+	unsigned long long rate;
+
+	priv->vc4->gen = VC4_GEN_5;
+	priv->variant.unsupported_odd_h_timings = true;
+	mode = drm_display_mode_from_cea_vic(&priv->vc4->base, 6);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	KUNIT_ASSERT_EQ(test, drm_kunit_add_mode_destroy_action(test, mode), 0);
+	drm_mode_set_crtcinfo(mode, CRTC_INTERLACE_HALVE_V);
+	drm_mode_copy(adjusted, mode);
+	KUNIT_ASSERT_EQ(test, vc4_hdmi_encoder_atomic_check(&priv->hdmi->encoder.base,
+							    &priv->crtc, &priv->conn), 0);
+	/* Keep the existing 2D DBLCLK porch correction. */
+	KUNIT_EXPECT_EQ(test, adjusted->hsync_start, 738);
+	KUNIT_EXPECT_EQ(test, adjusted->hsync_end, 800);
+	KUNIT_EXPECT_EQ(test, adjusted->crtc_hsync_start, mode->crtc_hsync_start);
+
+	drm_mode_copy(adjusted, mode);
+	adjusted->flags |= DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF;
+	KUNIT_ASSERT_EQ(test, vc4_hdmi_encoder_atomic_check(&priv->hdmi->encoder.base,
+							    &priv->crtc, &priv->conn), 0);
+	KUNIT_EXPECT_EQ(test, adjusted->crtc_hsync_start, 738);
+	KUNIT_EXPECT_EQ(test, adjusted->crtc_hsync_end, 800);
+	KUNIT_EXPECT_EQ(test, adjusted->crtc_vdisplay, 240);
+	KUNIT_EXPECT_EQ(test, adjusted->crtc_clock, 13500);
+	rate = drm_hdmi_compute_stereo_mode_clock(adjusted, 8,
+						  DRM_OUTPUT_COLOR_FORMAT_RGB444, 0);
+	KUNIT_EXPECT_EQ(test, rate, 27000000ULL);
+}
+
+static struct kunit_case vc4_hdmi_stereo_tests[] = {
+	KUNIT_CASE_PARAM(vc4_test_hdmi_stereo, vc4_stereo_gen_params),
+	KUNIT_CASE_PARAM(vc4_test_hdmi_stereo_limits, vc4_stereo_limit_gen_params),
+	KUNIT_CASE(vc4_test_hdmi_stereo_dblclk),
+	{}
+};
+
+static struct kunit_suite vc4_hdmi_stereo_suite = {
+	.name = "vc4-hdmi-stereo",
+	.init = vc4_stereo_init,
+	.test_cases = vc4_hdmi_stereo_tests,
+};
+
+kunit_test_suite(vc4_hdmi_stereo_suite);
diff --git a/drivers/gpu/drm/vc4/vc4_crtc.c b/drivers/gpu/drm/vc4/vc4_crtc.c
index 4572b0b..cfa8290 100644
--- a/drivers/gpu/drm/vc4/vc4_crtc.c
+++ b/drivers/gpu/drm/vc4/vc4_crtc.c
@@ -194,7 +194,8 @@ static bool vc4_crtc_get_scanout_position(struct drm_crtc *crtc,
 	 * We can't get meaningful readings wrt. scanline position of the PV
 	 * and need to make things up in a approximative but consistent way.
 	 */
-	vblank_lines = mode->vtotal - mode->vdisplay;
+	vblank_lines = drm_mode_is_stereo(mode) ?
+		mode->crtc_vtotal - mode->crtc_vdisplay : mode->vtotal - mode->vdisplay;
 
 	if (in_vblank_irq) {
 		/*
@@ -352,6 +353,10 @@ static void vc4_crtc_config_pv(struct drm_crtc *crtc, struct drm_encoder *encode
 	const struct vc4_pv_data *pv_data = vc4_crtc_to_vc4_pv_data(vc4_crtc);
 	struct drm_crtc_state *crtc_state = crtc->state;
 	struct drm_display_mode *mode = &crtc_state->adjusted_mode;
+	u32 hdisplay = drm_mode_is_stereo(mode) ? mode->crtc_hdisplay : mode->hdisplay;
+	u32 hsync_start = drm_mode_is_stereo(mode) ? mode->crtc_hsync_start : mode->hsync_start;
+	u32 hsync_end = drm_mode_is_stereo(mode) ? mode->crtc_hsync_end : mode->hsync_end;
+	u32 htotal = drm_mode_is_stereo(mode) ? mode->crtc_htotal : mode->htotal;
 	bool interlace = mode->flags & DRM_MODE_FLAG_INTERLACE;
 	bool is_hdmi = vc4_encoder->type == VC4_ENCODER_TYPE_HDMI0 ||
 		       vc4_encoder->type == VC4_ENCODER_TYPE_HDMI1;
@@ -383,27 +388,27 @@ static void vc4_crtc_config_pv(struct drm_crtc *crtc, struct drm_encoder *encode
 	vc4_crtc_pixelvalve_reset(crtc);
 
 	CRTC_WRITE(PV_HORZA,
-		   VC4_SET_FIELD((mode->htotal - mode->hsync_end) * pixel_rep / ppc,
+		   VC4_SET_FIELD((htotal - hsync_end) * pixel_rep / ppc,
 				 PV_HORZA_HBP) |
-		   VC4_SET_FIELD((mode->hsync_end - mode->hsync_start) * pixel_rep / ppc,
+		   VC4_SET_FIELD((hsync_end - hsync_start) * pixel_rep / ppc,
