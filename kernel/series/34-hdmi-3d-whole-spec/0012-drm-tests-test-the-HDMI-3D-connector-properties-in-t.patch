From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Fri, 16 Oct 2026 08:09:16 -0300
Subject: [PATCH] drm/tests: test the HDMI 3D connector properties in the HDMI
 state helper

A change of the side by side (full) timing is a mode change, and gives
CRTC_STEREO_KEEP_HBLANK to the connector's and the CRTC's stereo flags.
The 3D metadata property reaches the vendor InfoFrame of an L + depth
mode, and is not sent with a 2D mode.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 .../drm/tests/drm_hdmi_state_helper_test.c    | 205 ++++++++++++++++++
 1 file changed, 205 insertions(+)

diff --git a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
index 353a261d42..c54c938e47 100644
--- a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
+++ b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
@@ -389,6 +389,208 @@ static void drm_test_check_broadcast_rgb_crtc_mode_changed(struct kunit *test)
 	drm_modeset_acquire_fini(&ctx);
 }
 
+/*
+ * Test that if we change how side by side (full) is timed, we trigger a
+ * mode change on the connector's CRTC: the timing is the mode's.
+ */
+static void drm_test_check_sbs_full_timing_crtc_mode_changed(struct kunit *test)
+{
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *old_conn_state;
+	struct drm_connector_state *new_conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_atomic_commit *state;
+	struct drm_display_mode *preferred;
+	struct drm_connector *conn;
+	struct drm_device *drm;
+	struct drm_crtc *crtc;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init(test,
+						    BIT(DRM_OUTPUT_COLOR_FORMAT_RGB444),
+						    8);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	crtc = priv->crtc;
+	conn = &priv->connector;
+
+	preferred = find_preferred_mode(conn);
+	KUNIT_ASSERT_NOT_NULL(test, preferred);
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+retry_conn_enable:
+	ret = drm_kunit_helper_enable_crtc_connector(test, drm,
+						     crtc, conn,
+						     preferred,
+						     &ctx);
+	if (ret == -EDEADLK) {
+		ret = drm_modeset_backoff(&ctx);
+		if (!ret)
+			goto retry_conn_enable;
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	new_conn_state = drm_atomic_get_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, new_conn_state);
+
+	old_conn_state = drm_atomic_get_old_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, old_conn_state);
+
+	new_conn_state->hdmi.sbs_full_timing = DRM_HDMI_SBS_FULL_TIMING_KEEP_BLANKING;
+
+	KUNIT_ASSERT_NE(test,
+			old_conn_state->hdmi.sbs_full_timing,
+			new_conn_state->hdmi.sbs_full_timing);
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	new_conn_state = drm_atomic_get_new_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, new_conn_state);
+	KUNIT_EXPECT_EQ(test, drm_connector_stereo_crtc_flags(new_conn_state),
+			CRTC_STEREO_KEEP_HBLANK);
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, crtc_state);
+	KUNIT_EXPECT_TRUE(test, crtc_state->mode_changed);
+	KUNIT_EXPECT_EQ(test, drm_atomic_crtc_stereo_flags(crtc_state),
+			CRTC_STEREO_KEEP_HBLANK);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+static struct drm_display_mode *find_mode(struct drm_connector *connector,
+					  int hdisplay, int vdisplay)
+{
+	struct drm_display_mode *mode;
+
+	list_for_each_entry(mode, &connector->modes, head)
+		if (mode->hdisplay == hdisplay && mode->vdisplay == vdisplay)
+			return mode;
+
+	return NULL;
+}
+
+/*
+ * Parallax information as ISO/IEC 23002-3 orders it (parallax_zero 128,
+ * parallax_scale 256, dref 200 cm, wref 100 cm), the value of the "HDMI 3D
+ * metadata" property.
+ */
+static const struct drm_hdmi_3d_metadata test_hdmi_3d_parallax = {
+	.type = HDMI_3D_METADATA_PARALLAX,
+	.length = HDMI_3D_METADATA_PARALLAX_SIZE,
+	.data = { 0x00, 0x80, 0x01, 0x00, 0x00, 0xc8, 0x00, 0x64 },
+};
+
+/*
+ * The sink sets HDMI_Video_present, so it takes HDMI vendor InfoFrames
+ * (drm_parse_hdmi_vsdb_video()).
+ */
+static void hdmi_3d_metadata_check(struct kunit *test, u32 layout,
+				   bool expect_meta)
+{
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *conn_state;
+	struct hdmi_vendor_infoframe *frame;
+	struct drm_property_blob *blob;
+	struct drm_atomic_commit *state;
+	struct drm_display_mode *mode;
+	struct drm_connector *conn;
+	struct drm_device *drm;
+	struct drm_crtc *crtc;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init_with_edid_funcs(test,
+				BIT(DRM_OUTPUT_COLOR_FORMAT_RGB444),
+				8,
+				&dummy_connector_hdmi_funcs,
+				test_edid_hdmi_1080p_rgb_yuv_4k_yuv420_dc_max_200mhz);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	crtc = priv->crtc;
+	conn = &priv->connector;
+	KUNIT_ASSERT_TRUE(test, conn->display_info.has_hdmi_infoframe);
+
+	/*
+	 * 640x480: its 3D frame fits the sink's TMDS rate in every 3D
+	 * structure (L + depth doubles the 25.2 MHz pixel clock).
+	 */
+	mode = drm_mode_duplicate(drm, find_mode(conn, 640, 480));
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	mode->flags |= layout;
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+retry_conn_enable:
+	ret = drm_kunit_helper_enable_crtc_connector(test, drm,
+						     crtc, conn,
+						     mode,
+						     &ctx);
+	if (ret == -EDEADLK) {
+		ret = drm_modeset_backoff(&ctx);
+		if (!ret)
+			goto retry_conn_enable;
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	state = drm_kunit_helper_atomic_state_alloc(test, drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+
+	conn_state = drm_atomic_get_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn_state);
+
+	blob = drm_property_create_blob(drm, sizeof(test_hdmi_3d_parallax),
+					&test_hdmi_3d_parallax);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, blob);
+	drm_property_replace_blob(&conn_state->hdmi.s3d_metadata, blob);
+	drm_property_blob_put(blob);
+
+	ret = drm_atomic_check_only(state);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	conn_state = drm_atomic_get_new_connector_state(state, conn);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn_state);
+	KUNIT_ASSERT_TRUE(test, conn_state->hdmi.infoframes.hdmi.set);
+
+	frame = &conn_state->hdmi.infoframes.hdmi.data.vendor.hdmi;
+	KUNIT_EXPECT_EQ(test, frame->s3d_meta_present, expect_meta);
+	if (expect_meta) {
+		KUNIT_EXPECT_EQ(test, frame->s3d_meta_type, HDMI_3D_METADATA_PARALLAX);
+		KUNIT_EXPECT_EQ(test, frame->s3d_meta_length,
+				HDMI_3D_METADATA_PARALLAX_SIZE);
+		KUNIT_EXPECT_MEMEQ(test, frame->s3d_meta, test_hdmi_3d_parallax.data,
+				   HDMI_3D_METADATA_PARALLAX_SIZE);
+		KUNIT_EXPECT_EQ(test, frame->length, 5 + 1 + HDMI_3D_METADATA_PARALLAX_SIZE);
+	}
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+/*
+ * Test that the "HDMI 3D metadata" property reaches the vendor InfoFrame
+ * of an L + depth mode (HDMI 1.4a, Appendix H, Table H-1).
+ */
+static void drm_test_check_3d_metadata_l_depth(struct kunit *test)
+{
+	hdmi_3d_metadata_check(test, DRM_MODE_FLAG_3D_L_DEPTH, true);
+}
+
+/* and is not sent with a 2D mode */
+static void drm_test_check_3d_metadata_2d(struct kunit *test)
+{
+	hdmi_3d_metadata_check(test, 0, false);
+}
+
 /*
  * Test that if we set the RGB quantization property to the same value,
  * we don't trigger a mode change on the connector's CRTC and leave the
@@ -2457,6 +2659,9 @@ static struct kunit_case drm_atomic_helper_connector_hdmi_check_tests[] = {
 	KUNIT_CASE_PARAM(drm_test_check_broadcast_rgb_cea_mode_yuv420,
 			 check_broadcast_rgb_cea_mode_yuv420_gen_params),
 	KUNIT_CASE(drm_test_check_broadcast_rgb_crtc_mode_changed),
+	KUNIT_CASE(drm_test_check_sbs_full_timing_crtc_mode_changed),
+	KUNIT_CASE(drm_test_check_3d_metadata_l_depth),
+	KUNIT_CASE(drm_test_check_3d_metadata_2d),
 	KUNIT_CASE(drm_test_check_broadcast_rgb_crtc_mode_not_changed),
 	KUNIT_CASE(drm_test_check_disable_connector),
 	KUNIT_CASE(drm_test_check_hdmi_funcs_reject_rate),
-- 
2.53.0

