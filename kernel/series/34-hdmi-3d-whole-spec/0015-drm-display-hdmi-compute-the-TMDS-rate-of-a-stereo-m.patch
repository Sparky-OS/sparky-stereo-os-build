From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Fri, 16 Oct 2026 09:36:29 -0300
Subject: [PATCH] drm/display/hdmi: compute the TMDS rate of a stereo mode from
 its 3D frame

drm_hdmi_compute_mode_clock() started from mode->clock, the pixel clock
of one picture. A stereo mode is sent at the pixel clock of its whole 3D
frame (HDMI 1.4a, section 8.2.3.2 and Appendix H): twice the 2D pixel
clock for frame packing, field alternative, line alternative, side by
side (full) and L + depth, four times for L + depth + graphics +
graphics-depth. The HDMI state helper therefore programmed half the TMDS
character rate those modes need, and drm_hdmi_connector_mode_valid()
accepted modes whose 3D frame the sink or the source cannot carry.

Add drm_hdmi_compute_stereo_mode_clock(), which starts from the 3D frame
as drm_mode_set_crtcinfo() times it, with the connector's side by side
(full) timing among the adjust flags; the helper's rules for 4:2:2,
4:2:0, double clock and bits per component apply on top as before.
drm_hdmi_compute_mode_clock() is its case with the specification's
timing. The state helper passes drm_connector_stereo_crtc_flags() of the
connector state.

Only stereo modes change, so only drivers that allow them and use these
helpers do: of those in the tree, vc4 (stereo_allowed, the HDMI state
helper, and drm_hdmi_compute_mode_clock() in its scrambling decision),
whose stereo modes are now validated, clocked and scrambled at the rate
of their 3D frame. vc4 still times its pixel valve with the 2D timing, so its 3D
output also needs that changed. sun4i, ite-it6263 and the bridge
connector do not allow stereo modes and see no change.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 drivers/gpu/drm/display/drm_hdmi_helper.c     |  50 ++++++-
 .../gpu/drm/display/drm_hdmi_state_helper.c   |   3 +-
 .../drm/tests/drm_hdmi_state_helper_test.c    | 137 ++++++++++++++++++
 include/drm/display/drm_hdmi_helper.h         |   5 +
 4 files changed, 188 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/display/drm_hdmi_helper.c b/drivers/gpu/drm/display/drm_hdmi_helper.c
index 5cb0b033b1..a95c5b0ad5 100644
--- a/drivers/gpu/drm/display/drm_hdmi_helper.c
+++ b/drivers/gpu/drm/display/drm_hdmi_helper.c
@@ -198,23 +198,38 @@ void drm_hdmi_avi_infoframe_content_type(struct hdmi_avi_infoframe *frame,
 EXPORT_SYMBOL(drm_hdmi_avi_infoframe_content_type);
 
 /**
- * drm_hdmi_compute_mode_clock() - Computes the TMDS Character Rate
+ * drm_hdmi_compute_stereo_mode_clock() - Computes the TMDS Character Rate
  * @mode: Display mode to compute the clock for
  * @bpc: Bits per character
  * @fmt: Output Pixel Format used
+ * @adjust_flags: drm_mode_set_crtcinfo() flags that time a stereo mode on top
+ *	of CRTC_STEREO_DOUBLE, such as drm_connector_stereo_crtc_flags() of the
+ *	connector state
  *
- * Returns the TMDS Character Rate for a given mode, bpc count and output format.
+ * Returns the TMDS Character Rate for a given mode, bpc count and output
+ * format. A stereo mode is sent at the pixel clock of its whole 3D frame
+ * (HDMI 1.4a, section 8.2.3.2 and Appendix H), as drm_mode_set_crtcinfo()
+ * times it: twice the 2D pixel clock for frame packing, field alternative,
+ * line alternative, side by side (full) and L + depth, four times for L +
+ * depth + graphics + graphics-depth, the 2D pixel clock for top and bottom
+ * and side by side (half).
  *
  * RETURNS:
  * The TMDS Character Rate, in Hertz, or 0 on error.
  */
 unsigned long long
-drm_hdmi_compute_mode_clock(const struct drm_display_mode *mode,
-			    unsigned int bpc,
-			    enum drm_output_color_format fmt)
+drm_hdmi_compute_stereo_mode_clock(const struct drm_display_mode *mode,
+				   unsigned int bpc,
+				   enum drm_output_color_format fmt,
+				   int adjust_flags)
 {
-	unsigned long long clock = mode->clock * 1000ULL;
 	unsigned int vic = drm_match_cea_mode(mode);
+	struct drm_display_mode frame;
+	unsigned long long clock;
+
+	drm_mode_init(&frame, mode);
+	drm_mode_set_crtcinfo(&frame, CRTC_STEREO_DOUBLE_ONLY | adjust_flags);
+	clock = frame.crtc_clock * 1000ULL;
 
 	/*
 	 * CTA-861-G Spec, section 5.4 - Color Coding and Quantization
@@ -257,6 +272,29 @@ drm_hdmi_compute_mode_clock(const struct drm_display_mode *mode,
 
 	return DIV_ROUND_CLOSEST_ULL(clock * bpc, 8);
 }
+EXPORT_SYMBOL(drm_hdmi_compute_stereo_mode_clock);
+
+/**
+ * drm_hdmi_compute_mode_clock() - Computes the TMDS Character Rate
+ * @mode: Display mode to compute the clock for
+ * @bpc: Bits per character
+ * @fmt: Output Pixel Format used
+ *
+ * Returns the TMDS Character Rate for a given mode, bpc count and output
+ * format; for a stereo mode the rate of its 3D frame with the timings of HDMI
+ * 1.4a, as drm_hdmi_compute_stereo_mode_clock() gives it without adjust
+ * flags.
+ *
+ * RETURNS:
+ * The TMDS Character Rate, in Hertz, or 0 on error.
+ */
+unsigned long long
+drm_hdmi_compute_mode_clock(const struct drm_display_mode *mode,
+			    unsigned int bpc,
+			    enum drm_output_color_format fmt)
+{
+	return drm_hdmi_compute_stereo_mode_clock(mode, bpc, fmt, 0);
+}
 EXPORT_SYMBOL(drm_hdmi_compute_mode_clock);
 
 struct drm_hdmi_acr_n_cts_entry {
diff --git a/drivers/gpu/drm/display/drm_hdmi_state_helper.c b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
index 6211f62b8e..698c6fd35c 100644
--- a/drivers/gpu/drm/display/drm_hdmi_state_helper.c
+++ b/drivers/gpu/drm/display/drm_hdmi_state_helper.c
@@ -580,7 +580,8 @@ hdmi_compute_clock(const struct drm_connector *connector,
 	enum drm_mode_status status;
 	unsigned long long clock;
 
-	clock = drm_hdmi_compute_mode_clock(mode, bpc, fmt);
+	clock = drm_hdmi_compute_stereo_mode_clock(mode, bpc, fmt,
+						   drm_connector_stereo_crtc_flags(conn_state));
 	if (!clock)
 		return -EINVAL;
 
diff --git a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
index c54c938e47..3abc10298a 100644
--- a/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
+++ b/drivers/gpu/drm/tests/drm_hdmi_state_helper_test.c
@@ -1453,6 +1453,105 @@ static void drm_test_check_tmds_char_rate_rgb_8bpc(struct kunit *test)
 	drm_modeset_acquire_fini(&ctx);
 }
 
+struct drm_hdmi_stereo_rate_test {
+	const char *name;
+	u32 layout;
+	enum drm_hdmi_sbs_full_timing timing;
+	unsigned long long rate;
+};
+
+/*
+ * 1080p60 (VIC 16, 148.5 MHz) in each 3D structure, RGB 8 bpc: a stereo mode
+ * is sent at the pixel clock of its whole 3D frame (HDMI 1.4a, section
+ * 8.2.3.2 and Appendix H; 297 MHz for side by side (full), Table H-5).
+ */
+static const struct drm_hdmi_stereo_rate_test drm_hdmi_stereo_rate_tests[] = {
+	{ "2d", 0, DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE, 148500000 },
+	{ "frame-packing", DRM_MODE_FLAG_3D_FRAME_PACKING,
+	  DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE, 297000000 },
+	{ "line-alternative", DRM_MODE_FLAG_3D_LINE_ALTERNATIVE,
+	  DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE, 297000000 },
+	{ "side-by-side-full", DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL,
+	  DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE, 297000000 },
+	{ "side-by-side-full-blanking-kept", DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL,
+	  DRM_HDMI_SBS_FULL_TIMING_KEEP_BLANKING, 278100000 },
+	{ "l-depth", DRM_MODE_FLAG_3D_L_DEPTH,
+	  DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE, 297000000 },
+	{ "top-and-bottom", DRM_MODE_FLAG_3D_TOP_AND_BOTTOM,
+	  DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE, 148500000 },
+	{ "side-by-side-half", DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF,
+	  DRM_HDMI_SBS_FULL_TIMING_WHOLE_LINE, 148500000 },
+};
+
+static void drm_hdmi_stereo_rate_desc(const struct drm_hdmi_stereo_rate_test *t,
+				      char *desc)
+{
+	strscpy(desc, t->name, KUNIT_PARAM_DESC_SIZE);
+}
+
+KUNIT_ARRAY_PARAM(drm_hdmi_stereo_rate, drm_hdmi_stereo_rate_tests,
+		  drm_hdmi_stereo_rate_desc);
+
+/*
+ * Test that the TMDS character rate of a stereo mode is that of its 3D
+ * frame, with the connector's side by side (full) timing.
+ */
+static void drm_test_check_tmds_char_rate_stereo(struct kunit *test)
+{
+	const struct drm_hdmi_stereo_rate_test *t = test->param_value;
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_connector_state *conn_state;
+	struct drm_display_mode *mode;
+	struct drm_connector *conn;
+	struct drm_device *drm;
+	struct drm_crtc *crtc;
+	int ret;
+
+	priv = drm_kunit_helper_connector_hdmi_init_with_edid_funcs(test,
+				BIT(DRM_OUTPUT_COLOR_FORMAT_RGB444),
+				8,
+				&dummy_connector_hdmi_funcs,
+				test_edid_hdmi_1080p_rgb_max_340mhz);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	drm = &priv->drm;
+	crtc = priv->crtc;
+	conn = &priv->connector;
+
+	mode = drm_mode_duplicate(drm, find_preferred_mode(conn));
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	KUNIT_ASSERT_EQ(test, mode->clock, 148500);
+	mode->flags |= t->layout;
+
+	/* the commit below starts from this state */
+	conn->state->hdmi.sbs_full_timing = t->timing;
+
+	drm_modeset_acquire_init(&ctx, 0);
+
+retry_conn_enable:
+	ret = drm_kunit_helper_enable_crtc_connector(test, drm,
+						     crtc, conn,
+						     mode,
+						     &ctx);
+	if (ret == -EDEADLK) {
+		ret = drm_modeset_backoff(&ctx);
+		if (!ret)
+			goto retry_conn_enable;
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	conn_state = conn->state;
+	KUNIT_ASSERT_NOT_NULL(test, conn_state);
+
+	KUNIT_ASSERT_EQ(test, conn_state->hdmi.output_bpc, 8);
+	KUNIT_ASSERT_EQ(test, conn_state->hdmi.output_format, DRM_OUTPUT_COLOR_FORMAT_RGB444);
+	KUNIT_EXPECT_EQ(test, conn_state->hdmi.tmds_char_rate, t->rate);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
 /*
  * Test that when doing a commit which would use RGB 10bpc, the TMDS
  * clock rate stored in the connector state is equal to 1.25 times the
@@ -2679,6 +2778,8 @@ static struct kunit_case drm_atomic_helper_connector_hdmi_check_tests[] = {
 	KUNIT_CASE(drm_test_check_output_bpc_format_driver_8bpc_only),
 	KUNIT_CASE(drm_test_check_output_bpc_format_driver_rgb_only),
 	KUNIT_CASE(drm_test_check_tmds_char_rate_rgb_8bpc),
+	KUNIT_CASE_PARAM(drm_test_check_tmds_char_rate_stereo,
+			 drm_hdmi_stereo_rate_gen_params),
 	KUNIT_CASE(drm_test_check_tmds_char_rate_rgb_10bpc),
 	KUNIT_CASE(drm_test_check_tmds_char_rate_rgb_12bpc),
 	KUNIT_CASE_PARAM(drm_test_check_hdmi_color_format,
@@ -2967,6 +3068,41 @@ static void drm_test_check_mode_valid_reject_max_clock(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, preferred->clock, 25200);
 }
 
+/*
+ * Test that drm_hdmi_connector_mode_valid() checks a stereo mode at the rate
+ * of its 3D frame: frame packing of 1080p60 is sent at 297 MHz (HDMI 1.4a,
+ * section 8.2.3.2), more than a 200 MHz sink takes, while 1080p60 itself and
+ * its top and bottom fit.
+ */
+static void drm_test_check_mode_valid_reject_stereo_clock(struct kunit *test)
+{
+	struct drm_atomic_helper_connector_hdmi_priv *priv;
+	struct drm_display_mode *mode;
+	struct drm_connector *conn;
+
+	priv = drm_kunit_helper_connector_hdmi_init_with_edid_funcs(test,
+				BIT(DRM_OUTPUT_COLOR_FORMAT_RGB444),
+				8,
+				&dummy_connector_hdmi_funcs,
+				test_edid_hdmi_1080p_rgb_max_200mhz);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+
+	conn = &priv->connector;
+	KUNIT_ASSERT_EQ(test, conn->display_info.max_tmds_clock, 200 * 1000);
+
+	mode = drm_mode_duplicate(&priv->drm, find_preferred_mode(conn));
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	KUNIT_ASSERT_EQ(test, mode->clock, 148500);
+	KUNIT_EXPECT_EQ(test, drm_hdmi_connector_mode_valid(conn, mode), MODE_OK);
+
+	mode->flags |= DRM_MODE_FLAG_3D_TOP_AND_BOTTOM;
+	KUNIT_EXPECT_EQ(test, drm_hdmi_connector_mode_valid(conn, mode), MODE_OK);
+
+	mode->flags &= ~DRM_MODE_FLAG_3D_MASK;
+	mode->flags |= DRM_MODE_FLAG_3D_FRAME_PACKING;
+	KUNIT_EXPECT_EQ(test, drm_hdmi_connector_mode_valid(conn, mode), MODE_CLOCK_HIGH);
+}
+
 /*
  * Test that drm_hdmi_connector_mode_valid() will accept modes that require a
  * 4:2:0 chroma subsampling, even if said mode would violate maximum clock
@@ -3061,6 +3197,7 @@ static struct kunit_case drm_atomic_helper_connector_hdmi_mode_valid_tests[] = {
 	KUNIT_CASE(drm_test_check_mode_valid_reject),
 	KUNIT_CASE(drm_test_check_mode_valid_reject_rate),
 	KUNIT_CASE(drm_test_check_mode_valid_reject_max_clock),
+	KUNIT_CASE(drm_test_check_mode_valid_reject_stereo_clock),
 	KUNIT_CASE(drm_test_check_mode_valid_yuv420_only_max_clock),
 	KUNIT_CASE(drm_test_check_mode_valid_reject_yuv420_only_connector),
 	KUNIT_CASE(drm_test_check_mode_valid_accept_yuv420_also_connector_rgb),
diff --git a/include/drm/display/drm_hdmi_helper.h b/include/drm/display/drm_hdmi_helper.h
index 9c31ed9051..36fa1892ce 100644
--- a/include/drm/display/drm_hdmi_helper.h
+++ b/include/drm/display/drm_hdmi_helper.h
@@ -28,6 +28,11 @@ void drm_hdmi_avi_infoframe_content_type(struct hdmi_avi_infoframe *frame,
 unsigned long long
 drm_hdmi_compute_mode_clock(const struct drm_display_mode *mode,
 			    unsigned int bpc, enum drm_output_color_format fmt);
+unsigned long long
+drm_hdmi_compute_stereo_mode_clock(const struct drm_display_mode *mode,
+				   unsigned int bpc,
+				   enum drm_output_color_format fmt,
+				   int adjust_flags);
 
 void
 drm_hdmi_acr_get_n_cts(unsigned long long tmds_char_rate,
