From a6a3e0ae73db8dc7f4ef02a422597302dc8c78cc Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 26 Nov 2026 18:20:15 -0300
Subject: [PATCH 2/3] Bluetooth: btusb: write the voice setting of the CSR
 clone with LMP subversion 0x2312

btusb_setup_csr() marks every fake CSR controller with
HCI_QUIRK_BROKEN_READ_VOICE_SETTING, so hdev->voice_setting stays 0 and
the core disables SCO on it. On the clone with bcdDevice 0x8891, HCI
revision 0x0810 and LMP subversion 0x2312, HCI_OP_WRITE_VOICE_SETTING
completes with success, and an eSCO link with 16-bit CVSD input is then
set up.

For that clone only, set HCI_QUIRK_VOICE_SETTING_BY_DRIVER and write the
voice setting SCO sockets ask for by default (0x0060) in post_init, which
runs after the controller's HCI_Reset and before any SCO connection can
be made. hci_cc_write_voice_setting() stores it in hdev->voice_setting,
so btusb_work() selects the 16-bit isochronous alternate setting and an
incoming connection is accepted with it. The controller's own SCO
buffers (48 bytes, 16 packets) are kept. When the write fails, SCO is
disabled as before. disable_scofix=1 turns the exception off.

The match needs all three identities and the fake detection: a genuine
CSR8510 also reports bcdDevice 0x8891, and the Barrot 8041a02 clone
with LMP subversion 0x1012 is left as it is. Whether audio crosses a
SCO link on this clone is not proven here.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/bluetooth/btusb.c | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
index 109013b43..aeb1969cd 100644
--- a/drivers/bluetooth/btusb.c
+++ b/drivers/bluetooth/btusb.c
@@ -2569,6 +2569,29 @@ static int btusb_setup_bcm92035(struct hci_dev *hdev)
 	return 0;
 }
 
+static int btusb_post_init_csr_voice(struct hci_dev *hdev)
+{
+	/* CVSD air coding with 16-bit linear PCM input, the setting SCO
+	 * sockets ask for by default (BT_VOICE_CVSD_16BIT).
+	 */
+	__le16 setting = cpu_to_le16(0x0060);
+	int err;
+
+	err = __hci_cmd_sync_status(hdev, HCI_OP_WRITE_VOICE_SETTING,
+				    sizeof(setting), &setting,
+				    HCI_INIT_TIMEOUT);
+	if (err) {
+		bt_dev_warn(hdev, "CSR: Couldn't write the voice setting (%d); SCO disabled",
+			    err);
+		hci_dev_lock(hdev);
+		hdev->sco_pkts = 0;
+		hdev->sco_cnt = 0;
+		hci_dev_unlock(hdev);
+	}
+
+	return 0;
+}
+
 static int btusb_setup_csr(struct hci_dev *hdev)
 {
 	struct btusb_data *data = hci_get_drvdata(hdev);
@@ -2720,6 +2743,19 @@ static int btusb_setup_csr(struct hci_dev *hdev)
 			usb_enable_autosuspend(data->udev);
 	}
 
+	/* This clone (bcdDevice 0x8891, HCI revision 0x0810, LMP subversion
+	 * 0x2312) cannot have its voice setting read, but accepts
+	 * HCI_OP_WRITE_VOICE_SETTING: write it after init instead of
+	 * leaving SCO disabled.
+	 */
+	if (is_fake && !disable_scofix && bcdDevice == 0x8891 &&
+	    le16_to_cpu(rp->hci_rev) == 0x0810 &&
+	    le16_to_cpu(rp->lmp_subver) == 0x2312) {
+		bt_dev_info(hdev, "CSR: Writing the voice setting after init, SCO kept");
+		hci_set_quirk(hdev, HCI_QUIRK_VOICE_SETTING_BY_DRIVER);
+		hdev->post_init = btusb_post_init_csr_voice;
+	}
+
 	kfree_skb(skb);
 
 	return 0;
