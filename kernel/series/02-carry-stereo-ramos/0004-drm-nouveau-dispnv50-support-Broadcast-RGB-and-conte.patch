diff --git a/drivers/gpu/drm/nouveau/dispnv50/atom.h b/drivers/gpu/drm/nouveau/dispnv50/atom.h
index c766f694ebbf73cf752851e42184c242c83b8a80..350b2a5899b6cf0e31fdda2f2260660bdba70cdd 100644
--- a/drivers/gpu/drm/nouveau/dispnv50/atom.h
+++ b/drivers/gpu/drm/nouveau/dispnv50/atom.h
@@ -121,6 +121,7 @@ struct nv50_head_atom {
 			u16 cos:12;
 			u16 sin:12;
 		} sat;
+		bool limited; /* "Broadcast RGB" Limited: 16-235 on the wire */
 	} procamp;
 
 	struct {
diff --git a/drivers/gpu/drm/nouveau/dispnv50/disp.c b/drivers/gpu/drm/nouveau/dispnv50/disp.c
index c45456eef645d26fba94eb37f9ea1123c8964cfc..4036bf04eec96a1df9b599aaf05f9ccac74766f4 100644
--- a/drivers/gpu/drm/nouveau/dispnv50/disp.c
+++ b/drivers/gpu/drm/nouveau/dispnv50/disp.c
@@ -39,6 +39,7 @@
 #include <linux/math64.h>
 
 #include <drm/display/drm_dp_helper.h>
+#include <drm/display/drm_hdmi_helper.h>
 #include <drm/display/drm_scdc_helper.h>
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
@@ -1067,8 +1068,16 @@ nv50_hdmi_enable(struct drm_encoder *encoder, struct nouveau_crtc *nv_crtc,
 	args->head = nv_crtc->index;
 
 	if (!drm_hdmi_avi_infoframe_from_display_mode(&infoframe.avi, &nv_connector->base, mode)) {
+		const struct drm_connector_state *conn_state =
+			drm_atomic_get_new_connector_state(state, &nv_connector->base);
+
+		/* the range the head sends ("Broadcast RGB") */
 		drm_hdmi_avi_infoframe_quant_range(&infoframe.avi, &nv_connector->base, mode,
+						   asyh->procamp.limited ?
+						   HDMI_QUANTIZATION_RANGE_LIMITED :
 						   HDMI_QUANTIZATION_RANGE_FULL);
+		if (conn_state)
+			drm_hdmi_avi_infoframe_content_type(&infoframe.avi, conn_state);
 
 		size = hdmi_infoframe_pack(&infoframe, args->data, data_len);
 	} else {
diff --git a/drivers/gpu/drm/nouveau/dispnv50/head.c b/drivers/gpu/drm/nouveau/dispnv50/head.c
index 3e90043b04a9c07ac615eaf39f8117be9b219431..31d09560507c6a475c103d886cb2336bf0f17f63 100644
--- a/drivers/gpu/drm/nouveau/dispnv50/head.c
+++ b/drivers/gpu/drm/nouveau/dispnv50/head.c
@@ -89,6 +89,17 @@ nv50_head_flush_set(struct nv50_head *head, struct nv50_head_atom *asyh)
 	if (asyh->set.or     ) head->func->or      (head, asyh);
 }
 
+static void
+nv50_head_atomic_check_range(struct nv50_head_atom *armh,
+			     struct nv50_head_atom *asyh,
+			     struct nouveau_conn_atom *asyc)
+{
+	asyh->procamp.limited = asyc->state.connector->broadcast_rgb_property &&
+		asyc->state.hdmi.broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED;
+	if (asyh->procamp.limited != armh->procamp.limited)
+		asyh->set.procamp = true;
+}
+
 static void
 nv50_head_atomic_check_procamp(struct nv50_head_atom *armh,
 			       struct nv50_head_atom *asyh,
@@ -489,6 +500,7 @@ nv50_head_atomic_check(struct drm_crtc *crtc, struct drm_atomic_commit *state)
 				nv50_head_atomic_check_dither(armh, asyh, asyc);
 			if (asyc->set.procamp)
 				nv50_head_atomic_check_procamp(armh, asyh, asyc);
+			nv50_head_atomic_check_range(armh, asyh, asyc);
 		}
 
 		if (head->func->core_calc) {
diff --git a/drivers/gpu/drm/nouveau/dispnv50/headc57d.c b/drivers/gpu/drm/nouveau/dispnv50/headc57d.c
index 8c67600079224a9ee31655aa78d4a2ad967cc336..3b5224e1babb05f47a2eb7ed57cd2b1e713f970c 100644
--- a/drivers/gpu/drm/nouveau/dispnv50/headc57d.c
+++ b/drivers/gpu/drm/nouveau/dispnv50/headc57d.c
@@ -74,21 +74,48 @@ headc57d_or(struct nv50_head *head, struct nv50_head_atom *asyh)
 	return 0;
 }
 
+/* RGB compressed to 16-235 (S3.16), as OpenRM's RGBToLimitedRangeRGB */
+static const u32
+headc57d_limited_rgb[12] = {
+	0xdb04, 0x0000, 0x0000, 0x1000,
+	0x0000, 0xdb04, 0x0000, 0x1000,
+	0x0000, 0x0000, 0xdb04, 0x1000,
+};
+
 static int
 headc57d_procamp(struct nv50_head *head, struct nv50_head_atom *asyh)
 {
 	struct nvif_push *push = &nv50_disp(head->base.base.dev)->core->chan.push;
 	const int i = head->base.index;
+	const bool limited = asyh->procamp.limited;
 	int ret;
 
-	if ((ret = PUSH_WAIT(push, 2)))
+	ret = PUSH_WAIT(push, 20);
+	if (ret)
 		return ret;
 
-	//TODO:
+	/* "Broadcast RGB" Limited: CEA range, with OCSC1 compressing RGB to 16-235 and
+	 * the output clamped to it, as OpenRM programs it.
+	 */
 	PUSH_MTHD(push, NVC57D, HEAD_SET_PROCAMP(i),
 		  NVDEF(NVC57D, HEAD_SET_PROCAMP, COLOR_SPACE, RGB) |
 		  NVDEF(NVC57D, HEAD_SET_PROCAMP, CHROMA_LPF, DISABLE) |
-		  NVDEF(NVC57D, HEAD_SET_PROCAMP, DYNAMIC_RANGE, VESA));
+		  (limited ? NVDEF(NVC57D, HEAD_SET_PROCAMP, DYNAMIC_RANGE, CEA) :
+			     NVDEF(NVC57D, HEAD_SET_PROCAMP, DYNAMIC_RANGE, VESA)));
+
+	PUSH_MTHD(push, NVC57D, HEAD_SET_CLAMP_RANGE_GREEN(i),
+		  NVVAL(NVC57D, HEAD_SET_CLAMP_RANGE_GREEN, LOW, limited ? 0x100 : 0x000) |
+		  NVVAL(NVC57D, HEAD_SET_CLAMP_RANGE_GREEN, HIGH, limited ? 0xeb0 : 0xfff),
+
+				HEAD_SET_CLAMP_RANGE_RED_BLUE(i),
+		  NVVAL(NVC57D, HEAD_SET_CLAMP_RANGE_RED_BLUE, LOW, limited ? 0x100 : 0x000) |
+		  NVVAL(NVC57D, HEAD_SET_CLAMP_RANGE_RED_BLUE, HIGH, limited ? 0xeb0 : 0xfff));
+
+	PUSH_MTHD(push, NVC57D, HEAD_SET_OCSC1CONTROL(i),
+		  limited ? NVDEF(NVC57D, HEAD_SET_OCSC1CONTROL, ENABLE, ENABLE) :
+			    NVDEF(NVC57D, HEAD_SET_OCSC1CONTROL, ENABLE, DISABLE));
+	if (limited)
+		PUSH_MTHD(push, NVC57D, HEAD_SET_OCSC1COEFFICIENT_C00(i), headc57d_limited_rgb, 12);
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/nouveau/dispnv50/headca7d.c b/drivers/gpu/drm/nouveau/dispnv50/headca7d.c
