From 9741376bfba2b20c7ff77a76d464ab7bae6f9ae5 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 14 Nov 2026 21:22:43 -0300
Subject: [PATCH] media: uvcvideo: decode unaligned bulk payloads on known
 Realtek cameras

The Realtek 0bda:5722 in a Sony VAIO Duo 13 returns no complete YUYV
frames when its payloads cross the driver's 16384-byte URB boundaries.
Its 640x480 probe reports dwMaxVideoFrameSize 614400 and
dwMaxPayloadTransferSize 119296. usbmon records 37 full URBs plus
8264 bytes: 614472 bytes, or 614400 image bytes and six 12-byte headers.
The driver instead treats headers inside URBs as image data and reports
"Dropping payload (out of sync)".

Julian Meyer identified this defect for 0bda:579f in 2020 and proposed
continuing the decode at the maximum payload size. Muhammad Waleed
Badar's 2026 v3 adds a device quirk and validates the following header,
addressing Hans de Goede's and Ricardo Ribalda's review about cameras
that append trailer data. Adapt that refactoring and header check for
both reported IDs, keeping unquirked devices on their existing path.

Require a positive boundary offset, preserve the current transfer when
its remainder is not a complete header, and report that condition once.
Bound scheduled copies by the existing array; an excessive number of
fragments marks the buffer bad and drops further data instead of writing
past the array. Every iteration consumes bytes even when no copy occurs.

Synthetic transfers through the actual decoder in x86_64 QEMU deliver
two byte-exact 614400-byte frames. Short packets, aligned payloads, a
zero maximum, isochronous input, small MJPEG frames, trailers and an
unquirked device retain their tested behavior. The supplied generic fix
was measured on hardware; this restricted form still needs that test.

Link: https://lkml.iu.edu/2004.2/06143.html
Link: https://lkml.iu.edu/hypermail/linux/kernel/2611.0/04453.html
Assisted-by: LLM [OpenAI Codex]
---
 drivers/media/usb/uvc/uvc_driver.c |  18 ++++
 drivers/media/usb/uvc/uvc_video.c  | 128 ++++++++++++++++++++---------
 drivers/media/usb/uvc/uvcvideo.h   |   4 +
 3 files changed, 110 insertions(+), 40 deletions(-)

diff --git a/drivers/media/usb/uvc/uvc_driver.c b/drivers/media/usb/uvc/uvc_driver.c
index e289cc7..361944d 100644
--- a/drivers/media/usb/uvc/uvc_driver.c
+++ b/drivers/media/usb/uvc/uvc_driver.c
@@ -2887,6 +2887,24 @@ static const struct usb_device_id uvc_ids[] = {
 	  .bInterfaceSubClass	= 1,
 	  .bInterfaceProtocol	= 0,
 	  .driver_info		= (kernel_ulong_t)&uvc_quirk_probe_minmax },
+	/* Realtek USB Camera (Sony VAIO Duo 13) */
+	{ .match_flags		= USB_DEVICE_ID_MATCH_DEVICE
+				| USB_DEVICE_ID_MATCH_INT_INFO,
+	  .idVendor		= 0x0bda,
+	  .idProduct		= 0x5722,
+	  .bInterfaceClass	= USB_CLASS_VIDEO,
+	  .bInterfaceSubClass	= 1,
+	  .bInterfaceProtocol	= 0,
+	  .driver_info		= UVC_INFO_QUIRK(UVC_QUIRK_BULK_UNALIGNED_PAYLOAD) },
+	/* Realtek USB Camera (Razer Blade) */
+	{ .match_flags		= USB_DEVICE_ID_MATCH_DEVICE
+				| USB_DEVICE_ID_MATCH_INT_INFO,
+	  .idVendor		= 0x0bda,
+	  .idProduct		= 0x579f,
+	  .bInterfaceClass	= USB_CLASS_VIDEO,
+	  .bInterfaceSubClass	= 1,
+	  .bInterfaceProtocol	= 0,
+	  .driver_info		= UVC_INFO_QUIRK(UVC_QUIRK_BULK_UNALIGNED_PAYLOAD) },
 	/* Sonix Technology Co. Ltd. - 292A IPC AR0330 */
 	{ .match_flags		= USB_DEVICE_ID_MATCH_DEVICE
 				| USB_DEVICE_ID_MATCH_INT_INFO,
diff --git a/drivers/media/usb/uvc/uvc_video.c b/drivers/media/usb/uvc/uvc_video.c
index fc3536a..4d19248 100644
--- a/drivers/media/usb/uvc/uvc_video.c
+++ b/drivers/media/usb/uvc/uvc_video.c
@@ -1612,29 +1612,19 @@ static void uvc_video_decode_isoc(struct uvc_urb *uvc_urb,
 	}
 }
 
-static void uvc_video_decode_bulk(struct uvc_urb *uvc_urb,
-			struct uvc_buffer *buf, struct uvc_buffer *meta_buf)
+static void uvc_video_decode_bulk_chunk(struct uvc_urb *uvc_urb,
+					struct uvc_buffer **bufp,
+					struct uvc_buffer **meta_bufp,
+					u8 *mem, int len, bool short_urb)
 {
-	struct urb *urb = uvc_urb->urb;
 	struct uvc_streaming *stream = uvc_urb->stream;
-	u8 *mem;
-	int len, ret;
-
-	/*
-	 * Ignore ZLPs if they're not part of a frame, otherwise process them
-	 * to trigger the end of payload detection.
-	 */
-	if (urb->actual_length == 0 && stream->bulk.header_size == 0)
-		return;
+	struct uvc_buffer *buf = *bufp;
+	struct uvc_buffer *meta_buf = *meta_bufp;
+	int ret;
 
-	mem = urb->transfer_buffer;
-	len = urb->actual_length;
 	stream->bulk.payload_size += len;
 
-	/*
-	 * If the URB is the first of its payload, decode and save the
-	 * header.
-	 */
+	/* If the chunk starts a payload, decode and save its header. */
 	if (stream->bulk.header_size == 0 && !stream->bulk.skip_payload) {
 		do {
 			ret = uvc_video_decode_start(stream, buf, meta_buf, mem,
@@ -1643,47 +1633,105 @@ static void uvc_video_decode_bulk(struct uvc_urb *uvc_urb,
 				uvc_video_next_buffers(stream, &buf, &meta_buf);
 		} while (ret == -EAGAIN);
 
-		/* If an error occurred skip the rest of the payload. */
-		if (ret < 0 || buf == NULL) {
+		if (ret < 0 || !buf) {
 			stream->bulk.skip_payload = 1;
 		} else {
 			memcpy(stream->bulk.header, mem, ret);
 			stream->bulk.header_size = ret;
-
 			uvc_video_decode_meta(stream, meta_buf, mem, ret);
-
 			mem += ret;
 			len -= ret;
 		}
 	}
 
-	/*
-	 * The buffer queue might have been cancelled while a bulk transfer
-	 * was in progress, so we can reach here with buf equal to NULL. Make
-	 * sure buf is never dereferenced if NULL.
-	 */
-
-	/* Prepare video data for processing. */
-	if (!stream->bulk.skip_payload && buf != NULL)
-		uvc_video_decode_data(uvc_urb, buf, mem, len);
+	/* A cancelled queue may have no video buffer. */
+	if (!stream->bulk.skip_payload && buf) {
+		if (uvc_urb->async_operations <
+		    ARRAY_SIZE(uvc_urb->copy_operations)) {
+			uvc_video_decode_data(uvc_urb, buf, mem, len);
+		} else {
+			buf->error = 1;
+			stream->bulk.skip_payload = 1;
+			uvc_warn_once(stream->dev, UVC_WARN_BULK_COPY_LIMIT,
+				      "Too many bulk payload fragments; dropping data\n");
+		}
+	}
 
-	/*
-	 * Detect the payload end by a URB smaller than the maximum size (or
-	 * a payload size equal to the maximum) and process the header again.
-	 */
-	if (urb->actual_length < urb->transfer_buffer_length ||
-	    stream->bulk.payload_size >= stream->bulk.max_payload_size) {
-		if (!stream->bulk.skip_payload && buf != NULL) {
+	if (short_urb || stream->bulk.payload_size >=
+			 stream->bulk.max_payload_size) {
+		if (!stream->bulk.skip_payload && buf) {
 			uvc_video_decode_end(stream, buf, stream->bulk.header,
-				stream->bulk.payload_size);
+					     stream->bulk.payload_size);
 			if (buf->state == UVC_BUF_STATE_READY)
 				uvc_video_next_buffers(stream, &buf, &meta_buf);
 		}
-
 		stream->bulk.header_size = 0;
 		stream->bulk.skip_payload = 0;
 		stream->bulk.payload_size = 0;
 	}
+
+	*bufp = buf;
+	*meta_bufp = meta_buf;
+}
+
+static bool uvc_video_bulk_is_header(const u8 *data, unsigned int len)
+{
+	unsigned int min_len = 2;
+
+	if (len < 2 || !(data[1] & UVC_STREAM_EOH))
+		return false;
+	if (data[1] & UVC_STREAM_PTS)
+		min_len += 4;
+	if (data[1] & UVC_STREAM_SCR)
+		min_len += 6;
+
+	return data[0] >= min_len && data[0] <= len;
+}
+
+static void uvc_video_decode_bulk(struct uvc_urb *uvc_urb,
+				  struct uvc_buffer *buf,
+				  struct uvc_buffer *meta_buf)
+{
+	struct urb *urb = uvc_urb->urb;
+	struct uvc_streaming *stream = uvc_urb->stream;
+	bool short_urb = urb->actual_length < urb->transfer_buffer_length;
+	u8 *mem = urb->transfer_buffer;
+	unsigned int len = urb->actual_length;
+
+	if (!len && !stream->bulk.header_size)
+		return;
+
+	do {
+		unsigned int chunk = len;
+
+		/*
+		 * Other cameras append trailer data. Only split known devices,
+		 * at a positive offset, when another complete header follows.
+		 */
+		if ((stream->dev->quirks & UVC_QUIRK_BULK_UNALIGNED_PAYLOAD) &&
+		    stream->bulk.max_payload_size > stream->bulk.payload_size) {
+			unsigned int rem = stream->bulk.max_payload_size -
+					   stream->bulk.payload_size;
+
+			if (rem < len) {
+				if (!uvc_video_bulk_is_header(mem + rem, len - rem)) {
+					uvc_warn_once(stream->dev,
+						      UVC_WARN_BULK_HEADER,
+						      "Unrecognized header after bulk payload boundary; keeping transfer intact\n");
+				} else {
+					uvc_warn_once(stream->dev,
+						      UVC_WARN_BULK_UNALIGNED,
+						      "UVC non compliance - bulk payload starts inside a URB; enabling workaround\n");
+					chunk = rem;
+				}
+			}
+		}
+
+		uvc_video_decode_bulk_chunk(uvc_urb, &buf, &meta_buf, mem,
+					    chunk, short_urb && chunk == len);
+		mem += chunk;
+		len -= chunk;
+	} while (len);
 }
 
 static void uvc_video_encode_bulk(struct uvc_urb *uvc_urb,
diff --git a/drivers/media/usb/uvc/uvcvideo.h b/drivers/media/usb/uvc/uvcvideo.h
index b6bcee4..f475129 100644
--- a/drivers/media/usb/uvc/uvcvideo.h
+++ b/drivers/media/usb/uvc/uvcvideo.h
@@ -81,6 +81,7 @@
 #define UVC_QUIRK_INVALID_DEVICE_SOF	0x00010000
 #define UVC_QUIRK_MJPEG_NO_EOF		0x00020000
 #define UVC_QUIRK_MSXU_META		0x00040000
+#define UVC_QUIRK_BULK_UNALIGNED_PAYLOAD	0x00080000
 
 /* Format flags */
 #define UVC_FMT_FLAG_COMPRESSED		0x00000001
@@ -661,6 +662,9 @@ static inline struct uvc_fh *to_uvc_fh(struct file *filp)
 #define UVC_WARN_MINMAX		0
 #define UVC_WARN_PROBE_DEF	1
 #define UVC_WARN_XU_GET_RES	2
+#define UVC_WARN_BULK_UNALIGNED	3
+#define UVC_WARN_BULK_HEADER	4
+#define UVC_WARN_BULK_COPY_LIMIT	5
 
 extern unsigned int uvc_clock_param;
 extern unsigned int uvc_no_drop_param;
-- 
