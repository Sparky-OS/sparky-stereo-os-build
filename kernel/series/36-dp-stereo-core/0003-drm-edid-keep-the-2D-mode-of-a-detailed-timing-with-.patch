From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 29 Oct 2026 12:29:01 -0300
Subject: [PATCH] drm/edid: keep the 2D mode of a detailed timing with stereo
 flags

Byte 17 of an EDID detailed timing descriptor says, in bits 6:5 and 0,
whether and how the sink shows that timing in stereo (E-EDID 1.4, section
3.10.2, Table 3.22, as libdisplay-info names the values in enum
di_edid_detailed_timing_def_stereo and edid-decode prints them):
  00x  no stereo
  010  field sequential, right image when the stereo sync signal is 1
  100  field sequential, left image when the stereo sync signal is 1
  011  2-way interleaved, right image on even lines
  101  2-way interleaved, left image on even lines
  110  4-way interleaved
  111  side by side interleaved

DRM_EDID_PT_STEREO was bit 5 alone, and drm_mode_detailed() dropped every
timing with it set. So of the six stereo values, the four with bit 5 set
(0x20, 0x21, 0x60, 0x61) lost their mode, while the two with only bit 6
set (0x40, 0x41) were kept as plain 2D modes. Two timings that differ
only in the polarity of the stereo sync signal were treated in opposite
ways, and a sink whose first detailed timing has bit 5 set lost its
preferred mode, the next detailed timing becoming preferred instead.

The stereo bits describe how the sink shows the timing; the timing
itself is an ordinary raster that the sink accepts. List it as a 2D mode
for every value, as the parser already did for 0x40 and 0x41, and name
the whole table in drm_edid.h, so that the stereo layouts DRM can
describe can be added next to the 2D mode.

Assisted-by: LLM
---
 drivers/gpu/drm/drm_edid.c | 15 ++++++++++-----
 include/drm/drm_edid.h     | 19 ++++++++++++++++++-
 2 files changed, 28 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/drm_edid.c b/drivers/gpu/drm/drm_edid.c
index 79ef8a0aa..74b069391 100644
--- a/drivers/gpu/drm/drm_edid.c
+++ b/drivers/gpu/drm/drm_edid.c
@@ -3539,11 +3539,16 @@ static struct drm_display_mode *drm_mode_detailed(struct drm_connector *connecto
 	if (hactive < 64 || vactive < 64)
 		return NULL;
 
-	if (pt->misc & DRM_EDID_PT_STEREO) {
-		drm_dbg_kms(dev, "[CONNECTOR:%d:%s] Stereo mode not supported\n",
-			    connector->base.id, connector->name);
-		return NULL;
-	}
+	/*
+	 * The stereo bits say how the sink shows this timing in stereo (field
+	 * sequential with a stereo sync signal, or one of the interleaved
+	 * layouts); the timing itself is an ordinary raster, so it is listed
+	 * as a 2D mode whatever they say.
+	 */
+	if (pt->misc & DRM_EDID_PT_STEREO)
+		drm_dbg_kms(dev, "[CONNECTOR:%d:%s] Detailed timing with stereo flags 0x%02x\n",
+			    connector->base.id, connector->name,
+			    pt->misc & DRM_EDID_PT_STEREO_MASK);
 	if (!(pt->misc & DRM_EDID_PT_SEPARATE_SYNC)) {
 		drm_dbg_kms(dev, "[CONNECTOR:%d:%s] Composite sync not supported\n",
 			    connector->base.id, connector->name);
diff --git a/include/drm/drm_edid.h b/include/drm/drm_edid.h
index 0820d6b1a..1b967737e 100644
--- a/include/drm/drm_edid.h
+++ b/include/drm/drm_edid.h
@@ -69,9 +69,26 @@ struct std_timing {
 #define DRM_EDID_PT_HSYNC_POSITIVE (1 << 1)
 #define DRM_EDID_PT_VSYNC_POSITIVE (1 << 2)
 #define DRM_EDID_PT_SEPARATE_SYNC  (3 << 3)
-#define DRM_EDID_PT_STEREO         (1 << 5)
 #define DRM_EDID_PT_INTERLACED     (1 << 7)
 
+/*
+ * Stereo viewing support, bits 6:5 and 0 of the flags byte (E-EDID 1.4,
+ * section 3.10.2, Table 3.22). Bits 6:5 at 00b mean no stereo, whatever bit 0
+ * says.
+ */
+#define DRM_EDID_PT_STEREO_MASK		((3 << 5) | (1 << 0))
+#define DRM_EDID_PT_STEREO		(3 << 5)
+/* field sequential, right image when the stereo sync signal is 1 */
+#define DRM_EDID_PT_STEREO_FIELD_SEQ_RIGHT	(1 << 5)
+/* field sequential, left image when the stereo sync signal is 1 */
+#define DRM_EDID_PT_STEREO_FIELD_SEQ_LEFT	(2 << 5)
+/* 2-way interleaved, right image on even lines */
+#define DRM_EDID_PT_STEREO_2_WAY_RIGHT_EVEN	((1 << 5) | (1 << 0))
+/* 2-way interleaved, left image on even lines */
+#define DRM_EDID_PT_STEREO_2_WAY_LEFT_EVEN	((2 << 5) | (1 << 0))
+#define DRM_EDID_PT_STEREO_4_WAY		(3 << 5)
+#define DRM_EDID_PT_STEREO_SIDE_BY_SIDE		((3 << 5) | (1 << 0))
+
 /* If detailed data is pixel timing */
 struct detailed_pixel_timing {
 	u8 hactive_lo;
-- 
