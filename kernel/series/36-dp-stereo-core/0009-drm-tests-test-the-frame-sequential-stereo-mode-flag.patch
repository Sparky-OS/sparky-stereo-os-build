 drivers/gpu/drm/tests/Makefile                |   1 +
 .../gpu/drm/tests/drm_frame_sequential_test.c | 235 ++++++++++++++++++
 drivers/gpu/drm/tests/drm_modes_test.c        |  55 ++++
 3 files changed, 291 insertions(+)
 create mode 100644 drivers/gpu/drm/tests/drm_frame_sequential_test.c

