+#define FRAME_SEQ	DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL
+
+static const struct drm_display_mode *
+drm_edid_stereo_find(struct kunit *test, int hdisplay, int vdisplay,
+		     int vrefresh, int clock, bool interlaced, u32 layout)
+{
+	struct drm_edid_3d_priv *priv = test->priv;
+	struct drm_display_mode *mode;
+
+	list_for_each_entry(mode, &priv->connector.probed_modes, head) {
+		if (mode->hdisplay == hdisplay && mode->vdisplay == vdisplay &&
+		    drm_mode_vrefresh(mode) == vrefresh && mode->clock == clock &&
+		    !!(mode->flags & DRM_MODE_FLAG_INTERLACE) == interlaced &&
+		    (mode->flags & DRM_MODE_FLAG_3D_MASK) == layout)
+			return mode;
+	}
+
+	return NULL;
+}
+
+static void drm_test_edid_stereo_detailed_timings(struct kunit *test)
+{
+	const struct drm_display_mode *mode;
+
+	drm_edid_3d_add_modes(test, edid_dtd_stereo, sizeof(edid_dtd_stereo));
+
+	/* every timing keeps its 2D mode, the first one preferred */
+	mode = drm_edid_stereo_find(test, 1920, 1080, 60, 148500, false, 0);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	KUNIT_EXPECT_TRUE(test, mode->type & DRM_MODE_TYPE_PREFERRED);
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1280, 720, 60, 74250,
+							 false, 0));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1920, 1080, 60, 74250,
+							 true, 0));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1024, 768, 60, 65000,
+							 false, 0));
+
+	/* field sequential, either polarity, progressive: also frame sequential */
+	mode = drm_edid_stereo_find(test, 1920, 1080, 60, 148500, false, FRAME_SEQ);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	KUNIT_EXPECT_FALSE(test, mode->type & DRM_MODE_TYPE_PREFERRED);
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1280, 720, 60, 74250,
+							 false, FRAME_SEQ));
+
+	/*
+	 * and their 1000/1001 twins, as for every 60 Hz CTA-861 format; nothing
+	 * for the interlaced or the interleaved timing
+	 */
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1920, 1080, 60, 148352,
+							 false, FRAME_SEQ));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1280, 720, 60, 74176,
+							 false, FRAME_SEQ));
+	KUNIT_EXPECT_EQ(test, drm_edid_3d_count_layout(test, FRAME_SEQ), 4);
+}
+
+static void drm_test_edid_stereo_displayid_2(struct kunit *test)
+{
+	drm_edid_3d_add_modes(test, edid_displayid2_stereo,
+			      sizeof(edid_displayid2_stereo));
+
+	/* the 2D modes of the Type VII timings stay */
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1920, 1080, 120, 297000,
+							 false, 0));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 2560, 1440, 60, 241500,
+							 false, 0));
+
+	/* the timing that reports 3D, and the three codes */
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1920, 1080, 120, 297000,
+							 false, FRAME_SEQ));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1280, 720, 60, 74250,
+							 false, FRAME_SEQ));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1920, 1080, 60, 148500,
+							 false, FRAME_SEQ));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 3840, 2160, 30, 297000,
+							 false, FRAME_SEQ));
+
+	/* not the mono-only timing, and nothing else */
+	KUNIT_EXPECT_NULL(test, drm_edid_stereo_find(test, 2560, 1440, 60, 241500,
+						     false, FRAME_SEQ));
+	KUNIT_EXPECT_EQ(test, drm_edid_3d_count_layout(test, FRAME_SEQ), 4);
+}
+
+static void drm_test_edid_stereo_displayid_1(struct kunit *test)
+{
+	drm_edid_3d_add_modes(test, edid_displayid1_stereo,
+			      sizeof(edid_displayid1_stereo));
+
+	/* all listed timings, although neither reports 3D itself */
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1920, 1080, 60, 148500,
+							 false, FRAME_SEQ));
+	KUNIT_EXPECT_NOT_NULL(test, drm_edid_stereo_find(test, 1280, 720, 60, 74250,
+							 false, FRAME_SEQ));
+	KUNIT_EXPECT_EQ(test, drm_edid_3d_count_layout(test, FRAME_SEQ), 2);
+
+	/* the side by side block lists nothing yet */
+	KUNIT_EXPECT_EQ(test, drm_edid_3d_count_layout(test,
+						       DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF), 0);
+	KUNIT_EXPECT_EQ(test, drm_edid_3d_count_layout(test,
+						       DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL), 0);
+}
+
+static struct kunit_case drm_edid_stereo_tests[] = {
+	KUNIT_CASE(drm_test_edid_stereo_detailed_timings),
+	KUNIT_CASE(drm_test_edid_stereo_displayid_2),
+	KUNIT_CASE(drm_test_edid_stereo_displayid_1),
+	{ }
+};
+
+static struct kunit_suite drm_edid_stereo_test_suite = {
+	.name = "drm_edid_stereo",
+	.init = drm_edid_3d_init,
+	.test_cases = drm_edid_stereo_tests,
+};
+
+kunit_test_suites(&drm_edid_3d_test_suite, &drm_edid_stereo_test_suite);
 
