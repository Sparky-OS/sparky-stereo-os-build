diff --git a/drivers/gpu/drm/amd/display/dc/dio/dcn10/dcn10_stream_encoder.c b/drivers/gpu/drm/amd/display/dc/dio/dcn10/dcn10_stream_encoder.c
index d913f065e..408a1e976 100644
--- a/drivers/gpu/drm/amd/display/dc/dio/dcn10/dcn10_stream_encoder.c
+++ b/drivers/gpu/drm/amd/display/dc/dio/dcn10/dcn10_stream_encoder.c
@@ -1488,6 +1488,42 @@ void enc1_setup_stereo_sync(
 	REG_UPDATE(DIG_FE_CNTL, DIG_STEREOSYNC_GATE_EN, !enable);
 }
 
+/*
+ * GSP0 is read through the same AFMT_GENERIC window that
+ * enc1_update_generic_info_packet() writes it through. DCN 3.0 and later keep
+ * the generic packets in the VPG instead, and have no AFMT_GENERIC registers.
+ */
+void enc1_read_stereo_state(
+	struct stream_encoder *enc,
+	struct enc_stereo_state *s)
+{
+	struct dcn10_stream_encoder *enc1 = DCN10STRENC_FROM_STRENC(enc);
+
+	REG_GET_2(DIG_FE_CNTL,
+			DIG_STEREOSYNC_SELECT, &s->dig_stereosync_select,
+			DIG_STEREOSYNC_GATE_EN, &s->dig_stereosync_gate_en);
+	s->dp_sec_cntl = REG_READ(DP_SEC_CNTL);
+	REG_GET_2(DP_SEC_CNTL,
+			DP_SEC_STREAM_ENABLE, &s->dp_sec_stream_enable,
+			DP_SEC_GSP0_ENABLE, &s->dp_sec_gsp0_enable);
+	s->dp_msa_misc = REG_READ(DP_MSA_MISC);
+
+	s->gsp0_read = REG(AFMT_GENERIC_HDR) != 0;
+	if (!s->gsp0_read)
+		return;
+
+	REG_UPDATE(AFMT_VBI_PACKET_CONTROL, AFMT_GENERIC_INDEX, 0);
+	s->gsp0_header = REG_READ(AFMT_GENERIC_HDR);
+	s->gsp0_data[0] = REG_READ(AFMT_GENERIC_0);
+	s->gsp0_data[1] = REG_READ(AFMT_GENERIC_1);
+	s->gsp0_data[2] = REG_READ(AFMT_GENERIC_2);
+	s->gsp0_data[3] = REG_READ(AFMT_GENERIC_3);
+	s->gsp0_data[4] = REG_READ(AFMT_GENERIC_4);
+	s->gsp0_data[5] = REG_READ(AFMT_GENERIC_5);
+	s->gsp0_data[6] = REG_READ(AFMT_GENERIC_6);
+	s->gsp0_data[7] = REG_READ(AFMT_GENERIC_7);
+}
+
 void enc1_dig_connect_to_otg(
 	struct stream_encoder *enc,
 	int tg_inst)
@@ -1600,6 +1636,7 @@ static const struct stream_encoder_funcs dcn10_str_enc_funcs = {
 	.hdmi_audio_setup = enc1_se_hdmi_audio_setup,
 	.hdmi_audio_disable = enc1_se_hdmi_audio_disable,
 	.setup_stereo_sync  = enc1_setup_stereo_sync,
+	.read_stereo_state = enc1_read_stereo_state,
 	.set_avmute = enc1_stream_encoder_set_avmute,
 	.dig_connect_to_otg  = enc1_dig_connect_to_otg,
 	.hdmi_reset_stream_attribute = enc1_reset_hdmi_stream_attribute,
