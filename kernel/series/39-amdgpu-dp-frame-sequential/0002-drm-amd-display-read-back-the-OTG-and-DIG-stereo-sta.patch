index 2b95cb11e..5ef058686 100644
--- a/drivers/gpu/drm/amd/display/dc/inc/hw/stream_encoder.h
+++ b/drivers/gpu/drm/amd/display/dc/inc/hw/stream_encoder.h
@@ -141,6 +141,23 @@ struct enc_state {
 	uint32_t sec_stream_enable;
 };
 
+/*
+ * What the DIG front end sends for stereo: its stereo sync (which drives MSA
+ * MISC1 bits 2:1 on DisplayPort), the generic packet enables, the MSA MISC
+ * register and, where the generic packets live in the AFMT, GSP0 (the VSC SDP).
+ */
+struct enc_stereo_state {
+	uint32_t dig_stereosync_select;
+	uint32_t dig_stereosync_gate_en;
+	uint32_t dp_sec_cntl;
+	uint32_t dp_sec_stream_enable;
+	uint32_t dp_sec_gsp0_enable;
+	uint32_t dp_msa_misc;
+	bool gsp0_read;
+	uint32_t gsp0_header;
+	uint32_t gsp0_data[8];
+};
+
 struct stream_encoder_funcs {
 	void (*dp_set_stream_attribute)(
 		struct stream_encoder *enc,
@@ -228,6 +245,10 @@ struct stream_encoder_funcs {
 			int tg_inst,
 			bool enable);
 
+	void (*read_stereo_state)(
+			struct stream_encoder *enc,
+			struct enc_stereo_state *s);
+
 	void (*set_avmute)(
 		struct stream_encoder *enc, bool enable);
 
