 #include "amdgpu_dm_kunit_test_helpers.h"
 
 /* Tests for get_subconnector_type() */
@@ -5423,6 +5425,399 @@ static void dm_test_connector_can_carry_hdmi(struct kunit *test)
 
 #undef CAN_CARRY_HDMI
 
+/* Frame-sequential stereo on DisplayPort */
+
+/* A 1920x1080 mode at 120 Hz (CTA-861 VIC 63's timing), with @flags */
+static void dm_test_fill_fs_mode(struct drm_display_mode *mode, u32 flags)
+{
+	memset(mode, 0, sizeof(*mode));
+	mode->clock = 297000;
+	mode->hdisplay = 1920;
+	mode->hsync_start = 2008;
+	mode->hsync_end = 2052;
+	mode->htotal = 2200;
+	mode->vdisplay = 1080;
+	mode->vsync_start = 1084;
+	mode->vsync_end = 1089;
+	mode->vtotal = 1125;
+	mode->flags = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC | flags;
+	/* as create_stream_for_sink() times every stereo mode */
+	drm_mode_set_crtcinfo(mode, CRTC_STEREO_DOUBLE);
+}
+
+/**
+ * dm_test_fill_stream_frame_sequential - Test the stream of a frame-sequential mode
+ * @test: The KUnit test context
+ *
+ * On a DisplayPort stream a frame-sequential mode gets in-band frame
+ * alternate stereo (TIMING_3D_FORMAT_INBAND_FA) and a frame-sequential view,
+ * and keeps its 2D link timing: 1920 active pixels, 2200 total, 1125 lines,
+ * 297 MHz.
+ */
+static void dm_test_fill_stream_frame_sequential(struct kunit *test)
+{
+	struct dm_test_fill_ctx *ctx = dm_test_fill_ctx_alloc(test);
+	struct dc_crtc_timing *timing = &ctx->stream->timing;
+
+	dm_test_fill_fs_mode(ctx->mode, DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL);
+	fill_stream_properties_from_drm_display_mode(ctx->stream, ctx->mode,
+		&ctx->aconnector->base, ctx->conn_state, NULL, 8,
+		PIXEL_ENCODING_RGB, false);
+
+	KUNIT_EXPECT_EQ(test, (int)timing->timing_3d_format,
+			(int)TIMING_3D_FORMAT_INBAND_FA);
+	KUNIT_EXPECT_EQ(test, (int)ctx->stream->view_format,
+			(int)VIEW_3D_FORMAT_FRAME_SEQUENTIAL);
+	KUNIT_EXPECT_EQ(test, timing->h_addressable, 1920);
+	KUNIT_EXPECT_EQ(test, timing->h_total, 2200);
+	KUNIT_EXPECT_EQ(test, timing->v_addressable, 1080);
+	KUNIT_EXPECT_EQ(test, timing->v_total, 1125);
+	KUNIT_EXPECT_EQ(test, timing->pix_clk_100hz, 2970000);
+}
+
+/**
+ * dm_test_fill_stream_frame_sequential_dp_only - Test frame sequential on other signals
+ * @test: The KUnit test context
+ *
+ * MSA MISC1 exists only on single-stream DisplayPort here: the mode that gets
+ * in-band frame alternate stereo on a DisplayPort stream gets no stereo format
+ * and no stereo view on an MST, eDP, DVI or HDMI stream.
+ */
+static void dm_test_fill_stream_frame_sequential_dp_only(struct kunit *test)
+{
+	static const struct {
+		enum signal_type signal;
+		bool stereo;
+	} cases[] = {
+		{ SIGNAL_TYPE_DISPLAY_PORT, true },
+		{ SIGNAL_TYPE_DISPLAY_PORT_MST, false },
+		{ SIGNAL_TYPE_EDP, false },
+		{ SIGNAL_TYPE_DVI_SINGLE_LINK, false },
+		{ SIGNAL_TYPE_HDMI_TYPE_A, false },
+	};
+	struct dm_test_fill_ctx *ctx = dm_test_fill_ctx_alloc(test);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		bool stereo = cases[i].stereo;
+		int format = stereo ? TIMING_3D_FORMAT_INBAND_FA : TIMING_3D_FORMAT_NONE;
+		int view = stereo ? VIEW_3D_FORMAT_FRAME_SEQUENTIAL : VIEW_3D_FORMAT_NONE;
+
+		memset(ctx->stream, 0, sizeof(*ctx->stream));
+		ctx->stream->signal = cases[i].signal;
+		dm_test_fill_fs_mode(ctx->mode, DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL);
+		fill_stream_properties_from_drm_display_mode(ctx->stream, ctx->mode,
+			&ctx->aconnector->base, ctx->conn_state, NULL, 8,
+			PIXEL_ENCODING_RGB, false);
+
+		KUNIT_EXPECT_EQ_MSG(test, (int)ctx->stream->timing.timing_3d_format, format,
+				    "signal %d", cases[i].signal);
+		KUNIT_EXPECT_EQ_MSG(test, (int)ctx->stream->view_format, view,
+				    "signal %d", cases[i].signal);
+	}
+}
+
+/**
+ * dm_test_fill_stream_frame_sequential_other_layouts - Test 2D and HDMI 3D modes
+ * @test: The KUnit test context
+ *
+ * On a DisplayPort stream only the frame-sequential layout is stereo to DC; a
+ * 2D mode and the HDMI 3D layouts build the stream they built before: no
+ * stereo format, no stereo view.
+ */
+static void dm_test_fill_stream_frame_sequential_other_layouts(struct kunit *test)
+{
+	static const u32 layouts[] = {
+		0,
+		DRM_MODE_FLAG_3D_FRAME_PACKING,
+		DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL,
+		DRM_MODE_FLAG_3D_TOP_AND_BOTTOM,
+		DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF,
+		DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL,
+	};
+	struct dm_test_fill_ctx *ctx = dm_test_fill_ctx_alloc(test);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(layouts); i++) {
+		bool fs = layouts[i] == DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL;
+		int format = fs ? TIMING_3D_FORMAT_INBAND_FA : TIMING_3D_FORMAT_NONE;
+		int view = fs ? VIEW_3D_FORMAT_FRAME_SEQUENTIAL : VIEW_3D_FORMAT_NONE;
+
+		memset(ctx->stream, 0, sizeof(*ctx->stream));
+		ctx->stream->signal = SIGNAL_TYPE_DISPLAY_PORT;
+		dm_test_fill_fs_mode(ctx->mode, layouts[i]);
+		fill_stream_properties_from_drm_display_mode(ctx->stream, ctx->mode,
+			&ctx->aconnector->base, ctx->conn_state, NULL, 8,
+			PIXEL_ENCODING_RGB, false);
+
+		KUNIT_EXPECT_EQ_MSG(test, (int)ctx->stream->timing.timing_3d_format, format,
+				    "layout 0x%x", layouts[i]);
+		KUNIT_EXPECT_EQ_MSG(test, (int)ctx->stream->view_format, view,
+				    "layout 0x%x", layouts[i]);
+	}
+}
+
+/**
+ * dm_test_vsc_sdp_frame_sequential - Test the VSC SDP of a frame-sequential stream
+ * @test: The KUnit test context
+ *
+ * mod_build_vsc_infopacket() on the stream of a frame-sequential mode sends
+ * VSC SDP revision 1 (HB0 00h, HB1 07h, HB2 01h, HB3 01h) with DB0 0x01,
+ * "Frame/Field Sequential, L + R view indication based on MISC1 bit 2:1" (DP
+ * 1.2, as info_packet.c quotes it); with VSC colorimetry, revision 5 (HB2 05h,
+ * HB3 13h) with the same DB0. The stream of the 2D mode sends no VSC SDP.
+ */
+static void dm_test_vsc_sdp_frame_sequential(struct kunit *test)
+{
+	struct dm_test_fill_ctx *ctx = dm_test_fill_ctx_alloc(test);
+	struct dc_info_packet *packet;
+	struct dc_link *link;
+	int colorimetry;
+
+	link = kunit_kzalloc(test, sizeof(*link), GFP_KERNEL);
+	packet = kunit_kzalloc(test, sizeof(*packet), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, link);
+	KUNIT_ASSERT_NOT_NULL(test, packet);
+	/* a DisplayPort link as link_factory.c constructs it: no PSR, no replay */
+	link->psr_settings.psr_version = DC_PSR_VERSION_UNSUPPORTED;
+	link->replay_settings.config.replay_version = DC_REPLAY_VERSION_UNSUPPORTED;
+
+	for (colorimetry = 0; colorimetry < 2; colorimetry++) {
+		memset(ctx->stream, 0, sizeof(*ctx->stream));
+		ctx->stream->signal = SIGNAL_TYPE_DISPLAY_PORT;
+		ctx->stream->link = link;
+		ctx->stream->use_vsc_sdp_for_colorimetry = colorimetry;
+		dm_test_fill_fs_mode(ctx->mode, DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL);
+		fill_stream_properties_from_drm_display_mode(ctx->stream, ctx->mode,
+			&ctx->aconnector->base, ctx->conn_state, NULL, 8,
+			PIXEL_ENCODING_RGB, false);
+
+		memset(packet, 0, sizeof(*packet));
+		mod_build_vsc_infopacket(ctx->stream, packet, ctx->stream->output_color_space,
+					 TRANSFER_FUNC_UNKNOWN);
+
+		KUNIT_EXPECT_TRUE(test, packet->valid);
+		KUNIT_EXPECT_EQ(test, packet->hb0, 0x00);
+		KUNIT_EXPECT_EQ(test, packet->hb1, 0x07);
+		KUNIT_EXPECT_EQ(test, packet->hb2, colorimetry ? 0x05 : 0x01);
+		KUNIT_EXPECT_EQ(test, packet->hb3, colorimetry ? 0x13 : 0x01);
+		KUNIT_EXPECT_EQ_MSG(test, packet->sb[0], 0x01, "colorimetry %d", colorimetry);
+	}
+
+	memset(ctx->stream, 0, sizeof(*ctx->stream));
+	ctx->stream->signal = SIGNAL_TYPE_DISPLAY_PORT;
+	ctx->stream->link = link;
+	dm_test_fill_fs_mode(ctx->mode, 0);
+	fill_stream_properties_from_drm_display_mode(ctx->stream, ctx->mode,
+		&ctx->aconnector->base, ctx->conn_state, NULL, 8,
+		PIXEL_ENCODING_RGB, false);
+	memset(packet, 0, sizeof(*packet));
+	mod_build_vsc_infopacket(ctx->stream, packet, ctx->stream->output_color_space,
+				 TRANSFER_FUNC_UNKNOWN);
+	KUNIT_EXPECT_FALSE(test, packet->valid);
+	KUNIT_EXPECT_EQ(test, packet->sb[0], 0x00);
+}
+
+static void dm_test_setup_stereo(struct pipe_ctx *pipe_ctx, struct dc *dc)
+{
+}
+
+static enum dp_link_encoding dm_test_encoding_format(const struct dc_link_settings *settings)
+{
+	return settings->link_rate >= LINK_RATE_UHBR10 ?
+		DP_128b_132b_ENCODING : DP_8b_10b_ENCODING;
+}
+
+struct dm_test_fs_link {
+	struct dc *dc;
+	struct link_service *link_srv;
+	struct dc_link *link;
+	struct dc_sink *sink;
+};
+
+/* A DCN link at HBR2 to a single-stream DisplayPort sink, no converter */
+static struct dm_test_fs_link *dm_test_fs_link_alloc(struct kunit *test)
+{
+	struct dm_test_fs_link *fs = kunit_kzalloc(test, sizeof(*fs), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, fs);
+	fs->dc = kunit_kzalloc(test, sizeof(*fs->dc), GFP_KERNEL);
+	fs->link_srv = kunit_kzalloc(test, sizeof(*fs->link_srv), GFP_KERNEL);
+	fs->link = kunit_kzalloc(test, sizeof(*fs->link), GFP_KERNEL);
+	fs->sink = kunit_kzalloc(test, sizeof(*fs->sink), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, fs->dc);
+	KUNIT_ASSERT_NOT_NULL(test, fs->link_srv);
+	KUNIT_ASSERT_NOT_NULL(test, fs->link);
+	KUNIT_ASSERT_NOT_NULL(test, fs->sink);
+
+	fs->dc->hwss.setup_stereo = dm_test_setup_stereo;
+	fs->link_srv->dp_get_encoding_format = dm_test_encoding_format;
+	fs->dc->link_srv = fs->link_srv;
+	fs->link->dc = fs->dc;
+	fs->link->verified_link_cap.link_rate = LINK_RATE_HIGH2;
+	fs->link->dpcd_caps.dongle_type = DISPLAY_DONGLE_NONE;
+	fs->link->psr_settings.psr_version = DC_PSR_VERSION_UNSUPPORTED;
+	fs->link->replay_settings.config.replay_version = DC_REPLAY_VERSION_UNSUPPORTED;
+	fs->sink->sink_signal = SIGNAL_TYPE_DISPLAY_PORT;
+
+	return fs;
+}
+
+/**
+ * dm_test_link_sends_frame_sequential - Test which links send frame-sequential stereo
+ * @test: The KUnit test context
+ *
+ * A DCN link at HBR2 to a single-stream DisplayPort sink sends it. Refused:
+ * DCE (no setup_stereo), the MST, eDP, HDMI (a DP++ adaptor) and DVI signals,
+ * no sink, no link, a VGA, DVI or HDMI protocol converter, a 128b/132b link,
+ * Panel Replay, and a DC without its link service.
+ */
+static void dm_test_link_sends_frame_sequential(struct kunit *test)
+{
+	static const enum signal_type refused_signals[] = {
+		SIGNAL_TYPE_DISPLAY_PORT_MST,
+		SIGNAL_TYPE_EDP,
+		SIGNAL_TYPE_HDMI_TYPE_A,
+		SIGNAL_TYPE_DVI_SINGLE_LINK,
+		SIGNAL_TYPE_VIRTUAL,
+	};
+	static const enum display_dongle_type converters[] = {
+		DISPLAY_DONGLE_DP_VGA_CONVERTER,
+		DISPLAY_DONGLE_DP_DVI_CONVERTER,
+		DISPLAY_DONGLE_DP_HDMI_CONVERTER,
+	};
+	struct dm_test_fs_link *fs = dm_test_fs_link_alloc(test);
+	int i;
+
+	KUNIT_EXPECT_TRUE(test, dm_link_sends_frame_sequential(fs->link, fs->sink));
+
+	fs->dc->hwss.setup_stereo = NULL;
+	KUNIT_EXPECT_FALSE(test, dm_link_sends_frame_sequential(fs->link, fs->sink));
+	fs->dc->hwss.setup_stereo = dm_test_setup_stereo;
+
+	for (i = 0; i < ARRAY_SIZE(refused_signals); i++) {
+		fs->sink->sink_signal = refused_signals[i];
+		KUNIT_EXPECT_FALSE_MSG(test, dm_link_sends_frame_sequential(fs->link, fs->sink),
+				       "signal %d", refused_signals[i]);
+	}
+	fs->sink->sink_signal = SIGNAL_TYPE_DISPLAY_PORT;
+
+	KUNIT_EXPECT_FALSE(test, dm_link_sends_frame_sequential(fs->link, NULL));
+	KUNIT_EXPECT_FALSE(test, dm_link_sends_frame_sequential(NULL, fs->sink));
+
+	for (i = 0; i < ARRAY_SIZE(converters); i++) {
+		fs->link->dpcd_caps.dongle_type = converters[i];
+		KUNIT_EXPECT_FALSE_MSG(test, dm_link_sends_frame_sequential(fs->link, fs->sink),
+				       "dongle %d", converters[i]);
+	}
+	fs->link->dpcd_caps.dongle_type = DISPLAY_DONGLE_NONE;
+
+	fs->link->verified_link_cap.link_rate = LINK_RATE_UHBR10;
+	KUNIT_EXPECT_FALSE(test, dm_link_sends_frame_sequential(fs->link, fs->sink));
+	fs->link->verified_link_cap.link_rate = LINK_RATE_HIGH2;
+
+	fs->link->replay_settings.config.replay_version = DC_VESA_PANEL_REPLAY;
+	KUNIT_EXPECT_FALSE(test, dm_link_sends_frame_sequential(fs->link, fs->sink));
+	fs->link->replay_settings.config.replay_version = DC_REPLAY_VERSION_UNSUPPORTED;
+	KUNIT_EXPECT_TRUE(test, dm_link_sends_frame_sequential(fs->link, fs->sink));
+
+	fs->dc->link_srv = NULL;
+	KUNIT_EXPECT_FALSE(test, dm_link_sends_frame_sequential(fs->link, fs->sink));
+}
+
+/**
+ * dm_test_connector_can_send_frame_sequential - Test which connectors opt in
+ * @test: The KUnit test context
+ *
+ * A DisplayPort connector of a DCN opts in to frame-sequential modes; one of
+ * a DCE, an MST port, a connector without a link, and eDP, HDMI, DVI and VGA
+ * connectors do not.
+ */
+static void dm_test_connector_can_send_frame_sequential(struct kunit *test)
+{
+	struct amdgpu_dm_connector *aconnector;
+	struct dm_test_fs_link *fs = dm_test_fs_link_alloc(test);
+
+	aconnector = kunit_kzalloc(test, sizeof(*aconnector), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, aconnector);
+	aconnector->dc_link = fs->link;
+
+	KUNIT_EXPECT_TRUE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_DisplayPort));
+	KUNIT_EXPECT_FALSE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_eDP));
+	KUNIT_EXPECT_FALSE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_HDMIA));
+	KUNIT_EXPECT_FALSE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_DVID));
+	KUNIT_EXPECT_FALSE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_VGA));
+
+	fs->dc->hwss.setup_stereo = NULL;
+	KUNIT_EXPECT_FALSE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_DisplayPort));
+	fs->dc->hwss.setup_stereo = dm_test_setup_stereo;
+
+	aconnector->mst_root = aconnector;
+	KUNIT_EXPECT_FALSE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_DisplayPort));
+	aconnector->mst_root = NULL;
+
+	aconnector->dc_link = NULL;
+	KUNIT_EXPECT_FALSE(test, dm_connector_can_send_frame_sequential(aconnector,
+							DRM_MODE_CONNECTOR_DisplayPort));
+}
+
+/**
+ * dm_test_mode_valid_frame_sequential - Test the frame-sequential mode filter
+ * @test: The KUnit test context
+ *
+ * A frame-sequential mode passes the stereo check on a DCN link to a
+ * DisplayPort sink and goes on to stream validation (which fails here,
+ * MODE_ERROR, as the test has no device); on DCE, an MST, eDP or HDMI sink and
+ * behind an HDMI protocol converter it is refused with MODE_NO_STEREO before
+ * any stream is built.
+ */
+static void dm_test_mode_valid_frame_sequential(struct kunit *test)
+{
+	static const enum signal_type refused_signals[] = {
+		SIGNAL_TYPE_DISPLAY_PORT_MST,
+		SIGNAL_TYPE_EDP,
+		SIGNAL_TYPE_HDMI_TYPE_A,
+	};
+	struct dm_test_fs_link *fs = dm_test_fs_link_alloc(test);
+	struct amdgpu_dm_connector *aconnector;
+	struct drm_display_mode *mode;
+	int i;
+
+	aconnector = kunit_kzalloc(test, sizeof(*aconnector), GFP_KERNEL);
+	mode = kunit_kzalloc(test, sizeof(*mode), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, aconnector);
+	KUNIT_ASSERT_NOT_NULL(test, mode);
+	aconnector->dc_link = fs->link;
+	aconnector->dc_sink = fs->sink;
+	dm_test_fill_fs_mode(mode, DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL);
+
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_connector_mode_valid(&aconnector->base, mode),
+			MODE_ERROR);
+
+	fs->dc->hwss.setup_stereo = NULL;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_connector_mode_valid(&aconnector->base, mode),
+			MODE_NO_STEREO);
+	fs->dc->hwss.setup_stereo = dm_test_setup_stereo;
+
+	for (i = 0; i < ARRAY_SIZE(refused_signals); i++) {
+		fs->sink->sink_signal = refused_signals[i];
+		KUNIT_EXPECT_EQ_MSG(test, amdgpu_dm_connector_mode_valid(&aconnector->base, mode),
+				    MODE_NO_STEREO, "signal %d", refused_signals[i]);
+	}
+	fs->sink->sink_signal = SIGNAL_TYPE_DISPLAY_PORT;
+
+	fs->link->dpcd_caps.dongle_type = DISPLAY_DONGLE_DP_HDMI_CONVERTER;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_connector_mode_valid(&aconnector->base, mode),
+			MODE_NO_STEREO);
+}
+
 /**
  * dm_test_hdmi_cec_set_edid_no_notifier - Test the no-notifier no-op path
  * @test: The KUnit test context
@@ -6024,6 +6419,14 @@ static struct kunit_case amdgpu_dm_connector_tests[] = {
 	KUNIT_CASE(dm_test_sink_signals_hdmi_3d),
 	/* dm_connector_can_carry_hdmi */
