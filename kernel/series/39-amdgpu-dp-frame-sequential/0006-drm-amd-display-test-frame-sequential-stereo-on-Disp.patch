+/* Frame-sequential stereo: one eye per frame from a side by side frame */
+
+struct dm_test_fs_ctx {
+	struct drm_plane *plane;
+	struct drm_framebuffer *fb;
+	struct drm_plane_state *state;
+	struct drm_crtc_state *crtc_state;
+};
+
+/*
+ * A 1920x1080 frame-sequential CRTC and its primary plane covering the
+ * 3840x1080 frame of both eyes from a linear XRGB8888 framebuffer: the plane
+ * amdgpu_dm_plane_check_frame_sequential() accepts.
+ */
+static struct dm_test_fs_ctx *dm_test_fs_ctx_alloc(struct kunit *test)
+{
+	struct dm_test_fs_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->plane = kunit_kzalloc(test, sizeof(*ctx->plane), GFP_KERNEL);
+	ctx->fb = kunit_kzalloc(test, sizeof(*ctx->fb), GFP_KERNEL);
+	ctx->state = kunit_kzalloc(test, sizeof(*ctx->state), GFP_KERNEL);
+	ctx->crtc_state = kunit_kzalloc(test, sizeof(*ctx->crtc_state), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->plane);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->fb);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->state);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->crtc_state);
+
+	ctx->plane->type = DRM_PLANE_TYPE_PRIMARY;
+	ctx->plane->name = "kunit-primary";
+
+	ctx->fb->format = drm_format_info(DRM_FORMAT_XRGB8888);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->fb->format);
+	ctx->fb->modifier = DRM_FORMAT_MOD_LINEAR;
+	ctx->fb->width = 3840;
+	ctx->fb->height = 1080;
+
+	ctx->crtc_state->enable = true;
+	ctx->crtc_state->mode.hdisplay = 1920;
+	ctx->crtc_state->mode.vdisplay = 1080;
+	ctx->crtc_state->mode.flags = DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL;
+
+	ctx->state->plane = ctx->plane;
+	ctx->state->fb = ctx->fb;
+	ctx->state->rotation = DRM_MODE_ROTATE_0;
+	ctx->state->src_w = 3840 << 16;
+	ctx->state->src_h = 1080 << 16;
+	ctx->state->crtc_w = 3840;
+	ctx->state->crtc_h = 1080;
+
+	return ctx;
+}
+
+/**
+ * dm_test_plane_check_frame_sequential - Test the plane a frame-sequential CRTC takes
+ * @test: The KUnit test context
+ *
+ * The primary plane covering the whole frame of both eyes, unscaled, from a
+ * linear XRGB8888 framebuffer is accepted; so is it with a 2560-wide eye in
+ * ARGB16161616F (an eye of 20480 bytes, 80 times 256). Each departure from it
+ * is refused: an overlay or cursor plane, a plane covering one eye or placed
+ * off the origin, a scaled or rotated one, a tiled framebuffer, a two-plane
+ * YUV framebuffer, an eye whose width in bytes is not a multiple of 256 (1366
+ * XRGB8888 pixels, 5464 bytes), and an asynchronous flip.
+ */
+static void dm_test_plane_check_frame_sequential(struct kunit *test)
+{
+	struct dm_test_fs_ctx *ctx = dm_test_fs_ctx_alloc(test);
+
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), 0);
+
+	ctx->fb->format = drm_format_info(DRM_FORMAT_ARGB16161616F);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->fb->format);
+	ctx->crtc_state->mode.hdisplay = 2560;
+	ctx->crtc_state->mode.vdisplay = 1440;
+	ctx->state->src_w = 5120 << 16;
+	ctx->state->src_h = 1440 << 16;
+	ctx->state->crtc_w = 5120;
+	ctx->state->crtc_h = 1440;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), 0);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->plane->type = DRM_PLANE_TYPE_OVERLAY;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+	ctx->plane->type = DRM_PLANE_TYPE_CURSOR;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->state->src_w = 1920 << 16;
+	ctx->state->crtc_w = 1920;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->state->crtc_x = 16;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->state->src_w = 1920 << 16;
+	ctx->state->src_h = 540 << 16;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->state->rotation = DRM_MODE_ROTATE_180;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->fb->modifier = AMD_FMT_MOD |
+		AMD_FMT_MOD_SET(TILE_VERSION, AMD_FMT_MOD_TILE_VER_GFX9) |
+		AMD_FMT_MOD_SET(TILE, AMD_FMT_MOD_TILE_GFX9_64K_S_X);
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->fb->format = drm_format_info(DRM_FORMAT_NV12);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->fb->format);
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->crtc_state->mode.hdisplay = 1366;
+	ctx->crtc_state->mode.vdisplay = 768;
+	ctx->state->src_w = 2732 << 16;
+	ctx->state->src_h = 768 << 16;
+	ctx->state->crtc_w = 2732;
+	ctx->state->crtc_h = 768;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+
+	ctx = dm_test_fs_ctx_alloc(test);
+	ctx->crtc_state->async_flip = true;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+}
+
+/**
+ * dm_test_plane_check_frame_sequential_other_crtcs - Only frame-sequential CRTCs are limited
+ * @test: The KUnit test context
+ *
+ * An overlay plane covering one eye's width, tiled, which a frame-sequential
+ * CRTC refuses, is accepted on a 2D CRTC, on a CRTC with an HDMI 3D layout and
+ * on a disabled frame-sequential CRTC, and a plane without a framebuffer is
+ * never checked.
+ */
+static void dm_test_plane_check_frame_sequential_other_crtcs(struct kunit *test)
+{
+	struct dm_test_fs_ctx *ctx = dm_test_fs_ctx_alloc(test);
+
+	ctx->plane->type = DRM_PLANE_TYPE_OVERLAY;
+	ctx->state->src_w = 1920 << 16;
+	ctx->state->crtc_w = 1920;
+	ctx->fb->modifier = AMD_FMT_MOD |
+		AMD_FMT_MOD_SET(TILE_VERSION, AMD_FMT_MOD_TILE_VER_GFX9) |
+		AMD_FMT_MOD_SET(TILE, AMD_FMT_MOD_TILE_GFX9_64K_S_X);
+
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), -EINVAL);
+	ctx->crtc_state->mode.flags = 0;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), 0);
+	ctx->crtc_state->mode.flags = DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), 0);
+	ctx->crtc_state->mode.flags = DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL;
+	ctx->crtc_state->enable = false;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), 0);
+	ctx->crtc_state->enable = true;
+	ctx->state->fb = NULL;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_check_frame_sequential(ctx->state,
+								     ctx->crtc_state), 0);
+}
+
+/**
+ * dm_test_atomic_check_frame_sequential_cursor - Test the check runs in atomic_check
+ * @test: KUnit test context.
+ *
+ * A plane without a DC plane state, as the cursor plane is, passes atomic_check
+ * on a 2D CRTC and is refused on a frame-sequential one, before DC is asked.
+ */
+static void dm_test_atomic_check_frame_sequential_cursor(struct kunit *test)
+{
+	struct amdgpu_device *adev;
+	struct drm_atomic_commit *state;
+	struct drm_plane *plane;
+	struct dm_plane_state *dm_plane_state;
+	struct drm_crtc_state *new_crtc_state;
+	struct drm_framebuffer *fb;
+
+	adev = dm_test_init_atomic_check_state(test, &state, &plane, &dm_plane_state,
+					       &new_crtc_state, &fb);
+	KUNIT_ASSERT_NOT_NULL(test, adev);
+	plane->type = DRM_PLANE_TYPE_CURSOR;
+	dm_plane_state->dc_state = NULL;
+
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_atomic_check(plane, state), 0);
+
+	new_crtc_state->mode.hdisplay = 1920;
+	new_crtc_state->mode.vdisplay = 1080;
+	new_crtc_state->mode.flags = DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL;
+	KUNIT_EXPECT_EQ(test, amdgpu_dm_plane_atomic_check(plane, state), -EINVAL);
+}
+
+/**
+ * dm_test_plane_fill_frame_sequential - Test the stereo surface of a frame-sequential stream
+ * @test: The KUnit test context
+ *
+ * On a frame-sequential stream the plane's rectangles become the left half of
+ * the frame, and its address a stereo surface: the left eye at the
+ * framebuffer's address, the right eye 1920 XRGB8888 pixels (7680 bytes)
+ * further, frame alternate, each eye 1920 wide. A 2D stream keeps the
+ * graphics address and the whole rectangles.
+ */
+static void dm_test_plane_fill_frame_sequential(struct kunit *test)
+{
+	const u64 base = 0x812340000ULL;
+	struct dc_stream_state *stream;
+	struct dc_scaling_info *scaling;
+	struct dc_plane_info *info;
+	struct dc_plane_address *address;
+	struct drm_framebuffer *fb;
+	int pass;
+
+	stream = kunit_kzalloc(test, sizeof(*stream), GFP_KERNEL);
+	scaling = kunit_kzalloc(test, sizeof(*scaling), GFP_KERNEL);
+	info = kunit_kzalloc(test, sizeof(*info), GFP_KERNEL);
+	address = kunit_kzalloc(test, sizeof(*address), GFP_KERNEL);
+	fb = kunit_kzalloc(test, sizeof(*fb), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, stream);
+	KUNIT_ASSERT_NOT_NULL(test, scaling);
+	KUNIT_ASSERT_NOT_NULL(test, info);
+	KUNIT_ASSERT_NOT_NULL(test, address);
+	KUNIT_ASSERT_NOT_NULL(test, fb);
+	fb->format = drm_format_info(DRM_FORMAT_XRGB8888);
+	KUNIT_ASSERT_NOT_NULL(test, fb->format);
+	stream->src.width = 1920;
+	stream->src.height = 1080;
+
+	for (pass = 0; pass < 2; pass++) {
+		bool fs = pass == 1;
+
+		stream->view_format = fs ? VIEW_3D_FORMAT_FRAME_SEQUENTIAL : VIEW_3D_FORMAT_NONE;
+		memset(scaling, 0, sizeof(*scaling));
+		scaling->src_rect.width = 3840;
+		scaling->src_rect.height = 1080;
+		scaling->dst_rect = scaling->src_rect;
+		scaling->clip_rect = scaling->src_rect;
+		memset(info, 0, sizeof(*info));
+		info->plane_size.surface_size.width = 3840;
+		info->plane_size.surface_size.height = 1080;
+		info->plane_size.surface_pitch = 3840;
+		memset(address, 0, sizeof(*address));
+		address->type = PLN_ADDR_TYPE_GRAPHICS;
+		address->grph.addr.quad_part = base;
+
+		amdgpu_dm_plane_fill_frame_sequential_scaling(stream, scaling);
+		amdgpu_dm_plane_fill_frame_sequential_address(stream, fb, info, address);
+
+		KUNIT_EXPECT_EQ_MSG(test, scaling->src_rect.width, fs ? 1920 : 3840,
+				    "pass %d", pass);
+		KUNIT_EXPECT_EQ(test, scaling->src_rect.height, 1080);
+		KUNIT_EXPECT_EQ(test, scaling->dst_rect.width, fs ? 1920 : 3840);
+		KUNIT_EXPECT_EQ(test, scaling->clip_rect.width, fs ? 1920 : 3840);
+		KUNIT_EXPECT_EQ(test, info->plane_size.surface_size.width, fs ? 1920 : 3840);
+		KUNIT_EXPECT_EQ(test, info->plane_size.surface_pitch, 3840);
+
+		if (fs) {
+			KUNIT_EXPECT_EQ(test, address->type, PLN_ADDR_TYPE_GRPH_STEREO);
+			KUNIT_EXPECT_EQ(test, info->stereo_format,
+					PLANE_STEREO_FORMAT_FRAME_ALTERNATE);
+			KUNIT_EXPECT_EQ(test, address->grph_stereo.left_addr.quad_part, base);
+			KUNIT_EXPECT_EQ(test, address->grph_stereo.right_addr.quad_part,
+					base + 1920 * 4);
+			KUNIT_EXPECT_EQ(test, address->grph_stereo.left_meta_addr.quad_part, 0);
+			KUNIT_EXPECT_EQ(test, address->grph_stereo.right_meta_addr.quad_part, 0);
+		} else {
+			KUNIT_EXPECT_EQ(test, address->type, PLN_ADDR_TYPE_GRAPHICS);
+			KUNIT_EXPECT_EQ(test, info->stereo_format, PLANE_STEREO_FORMAT_NONE);
+			KUNIT_EXPECT_EQ(test, address->grph.addr.quad_part, base);
+		}
+	}
+
+	/* no stream: nothing changes */
+	scaling->src_rect.width = 3840;
+	amdgpu_dm_plane_fill_frame_sequential_scaling(NULL, scaling);
+	KUNIT_EXPECT_EQ(test, scaling->src_rect.width, 3840);
+}
