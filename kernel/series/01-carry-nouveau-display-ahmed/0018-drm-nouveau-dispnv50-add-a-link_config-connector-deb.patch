index cb65cd3b7e2a32c3a3ffded92a9e92ca634673d9..742d00f49eccc02c7e8a2e5fa2b13b657b33bed9 100644
--- a/drivers/gpu/drm/nouveau/nouveau_connector.h
+++ b/drivers/gpu/drm/nouveau/nouveau_connector.h
@@ -201,6 +201,8 @@ nouveau_crtc_connector_get(struct nouveau_crtc *nv_crtc)
 struct drm_connector *
 nouveau_connector_create(struct drm_device *, int id);
 unsigned int nouveau_connector_tmds_link_bandwidth(struct drm_connector *);
