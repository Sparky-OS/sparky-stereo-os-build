# Sparky Stereo OS kernel: configuration fragment (Step 2, 2026-10-08).
#
# Base: Debian linux-config-7.2 7.2.9-1, file config.amd64_none_amd64 (the rt flavour starts from config.amd64_none_rt-amd64),
# then `make olddefconfig` on the patched 7.3 tree, then this fragment (scripts/kconfig/merge_config.sh), then olddefconfig again.
# Every option has a one-line reason above it. "pin" means: same value as Debian's, written down because a decision depends on it.
# scripts/cfgreasons.py turns this file into the table of deviations (value here, value in Debian, reason) and checks that every
# option holds in the final .config.

# ======================================================================================
# 1. Rebuild basics
# ======================================================================================
# No extra certificates are built into the kernel: Debian passes its own certificate files when it builds (its config file has no value), a rebuild outside Debian must not pick any up; the per-build module key is added by the build itself.
CONFIG_SYSTEM_TRUSTED_KEYS=""
# Secure Boot makes the kernel enforce module signatures (IMA_ARCH_POLICY, with no lockdown patch), so every in-tree module is signed during the build with the per-build key, which the recipe deletes after packaging; Debian signs in a later step instead.
CONFIG_MODULE_SIG_ALL=y
# pin: unsigned modules still load when Secure Boot is off (DKMS on a machine without Secure Boot).
# CONFIG_MODULE_SIG_FORCE is not set
# Build resource, no effect on what is shipped: the DWARF that the objects of the build tree carry (the BTF of vmlinux and of the modules is generated from it) is zstd-compressed, which makes the tree
# much smaller (the shared build disk has little room) for a few percent of build time. Debian's value is no compression; BTF generation from compressed DWARF is exercised by tests/package-smoke.sh.
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y

# ======================================================================================
# 2. Secure Boot without losing hibernation (Daniel, 2026-10-08)
# ======================================================================================
# pin: no lockdown unless the boot command line asks for it (lockdown=integrity); Debian's patch that locks down under Secure Boot is not carried, so LOCK_DOWN_IN_EFI_SECURE_BOOT does not exist.
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
# pin: the lockdown LSM stays built in so lockdown=integrity and lockdown=confidentiality work as boot options.
CONFIG_SECURITY_LOCKDOWN_LSM=y
# pin: lockdown is initialised early enough for the boot option.
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# pin: under Secure Boot security/integrity/ima/ima_efi.c calls set_module_sig_enforced() and set_kexec_sig_enforced(), so modules and kexec stay signature-enforced without lockdown.
CONFIG_IMA_ARCH_POLICY=y
# pin: kexec_file_load() can check signatures (set_kexec_sig_enforced() needs it).
CONFIG_KEXEC_SIG=y
# pin: keys in the UEFI db and in shim's MokListRT land in the platform keyring.
CONFIG_INTEGRITY_PLATFORM_KEYRING=y
# pin: keys that shim marks as trusted by the kernel go to the machine keyring.
CONFIG_INTEGRITY_MACHINE_KEYRING=y
# pin: load the UEFI db / MokListRT certificates at boot.
CONFIG_LOAD_UEFI_KEYS=y
# pin: module verification also uses the secondary trusted keyring.
CONFIG_SECONDARY_TRUSTED_KEYRING=y
# pin: hibernation is a requirement of the edition.
CONFIG_HIBERNATION=y

# ======================================================================================
# 3. Options that exist because Debian's patches are carried (same values as Debian's config)
# ======================================================================================
# pin: perf_event_paranoid=3 level (series 04).
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
# pin: x32 syscalls off unless syscall.x32=y (series 07).
CONFIG_X86_X32_DISABLED=y
# pin: Intel IOMMU on, integrated GPU excluded, as Debian (series 06).
CONFIG_INTEL_IOMMU_DEFAULT_ON_INTGPU_OFF=y

# ======================================================================================
# 4. The brief
# ======================================================================================
# pin: Binder as a module, as Debian ships it (series 09); Waydroid loads binder_linux when no binderfs is registered.
CONFIG_ANDROID_BINDER_IPC=m
# binderfs is built into binder_linux so Waydroid can mount it and create the device nodes itself (Debian: off).
CONFIG_ANDROID_BINDERFS=y
# Waydroid needs all three nodes; Debian ships only "binder".
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# Sim rigs: Winwing panels and throttles (source in the tree, off in Debian).
CONFIG_HID_WINWING=m
# USB displays: Generic USB Display (gud), off in Debian.
CONFIG_DRM_GUD=m
# USB projectors with the GM12U320 chip, off in Debian.
CONFIG_DRM_GM12U320=m
# pin: NTFS, the new read-write driver; udisks2 tries ntfs3 first, then ntfs.
CONFIG_NTFS_FS=m
# NTFS3 (Paragon) as a module too; Debian has only the new driver.
CONFIG_NTFS3_FS=m
# NTFS3: LZX/XPRESS compressed files (Windows 10 system files and compact OS).
CONFIG_NTFS3_LZX_XPRESS=y
# NTFS3: POSIX ACLs.
CONFIG_NTFS3_FS_POSIX_ACL=y
# NTFS (new driver): POSIX ACLs.
CONFIG_NTFS_FS_POSIX_ACL=y
# pin: ECC error reporting of the newest Intel server memory controllers.
CONFIG_EDAC_IMH=m
# zram: zstd compresses better than lz4 (Debian's default) at a small CPU cost; the swap of handhelds and low-RAM machines.
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# ======================================================================================
# 5. Hardware drivers that the carried series adds or that are off in Debian
# ======================================================================================
# Zotac Zone controller (series 14): HID part.
CONFIG_ZOTAC_ZONE_HID=m
# Zotac Zone controller (series 14): platform part.
CONFIG_ZOTAC_ZONE_PLATFORM=m
# AYN handhelds embedded controller: fan, temperature sensors, RGB (series 15).
CONFIG_AYN_EC=m
# AYANEO 3 detachable controller (series 15).
CONFIG_HID_AYANEO=m
# AW87xxx audio amplifier of several AYANEO/AYN handhelds (series 16, tagged NOT-FOR-UPSTREAM by OGC).
CONFIG_SND_SOC_AW87XXX=m
# ASUS ROG Ally / Ally X gamepad configuration (series 17).
CONFIG_HID_ASUS_ALLY=m
# Valve Steam Machine / Steam Deck RGB LEDs (series 21).
CONFIG_LEDS_VALVE=m
# Steam Deck embedded controller: sensors (series 30).
CONFIG_SENSORS_STEAMDECK=m
# Steam Deck embedded controller: MFD core (series 30).
CONFIG_MFD_STEAMDECK=m
# Steam Deck LEDs (series 30).
CONFIG_LEDS_STEAMDECK=m
# Steam Deck extcon: DisplayPort alt-mode detection (series 30).
CONFIG_EXTCON_STEAMDECK=m
# Lenovo Legion Go (pin of a driver that is in the tree; fixes in series 18 are for the Go S).
CONFIG_HID_LENOVO_GO=m
# Lenovo Legion Go S controller (series 18).
CONFIG_HID_LENOVO_GO_S=m
# MSI Claw gamepad.
CONFIG_HID_MSI=m
# MSI WMI platform features.
CONFIG_MSI_WMI_PLATFORM=m
# OneXPlayer controller configuration.
CONFIG_HID_OXP=m
# OneXPlayer embedded controller (series 29 adds board ids and tablet mode).
CONFIG_OXP_EC=m
# AYANEO embedded controller.
CONFIG_AYANEO_EC=m
# ASUS Armoury (ROG power limits; series 17 fixes it).
CONFIG_ASUS_ARMOURY=m
# BMI270 IMU of gaming handhelds (series 19 adds PNP ids).
CONFIG_BMI270_I2C=m
# Chrome OS EC CEC for the Steam Machine (series 21).
CONFIG_CEC_CROS_EC=m
# Chrome OS EC sysfs: CEC wake and physical address (series 21).
CONFIG_CROS_EC_SYSFS=m
# MAX98390 amplifier on I2C for HD-audio laptops: the Samsung Galaxy Book 4/5 sound fixes (series 13) need it; off in Debian.
CONFIG_SND_HDA_SCODEC_MAX98390_I2C=m

# ======================================================================================
# 6. Audit: options Debian 7.2.9 leaves off or lacks (laptops, readers, sensors)
# ======================================================================================
# Cirrus CS42L43 pin controller (laptop audio).
CONFIG_PINCTRL_CS42L43=m
# Cirrus CS42L43 SPI.
CONFIG_SPI_CS42L43=m
# Alcor card reader (PCI).
CONFIG_MISC_ALCOR_PCI=m
# Alcor SD/MMC host.
CONFIG_MMC_ALCOR=m
# Netfilter hook list through netlink.
CONFIG_NETFILTER_NETLINK_HOOK=m
# PPS generator class.
CONFIG_PPS_GENERATOR=m
# PPS generator on Intel TIO.
CONFIG_PPS_GENERATOR_TIO=m
# Lontium LT6911UXE HDMI bridge (capture cards).
CONFIG_VIDEO_LT6911UXE=m
# Intel computer vision subsystem.
CONFIG_VIDEO_INTEL_CVS=m
# Lenovo EC sensors.
CONFIG_SENSORS_LENOVO_EC=m
# Yoga fan sensors.
CONFIG_SENSORS_YOGAFAN=m
# Intel SCU platform support.
CONFIG_INTEL_SCU_PLATFORM=m
# Intel PMC USB-C mux.
CONFIG_TYPEC_MUX_INTEL_PMC=m
# EROFS page cache sharing (image-based installs).
CONFIG_EROFS_FS_PAGE_CACHE_SHARE=y
# Contiguous memory allocator, as Debian 7.2.2 enabled it (cameras, capture, some GPUs).
CONFIG_CMA=y
# CMA statistics in sysfs.
CONFIG_CMA_SYSFS=y
# DMA allocations from CMA.
CONFIG_DMA_CMA=y
# One CMA area per NUMA node.
CONFIG_DMA_NUMA_CMA=y
# /proc/<pid>/mem keeps the ptrace access rule (hardening that Debian enables).
CONFIG_PROC_MEM_FORCE_PTRACE=y
# Rust in the kernel: Debian 7.2.9 has it; the build container has rustc, rust-src and bindgen.
CONFIG_RUST=y
# Rust QR-code panic screen (needs RUST).
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
# Rust PHY driver, as Debian.
CONFIG_AX88796B_RUST_PHY=y
# Rust PHY driver, as Debian.
CONFIG_AMCC_QT2025_PHY=m

# ======================================================================================
# 7. Series options (defaults are on; written down so a later Kconfig change cannot switch them off silently)
# ======================================================================================
# BORE scheduler (series 10); runtime switch kernel.sched_bore.
CONFIG_SCHED_BORE=y
# POC idle-CPU selector (series 26); runtime switch kernel.sched_poc_selector.
CONFIG_SCHED_POC_SELECTOR=y
# ADIOS I/O scheduler as a module (series 25); not the default scheduler.
CONFIG_MQ_IOSCHED_ADIOS=m
# BBRv3 congestion control as a module named bbr3 (series 28); cubic stays the default.
CONFIG_TCP_CONG_BBR3=m

# ======================================================================================
# 8. Gaming tuning, config only (CachyOS config vs Debian 7.2.9)
# ======================================================================================
# pin: dmem cgroup controller OFF (Debian's value). Linux 7.3 changed dmem_cgroup_register_region() to take a struct dmem_cgroup_init,
# and NVIDIA's open modules 615.71.09 still call the old form, so they do not compile with it on (os-interface.c:3031): a kernel that breaks the NVIDIA DKMS package is not an easy win.
# Turn it on only when NVIDIA's own release handles the 7.3 signature (a compat patch for 615.71.09 is kept in the kernel-soul lane, work/nvidia-dmem/).
# CONFIG_CGROUP_DMEM is not set
# Core scheduling: cookies keep untrusted tasks from sharing an SMT core (containers, browsers).
CONFIG_SCHED_CORE=y
# AMD 3D V-Cache mode switch (7950X3D class): lets games stay on the cache CCD.
CONFIG_AMD_3D_VCACHE=y
# AMD heterogeneous core feedback (hybrid Zen 5 / Zen 6 scheduling hints).
CONFIG_AMD_HFI=y
# Timer-events-oriented idle governor: fewer wrong deep-idle choices than menu, lower wake-up latency.
CONFIG_CPU_IDLE_GOV_TEO=y
# Posted MSI interrupts (Intel): fewer interrupts for NVMe and NICs under load.
CONFIG_X86_POSTED_MSI=y
# Power-efficient workqueue defaults (laptops, handhelds).
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# DualPI2 qdisc (L4S low-latency networking), module.
CONFIG_NET_SCH_DUALPI2=m
# I/O latency cgroup controller (systemd resource control).
CONFIG_BLK_CGROUP_IOLATENCY=y
# I/O priority cgroup controller.
CONFIG_BLK_CGROUP_IOPRIO=y
# 1000 Hz timer tick: finer scheduling granularity for games and audio (CachyOS, Liquorix, Valve); the idle tick still stops (NO_HZ_FULL).
CONFIG_HZ_1000=y
# the 250 Hz choice is replaced by the 1000 Hz one above.
# CONFIG_HZ_250 is not set
# HZ follows the choice (written so the value is checked).
CONFIG_HZ=1000

# ======================================================================================
# 9. Decisions of the earlier lanes (kernel/configure.sh of 2026-10-05 and 2026-10-06), carried over
# ======================================================================================
# Realtek Wi-Fi 6 / 6E USB adapter RTL8852AU: in the tree, off in Debian.
CONFIG_RTW89_8852AU=m
# Realtek Wi-Fi 6E USB adapter RTL8852CU.
CONFIG_RTW89_8852CU=m
# Realtek Wi-Fi 7 USB adapter RTL8922AU.
CONFIG_RTW89_8922AU=m
# Realtek Wi-Fi 7 PCIe card RTL8922DE.
CONFIG_RTW89_8922DE=m
# VKMS (virtual KMS) as a module for KWin's DRM tests (Daniel, 2026-10-06); loaded only where needed.
CONFIG_DRM_VKMS=m
# pin: BTF type information (made by pahole from DWARF) for sched_ext and for BPF programs built against the running kernel.
CONFIG_DEBUG_INFO_BTF=y
# pin: DWARF at the toolchain's default, the setting BTF needs (DEBUG_INFO_REDUCED and DEBUG_INFO_SPLIT forbid BTF).
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# pin: the extensible scheduling class (scx schedulers).
CONFIG_SCHED_CLASS_EXT=y
