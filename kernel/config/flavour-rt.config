# Real-time flavour (Debian's rt-amd64 config as base, plus sparky-stereo.config): for audio production (JACK / PipeWire at RT priority).
# Facts for the package description: DRM_I915 does not exist on PREEMPT_RT (its Kconfig says depends on !PREEMPT_RT), so older Intel graphics
# need the xe driver (DRM_XE=m is on) or another kernel; NVIDIA's open kernel modules build here only with IGNORE_PREEMPT_RT_PRESENCE=1.
# pin: full real-time preemption.
CONFIG_PREEMPT_RT=y
# pin: priority boosting of RCU readers, part of Debian's rt-amd64 config.
CONFIG_RCU_BOOST=y
