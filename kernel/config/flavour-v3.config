# x86-64-v3 flavour (series 90): the kernel and its modules are compiled for CPUs with AVX2, BMI2, MOVBE (Haswell / Zen 1 and newer).
# Selects the generic CPU family with ISA level 3: -march=x86-64-v3 for C and -Ctarget-cpu=x86-64-v3 for Rust.
CONFIG_GENERIC_CPU=y
# ISA level 3 (v2 = SSE4.2, v3 = AVX2, v4 = AVX-512 is not offered by the series).
CONFIG_X86_64_VERSION=3
