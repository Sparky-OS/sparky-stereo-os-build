 	uint8_t  commands[64];
 	uint8_t  max_page;
 	uint8_t  features[8];
@@ -655,6 +656,30 @@ static void btdev_init_param(struct btdev *btdev)
 	btdev->country_code = 0x00;
 }
 
+/* Test aid: BTDEV_IDENTITY=VER:MANUFACTURER:HCI_REV:LMP_SUBVER:SCO_MTU:SCO_PKTS
+ * (hexadecimal) makes a BR/EDR device answer Read Local Version and Read
+ * Buffer Size as that controller does, also after HCI_Reset.
+ */
+static void btdev_apply_identity(struct btdev *btdev)
+{
+	const char *id = getenv("BTDEV_IDENTITY");
+	unsigned int ver, manufacturer, rev, subver, mtu, pkts;
+
+	btdev->lmp_subver = btdev->revision;
+
+	if (btdev->type != BTDEV_TYPE_BREDR || !id ||
+	    sscanf(id, "%x:%x:%x:%x:%x:%x", &ver, &manufacturer, &rev,
+				&subver, &mtu, &pkts) != 6)
+		return;
+
+	btdev->version = ver;
+	btdev->manufacturer = manufacturer;
+	btdev->revision = rev;
+	btdev->lmp_subver = subver;
+	btdev->sco_mtu = mtu;
+	btdev->sco_max_pkt = pkts;
+}
