# Configuration of the packaging smoke test (tests/package-smoke.sh): a tiny kernel that goes through the same bindeb-pkg, signing, BTF and headers steps as the real build
# in a few minutes. Merged on top of `make tinyconfig`.
CONFIG_64BIT=y
CONFIG_MODULES=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_XZ=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_BPF_SYSCALL=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_LOCALVERSION=""
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y
