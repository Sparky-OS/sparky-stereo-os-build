+static void test_mode_listed(data_t *data)
+{
+	drmModeConnector *c = drmModeGetConnector(data->fd, data->conn_id);
+	drmModeConnector *plain;
+	drmModeFB2 *fb;
+	unsigned int fb_id;
+	int fd, n_fs = 0;
+
+	igt_assert(c);
+	igt_assert_f(c->connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+		     c->connector_type == DRM_MODE_CONNECTOR_eDP,
+		     "frame-sequential modes on a connector of type %d\n", c->connector_type);
+
+	for (int i = 0; i < c->count_modes; i++) {
+		bool twin = false;
+
+		if (!is_frame_sequential(&c->modes[i]))
+			continue;
+
+		for (int j = 0; j < c->count_modes; j++)
+			twin |= !(c->modes[j].flags & DRM_MODE_FLAG_3D_MASK) &&
+				same_timing(&c->modes[i], &c->modes[j]);
+
+		igt_info("frame-sequential mode: %dx%d %d Hz clock %d\n",
+			 c->modes[i].hdisplay, c->modes[i].vdisplay, c->modes[i].vrefresh,
+			 c->modes[i].clock);
+		kmstest_dump_mode(&c->modes[i]);
+		igt_assert_f(twin, "%s has no 2D twin\n", c->modes[i].name);
+		n_fs++;
+	}
+	igt_assert_lt(0, n_fs);
+	drmModeFreeConnector(c);
+
+	/* IGT's own stereo framebuffer for the mode holds both eyes side by side */
+	fb_id = igt_create_stereo_fb(data->fd, &data->fs_mode, DRM_FORMAT_XRGB8888,
+				     DRM_FORMAT_MOD_LINEAR);
+	fb = drmModeGetFB2(data->fd, fb_id);
+	igt_assert(fb);
+	igt_assert_eq(fb->width, 2 * data->fs_mode.hdisplay);
+	igt_assert_eq(fb->height, data->fs_mode.vdisplay);
+	drmModeFreeFB2(fb);
+	drmModeRmFB(data->fd, fb_id);
+
+	/* Hidden from clients that do not ask for stereo modes */
+	fd = drm_open_driver(DRIVER_ANY);
+	plain = drmModeGetConnectorCurrent(fd, data->conn_id);
+	igt_assert(plain);
+	for (int i = 0; i < plain->count_modes; i++)
+		igt_assert(!(plain->modes[i].flags & DRM_MODE_FLAG_3D_MASK));
+	drmModeFreeConnector(plain);
+	drm_close_driver(fd);
+}
+
+/* A CRTC @conn_id can drive, other than the one under test, and its primary plane */
+static bool other_pipe(data_t *data, uint32_t conn_id, struct pipe *pipe)
+{
+	drmModeConnector *c = drmModeGetConnector(data->fd, conn_id);
+	drmModePlaneRes *planes;
+	uint32_t crtcs = 0;
+
+	igt_assert(c);
+	for (int e = 0; e < c->count_encoders; e++) {
+		drmModeEncoder *enc = drmModeGetEncoder(data->fd, c->encoders[e]);
+
+		if (enc)
+			crtcs |= enc->possible_crtcs;
+		drmModeFreeEncoder(enc);
+	}
+	drmModeFreeConnector(c);
+
+	crtcs &= ~(1 << data->crtc_index);
+	if (!crtcs)
+		return false;
+
+	pipe->conn_id = conn_id;
+	pipe->crtc_index = ffs(crtcs) - 1;
+	pipe->crtc_id = data->res->crtcs[pipe->crtc_index];
+	pipe->plane_id = 0;
+
+	planes = drmModeGetPlaneResources(data->fd);
+	igt_assert(planes);
+	for (int i = 0; i < planes->count_planes && !pipe->plane_id; i++) {
+		drmModePlane *p = drmModeGetPlane(data->fd, planes->planes[i]);
+		uint64_t type;
+
+		if (p && (p->possible_crtcs & (1 << pipe->crtc_index)) &&
+		    kmstest_get_property(data->fd, p->plane_id, DRM_MODE_OBJECT_PLANE, "type",
+					 NULL, &type, NULL) && type == DRM_PLANE_TYPE_PRIMARY)
+			pipe->plane_id = p->plane_id;
+		drmModeFreePlane(p);
+	}
+	drmModeFreePlaneResources(planes);
+
+	return pipe->plane_id;
+}
+
+static void test_refused(data_t *data)
+{
+	drmModeModeInfo mode;
+	struct pipe pipe;
+	int others = 0;
+
+	/* The opted-in connector takes the mode */
+	igt_assert_eq(set_mode(data, &data->fs_mode, &data->sbs[0], false, true), 0);
+
+	for (int i = 0; i < data->res->count_connectors; i++) {
+		drmModeConnector *c = drmModeGetConnector(data->fd, data->res->connectors[i]);
+		bool listed = false;
+
+		igt_assert(c);
+		if (c->connector_id == data->conn_id ||
+		    c->connector_type == DRM_MODE_CONNECTOR_WRITEBACK ||
+		    c->connection != DRM_MODE_CONNECTED || !c->count_modes) {
+			drmModeFreeConnector(c);
+			continue;
+		}
+
+		for (int j = 0; j < c->count_modes; j++)
+			listed |= is_frame_sequential(&c->modes[j]);
+		if (listed || !other_pipe(data, c->connector_id, &pipe)) {
+			drmModeFreeConnector(c);
+			continue;
+		}
+
+		mode = data->mode_2d;
+		for (int j = 0; j < c->count_modes; j++)
+			if (same_timing(&c->modes[j], &data->mode_2d))
+				mode = c->modes[j];
+
+		/* The 2D mode is accepted: only the flag makes the difference */
+		igt_assert_eq(set_mode_on(data, &pipe, &mode, &data->eye_fb[0][0], false, true), 0);
+
+		mode.flags |= DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL;
+		igt_assert_eq(set_mode_on(data, &pipe, &mode, &data->sbs[0], false, true), -EINVAL);
+		igt_info("connector %u (type %d), CRTC %d: frame-sequential %s refused, "
+			 "its 2D twin accepted\n", c->connector_id, c->connector_type,
+			 pipe.crtc_index, mode.name);
+		others++;
+		drmModeFreeConnector(c);
+	}
+
+	igt_require_f(others, "no connected connector without frame-sequential modes\n");
+}
+
+#define CAPTURES 32
+
+/*
+ * Captures CAPTURES frames back to back, each into a buffer of its own, and
+ * checks them afterwards: each capture is asked for as soon as the previous
+ * one is queued, so they follow each other frame after frame when the driver
+ * keeps up. The jobs complete in order, so the n-th frame the log marks as
+ * written back is the n-th capture.
+ */
+static void test_writeback_eye_order(data_t *data)
+{
+	struct link_frame frames[LOG_FRAMES], *f[CAPTURES];
+	struct igt_fb wb[CAPTURES];
+	int32_t fences[CAPTURES];
+	int counted[2] = {}, run = 1, longest = 1, n, k = 0, total;
+
+	igt_require_f(data->wb_conn_id, "no writeback connector on the CRTC\n");
+
+	for (int i = 0; i < CAPTURES; i++)
+		igt_create_fb(data->fd, data->fs_mode.hdisplay, data->fs_mode.vdisplay,
+			      DRM_FORMAT_XRGB8888, DRM_FORMAT_MOD_LINEAR, &wb[i]);
+
+	igt_assert_eq(set_mode(data, &data->fs_mode, &data->sbs[0], true, false), 0);
+
+	for (int i = 0; i < CAPTURES; i++) {
+		capture(data, &wb[i], &fences[i]);
+		wait_flip(data);
+	}
+	for (int i = 0; i < CAPTURES; i++) {
+		igt_assert_eq(sync_fence_wait(fences[i], 1000), 0);
+		close(fences[i]);
+	}
+
+	n = read_link_log(data, frames);
+	total = check_eye_order(frames, n);
+	/* The last CAPTURES frames written back are the captures, in order */
+	for (int j = n - 1; j >= 0 && k < CAPTURES; j--)
+		if (frames[j].wb)
+			f[CAPTURES - 1 - k++] = &frames[j];
+	igt_assert_f(k == CAPTURES, "%d frames written back in the log, %d captures\n",
+		     k, CAPTURES);
+	for (int i = 0; i < CAPTURES; i++)
+		check_link(f[i]);
+
+	for (int i = 0; i < CAPTURES; i++) {
+		int wrong = wrong_samples(data, &wb[i], 0, f[i]->eye);
+
+		igt_debug("capture %d: frame %" PRIu64 " %s eye, %d wrong samples\n",
+			  i, f[i]->frame, eye_name(f[i]->eye), wrong);
+		igt_assert_f(!wrong, "frame %" PRIu64 " (%s eye): %d of %d samples are not the %s eye's\n",
+			     f[i]->frame, eye_name(f[i]->eye), wrong,
+			     data->fs_mode.hdisplay * data->fs_mode.vdisplay, eye_name(f[i]->eye));
+		counted[eye_index(f[i]->eye)]++;
+
+		if (i && f[i]->frame == f[i - 1]->frame + 1)
+			longest = max(longest, ++run);
+		else
+			run = 1;
+	}
+
+	igt_info("%d frames written back: %d left, %d right, the longest run %d consecutive "
+		 "frames; %d frames in the log alternate\n",
+		 CAPTURES, counted[0], counted[1], longest, total);
+	igt_assert_lt(0, counted[0]);
+	igt_assert_lt(0, counted[1]);
+	igt_assert_lte(4, longest);
+
+	for (int i = 0; i < CAPTURES; i++)
+		igt_remove_fb(data->fd, &wb[i]);
+}
+
+static void test_crc_eye_order(data_t *data)
+{
+	struct link_frame frames[LOG_FRAMES];
+	igt_pipe_crc_t *pipe_crc;
+	igt_crc_t *crcs = NULL;
+	int n, got, counted[2] = {}, missed = 0;
+
+	get_references(data);
+
+	pipe_crc = igt_pipe_crc_new(data->fd, data->crtc_index, IGT_PIPE_CRC_SOURCE_AUTO);
+	igt_assert_eq(set_mode(data, &data->fs_mode, &data->sbs[0], false, false), 0);
+	igt_pipe_crc_start(pipe_crc);
+	got = igt_pipe_crc_get_crcs(pipe_crc, 64, &crcs);
+	igt_pipe_crc_stop(pipe_crc);
+	igt_assert_eq(got, 64);
+
+	n = read_link_log(data, frames);
+	check_eye_order(frames, n);
+
+	for (int i = 0; i < got; i++) {
+		struct link_frame *f = find_frame(frames, n, crcs[i].frame);
+		int fb;
+
+		igt_assert(crcs[i].has_valid_frame);
+		igt_assert_f(f, "frame %u of the CRC is not in the log\n", crcs[i].frame);
+		if (i) {
+			igt_assert_lt_u32(crcs[i - 1].frame, crcs[i].frame);
+			missed += crcs[i].frame - crcs[i - 1].frame - 1;
+		}
+
+		fb = crc_fb(data, &crcs[i], f->eye);
+		igt_assert_f(fb == 0, "frame %u (%s eye): its CRC is not the %s eye's\n",
+			     crcs[i].frame, eye_name(f->eye), eye_name(f->eye));
+		counted[eye_index(f->eye)]++;
+	}
+
+	/*
+	 * A software composer that falls behind composes only the last frame
+	 * it missed, so a busy machine can leave a frame without a CRC; the
+	 * log still holds every frame, and their eye order is checked above.
+	 */
+	igt_info("%d frames with a CRC, each the CRC of its eye: %d left, %d right; "
+		 "%d frames without one in between\n", got, counted[0], counted[1], missed);
+	igt_assert_lte(missed, 2);
+	igt_assert_lte(abs(counted[0] - counted[1]), 2);
+
+	free(crcs);
+	igt_pipe_crc_free(pipe_crc);
+}
+
+static void test_flip_at_pair_boundary(data_t *data)
+{
+	struct link_frame frames[LOG_FRAMES];
+	igt_pipe_crc_t *pipe_crc;
+	igt_crc_t *crcs = NULL;
+	int n, got, latency[4] = {}, pairs = 0, changes = 0;
+	unsigned int seq[16];
+
+	get_references(data);
+
+	pipe_crc = igt_pipe_crc_new_nonblock(data->fd, data->crtc_index, IGT_PIPE_CRC_SOURCE_AUTO);
+	igt_assert_eq(set_mode(data, &data->fs_mode, &data->sbs[0], false, false), 0);
+	igt_pipe_crc_start(pipe_crc);
+
+	current_frame(data, 2);
+	for (int i = 0; i < 16; i++) {
+		unsigned int now;
+
+		/*
+		 * A flip asked for right after the previous one took effect,
+		 * at the start of a left-eye frame, has a right-eye frame next
+		 * and waits for the one after it; every other flip waits one
+		 * frame more first, so it has a left-eye frame next.
+		 */
+		if (i % 2)
+			current_frame(data, 1);
+		now = current_frame(data, 0);
+		flip(data, &data->sbs[(i + 1) % 2]);
+		seq[i] = wait_flip(data);
+		igt_assert_lt(0, seq[i] - now);
+		igt_assert_lt(seq[i] - now, 4);
+		latency[seq[i] - now]++;
+	}
+	current_frame(data, 2);
+
+	got = igt_pipe_crc_get_crcs(pipe_crc, 128, &crcs);
+	igt_pipe_crc_stop(pipe_crc);
+	n = read_link_log(data, frames);
+	check_eye_order(frames, n);
+
+	/* Each flip took effect at a left-eye frame, which shows new planes */
+	for (int i = 0; i < 16; i++) {
+		struct link_frame *f = find_frame(frames, n, seq[i]);
+
+		igt_assert_f(f, "the frame of flip %d, %u, is not in the log\n", i, seq[i]);
+		igt_assert_f(f->eye == EYE_LEFT, "flip %d took effect at frame %u, a %s one\n",
+			     i, seq[i], eye_name(f->eye));
+		igt_assert(f > frames && f[-1].scanout != f->scanout);
+	}
+
+	/* New planes appear only at left-eye frames: a pair shows one scanout */
+	for (int i = 1; i < n; i++)
+		if (frames[i].eye == EYE_RIGHT && frames[i].frame == frames[i - 1].frame + 1)
+			igt_assert_eq_u32(frames[i].scanout, frames[i - 1].scanout);
+
+	/* The pixels: each frame its eye of one framebuffer, both eyes of a pair the same one */
+	for (int i = 0; i < got; i++) {
+		struct link_frame *f = find_frame(frames, n, crcs[i].frame);
+		int fb;
+
+		igt_assert_f(f, "frame %u of the CRC is not in the log\n", crcs[i].frame);
+		fb = crc_fb(data, &crcs[i], f->eye);
+		igt_assert_f(fb >= 0, "frame %u (%s eye) shows neither framebuffer's %s eye\n",
+			     crcs[i].frame, eye_name(f->eye), eye_name(f->eye));
+
+		if (!i || crcs[i - 1].frame + 1 != crcs[i].frame)
+			continue;
+
+		if (f->eye == EYE_RIGHT) {
+			igt_assert_f(crc_fb(data, &crcs[i - 1], EYE_LEFT) == fb,
+				     "the pair of frames %u and %u shows two framebuffers\n",
+				     crcs[i - 1].frame, crcs[i].frame);
+			pairs++;
+		} else if (crc_fb(data, &crcs[i - 1], EYE_RIGHT) != fb) {
+			changes++;
+		}
+	}
+
+	igt_info("16 flips at left-eye frames, %d one frame after the request, %d two frames; "
+		 "%d frames: %d pairs each from one framebuffer, %d changes of framebuffer\n",
+		 latency[1], latency[2], got, pairs, changes);
+	igt_assert_lt(0, latency[1]);
+	igt_assert_lt(0, latency[2]);
+	igt_assert_lt(0, pairs);
+	igt_assert_lt(0, changes);
+
+	free(crcs);
+	igt_pipe_crc_free(pipe_crc);
+}
+
+static void test_2d_control(data_t *data)
+{
+	struct link_frame frames[LOG_FRAMES];
+	int n, counted = 0;
+
+	igt_assert_eq(set_mode(data, &data->mode_2d, &data->eye_fb[0][0],
+			       false, false), 0);
+	current_frame(data, 8);
+
+	n = read_link_log(data, frames);
+	for (int i = n - 1; i >= 0 && n - i <= 6; i--) {
+		igt_assert_f(frames[i].eye == EYE_NONE, "2D frame %" PRIu64 " carries the %s eye\n",
+			     frames[i].frame, eye_name(frames[i].eye));
+		igt_assert_eq_u32(frames[i].misc1, MISC1_NONE);
+		igt_assert_eq_u32(frames[i].vsc, 0);
+		igt_assert_eq_u32(frames[i].db0, 0);
+		counted++;
+	}
+	igt_assert_eq(counted, 6);
+}
+
+static bool find_pipe(data_t *data)
+{
+	drmModePlaneRes *planes;
+
+	for (int i = 0; i < data->res->count_connectors; i++) {
+		drmModeConnector *c = drmModeGetConnector(data->fd, data->res->connectors[i]);
+
+		if (!c)
+			continue;
+
+		for (int j = 0; j < c->count_modes && !data->conn_id; j++) {
+			if (c->connection != DRM_MODE_CONNECTED ||
+			    !is_frame_sequential(&c->modes[j]))
+				continue;
+
+			for (int k = 0; k < c->count_modes; k++) {
+				if (!(c->modes[k].flags & DRM_MODE_FLAG_3D_MASK) &&
+				    same_timing(&c->modes[k], &c->modes[j])) {
+					data->conn_id = c->connector_id;
+					data->fs_mode = c->modes[j];
+					data->mode_2d = c->modes[k];
+				}
+			}
+		}
+		drmModeFreeConnector(c);
+	}
+
+	if (!data->conn_id)
+		return false;
+
+	/* The first CRTC the connector can use, with a writeback connector if one can */
+	for (int i = 0; i < data->res->count_crtcs && !data->crtc_id; i++) {
+		drmModeConnector *c = drmModeGetConnector(data->fd, data->conn_id);
+		bool usable = false;
+
+		for (int e = 0; e < c->count_encoders; e++) {
+			drmModeEncoder *enc = drmModeGetEncoder(data->fd, c->encoders[e]);
+
+			usable |= enc && (enc->possible_crtcs & (1 << i));
+			drmModeFreeEncoder(enc);
+		}
+		drmModeFreeConnector(c);
+
+		if (usable) {
+			data->crtc_id = data->res->crtcs[i];
+			data->crtc_index = i;
+		}
+	}
+	igt_assert(data->crtc_id);
+
+	for (int i = 0; i < data->res->count_connectors && !data->wb_conn_id; i++) {
+		drmModeConnector *c = drmModeGetConnector(data->fd, data->res->connectors[i]);
+
+		if (c && c->connector_type == DRM_MODE_CONNECTOR_WRITEBACK) {
+			for (int e = 0; e < c->count_encoders; e++) {
+				drmModeEncoder *enc = drmModeGetEncoder(data->fd, c->encoders[e]);
+
+				if (enc && (enc->possible_crtcs & (1 << data->crtc_index)))
+					data->wb_conn_id = c->connector_id;
+				drmModeFreeEncoder(enc);
+			}
+		}
+		drmModeFreeConnector(c);
+	}
+
+	planes = drmModeGetPlaneResources(data->fd);
+	igt_assert(planes);
+	for (int i = 0; i < planes->count_planes && !data->plane_id; i++) {
+		drmModePlane *p = drmModeGetPlane(data->fd, planes->planes[i]);
+		uint64_t type;
+
+		if (p && (p->possible_crtcs & (1 << data->crtc_index)) &&
+		    kmstest_get_property(data->fd, p->plane_id, DRM_MODE_OBJECT_PLANE, "type",
+					 NULL, &type, NULL) && type == DRM_PLANE_TYPE_PRIMARY)
+			data->plane_id = p->plane_id;
+		drmModeFreePlane(p);
+	}
+	drmModeFreePlaneResources(planes);
+	igt_assert(data->plane_id);
+
+	igt_info("connector %u, CRTC %d, plane %u, writeback connector %u, mode %s %dx%d@%d\n",
+		 data->conn_id, data->crtc_index, data->plane_id, data->wb_conn_id,
+		 data->fs_mode.name, data->fs_mode.hdisplay, data->fs_mode.vdisplay,
+		 data->fs_mode.vrefresh);
+
+	return true;
+}
