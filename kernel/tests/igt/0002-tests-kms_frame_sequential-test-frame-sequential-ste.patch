+	igt_fixture() {
+		disable_crtc(&data);
+		for (int n = 0; n < 2; n++) {
+			igt_remove_fb(data.fd, &data.sbs[n]);
+			for (int e = 0; e < 2; e++)
+				igt_remove_fb(data.fd, &data.eye_fb[n][e]);
+		}
+		drmModeFreeResources(data.res);
+		drm_close_driver(data.fd);
+	}
+}
