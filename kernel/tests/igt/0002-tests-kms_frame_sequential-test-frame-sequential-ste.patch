+// SPDX-License-Identifier: MIT
+/*
+ * Copyright © 2026 Daniel Campos Ramos
+ */
+
+/**
+ * TEST: kms frame sequential
+ * Category: Display
+ * Description: Tests frame-sequential stereo modes (DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL):
+ *              the framebuffer holds both eyes side by side, left eye first, and the
+ *              driver sends one eye per frame, the left eye first, naming each eye to
+ *              the sink (DisplayPort MSA MISC1 bits 2:1 and the VSC SDP), with page
+ *              flips taking effect only at the start of a left-eye frame.
+ * Driver requirement: vkms
+ * Mega feature: General Display Features
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "igt.h"
+#include "igt_sysfs.h"
+#include "sw_sync.h"
+
+/**
+ * SUBTEST: mode-listed
+ * Description: A connector that opted in lists the frame-sequential modes its sink
+ *              declares, each the twin of a 2D mode with the same timing, and hides
+ *              them from clients without DRM_CLIENT_CAP_STEREO_3D; IGT's stereo
+ *              framebuffer for such a mode holds both eyes side by side.
+ *
+ * SUBTEST: refused-without-opt-in
+ * Description: A TEST_ONLY commit of a frame-sequential mode is refused on a connector
+ *              whose driver did not opt in, while the same mode without the flag and the
+ *              opted-in connector are accepted.
+ *
+ * SUBTEST: writeback-eye-order
+ * Description: Frame by frame through writeback and the driver's stereo link log: each
+ *              frame holds exactly the eye the log names, the eyes take turns, and each
+ *              frame is announced with MSA MISC1 and the VSC SDP of its eye.
+ *
+ * SUBTEST: crc-eye-order
+ * Description: 64 frames of a run through the CRTC CRC and the stereo link log: the
+ *              first frame is a left one, the eyes take turns, and each frame's CRC is
+ *              that of its eye.
+ *
+ * SUBTEST: flip-at-pair-boundary
+ * Description: Page flips take effect only at left-eye frames, so both eyes of every pair
+ *              come from the same framebuffer.
+ *
+ * SUBTEST: 2d-control
+ * Description: In the 2D twin of the mode no frame carries an eye, MISC1 says no stereo
+ *              and no VSC SDP is sent.
+ */
+
+IGT_TEST_DESCRIPTION("Tests frame-sequential stereo modes: one eye per frame from a side "
+		     "by side framebuffer, the eye named to the sink, flips at pair boundaries.");
+
+/* MSA MISC1 bits 2:1 (DisplayPort 1.1a): 11b left, 01b right, 00b no stereo */
+#define MISC1_LEFT	0x06
+#define MISC1_RIGHT	0x02
+#define MISC1_NONE	0x00
+/* VSC SDP revision 0x1, DB0 frame/field sequential named by MISC1 (DisplayPort 1.2) */
+#define VSC_REVISION	0x01
+#define VSC_DB0_FS	0x01
+
+#define LOG_FRAMES	256
+
+enum eye {
+	EYE_NONE,
+	EYE_LEFT,
+	EYE_RIGHT,
+};
+
+struct link_frame {
+	uint64_t frame;
+	enum eye eye;
+	unsigned int misc1, vsc, db0, scanout;
+	int wb;
+};
+
+struct pipe {
+	uint32_t conn_id;
+	uint32_t crtc_id;
+	int crtc_index;
+	uint32_t plane_id;
+};
+
+typedef struct {
+	int fd;
+	drmModeRes *res;
+	/* The pipe under test, through the connector that opted in */
+	uint32_t conn_id;
+	uint32_t wb_conn_id;
+	uint32_t crtc_id;
+	int crtc_index;
+	uint32_t plane_id;
+	drmModeModeInfo fs_mode;
+	drmModeModeInfo mode_2d;
+	struct igt_fb sbs[2];
+	struct igt_fb eye_fb[2][2];
+	igt_crc_t ref[2][2];
+	bool have_refs;
+} data_t;
+
+static bool swap_eyes;
+
+static int eye_index(enum eye eye)
+{
+	return eye == EYE_RIGHT;
+}
+
+static const char *eye_name(enum eye eye)
+{
+	return eye == EYE_LEFT ? "left" : eye == EYE_RIGHT ? "right" : "none";
+}
+
+static bool is_frame_sequential(const drmModeModeInfo *mode)
+{
+	return (mode->flags & DRM_MODE_FLAG_3D_MASK) == DRM_MODE_FLAG_3D_FRAME_SEQUENTIAL;
+}
+
+static bool same_timing(const drmModeModeInfo *a, const drmModeModeInfo *b)
+{
+	return a->clock == b->clock &&
+	       a->hdisplay == b->hdisplay && a->hsync_start == b->hsync_start &&
+	       a->hsync_end == b->hsync_end && a->htotal == b->htotal &&
+	       a->vdisplay == b->vdisplay && a->vsync_start == b->vsync_start &&
+	       a->vsync_end == b->vsync_end && a->vtotal == b->vtotal &&
+	       (a->flags & ~DRM_MODE_FLAG_3D_MASK) == (b->flags & ~DRM_MODE_FLAG_3D_MASK);
+}
+
+/*
+ * Each sample names its eye and its place: R = x & 0xff, G = y & 0xff,
+ * B = framebuffer << 7 | eye << 6 | (x >> 8) << 2 | y >> 8, so a sample taken
+ * from the wrong eye, framebuffer or place cannot match.
+ */
+static uint32_t sample(int fb, enum eye eye, int x, int y)
+{
+	uint32_t b = fb << 7 | eye_index(eye) << 6 | ((x >> 8) & 3) << 2 | ((y >> 8) & 3);
+
+	return 0xff000000 | (x & 0xff) << 16 | (y & 0xff) << 8 | b;
+}
+
+static void fill_eye(data_t *data, struct igt_fb *fb, int x0, int n, enum eye eye)
+{
+	uint32_t *ptr = igt_fb_map_buffer(data->fd, fb);
+	int w = data->fs_mode.hdisplay;
+
+	igt_assert(ptr);
+	for (int y = 0; y < fb->height; y++)
+		for (int x = 0; x < w; x++)
+			ptr[y * fb->strides[0] / 4 + x0 + x] = sample(n, eye, x, y);
+	igt_fb_unmap_buffer(fb, ptr);
+}
+
+static void create_fbs(data_t *data)
+{
+	int w = data->fs_mode.hdisplay, h = data->fs_mode.vdisplay;
+
+	for (int n = 0; n < 2; n++) {
+		/* The frame: both eyes side by side, left eye first (swapped for the control) */
+		igt_create_fb(data->fd, 2 * w, h, DRM_FORMAT_XRGB8888,
+			      DRM_FORMAT_MOD_LINEAR, &data->sbs[n]);
+		fill_eye(data, &data->sbs[n], 0, n, swap_eyes ? EYE_RIGHT : EYE_LEFT);
+		fill_eye(data, &data->sbs[n], w, n, swap_eyes ? EYE_LEFT : EYE_RIGHT);
+
+		/* Each eye alone, the picture its frames must show */
+		for (int e = 0; e < 2; e++) {
+			igt_create_fb(data->fd, w, h, DRM_FORMAT_XRGB8888,
+				      DRM_FORMAT_MOD_LINEAR, &data->eye_fb[n][e]);
+			fill_eye(data, &data->eye_fb[n][e], 0, n, e ? EYE_RIGHT : EYE_LEFT);
+		}
+	}
+}
+
+static uint32_t prop(data_t *data, uint32_t obj, uint32_t type, const char *name)
+{
+	uint32_t id;
+
+	igt_assert_f(kmstest_get_property(data->fd, obj, type, name, &id, NULL, NULL),
+		     "no property %s on object %u\n", name, obj);
+
+	return id;
+}
+
+static void add_plane(data_t *data, drmModeAtomicReq *req, const struct pipe *pipe,
+		      struct igt_fb *fb)
+{
+	uint32_t p = pipe->plane_id;
+	uint32_t t = DRM_MODE_OBJECT_PLANE;
+
+	igt_assert(drmModeAtomicAddProperty(req, p, prop(data, p, t, "FB_ID"),
+					    fb->fb_id) >= 0);
+	igt_assert(drmModeAtomicAddProperty(req, p, prop(data, p, t, "CRTC_ID"),
+					    pipe->crtc_id) >= 0);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "SRC_X"), 0);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "SRC_Y"), 0);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "SRC_W"), (uint64_t)fb->width << 16);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "SRC_H"), (uint64_t)fb->height << 16);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "CRTC_X"), 0);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "CRTC_Y"), 0);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "CRTC_W"), fb->width);
+	drmModeAtomicAddProperty(req, p, prop(data, p, t, "CRTC_H"), fb->height);
+}
+
+static const struct pipe *main_pipe(data_t *data)
+{
+	static struct pipe pipe;
+
+	pipe = (struct pipe) {
+		.conn_id = data->conn_id,
+		.crtc_id = data->crtc_id,
+		.crtc_index = data->crtc_index,
+		.plane_id = data->plane_id,
+	};
+
+	return &pipe;
+}
+
+/*
+ * Sets @mode on @pipe (and on the writeback connector if @with_wb), the
+ * primary plane showing @fb; TEST_ONLY when @test_only.
+ */
+static int set_mode_on(data_t *data, const struct pipe *pipe, const drmModeModeInfo *mode,
+		       struct igt_fb *fb, bool with_wb, bool test_only)
+{
+	drmModeAtomicReq *req = drmModeAtomicAlloc();
+	uint32_t blob, c = pipe->crtc_id, conn_id = pipe->conn_id;
+	uint32_t flags = DRM_MODE_ATOMIC_ALLOW_MODESET;
+	int ret;
+
+	igt_assert_eq(drmModeCreatePropertyBlob(data->fd, mode, sizeof(*mode), &blob), 0);
+
+	drmModeAtomicAddProperty(req, c, prop(data, c, DRM_MODE_OBJECT_CRTC, "MODE_ID"), blob);
+	drmModeAtomicAddProperty(req, c, prop(data, c, DRM_MODE_OBJECT_CRTC, "ACTIVE"), 1);
+	drmModeAtomicAddProperty(req, conn_id,
+				 prop(data, conn_id, DRM_MODE_OBJECT_CONNECTOR, "CRTC_ID"), c);
+	if (with_wb)
+		drmModeAtomicAddProperty(req, data->wb_conn_id,
+					 prop(data, data->wb_conn_id, DRM_MODE_OBJECT_CONNECTOR,
+					      "CRTC_ID"), c);
+	add_plane(data, req, pipe, fb);
+
+	if (test_only)
+		flags |= DRM_MODE_ATOMIC_TEST_ONLY;
+
+	ret = drmModeAtomicCommit(data->fd, req, flags, NULL);
+	ret = ret ? -errno : 0;
+
+	drmModeAtomicFree(req);
+	drmModeDestroyPropertyBlob(data->fd, blob);
+
+	return ret;
+}
+
+static int set_mode(data_t *data, const drmModeModeInfo *mode, struct igt_fb *fb,
+		    bool with_wb, bool test_only)
+{
+	return set_mode_on(data, main_pipe(data), mode, fb, with_wb, test_only);
+}
+
+static void disable_crtc(data_t *data)
+{
+	drmModeAtomicReq *req = drmModeAtomicAlloc();
+	uint32_t c = data->crtc_id, p = data->plane_id;
+
+	drmModeAtomicAddProperty(req, c, prop(data, c, DRM_MODE_OBJECT_CRTC, "MODE_ID"), 0);
+	drmModeAtomicAddProperty(req, c, prop(data, c, DRM_MODE_OBJECT_CRTC, "ACTIVE"), 0);
+	drmModeAtomicAddProperty(req, data->conn_id,
+				 prop(data, data->conn_id, DRM_MODE_OBJECT_CONNECTOR,
+				      "CRTC_ID"), 0);
+	if (data->wb_conn_id)
+		drmModeAtomicAddProperty(req, data->wb_conn_id,
+					 prop(data, data->wb_conn_id, DRM_MODE_OBJECT_CONNECTOR,
+					      "CRTC_ID"), 0);
+	drmModeAtomicAddProperty(req, p, prop(data, p, DRM_MODE_OBJECT_PLANE, "FB_ID"), 0);
+	drmModeAtomicAddProperty(req, p, prop(data, p, DRM_MODE_OBJECT_PLANE, "CRTC_ID"), 0);
+	drmModeAtomicCommit(data->fd, req, DRM_MODE_ATOMIC_ALLOW_MODESET, NULL);
+	drmModeAtomicFree(req);
+}
+
+/*
+ * Asks for the next frame to be written back into @fb, with a vblank event
+ * for the commit (the CRTC is in it, unchanged, only to get one), and waits
+ * for that event: the job is then queued, and the next capture can be asked
+ * for while this one is composed. @fence receives its out fence.
+ */
+static void capture(data_t *data, struct igt_fb *fb, int32_t *fence)
+{
+	drmModeAtomicReq *req = drmModeAtomicAlloc();
+	uint32_t w = data->wb_conn_id, c = data->crtc_id;
+
+	*fence = -1;
+	drmModeAtomicAddProperty(req, c, prop(data, c, DRM_MODE_OBJECT_CRTC, "ACTIVE"), 1);
+	drmModeAtomicAddProperty(req, w, prop(data, w, DRM_MODE_OBJECT_CONNECTOR,
+					      "WRITEBACK_FB_ID"), fb->fb_id);
+	drmModeAtomicAddProperty(req, w, prop(data, w, DRM_MODE_OBJECT_CONNECTOR,
+					      "WRITEBACK_OUT_FENCE_PTR"), to_user_pointer(fence));
+	do_or_die(drmModeAtomicCommit(data->fd, req,
+				      DRM_MODE_ATOMIC_NONBLOCK | DRM_MODE_PAGE_FLIP_EVENT, data));
+	drmModeAtomicFree(req);
+	igt_assert(*fence >= 0);
+}
+
+static void flip(data_t *data, struct igt_fb *fb)
+{
+	drmModeAtomicReq *req = drmModeAtomicAlloc();
+	uint32_t p = data->plane_id;
+
+	drmModeAtomicAddProperty(req, p, prop(data, p, DRM_MODE_OBJECT_PLANE, "FB_ID"), fb->fb_id);
+	do_or_die(drmModeAtomicCommit(data->fd, req,
+				      DRM_MODE_ATOMIC_NONBLOCK | DRM_MODE_PAGE_FLIP_EVENT, data));
+	drmModeAtomicFree(req);
+}
+
+static unsigned int event_sequence;
+
+static void flip_handler(int fd, unsigned int sequence, unsigned int tv_sec,
+			 unsigned int tv_usec, unsigned int crtc_id, void *user_data)
+{
+	event_sequence = sequence;
+}
+
+static unsigned int wait_flip(data_t *data)
+{
+	drmEventContext ev = {
+		.version = 3,
+		.page_flip_handler2 = flip_handler,
+	};
+
+	event_sequence = 0;
+	igt_assert_eq(drmHandleEvent(data->fd, &ev), 0);
+
+	return event_sequence;
+}
+
+static unsigned int current_frame(data_t *data, int wait)
+{
+	drmVBlank vbl = {
+		.request.type = DRM_VBLANK_RELATIVE | kmstest_get_vbl_flag(data->crtc_index),
+		.request.sequence = wait,
+	};
+
+	do_or_die(drmWaitVBlank(data->fd, &vbl));
+
+	return vbl.reply.sequence;
+}
+
+/* Reads the driver's stereo link log of the CRTC, the oldest frame first */
+static int read_link_log(data_t *data, struct link_frame *frames)
+{
+	static char buf[LOG_FRAMES * 128];
+	int dir, n = 0;
+	char *line, *save;
+
+	dir = igt_debugfs_crtc_dir(data->fd, data->crtc_index);
+	igt_require_f(dir >= 0, "no debugfs directory for CRTC %d\n", data->crtc_index);
+	igt_require_f(igt_debugfs_simple_read(dir, "stereo_link", buf, sizeof(buf)) > 0,
+		      "the driver has no stereo link log\n");
+	close(dir);
+
+	for (line = strtok_r(buf, "\n", &save); line && n < LOG_FRAMES;
+	     line = strtok_r(NULL, "\n", &save)) {
+		struct link_frame *f = &frames[n];
+		char eye[8];
+
+		igt_assert_f(sscanf(line, "frame=%" SCNu64 " eye=%7s misc1=%x vsc=%x db0=%x scanout=%u wb=%d",
+				    &f->frame, eye, &f->misc1, &f->vsc, &f->db0, &f->scanout,
+				    &f->wb) == 7, "cannot read \"%s\"\n", line);
+		if (!strcmp(eye, "left"))
+			f->eye = EYE_LEFT;
+		else if (!strcmp(eye, "right"))
+			f->eye = EYE_RIGHT;
+		else
+			f->eye = EYE_NONE;
+		n++;
+	}
+
+	return n;
+}
+
+static struct link_frame *find_frame(struct link_frame *frames, int n, uint64_t frame)
+{
+	for (int i = 0; i < n; i++)
+		if (frames[i].frame == frame)
+			return &frames[i];
+
+	return NULL;
+}
+
+/* What the frame was sent with must be what its eye needs */
+static void check_link(const struct link_frame *f)
+{
+	switch (f->eye) {
+	case EYE_LEFT:
+		igt_assert_eq_u32(f->misc1, MISC1_LEFT);
+		break;
+	case EYE_RIGHT:
+		igt_assert_eq_u32(f->misc1, MISC1_RIGHT);
+		break;
+	default:
+		igt_assert_f(false, "frame %" PRIu64 " carries no eye\n", f->frame);
+	}
+	igt_assert_eq_u32(f->vsc, VSC_REVISION);
+	igt_assert_eq_u32(f->db0, VSC_DB0_FS);
+}
+
+/*
+ * The frames of the current frame-sequential mode in the log, from the first
+ * one after the 2D or empty frames before it: that first frame is a left one,
+ * and the eyes take turns frame after frame.
+ */
+static int check_eye_order(struct link_frame *frames, int n)
+{
+	int first = -1, count = 0;
+
+	for (int i = n - 1; i >= 0 && frames[i].eye != EYE_NONE; i--)
+		first = i;
+	igt_assert_f(first >= 0, "no frame-sequential frame in the log\n");
+
+	for (int i = first; i < n; i++) {
+		check_link(&frames[i]);
+		if (i > first) {
+			uint64_t d = frames[i].frame - frames[i - 1].frame;
+
+			igt_assert_lt_u64(0, d);
+			igt_assert_f((frames[i].eye != frames[i - 1].eye) == (d & 1),
+				     "frames %" PRIu64 " and %" PRIu64 " carry the %s and the %s eye\n",
+				     frames[i - 1].frame, frames[i].frame,
+				     eye_name(frames[i - 1].eye), eye_name(frames[i].eye));
+		}
+		count++;
+	}
+
+	/* Only the first frame of the mode is known when the log still holds it */
+	if (first > 0)
+		igt_assert_f(frames[first].eye == EYE_LEFT,
+			     "the first frame of the mode, %" PRIu64 ", is a %s one\n",
+			     frames[first].frame, eye_name(frames[first].eye));
+
+	return count;
+}
+
+/* The writeback buffer must hold exactly @eye of framebuffer @n */
+static int wrong_samples(data_t *data, struct igt_fb *wb, int n, enum eye eye)
+{
+	uint32_t *ptr = igt_fb_map_buffer(data->fd, wb);
+	int wrong = 0;
+
+	igt_assert(ptr);
+	for (int y = 0; y < wb->height; y++)
+		for (int x = 0; x < wb->width; x++)
+			wrong += (ptr[y * wb->strides[0] / 4 + x] | 0xff000000) !=
+				 sample(n, eye, x, y);
+	igt_fb_unmap_buffer(wb, ptr);
+
+	return wrong;
+}
+
+/* The CRC of each eye of each framebuffer, shown alone in the 2D twin */
+static void get_references(data_t *data)
+{
+	igt_pipe_crc_t *pipe_crc;
+
+	if (data->have_refs)
+		return;
+
+	for (int n = 0; n < 2; n++) {
+		for (int e = 0; e < 2; e++) {
+			igt_assert_eq(set_mode(data, &data->mode_2d,
+					       &data->eye_fb[n][e], false, false), 0);
+			pipe_crc = igt_pipe_crc_new(data->fd, data->crtc_index,
+						    IGT_PIPE_CRC_SOURCE_AUTO);
+			igt_pipe_crc_collect_crc(pipe_crc, &data->ref[n][e]);
+			igt_pipe_crc_free(pipe_crc);
+		}
+	}
+
+	for (int a = 0; a < 4; a++)
+		for (int b = a + 1; b < 4; b++)
+			igt_assert_f(!igt_check_crc_equal(&data->ref[a / 2][a % 2],
+							  &data->ref[b / 2][b % 2]),
+				     "two eyes give the same CRC\n");
+
+	data->have_refs = true;
+}
+
+/* Which framebuffer the CRC of a frame carrying @eye shows, or -1 */
+static int crc_fb(data_t *data, const igt_crc_t *crc, enum eye eye)
+{
+	for (int n = 0; n < 2; n++)
+		if (igt_check_crc_equal(crc, &data->ref[n][eye_index(eye)]))
+			return n;
+
+	return -1;
+}
