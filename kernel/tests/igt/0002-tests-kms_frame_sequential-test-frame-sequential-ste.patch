+		data.res = drmModeGetResources(data.fd);
+		igt_require(data.res);
+		igt_require_f(find_pipe(&data), "no connector lists a frame-sequential mode\n");
+
+		create_fbs(&data);
+	}
+
+	igt_describe("A connector that opted in lists the frame-sequential modes of its sink, "
+		     "each with a 2D twin, hidden from clients without stereo.");
+	igt_subtest("mode-listed")
+		test_mode_listed(&data);
+
+	igt_describe("TEST_ONLY refuses a frame-sequential mode on a connector without opt-in.");
+	igt_subtest("refused-without-opt-in")
+		test_refused(&data);
+
+	igt_describe("Frame by frame through writeback and the stereo link log.");
+	igt_subtest("writeback-eye-order")
+		test_writeback_eye_order(&data);
