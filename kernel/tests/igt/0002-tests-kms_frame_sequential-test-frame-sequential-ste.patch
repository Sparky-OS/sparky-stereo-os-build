+static int opt_handler(int opt, int opt_index, void *_data)
+{
+	switch (opt) {
+	case 's':
+		swap_eyes = true;
+		igt_info("Negative control: the framebuffers hold the eyes swapped, "
+			 "the checks of the eye order must fail\n");
+		break;
+	default:
+		return IGT_OPT_HANDLER_ERROR;
+	}
+
+	return IGT_OPT_HANDLER_SUCCESS;
+}
+
+static const struct option long_opts[] = {
+	{ .name = "swap-eyes", .has_arg = false, .val = 's', },
+	{}
+};
+
+static const char help_str[] =
+	"  --swap-eyes\tNegative control: put the right eye in the left half of the\n"
+	"\t\tframebuffers and the left eye in the right half; the eye order tests\n"
+	"\t\tmust then fail.\n";
