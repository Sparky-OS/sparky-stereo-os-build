<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name="stereoshowrc"/>
  <group name="General">
    <entry name="Enabled" type="Bool"><default>true</default></entry>
    <entry name="IdleSeconds" type="Int"><default>8100</default><min>60</min><max>86400</max></entry>
    <entry name="CycleSeconds" type="Int"><default>600</default><min>60</min><max>86400</max></entry>
  </group>
</kcfg>
