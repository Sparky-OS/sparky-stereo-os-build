                                 s->seraphimVertices[svi].f[3] = oldscreeny-dym+dxos;
                                 svi++;
+
+                                /* The trail already has a world-space depth.
+                                   Retain it for OpenGL camera rendering instead
+                                   of handing the wrapper a flattened picture. */
+                                if (camera_p)
+                                  {
+                                    int vertex;
+                                    for (vertex = 0; vertex < 4; vertex++)
+                                      {
+                                        int index = (si - 1) * 4 + vertex;
+                                        float depth = vertex < 2 ? z : oldz;
+                                        float *screen = s->seraphimVertices[
+                                          (si - 1) * 2 + vertex / 2].f +
+                                          (vertex % 2) * 2;
+                                        s->cameraVertices[index][0] =
+                                          (screen[0] - wslash2) * depth /
+                                          global->sys_glWidth;
+                                        s->cameraVertices[index][1] =
+                                          (screen[1] - hslash2) * depth /
+                                          global->sys_glWidth;
+                                        s->cameraVertices[index][2] = -depth;
+                                      }
+                                  }
 			}
 		}
             }
 	}
 	glColorPointer(4,GL_FLOAT,0,s->seraphimColors);
-	glVertexPointer(2,GL_FLOAT,0,s->seraphimVertices);
 	glTexCoordPointer(2,GL_FLOAT,0,s->seraphimTextures);
-	glDrawArrays(GL_QUADS,0,si*4);
+        if (camera_p)
+          {
+            GLint mode;
+            double aspect = global->sys_glHeight / global->sys_glWidth;
+            glGetIntegerv (GL_MATRIX_MODE, &mode);
+            glMatrixMode (GL_PROJECTION);
+            glPushMatrix ();
+            glLoadIdentity ();
+            /* Match sx = x * width / z + width/2 and the existing z>=25
+               visibility cutoff. The stereo layer supplies both eyes. */
+            glFrustum (-12.5, 12.5, -12.5 * aspect, 12.5 * aspect,
+                       25, 1000000);
+            glMatrixMode (mode);
+            glVertexPointer (3, GL_FLOAT, 0, s->cameraVertices);
+            glDrawArrays (GL_QUADS, 0, si * 4);
+            glMatrixMode (GL_PROJECTION);
+            glPopMatrix ();
+            glMatrixMode (mode);
+          }
+        else
