 	int i,k;
+        const char *stereo = getenv("GL_STEREO");
+        int camera_p = stereo && !strcmp(stereo, "1");
 
 	width = (streamSize+2.5f*flurry->streamExpansion) * screenRatio;
 
@@ -1078,14 +1080,59 @@
