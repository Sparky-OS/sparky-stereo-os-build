+/* The second light after this one, from those switched on: at the viewer,
+ * the lamp, the sun. With none switched on, all three take turns. */
+static int next_light(int light)
+{
+    int on[3], i;
+
+    on[0] = viewerlight;
+    on[1] = lamplight;
+    on[2] = sunlight;
+    if (!on[0] && !on[1] && !on[2])
+	on[0] = on[1] = on[2] = 1;
+    for (i = 1; i <= 3; i++)
+	if (on[(light + i) % 3])
+	    return (light + i) % 3;
+    return light;
+}
+
 /* Start morph process to this model */
 static void start_morph(struct glsnake_cfg *bp, 
                         unsigned int model_index, int immediate)
 {
+    /* each new shape gets the next light */
+    if (!immediate)
+	bp->light = next_light(bp->light);
+
     /* if immediate, don't bother morphing, go straight to the next model */
     if (immediate) {
 	int i;
