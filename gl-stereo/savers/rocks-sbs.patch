 static void
 rock_draw (struct state *st, struct rock *rock, Bool draw_p)
 {
+  if (st->sbs)
+    {
+      int eye;
+      for (eye = 0; eye < 2; eye++)
+        {
+          int origin = st->reference ? 0 : eye * st->width;
+          int x = rock->x + (eye ? rock->diff : -rock->diff) + origin;
+          GC gc = draw_p ? st->draw_gcs[rock->color] : st->erase_gc;
+          XRectangle clip = {origin, 0, st->width, st->height};
+          if (st->reference && eye != st->reference - 1) continue;
+          XSetClipRectangles(st->dpy, gc, 0, 0, &clip, 1, Unsorted);
+          if (rock->size <= 1)
+            XDrawPoint(st->dpy, st->window, gc, x, rock->y);
+          else if (rock->size <= MIN_SIZE || !draw_p)
+            XFillRectangle(st->dpy, st->window, gc, x - rock->size/2,
+                           rock->y - rock->size/2, rock->size, rock->size);
+          else if (rock->size < MAX_SIZE)
+            XCopyPlane(st->dpy, st->pixmaps[rock->size], st->window, gc,
+                       0, 0, rock->size, rock->size, x - rock->size/2,
+                       rock->y - rock->size/2, 1L);
+        }
+      return;
+    }
   GC gc = (draw_p 
 	   ? (st->threed ? st->erase_gc : st->draw_gcs[rock->color])
 	   : st->erase_gc);
