+/*
+ * The side by side window tells the desktop what it holds, so a stereo
+ * compositor (KWin on Sparky Stereo OS) shows each half to its eye.
+ */
+static void
+peek_declare_stereo(struct comp_window_peek *w)
+{
+#ifdef XRT_HAVE_STEREO_DECLARE
+	SDL_SysWMinfo info;
+	SDL_VERSION(&info.version);
+	if (!SDL_GetWindowWMInfo(w->window, &info)) {
+		COMP_WARN(w->c, "Peek window: no window system info, stereo not declared");
+		return;
+	}
+
+	int ret = -1;
+	switch (info.subsystem) {
+#ifdef SDL_VIDEO_DRIVER_X11
+	case SDL_SYSWM_X11:
+		if (stereo_supported_x11(info.info.x11.display) == 0) {
+			COMP_DEBUG(w->c, "Peek window: the X11 window manager takes no stereo declaration");
+			return;
+		}
+		ret = stereo_declare_x11(info.info.x11.display, info.info.x11.window, STEREO_SBS_FULL,
+		                         STEREO_CLASS_GAME, STEREO_GAME_VR);
+		break;
+#endif
+#ifdef SDL_VIDEO_DRIVER_WAYLAND
+	case SDL_SYSWM_WAYLAND:
+		if (stereo_declare_wayland_init(info.info.wl.display, NULL) != 0) {
+			break;
+		}
+		// Nothing else dispatches this display yet: fetch the compositor's globals here.
+		wl_display_roundtrip(info.info.wl.display);
+		w->wayland_declared = true;
+		if (stereo_supported_wayland() == 0) {
+			COMP_DEBUG(w->c, "Peek window: the Wayland compositor takes no stereo declaration");
+			return;
+		}
+		ret = stereo_declare_wayland(info.info.wl.surface, STEREO_SBS_FULL, STEREO_CLASS_GAME, STEREO_GAME_VR);
+		if (ret == 0) {
+			// Without a viewport the buffer is the window: make room for both eyes.
+			SDL_SetWindowSize(w->window, (int)w->width * 2, (int)w->height);
+			w->width *= 2;
+		}
+		break;
+#endif
+	default: COMP_DEBUG(w->c, "Peek window: no stereo declaration for this window system"); return;
+	}
+
+	if (ret != 0) {
+		COMP_WARN(w->c, "Peek window: stereo declaration failed (%d)", ret);
+	} else {
+		COMP_DEBUG(w->c, "Peek window declared as full side by side, left eye first");
+	}
+#else
+	(void)w;
+#endif
+}
+
+static void
+peek_remove_stereo(struct comp_window_peek *w)
+{
+#ifdef XRT_HAVE_STEREO_DECLARE
+	SDL_SysWMinfo info;
+	SDL_VERSION(&info.version);
+	if (!SDL_GetWindowWMInfo(w->window, &info)) {
+		return;
+	}
+	switch (info.subsystem) {
+#ifdef SDL_VIDEO_DRIVER_X11
+	case SDL_SYSWM_X11: stereo_remove_x11(info.info.x11.display, info.info.x11.window); break;
+#endif
+#ifdef SDL_VIDEO_DRIVER_WAYLAND
+	case SDL_SYSWM_WAYLAND:
+		if (w->wayland_declared) {
+			stereo_remove_wayland(info.info.wl.surface);
+			wl_surface_commit(info.info.wl.surface);
+			stereo_declare_wayland_finish();
+		}
+		break;
+#endif
+	default: break;
+	}
+#else
+	(void)w;
+#endif
+}
