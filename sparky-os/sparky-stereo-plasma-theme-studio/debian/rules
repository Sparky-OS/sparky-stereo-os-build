#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export QT_QPA_PLATFORM = offscreen
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON

execute_after_dh_strip:
	install -Dm644 debian/sparky-stereo-theme-editor-dbgsym.lintian-overrides debian/.debhelper/sparky-stereo-theme-editor/dbgsym-root/usr/share/lintian/overrides/sparky-stereo-theme-editor-dbgsym
