diff --git a/server/HeadsetPoseConsumer.cpp b/server/HeadsetPoseConsumer.cpp
new file mode 100644
index 0000000..155e463
--- /dev/null
+++ b/server/HeadsetPoseConsumer.cpp
@@ -0,0 +1,81 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "HeadsetPoseConsumer.h"
+#include <array>
+#include <bit>
+#include <cstring>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+HeadsetPoseConsumer::HeadsetPoseConsumer(std::string path) : m_path(std::move(path)) {}
+HeadsetPoseConsumer::~HeadsetPoseConsumer() { close(); }
+void HeadsetPoseConsumer::close() noexcept
+{
+    if (m_socket >= 0) ::close(m_socket);
+    m_socket = -1;
+}
+bool HeadsetPoseConsumer::available() const noexcept
+{
+    if (!m_registered) return true;
+    if (m_socket < 0) return false;
+    pollfd descriptor{m_socket, POLLIN, 0};
+    const int result = ::poll(&descriptor, 1, 0);
+    return result >= 0 && !(descriptor.revents & (POLLHUP | POLLERR | POLLNVAL));
+}
+bool HeadsetPoseConsumer::registerSource(const KRdp::TrackingSource &source) noexcept
+{
+    close();
+    m_registered = true;
+    m_source = source;
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    if (m_path.empty() || m_path.size() >= sizeof(address.sun_path)) return false;
+    std::memcpy(address.sun_path, m_path.c_str(), m_path.size() + 1);
+    m_socket = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (m_socket < 0 || ::connect(m_socket, reinterpret_cast<sockaddr *>(&address), sizeof(address)) != 0) {
+        close();
+        return false;
+    }
+    ucred peer{};
+    socklen_t size = sizeof(peer);
+    if (getsockopt(m_socket, SOL_SOCKET, SO_PEERCRED, &peer, &size) != 0 || peer.uid != geteuid()) {
+        close();
+        return false;
+    }
+    return send(0);
+}
+bool HeadsetPoseConsumer::send(unsigned kind, const KRdp::StereoPose *pose, KRdp::TrackingReason reason) noexcept
+{
+    // SDVR local ABI 1: fixed 160 bytes, little endian; no native struct layout.
+    // ids at 8/24/40/56; BOOTTIME/source/uncertainty/origin at 72/80/88/96;
+    // xyzw doubles at 104; source epoch/mount/flags/reason at 136/140/144/148.
+    std::array<unsigned char, 160> bytes{};
+    auto put = [&](size_t offset, uint64_t value, size_t width) {
+        for (size_t i = 0; i < width; ++i) bytes[offset + i] = (value >> (8 * i)) & 255;
+    };
+    std::memcpy(bytes.data(), "SDVR", 4);
+    put(4, 1, 2); put(6, kind, 2);
+    std::memcpy(bytes.data() + 8, m_source.source.data(), 16);
+    std::memcpy(bytes.data() + 24, m_source.session.data(), 16);
+    std::memcpy(bytes.data() + 40, m_source.lease.data(), 16);
+    std::memcpy(bytes.data() + 56, m_source.output.data(), 16);
+    if (pose) {
+        put(72, pose->captureTimeNs, 8); put(80, pose->sourceCaptureTimeNs, 8);
+        put(88, pose->uncertaintyNs, 8); put(96, pose->origin, 8);
+        for (size_t i = 0; i < 4; ++i) put(104 + i * 8, std::bit_cast<uint64_t>(pose->orientation[i]), 8);
+        put(136, pose->sourceEpoch, 4); put(140, pose->mounting, 4);
+        put(144, pose->orientationValid ? 1 : 0, 4);
+    }
+    put(148, uint16_t(reason), 2);
+    if (m_socket < 0 || ::send(m_socket, bytes.data(), bytes.size(), MSG_NOSIGNAL | MSG_DONTWAIT) != ssize_t(bytes.size())) {
+        // Never retain an apparently healthy source after bounded delivery fails.
+        close();
+        return false;
+    }
+    return true;
+}
+void HeadsetPoseConsumer::submitPose(const KRdp::StereoPose &pose) noexcept { send(1, &pose); }
+void HeadsetPoseConsumer::invalidateSource(const KRdp::TrackingSource &, KRdp::TrackingReason reason) noexcept { send(2, nullptr, reason); }
+void HeadsetPoseConsumer::unregisterSource(const KRdp::TrackingSource &) noexcept { send(3); close(); }
