new file mode 100644
index 0000000..a405826
--- /dev/null
+++ b/src/stereotracking/Channel.cpp
@@ -0,0 +1,112 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "Channel.h"
+#include "krdp_logging.h"
+#include <freerdp/channels/wtsvc.h>
+#include <time.h>
+#include <winpr/wtsapi.h>
+
+namespace KRdp::StereoTracking
+{
+uint64_t Channel::now()
+{
+    timespec t{};
+    if (clock_gettime(CLOCK_BOOTTIME, &t) != 0)
+        return 0;
+    return uint64_t(t.tv_sec) * 1000000000ULL + t.tv_nsec;
+}
+Channel::Channel(HANDLE manager, TrackingGrant grant, uint64_t peer, Options options, StereoPoseConsumer &consumer, uint64_t now)
+    : m_started(now)
+{
+    char name[] = "Sparky.StereoDroid.Pose.1";
+    ULONG *sessionId = nullptr;
+    DWORD size = 0;
+    if (!WTSQuerySessionInformationA(manager, WTS_CURRENT_SESSION, WTSSessionId, reinterpret_cast<char **>(&sessionId), &size))
+        return;
+    const auto id = *sessionId;
+    WTSFreeMemory(sessionId);
+    m_channel = WTSVirtualChannelOpenEx(id, name, WTS_CHANNEL_OPTION_DYNAMIC | WTS_CHANNEL_OPTION_DYNAMIC_PRI_HIGH);
+    if (!m_channel) {
+        qCWarning(KRDP) << "Stereo tracking channel unavailable";
+        return;
+    }
+    qCInfo(KRDP) << "STEREO_DVC_OPEN requested";
+    auto writer = [this](std::span<const uint8_t> bytes) {
+        ULONG written = 0;
+        return m_channel && bytes.size() <= 4096
+            && WTSVirtualChannelWrite(m_channel, reinterpret_cast<char *>(const_cast<uint8_t *>(bytes.data())), bytes.size(), &written)
+            && written == bytes.size();
+    };
+    static std::atomic_uint32_t nextEpoch{1};
+    const auto epoch = nextEpoch.fetch_add(1);
+    m_session = std::make_unique<Session>(std::move(grant), peer, options, epoch, consumer, writer, now);
+}
+Channel::~Channel()
+{
+    close(TrackingReason::PeerDisconnected);
+}
+void Channel::close(TrackingReason reason)
+{
+    if (m_session)
+        m_session->stop(reason);
+    if (m_channel) {
+        WTSVirtualChannelClose(m_channel);
+        m_channel = nullptr;
+    }
+}
+void Channel::poll(uint64_t now, bool recenter)
+{
+    if (!m_channel || !m_session)
+        return;
+    if (m_closeAt) {
+        if (now >= *m_closeAt)
+            close(m_session->reason());
+        return;
+    }
+
+    if (!m_ready) {
+        void *data = nullptr;
+        DWORD size = 0;
+        if (!WTSVirtualChannelQuery(m_channel, WTSVirtualChannelReady, &data, &size)) {
+            qCWarning(KRDP) << "STEREO_DVC_REJECTED";
+            close(TrackingReason::PeerDisconnected);
+            return;
+        }
+        m_ready = data && size == sizeof(BOOL) && *static_cast<BOOL *>(data);
+        WTSFreeMemory(data);
+        if (!m_ready) {
+            if (now - m_started > 5000000000)
+                close(TrackingReason::PeerDisconnected);
+            return;
+        }
+        qCInfo(KRDP) << "STEREO_DVC_READY";
+    }
+    std::array<uint8_t, 4096> bytes{};
+    // Bound work per turn so a flooding peer cannot starve input or freshness timers.
+    for (unsigned n = 0; n < 16; ++n) {
+        ULONG read = 0;
+        if (!WTSVirtualChannelRead(m_channel, 0, reinterpret_cast<char *>(bytes.data()), bytes.size(), &read)) {
+            if (GetLastError() != ERROR_NO_DATA)
+                close(TrackingReason::PeerDisconnected);
+            break;
+        }
+        if (!read)
+            break;
+        if (!m_session->receive(std::span(bytes).first(read), now))
+            break;
+    }
+    if (recenter)
+        m_session->recenter(now);
+    m_session->tick(now);
+    if (m_session->state() != m_loggedState || m_session->reason() != m_loggedReason) {
+        m_loggedState = m_session->state();
+        m_loggedReason = m_session->reason();
+        qCInfo(KRDP) << "STEREO_STATE" << uint16_t(m_loggedState) << "reason" << uint16_t(m_loggedReason) << "pcNs" << now;
+    }
+    if (m_session->closed()) {
+        // Invalidation is immediate. Let the manager flush the queued terminal
+        // STATUS before closing the DVC and discarding its unsent messages.
+        m_closeAt = now + 100000000;
+    }
+}
+}
