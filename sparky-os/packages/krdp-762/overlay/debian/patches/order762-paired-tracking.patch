+#pragma once
+#include "../StereoPose.h"
+#include "ClockSync.h"
+#include "Geometry.h"
+#include "Protocol.h"
+namespace KRdp::StereoTracking
+{
+class PoseState
+{
+public:
+    PoseState(TrackingGrant grant, uint64_t peer, uint32_t epoch, uint16_t sensor, uint32_t mounting, StereoPoseConsumer &consumer);
+    ~PoseState();
+    bool accept(const Message &message, const ClockSync &clock, uint64_t now);
+    void tick(uint64_t now);
+    bool requestRecenter();
+    void pause(TrackingReason reason);
+    void stop(TrackingReason reason);
+    TrackingState state() const
+    {
+        return m_state;
+    }
+    TrackingReason reason() const
+    {
+        return m_reason;
+    }
+    const std::optional<StereoPose> &latest() const
+    {
+        return m_latest;
+    }
+
+private:
+    bool authorized() const;
+    void invalidate(TrackingState state, TrackingReason reason);
+    TrackingGrant m_grant;
+    uint64_t m_peer;
+    uint32_t m_epoch;
+    uint16_t m_sensor;
+    uint32_t m_mounting;
+    StereoPoseConsumer &m_consumer;
+    Geometry m_geometry;
+    TrackingState m_state = TrackingState::Pending;
+    TrackingReason m_reason = TrackingReason::None;
+    bool m_registered = false;
+    bool m_needRecenter = false;
+    std::optional<uint32_t> m_sourceEpoch;
+    std::optional<StereoPose> m_latest;
+    std::optional<uint64_t> m_lastSequence;
+    std::optional<uint64_t> m_lastSensorTime;
