diff --git a/examples/stereopose/main.cpp b/examples/stereopose/main.cpp
new file mode 100644
index 0000000..32aeb48
--- /dev/null
+++ b/examples/stereopose/main.cpp
@@ -0,0 +1,191 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: BSD-2-Clause
+#include "RdpConnection.h"
+#include "Server.h"
+#include "VideoStream.h"
+#include <QCommandLineParser>
+#include <QGuiApplication>
+#include <QHostAddress>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QTimer>
+#include <array>
+#include <atomic>
+#include <cstdio>
+
+using namespace KRdp;
+// The fixture owns no real output or desktop input permission. This exercises
+// the proposed consumer seam with an explicitly synthetic grant and a bounded
+// single-producer/single-consumer mailbox, never KWin input injection.
+class Consumer : public StereoPoseConsumer
+{
+public:
+    struct Sample {
+        uint64_t capture, sourceCapture, uncertainty, origin;
+        uint32_t epoch, mount;
+        uint16_t sensor;
+        int16_t accuracy;
+        bool drift;
+        std::array<double, 4> orientation;
+    };
+    std::array<Sample, 256> samples;
+    std::atomic_uint written = 0, read = 0, poses = 0, invalidations = 0, removed = 0;
+    std::atomic_bool valid = false;
+    bool registerSource(const TrackingSource &) noexcept override
+    {
+        return true;
+    }
+    void submitPose(const StereoPose &p) noexcept override
+    {
+        const auto w = written.load(std::memory_order_relaxed);
+        if (w - read.load(std::memory_order_acquire) >= samples.size())
+            return;
+        samples[w % samples.size()] = {p.captureTimeNs,
+                                       p.sourceCaptureTimeNs,
+                                       p.uncertaintyNs,
+                                       p.origin,
+                                       p.sourceEpoch,
+                                       p.mounting,
+                                       p.sensorType,
+                                       p.sensorAccuracy,
+                                       p.yawMayDrift,
+                                       p.orientation};
+        written.store(w + 1, std::memory_order_release);
+        poses.fetch_add(1);
+        valid.store(true);
+    }
+    void invalidateSource(const TrackingSource &, TrackingReason) noexcept override
+    {
+        valid.store(false);
+        invalidations.fetch_add(1);
+    }
+    void unregisterSource(const TrackingSource &) noexcept override
+    {
+        valid.store(false);
+        removed.fetch_add(1);
+    }
+    void drain()
+    {
+        auto r = read.load(std::memory_order_relaxed);
+        const auto w = written.load(std::memory_order_acquire);
+        while (r < w) {
+            const auto &p = samples[r % samples.size()];
+            QJsonArray q;
+            for (double v : p.orientation)
+                q.append(v);
+            const QJsonObject object{{QStringLiteral("captureNs"), QString::number(p.capture)},
+                                     {QStringLiteral("sourceCaptureNs"), QString::number(p.sourceCapture)},
+                                     {QStringLiteral("uncertaintyNs"), QString::number(p.uncertainty)},
+                                     {QStringLiteral("origin"), QString::number(p.origin)},
+                                     {QStringLiteral("sourceEpoch"), int(p.epoch)},
+                                     {QStringLiteral("mounting"), int(p.mount)},
+                                     {QStringLiteral("sensor"), int(p.sensor)},
+                                     {QStringLiteral("accuracy"), int(p.accuracy)},
+                                     {QStringLiteral("yawMayDrift"), p.drift},
+                                     {QStringLiteral("orientation"), q},
+                                     {QStringLiteral("position"), QJsonValue::Null},
+                                     {QStringLiteral("confidence"), QJsonValue::Null},
+                                     {QStringLiteral("positionValid"), false},
+                                     {QStringLiteral("positionModeled"), false}};
+            const auto json = QJsonDocument(object).toJson(QJsonDocument::Compact);
+            std::printf("POSE %s\n", json.constData());
+            ++r;
+        }
+        read.store(r, std::memory_order_release);
+    }
+};
+int main(int argc, char **argv)
+{
+    QGuiApplication app(argc, argv);
+    QCommandLineParser args;
+    args.addHelpOption();
+    args.addOption({QStringLiteral("certificate"), QStringLiteral("Disposable fixture certificate"), QStringLiteral("file")});
+    args.addOption({QStringLiteral("key"), QStringLiteral("Disposable fixture key"), QStringLiteral("file")});
+    args.addOption({QStringLiteral("seconds"), QStringLiteral("Probe duration"), QStringLiteral("n"), QStringLiteral("20")});
+    args.addOption({QStringLiteral("rate"), QStringLiteral("Explicit publication rate"), QStringLiteral("hz"), QStringLiteral("60")});
+    args.addOption({QStringLiteral("sensor"), QStringLiteral("Explicit fused sensor type"), QStringLiteral("type"), QStringLiteral("15")});
+    args.addOption({QStringLiteral("mount"), QStringLiteral("Explicit mounting quarter turn"), QStringLiteral("n"), QStringLiteral("1")});
+    args.addOption({QStringLiteral("negative"), QStringLiteral("Require a connected peer and no pose")});
+    args.addOption({QStringLiteral("recenter-at"), QStringLiteral("Recenter after milliseconds"), QStringLiteral("ms"), QStringLiteral("0")});
+    args.addOption({QStringLiteral("revoke-at"), QStringLiteral("Revoke after milliseconds"), QStringLiteral("ms"), QStringLiteral("0")});
+    args.process(app);
+    if (args.value(QStringLiteral("certificate")).isEmpty() || args.value(QStringLiteral("key")).isEmpty())
+        return 2;
+    Server server;
+    server.setAddress(QHostAddress::AnyIPv4);
+    server.setPort(3389);
+    server.setUsePAMAuthentication(true);
+    server.setTlsCertificate(args.value(QStringLiteral("certificate")).toStdString());
+    server.setTlsCertificateKey(args.value(QStringLiteral("key")).toStdString());
+    server.addUser({QStringLiteral("fixture"), QStringLiteral("fixture"), false});
+    auto consumer = std::make_shared<Consumer>();
+    auto active = std::make_shared<std::atomic_bool>(true);
+    bool connected = false;
+    QTimer deadline;
+    deadline.setSingleShot(true);
+    QObject::connect(&server, &Server::newConnectionCreated, &app, [&](RdpConnection *connection) {
+        TrackingGrant grant;
+        grant.peerToken = connection->stereoTrackingPeerToken();
+        grant.remoteInputApproved = true;
+        grant.active = active;
+        grant.source.source[0] = 1;
+        grant.source.session[0] = 2;
+        grant.source.lease[0] = 3;
+        grant.source.output[0] = 4;
+        grant.source.seat = "fixture-seat";
+        const StereoTracking::Options options{uint16_t(args.value(QStringLiteral("rate")).toUInt()),
+                                              uint16_t(args.value(QStringLiteral("sensor")).toUInt()),
+                                              uint16_t(args.value(QStringLiteral("mount")).toUInt())};
+        if (!connection->configureStereoTracking(grant, options, consumer)) {
+            app.exit(3);
+            return;
+        }
+        QObject::connect(connection, &RdpConnection::stateChanged, &app, [&, connection](RdpConnection::State state) {
+            std::printf("RDP_STATE %d\n", int(state));
+            if (!connected && (state == RdpConnection::State::Activated || state == RdpConnection::State::Streaming)) {
+                connected = true;
+                deadline.start(args.value(QStringLiteral("seconds")).toInt() * 1000);
+                const auto recenter = args.value(QStringLiteral("recenter-at")).toInt();
+                if (recenter > 0)
+                    QTimer::singleShot(recenter, connection, &RdpConnection::recenterStereoTracking);
+                const auto revoke = args.value(QStringLiteral("revoke-at")).toInt();
+                if (revoke > 0)
+                    QTimer::singleShot(revoke, &app, [active] {
+                        active->store(false);
+                        std::puts("GRANT_REVOKED");
+                    });
+            }
+        });
+    });
+    QTimer::singleShot(35000, &app, [&] {
+        if (!connected) {
+            std::puts("POSE_RESULT FAIL no activated peer");
+            app.exit(1);
+        }
+    });
+    QTimer drain;
+    QObject::connect(&drain, &QTimer::timeout, &app, [&] {
+        consumer->drain();
+    });
+    drain.start(20);
+    QObject::connect(&deadline, &QTimer::timeout, &app, [&] {
+        consumer->drain();
+        const auto n = consumer->poses.load();
+        const bool passed = connected && (args.isSet(QStringLiteral("negative")) ? n == 0 : n >= 10);
+        std::printf("POSE_RESULT %s connected=%d poses=%u invalidations=%u unregistered=%u valid=%d\n",
+                    passed ? "PASS" : "FAIL",
+                    connected,
+                    n,
+                    consumer->invalidations.load(),
+                    consumer->removed.load(),
+                    consumer->valid.load());
+        server.stop();
+        app.exit(passed ? 0 : 1);
+    });
+    if (!server.start())
+        return 4;
+    std::setvbuf(stdout, nullptr, _IOLBF, 0);
+    std::puts("LISTENING synthetic grant; no compositor input");
+    return app.exec();
+}
