+
+namespace KRdp::StereoTracking
+{
+class Channel
+{
+public:
+    Channel(HANDLE manager, TrackingGrant grant, uint64_t peer, Options options, StereoPoseConsumer &consumer, uint64_t now);
+    ~Channel();
+    void poll(uint64_t now, bool recenter);
+    static uint64_t now();
+
+private:
+    void close(TrackingReason reason);
+    HANDLE m_channel = nullptr;
+    std::unique_ptr<Session> m_session;
+    uint64_t m_started;
+    std::optional<uint64_t> m_closeAt;
+    bool m_ready = false;
+    TrackingState m_loggedState = TrackingState::Pending;
+    TrackingReason m_loggedReason = TrackingReason::None;
+};
+}
diff --git a/src/stereotracking/ClockSync.cpp b/src/stereotracking/ClockSync.cpp
new file mode 100644
index 0000000..2a46f1e
--- /dev/null
+++ b/src/stereotracking/ClockSync.cpp
@@ -0,0 +1,60 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "ClockSync.h"
+#include <cmath>
+#include <limits>
+
+namespace KRdp::StereoTracking
+{
+bool ClockSync::addExchange(uint64_t t0, uint64_t t1, uint64_t t2, uint64_t t3)
+{
+    const auto invalid = [this] {
+        reset();
+        return false;
+    };
+    constexpr auto limit = uint64_t(std::numeric_limits<int64_t>::max());
+    if (t0 > limit || t1 > limit || t2 > limit || t3 > limit || t3 < t0 || t2 < t1 || t3 - t0 < t2 - t1 || (!m_window.empty() && t3 < m_window.back().pcTime))
+        return invalid();
+    const long double offset = ((static_cast<long double>(t1) - t0) + (static_cast<long double>(t2) - t3)) / 2;
+    if (offset < -static_cast<long double>(limit) || offset > static_cast<long double>(limit))
+        return invalid();
+    Estimate sample{int64_t(std::llround(offset)), (t3 - t0 - (t2 - t1) + 1) / 2, t3};
+    if (!m_window.empty()) {
+        const Estimate *best = &m_window.front();
+        for (const auto &e : m_window)
+            if (e.uncertainty <= best->uncertainty)
+                best = &e;
+        const auto bound = best->uncertainty + sample.uncertainty + 10000000 + (t3 - best->pcTime) / 1000;
+        if (std::abs(static_cast<long double>(sample.offset) - best->offset) > bound)
+            return invalid();
+    }
+    m_window.push_back(sample);
+    if (m_window.size() > 8)
+        m_window.pop_front();
+    return true;
+}
+std::optional<CaptureTime> ClockSync::map(uint64_t phoneTime, uint64_t nowPc) const
+{
+    constexpr auto limit = uint64_t(std::numeric_limits<int64_t>::max());
+    if (m_window.size() != 8 || phoneTime > limit || nowPc > limit)
+        return {};
+    const Estimate *best = &m_window.front();
+    for (const auto &e : m_window)
+        if (e.uncertainty <= best->uncertainty)
+            best = &e;
+    if (nowPc < best->pcTime)
+        return {};
+    // Engineering drift allowance between exchanges: 1000 ppm, not a measured device bound.
+    const auto uncertainty = best->uncertainty + (nowPc - best->pcTime) / 1000;
+    if (uncertainty > 10000000)
+        return {};
+    const long double capture = static_cast<long double>(phoneTime) - best->offset;
+    if (capture < 0 || capture > limit)
+        return {};
+    return CaptureTime{uint64_t(std::llround(capture)), uncertainty};
+}
+void ClockSync::reset()
+{
+    m_window.clear();
+}
+}
