new file mode 100644
index 0000000..5e821b7
--- /dev/null
+++ b/src/StereoPose.h
@@ -0,0 +1,92 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+
+namespace KRdp
+{
+namespace StereoTracking
+{
+struct Options {
+    uint16_t rate = 60;
+    uint16_t sensor = 15;
+    uint16_t mounting = 1;
+};
+}
+using TrackingId = std::array<uint8_t, 16>;
+enum class TrackingState : uint16_t {
+    Pending,
+    Active,
+    Paused,
+    Unavailable,
+    Error,
+    Stopped
+};
+enum class TrackingReason : uint16_t {
+    None,
+    NoSensor,
+    UnsupportedVersion,
+    PermissionDenied,
+    CameraUnavailable,
+    EncoderUnavailable,
+    TrackerUnavailable,
+    TimingUnavailable,
+    StaleInput,
+    InvalidMessage,
+    CalibrationRequired,
+    PeerDisconnected,
+    SensorRestarted
+};
+// Prototype input contract for the proposed common stereo pointer adapter.
+// This does not grant KWin input permission or define a Wayland protocol.
+struct TrackingSource {
+    TrackingId source{};
+    TrackingId session{};
+    TrackingId lease{};
+    TrackingId output{};
+    std::string seat;
+    std::string kind = "phone-orientation";
+};
+struct TrackingGrant {
+    TrackingSource source;
+    uint64_t peerToken = 0;
+    bool remoteInputApproved = false;
+    std::shared_ptr<std::atomic_bool> active;
+};
+struct StereoPose {
+    TrackingSource source;
+    uint64_t origin = 0;
+    uint64_t captureTimeNs = 0;
+    uint64_t sourceCaptureTimeNs = 0; // Original phone sensor clock, retained for diagnostics.
+    uint64_t uncertaintyNs = 0;
+    std::array<double, 4> orientation{}; // Canonical U frame, xyzw; look -Z, up +Y.
+    std::optional<std::array<double, 3>> positionMeters;
+    std::optional<double> confidence; // Android accuracy is not a calibrated confidence.
+    int16_t sensorAccuracy = -1;
+    uint16_t sensorType = 0;
+    bool yawMayDrift = false;
+    uint32_t sourceEpoch = 0;
+    uint32_t mounting = 0;
+    bool orientationValid = false;
+    bool positionValid = false;
+    bool positionModeled = false;
+};
+class StereoPoseConsumer
+{
+public:
+    virtual ~StereoPoseConsumer() = default;
+    virtual bool available() const noexcept { return true; }
+    virtual TrackingReason unavailableReason() const noexcept { return TrackingReason::PermissionDenied; }
+    // Called on the RDP worker. Implementations must use bounded, nonblocking delivery.
+    virtual bool registerSource(const TrackingSource &) noexcept = 0;
+    virtual void submitPose(const StereoPose &) noexcept = 0;
+    // Release held gestures/actions whenever the source is invalidated or revoked.
+    virtual void invalidateSource(const TrackingSource &, TrackingReason) noexcept = 0;
+    virtual void unregisterSource(const TrackingSource &) noexcept = 0;
+};
+}
