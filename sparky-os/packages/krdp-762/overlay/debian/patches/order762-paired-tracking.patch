+    uint64_t m_origin = 1;
+    unsigned m_recovery = 0;
+};
+}
diff --git a/src/stereotracking/Protocol.cpp b/src/stereotracking/Protocol.cpp
new file mode 100644
index 0000000..5d44941
--- /dev/null
+++ b/src/stereotracking/Protocol.cpp
@@ -0,0 +1,216 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "Protocol.h"
+#include <algorithm>
+#include <bit>
+#include <cmath>
+
+namespace KRdp::StereoTracking
+{
+namespace
+{
+uint16_t u16(std::span<const uint8_t> p, size_t i)
+{
+    return uint16_t(p[i]) | (uint16_t(p[i + 1]) << 8);
+}
+uint32_t u32(std::span<const uint8_t> p, size_t i)
+{
+    return uint32_t(u16(p, i)) | (uint32_t(u16(p, i + 2)) << 16);
+}
+uint64_t u64(std::span<const uint8_t> p, size_t i)
+{
+    return uint64_t(u32(p, i)) | (uint64_t(u32(p, i + 4)) << 32);
+}
+void put(std::vector<uint8_t> &p, size_t i, uint64_t value, size_t size)
+{
+    for (size_t n = 0; n < size; ++n)
+        p[i + n] = uint8_t(value >> (8 * n));
+}
+bool zero(std::span<const uint8_t> p)
+{
+    return std::all_of(p.begin(), p.end(), [](uint8_t x) {
+        return x == 0;
+    });
+}
+bool utf8(std::span<const uint8_t> p)
+{
+    size_t i = 0;
+    while (i < p.size()) {
+        const uint8_t lead = p[i++];
+        if (lead < 0x80)
+            continue;
+        unsigned count;
+        uint32_t cp;
+        if (lead >= 0xc2 && lead <= 0xdf) {
+            count = 1;
+            cp = lead & 0x1f;
+        } else if (lead >= 0xe0 && lead <= 0xef) {
+            count = 2;
+            cp = lead & 0x0f;
+        } else if (lead >= 0xf0 && lead <= 0xf4) {
+            count = 3;
+            cp = lead & 7;
+        } else
+            return false;
+        const unsigned length = count;
+        if (i + count > p.size())
+            return false;
+        while (count--) {
+            const auto c = p[i++];
+            if ((c & 0xc0) != 0x80)
+                return false;
+            cp = (cp << 6) | (c & 0x3f);
+        }
+        if ((length == 1 && cp < 0x80) || (length == 2 && cp < 0x800) || (length == 3 && cp < 0x10000) || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff))
+            return false;
+    }
+    return true;
+}
+bool payloadValid(Type type, uint32_t epoch, std::span<const uint8_t> p)
+{
+    switch (type) {
+    case Type::Hello:
+        return epoch == 0 && p.size() == 64 && (u64(p, 16) & ~15ULL) == 0 && (u32(p, 24) & ~3U) == 0 && u16(p, 28) <= 120 && u16(p, 30) <= 3 && u32(p, 36) >= 32
+            && u32(p, 36) <= 4096 && u16(p, 46) == 0 && (!(u64(p, 16) & 1) || (u32(p, 24) != 0 && u16(p, 28) != 0));
+    case Type::Select: {
+        if (epoch == 0 || p.size() != 64 || (u64(p, 32) & ~15ULL) != 0 || u32(p, 52) != epoch || !zero(p.subspan(56)) || u16(p, 48) > 3 || u16(p, 44) != 100
+            || u16(p, 46) != 250)
+            return false;
+        const auto hz = u16(p, 40);
+        const auto sensor = u16(p, 42);
+        if (u16(p, 50) == 1)
+            return (u64(p, 32) & 1) && (sensor == 11 || sensor == 15) && (hz == 30 || hz == 60 || hz == 90 || hz == 120);
+        return u16(p, 50) == 2 && !(u64(p, 32) & 1) && hz == 0 && sensor == 0;
+    }
+    case Type::Pose: {
+        if (epoch == 0 || p.size() != 32 || (u16(p, 16) != 11 && u16(p, 16) != 15) || int16_t(u16(p, 18)) < -1 || int16_t(u16(p, 18)) > 3
+            || (u32(p, 20) & ~3U) != 0 || u32(p, 28) > 3)
+            return false;
+        double norm2 = 0;
+        for (size_t i = 0; i < 16; i += 4) {
+            const auto value = std::bit_cast<float>(u32(p, i));
+            if (!std::isfinite(value))
+                return false;
+            norm2 += double(value) * value;
+        }
+        return norm2 >= .99 * .99 && norm2 <= 1.01 * 1.01;
+    }
+    case Type::ClockRequest:
+        return epoch != 0 && p.size() == 8;
+    case Type::ClockResponse:
+        return epoch != 0 && p.size() == 24 && u64(p, 16) >= u64(p, 8);
+    case Type::Status:
+        return p.size() >= 8 && p.size() <= 520 && u16(p, 0) <= 5 && u16(p, 2) <= 12 && u32(p, 4) == p.size() - 8 && utf8(p.subspan(8));
+    }
+    return false;
+}
+}
+
+std::optional<Message> decode(std::span<const uint8_t> bytes, Receiver receiver, std::string &error)
+{
+    error.clear();
+    if (bytes.size() >= 32 && std::equal(bytes.begin(), bytes.begin() + 4, "SDP1") && u16(bytes, 4) != 1) {
+        error = "Unsupported pose version";
+        return {};
+    }
+    if (bytes.size() < 32 || bytes.size() > 4096 || !std::equal(bytes.begin(), bytes.begin() + 4, "SDP1") || u16(bytes, 4) != 1
+        || u32(bytes, 8) != bytes.size()) {
+        error = "Invalid pose envelope";
+        return {};
+    }
+    const auto type = Type(u16(bytes, 6));
+    if ((receiver == Receiver::PC && (type == Type::Select || type == Type::ClockRequest))
+        || (receiver == Receiver::Phone && (type == Type::Hello || type == Type::Pose || type == Type::ClockResponse))) {
+        error = "Invalid pose message direction";
+        return {};
+    }
+    if (!payloadValid(type, u32(bytes, 12), bytes.subspan(32))) {
+        error = "Invalid pose message payload";
+        return {};
+    }
+    return Message{type, u32(bytes, 12), u64(bytes, 16), u64(bytes, 24), {bytes.begin() + 32, bytes.end()}};
+}
+
+std::optional<Pose> decodePose(const Message &message)
+{
+    const auto p = std::span(message.payload);
+    if (message.type != Type::Pose || !payloadValid(Type::Pose, message.epoch, p))
+        return {};
+    Pose result{};
+    double norm2 = 0;
+    for (size_t i = 0; i < 4; ++i) {
+        result.quaternion[i] = std::bit_cast<float>(u32(p, i * 4));
+        norm2 += result.quaternion[i] * result.quaternion[i];
+    }
+    for (auto &v : result.quaternion)
+        v /= std::sqrt(norm2);
+    result.sensor = u16(p, 16);
+    result.accuracy = int16_t(u16(p, 18));
+    result.flags = u32(p, 20);
+    result.sourceEpoch = u32(p, 24);
+    result.mounting = u32(p, 28);
+    return result;
+}
+
+std::vector<uint8_t> encode(const Message &message)
+{
+    if (!payloadValid(message.type, message.epoch, message.payload))
+        return {};
+    std::vector<uint8_t> result(32 + message.payload.size());
+    std::copy_n("SDP1", 4, result.begin());
+    put(result, 4, 1, 2);
+    put(result, 6, uint16_t(message.type), 2);
+    put(result, 8, result.size(), 4);
+    put(result, 12, message.epoch, 4);
+    put(result, 16, message.sequence, 8);
+    put(result, 24, message.timeNs, 8);
+    std::copy(message.payload.begin(), message.payload.end(), result.begin() + 32);
+    return result;
+}
+
+bool Framer::feed(std::span<const uint8_t> bytes, Receiver receiver, std::vector<Message> &messages, std::string &error)
+{
+    if (m_failed) {
+        error = "Pose framing already failed";
+        return false;
+    }
+    while (!bytes.empty()) {
+        const auto count = std::min(m_expected - m_bytes.size(), bytes.size());
+        m_bytes.insert(m_bytes.end(), bytes.begin(), bytes.begin() + count);
+        bytes = bytes.subspan(count);
+        if (m_bytes.size() != m_expected)
+            continue;
+        if (m_expected == 32) {
+            const auto total = u32(m_bytes, 8);
+            if (std::equal(m_bytes.begin(), m_bytes.begin() + 4, "SDP1") && u16(m_bytes, 4) != 1) {
+                m_failed = true;
+                error = "Unsupported pose version";
+                return false;
+            }
+            if (!std::equal(m_bytes.begin(), m_bytes.begin() + 4, "SDP1") || u16(m_bytes, 4) != 1 || total < 32 || total > 4096) {
+                m_failed = true;
+                error = "Invalid fragmented pose envelope";
+                return false;
+            }
+            m_expected = total;
+            if (total > 32)
+                continue;
+        }
+        auto message = decode(m_bytes, receiver, error);
+        if (!message) {
+            m_failed = true;
+            return false;
+        }
+        messages.push_back(std::move(*message));
+        m_bytes.clear();
+        m_expected = 32;
+    }
+    return true;
+}
+void Framer::reset()
+{
+    m_bytes.clear();
+    m_expected = 32;
+    m_failed = false;
+}
+}
diff --git a/src/stereotracking/Protocol.h b/src/stereotracking/Protocol.h
new file mode 100644
index 0000000..9b08209
--- /dev/null
+++ b/src/stereotracking/Protocol.h
@@ -0,0 +1,54 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#pragma once
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace KRdp::StereoTracking
+{
+enum class Type : uint16_t {
+    Hello = 1,
+    Select,
+    Pose,
+    ClockRequest,
+    ClockResponse,
+    Status
+};
+enum class Receiver {
+    Phone,
+    PC
+};
+struct Message {
+    Type type;
+    uint32_t epoch;
+    uint64_t sequence;
+    uint64_t timeNs;
+    std::vector<uint8_t> payload;
+};
+struct Pose {
+    std::array<double, 4> quaternion; // Device-to-world, xyzw.
+    uint16_t sensor;
+    int16_t accuracy;
+    uint32_t flags;
+    uint32_t sourceEpoch;
+    uint32_t mounting;
+};
+std::optional<Message> decode(std::span<const uint8_t> bytes, Receiver receiver, std::string &error);
+std::optional<Pose> decodePose(const Message &message);
+std::vector<uint8_t> encode(const Message &message);
+class Framer
+{
+public:
+    bool feed(std::span<const uint8_t> bytes, Receiver receiver, std::vector<Message> &messages, std::string &error);
+    void reset();
+
+private:
+    std::vector<uint8_t> m_bytes;
+    size_t m_expected = 32;
+    bool m_failed = false;
+};
+}
diff --git a/src/stereotracking/Session.cpp b/src/stereotracking/Session.cpp
new file mode 100644
index 0000000..39da509
--- /dev/null
+++ b/src/stereotracking/Session.cpp
@@ -0,0 +1,213 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "Session.h"
+#include <algorithm>
+
+namespace KRdp::StereoTracking
+{
+namespace
+{
+uint64_t get(std::span<const uint8_t> p, size_t i, size_t n)
+{
+    uint64_t v = 0;
+    for (size_t k = 0; k < n; ++k)
+        v |= uint64_t(p[i + k]) << (8 * k);
+    return v;
+}
+void put(std::vector<uint8_t> &p, size_t i, uint64_t v, size_t n)
+{
+    while (n--) {
+        p[i++] = uint8_t(v);
+        v >>= 8;
+    }
+}
+}
+Session::Session(TrackingGrant grant, uint64_t peer, Options options, uint32_t epoch, StereoPoseConsumer &consumer, Writer writer, uint64_t now)
+    : m_grant(std::move(grant))
+    , m_peer(peer)
+    , m_options(options)
+    , m_epoch(epoch)
+    , m_consumer(consumer)
+    , m_writer(std::move(writer))
+    , m_started(now)
+{
+}
+Session::~Session()
+{
+    stop(TrackingReason::PeerDisconnected);
+}
+bool Session::send(Type type, std::vector<uint8_t> payload, uint64_t now)
+{
+    const auto bytes = encode({type, (m_selected || type == Type::Select) ? m_epoch : 0, m_outSequence++, now, std::move(payload)});
+    if (bytes.empty() || !m_writer(bytes)) {
+        stop(TrackingReason::PeerDisconnected);
+        return false;
+    }
+    if (type == Type::Select) m_selected = true;
+    return true;
+}
+bool Session::fail(TrackingReason reason, uint64_t now)
+{
+    m_state = TrackingState::Error;
+    m_reason = reason;
+    std::vector<uint8_t> p(8);
+    put(p, 0, uint16_t(m_state), 2);
+    put(p, 2, uint16_t(reason), 2);
+    send(Type::Status, std::move(p), now);
+    if (m_pose)
+        m_pose->stop(reason);
+    m_closed = true;
+    return false;
+}
+bool Session::receive(std::span<const uint8_t> bytes, uint64_t now)
+{
+    if (m_closed)
+        return false;
+    std::vector<Message> messages;
+    std::string error;
+    if (!m_framer.feed(bytes, Receiver::PC, messages, error))
+        return fail(error == "Unsupported pose version" ? TrackingReason::UnsupportedVersion : TrackingReason::InvalidMessage, now);
+    for (const auto &msg : messages) {
+        if ((m_sequence && msg.sequence <= *m_sequence) || (m_pose && msg.epoch != m_epoch))
+            return fail(TrackingReason::InvalidMessage, now);
+        m_sequence = msg.sequence;
+        if (!message(msg, now))
+            return false;
+    }
+    return true;
+}
+bool Session::message(const Message &msg, uint64_t now)
+{
+    if (msg.type == Type::Hello && !m_pose) {
+        const auto &h = msg.payload;
+        if (m_epoch == 0 || !(get(h, 16, 8) & 1) || !(get(h, 24, 4) & (m_options.sensor == 15 ? 1 : 2)) || get(h, 28, 2) < m_options.rate || get(h, 36, 4) < 96
+            || (m_options.sensor != 15 && m_options.sensor != 11) || m_options.mounting > 3
+            || (m_options.rate != 30 && m_options.rate != 60 && m_options.rate != 90 && m_options.rate != 120))
+            return fail(TrackingReason::NoSensor, now);
+        m_pose = std::make_unique<PoseState>(m_grant, m_peer, m_epoch, m_options.sensor, m_options.mounting, m_consumer);
+        if (m_pose->state() != TrackingState::Pending)
+            return fail(m_pose->reason(), now);
+        std::vector<uint8_t> p(64);
+        std::copy(m_grant.source.session.begin(), m_grant.source.session.end(), p.begin());
+        std::copy_n(h.begin(), 16, p.begin() + 16);
+        put(p, 32, 1, 8);
+        put(p, 40, m_options.rate, 2);
+        put(p, 42, m_options.sensor, 2);
+        put(p, 44, 100, 2);
+        put(p, 46, 250, 2);
+        put(p, 48, m_options.mounting, 2);
+        put(p, 50, 1, 2);
+        put(p, 52, m_epoch, 4);
+        return send(Type::Select, std::move(p), now);
+    }
+    if (!m_pose)
+        return fail(TrackingReason::InvalidMessage, now);
+    if (msg.type == Type::Status) {
+        const auto state = TrackingState(get(msg.payload, 0, 2));
+        const auto reason = TrackingReason(get(msg.payload, 2, 2));
+        if (state == TrackingState::Active) {
+            m_acknowledged = true;
+        } else if (state == TrackingState::Pending && reason == TrackingReason::CalibrationRequired) {
+            return recenter(now);
+        } else if (state == TrackingState::Paused || state == TrackingState::Pending) {
+            m_pose->pause(reason);
+        } else {
+            return fail(reason, now);
+        }
+        return true;
+    }
+    if (!m_acknowledged)
+        return fail(TrackingReason::InvalidMessage, now);
+    if (msg.type == Type::ClockResponse) {
+        const auto t0 = get(msg.payload, 0, 8);
+        if (!m_probe || *m_probe != t0 || !m_clock.addExchange(t0, get(msg.payload, 8, 8), get(msg.payload, 16, 8), now))
+            return fail(TrackingReason::TimingUnavailable, now);
+        m_probe.reset();
+        ++m_clockSamples;
+        return true;
+    }
+    if (msg.type == Type::Pose) {
+        // Await the eight real exchanges, never substitute receipt time.
+        if (m_clockSamples < 8)
+            return true;
+        m_pose->accept(msg, m_clock, now);
+        if (m_pose->state() == TrackingState::Error)
+            return fail(m_pose->reason(), now);
+        return true;
+    }
+    return fail(TrackingReason::InvalidMessage, now);
+}
+void Session::tick(uint64_t now)
+{
+    if (m_closed)
+        return;
+    if (!m_grant.active || !m_grant.active->load() || !m_grant.remoteInputApproved || m_grant.peerToken != m_peer) {
+        fail(TrackingReason::PermissionDenied, now);
+        return;
+    }
+    if (!m_consumer.available()) {
+        fail(TrackingReason::TrackerUnavailable, now);
+        return;
+    }
+    if ((!m_pose || !m_acknowledged) && now - m_started > 5000000000) {
+        fail(TrackingReason::PeerDisconnected, now);
+        return;
+    }
+    if (!m_pose || !m_acknowledged)
+        return;
+    m_pose->tick(now);
+    if (m_pose->state() == TrackingState::Stopped) {
+        stop(m_pose->reason());
+        return;
+    }
+    if (m_pose->state() != m_state || m_pose->reason() != m_reason) {
+        m_state = m_pose->state();
+        m_reason = m_pose->reason();
+        std::vector<uint8_t> p(8);
+        put(p, 0, uint16_t(m_state), 2);
+        put(p, 2, uint16_t(m_reason), 2);
+        if (!send(Type::Status, std::move(p), now))
+            return;
+    }
+    if (m_probe && now - *m_probe > 1000000000) {
+        fail(TrackingReason::TimingUnavailable, now);
+        return;
+    }
+    // Eight startup probes, then frequent refresh bounds the declared drift margin.
+    const auto interval = m_clockSamples < 8 ? 20000000ULL : 250000000ULL;
+    if (!m_probe && (m_lastProbe == 0 || now - m_lastProbe >= interval)) {
+        m_probe = now;
+        m_lastProbe = now;
+        std::vector<uint8_t> p(8);
+        put(p, 0, now, 8);
+        send(Type::ClockRequest, std::move(p), now);
+    }
+}
+bool Session::recenter(uint64_t now)
+{
+    if (m_closed || !m_pose || !m_pose->requestRecenter())
+        return false;
+    std::vector<uint8_t> p(8);
+    put(p, 0, uint16_t(TrackingState::Pending), 2);
+    put(p, 2, uint16_t(TrackingReason::CalibrationRequired), 2);
+    return send(Type::Status, std::move(p), now);
+}
+void Session::stop(TrackingReason reason)
+{
+    if (m_closed)
+        return;
+    if (m_pose)
+        m_pose->stop(reason);
+    m_closed = true;
+    m_state = TrackingState::Stopped;
+    m_reason = reason;
+}
+TrackingState Session::state() const
+{
+    return m_closed ? m_state : (m_pose ? m_pose->state() : m_state);
+}
+TrackingReason Session::reason() const
+{
+    return m_closed ? m_reason : (m_pose ? m_pose->reason() : m_reason);
+}
+}
