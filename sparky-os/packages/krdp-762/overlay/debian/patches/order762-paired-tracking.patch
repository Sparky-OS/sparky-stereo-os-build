+++ b/autotests/stereotracking/ClockSyncTest.cpp
@@ -0,0 +1,39 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "ClockSync.h"
+#include <cstdio>
+using namespace KRdp::StereoTracking;
+#define CHECK(t)                                                                                                                                               \
+    do {                                                                                                                                                       \
+        if (!(t)) {                                                                                                                                            \
+            std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #t);                                                                                          \
+            return 1;                                                                                                                                          \
+        }                                                                                                                                                      \
+    } while (false)
+int main()
+{
+    ClockSync clock;
+    constexpr uint64_t offset = 5000000000ULL;
+    CHECK(!clock.map(100, 100));
+    for (uint64_t i = 0; i < 8; ++i) {
+        const auto t0 = 1000000000ULL + i * 10000000ULL;
+        CHECK(clock.addExchange(t0, t0 + offset + 2000000, t0 + offset + 2100000, t0 + 4100000));
+        if (i < 7)
+            CHECK(!clock.map(t0 + offset, t0));
+    }
+    const uint64_t now = 1100000000ULL;
+    const auto mapped = clock.map(now + offset - 10000000, now);
+    CHECK(mapped && mapped->timeNs == now - 10000000);
+    CHECK(mapped->uncertaintyNs >= 2000000 && mapped->uncertaintyNs < 2100000);
+    CHECK(!clock.map(now + offset, now + 11000000000ULL));
+    CHECK(!clock.addExchange(now, now + offset, now + offset - 1, now + 100));
+    CHECK(!clock.map(now + offset, now));
+    for (uint64_t i = 0; i < 8; ++i)
+        CHECK(clock.addExchange(now + i * 10000, now + offset + i * 10000, now + offset + i * 10000, now + i * 10000));
+    CHECK(!clock.addExchange(now + 1000000, now + offset + 1000000000, now + offset + 1000000000, now + 1000001));
+    CHECK(!clock.map(now + offset, now));
+    CHECK(!clock.addExchange(20, 30, 31, 19));
+    CHECK(!clock.addExchange(20, 30, 50, 25));
+    CHECK(!clock.addExchange(UINT64_MAX, 0, 0, UINT64_MAX));
+    std::puts("PASS eight probes, known offset, processing delay, uncertainty drift, impossible order and discontinuity");
+}
diff --git a/autotests/stereotracking/GeometryTest.cpp b/autotests/stereotracking/GeometryTest.cpp
new file mode 100644
index 0000000..491f1bc
--- /dev/null
+++ b/autotests/stereotracking/GeometryTest.cpp
@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "Geometry.h"
+#include <cmath>
+#include <cstdio>
+using namespace KRdp::StereoTracking;
+#define CHECK(t)                                                                                                                                               \
+    do {                                                                                                                                                       \
+        if (!(t)) {                                                                                                                                            \
+            std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #t);                                                                                          \
+            return 1;                                                                                                                                          \
+        }                                                                                                                                                      \
+    } while (false)
+bool same(Quaternion a, Quaternion b)
+{
+    double dot = 0;
+    for (size_t i = 0; i < 4; ++i)
+        dot += a[i] * b[i];
+    return std::abs(std::abs(dot) - 1) < 1e-9;
+}
+int main()
+{
+    struct Fixture {
+        uint32_t mount;
+        Quaternion raw;
+        Quaternion expected;
+        Vector3 forward;
+        Vector3 up;
+    };
+    // Independent constant fixtures: +/-90 degrees about each physical device axis, both landscape mounts.
+    const Fixture cases[] = {
+        {1, {0, 0.70710678118654757, 0, 0.70710678118654757}, {0, 0.70710678118654757, 0, 0.70710678118654757}, {-1, 0, 0}, {0, 1, 0}},
+        {1, {0.70710678118654757, 0, -0.70710678118654757, 0}, {0, -0.70710678118654757, 0, 0.70710678118654757}, {1, 0, 0}, {0, 1, 0}},
+        {1, {0, 0, -0.70710678118654757, 0.70710678118654757}, {-0.70710678118654757, 0, 0, 0.70710678118654757}, {0, -1, 0}, {0, 0, -1}},
+        {1, {0.70710678118654757, 0.70710678118654757, 0, 0}, {0.70710678118654757, 0, 0, 0.70710678118654757}, {0, 1, 0}, {0, 0, 1}},
+        {1, {0, 0.70710678118654757, -0.70710678118654757, 0}, {0, 0, -0.70710678118654757, 0.70710678118654757}, {0, 0, -1}, {1, 0, 0}},
+        {1, {0.70710678118654757, 0, 0, 0.70710678118654757}, {0, 0, 0.70710678118654757, 0.70710678118654757}, {0, 0, -1}, {-1, 0, 0}},
+        {3, {0, -0.70710678118654757, 0, 0.70710678118654757}, {0, -0.70710678118654757, 0, 0.70710678118654757}, {1, 0, 0}, {0, 1, 0}},
+        {3, {0.70710678118654757, 0, 0.70710678118654757, 0}, {0, 0.70710678118654757, 0, 0.70710678118654757}, {-1, 0, 0}, {0, 1, 0}},
+        {3, {0.70710678118654757, -0.70710678118654757, 0, 0}, {0.70710678118654757, 0, 0, 0.70710678118654757}, {0, 1, 0}, {0, 0, 1}},
+        {3, {0, 0, 0.70710678118654757, 0.70710678118654757}, {-0.70710678118654757, 0, 0, 0.70710678118654757}, {0, -1, 0}, {0, 0, -1}},
+        {3, {0.70710678118654757, 0, 0, 0.70710678118654757}, {0, 0, -0.70710678118654757, 0.70710678118654757}, {0, 0, -1}, {1, 0, 0}},
+        {3, {0, -0.70710678118654757, 0.70710678118654757, 0}, {0, 0, 0.70710678118654757, 0.70710678118654757}, {0, 0, -1}, {-1, 0, 0}},
+    };
+    Geometry geometry;
+    CHECK(!geometry.apply({0, 0, 0, 1}, 1));
+    CHECK(!geometry.recenter({0, 0, 0, 1}, 1)); // Device back points along gravity.
+    unsigned rejectedWrongMount = 0, rejectedWFirst = 0;
+    for (const auto &test : cases) {
+        const Quaternion origin = test.mount == 1 ? Quaternion{.5, .5, -.5, .5} : Quaternion{.5, -.5, .5, .5};
+        CHECK(geometry.recenter(origin, test.mount));
+        const auto identity = geometry.apply(origin, test.mount);
+        CHECK(identity && same(*identity, {0, 0, 0, 1}));
+        const auto q = geometry.apply(test.raw, test.mount);
+        CHECK(q && same(*q, test.expected));
+        const auto forward = Geometry::rotate(*q, {0, 0, -1});
+        const auto up = Geometry::rotate(*q, {0, 1, 0});
+        for (size_t i = 0; i < 3; ++i) {
+            CHECK(std::abs(forward[i] - test.forward[i]) < 1e-9);
+            CHECK(std::abs(up[i] - test.up[i]) < 1e-9);
+        }
+        CHECK(!geometry.apply(test.raw, test.mount == 1 ? 3 : 1));
+        Geometry mutant;
+        CHECK(mutant.recenter(origin, test.mount == 1 ? 3 : 1));
+        const auto wrong = mutant.apply(test.raw, test.mount == 1 ? 3 : 1);
+        if (wrong && !same(*wrong, test.expected))
+            ++rejectedWrongMount;
+        const Quaternion wfirst = {test.raw[3], test.raw[0], test.raw[1], test.raw[2]};
+        const auto swapped = geometry.apply(wfirst, test.mount);
+        if (swapped && !same(*swapped, test.expected))
+            ++rejectedWFirst;
+        const auto direct = geometry.apply(test.raw, test.mount);
+        CHECK(direct);
+        Quaternion opposite = test.raw;
+        for (auto &v : opposite)
+            v = -v;
+        const auto continuous = geometry.apply(opposite, test.mount);
+        CHECK(continuous && same(*continuous, test.expected));
+        double dot = 0;
+        for (size_t i = 0; i < 4; ++i)
+            dot += (*direct)[i] * (*continuous)[i];
+        CHECK(dot > .999999);
+    }
+    CHECK(rejectedWrongMount >= 8 && rejectedWFirst >= 8);
+    const auto forward = Geometry::rotate({0, 0, 0, 1}, {0, 0, -1});
+    CHECK((forward == Vector3{0, 0, -1}));
+    std::printf("PASS 12 physical-axis fixtures, both mounts, wrong-mount=%u w-first=%u, sign continuity and vertical rejection\n",
+                rejectedWrongMount,
+                rejectedWFirst);
+}
diff --git a/autotests/stereotracking/PoseStateTest.cpp b/autotests/stereotracking/PoseStateTest.cpp
