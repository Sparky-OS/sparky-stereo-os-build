+#pragma once
+#include <cstdint>
+#include <deque>
+#include <optional>
+namespace KRdp::StereoTracking
+{
+struct CaptureTime {
+    uint64_t timeNs;
+    uint64_t uncertaintyNs;
+};
+class ClockSync
+{
+public:
+    bool addExchange(uint64_t t0, uint64_t t1, uint64_t t2, uint64_t t3);
+    std::optional<CaptureTime> map(uint64_t phoneTime, uint64_t nowPc) const;
+    void reset();
+
+private:
+    struct Estimate {
+        int64_t offset;
+        uint64_t uncertainty;
+        uint64_t pcTime;
+    };
+    std::deque<Estimate> m_window;
+};
+}
diff --git a/src/stereotracking/Geometry.cpp b/src/stereotracking/Geometry.cpp
new file mode 100644
index 0000000..35e5993
--- /dev/null
+++ b/src/stereotracking/Geometry.cpp
@@ -0,0 +1,89 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "Geometry.h"
+#include <cmath>
+#include <numbers>
+
+namespace KRdp::StereoTracking
+{
+namespace
+{
+Quaternion multiply(Quaternion a, Quaternion b)
+{
+    return {a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1],
+            a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0],
+            a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3],
+            a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2]};
+}
+Quaternion conjugate(Quaternion q)
+{
+    return {-q[0], -q[1], -q[2], q[3]};
+}
+std::optional<Quaternion> normalized(Quaternion q)
+{
+    double norm2 = 0;
+    for (auto v : q) {
+        if (!std::isfinite(v))
+            return {};
+        norm2 += v * v;
+    }
+    if (norm2 < .99 * .99 || norm2 > 1.01 * 1.01)
+        return {};
+    for (auto &v : q)
+        v /= std::sqrt(norm2);
+    return q;
+}
+Quaternion mountingRotation(uint32_t mount)
+{
+    const double angle = mount * std::numbers::pi / 4;
+    return {0, 0, std::sin(angle), std::cos(angle)};
+}
+}
+bool Geometry::recenter(Quaternion deviceToWorld, uint32_t mounting)
+{
+    reset();
+    const auto device = normalized(deviceToWorld);
+    if (!device || mounting > 3)
+        return false;
+    const auto head = multiply(*device, mountingRotation(mounting));
+    const auto back = rotate(head, {0, 0, 1});
+    if (std::hypot(back[0], back[1]) < .001)
+        return false;
+    const double yaw = std::atan2(back[0], -back[1]);
+    const auto z = Quaternion{0, 0, std::sin(yaw / 2), std::cos(yaw / 2)};
+    const double half = std::sqrt(.5);
+    m_reference = multiply(z, {half, 0, 0, half});
+    m_mounting = mounting;
+    m_valid = true;
+    return true;
+}
+std::optional<Quaternion> Geometry::apply(Quaternion deviceToWorld, uint32_t mounting)
+{
+    const auto device = normalized(deviceToWorld);
+    if (!m_valid || mounting != m_mounting || !device)
+        return {};
+    auto result = normalized(multiply(conjugate(m_reference), multiply(*device, mountingRotation(mounting))));
+    if (!result)
+        return {};
+    if (m_last) {
+        double dot = 0;
+        for (size_t i = 0; i < 4; ++i)
+            dot += (*m_last)[i] * (*result)[i];
+        if (dot < 0)
+            for (auto &v : *result)
+                v = -v;
+    }
+    m_last = result;
+    return result;
+}
+void Geometry::reset()
+{
+    m_valid = false;
+    m_last.reset();
+}
+Vector3 Geometry::rotate(Quaternion q, Vector3 vector)
+{
+    const auto result = multiply(multiply(q, {vector[0], vector[1], vector[2], 0}), conjugate(q));
+    return {result[0], result[1], result[2]};
+}
+}
