+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#pragma once
+#include "PoseState.h"
+#include <functional>
+
+namespace KRdp::StereoTracking
+{
+// One RDP worker owns this state. The writer must enqueue one bounded DVC message.
+class Session
+{
+public:
+    using Writer = std::function<bool(std::span<const uint8_t>)>;
+    Session(TrackingGrant grant, uint64_t peer, Options options, uint32_t epoch, StereoPoseConsumer &consumer, Writer writer, uint64_t now);
+    ~Session();
+    bool receive(std::span<const uint8_t> bytes, uint64_t now);
+    void tick(uint64_t now);
+    bool recenter(uint64_t now);
+    void stop(TrackingReason reason);
+    bool closed() const
+    {
+        return m_closed;
+    }
+    TrackingState state() const;
+    TrackingReason reason() const;
+
+private:
+    bool message(const Message &message, uint64_t now);
+    bool send(Type type, std::vector<uint8_t> payload, uint64_t now);
+    bool fail(TrackingReason reason, uint64_t now);
+    TrackingGrant m_grant;
+    uint64_t m_peer;
+    Options m_options;
+    uint32_t m_epoch;
+    StereoPoseConsumer &m_consumer;
+    Writer m_writer;
+    Framer m_framer;
+    ClockSync m_clock;
+    std::unique_ptr<PoseState> m_pose;
+    std::optional<uint64_t> m_sequence;
+    uint64_t m_outSequence = 0;
+    uint64_t m_started;
+    uint64_t m_lastProbe = 0;
+    std::optional<uint64_t> m_probe;
+    unsigned m_clockSamples = 0;
+    bool m_selected = false;
+    bool m_acknowledged = false;
+    bool m_closed = false;
+    TrackingState m_state = TrackingState::Pending;
+    TrackingReason m_reason = TrackingReason::None;
+};
+}
