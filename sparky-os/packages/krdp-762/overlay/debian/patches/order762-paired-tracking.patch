@@ -0,0 +1,34 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: BSD-2-Clause
+#include "HeadsetPoseConsumer.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+int main()
+{
+    char directory[] = "/tmp/sd762-pose-XXXXXX";
+    if (!mkdtemp(directory)) return 2;
+    const std::string path = std::string(directory) + "/pose";
+    KRdp::TrackingSource source;
+    source.source[0] = 1; source.session[0] = 2; source.lease[0] = 3; source.output[0] = 4;
+    HeadsetPoseConsumer consumer(path);
+    bool ok = !consumer.registerSource(source);
+    int server = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    sockaddr_un address{};address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+    if (bind(server, reinterpret_cast<sockaddr *>(&address), sizeof(address)) || listen(server, 1)) return 3;
+    ok = ok && consumer.registerSource(source) && consumer.available();
+    int peer = accept(server, nullptr, nullptr);
+    unsigned char bytes[161]{};
+    const auto size = recv(peer, bytes, sizeof(bytes), 0);
+    ok = ok && size == 160 && !std::memcmp(bytes,"SDVR",4) && bytes[4] == 1 && bytes[6] == 0 && bytes[8] == 1 && bytes[24] == 2 && bytes[40] == 3 && bytes[56] == 4;
+    close(peer);
+    // Losing the runtime must be observed even when Android publishes no new pose.
+    const bool lossObserved = !consumer.available();
+    std::printf("registration=%s disconnected-runtime=%s\n",ok?"PASS":"FAIL",lossObserved?"PASS":"FAIL");
+    close(server);unlink(path.c_str());rmdir(directory);
+    return ok && lossObserved ? 0 : 1;
+}
