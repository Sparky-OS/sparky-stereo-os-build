diff --git a/src/stereotracking/PoseState.cpp b/src/stereotracking/PoseState.cpp
new file mode 100644
index 0000000..b5dee62
--- /dev/null
+++ b/src/stereotracking/PoseState.cpp
@@ -0,0 +1,176 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "PoseState.h"
+#include <algorithm>
+
+namespace KRdp::StereoTracking
+{
+namespace
+{
+bool present(const TrackingId &id)
+{
+    return std::any_of(id.begin(), id.end(), [](uint8_t v) {
+        return v != 0;
+    });
+}
+}
+PoseState::PoseState(TrackingGrant grant, uint64_t peer, uint32_t epoch, uint16_t sensor, uint32_t mounting, StereoPoseConsumer &consumer)
+    : m_grant(std::move(grant))
+    , m_peer(peer)
+    , m_epoch(epoch)
+    , m_sensor(sensor)
+    , m_mounting(mounting)
+    , m_consumer(consumer)
+{
+    if (!authorized()) {
+        m_state = TrackingState::Unavailable;
+        m_reason = TrackingReason::PermissionDenied;
+        return;
+    }
+    if (epoch == 0 || (sensor != 11 && sensor != 15) || mounting > 3) {
+        m_state = TrackingState::Error;
+        m_reason = TrackingReason::InvalidMessage;
+        return;
+    }
+    m_registered = m_consumer.registerSource(m_grant.source);
+    if (!m_registered) {
+        m_state = TrackingState::Unavailable;
+        m_reason = m_consumer.unavailableReason();
+    }
+}
+PoseState::~PoseState()
+{
+    stop(TrackingReason::PeerDisconnected);
+}
+bool PoseState::authorized() const
+{
+    return m_peer != 0 && m_grant.peerToken == m_peer && m_grant.remoteInputApproved && m_grant.active && m_grant.active->load()
+        && present(m_grant.source.source) && present(m_grant.source.session) && present(m_grant.source.lease) && present(m_grant.source.output)
+        && !m_grant.source.seat.empty() && m_grant.source.kind == "phone-orientation";
+}
+void PoseState::invalidate(TrackingState state, TrackingReason reason)
+{
+    if (m_latest)
+        m_latest->orientationValid = false;
+    if (m_registered && (state != m_state || reason != m_reason || m_state == TrackingState::Active))
+        m_consumer.invalidateSource(m_grant.source, reason);
+    m_state = state;
+    m_reason = reason;
+    m_recovery = 0;
+}
+bool PoseState::accept(const Message &message, const ClockSync &clock, uint64_t now)
+{
+    if (!authorized()) {
+        stop(TrackingReason::PermissionDenied);
+        return false;
+    }
+    if (!m_registered || m_state == TrackingState::Error || m_state == TrackingState::Stopped)
+        return false;
+    const auto pose = decodePose(message);
+    if (!pose || message.epoch != m_epoch || (m_lastSequence && message.sequence <= *m_lastSequence) || pose->sensor != m_sensor
+        || pose->mounting != m_mounting) {
+        invalidate(TrackingState::Error, TrackingReason::InvalidMessage);
+        return false;
+    }
+    m_lastSequence = message.sequence;
+    if (m_needRecenter)
+        return false;
+    const auto time = clock.map(message.timeNs, now);
+    if (!time) {
+        invalidate(TrackingState::Unavailable, TrackingReason::TimingUnavailable);
+        return false;
+    }
+    if ((time->timeNs > now && time->timeNs - now > time->uncertaintyNs) || (now >= time->timeNs && now - time->timeNs > 100000000)
+        || (m_lastSensorTime && message.timeNs <= *m_lastSensorTime))
+        return false;
+    if (m_sourceEpoch && *m_sourceEpoch != pose->sourceEpoch) {
+        m_needRecenter = true;
+        invalidate(TrackingState::Paused, TrackingReason::SensorRestarted);
+        return false;
+    }
+    if (!(pose->flags & 1)) {
+        invalidate(TrackingState::Paused, TrackingReason::StaleInput);
+        return false;
+    }
+    if (!m_sourceEpoch) {
+        if (!m_geometry.recenter(pose->quaternion, m_mounting)) {
+            m_needRecenter = true;
+            invalidate(TrackingState::Paused, TrackingReason::CalibrationRequired);
+            return false;
+        }
+        m_sourceEpoch = pose->sourceEpoch;
+    }
+    const auto orientation = m_geometry.apply(pose->quaternion, m_mounting);
+    if (!orientation) {
+        invalidate(TrackingState::Error, TrackingReason::InvalidMessage);
+        return false;
+    }
+    m_lastSensorTime = message.timeNs;
+    m_lastCapture = time->timeNs;
+    if (m_state == TrackingState::Paused || m_state == TrackingState::Unavailable) {
+        if (++m_recovery < 3)
+            return false;
+    }
+    StereoPose result{};
+    result.source = m_grant.source;
+    result.origin = m_origin;
+    result.captureTimeNs = time->timeNs;
+    result.sourceCaptureTimeNs = message.timeNs;
+    result.uncertaintyNs = time->uncertaintyNs;
+    result.orientation = *orientation;
+    result.sensorAccuracy = pose->accuracy;
+    result.sensorType = pose->sensor;
+    result.yawMayDrift = (pose->flags & 2) != 0;
+    result.sourceEpoch = pose->sourceEpoch;
+    result.mounting = m_mounting;
+    result.orientationValid = true;
+    m_latest = result;
+    m_state = TrackingState::Active;
+    m_reason = TrackingReason::None;
+    m_recovery = 0;
+    m_consumer.submitPose(result);
+    return true;
+}
+void PoseState::tick(uint64_t now)
+{
+    if (!authorized()) {
+        stop(TrackingReason::PermissionDenied);
+        return;
+    }
+    if (!m_registered || m_state == TrackingState::Stopped || m_state == TrackingState::Error || m_needRecenter || !m_lastCapture)
+        return;
+    const auto age = now >= *m_lastCapture ? now - *m_lastCapture : 0;
+    if (age >= 250000000)
+        invalidate(TrackingState::Unavailable, TrackingReason::StaleInput);
+    else if (age >= 100000000)
+        invalidate(TrackingState::Paused, TrackingReason::StaleInput);
+}
+bool PoseState::requestRecenter()
+{
+    if (!authorized() || !m_registered || m_state == TrackingState::Error || m_state == TrackingState::Stopped)
+        return false;
+    invalidate(TrackingState::Pending, TrackingReason::CalibrationRequired);
+    m_geometry.reset();
+    m_sourceEpoch.reset();
+    m_lastSensorTime.reset();
+    m_lastCapture.reset();
+    m_needRecenter = false;
+    ++m_origin;
+    return true;
+}
+void PoseState::pause(TrackingReason reason)
+{
+    if (m_registered)
+        invalidate(TrackingState::Paused, reason);
+}
+void PoseState::stop(TrackingReason reason)
+{
+    if (m_registered) {
+        invalidate(TrackingState::Stopped, reason);
+        m_consumer.unregisterSource(m_grant.source);
+        m_registered = false;
+    }
+    m_state = TrackingState::Stopped;
+    m_reason = reason;
+}
+}
