menuentry 'Sparky GNU/Linux' --class sparky --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-simple-1111' {
	load_video
	set gfxpayload=$linux_gfx_mode
	insmod gzio
	linux	/boot/vmlinuz-7.3.1-stereo3d16 root=UUID=1111 ro  ${sparky_stereo_check} quiet splash ${sparky_stereo_boot}
	initrd	/boot/initrd.img-7.3.1-stereo3d16
}
submenu 'Advanced options for Sparky GNU/Linux' $menuentry_id_option 'gnulinux-advanced-1111' {
	menuentry 'Sparky GNU/Linux, with Linux 7.3.1-stereo3d16' --class sparky --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-7.3.1-stereo3d16-advanced-1111' {
		load_video
		linux	/boot/vmlinuz-7.3.1-stereo3d16 root=UUID=1111 ro  ${sparky_stereo_check} quiet splash ${sparky_stereo_boot}
		initrd	/boot/initrd.img-7.3.1-stereo3d16
	}
	menuentry 'Sparky GNU/Linux, with Linux 7.3.0-stereo3d13 (recovery mode)' --class sparky --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-7.3.0-stereo3d13-recovery-1111' {
		linux	/boot/vmlinuz-7.3.0-stereo3d13 root=UUID=1111 ro single  ${sparky_stereo_check}
		initrd	/boot/initrd.img-7.3.0-stereo3d13
	}
}
