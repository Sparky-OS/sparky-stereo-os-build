# Debian's /etc/grub.d/10_linux, with the call that records a start in each of its entries (sparky-stereo-boot 0.1.11,
# ORDER 572b). GRUB's recordfail mechanism is in Debian's grub2 and switched off: 10_linux writes "recordfail" at the
# top of an entry only when GRUB was configured with --enable-quick-boot (debian/patches/quick-boot.patch by Colin
# Watson, Richard Laager and Robie Basak; debian/rules gives the option to Ubuntu's build alone), and no setting
# reaches that. So Debian's file is moved aside (dpkg-divert, to /etc/sparky-stereo-boot/10_linux.debian, where its
# upgrades and the person's edits still go) and /etc/grub.d/10_linux is a link to this program, which runs Debian's
# file unchanged and writes that one line after each "menuentry ... {" of its output. Nothing else is changed; where
# GRUB cannot record a start, or the person turned it off (SPARKY_STEREO_RECORD, from 30-sparky-stereo-boot.cfg), the
# output is Debian's as it is.
set -e
debian=${SPARKY_STEREO_DEBIAN_10_LINUX:-/etc/sparky-stereo-boot/10_linux.debian}
lib=${SPARKY_STEREO_LIB:-/usr/lib/sparky-stereo-boot}
if [ ! -e "$debian" ]; then
	echo "sparky-stereo-boot: Debian's 10_linux is not at $debian, so no Linux entry can be written. Install grub-common again: sudo apt-get install --reinstall grub-common" >&2
	exit 1
fi
[ -x "$debian" ] || exit 0   # switched off the way GRUB's own files are (chmod -x)
case "${SPARKY_STEREO_RECORD:-off}" in off|none) exec "$debian" "$@" ;; esac
if grep -q '^quick_boot="1"' "$debian"; then exec "$debian" "$@"; fi
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
"$debian" "$@" > "$tmp"
rc=0
awk '
	{ print }
	/^[[:space:]]*menuentry[[:space:]].*\{[[:space:]]*$/ { match($0, /^[[:space:]]*/); print substr($0, 1, RLENGTH) "\trecordfail"; entries++ }
	/^[[:space:]]*linux[[:space:]]/ { kernels++ }
	END { if (kernels > 0 && entries == 0) exit 3 }
' "$tmp" || rc=$?
if [ "$rc" = 3 ]; then
	english="Debian's /etc/grub.d/10_linux wrote its entries in a form sparky-stereo-boot does not know, so a start is not recorded and GRUB's menu cannot show by itself after a start that did not finish. Then: sudo sparky-stereo-boot repair"
	if [ -f "$lib/problems.py" ] && command -v python3 >/dev/null; then
		python3 "$lib/problems.py" record start-record LOCAL97 --repair update-grub >&2
	else
		printf 'sparky-stereo-boot: %s\n' "$english" >&2
	fi
elif [ "$rc" != 0 ]; then
	exit "$rc"
elif [ -f "$lib/problems.py" ] && command -v python3 >/dev/null; then
	python3 "$lib/problems.py" clear start-record >&2
fi
exit 0
