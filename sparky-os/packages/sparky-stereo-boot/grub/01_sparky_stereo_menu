# GRUB's menu is never drawn without a loaded font (sparky-stereo-boot, ORDER 572).
# Debian's 00_header writes "if loadfont FONT; then set gfxmode=...; load_video; insmod gfxterm; ...; fi" and then
# "terminal_output gfxterm" whether the font loaded or not. When GRUB_FONT names a font file (the edition's sized
# font, or the person's), two things make that loadfont fail: Secure Boot, where Debian's signed GRUB refuses every
# font outside its own image (grub-core/kern/efi/sb.c: file types it does not list are "prohibited by secure boot
# policy"), and a font file that is gone. The menu was then drawn with GRUB's built-in ASCII glyphs, 16 pixels high,
# and a "?" in a box for every other character (the arrows, the frame, accented letters).
# This adds, right after 00_header: in those two cases GRUB loads its own font by name ("unicode": from the memdisk of
# the signed image under Secure Boot, grub-core/font/font.c and debian/build-efi-images, else from $prefix/fonts),
# takes the resolution at which that 16 pixel font has the menu's text height (SPARKY_STEREO_READABLE_GFXMODE, from
# 30-sparky-stereo-boot.cfg), and starts the graphical terminal again so it uses the font; when even that font cannot
# be loaded the menu is the firmware's text console. update-grub run under Secure Boot never names a font file
# (30-sparky-stereo-boot.cfg), so this is for Secure Boot switched on after the menu was written, and for the
# person's own GRUB_FONT.
#
# The menu shown once: a hidden menu with no wait cannot be counted on to open with a key (measured in QEMU under
# SeaBIOS and OVMF: Shift held and Esc pressed through the start opened nothing; GRUB looks at the keyboard once).
# "sudo sparky-stereo-boot menu" sets sparky_menu_once in GRUB's environment block, and so does the boot's own check
# when a Secure Boot key waits for its enrolment: the next start shows the menu for 30 seconds, then the variable goes
# (save_env here, and the boot check clears it again where GRUB cannot write the block).
set -e
cat <<'ONCE'
if [ "${sparky_menu_once}" = 1 ]; then
	set timeout_style=menu
	set timeout=30
	set sparky_menu_once=
	save_env sparky_menu_once
fi
ONCE
# After a start that did not finish (0.1.11, ORDER 572b): GRUB's recordfail, which Debian's grub2 carries switched off
# (debian/patches/quick-boot.patch by Colin Watson, Richard Laager and Robie Basak: 00_header writes the function and
# 10_linux the call only when GRUB was configured with --enable-quick-boot, which debian/rules gives Ubuntu's build
# alone). The function is written here, as 00_header would write it, when 30-sparky-stereo-boot.cfg found a place
# GRUB can write (SPARKY_STEREO_RECORD); /etc/grub.d/10_linux puts the call in each Linux entry. What 00_header's
# function tests (have_grubenv, boot_once) is kept in an exported variable, because the entries of a submenu
# ("Advanced options") see exported variables only. While the flag is set the menu is shown for the time
# 30-sparky-stereo-boot.cfg worked out, and the kernel line of that start carries fsck.mode=force (systemd-fsck(8);
# initramfs-tools checks the root file system with it) and sparky_stereo.start=unfinished, which tells the started
# system why (sparky-stereo-boot start-finished).
record=${SPARKY_STEREO_RECORD:-off}
if grep -qs '^quick_boot="1"' "${SPARKY_GRUB_00_HEADER:-/etc/grub.d/00_header}"; then
	case $record in grubenv) record=debian ;; esac   # a GRUB built with it writes the function itself
fi
case $record in
grubenv)
	cat <<'RECORD'
set sparky_record_ok="${have_grubenv}"
if [ -n "${boot_once}" ]; then
	set sparky_record_ok=
fi
export sparky_record_ok
function recordfail {
	set recordfail=1
	if [ -n "${sparky_record_ok}" ]; then save_env recordfail; fi
}
RECORD
	;;
esp:*)
	rest=${record#esp:}
	cat <<RECORD
set sparky_record=
search --no-floppy --fs-uuid --set=sparky_record ${rest%%:*}
if [ -n "\${sparky_record}" ]; then
	if [ -s "(\${sparky_record})${rest#*:}" ]; then
		load_env -f "(\${sparky_record})${rest#*:}" recordfail
	else
		set sparky_record=
	fi
fi
if [ -n "\${boot_once}" ]; then
	set sparky_record=
fi
export sparky_record
function recordfail {
	set recordfail=1
	if [ -n "\${sparky_record}" ]; then save_env -f "(\${sparky_record})${rest#*:}" recordfail; fi
}
RECORD
	;;
esac
case $record in
grubenv|debian|esp:*)
	cat <<CHECK
if [ "\${recordfail}" = 1 ]; then
	set sparky_stereo_check="fsck.mode=force sparky_stereo.start=unfinished"
	set timeout_style=menu
	set timeout=${SPARKY_STEREO_RECORD_TIMEOUT:-30}
fi
export sparky_stereo_check
CHECK
	;;
esac
# The call (0.1.13, rows 629/802): Debian's 10_linux writes "load_video" into each of its entries unless
# GRUB_GFXPAYLOAD_LINUX=text, GRUB runs a function by its last definition (grub-core/script/function.c), and GRUB sets
# "chosen" to the entry's id, "parent>child" inside a submenu, before it runs the entry (grub-core/normal/menu.c). So
# 00_header's own load_video is written again under another name, and a load_video that first records the start, for
# an entry of this system's Linux only ("gnulinux-..."; an entry of another system is "osprober-..." and must not count,
# or a start of Windows would be one of ours that did not finish). grub2-common's 10_linux stays as Debian ships it
# (0.1.11 and 0.1.12 diverted it; Debian Policy, appendix 7: "Do not attempt to divert a conffile"), and
# 90_sparky_stereo_start says when a Linux entry carries no load_video. 00_header's font lines and the ones below call
# load_video before any entry runs, with "chosen" unset, so they get Debian's body alone.
case $record in
grubenv|esp:*)
	body=$("${SPARKY_GRUB_00_HEADER:-/etc/grub.d/00_header}" 2>/dev/null |
		awk '/^function load_video \{$/ {f = 1; next} f && /^\}$/ {exit} f {print}') || body=
	if [ -n "$body" ]; then
		printf 'function sparky_stereo_load_video {\n%s\n}\n' "$body"
		cat <<'CALL'
function load_video {
	if regexp '^gnulinux-' "${chosen}"; then
		recordfail
	fi
	sparky_stereo_load_video
}
CALL
	fi
	;;
esac
[ -n "${GRUB_FONT:-}" ] || exit 0
case "${GRUB_TERMINAL_OUTPUT:-gfxterm}" in gfxterm) ;; *) exit 0 ;; esac
case "${GRUB_TERMINAL:-gfxterm}" in gfxterm) ;; *) exit 0 ;; esac
prefix=/usr
exec_prefix=/usr
datarootdir=/usr/share
. "${SPARKY_GRUB_MKCONFIG_LIB:-/usr/share/grub/grub-mkconfig_lib}"
if [ -r "$GRUB_FONT" ]; then
	prepare_grub_to_access_device $(${grub_probe:-grub-probe} --target=device "$GRUB_FONT")
	font=$(make_system_path_relative_to_its_root "$GRUB_FONT")
else
	font=$GRUB_FONT
fi
mode=${SPARKY_STEREO_READABLE_GFXMODE:-${GRUB_GFXMODE:-auto}}
lang=$(echo "${LANG:-}" | cut -d . -f 1)
cat <<MENU
if [ "\$shim_lock" = y -o ! -f "$font" ]; then
	if loadfont unicode ; then
		set gfxmode=$mode
		load_video
		insmod gfxterm
MENU
if [ -n "$lang" ] && [ "$lang" != C ] && [ "$lang" != POSIX ]; then
	cat <<MENU
		set locale_dir=\$prefix/locale
		set lang=$lang
		insmod gettext
MENU
fi
cat <<MENU
		terminal_output console
		terminal_output gfxterm
	else
		terminal_output console
	fi
else
	# the sized font is a Latin one: every glyph it lacks (Chinese, Japanese, Korean) comes from GRUB's own font,
	# which GRUB looks through when the first font has no glyph for a character
	loadfont unicode
fi
MENU
