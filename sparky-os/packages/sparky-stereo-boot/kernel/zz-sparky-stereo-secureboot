# After a kernel is installed: the Sparky Stereo OS certificate stays next to every shim on the EFI system
# partition, so MokManager can enroll it from the disk (sparky-stereo-boot).
[ -f /usr/lib/sparky-stereo-boot/secureboot.py ] || exit 0
/usr/bin/python3 /usr/lib/sparky-stereo-boot/secureboot.py esp || true
exit 0
