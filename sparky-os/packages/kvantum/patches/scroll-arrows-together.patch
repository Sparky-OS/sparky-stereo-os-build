Description: Put both scroll arrows together at the end of the scrollbar
 A new theme key, "scroll_arrows_together" in the General section (false by
 default), puts the sub-line arrow beside the add-line arrow at the end of a
 scrollbar (the bottom of a vertical one, the right of a horizontal one, the
 left in right-to-left layouts) and starts the groove at the other end, as the
 scroll bars of the classic Mac OS from 8.5 could be set.
 Only subControlRect() changes: the groove, the sub-line arrow and the two
 pages follow the new place, and drawing and hit testing already go through
 subControlRect(), so the Qt 6 and Qt 5 plugins behave the same. Themes that do
 not set the key are unchanged.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Forwarded: no
Last-Update: 2026-11-26
---
diff -ruN a/Kvantum/doc/Theme-Config b/Kvantum/doc/Theme-Config
--- a/Kvantum/doc/Theme-Config	2026-05-09 17:40:42.000000000 -0300
+++ b/Kvantum/doc/Theme-Config	2026-11-26 12:23:02.082922370 -0300
@@ -659,6 +659,15 @@
                                                       as far as possible but some apps might
                                                       still force scroll arrows.
 
+scroll_arrows_together            true/false          Put both scroll arrows together at
+                                                      the end of the scrollbar (the bottom
+                                                      of a vertical one, the right of a
+                                                      horizontal one, the left in right-to-
+                                                      left layouts), the groove starting at
+                                                      the other end? False by default. It
+                                                      has no effect when "scroll_arrows"
+                                                      is false.
+
 scrollbar_in_view                 true/false          Should scrollbars be inside the view
                                                       frame? It is false (outside) by default.
 
diff -ruN a/Kvantum/style/Kvantum.cpp b/Kvantum/style/Kvantum.cpp
--- a/Kvantum/style/Kvantum.cpp	2026-05-09 17:40:42.000000000 -0300
+++ b/Kvantum/style/Kvantum.cpp	2026-11-26 12:23:02.071798779 -0300
@@ -16330,6 +16330,12 @@
         arrowSize = extent;
       }
       bool horiz = (option->state & State_Horizontal);
+      /* with "scroll_arrows_together", the sub-line arrow is put beside the add-line one,
+         at the end of the scrollbar, and the groove starts at the beginning */
+      const bool together = arrowSize > 0 && tspec_.scroll_arrows_together;
+      const bool rtl = (option->direction == Qt::RightToLeft);
+      const int grooveOffset = !together ? arrowSize
+                                         : horiz && rtl ? 2*arrowSize : 0;
 
       int maxLength = 0; // max slider length
       int length = 0; // slider length
@@ -16369,10 +16375,18 @@
       switch (subControl) {
         case SC_ScrollBarGroove :
           if (horiz)
-            return QRect(x+arrowSize, y, w-2*arrowSize, h);
+            return QRect(x+grooveOffset, y, w-2*arrowSize, h);
           else
-            return QRect(x, y+arrowSize, w, h-2*arrowSize);
+            return QRect(x, y+grooveOffset, w, h-2*arrowSize);
         case SC_ScrollBarSubLine :
+          if (together)
+          {
+            if (horiz)
+              return QRect(rtl ? x+arrowSize : x+w-2*arrowSize, y,
+                           arrowSize, arrowSize);
+            else
+              return QRect(x, y+h-2*arrowSize, arrowSize, arrowSize);
+          }
           if (horiz)
             return QRect(option->direction == Qt::RightToLeft ? x+w-arrowSize : x, y,
                          arrowSize, arrowSize);
@@ -16393,17 +16407,17 @@
         }
         case SC_ScrollBarAddPage : {
           if (horiz)
-            return QRect(arrowSize+start+length, 0,
+            return QRect(grooveOffset+start+length, 0,
                          maxLength-start-length, extent);
           else
-            return QRect(0, arrowSize+start+length,
+            return QRect(0, grooveOffset+start+length,
                          extent, maxLength-start-length);
         }
         case SC_ScrollBarSubPage : {
           if (horiz)
-            return QRect(arrowSize, 0, start, extent);
+            return QRect(grooveOffset, 0, start, extent);
           else
-            return QRect(0, arrowSize, extent, start);
+            return QRect(0, grooveOffset, extent, start);
         }
 
         default : return QCommonStyle::subControlRect(control,option,subControl,widget);
