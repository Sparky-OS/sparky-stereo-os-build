+// Registration callbacks may synchronously notify the transmitter. The pending
+// receiver is added after its registration callback, preserving that ordering.
+class RegistrationNotifier : public simgear::Emesary::IReceiver
+{
+public:
+    int registrations = 0;
+    int deliveries = 0;
+
+    simgear::Emesary::ReceiptStatus Receive(simgear::Emesary::INotificationPtr) override
+    {
+        ++deliveries;
+        return simgear::Emesary::ReceiptStatus::OK;
+    }
+
+    void OnRegisteredAtTransmitter(simgear::Emesary::Transmitter* transmitter) override
+    {
+        ++registrations;
+        transmitter->NotifyAll(new TestThreadNotification("registration"));
+    }
+};
+
+void testRegistrationNotification()
+{
+    simgear::Emesary::Transmitter transmitter;
+    RegistrationNotifier receiver;
+    transmitter.Register(&receiver);
+    transmitter.NotifyAll(new TestThreadNotification("initial"));
+    SG_CHECK_EQUAL(receiver.registrations, 1);
+    SG_CHECK_EQUAL(receiver.deliveries, 1);
+}
