 }
 
+void DocumentViewContainer::setStereoLayerShown(const QRect &shown)
+{
+    setProperty("stereoLayerShown", shown);
+    for (DocumentView *view : d->mViews | d->mAddedViews) {
+        view->setProperty("stereoLayerShown", shown);
+        view->update();
+    }
+    scene()->update();
+    viewport()->update();
+}
