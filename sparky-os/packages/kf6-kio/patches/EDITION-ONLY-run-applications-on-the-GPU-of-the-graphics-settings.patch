+QProcessEnvironment graphicsSettingsEnvironment(const KService &service)
+{
+    // An application that says where it runs keeps its own choice
+    if (!service.property<QString>(QStringLiteral("PrefersNonDefaultGPU")).isEmpty()
+        || !service.property<QString>(QStringLiteral("X-KDE-RunOnDiscreteGpu")).isEmpty()) {
+        return {};
+    }
+
+    const QProcessEnvironment launchEnv = QProcessEnvironment::systemEnvironment();
+    for (const auto &name : {QStringLiteral("DRI_PRIME"),
+                             QStringLiteral("MESA_VK_DEVICE_SELECT"),
+                             QStringLiteral("VK_LOADER_DRIVERS_SELECT"),
+                             QStringLiteral("__NV_PRIME_RENDER_OFFLOAD")}) {
+        if (launchEnv.contains(name)) {
+            return {};
+        }
+    }
+
+    // The menu id when the application is in the menu, else its desktop file
+    QString entry = service.menuId();
+    if (entry.isEmpty() && QDir::isAbsolutePath(service.entryPath())) {
+        entry = service.entryPath();
+    }
+    const QString resolver = QStandardPaths::findExecutable(QStringLiteral("sparky-stereo-gpu-env"));
+    if (entry.isEmpty() || resolver.isEmpty()) {
+        return {};
+    }
+
+    QProcess process;
+    process.start(resolver, {QStringLiteral("--app"), entry});
+    if (!process.waitForFinished(2000) || process.exitStatus() != QProcess::NormalExit || process.exitCode() != 0) {
+        qCWarning(KIO_GUI) << "No GPU from" << resolver << "for" << entry << process.readAllStandardError();
+        return {};
+    }
+
+    QProcessEnvironment env;
+    const QStringList lines = QString::fromLocal8Bit(process.readAllStandardOutput()).split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    for (const QString &line : lines) {
+        const int equals = line.indexOf(QLatin1Char('='));
+        if (equals > 0) {
+            env.insert(line.left(equals), line.mid(equals + 1));
+        }
+    }
+    qCDebug(KIO_GUI) << "GPU environment from" << resolver << "for" << entry << env.toStringList();
+    return env;
+}
+
 }
