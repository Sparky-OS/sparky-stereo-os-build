+void ApplicationLauncherJobTest::shouldNotStartWhereItsGpuCannotBeUsed()
+{
+#ifdef Q_OS_UNIX
+    QFETCH(QString, resolverMode);
+    QFETCH(QStringList, expectedText);
+
+    // Given the stand-in resolver that refuses the person's choice or fails
+    QTemporaryDir tempDir;
+    const QString dir = tempDir.path();
+    QVERIFY(QDir(dir).mkpath(QStringLiteral("bin")));
+    QFile resolver(dir + QLatin1String("/bin/sparky-stereo-gpu-env"));
+    QVERIFY(resolver.open(QIODevice::WriteOnly));
+    resolver.write(resolverMode == QLatin1String("unstartable") ? s_unstartableResolver : s_fakeResolver);
+    resolver.close();
+    QVERIFY(resolver.setPermissions(resolver.permissions() | QFileDevice::ExeOwner));
+    const auto writeFile = [&dir](const QString &name, const QByteArray &content) {
+        QFile file(dir + QLatin1Char('/') + name);
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write(content);
+    };
+    writeFile(QStringLiteral("mode"), resolverMode.toUtf8());
+    writeFile(QStringLiteral("profile"), "balanced");
+    writeFile(QStringLiteral("said"), s_choiceCannotBeUsed);
+    writeFile(QStringLiteral("answers"), QByteArray());
+
+    // and a game in the menu that writes its environment when it runs
+    const QString id = QStringLiteral("kiogputest_refused_%1.desktop").arg(QString::fromLatin1(QTest::currentDataTag()));
+    const QString desktopFilePath = QStandardPaths::writableLocation(QStandardPaths::ApplicationsLocation) + QLatin1Char('/') + id;
+    const QString envFile = dir + QLatin1String("/env");
+    {
+        KDesktopFile file(desktopFilePath);
+        KConfigGroup group = file.desktopGroup();
+        group.writeEntry("Name", "KIOGpuTest");
+        group.writeEntry("Type", "Application");
+        group.writeEntry("Exec", QStringLiteral("sh -c 'env > %1'").arg(envFile));
+        group.writeEntry("Categories", "Game;ArcadeGame;");
+        QVERIFY(file.sync());
+    }
+    m_filesToRemove.append(desktopFilePath);
+    ksycoca_ms_between_checks = 0;
+    KService::Ptr service = KService::serviceByMenuId(id);
+    ksycoca_ms_between_checks = 5000;
+    QVERIFY(service);
+
+    // When starting it
+    const QByteArray oldPath = qgetenv("PATH");
+    qputenv("PATH", QByteArray(QFile::encodeName(dir) + "/bin:" + oldPath));
+    qunsetenv("DRI_PRIME");
+    KIO::ApplicationLauncherJob *job = new KIO::ApplicationLauncherJob(service, this);
+    const bool started = job->exec();
+    qputenv("PATH", oldPath);
+
+    // Then the launch fails with what failed, why and what to do, and the application never runs, on any GPU
+    QVERIFY(!started);
+    QCOMPARE(job->error(), KJob::UserDefinedError);
+    const QString text = job->errorString();
+    qsizetype from = 0;
+    for (const QString &piece : std::as_const(expectedText)) {
+        const qsizetype at = text.indexOf(piece, from);
+        QVERIFY2(at >= from, qPrintable(QStringLiteral("\"%1\" not in \"%2\"").arg(piece, text.mid(from))));
+        from = at + piece.size();
+    }
+    if (expectedText.size() == 1) {
+        QCOMPARE(text, expectedText.first());
+    }
+    if (resolverMode != QLatin1String("unstartable")) {
+        QFile askedLog(dir + QLatin1String("/asked"));
+        QVERIFY(askedLog.open(QIODevice::ReadOnly));
+        QCOMPARE(QString::fromUtf8(askedLog.readAll()).trimmed(), QStringLiteral("--app ") + id);
+    }
+    QTest::qWait(300);
+    QVERIFY(!QFile::exists(envFile));
+    QTRY_COMPARE(KProcessRunner::instanceCount(), 0);
+#else
+    QSKIP("This test is not run on Windows");
+#endif
+}
