+// An application the session bus can activate: it counts the Activate calls it gets
+class ActivatedApplication : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.freedesktop.Application")
+
+public:
+    int activated = 0;
+
+public Q_SLOTS:
+    void Activate()
+    {
+        ++activated;
+    }
+    void Activate(const QVariantMap &platformData)
+    {
+        Q_UNUSED(platformData);
+        ++activated;
+    }
+};
 
