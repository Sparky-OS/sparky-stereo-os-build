+void ApplicationLauncherJobTest::shouldStartAnActivatableApplicationOnItsGpu_data()
+{
+    QTest::addColumn<bool>("gpuEnvironment");
+    QTest::newRow("runs_on_another_gpu") << true;
+    QTest::newRow("runs_on_the_desktop_gpu") << false;
+}
+
+void ApplicationLauncherJobTest::shouldStartAnActivatableApplicationOnItsGpu()
+{
+#ifdef WITH_QTDBUS
+    QFETCH(bool, gpuEnvironment);
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    if (!bus.isConnected()) {
+        QSKIP("This test needs a session bus");
+    }
+
+    // Given the stand-in resolver, answering a GPU for the application or nothing
+    QTemporaryDir tempDir;
+    const QString dir = tempDir.path();
+    QVERIFY(QDir(dir).mkpath(QStringLiteral("bin")));
+    QFile resolver(dir + QLatin1String("/bin/sparky-stereo-gpu-env"));
+    QVERIFY(resolver.open(QIODevice::WriteOnly));
+    resolver.write(s_fakeResolver);
+    resolver.close();
+    QVERIFY(resolver.setPermissions(resolver.permissions() | QFileDevice::ExeOwner));
+    const auto writeFile = [&dir](const QString &name, const QByteArray &content) {
+        QFile file(dir + QLatin1Char('/') + name);
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write(content);
+    };
+    writeFile(QStringLiteral("mode"), "answer");
+    writeFile(QStringLiteral("profile"), "balanced");
+
+    // and an application in Elisa's form: a reverse-DNS name, DBusActivatable=true and an Exec line
+    const QString name = gpuEnvironment ? QStringLiteral("org.kde.kiogputest.activatable1") : QStringLiteral("org.kde.kiogputest.activatable2");
+    const QString id = name + QLatin1String(".desktop");
+    const QString desktopFilePath = QStandardPaths::writableLocation(QStandardPaths::ApplicationsLocation) + QLatin1Char('/') + id;
+    const QString envFile = dir + QLatin1String("/env");
+    {
+        KDesktopFile file(desktopFilePath);
+        KConfigGroup group = file.desktopGroup();
+        group.writeEntry("Name", "KIOGpuTestActivatable");
+        group.writeEntry("Type", "Application");
+        group.writeEntry("Exec", QStringLiteral("sh -c 'env > %1'").arg(envFile));
+        group.writeEntry("Categories", "Qt;KDE;Audio;AudioVideo;");
+        group.writeEntry("DBusActivatable", true);
+        QVERIFY(file.sync());
+    }
+    m_filesToRemove.append(desktopFilePath);
+    writeFile(QStringLiteral("answers"), gpuEnvironment ? id.toUtf8() + " balanced DRI_PRIME=pci-0000_99_00_0 VK_LOADER_DRIVERS_SELECT=*kiogputest*\n" : QByteArray());
+    ksycoca_ms_between_checks = 0;
+    KService::Ptr service = KService::serviceByMenuId(id);
+    ksycoca_ms_between_checks = 5000;
+    QVERIFY(service);
+
+    // already on the session bus, where activation finds it
+    ActivatedApplication application;
+    QVERIFY(bus.registerService(name));
+    QVERIFY(bus.registerObject(QLatin1Char('/') + QString(name).replace(QLatin1Char('.'), QLatin1Char('/')), &application, QDBusConnection::ExportAllSlots));
+
+    // When starting it
+    const QByteArray oldPath = qgetenv("PATH");
+    qputenv("PATH", QByteArray(QFile::encodeName(dir) + "/bin:" + oldPath));
+    qunsetenv("DRI_PRIME");
+    KIO::ApplicationLauncherJob *job = new KIO::ApplicationLauncherJob(service, this);
+    const bool started = job->exec();
+    qputenv("PATH", oldPath);
+    QVERIFY2(started, qPrintable(job->errorString()));
+
+    // Then KIO starts it itself with its GPU's variables, which activation would lose; without them it is activated
+    if (gpuEnvironment) {
+        QTRY_VERIFY(QFileInfo(envFile).size() > 0);
+        QFile envOutput(envFile);
+        QVERIFY(envOutput.open(QIODevice::ReadOnly));
+        QVERIFY(envOutput.readAll().split('\n').contains("DRI_PRIME=pci-0000_99_00_0"));
+        QCOMPARE(application.activated, 0);
+    } else {
+        QTRY_COMPARE(application.activated, 1);
+        QVERIFY(!QFile::exists(envFile));
+    }
+
+    bus.unregisterObject(QLatin1Char('/') + QString(name).replace(QLatin1Char('.'), QLatin1Char('/')));
+    bus.unregisterService(name);
+    QTRY_COMPARE(KProcessRunner::instanceCount(), 0);
+#else
+    QSKIP("D-Bus activation needs QtDBus");
+#endif
+}
