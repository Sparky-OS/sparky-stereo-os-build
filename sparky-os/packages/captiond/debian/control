Rules-Requires-Root: no
Build-Depends: debhelper-compat (= 14), cmake, ninja-build, pkgconf, extra-cmake-modules,
 gettext, libpipewire-0.3-dev, libicu-dev, libsystemd-dev, nlohmann-json3-dev,
 libwhisper-dev, libggml-dev, libkf6doctools-dev, pipewire-bin, dbus-daemon
