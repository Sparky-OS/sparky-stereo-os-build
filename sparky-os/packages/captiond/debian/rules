#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export QT_QPA_PLATFORM = offscreen
export CAPTIOND_TEST_MODEL =
export CAPTIOND_TEST_VAD_MODEL =

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DCAPTIOND_ENGINE_WHISPER=ON -DCAPTIOND_WITH_DBUS=ON -DCAPTIOND_WITH_NLS=ON

override_dh_auto_test:
	cd obj-* && ctest --output-on-failure -j2 -LE model -E "^(test_whisper|test_daemon|test_transcribe)$$"

# Installing captions must not start a listener or enable login activation.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable
