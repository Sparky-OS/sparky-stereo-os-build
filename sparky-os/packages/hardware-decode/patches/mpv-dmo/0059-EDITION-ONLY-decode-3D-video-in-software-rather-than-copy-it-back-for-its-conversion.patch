+// A filter asked for the pictures in memory rather than copying hardware frames
+// back (the stereo conversion): decode in software from that picture on, unless
+// the decoder keeps a hardware decoder the person chose.
+static bool check_for_software_frames(struct MPContext *mpctx)
+{
+    struct vo_chain *vo_c = mpctx->vo_chain;
+
+    if (!vo_c->filter->software_frames_wanted)
+        return false;
+    vo_c->filter->software_frames_wanted = false;
+
+    // A hardware decoder the person chose keeps its frames, and the filter
+    // copies them from now on.
+    if (!vo_c->track || !vo_c->track->dec ||
+        mp_decoder_wrapper_control(vo_c->track->dec,
+                            VDCTRL_SOFTWARE_FRAMES, NULL) != CONTROL_OK)
+        vo_c->filter->software_frames_refused = true;
+
+    double pts = vo_c->filter->software_frames_pts;
+    if (pts == MP_NOPTS_VALUE)
+        pts = mpctx->video_pts;
+    mp_output_chain_reset_harder(vo_c->filter);
+    // Decode again from the keyframe before that picture, so none is lost.
+    if (pts != MP_NOPTS_VALUE)
+        queue_seek(mpctx, MPSEEK_ABSOLUTE, pts, MPSEEK_EXACT, 0);
+    return true;
+}
