+QStringList RenderRequest::noticeMessages()
+{
+    return m_notices;
+}
+
+// The bits of a sample of a pixel format (FFmpeg's names), 0 when it is not known
+static int pixelFormatDepth(const QString &name)
+{
+    const AVPixelFormat format = av_get_pix_fmt(name.toUtf8().constData());
+    const AVPixFmtDescriptor *descriptor = format == AV_PIX_FMT_NONE ? nullptr : av_pix_fmt_desc_get(format);
+    return descriptor ? descriptor->comp[0].depth : 0;
+}
+
+void RenderRequest::chooseStereoRenderDepth()
+{
+    // "All deep colour depths the standard defines, no caps of our own", and the source's depth kept out of the box: the deepest
+    // video clip of the project, by the pixel format its stream declares
+    int sourceDepth = 0;
+    const std::vector<QString> ids = pCore->projectItemModel()->getAllClipIds();
+    for (const QString &id : ids) {
+        const std::shared_ptr<ProjectClip> clip = pCore->projectItemModel()->getClipByBinID(id);
+        if (!clip || (clip->clipType() != ClipType::AV && clip->clipType() != ClipType::Video)) {
+            continue;
+        }
+        const int index = clip->getProducerIntProperty(QStringLiteral("video_index"));
+        const int depth = pixelFormatDepth(clip->getProducerProperty(QStringLiteral("meta.media.%1.codec.pix_fmt").arg(index)));
+        sourceDepth = qMax(sourceDepth, depth);
+    }
+    if (sourceDepth <= 8) {
+        return;
+    }
+    const QString codec = m_presetParams.value(QStringLiteral("vcodec"));
+    // The most bits each codec carries, by its specification, as the encoder the edition ships writes it: H.264 (ITU-T H.264 Annex
+    // A) High 10 carries 10, and its High 4:4:4 Predictive 14, which libx264 does not write; H.265 (ITU-T H.265 Annex A) Main 10
+    // carries 10 and its format range extensions Main 12 12 and more, of which libx265 writes up to 12; FFV1 (RFC 9043) up to 16.
+    int codecDepth = 0;
+    if (codec == QLatin1String("libx264")) {
+        codecDepth = 10;
+    } else if (codec == QLatin1String("libx265")) {
+        codecDepth = 12;
+    } else if (codec == QLatin1String("ffv1")) {
+        codecDepth = 16;
+    }
+    // A 3D preset that names no pixel format writes the source's depth up to its codec's: 4:2:0, as the presets' 8 bit picture
+    if (m_presetParams.contains(QStringLiteral("stereo3d")) && !m_presetParams.contains(QStringLiteral("pix_fmt")) && codecDepth > 8) {
+        const int depth = qMin(sourceDepth, codecDepth);
+        const QString pixFmt = depth <= 10 ? QStringLiteral("yuv420p10le") : depth <= 12 ? QStringLiteral("yuv420p12le") : QStringLiteral("yuv420p16le");
+        m_presetParams.insert(QStringLiteral("pix_fmt"), pixFmt);
+        if (depth > 10) {
+            // MLT works a frame deeper than 10 bits only in RGBA64 (16 bits a sample)
+            m_presetParams.insert(QStringLiteral("mlt_image_format"), QStringLiteral("rgba64"));
+        }
+    }
+    // what the render writes: its pixel format's bits, or 8 when it names none (MLT's encoder then writes 4:2:0 at 8 bits)
+    const QString pixFmt = m_presetParams.value(QStringLiteral("pix_fmt"));
+    const int written = pixFmt.isEmpty() ? 8 : pixelFormatDepth(pixFmt);
+    if (written > 0 && written < sourceDepth) {
+        m_notices.append(i18n("The deepest clip of this project has %1 bits a sample and this render writes %2: its pictures keep fewer "
+                              "levels of each colour than the clip. The 3D FFV1 preset keeps up to 16 bits, the 3D HEVC presets up to 12.",
+                              sourceDepth, written));
+    }
+}
