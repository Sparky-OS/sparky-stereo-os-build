+void ProjectClip::applyStereoUnpack(const std::shared_ptr<Mlt::Producer> &producer)
+{
+    if (!producer || !producer->is_valid()) {
+        return;
+    }
+    for (int i = producer->filter_count() - 1; i >= 0; --i) {
+        std::unique_ptr<Mlt::Filter> filter(producer->filter(i));
+        if (filter && filter->get_int("kdenlive:stereo3d_unpack") == 1) {
+            producer->detach(*filter.get());
+        }
+    }
+    KdenliveDoc *doc = pCore->currentDoc();
+    if (!m_masterProducer || !doc || !doc->isStereo3DAutomatic()) {
+        return;
+    }
+    const Stereo3D::Format format{Stereo3D::fromMltName(QString::fromUtf8(m_masterProducer->get("meta.media.stereo3d.type"))),
+                                  m_masterProducer->get_int("meta.media.stereo3d.invert") == 1};
+    if (!Stereo3D::bothViewsInFrame(format.packing)) {
+        return;
+    }
+    // The views of the project's frames are whole pictures, or squeezed to half their width (a 1920x1080 side by side frame), by
+    // the shape of the frame shown, as the players judge it
+    const QSize frame = pCore->getCurrentFrameSize();
+    const bool projectFull =
+        Stereo3D::fullSizeViews(QSize(qRound(frame.width() * pCore->getCurrentSar()), frame.height()), Stereo3D::Packing::SideBySide);
+    if (format.packing == Stereo3D::Packing::SideBySide && !format.rightFirst) {
+        // Already side by side, the left eye first: left as it is when its views are of the project's kind
+        const QSize clip(m_masterProducer->get_int("meta.media.width"), m_masterProducer->get_int("meta.media.height"));
+        const double sar = m_masterProducer->get_double("aspect_ratio") > 0 ? m_masterProducer->get_double("aspect_ratio") : 1.0;
+        const int hint = Stereo3D::viewsHint(QString::fromUtf8(m_masterProducer->get("meta.media.stereo3d.views")));
+        if (Stereo3D::fullSizeViews(QSize(qRound(clip.width() * sar), clip.height()), format.packing, hint) == projectFull) {
+            return;
+        }
+    }
+    Mlt::Filter unpack(pCore->getProjectProfile(), "stereo3d_unpack");
+    if (!unpack.is_valid()) {
+        qCWarning(KDENLIVE_LOG) << "MLT has no stereo3d_unpack filter: the 3D clip" << clipName() << "keeps its packing in the project";
+        return;
+    }
+    unpack.set("packing", Stereo3D::mltName(format.packing).toUtf8().constData());
+    unpack.set("invert", format.rightFirst ? 1 : 0);
+    unpack.set("output", "side_by_side");
+    unpack.set("in_producer", 1);
+    unpack.set("target_views", projectFull ? "full" : "half");
+    unpack.set("kdenlive:stereo3d_unpack", 1);
+    producer->attach(unpack);
+    // first of the producer's filters, before its rescaling and padding
+    producer->move_filter(producer->filter_count() - 1, 0);
+}
+
+void ProjectClip::updateStereoUnpack()
+{
+    for (auto &producer : m_videoProducers) {
+        applyStereoUnpack(producer.second);
+    }
+}
+
+void ProjectClip::setStereo3DFromFrame(const QString &type, int invert, const QString &views)
+{
+    if (!m_masterProducer || type.isEmpty() || m_masterProducer->property_exists("meta.media.stereo3d.type")) {
+        return;
+    }
+    m_masterProducer->set("meta.media.stereo3d.type", type.toUtf8().constData());
+    m_masterProducer->set("meta.media.stereo3d.invert", invert);
+    if (!views.isEmpty()) {
+        m_masterProducer->set("meta.media.stereo3d.views", views.toUtf8().constData());
+    }
+    updateStereoUnpack();
+    pCore->refreshProjectMonitorOnce();
+}
