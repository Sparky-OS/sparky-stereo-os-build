--- a/src/render/renderrequest.cpp
+++ b/src/render/renderrequest.cpp
@@ -128,6 +128,22 @@ std::vector<RenderRequest::RenderJob> Re
 {
     m_errors.clear();
 
+    // The stereoscopic 3D presets write the project's frames as full side by side, the left eye first, and mark them so:
+    // a project that is not 3D, or whose frames the person declared packed another way, is not rendered with them
+    if (m_presetParams.contains(QStringLiteral("stereo3d"))) {
+        const Stereo3D::Format stereo = pCore->currentDoc()->stereo3DFormat();
+        if (!stereo.isStereo()) {
+            addErrorMessage(i18n("This project has no stereoscopic 3D clip: a 3D preset would mark a 2D video as 3D. Choose another preset."));
+            return {};
+        }
+        if (stereo.packing != Stereo3D::Packing::SideBySide || stereo.rightFirst) {
+            addErrorMessage(i18n("The 3D presets write side by side, the left eye first, and this project's frames are packed: %1. Set the "
+                                 "Packing of the Project to Automatic (From the Clips) in the project monitor's Stereoscopic 3D menu.",
+                                 Stereo3D::description(stereo)));
+            return {};
+        }
+    }
+
     QString playlistPath = generatePlaylistFile();
