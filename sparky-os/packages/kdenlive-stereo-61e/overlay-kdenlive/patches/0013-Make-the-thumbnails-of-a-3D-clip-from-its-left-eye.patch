+Stereo3D::Format ProjectClip::stereo3DFormat() const
+{
+    if (!m_masterProducer) {
+        return {};
+    }
+    return {Stereo3D::fromMltName(QString::fromUtf8(m_masterProducer->get("meta.media.stereo3d.type"))),
+            m_masterProducer->get_int("meta.media.stereo3d.invert") == 1};
+}
+
+void ProjectClip::learnStereo3DFromFrame()
+{
+    if (!m_masterProducer || stereo3DFormat().isStereo() || (m_clipType != ClipType::AV && m_clipType != ClipType::Video)) {
+        return;
+    }
+    // A frame packing arrangement SEI is only read when a frame is decoded: decode one
+    std::unique_ptr<Mlt::Producer> prod = getThumbProducer();
+    if (!prod || !prod->is_valid()) {
+        return;
+    }
+    std::unique_ptr<Mlt::Frame> frame(prod->get_frame());
+    if (!frame || !frame->is_valid()) {
+        return;
+    }
+    mlt_image_format format = mlt_image_rgba;
+    int width = 0;
+    int height = 0;
+    frame->get_image(format, width, height);
+    const QString type = QString::fromUtf8(prod->get("meta.media.stereo3d.type"));
+    if (!type.isEmpty()) {
+        setStereo3DFromFrame(type, prod->get_int("meta.media.stereo3d.invert"), QString::fromUtf8(prod->get("meta.media.stereo3d.views")));
+    }
+}
+
+void ProjectClip::attachStereoLeftEye(Mlt::Producer &producer, const Stereo3D::Format &format)
+{
+    // A thumbnail of a 3D clip is its left eye's view, one picture, not the squeezed pair; a frame sequence has one view in each
+    // frame already. The filter goes first, before the scaling and padding of the thumbnail.
+    if (!producer.is_valid() || !Stereo3D::bothViewsInFrame(format.packing)) {
+        return;
+    }
+    Mlt::Filter left(pCore->thumbProfile(), "stereo3d_unpack");
+    if (!left.is_valid()) {
+        return;
+    }
+    left.set("packing", Stereo3D::mltName(format.packing).toUtf8().constData());
+    left.set("invert", format.rightFirst ? 1 : 0);
+    left.set("output", "left");
+    // it says the view's size to the scaling and padding of the thumbnail (the edition's MLT, +stereo3d7)
+    left.set("in_producer", 1);
+    producer.attach(left);
+    producer.move_filter(producer.filter_count() - 1, 0);
+}
