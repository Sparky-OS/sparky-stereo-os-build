 QString ProjectClip::saveStereo3DCorrection()
 {
+#ifdef HAVE_STEREO_LAYER
+    if (m_clipType == ClipType::Image) {
+        if (!hasStereo3DCorrection()) {
+            return i18n("This clip has no 3D correction to save.");
+        }
+        // A still's mark is written by the stereo layer, as every picture program of the edition writes it (JPS, MPO, PNG's sTER),
+        // and read back; its refusal says why in the person's language
+        Stereo::Picture::Options options;
+        if (const Stereo3D::InputEntry *entry = Stereo3D::inputEntry(stereo3DInput())) {
+            options.inputLayout = static_cast<Stereo::Picture::Layout>(entry->policyLayout);
+            options.inputOrder = entry->policyOrder == 1 ? Stereo::Picture::EyeOrder::RightFirst : Stereo::Picture::EyeOrder::LeftFirst;
+            options.anaglyph = static_cast<Stereo::Picture::AnaglyphColorPair>(entry->policyAnaglyph);
+            if (QLatin1String(entry->id) == QLatin1String("mono")) {
+                options.view = Stereo::Picture::View::Mono;
+            }
+        }
+        options.swapEyes = stereo3DSwap();
+        const QString path = url();
+        // the layer (1.23) writes a still's mark into a JPEG picture (a JPS, an MPO) only: another format is refused with its reason
+        QFile file(path);
+        const QByteArray head = file.open(QIODevice::ReadOnly) ? file.read(2) : QByteArray();
+        if (head != QByteArray("\xff\xd8", 2)) {
+            return i18n("The 3D correction could not be saved into %1: %2 The file is as it was, and the correction stays in the project.",
+                        QFileInfo(path).fileName(),
+                        i18nc("Why a 3D correction could not be saved into a file",
+                              "the 3D mark of a still is written into JPEG pictures (JPS, MPO) only, and this picture is another format."));
+        }
+        const Stereo::Picture::SaveResult result = Stereo::Picture::saveCorrection(path, options);
+        if (!result.success) {
+            qCWarning(KDENLIVE_LOG) << "3D correction not saved into" << path << result.error;
+            return i18n("The 3D correction could not be saved into %1: %2 The file is as it was, and the correction stays in the project.",
+                        QFileInfo(path).fileName(), result.error);
+        }
+        resetProducerProperty(QStringLiteral("kdenlive:stereo3d_input"));
+        resetProducerProperty(QStringLiteral("kdenlive:stereo3d_swap"));
+        m_refreshMonitorWhenLoaded = true;
+        reloadProducer(false, false, false);
+        return QString();
+    }
+#endif
 #ifdef HAVE_STEREO_MARK
     if (!hasStereo3DCorrection()) {
         return i18n("This clip has no 3D correction to save.");
@@ -990,6 +1039,7 @@ QString ProjectClip::saveStereo3DCorrect
     // The file carries the correction now: the clip's own is taken off and the clip is read again from the file
     resetProducerProperty(QStringLiteral("kdenlive:stereo3d_input"));
     resetProducerProperty(QStringLiteral("kdenlive:stereo3d_swap"));
+    m_refreshMonitorWhenLoaded = true;
     reloadProducer(false, false, false);
     return QString();
 #else
