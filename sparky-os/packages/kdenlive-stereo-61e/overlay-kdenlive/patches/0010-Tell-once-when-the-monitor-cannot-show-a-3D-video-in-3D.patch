 #ifdef HAVE_STEREO_PREVIEW
-    layer = mode == 2 && StereoLayer::isSupported() && format.isStereo();
+    layer = mode == 2 && StereoLayer::isSupported() && format.isStereo() && !m_stereoLayerFailed;
+    if (mode == 2 && format.isStereo() && !m_stereoWaylandSaid && StereoLayer::needsWayland()) {
+        // The desktop takes stereo content, but the 3D area is a Wayland surface and Kdenlive runs on X11
+        m_stereoWaylandSaid = true;
+        warningMessage(i18n("This monitor shows a 3D video in 3D only when Kdenlive runs on Wayland. It shows the packed frame as it is."), -1);
+    }
 #endif
     const bool unpackedByFilter = format.packing == Stereo3D::Packing::Lines || format.packing == Stereo3D::Packing::Columns
         || format.packing == Stereo3D::Packing::Checkerboard || format.packing == Stereo3D::Packing::FrameSequence;
@@ -2699,6 +2708,16 @@ void Monitor::updateStereoPreview()
         m_stereoLayer = new StereoLayer(m_glMonitor, this);
         m_stereoLayerTimer.setInterval(100);
         connect(&m_stereoLayerTimer, &QTimer::timeout, m_stereoLayer, &StereoLayer::update);
+        // Where the 3D area cannot show the views, the person is told once and the monitor shows the packed frame
+        connect(
+            m_stereoLayer, &StereoLayer::failed, this,
+            [this](const QString &reason) {
+                m_stereoLayerFailed = true;
+                warningMessage(i18n("This monitor cannot show the video in 3D: %1 It shows the packed frame as it is.", reason), -1);
+                updateStereoPreview();
+                m_glMonitor->requestRefresh();
+            },
+            Qt::QueuedConnection);
     }
     if (m_stereoLayer) {
         m_stereoLayer->setActive(layer);
