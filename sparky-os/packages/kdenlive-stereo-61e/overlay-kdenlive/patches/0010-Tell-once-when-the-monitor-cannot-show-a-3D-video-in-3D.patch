     connect(m_stereoPreview, &KSelectAction::actionTriggered, this, [this](QAction *a) {
         setStereoPreviewSetting(a->data().toInt());
+#ifdef HAVE_STEREO_PREVIEW
+        // The person chose again: a 3D area that failed is tried again
+        m_stereoLayerFailed = false;
+#endif
         updateStereoPreview();
     });
     stereoMenu->addAction(m_stereoPreview);
@@ -2683,7 +2687,12 @@ void Monitor::updateStereoPreview()
     // subsampled chroma of the preview)
