+        // A preset name Kdenlive does not have stops the render: it is said, never replaced by the default preset (which wrote another
+        // format into the file name given)
+        if (!RenderPresetRepository::get()->presetExists(presetName)) {
+            qCritical().noquote() << i18n("Kdenlive has no render preset named “%1”: nothing was rendered. The render presets are:", presetName);
+            QVector<QString> names = RenderPresetRepository::get()->getAllPresets();
+            for (const QString &name : std::as_const(names)) {
+                qCritical().noquote() << "  " << name;
+            }
+            // as the render's own end does
+            pCore->projectManager()->closeCurrentDocument(false, false);
+            app.processEvents();
+            Core::clean();
+            app.processEvents();
+            return EXIT_FAILURE;
+        }
