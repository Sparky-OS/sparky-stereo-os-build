+void PreviewManager::markStereoChunk(Mlt::Producer *prod)
+{
+    // A chunk of a 3D project is a frame of two eyes: in the monitors it is fitted to their frame of two eyes and marked as one, as a
+    // 3D clip of the project's own kind is (ProjectClip::applyStereoUnpack)
+    if (!prod || !pCore->currentDoc() || !pCore->currentDoc()->isStereo3DPairProject()) {
+        return;
+    }
+    Mlt::Filter unpack(pCore->getMonitorProfile(), "stereo3d_unpack");
+    if (!unpack.is_valid()) {
+        return;
+    }
+    unpack.set("packing", "side_by_side");
+    unpack.set("invert", 0);
+    unpack.set("output", "side_by_side");
+    unpack.set("in_producer", 1);
+    unpack.set("target_views", "full");
+    unpack.set("kdenlive:stereo3d_unpack", 1);
+    prod->attach(unpack);
+    prod->move_filter(prod->filter_count() - 1, 0);
+}
