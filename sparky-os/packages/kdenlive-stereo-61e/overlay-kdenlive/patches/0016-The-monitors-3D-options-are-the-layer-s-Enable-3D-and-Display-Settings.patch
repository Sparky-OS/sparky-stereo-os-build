+void Monitor::moveProjectRightFirstToClips()
+{
+    // Kdenlive 26.08.1-1+stereo3d6 to +stereo3d8 had a "Right Eye First" for the whole project, beside a packing declared for the
+    // project. The eye order is now each clip's own (its swap), and only the screen's own swap is for everything: a project saved with
+    // it gets the packing and the eye order as each video clip's input format, takes its packing from its clips, and the person is told.
+    KdenliveDoc *doc = pCore->currentDoc();
+    if (!doc || doc->getDocumentProperty(QStringLiteral("stereo3d_invert")) != QLatin1String("1")) {
+        m_stereoRightFirstMoved = doc != nullptr;
+        return;
+    }
+    const Stereo3D::Packing packing = Stereo3D::fromMltName(doc->getDocumentProperty(QStringLiteral("stereo3d")));
+    QString input;
+    for (const Stereo3D::InputEntry &entry : Stereo3D::inputEntries()) {
+        if (entry.packing == packing && entry.rightFirst && packing != Stereo3D::Packing::None) {
+            input = QString::fromLatin1(entry.id);
+            break;
+        }
+    }
+    std::vector<std::shared_ptr<ProjectClip>> clips;
+    for (const QString &id : pCore->projectItemModel()->getAllClipIds()) {
+        const std::shared_ptr<ProjectClip> clip = pCore->projectItemModel()->getClipByBinID(id);
+        if (!clip || (clip->clipType() != ClipType::AV && clip->clipType() != ClipType::Video)) {
+            continue;
+        }
+        if (!clip->statusReady()) {
+            // the clips are read again later: the move waits for all of them
+            return;
+        }
+        clips.push_back(clip);
+    }
+    m_stereoRightFirstMoved = true;
+    int moved = 0;
+    if (!input.isEmpty()) {
+        for (const auto &clip : clips) {
+            if (!clip->hasStereo3DCorrection()) {
+                clip->setProperties({{QStringLiteral("kdenlive:stereo3d_input"), input}}, false);
+                ++moved;
+            }
+        }
+    }
+    doc->setDocumentProperty(QStringLiteral("stereo3d_invert"), QString());
+    if (!input.isEmpty()) {
+        doc->setStereo3DFormat({}, true);
+    }
+    doc->setModified(true);
+    warningMessage(i18np("This project's packing was set to “%2” with the right eye first. The eye order is now each clip's own: %1 video "
+                         "clip has that 3D input format in its properties, and the project takes its packing from its clips.",
+                         "This project's packing was set to “%2” with the right eye first. The eye order is now each clip's own: %1 video "
+                         "clips have that 3D input format in their properties, and the project takes its packing from its clips.",
+                         moved, Stereo3D::packingText(packing)),
+                   -1);
+}
