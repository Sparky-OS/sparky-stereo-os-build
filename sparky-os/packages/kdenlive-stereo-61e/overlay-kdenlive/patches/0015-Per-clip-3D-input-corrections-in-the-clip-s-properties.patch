+
+const InputEntry *inputEntry(const QString &id)
+{
+    for (const InputEntry &entry : inputEntries()) {
+        if (id == QLatin1String(entry.id)) {
+            return &entry;
+        }
+    }
+    return nullptr;
+}
+
+QString inputText(const InputEntry &entry)
+{
+    const QString text = QCoreApplication::translate("Stereo::FileChoiceMenu", entry.text);
+    if (entry.packing == Packing::None && strcmp(entry.id, "mono") != 0) {
+        // the layer's words for a format the program cannot show in 3D where the list is: the choice is still kept
+        return QCoreApplication::translate("Stereo::FileChoiceMenu", "%1 (one view shown here)").arg(text);
+    }
+    return text;
+}
+
+QString inputGroupTitle(int group)
+{
+    switch (group) {
+    case 2:
+        return QCoreApplication::translate("Stereo::FileChoiceMenu", "Interleaved");
+    case 3:
+        return QCoreApplication::translate("Stereo::FileChoiceMenu", "One view after the other");
+    case 4:
+        return QCoreApplication::translate("Stereo::FileChoiceMenu", "Anaglyph");
+    case 5:
+        return QCoreApplication::translate("Stereo::FileChoiceMenu", "Picture and depth");
+    default:
+        return QString();
+    }
+}
+
+QString inputTitle()
+{
+    return QCoreApplication::translate("Stereo::FileChoiceMenu", "3D Input Format");
+}
+
+QString swapEyesText()
+{
+    return QCoreApplication::translate("Stereo::FileChoiceMenu", "Swap left and right eyes");
+}
+
+QString swapEyesToolTip()
+{
+    return QCoreApplication::translate("Stereo::FileChoiceMenu", "Show each eye the other view of this file");
+}
+
+QString saveCorrectionText()
+{
+    return QCoreApplication::translate("Stereo::FileChoiceMenu", "Save the correction into the file");
+}
+
+QString saveCorrectionToolTip()
+{
+    return QCoreApplication::translate("Stereo::FileChoiceMenu", "Write this correction into the file itself, so every program and device reads it");
+}
+
+Format corrected(const Format &file, const QString &input, bool swapEyes)
+{
+    Format format = file;
+    if (const InputEntry *entry = inputEntry(input)) {
+        format = {entry->packing, entry->rightFirst};
+    }
+    if (swapEyes && format.isStereo()) {
+        format.rightFirst = !format.rightFirst;
+    }
+    return format;
+}
