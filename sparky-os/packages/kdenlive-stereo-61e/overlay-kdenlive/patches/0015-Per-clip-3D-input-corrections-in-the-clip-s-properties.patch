+
+bool ProjectClip::stereo3DSwap() const
+{
+    return m_masterProducer && m_masterProducer->get_int("kdenlive:stereo3d_swap") == 1;
+}
+
+bool ProjectClip::hasStereo3DCorrection() const
+{
+    return Stereo3D::inputEntry(stereo3DInput()) != nullptr || stereo3DSwap();
+}
+
+Stereo3D::Format ProjectClip::stereo3DFormat() const
+{
+    // the correction applies as soon as the clip's producer exists: its timeline producers are made before the clip's type is known
+    if (!m_masterProducer) {
+        return {};
+    }
+    return Stereo3D::corrected(stereo3DFileFormat(), stereo3DInput(), stereo3DSwap());
+}
+
+QString ProjectClip::saveStereo3DCorrection()
+{
+#ifdef HAVE_STEREO_MARK
+    if (!hasStereo3DCorrection()) {
+        return i18n("This clip has no 3D correction to save.");
+    }
+    const Stereo3D::Format format = stereo3DFormat();
+    int layout = 0;
+    int order = format.rightFirst ? 1 : 0;
+    int anaglyph = 0;
+    if (const Stereo3D::InputEntry *entry = Stereo3D::inputEntry(stereo3DInput())) {
+        layout = entry->policyLayout;
+        order = entry->policyOrder;
+        anaglyph = entry->policyAnaglyph;
+        if (stereo3DSwap() && layout >= 1 && layout <= 9) {
+            order = 1 - order;
+        }
+    } else {
+        // the file's own packing with the swap
+        switch (format.packing) {
+        case Stereo3D::Packing::SideBySide:
+            layout = 1;
+            break;
+        case Stereo3D::Packing::TopBottom:
+            layout = 2;
+            break;
+        case Stereo3D::Packing::Lines:
+            layout = 4;
+            break;
+        case Stereo3D::Packing::Columns:
+            layout = 5;
+            break;
+        case Stereo3D::Packing::Checkerboard:
+            layout = 6;
+            break;
+        case Stereo3D::Packing::SideBySideQuincunx:
+            layout = 7;
+            break;
+        case Stereo3D::Packing::FrameSequence:
+            layout = 8;
+            break;
+        case Stereo3D::Packing::None:
+            break;
+        }
+    }
+    const QString path = url();
+    stereo_mark_result result;
+    memset(&result, 0, sizeof(result));
+    const int status = stereo_mark_save(path.toUtf8().constData(), 1, layout, order, anaglyph, &result);
+    if (status != STEREO_MARK_WRITTEN && status != STEREO_MARK_UNCHANGED) {
+        QString reason;
+        switch (status) {
+        case STEREO_MARK_CONTAINER:
+            reason = i18nc("Why a 3D correction could not be saved into a file", "its format has no 3D mark that can be written (Matroska, WebM and MP4 have one).");
+            break;
+        case STEREO_MARK_LAYOUT:
+        case STEREO_MARK_WEBM_LAYOUT:
+        case STEREO_MARK_MP4_DEPTH:
+            reason = i18nc("Why a 3D correction could not be saved into a file", "its format's mark has no value for this 3D input format.");
+            break;
+        case STEREO_MARK_STREAM_DECLARES:
+            reason = i18nc("Why a 3D correction could not be saved into a file",
+                           "its video stream declares another 3D format itself, and the stream's declaration comes before the container's mark.");
+            break;
+        case STEREO_MARK_MP4_NO_ROOM:
+        case STEREO_MARK_MP4_ENTRIES:
+            reason = i18nc("Why a 3D correction could not be saved into a file", "the mark cannot be added to this MP4 file without moving its media data.");
+            break;
+        case STEREO_MARK_TOOL_MISSING:
+            reason = i18nc("Why a 3D correction could not be saved into a file", "writing a Matroska file's mark needs mkvpropedit (MKVToolNix), which is not installed.");
+            break;
+        default:
+            reason = i18nc("Why a 3D correction could not be saved into a file, %1 what the system said", "the write failed (%1).",
+                           QString::fromUtf8(result.details[0] ? result.details : stereo_mark_status_name(status)));
+            break;
+        }
+        qCWarning(KDENLIVE_LOG) << "3D correction not saved into" << path << stereo_mark_status_name(status) << result.details;
+        return i18n("The 3D correction could not be saved into %1: %2 The file is as it was, and the correction stays in the project.",
+                    QFileInfo(path).fileName(), reason);
+    }
+    // The file carries the correction now: the clip's own is taken off and the clip is read again from the file
+    resetProducerProperty(QStringLiteral("kdenlive:stereo3d_input"));
+    resetProducerProperty(QStringLiteral("kdenlive:stereo3d_swap"));
+    reloadProducer(false, false, false);
+    return QString();
+#else
+    return i18n("This build of Kdenlive cannot write a 3D mark into a file.");
+#endif
+}
