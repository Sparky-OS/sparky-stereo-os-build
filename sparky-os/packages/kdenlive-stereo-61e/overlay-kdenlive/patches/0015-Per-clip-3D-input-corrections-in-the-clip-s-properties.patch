+QVBoxLayout *ClipPropertiesController::stereoInputProperty()
+{
+    // The person's correction of the clip's 3D input, as every program on the stereo layer offers it for a file it shows: the
+    // input formats of the layer's list in its words (a declaration can be wrong, and an unmarked clip gets its packing here), Swap
+    // left and right eyes and the save into the file for a clip shown in 3D. Kept in the project's clip properties, never in the file
+    // unless the person saves it there.
+    const QString input = QString::fromUtf8(m_properties->get("kdenlive:stereo3d_input"));
+    const bool swap = m_properties->get_int("kdenlive:stereo3d_swap") == 1;
+    const std::shared_ptr<ProjectClip> clip = pCore->projectItemModel()->getClipByBinID(m_id);
+    const bool shownAsPair = clip && clip->stereo3DFormat().isStereo();
+
+    auto *vlay = new QVBoxLayout;
+    auto *hlay = new QHBoxLayout;
+    auto *label = new QLabel(Stereo3D::inputTitle(), this);
+    auto *combo = new QComboBox(this);
+    combo->setObjectName(QStringLiteral("stereo3d_input_value"));
+    combo->addItem(QCoreApplication::translate("Stereo::FileChoiceMenu", "Automatic"), QString());
+    int group = 0;
+    for (const Stereo3D::InputEntry &entry : Stereo3D::inputEntries()) {
+        if (entry.group != group) {
+            group = entry.group;
+            combo->insertSeparator(combo->count());
+            const QString title = Stereo3D::inputGroupTitle(group);
+            if (!title.isEmpty()) {
+                combo->addItem(title);
+                if (auto *model = qobject_cast<QStandardItemModel *>(combo->model())) {
+                    model->item(combo->count() - 1)->setEnabled(false);
+                }
+            }
+        }
+        combo->addItem(Stereo3D::inputText(entry), QString::fromLatin1(entry.id));
+    }
+    combo->setCurrentIndex(qMax(0, combo->findData(input)));
+    label->setBuddy(combo);
+    hlay->addWidget(label);
+    hlay->addStretch(10);
+    hlay->addWidget(combo);
+    vlay->addLayout(hlay);
+
+    auto *swapBox = new QCheckBox(Stereo3D::swapEyesText(), this);
+    swapBox->setToolTip(Stereo3D::swapEyesToolTip());
+    swapBox->setChecked(swap);
+    // a correction of a pair: offered for a clip shown in 3D, or to take back a swap the clip has; nothing of it on a clip shown flat
+    swapBox->setVisible(shownAsPair || swap);
+    vlay->addWidget(swapBox);
+
+    const bool corrected = clip && clip->hasStereo3DCorrection();
+    auto *saveButton = new QPushButton(Stereo3D::saveCorrectionText(), this);
+    saveButton->setToolTip(Stereo3D::saveCorrectionToolTip());
+    saveButton->setEnabled(corrected);
+    saveButton->setVisible(shownAsPair || corrected);
+    auto *saveLay = new QHBoxLayout;
+    saveLay->addWidget(saveButton);
+    saveLay->addStretch(10);
+    vlay->addLayout(saveLay);
+
+    connect(combo, static_cast<void (QComboBox::*)(int)>(&QComboBox::activated), this, [this, combo]() {
+        QMap<QString, QString> oldProperties;
+        oldProperties.insert(QStringLiteral("kdenlive:stereo3d_input"), QString::fromUtf8(m_properties->get("kdenlive:stereo3d_input")));
+        QMap<QString, QString> properties;
+        properties.insert(QStringLiteral("kdenlive:stereo3d_input"), combo->currentData().toString());
+        Q_EMIT updateClipProperties(m_id, oldProperties, properties);
+    });
+    connect(swapBox, &QCheckBox::toggled, this, [this](bool checked) {
+        QMap<QString, QString> oldProperties;
+        oldProperties.insert(QStringLiteral("kdenlive:stereo3d_swap"), QString::fromUtf8(m_properties->get("kdenlive:stereo3d_swap")));
+        QMap<QString, QString> properties;
+        properties.insert(QStringLiteral("kdenlive:stereo3d_swap"), checked ? QStringLiteral("1") : QString());
+        Q_EMIT updateClipProperties(m_id, oldProperties, properties);
+    });
+    connect(saveButton, &QPushButton::clicked, this, [this]() {
+        // written only because the person chose it; read back by the library, and the clip read again from the file
+        const std::shared_ptr<ProjectClip> binClip = pCore->projectItemModel()->getClipByBinID(m_id);
+        if (!binClip) {
+            return;
+        }
+        const QString error = binClip->saveStereo3DCorrection();
+        if (!error.isEmpty()) {
+            KMessageBox::error(this, error);
+        }
+    });
+    return vlay;
+}
