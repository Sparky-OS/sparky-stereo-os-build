+
+bool KdenliveDoc::isStereo3DPairProject() const
+{
+    if (!isStereo3DAutomatic()) {
+        return false;
+    }
+    const Stereo3D::Format format = stereo3DFormat();
+    return format.packing == Stereo3D::Packing::SideBySide && !format.rightFirst;
+}
+
+QSize KdenliveDoc::stereo3DPairFrame() const
+{
+    if (!isStereo3DPairProject()) {
+        return {};
+    }
+    // "Full" is the layout, not a size: each eye is a whole picture of the project's resolution. A project whose own frame already
+    // holds two whole views (3840x1080) keeps it.
+    const QSize frame = pCore->getCurrentFrameSize();
+    if (Stereo3D::fullSizeViews(QSize(qRound(frame.width() * pCore->getCurrentSar()), frame.height()), Stereo3D::Packing::SideBySide)) {
+        return frame;
+    }
+    return {2 * frame.width(), frame.height()};
+}
+
+void KdenliveDoc::checkStereo3DPairProject(bool afterLoading)
+{
+    if (m_checkingStereoPair || !pCore->projectItemModel()) {
+        return;
+    }
+    const bool pair = isStereo3DPairProject();
+    // Once the project is open its timeline is there: whatever was decided while its clips loaded, every clip's timeline instances
+    // follow what the project is
+    if (pair == m_stereoPairProject && !(afterLoading && pair)) {
+        return;
+    }
+    m_checkingStereoPair = true;
+    m_stereoPairProject = pair;
+    // every clip's conversion: 3D clips taken apart, 2D ones in both eyes, or nothing in a 2D project
+    const std::vector<QString> ids = pCore->projectItemModel()->getAllClipIds();
+    for (const QString &id : ids) {
+        if (const std::shared_ptr<ProjectClip> clip = pCore->projectItemModel()->getClipByBinID(id)) {
+            const int type = clip->clipType();
+            if (type == ClipType::Color || type == ClipType::Image || type == ClipType::Text || type == ClipType::TextTemplate || type == ClipType::Qml) {
+                // their timeline instances are cuts of the clip's own producer in a 2D project and producers of their own in a 3D one
+                clip->reloadTimeline();
+            } else {
+                clip->updateStereoUnpack();
+            }
+        }
+    }
+    m_checkingStereoPair = false;
+    // the monitors' working frame: two eyes side by side, or the project's own
+    if (pCore->monitorManager()) {
+        Q_EMIT pCore->monitorManager()->updatePreviewScaling();
+    }
+    pCore->refreshProjectMonitorOnce();
+}
