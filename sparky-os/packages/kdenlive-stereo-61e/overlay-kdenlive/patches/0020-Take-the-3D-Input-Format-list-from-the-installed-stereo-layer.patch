+    static const QList<InputEntry> entries = [] {
+        QList<InputEntry> list;
+#ifdef HAVE_STEREO_POLICY_LIST
+        const size_t count = stereo_policy_input_format_count();
+        for (size_t i = 0; i < count; ++i) {
+            const stereo_policy_input_format *format = stereo_policy_input_format_at(i);
+            // Kdenlive's own first entry, Automatic, is the property left empty
+            if (!format || !format->id || !format->text || !strcmp(format->id, "automatic")) {
+                continue;
+            }
+            const Packing packing = packingOfLayout(format->layout, format->anaglyph);
+            list.append({format->id, format->text, format->group, packing, packing != Packing::None && format->order == 1, format->layout,
+                         format->order, format->anaglyph, format->video_only != 0});
