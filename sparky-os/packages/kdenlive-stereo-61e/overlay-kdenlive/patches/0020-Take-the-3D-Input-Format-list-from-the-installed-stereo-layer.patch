-// The stereo layer's input formats (stereo-layer 1.22, src/picture/filechoicelist.cpp; from 1.23 also its C list
-// stereo_policy_input_format_at()), in its order and words: the packings of RFC 9559 StereoMode and of H.264 Table D-8 and H.265
-// Table D.8, both eye orders, the anaglyph colour pairs and the picture-with-depth layouts. The policy values are stereo-policy.h's:
-// layouts 0 none, 1 side by side, 2 top and bottom, 4 rows, 5 columns, 6 checkerboard, 7 side by side quincunx, 8 frames in turn,
-// 9 both views in one block, 10 to 13 a picture and its depth; anaglyphs 1 red/cyan, 2 green/magenta, 3 amber/blue.
+// The stereo layer's input formats, read from the installed layer when they are first needed (stereo-policy 1.23:
+// stereo_policy_input_format_at()), in its order, groups and words, translated by its own catalogue (context Stereo::FileChoiceMenu):
+// every packing the layer knows, never a list of Kdenlive's own. The policy values are stereo-policy.h's: layouts 0 none, 1 side by
+// side, 2 top and bottom, 4 rows, 5 columns, 6 checkerboard, 7 side by side quincunx, 8 frames in turn, 9 both views in one block,
+// 10 to 13 a picture and its depth; anaglyphs 1 red/cyan, 2 green/magenta, 3 amber/blue. Kdenlive shows as a pair the packings
+// MLT's stereo3d_unpack takes apart; the others are shown as one picture and said so.
+static Packing packingOfLayout(int layout, int anaglyph)
+{
+    if (anaglyph != 0) {
+        return Packing::None;
+    }
+    switch (layout) {
+    case 1:
+        return Packing::SideBySide;
+    case 2:
+        return Packing::TopBottom;
+    case 4:
+        return Packing::Lines;
+    case 5:
+        return Packing::Columns;
+    case 6:
+        return Packing::Checkerboard;
+    case 7:
+        return Packing::SideBySideQuincunx;
+    case 8:
+        return Packing::FrameSequence;
+    default:
+        return Packing::None;
+    }
+}
