Description: Take the 3D Input Format list from the installed stereo layer
 The list of a clip's 3D input formats is the installed stereo layer's own
 (stereo-policy 1.23: stereo_policy_input_format_count() and _at()), read when
 Kdenlive first needs it, in its order, groups and words, translated by the
 layer's catalogue; Kdenlive keeps no copy of it.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Forwarded: not-yet
Last-Update: 2026-11-21
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -319,6 +319,11 @@ add_definitions(${qt${QT_MAJOR_VERSION}g
 if(StereoLayer_FOUND)
     target_link_libraries(kdenliveLib PUBLIC Stereo::Layer)
     target_compile_definitions(kdenliveLib PUBLIC HAVE_STEREO_LAYER)
+    # the layer's own list of input formats (stereo-policy 1.23), read when the program runs
+    if(TARGET Stereo::Policy AND StereoLayer_VERSION VERSION_GREATER_EQUAL 1.23)
+        target_link_libraries(kdenliveLib PUBLIC Stereo::Policy)
+        target_compile_definitions(kdenliveLib PUBLIC HAVE_STEREO_POLICY_LIST)
+    endif()
     # the person's 3D correction of a clip written into the file's own mark, when the person chooses it (libstereo-av)
     if(TARGET Stereo::Av)
         target_link_libraries(kdenliveLib PUBLIC Stereo::Av)
