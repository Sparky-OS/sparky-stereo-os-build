--- a/src/monitor/stereolayer.cpp
+++ b/src/monitor/stereolayer.cpp
@@ -155,6 +155,52 @@ bool createBuffer(Buffer &buffer, wl_shm
 
 }
 
+namespace
+{
+// libstereo-declare is set up once in a process (stereo_declare_wayland_init() answers -EBUSY to a second call), on an event queue
+// of its own, and declares any number of surfaces: the 3D areas of the project monitor and the clip monitor share it, and the last
+// one to go ends it
+struct SharedDeclaration
+{
+    int users{0};
+    wl_event_queue *queue{nullptr};
+};
+
+SharedDeclaration &sharedDeclaration()
+{
+    static SharedDeclaration shared;
+    return shared;
+}
+
+bool acquireDeclaration(wl_display *display)
+{
+    SharedDeclaration &shared = sharedDeclaration();
+    if (shared.users == 0) {
+        shared.queue = wl_display_create_queue(display);
+        if (!shared.queue || stereo_declare_wayland_init(display, shared.queue) != 0) {
+            if (shared.queue) {
+                wl_event_queue_destroy(shared.queue);
+                shared.queue = nullptr;
+            }
+            return false;
+        }
+        wl_display_roundtrip_queue(display, shared.queue);
+    }
+    ++shared.users;
+    return true;
+}
+
+void releaseDeclaration()
+{
+    SharedDeclaration &shared = sharedDeclaration();
+    if (shared.users > 0 && --shared.users == 0) {
+        stereo_declare_wayland_finish();
+        wl_event_queue_destroy(shared.queue);
+        shared.queue = nullptr;
+    }
+}
+}
+
