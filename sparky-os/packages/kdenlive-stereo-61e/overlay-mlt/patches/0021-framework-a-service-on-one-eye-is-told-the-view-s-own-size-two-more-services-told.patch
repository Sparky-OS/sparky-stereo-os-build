@@ -162,23 +164,47 @@ int mlt_stereo_eyes_wanted(mlt_service service, mlt_frame frame, mlt_frame b_fra
 
 int mlt_stereo_eyes_enter(mlt_frame frame)
 {
-    // While a service acting on each eye is set up (its process), the frame says one eye's media width: a service that sizes
-    // itself then (crop) works in that eye's samples
-    if (!frame || !mlt_properties_get_int(MLT_FRAME_PROPERTIES(frame), PAIR))
+    // While a service acting on each eye is set up (its process), the frame says one eye's media size: a service that sizes
+    // itself then (crop) works in that eye's samples. The eye's own samples are the view's as the clip holds it, which
+    // stereo3d_unpack says (a clip of 4:3 views or of half views in a project of another shape), else half the frame
+    mlt_properties props = MLT_FRAME_PROPERTIES(frame);
+    if (!frame || !mlt_properties_get_int(props, PAIR))
+        return 0;
+    const int width = mlt_properties_get_int(props, "meta.media.width");
+    if (width <= 1)
         return 0;
-    const int width = mlt_properties_get_int(MLT_FRAME_PROPERTIES(frame), "meta.media.width");
-    if (width > 1)
-        mlt_properties_set_int(MLT_FRAME_PROPERTIES(frame), "meta.media.width", width / 2);
-    return width > 1 ? width : 0;
+    const int view_width = mlt_properties_get_int(props, "stereo3d_unpack.view_width");
+    const int view_height = mlt_properties_get_int(props, "stereo3d_unpack.view_height");
+    const int height = mlt_properties_get_int(props, "meta.media.height");
+    if (view_width > 1 && view_height > 1 && height > 1) {
+        mlt_properties_set_int(props, "_stereo3d.enter_height", height);
+        mlt_properties_set_int(props, "meta.media.width", view_width);
+        mlt_properties_set_int(props, "meta.media.height", view_height);
+    } else {
+        mlt_properties_set_int(props, "_stereo3d.enter_height", 0);
+        mlt_properties_set_int(props, "meta.media.width", width / 2);
+    }
+    return width;
 }
 
 void mlt_stereo_eyes_leave(mlt_frame frame, int width)
 {
-    // the frame's width again, or twice what the service left as one eye's (crop's cropped width)
+    // the frame's size again, or what the service left as one eye's (crop's cropped size) as two eyes of the frame
     if (!frame || width <= 1)
         return;
-    const int eye = mlt_properties_get_int(MLT_FRAME_PROPERTIES(frame), "meta.media.width");
-    mlt_properties_set_int(MLT_FRAME_PROPERTIES(frame), "meta.media.width", eye == width / 2 ? width : 2 * eye);
+    mlt_properties props = MLT_FRAME_PROPERTIES(frame);
+    const int height = mlt_properties_get_int(props, "_stereo3d.enter_height");
+    const int eye = mlt_properties_get_int(props, "meta.media.width");
+    if (height > 1) {
+        const int view_width = mlt_properties_get_int(props, "stereo3d_unpack.view_width");
+        const int view_height = mlt_properties_get_int(props, "stereo3d_unpack.view_height");
+        const int eye_height = mlt_properties_get_int(props, "meta.media.height");
+        mlt_properties_set_int(props, "meta.media.width", eye == view_width ? width : (int) ((double) width * eye / view_width + 0.5));
+        mlt_properties_set_int(props, "meta.media.height",
+                               eye_height == view_height ? height : (int) ((double) height * eye_height / view_height + 0.5));
+        return;
+    }
+    mlt_properties_set_int(props, "meta.media.width", eye == width / 2 ? width : 2 * eye);
 }
 
 static void op_close(void *data)
