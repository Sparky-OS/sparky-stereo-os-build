diff --git a/src/framework/mlt_deque.c b/src/framework/mlt_deque.c
index a20dab4..bcc1a06 100644
--- a/src/framework/mlt_deque.c
+++ b/src/framework/mlt_deque.c
@@ -413,6 +413,53 @@ double mlt_deque_peek_front_double(mlt_deque self)
     return self->count > 0 ? self->list[0].floating : 0;
 }
 
+/** Move the last entries of a deque to the back of another, keeping their order and their bytes (an entry pushed as
+ * a pointer, an int or a double is moved as it is).
+ *
+ * \private \memberof mlt_deque_s
+ * \param self the deque the entries are taken from
+ * \param target the deque they are put on
+ * \param count how many entries
+ * \return true if there was an error
+ */
+
+int mlt_deque_move_back(mlt_deque self, mlt_deque target, int count)
+{
+    if (count < 0 || count > self->count)
+        return 1;
+    for (int i = self->count - count; i < self->count; i++) {
+        if (mlt_deque_allocate(target))
+            return 1;
+        target->list[target->count++] = self->list[i];
+    }
+    self->count -= count;
+    return 0;
+}
+
+/** Put a copy of every entry of a deque at the back of another, keeping their order and their bytes, an entry that
+ * is the pointer \p from put as \p to.
+ *
+ * \private \memberof mlt_deque_s
+ * \param self the deque the entries are put on
+ * \param source the deque they are copied from (unchanged)
+ * \param from a pointer to replace, or NULL
+ * \param to what replaces it
+ * \return true if there was an error
+ */
+
+int mlt_deque_append_copy(mlt_deque self, mlt_deque source, void *from, void *to)
+{
+    for (int i = 0; i < source->count; i++) {
+        if (mlt_deque_allocate(self))
+            return 1;
+        self->list[self->count] = source->list[i];
+        if (from && self->list[self->count].addr == from)
+            self->list[self->count].addr = to;
+        self->count++;
+    }
+    return 0;
+}
+
 /** Destroy the queue.
  *
  * \public \memberof mlt_deque_s
