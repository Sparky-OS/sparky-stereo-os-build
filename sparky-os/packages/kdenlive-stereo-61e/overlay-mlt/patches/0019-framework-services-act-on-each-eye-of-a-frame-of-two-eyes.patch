+// A frame of two eyes asked for at another size: each eye scaled apart to its half of that size, as a 2D producer's normalizers
+// scale its picture (MLT's rescaler, FFmpeg's scaler when there is one, on a frame of its own per eye), so no scaler reaches across
+// the middle. A service acting on each eye may ask for a smaller picture (qtblend, composite). Returns false when it scaled.
+static int scale_halves(mlt_filter filter, mlt_frame frame, uint8_t **image, mlt_image_format format, int *width, int *height, int want_width, int want_height)
+{
+    const int bpp = format == mlt_image_rgba64 ? 8 : format == mlt_image_rgba ? 4 : 0;
+    const int ew = *width / 2, eh = *height, ow = want_width / 2, oh = want_height;
+    if (!bpp || ew < 1 || eh < 1 || ow < 1 || oh < 1)
+        return 1;
+    mlt_profile profile = mlt_profile_clone(mlt_service_profile(MLT_FILTER_SERVICE(filter)));
+    mlt_filter scaler = profile ? mlt_factory_filter(profile, "swscale", NULL) : NULL;
+    if (!scaler && profile)
+        scaler = mlt_factory_filter(profile, "rescale", NULL);
+    uint8_t *out = mlt_pool_alloc((size_t) 2 * ow * oh * bpp);
+    int error = !out || !scaler;
+    for (int e = 0; e < 2 && !error; e++) {
+        mlt_frame eye = mlt_frame_init(MLT_FILTER_SERVICE(filter));
+        uint8_t *picture = mlt_pool_alloc((size_t) ew * eh * bpp);
+        if (!eye || !picture) {
+            mlt_frame_close(eye);
+            mlt_pool_release(picture);
+            error = 1;
+            break;
+        }
+        for (int y = 0; y < eh; y++)
+            memcpy(picture + (size_t) y * ew * bpp, *image + ((size_t) y * *width + e * ew) * bpp, (size_t) ew * bpp);
+        mlt_properties props = MLT_FRAME_PROPERTIES(eye);
+        mlt_properties_pass_list(props, MLT_FRAME_PROPERTIES(frame), "consumer.rescale, rescale.interp, aspect_ratio, progressive, colorspace, color_trc, full_range");
+        mlt_properties_set_int(props, "width", ew);
+        mlt_properties_set_int(props, "height", eh);
+        mlt_properties_set_int(props, "meta.media.width", ew);
+        mlt_properties_set_int(props, "meta.media.height", eh);
+        mlt_properties_set_int(props, "format", format);
+        mlt_frame_set_image(eye, picture, ew * eh * bpp, mlt_pool_release);
+        eye->convert_image = frame->convert_image;
+        mlt_filter_process(scaler, eye);
+        uint8_t *scaled = NULL;
+        mlt_image_format scaled_format = format;
+        int w = ow, h = oh;
+        error = mlt_frame_get_image(eye, &scaled, &scaled_format, &w, &h, 0) || !scaled || scaled_format != format || w != ow || h != oh;
+        if (!error)
+            for (int y = 0; y < oh; y++)
+                memcpy(out + ((size_t) y * 2 * ow + e * ow) * bpp, scaled + (size_t) y * ow * bpp, (size_t) ow * bpp);
+        mlt_frame_close(eye);
+    }
+    mlt_filter_close(scaler);
+    mlt_profile_close(profile);
+    if (error) {
+        mlt_pool_release(out);
+        mlt_log_error(MLT_FILTER_SERVICE(filter), "the eyes could not be scaled apart to %dx%d: the frame of two eyes is given at %dx%d\n",
+                      want_width, want_height, *width, *height);
+        return 1;
+    }
+    mlt_frame_set_image(frame, out, 2 * ow * oh * bpp, mlt_pool_release);
+    mlt_frame_set_alpha(frame, NULL, 0, NULL);
+    mlt_properties_set_int(MLT_FRAME_PROPERTIES(frame), "width", 2 * ow);
+    mlt_properties_set_int(MLT_FRAME_PROPERTIES(frame), "height", oh);
+    *image = out;
+    *width = 2 * ow;
+    *height = oh;
+    return 0;
+}
