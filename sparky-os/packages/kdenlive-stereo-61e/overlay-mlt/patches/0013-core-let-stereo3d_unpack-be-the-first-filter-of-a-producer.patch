+// One axis of a resampling: for each output position, the weights of the input samples it takes. Shrinking, each output
+// sample is the average of the input it covers (area integration); growing, it is the linear interpolation of its two neighbours.
+typedef struct
+{
+    int first;
+    int count;
+    float *weights;
+} taps_t;
+
+static taps_t *axis_taps(int in, int out)
+{
+    taps_t *taps = calloc((size_t) out, sizeof(taps_t));
+    const double scale = (double) in / out;
+    for (int o = 0; o < out; o++) {
+        taps_t *t = &taps[o];
+        if (scale > 1.0) {
+            const double start = o * scale, end = start + scale;
+            t->first = (int) start;
+            int last = (int) end;
+            if (last >= in)
+                last = in - 1;
+            t->count = last - t->first + 1;
+            t->weights = calloc((size_t) t->count, sizeof(float));
+            for (int i = 0; i < t->count; i++) {
+                const double a = t->first + i > start ? t->first + i : start;
+                const double b = t->first + i + 1 < end ? t->first + i + 1 : end;
+                t->weights[i] = (float) ((b > a ? b - a : 0) / scale);
+            }
+        } else {
+            double centre = (o + 0.5) * scale - 0.5;
+            if (centre < 0)
+                centre = 0;
+            t->first = (int) centre;
+            const double w = centre - t->first;
+            t->count = t->first + 1 < in ? 2 : 1;
+            t->weights = calloc(2, sizeof(float));
+            t->weights[0] = (float) (t->count == 2 ? 1 - w : 1);
+            t->weights[1] = (float) w;
+        }
+    }
+    return taps;
+}
+
+static void free_taps(taps_t *taps, int out)
+{
+    for (int o = 0; o < out; o++)
+        free(taps[o].weights);
+    free(taps);
+}
+
+// The samples of a view resampled to the size it takes in a frame of a producer's profile (RGBA, 8 bits)
+static void resample_view(const uint8_t *src, int sw, int sh, uint8_t *dst, int dst_stride, int dw, int dh)
+{
+    taps_t *xt = axis_taps(sw, dw);
+    taps_t *yt = axis_taps(sh, dh);
+    float *rows = calloc((size_t) sh * dw * 4, sizeof(float));
+    for (int y = 0; y < sh; y++) {
+        const uint8_t *in = src + (size_t) y * sw * 4;
+        float *out = rows + (size_t) y * dw * 4;
+        for (int x = 0; x < dw; x++) {
+            const taps_t *t = &xt[x];
+            for (int i = 0; i < t->count; i++) {
+                const uint8_t *p = in + (size_t) (t->first + i) * 4;
+                for (int c = 0; c < 4; c++)
+                    out[x * 4 + c] += t->weights[i] * p[c];
+            }
+        }
+    }
+    for (int y = 0; y < dh; y++) {
+        const taps_t *t = &yt[y];
+        uint8_t *out = dst + (size_t) y * dst_stride;
+        for (int x = 0; x < dw * 4; x++) {
+            float v = 0;
+            for (int i = 0; i < t->count; i++)
+                v += t->weights[i] * rows[(size_t) (t->first + i) * dw * 4 + x];
+            out[x] = v <= 0 ? 0 : v >= 255 ? 255 : (uint8_t) (v + 0.5f);
+        }
+    }
+    free(rows);
+    free_taps(xt, dw);
+    free_taps(yt, dh);
+}
