+// As the first filter of a producer (in_producer=1), the filter takes the views out of the producer's own picture and fits each,
+// keeping its shape, to its half of a frame of the profile's size, the left eye in the left half: the one resize an editor makes
+// of any clip to its project, here per eye. When the frame is made it tells the producer's other filters (rescaling, padding)
+// the profile's size and sample aspect ratio, so they have nothing left to do. target_views=half is for a profile whose frames
+// carry half views, squeezed to half their width (a 1920x1080 side by side profile): each half is shown twice as wide, so a view
+// is fitted to that shape. With output left or right it gives that view at the size of a view and says so. Frame sequences are
+// passed on as they are here.
+static void announce(mlt_filter filter, mlt_frame frame)
+{
+    mlt_properties properties = MLT_FILTER_PROPERTIES(filter);
+    mlt_properties frame_props = MLT_FRAME_PROPERTIES(frame);
+    mlt_profile profile = mlt_service_profile(MLT_FILTER_SERVICE(filter));
+    const packing_t packing = packing_from_name(mlt_properties_get(properties, "packing"));
+    const char *output = mlt_properties_get(properties, "output");
+    const int width = mlt_properties_get_int(frame_props, "width");
+    const int height = mlt_properties_get_int(frame_props, "height");
+    if (!profile || packing == packing_none || packing == packing_frame_sequence || !output || width < 2 || height < 2
+        || profile->width < 4 || profile->height < 2)
+        return;
+    int vw, vh;
+    view_size(frame, packing, width, height, &vw, &vh);
+    if (strcmp(output, "side_by_side")) {
+        // One view (left or right): the view restored to the size of a view, its sample aspect ratio the frame's, for the
+        // producer's other filters to scale and pad as any picture (a thumbnail of a 3D clip)
+        mlt_properties_set_int(frame_props, "stereo3d_unpack.in_producer", 1);
+        mlt_properties_set_int(frame_props, "stereo3d_unpack.width", width);
+        mlt_properties_set_int(frame_props, "stereo3d_unpack.height", height);
+        mlt_properties_set_int(frame_props, "width", vw);
+        mlt_properties_set_int(frame_props, "height", vh);
+        mlt_properties_set_int(frame_props, "meta.media.width", vw);
+        mlt_properties_set_int(frame_props, "meta.media.height", vh);
+        return;
+    }
+    double aspect = mlt_frame_get_aspect_ratio(frame);
+    if (aspect <= 0)
+        aspect = 1.0;
+    // the shape of a view, and the shape of the half of the profile's frame it goes into
+    const double view_shape = vw * aspect / vh;
+    const char *target = mlt_properties_get(properties, "target_views");
+    const int fw = profile->width;
+    const int fh = profile->height;
+    const double half_shape = (fw / 2) * mlt_profile_sar(profile) * (target && !strcmp(target, "half") ? 2 : 1) / fh;
+    int pw = fw / 2;
+    int ph = fh;
+    if (view_shape >= half_shape)
+        ph = (int) (fh * half_shape / view_shape + 0.5);
+    else
+        pw = (int) ((fw / 2) * view_shape / half_shape + 0.5);
+    if (pw < 1)
+        pw = 1;
+    if (ph < 1)
+        ph = 1;
+    mlt_properties_set_int(frame_props, "stereo3d_unpack.in_producer", 1);
+    mlt_properties_set_int(frame_props, "stereo3d_unpack.width", width);
+    mlt_properties_set_int(frame_props, "stereo3d_unpack.height", height);
+    mlt_properties_set_int(frame_props, "stereo3d_unpack.out_width", fw);
+    mlt_properties_set_int(frame_props, "stereo3d_unpack.out_height", fh);
+    mlt_properties_set_int(frame_props, "stereo3d_unpack.picture_width", pw);
+    mlt_properties_set_int(frame_props, "stereo3d_unpack.picture_height", ph);
+    mlt_properties_set_int(frame_props, "width", fw);
+    mlt_properties_set_int(frame_props, "height", fh);
+    mlt_properties_set_int(frame_props, "meta.media.width", fw);
+    mlt_properties_set_int(frame_props, "meta.media.height", fh);
+    mlt_frame_set_aspect_ratio(frame, mlt_profile_sar(profile));
+}
+
 static mlt_frame filter_process(mlt_filter filter, mlt_frame frame)
 {
+    if (mlt_properties_get_int(MLT_FILTER_PROPERTIES(filter), "in_producer"))
+        announce(filter, frame);
     mlt_frame_push_service(frame, filter);
     mlt_frame_push_get_image(frame, filter_get_image);
     return frame;
