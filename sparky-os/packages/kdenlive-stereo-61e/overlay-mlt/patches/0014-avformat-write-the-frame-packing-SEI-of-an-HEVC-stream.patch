+/** Writes an encoded video packet, through the stereo bitstream filter when there is one; a null packet drains the filter.
+*/
+static int write_video_packet(encode_ctx_t *enc_ctx, AVPacket *pkt)
+{
+    AVCodecContext *c = enc_ctx->vcodec_ctx;
+    AVBSFContext *bsf = mlt_properties_get_data(enc_ctx->properties, "_stereo3d_bsf", NULL);
+    if (!bsf) {
+        if (!pkt)
+            return 0;
+        av_packet_rescale_ts(pkt, c->time_base, enc_ctx->video_st->time_base);
+        pkt->stream_index = enc_ctx->video_st->index;
+        return av_interleaved_write_frame(enc_ctx->oc, pkt);
+    }
+    int ret = av_bsf_send_packet(bsf, pkt);
+    if (ret < 0)
+        return ret;
+    AVPacket *out = av_packet_alloc();
+    if (!out)
+        return AVERROR(ENOMEM);
+    while ((ret = av_bsf_receive_packet(bsf, out)) >= 0) {
+        av_packet_rescale_ts(out, bsf->time_base_out, enc_ctx->video_st->time_base);
+        out->stream_index = enc_ctx->video_st->index;
+        ret = av_interleaved_write_frame(enc_ctx->oc, out);
+        if (ret < 0)
+            break;
+    }
+    av_packet_free(&out);
+    return ret == AVERROR(EAGAIN) || ret == AVERROR_EOF ? 0 : ret;
+}
