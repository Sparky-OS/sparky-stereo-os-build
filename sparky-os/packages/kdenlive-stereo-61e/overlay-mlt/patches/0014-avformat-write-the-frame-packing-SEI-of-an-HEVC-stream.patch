+static void close_stereo3d_bsf(void *data)
+{
+    AVBSFContext *bsf = data;
+    av_bsf_free(&bsf);
+}
+
+/** An HEVC encoder that does not write the frame packing arrangement SEI from the frame's Stereo 3D description
+    (libx265, unlike libx264) gets it from FFmpeg's hevc_metadata bitstream filter (frame_packing=insert), which takes the
+    layout from the stream's Stereo 3D side data and clears general_non_packed_constraint_flag in the parameter sets, as
+    H.265 7.4.4 requires of a stream with a frame packing arrangement (D.3.16). The hardware encoders that write it
+    themselves (VA-API, NVENC, QSV, Vulkan) are left as they are. Without the option, an FFmpeg that lacks it, the stream
+    gets no SEI and that is said; the container's mark is still written.
+*/
+static void open_stereo3d_bsf(mlt_properties properties, AVStream *st, AVCodecContext *video_enc)
+{
+    static const char *const writers[] = {"hevc_vaapi", "hevc_nvenc", "hevc_qsv", "hevc_vulkan"};
+    if (st->codecpar->codec_id != AV_CODEC_ID_HEVC || !video_enc->codec)
+        return;
+    for (size_t i = 0; i < sizeof(writers) / sizeof(writers[0]); i++) {
+        if (!strcmp(video_enc->codec->name, writers[i]))
+            return;
+    }
+    const AVBitStreamFilter *filter = av_bsf_get_by_name("hevc_metadata");
+    AVBSFContext *bsf = NULL;
+    if (!filter || av_bsf_alloc(filter, &bsf) < 0 || avcodec_parameters_copy(bsf->par_in, st->codecpar) < 0) {
+        av_bsf_free(&bsf);
+        mlt_log_error(NULL, "%s: no hevc_metadata bitstream filter: the HEVC stream has no frame packing SEI\n", __FILE__);
+        return;
+    }
+    bsf->time_base_in = video_enc->time_base;
+    if (av_opt_set(bsf->priv_data, "frame_packing", "insert", 0) < 0 || av_bsf_init(bsf) < 0
+        || avcodec_parameters_copy(st->codecpar, bsf->par_out) < 0) {
+        av_bsf_free(&bsf);
+        mlt_log_error(NULL,
+                      "%s: FFmpeg's hevc_metadata cannot insert a frame packing arrangement: the HEVC stream has no "
+                      "frame packing SEI\n",
+                      __FILE__);
+        return;
+    }
+    mlt_properties_set_data(properties, "_stereo3d_bsf", bsf, 0, close_stereo3d_bsf, NULL);
+}
