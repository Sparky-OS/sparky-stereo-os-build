+static int filter_get_image(mlt_frame frame,
+                            uint8_t **image,
+                            mlt_image_format *format,
+                            int *width,
+                            int *height,
+                            int writable)
+{
+    (void) writable;
+    mlt_filter filter = mlt_frame_pop_service(frame);
+    const mlt_image_format asked = *format;
+    int error = unpack_image(filter, frame, image, format, width, height);
+    // A deep request gets the format it asked for (yuv420p10, yuv444p10, yuv422p16) from the views worked in RGBA64, so what
+    // follows (a transition such as qtblend) is handed the picture as a decoder would hand it. An opaque picture carries no alpha
+    // mask after the conversion: with one, qtblend composites it as a picture with transparency, through 8 bits.
+    if (!error && *format == mlt_image_rgba64 && asked != mlt_image_rgba64
+        && (asked == mlt_image_yuv420p10 || asked == mlt_image_yuv444p10 || asked == mlt_image_yuv422p16) && frame->convert_image) {
+        struct mlt_image_s img;
+        mlt_image_set_values(&img, *image, *format, *width, *height);
+        const int opaque = mlt_image_is_opaque(&img);
+        error = frame->convert_image(frame, image, format, asked);
+        if (!error && opaque)
+            mlt_frame_set_alpha(frame, NULL, 0, NULL);
+    }
+    return error;
+}
