+// Bilinear scaling of the samples of a view to the size it is shown at, 16 bits a sample (RGBA64)
+static void scale_view16(const uint16_t *src, int sw, int sh, uint16_t *dst, int dw, int dh)
+{
+    for (int y = 0; y < dh; y++) {
+        double fy = dh > 1 && sh > 1 ? (double) y * (sh - 1) / (dh - 1) : 0;
+        int y0 = (int) fy;
+        int y1 = y0 + 1 < sh ? y0 + 1 : y0;
+        double wy = fy - y0;
+        for (int x = 0; x < dw; x++) {
+            double fx = dw > 1 && sw > 1 ? (double) x * (sw - 1) / (dw - 1) : 0;
+            int x0 = (int) fx;
+            int x1 = x0 + 1 < sw ? x0 + 1 : x0;
+            double wx = fx - x0;
+            for (int c = 0; c < 4; c++) {
+                double top = src[((size_t) y0 * sw + x0) * 4 + c] * (1 - wx) + src[((size_t) y0 * sw + x1) * 4 + c] * wx;
+                double bottom = src[((size_t) y1 * sw + x0) * 4 + c] * (1 - wx) + src[((size_t) y1 * sw + x1) * 4 + c] * wx;
+                dst[((size_t) y * dw + x) * 4 + c] = (uint16_t) (top * (1 - wy) + bottom * wy + 0.5);
+            }
+        }
+    }
+}
