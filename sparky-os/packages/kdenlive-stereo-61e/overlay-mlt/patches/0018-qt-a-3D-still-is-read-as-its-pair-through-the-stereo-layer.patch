+// A 3D still, read by the stereo layer as every program of the edition reads it (its file mark, or the photo policy): its two
+// views side by side, the left eye first, or a null image for a 2D picture
+static QImage stereo_still(const QString &filename)
+{
+    const Stereo::Picture picture = Stereo::Picture::load(filename, Stereo::Picture::Options{}, Stereo::OutputMode::Stereo);
+    return picture.isStereo() ? picture.sideBySide() : QImage();
+}
+
+// What the producer says of a 3D still: full side by side, the left eye first, two whole views
+static void announce_stereo_still(mlt_properties props, const QImage &pair)
+{
+    mlt_properties_set(props, "meta.media.stereo3d.type", "side_by_side");
+    mlt_properties_set_int(props, "meta.media.stereo3d.invert", 0);
+    mlt_properties_set(props, "meta.media.stereo3d.views", "full");
+    mlt_properties_set_int(props, "meta.media.width", pair.width());
+    mlt_properties_set_int(props, "meta.media.height", pair.height());
+}
+#endif
+
