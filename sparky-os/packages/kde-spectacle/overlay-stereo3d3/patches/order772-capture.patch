+#pragma once
+
+#include <QImage>
+#include <QRect>
+#include <QPainter>
+#include "ImageMetaData.h"
+
+namespace CaptureImage
+{
+inline QImage eye(const QImage &image, bool right = false)
+{
+    if (!ImageMetaData::isStereo(image)) {
+        return image;
+    }
+    auto result = image.copy(right ? image.width() / 2 : 0, 0, image.width() / 2, image.height());
+    ImageMetaData::setStereo(result, false);
+    return result;
+}
+
+inline QImage cropped(const QImage &image, const QRect &rect)
+{
+    if (!ImageMetaData::isStereo(image)) {
+        return image.copy(rect);
+    }
+    const QRect eyeRect(0, 0, image.width() / 2, image.height());
+    const QRect selection = rect.intersected(eyeRect);
+    if (selection.isEmpty()) {
+        return {};
+    }
+    QImage result(QSize(selection.width() * 2, selection.height()), image.format());
+    QPainter painter(&result);
+    painter.drawImage(0, 0, image, selection.x(), selection.y(), selection.width(), selection.height());
+    painter.drawImage(selection.width(), 0, image, selection.x() + eyeRect.width(), selection.y(), selection.width(), selection.height());
+    painter.end();
+    ImageMetaData::copy(result, image);
+    return result;
+}
+}
