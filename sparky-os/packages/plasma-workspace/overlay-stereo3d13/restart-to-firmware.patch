+
+void KSMShutdownDlg::slotRebootToFirmwareSetup()
+{
+    if (m_firmwareRequestPending || !m_session.canRebootToFirmwareSetup()) {
+        return;
+    }
+
+    m_firmwareRequestPending = true;
+    rootContext()->setContextProperty(u"firmwareRestartPending"_s, true);
+    rootContext()->setContextProperty(u"firmwareRestartError"_s, QString());
+    const auto message = QDBusMessage::createMethodCall(u"org.kde.Shutdown"_s, u"/Shutdown"_s, u"org.kde.Shutdown"_s, u"logoutAndRebootToFirmwareSetup"_s);
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        const QDBusPendingReply<QString> reply = *watcher;
+        watcher->deleteLater();
+        const QString error = reply.isError() ? reply.error().name() : reply.value();
+        if (error.isEmpty()) {
+            accept();
+            return;
+        }
+
+        m_firmwareRequestPending = false;
+        rootContext()->setContextProperty(u"firmwareRestartPending"_s, false);
+        rootContext()->setContextProperty(u"firmwareRestartError"_s, error);
+    });
+}
