+QString Shutdown::logoutAndRebootToFirmwareSetup()
+{
+    if (m_logoutStarted) {
+        return u"org.kde.Shutdown.InProgress"_s;
+    }
+
+    if (!QFileInfo(u"/sys/firmware/efi"_s).isDir()) {
+        QCoreApplication::quit();
+        return u"org.freedesktop.DBus.Error.NotSupported"_s;
+    }
+
+    auto message = login1Call(u"org.freedesktop.DBus.Properties"_s, u"Get"_s);
+    message << u"org.freedesktop.login1.Manager"_s << u"RebootToFirmwareSetup"_s;
+    const QDBusReply<QDBusVariant> previous = QDBusConnection::systemBus().call(message);
+    if (!previous.isValid()) {
+        qCWarning(PLASMA_SESSION) << "Could not read the firmware restart setting:" << previous.error();
+        QCoreApplication::quit();
+        return previous.error().name();
+    }
+
+    const auto result = setRebootToFirmwareSetup(true);
+    if (!result.isValid()) {
+        qCWarning(PLASMA_SESSION) << "Firmware restart was refused:" << result.error();
+        QCoreApplication::quit();
+        return result.error().name();
+    }
+
+    m_restoreFirmwareSetup = !previous.value().variant().toBool();
+    startLogout(KWorkSpace::ShutdownTypeReboot);
+    return {};
+}
+
+void Shutdown::restoreFirmwareSetup()
+{
+    if (m_restoreFirmwareSetup) {
+        const auto result = setRebootToFirmwareSetup(false);
+        if (!result.isValid()) {
+            qCWarning(PLASMA_SESSION) << "Could not restore the firmware restart setting:" << result.error();
+        }
+    }
+}
+
