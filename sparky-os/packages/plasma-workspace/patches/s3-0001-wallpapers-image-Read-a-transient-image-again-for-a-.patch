+
+#include "transientimage.h"
+
+#include <QImage>
+#include <QQuickWindow>
+#include <QSGRendererInterface>
+#include <QTemporaryDir>
+#include <QTest>
+
+using namespace Qt::StringLiterals;
+
+class TransientImageTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void moveToAnotherWindow();
+
+private:
+    QTemporaryDir m_dir;
+};
+
+void TransientImageTest::initTestCase()
+{
+    QQuickWindow::setGraphicsApi(QSGRendererInterface::Software);
+    QVERIFY(m_dir.isValid());
+    QImage red(64, 64, QImage::Format_RGB32);
+    red.fill(Qt::red);
+    QVERIFY(red.save(m_dir.filePath(u"red.png"_s)));
+}
+
+static QColor centre(QQuickWindow *window)
+{
+    const QImage grab = window->grabWindow();
+    return grab.isNull() ? QColor() : grab.pixelColor(grab.width() / 2, grab.height() / 2);
+}
+
+// The image is not kept once it is a texture, and the texture belongs to the window it was made for: an image moved
+// into another window (as the lock screen moves its wallpaper into a window of its own) shows there too.
+void TransientImageTest::moveToAnotherWindow()
+{
+    QQuickWindow first;
+    QQuickWindow second;
+    for (QQuickWindow *window : {&first, &second}) {
+        window->setColor(Qt::black);
+        window->resize(64, 64);
+        window->show();
+        QVERIFY(QTest::qWaitForWindowExposed(window));
+    }
+
+    TransientImage image;
+    image.setFillMode(TransientImage::Stretch);
+    image.setSize(QSizeF(64, 64));
+    image.setSource(QUrl::fromLocalFile(m_dir.filePath(u"red.png"_s)));
+    image.setParentItem(first.contentItem());
+    QTRY_COMPARE(image.status(), TransientImage::Ready);
+    QTRY_COMPARE(centre(&first), QColor(Qt::red));
+
+    image.setParentItem(second.contentItem());
+    QTRY_COMPARE(centre(&second), QColor(Qt::red));
+    QCOMPARE(centre(&first), QColor(Qt::black));
+}
+
+QTEST_MAIN(TransientImageTest)
+
+#include "test_transientimage.moc"
diff --git a/wallpapers/image/plugin/transientimage.cpp b/wallpapers/image/plugin/transientimage.cpp
index 53b6444..7df9a7b 100644
--- a/wallpapers/image/plugin/transientimage.cpp
+++ b/wallpapers/image/plugin/transientimage.cpp
@@ -547,6 +547,11 @@ QSGNode *TransientImage::updatePaintNode(QSGNode *oldNode, UpdatePaintNodeData *
 
 void TransientImage::releaseResources()
 {
+    if (m_texture) {
+        // The image is not kept once it is a texture, and the texture goes with the window the item leaves: read the
+        // image again for the next window it renders to.
+        m_options.reset();
+    }
     if (m_provider || m_texture) {
         window()->scheduleRenderJob(new TransientImageCleanupJob(std::move(m_texture), std::move(m_provider)), QQuickWindow::NoStage);
     }
