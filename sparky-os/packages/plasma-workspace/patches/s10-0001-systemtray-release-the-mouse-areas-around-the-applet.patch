From: Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>
Date: Wed, 18 Nov 2026 12:00:00 -0300
Subject: [PATCH] systemtray: release the mouse areas around the applet when its context menu opens

SystemTray::showPlasmoidMenu() releases the press that opened the menu (the popup takes the release, QTBUG-59044) through QQuickWindow::mouseGrabberItem().
Outside an event delivery that function answers null, with the warning "mouse grabber ambiguous: no event is currently being delivered", as soon as
several pointing devices have been in use (a touchpad beside a mouse, a compositor's virtual pointer). Then nothing is released: the tray item's MouseArea
stays pressed after the menu closes, and the next right click on the item is spent clearing that, so an applet's menu opened on every second right click only
(measured in a Plasma 6.7.4 login: 5 menus of 10 right clicks with the stock plugin, 10 of 10 with this change; the stock Clipboard and Disks & Devices
items alternate the same way).
The mouse areas of the applet's ancestors are released instead (releasemouseareas.h; an area that holds no grab is left alone), with an autotest.
Origin: ours; plasma-workspace master has the same code on 2026-11-18. Not offered to KDE (no KDE contributions for now).
Assisted-by: claude-sonnet-5-5
---
--- a/applets/systemtray/autotests/CMakeLists.txt	2026-08-04 00:28:03.000000000 -0300
+++ b/applets/systemtray/autotests/CMakeLists.txt	2026-11-18 06:04:47.203727893 -0300
@@ -2,3 +2,8 @@
     LINK_LIBRARIES systemtray_static
     Qt::Test
 )
+
+ecm_add_test(ungrabtest.cpp
+    TEST_NAME ungrabtest
+    LINK_LIBRARIES Qt::Quick Qt::Test
+)
--- a/applets/systemtray/autotests/ungrab.qml	1969-12-31 21:00:00.000000000 -0300
+++ b/applets/systemtray/autotests/ungrab.qml	2026-11-18 06:04:47.206321437 -0300
@@ -0,0 +1,12 @@
+import QtQuick
+Item {
+    width: 200; height: 100
+    property int presses: 0
+    Item {
+        anchors.fill: parent
+        MouseArea { objectName: "area"; anchors.fill: parent; acceptedButtons: Qt.AllButtons; onPressed: parent.parent.presses++ }
+        Item { anchors.fill: parent
+            Item { objectName: "applet"; anchors.fill: parent }
+        }
+    }
+}
--- a/applets/systemtray/autotests/ungrabtest.cpp	1969-12-31 21:00:00.000000000 -0300
+++ b/applets/systemtray/autotests/ungrabtest.cpp	2026-11-18 06:04:47.207321439 -0300
@@ -0,0 +1,46 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack)
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#include "../releasemouseareas.h"
+
+#include <QQuickView>
+#include <QtTest>
+
+#include <memory>
+
+// After a right press whose release never comes (the menu's popup took it), the tray item's MouseArea stays pressed; releaseMouseAreasAround() frees it,
+// and the next right press is a press again. (QtTest's synthetic devices do not reproduce the "ambiguous" answer of mouseGrabberItem(): in a Plasma login with
+// several pointing devices the old workaround released nothing and every second right click opened no menu.)
+class UngrabTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void nextPressIsNotSpent()
+    {
+        auto view = std::make_unique<QQuickView>();
+        view->setSource(QUrl::fromLocalFile(QFINDTESTDATA("ungrab.qml")));
+        QVERIFY(view->rootObject());
+        view->resize(200, 100);
+        view->show();
+        QVERIFY(QTest::qWaitForWindowExposed(view.get()));
+        QQuickItem *area = view->rootObject()->findChild<QQuickItem *>(QStringLiteral("area"));
+        QQuickItem *applet = view->rootObject()->findChild<QQuickItem *>(QStringLiteral("applet"));
+        QVERIFY(area && applet);
+
+        QTest::mousePress(view.get(), Qt::RightButton, {}, QPoint(100, 50));
+        QCOMPARE(view->rootObject()->property("presses").toInt(), 1);
+        QVERIFY(area->property("pressed").toBool());
+
+        releaseMouseAreasAround(applet);
+        QVERIFY(!area->property("pressed").toBool());
+
+        QTest::mousePress(view.get(), Qt::RightButton, {}, QPoint(100, 50));
+        QCOMPARE(view->rootObject()->property("presses").toInt(), 2);
+    }
+};
+
+QTEST_MAIN(UngrabTest)
+#include "ungrabtest.moc"
--- a/applets/systemtray/releasemouseareas.h	1969-12-31 21:00:00.000000000 -0300
+++ b/applets/systemtray/releasemouseareas.h	2026-11-18 06:04:47.187321410 -0300
@@ -0,0 +1,24 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack)
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QQuickItem>
+
+// The popup of an applet's context menu takes the mouse release, so the MouseArea of the tray item that was pressed stays pressed and the next press on it
+// is spent clearing that. QQuickWindow::mouseGrabberItem() cannot find the item outside an event delivery once several pointing devices have been in use
+// ("mouse grabber ambiguous"), so the mouse areas around the applet are released instead; one that holds no grab is left alone.
+inline void releaseMouseAreasAround(QQuickItem *item)
+{
+    for (int depth = 0; item && depth < 12; item = item->parentItem(), ++depth) {
+        const auto children = item->childItems();
+        for (QQuickItem *child : children) {
+            if (child->inherits("QQuickMouseArea")) {
+                child->ungrabMouse();
+            }
+        }
+    }
+}
--- a/applets/systemtray/systemtray.cpp	2026-08-04 00:28:03.000000000 -0300
+++ b/applets/systemtray/systemtray.cpp	2026-11-18 06:04:47.203727893 -0300
@@ -11,6 +11,7 @@
 #include "systemtray.h"
 
 #include "plasmoidregistry.h"
+#include "releasemouseareas.h"
 #include "sortedsystemtraymodel.h"
 #include "statusnotifieritemhost.h"
 #include "statusnotifieritemsource.h"
@@ -329,10 +330,9 @@
     // this causes the next click to go missing
 
     // by releasing manually we avoid that situation
+    // (QQuickWindow::mouseGrabberItem() no longer finds the item, see releasemouseareas.h)
     auto ungrabMouseHack = [appletInterface]() {
-        if (appletInterface->window() && appletInterface->window()->mouseGrabberItem()) {
-            appletInterface->window()->mouseGrabberItem()->ungrabMouse();
-        }
+        releaseMouseAreasAround(appletInterface);
     };
 
     QTimer::singleShot(0, appletInterface, ungrabMouseHack);
