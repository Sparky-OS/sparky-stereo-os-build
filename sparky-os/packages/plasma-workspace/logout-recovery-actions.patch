+void KSMShutdownDlg::slotTaskManager()
+{
+    auto *job = new KIO::ApplicationLauncherJob(KService::serviceByDesktopName(u"org.kde.plasma-systemmonitor"_s));
+    job->setUiDelegate(new KNotificationJobUiDelegate(KJobUiDelegate::AutoHandlingEnabled));
+    connect(job, &KJob::result, this, [this, job] {
+        if (!job->error()) {
+            reject();
+        }
+    });
+    job->start();
+}
+
+void KSMShutdownDlg::slotCloseFrozenWindow()
+{
+    const auto message = QDBusMessage::createMethodCall(u"org.kde.KWin"_s, u"/KWin"_s, u"org.kde.KWin"_s, u"killWindow"_s);
+    QDBusConnection::sessionBus().asyncCall(message);
+    reject();
+}
