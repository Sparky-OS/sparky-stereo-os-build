+// Sparky Stereo OS: sparky-stereo-boot's helper tells GRUB to start its anti-cheat entry once (grub-reboot, or the
+// boot package's own block where GRUB cannot write /boot/grub); polkit's org.sparkystereo.boot.restart-for-anti-cheat
+// allows it for the active local session, as logind allows a restart.
+const QString s_antiCheatHelper = u"/usr/lib/sparky-stereo-boot/anticheat-restart"_s;
+
+// "" on success, else the error name the greeter explains: pkexec exits 126 when the person did not authorize it and
+// 127 when it could not ask; the helper exits 3 when the anti-cheat start cannot be made on this computer.
+QString runAntiCheatHelper(const QString &command)
+{
+    QProcess process;
+    process.start(u"pkexec"_s, {s_antiCheatHelper, command});
+    if (!process.waitForFinished(280000) || process.exitStatus() != QProcess::NormalExit) {
+        process.kill();
+        qCWarning(PLASMA_SESSION) << "The anti-cheat restart helper did not finish:" << process.errorString();
+        return u"org.sparkystereo.Boot.Failed"_s;
+    }
+    const QString said = QString::fromUtf8(process.readAllStandardError()).trimmed();
+    switch (process.exitCode()) {
+    case 0:
+        return {};
+    case 126:
+    case 127:
+        qCWarning(PLASMA_SESSION) << "The anti-cheat restart was not authorized:" << said;
+        return u"org.freedesktop.PolicyKit1.Error.NotAuthorized"_s;
+    case 3:
+        qCWarning(PLASMA_SESSION) << "The anti-cheat restart is unavailable:" << said;
+        return u"org.freedesktop.DBus.Error.NotSupported"_s;
+    default:
+        qCWarning(PLASMA_SESSION) << "The anti-cheat restart could not be scheduled:" << process.exitCode() << said;
+        return u"org.sparkystereo.Boot.Failed"_s;
+    }
+}
