+QString Shutdown::logoutAndRebootForAntiCheat()
+{
+    if (m_logoutStarted) {
+        return u"org.kde.Shutdown.InProgress"_s;
+    }
+
+    if (!QFileInfo(u"/sys/firmware/efi"_s).isDir() || !QFileInfo(u"/var/lib/sparky-stereo-boot/anticheat.entry"_s).isFile()
+        || !QFileInfo(s_antiCheatHelper).isExecutable()) {
+        QCoreApplication::quit();
+        return u"org.freedesktop.DBus.Error.NotSupported"_s;
+    }
+
+    const QString error = runAntiCheatHelper(u"set"_s);
+    if (!error.isEmpty()) {
+        QCoreApplication::quit();
+        return error;
+    }
+
+    m_restoreAntiCheat = true;
+    startLogout(KWorkSpace::ShutdownTypeReboot);
+    return {};
+}
+
+void Shutdown::restoreAntiCheat()
+{
+    if (m_restoreAntiCheat) {
+        m_restoreAntiCheat = false;
