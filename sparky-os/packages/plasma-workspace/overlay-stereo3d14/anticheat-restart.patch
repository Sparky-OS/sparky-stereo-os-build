+}
+
+// What Easy Anti-Cheat would not accept on this computer, as sparky-stereo-boot's checker says it in the session's
+// language: every requirement that is not met or not known, so the person sees it before choosing the restart.
+void KSMShutdownDlg::readAntiCheatCheck()
+{
+    if (m_antiCheatCheckStarted) {
+        return;
+    }
+    m_antiCheatCheckStarted = true;
+    auto *process = new QProcess(this);
+    connect(process, &QProcess::finished, this, [this, process](int exitCode, QProcess::ExitStatus exitStatus) {
+        process->deleteLater();
+        QVariantList rows;
+        const QJsonDocument document = QJsonDocument::fromJson(process->readAllStandardOutput());
+        if (exitStatus != QProcess::NormalExit || exitCode > 1 || !document.isObject()) {
+            qCWarning(LOGOUT_GREETER) << "The anti-cheat check could not be read:" << exitStatus << exitCode << process->readAllStandardError();
+            rows.append(QVariantMap{{u"state"_s, u"unknown"_s}, {u"text"_s, QString()}});
+        } else {
+            const auto items = document.object().value(u"rows"_s).toArray();
+            for (const QJsonValue &item : items) {
+                const QJsonObject row = item.toObject();
+                const QString state = row.value(u"state"_s).toString();
+                // a row the anti-cheat start's own kernel line settles (lockdown, kexec) is not something Easy Anti-Cheat would refuse there
+                if (row.value(u"settledByAntiCheatStart"_s).toBool()) {
+                    continue;
+                }
+                if (state == u"not-met"_s || state == u"unknown"_s) {
+                    rows.append(QVariantMap{{u"state"_s, state}, {u"text"_s, row.value(u"text"_s).toString()}});
+                }
+            }
+        }
+        rootContext()->setContextProperty(u"antiCheatRows"_s, rows);
+    });
+    process->start(u"/usr/bin/sparky-stereo-boot"_s, {u"anticheat-check"_s, u"--json"_s});
+}
+
+void KSMShutdownDlg::slotRebootForAntiCheat()
+{
+    if (m_antiCheatRequestPending || !m_session.canRebootForAntiCheat()) {
+        return;
+    }
+
+    m_antiCheatRequestPending = true;
+    rootContext()->setContextProperty(u"antiCheatRestartPending"_s, true);
+    rootContext()->setContextProperty(u"antiCheatRestartError"_s, QString());
+    const auto message = QDBusMessage::createMethodCall(u"org.kde.Shutdown"_s, u"/Shutdown"_s, u"org.kde.Shutdown"_s, u"logoutAndRebootForAntiCheat"_s);
+    // an authentication dialog may stand between the request and its answer
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message, 300000), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        const QDBusPendingReply<QString> reply = *watcher;
+        watcher->deleteLater();
+        const QString error = reply.isError() ? reply.error().name() : reply.value();
+        if (error.isEmpty()) {
+            accept();
+            return;
+        }
+
+        m_antiCheatRequestPending = false;
+        rootContext()->setContextProperty(u"antiCheatRestartPending"_s, false);
+        rootContext()->setContextProperty(u"antiCheatRestartError"_s, error);
+    });
+}
