+        // Plasma 6 writes Qt 6 font strings (QFont::toString): 16 fields or more, the weight on the OpenType
+        // scale. Qt 4 and Qt 5 wrote 10 or 11 fields, the weight on Qt's legacy scale. Qt 6's QFont::fromString
+        // tells the two forms apart by the same count
+        const bool openTypeWeight( std::count( value.begin(), value.end(), ',' ) + 1 >= 16 );
