 #include <sstream>
 #include <vector>
 
@@ -27,6 +29,26 @@
 {
 
     //_____________________________________________
+    // an OpenType weight (Qt 6, Normal is 400) on Qt's legacy scale (Qt 4 and 5, Normal is 50): the closest
+    // of Qt 6's weights, with the table and the search of Qt 6's qt_openTypeToLegacyWeight (qfont.cpp)
+    static int legacyWeight( int openTypeWeight )
+    {
+        static const int map[][2] = {
+            { 100, 0 }, { 200, 12 }, { 300, 25 }, { 400, 50 }, { 500, 57 },
+            { 600, 63 }, { 700, 75 }, { 800, 81 }, { 900, 87 } };
+        int closest( map[0][1] );
+        int distance( std::abs( openTypeWeight - map[0][0] ) );
+        for( unsigned int index = 1; index < sizeof( map )/sizeof( map[0] ); ++index )
+        {
+            const int local( std::abs( openTypeWeight - map[index][0] ) );
+            if( local >= distance ) break;
+            closest = map[index][1];
+            distance = local;
+        }
+        return closest;
+    }
