     //_________________________________________________________
+    // add an XDG base directory, or a folder in it, to a path list, most important first: the base
+    // directory specification ignores relative paths, and a folder already listed is not listed again
+    static void addXdgDirectory( PathList& out, const char* base, const char* folder = "" )
+    {
+        if( !base || base[0] != '/' ) return;
+        std::string path( base );
+        while( !path.empty() && path[path.size()-1] == '/' ) path.erase( path.size()-1 );
+        path += folder;
+        path += '/';
+        if( std::find( out.begin(), out.end(), path ) == out.end() ) out.push_back( path );
+    }
+
