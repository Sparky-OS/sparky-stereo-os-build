#!/bin/bash
# Created by Paweł "pavroo" Pijanowski and Daniel Ramos (Capitain Jack) 2026/10/03
# Copyright 2026 under the GNU GPL3 License
# Last update 2026/10/10
set -euo pipefail
if ((EUID != 0)); then echo 'Run as root (use the Hardware Setup menu entry).'; exit 1; fi
export LC_ALL=C.UTF-8
SHARE=/usr/share/sparky/sparky-stereo-hardware
LIB=/usr/lib/sparky-stereo-hardware
# Used by the sourced action functions; production always targets the live root.
# shellcheck disable=SC2034
ROOT=
fixture=
dry=false
auto=false
rig_driver=
while (($#)); do
	case "$1" in
		--auto) auto=true ;;
		--dry-run) dry=true ;;
		--fixture) shift; fixture=${1:?Missing fixture directory} ;;
		--rig-driver) shift; rig_driver=${1:?Missing rig driver package} ;;
		--help) echo 'sparky-stereo-hardware [--auto] [--dry-run] [--fixture DIRECTORY] [--rig-driver PACKAGE]'; exit 0 ;;
		*) echo "Unknown option: $1" >&2; exit 2 ;;
	esac
	shift
done
case "$rig_driver" in ''|hid-tmff2-dkms|hid-fanatecff-dkms|new-lg4ff-dkms) ;; *) echo 'Unknown rig driver' >&2; exit 2 ;; esac
if [[ -n "$fixture" ]] && ! $dry; then echo 'Fixtures require --dry-run' >&2; exit 2; fi
if [[ -e /.dockerenv && -z "$fixture" ]]; then
	echo 'In a container use --fixture DIRECTORY --dry-run; hardware probing is disabled.' >&2
	exit 2
fi
# shellcheck source=../lib/actions.sh
source "$LIB/actions.sh"
source "$SHARE/cuda-key.sh"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
if ! $dry; then
	mkdir -p /var/log/sparky-stereo-hardware /run/lock
	exec 9>/run/lock/sparky-stereo-hardware.lock
	flock -n 9 || { echo 'Hardware setup is already running'; exit 1; }
	LOG=/var/log/sparky-stereo-hardware/$(date +%Y%m%d-%H%M%S)-$$.log
	exec > >(tee -a "$LOG") 2>&1
	log "Log: $LOG"
fi
if [[ -n "$fixture" ]]; then
	FACTS=$fixture
else
	FACTS=$WORK
	run lspci -Dnnv >"$FACTS/lspci"
	run lsusb >"$FACTS/lsusb"
	cp /proc/cpuinfo "$FACTS/cpuinfo"
	if laptop-detect; then echo 0 >"$FACTS/laptop"; else
		status=$?
		[[ $status == 1 ]] || { log "ERROR laptop-detect returned $status"; exit 1; }
		echo 1 >"$FACTS/laptop"
	fi
	dpkg --print-architecture >"$FACTS/architecture"
	# CPU level: the loader's own list (lines marked "supported, searched"); board: DMI
	if [[ -x /lib64/ld-linux-x86-64.so.2 ]]; then /lib64/ld-linux-x86-64.so.2 --help >"$FACTS/ldso-help" 2>&1 || :; fi
	for file in board_vendor board_name; do
		if [[ -r /sys/class/dmi/id/$file ]]; then cat "/sys/class/dmi/id/$file" >"$FACTS/dmi-${file//_/-}"; fi
	done
	: >"$FACTS/hid-uevents"
	for file in /sys/bus/hid/devices/*/uevent; do
		[[ ! -f "$file" ]] || cat "$file" >>"$FACTS/hid-uevents"
	done
	: >"$FACTS/input-properties"
	for file in /sys/class/input/event*; do
		[[ ! -e "$file" ]] || udevadm info --query=property --path="$file" >>"$FACTS/input-properties"
	done
	if isenkram-autoinstall-firmware -l >"$FACTS/firmware-packages" 2>"$WORK/isenkram.log"; then :; else
		status=$?
		if [[ $status != 1 ]] || ! grep -q 'did not find any firmware files' "$WORK/isenkram.log"; then
			cat "$WORK/isenkram.log"; log "ERROR isenkram returned $status"; exit 1
		fi
	fi
	cat "$WORK/isenkram.log"
	nvidia-detect >"$FACTS/nvidia-detect" 2>&1 || log 'nvidia-detect could not recommend a driver; use the edition compatibility table'
fi
python3 "$LIB/detect.py" "$FACTS" "$SHARE" >"$WORK/plan"
if [[ -n "$rig_driver" ]]; then
	if ! awk -F '\t' -v package="$rig_driver" '($1 == "candidate" || $1 == "package") && $2 == package {found=1} END {exit !found}' "$WORK/plan"; then
		log "No detected rig matches $rig_driver"; exit 2
	fi
	printf 'package\t%s\n' "$rig_driver" >>"$WORK/plan"
fi
cat "$WORK/plan"
log 'nvidia-detect report:'
cat "$FACTS/nvidia-detect"
if $dry; then
	log 'DRY RUN: no packages, repositories, configuration or hardware probes changed'
	log 'Sensors: would run sensors-detect --auto, persist and load its modules, verify sensors -u'
	if [[ -f "$FACTS/sensors-detect" ]]; then
		log 'Fixture sensor module recommendations:'
		sensor_modules "$FACTS/sensors-detect"
	fi
	if grep -Fxq $'action\tnvidia-open' "$WORK/plan"; then
		log 'Would configure CUDA debian13/x86_64 Signed-By key and origin pin 1002'
		nvidia_version=$(apt-cache show --no-all-versions nvidia-kernel-open-dkms-stereo3d 2>/dev/null | sed -n 's/^Version: \(.*\)+stereo3d[0-9]*$/\1/p' | head -n1)
		log "Would install nvidia-driver=${nvidia_version:-<module version>} nvidia-kernel-open-dkms-stereo3d by name"
	fi
	exit 0
fi
if ! $auto; then
	source "$SHARE/en"
	locale_code=$(sed -nE 's/^LANG=["\x27]?([a-z]{2}_[A-Z]{2})(\.[^"\x27]*)?["\x27]?$/\1/p' /etc/default/locale 2>/dev/null || true)
	case "$locale_code" in
		pl_PL) source "$SHARE/pl" ;;
		pt_BR) source "$SHARE/pt_BR" ;;
	esac
	yad --text-info --title="$LOCAL1" --filename="$WORK/plan" --width=760 --height=500 --button="$LOCAL2:1" --button="$LOCAL3:0" || exit 0
	# The child owns the execution lock; release it before launching the visible terminal.
	flock -u 9
	exec env SHELL=/bin/bash sparky-xterm "/usr/bin/sparky-stereo-hardware --auto ${rig_driver:+--rig-driver $rig_driver}"
fi
mapfile -t packages < <(awk -F '\t' '$1 == "package" {print $2}' "$WORK/plan")
for package in "${packages[@]}"; do
	case "$package" in
		task-laptop) apt_install --install-recommends "$package" ;;
		power-profiles-daemon|thermald) apt_install "$package" ;;
	esac
done
if [[ -s "$FACTS/firmware-packages" ]]; then
	run env DEBIAN_FRONTEND=noninteractive isenkram-autoinstall-firmware
else
	log 'No missing firmware packages matched by isenkram'
fi
for package in "${packages[@]}"; do
	case "$package" in amd64-microcode|intel-microcode) apt_install "$package" ;; esac
done
failed=0
amdgpu_actions=()
if grep -Fxq $'action\tamdgpu-dpm' "$WORK/plan"; then amdgpu_actions+=(amdgpu_dpm); fi
if grep -Fxq $'action\tamdgpu-panel' "$WORK/plan"; then amdgpu_actions+=(amdgpu_panel_power); fi
if ((${#amdgpu_actions[@]})); then setup_amdgpu "${amdgpu_actions[@]}" || failed=1; fi
setup_sensors || failed=1
if printf '%s\n' "${packages[@]}" | grep -Fxq firmware-nvidia-graphics; then
	apt_install firmware-nvidia-graphics
	if grep -Fxq $'action\tnvidia-open' "$WORK/plan"; then setup_nvidia || failed=1; fi
fi
if grep -Fxq $'action\tcreative-msi' "$WORK/plan"; then
	apt_install firmware-creative-stereo
	setup_creative || failed=1
fi
for package in "${packages[@]}"; do
	case "$package" in
		evdi-dkms|xpadneo-dkms|steam-devices|sparky-sim-hidraw) apt_install "$package" ;;
		hid-tmff2-dkms|hid-fanatecff-dkms|new-lg4ff-dkms) setup_rig_driver "$package" || failed=1 ;;
	esac
done
log "Hardware setup finished, errors=$failed. Firmware and driver changes may need a reboot."
exit "$failed"
