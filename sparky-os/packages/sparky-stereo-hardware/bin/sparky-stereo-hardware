#!/bin/bash
# Created by Paweł "pavroo" Pijanowski and Daniel Ramos (Capitain Jack) 2026/10/03
# Copyright 2026 under the GNU GPL3 License
# Last update 2026/11/03
# Nothing is replaced by something else behind the person's back: a step that fails says what failed, why and what to do
# (ERROR lines, a summary at the end, the same in a window when the menu started it) and the setup exits non-zero; another
# path, nouveau instead of the edition's NVIDIA driver, is only the person's own choice (--nvidia nouveau, or the plan
# window's button). Daniel, 2026-11-01: "either it works or not and the user must know". The edition's NVIDIA driver is the
# one for the card: its open modules with HDMI 3D on Turing and newer, NVIDIA's 580 driver on Maxwell, Pascal and Volta.
set -Eeuo pipefail
if ((EUID != 0)); then echo 'Run as root (use the Hardware Setup menu entry).'; exit 1; fi
export LC_ALL=C.UTF-8
SHARE=/usr/share/sparky/sparky-stereo-hardware
LIB=/usr/lib/sparky-stereo-hardware
# Used by the sourced action functions; production always targets the live root.
# shellcheck disable=SC2034
ROOT=
fixture=
dry=false
auto=false
rig_driver=
nvidia_choice=edition
while (($#)); do
	case "$1" in
		--auto) auto=true ;;
		--dry-run) dry=true ;;
		--fixture) shift; fixture=${1:?Missing fixture directory} ;;
		--rig-driver) shift; rig_driver=${1:?Missing rig driver package} ;;
		--nvidia) shift; nvidia_choice=${1:?Missing NVIDIA choice: edition or nouveau} ;;
		--help) echo 'sparky-stereo-hardware [--auto] [--dry-run] [--fixture DIRECTORY] [--rig-driver PACKAGE] [--nvidia edition|nouveau]'
			echo '  --nvidia edition (the default): the edition'"'"'s NVIDIA driver for the card: its open modules with HDMI 3D on Turing and newer, NVIDIA'"'"'s 580 driver on Maxwell, Pascal and Volta'
			echo '  --nvidia nouveau: keep nouveau'
			exit 0 ;;
		*) echo "Unknown option: $1" >&2; exit 2 ;;
	esac
	shift
done
case "$rig_driver" in ''|hid-tmff2-dkms|hid-fanatecff-dkms|new-lg4ff-dkms) ;; *) echo 'Unknown rig driver' >&2; exit 2 ;; esac
case "$nvidia_choice" in edition|nouveau) ;; *) echo 'The NVIDIA choice is edition (the default: the edition'"'"'s driver with HDMI 3D) or nouveau' >&2; exit 2 ;; esac
if [[ -n "$fixture" ]] && ! $dry; then echo 'Fixtures require --dry-run' >&2; exit 2; fi
if [[ -e /.dockerenv && -z "$fixture" ]]; then
	echo 'In a container use --fixture DIRECTORY --dry-run; hardware probing is disabled.' >&2
	exit 2
fi
# shellcheck source=../lib/actions.sh
source "$LIB/actions.sh"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
# Started from the menu (not --auto, not a dry run), the person has no terminal: what fails is shown in a window too.
if ! $auto && ! $dry; then export SPARKY_STEREO_HARDWARE_GUI=1; fi
# stop_run: the end of a run that cannot go on: its errors, in a window too when the menu started it, and exit 1
stop_run() {
	finish_run "${LOG:-}" 1 || exit 1
	exit 1
}
# An unexpected failure of a command stops the setup (set -e); it is said, with where, and the log's place. set -E carries
# the trap into functions, where set -e alone would end the setup without a word; in a subshell (a command substitution)
# the trap only ends that subshell, so the command that used it fails and is said once, by the setup itself.
trap 'if ((BASHPID != $$)); then exit 1; fi; trap - ERR; err 50 "$LINENO" "$BASH_COMMAND" "${LOG:-the output above}"; stop_run' ERR
if ! $dry; then
	mkdir -p /var/log/sparky-stereo-hardware /run/lock
	exec 9>/run/lock/sparky-stereo-hardware.lock
	flock -n 9 || { echo 'Hardware setup is already running'; exit 1; }
	LOG=/var/log/sparky-stereo-hardware/$(date +%Y%m%d-%H%M%S)-$$.log
	exec > >(tee -a "$LOG") 2>&1
	log "Log: $LOG"
fi
if [[ -n "$fixture" ]]; then
	FACTS=$fixture
else
	FACTS=$WORK
	run lspci -Dnnv >"$FACTS/lspci"
	run lsusb >"$FACTS/lsusb"
	cp /proc/cpuinfo "$FACTS/cpuinfo"
	if laptop-detect; then echo 0 >"$FACTS/laptop"; else
		status=$?
		[[ $status == 1 ]] || { err 53 "$status"; stop_run; }
		echo 1 >"$FACTS/laptop"
	fi
	dpkg --print-architecture >"$FACTS/architecture"
	# CPU level: the loader's own list (lines marked "supported, searched"); board: DMI
	if [[ -x /lib64/ld-linux-x86-64.so.2 ]] && ! /lib64/ld-linux-x86-64.so.2 --help >"$FACTS/ldso-help" 2>&1; then
		rm -f "$FACTS/ldso-help"
		log 'NOTE the loader did not list its CPU levels (ld-linux-x86-64.so.2 --help failed), so the plan names no CPU level'
	fi
	for file in board_vendor board_name; do
		if [[ -r /sys/class/dmi/id/$file ]]; then cat "/sys/class/dmi/id/$file" >"$FACTS/dmi-${file//_/-}"; fi
	done
	: >"$FACTS/hid-uevents"
	for file in /sys/bus/hid/devices/*/uevent; do
		[[ ! -f "$file" ]] || cat "$file" >>"$FACTS/hid-uevents"
	done
	: >"$FACTS/input-properties"
	for file in /sys/class/input/event*; do
		[[ ! -e "$file" ]] || udevadm info --query=property --path="$file" >>"$FACTS/input-properties"
	done
	if isenkram-autoinstall-firmware -l >"$FACTS/firmware-packages" 2>"$WORK/isenkram.log"; then :; else
		status=$?
		if [[ $status != 1 ]] || ! grep -q 'did not find any firmware files' "$WORK/isenkram.log"; then
			cat "$WORK/isenkram.log"; err 54 "$status"; stop_run
		fi
	fi
	cat "$WORK/isenkram.log"
	nvidia-detect >"$FACTS/nvidia-detect" 2>&1 || log 'nvidia-detect could not recommend a driver; use the edition compatibility table'
fi
python3 "$LIB/detect.py" "$FACTS" "$SHARE" >"$WORK/plan"
if [[ -n "$rig_driver" ]]; then
	if ! awk -F '\t' -v package="$rig_driver" '($1 == "candidate" || $1 == "package") && $2 == package {found=1} END {exit !found}' "$WORK/plan"; then
		log "No detected rig matches $rig_driver"; exit 2
	fi
	printf 'package\t%s\n' "$rig_driver" >>"$WORK/plan"
fi
cat "$WORK/plan"
log 'nvidia-detect report:'
cat "$FACTS/nvidia-detect"
if $dry; then
	log 'DRY RUN: no packages, repositories, configuration or hardware probes changed'
	log 'Sensors: would run sensors-detect --auto, persist and load its modules, verify sensors -u'
	if [[ -f "$FACTS/sensors-detect" ]]; then
		log 'Fixture sensor module recommendations:'
		sensor_modules "$FACTS/sensors-detect"
	fi
	if grep -Fxq $'action\tnvidia-open' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "Would keep nouveau for the NVIDIA graphics, as chosen (--nvidia nouveau): the edition's NVIDIA driver with HDMI 3D would not be installed"
		elif ! module_info=$(apt-cache show --no-all-versions nvidia-kernel-open-dkms-stereo3d 2>/dev/null) || [[ -z $module_info ]]; then
			log "Would stop with an ERROR: apt finds no nvidia-kernel-open-dkms-stereo3d, the edition's NVIDIA module, in the configured repositories"
		else
			nvidia_version=$(nvidia_version_of "$(sed -n 's/^Version: //p' <<<"$module_info" | head -n1)")
			log "Would install sparky-stereo-nvidia-driver-lock and sparky-stereo-cuda-repo (NVIDIA's CUDA repository and its pins) first, the repository only where none is configured for NVIDIA's URI"
			if [[ -n $nvidia_version ]]; then
				log "Would install nvidia-driver=$nvidia_version nvidia-kernel-open-dkms-stereo3d libnvcuvid1=$nvidia_version nvidia-vaapi-driver by name"
				! foreign_i386 || log "Would install nvidia-driver-libs:i386=$nvidia_version libcuda1:i386=$nvidia_version with them (dpkg has i386: NVIDIA's libraries for 32-bit programs)"
			else
				log "Would stop with an ERROR: the module's version has no +stereo3dN suffix, so the NVIDIA driver version it is built for is unknown"
			fi
		fi
	fi
	if grep -Fxq $'action\tnvidia-legacy-580xx' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "Would keep nouveau for the NVIDIA graphics, as chosen (--nvidia nouveau), with the edition's HDMI 3D: NVIDIA's 580 driver would not be installed"
		elif ! module_info=$(apt-cache show --no-all-versions nvidia-legacy-580xx-kernel-dkms 2>/dev/null) || [[ -z $module_info ]]; then
			log "Would stop with an ERROR: apt finds no nvidia-legacy-580xx-kernel-dkms, the edition's build of NVIDIA's 580 driver, in the configured repositories"
		else
			module_version=$(sed -n 's/^Version: //p' <<<"$module_info" | head -n1)
			nvidia_version=$(nvidia_version_of "$module_version" sparky)
			log "Would install sparky-stereo-nvidia-legacy-580xx-driver-lock and sparky-stereo-cuda-repo (NVIDIA's CUDA repository and its pins, for NVIDIA's EGL platform libraries) first, the repository only where none is configured for NVIDIA's URI"
			if [[ -n $nvidia_version ]]; then
				# the edition carries NVIDIA's 580 user space at the module's own version
				log "Would install nvidia-driver=$module_version nvidia-legacy-580xx-kernel-dkms libnvcuvid1=$module_version nvidia-vaapi-driver by name, downgrades allowed (a newer NVIDIA user space goes back to 580, and the open modules go)"
				! foreign_i386 || log "Would install nvidia-driver-libs:i386=$module_version libcuda1:i386=$module_version with them (dpkg has i386: NVIDIA's libraries for 32-bit programs)"
			else
				log "Would stop with an ERROR: the module's version has no +sparkyN suffix, so the NVIDIA driver version it is built for is unknown"
			fi
		fi
	fi
	exit 0
fi

if ! $auto; then
	load_strings
	# The plan, and the person's answer: install it, install it but keep nouveau for the NVIDIA graphics (offered only when
	# the plan installs the edition's NVIDIA driver), or cancel. yad gives 1 for Cancel and 252 for a closed window; any
	# other code means the window itself failed, which is said, never taken as an answer.
	buttons=(--button="$LOCAL2:1")
	if grep -Eq $'^action\tnvidia-(open|legacy-580xx)$' "$WORK/plan"; then buttons+=(--button="$LOCAL4:2"); fi
	buttons+=(--button="$LOCAL3:0")
	# A Maxwell, Pascal or Volta card has two drivers that give different results: both are said above the plan, in the
	# person's language, with the default marked and why (LOCAL8; its @INSTALL@ and @BUTTON@ are the two buttons' labels).
	explain=()
	if grep -Fxq $'action\tnvidia-legacy-580xx' "$WORK/plan"; then
		text=${LOCAL8//@INSTALL@/$LOCAL3}
		explain=(--text="${text//@BUTTON@/$LOCAL4}")
	fi
	answer=0
	yad --text-info --title="$LOCAL1" --filename="$WORK/plan" --width=760 --height=500 "${explain[@]}" "${buttons[@]}" || answer=$?
	case $(plan_answer "$answer") in
		edition) ;;
		nouveau) nvidia_choice=nouveau ;;
		cancel) log 'Hardware Setup cancelled; nothing was changed'; exit 0 ;;
		*) err 52 "$answer"; stop_run ;;
	esac
	# The child owns the execution lock; release it before launching the visible terminal.
	flock -u 9
	exec env SHELL=/bin/bash SPARKY_STEREO_HARDWARE_GUI=1 sparky-xterm "/usr/bin/sparky-stereo-hardware --auto --nvidia $nvidia_choice ${rig_driver:+--rig-driver $rig_driver}"
fi
failed=0
# install_step PACKAGE... [OPTION...]: apt installs them, or the failure is said and counted; the setup goes on with the
# steps that do not need them
install_step() {
	if ! apt_install "$@"; then
		err 47 "$(printf '%s ' "$@" | sed 's/--[a-z-]* //g; s/ $//')"
		failed=1
	fi
}
mapfile -t packages < <(awk -F '\t' '$1 == "package" {print $2}' "$WORK/plan")
for package in "${packages[@]}"; do
	case "$package" in
		task-laptop) install_step --install-recommends "$package" ;;
		power-profiles-daemon|thermald) install_step "$package" ;;
	esac
done
if [[ -s "$FACTS/firmware-packages" ]]; then
	if ! run env DEBIAN_FRONTEND=noninteractive isenkram-autoinstall-firmware; then
		err 48 "$(tr '\n' ' ' <"$FACTS/firmware-packages" | sed 's/ $//')"
		failed=1
	fi
else
	log 'No missing firmware packages matched by isenkram'
fi
for package in "${packages[@]}"; do
	case "$package" in amd64-microcode|intel-microcode) install_step "$package" ;; esac
done
amdgpu_actions=()
if grep -Fxq $'action\tamdgpu-dpm' "$WORK/plan"; then amdgpu_actions+=(amdgpu_dpm); fi
if grep -Fxq $'action\tamdgpu-panel' "$WORK/plan"; then amdgpu_actions+=(amdgpu_panel_power); fi
if ((${#amdgpu_actions[@]})); then setup_amdgpu "${amdgpu_actions[@]}" || failed=1; fi
setup_sensors || failed=1
if printf '%s\n' "${packages[@]}" | grep -Fxq firmware-nvidia-graphics; then
	# nouveau's firmware, for the driver the card runs on now (and until a reboot into NVIDIA's driver)
	install_step firmware-nvidia-graphics
	if grep -Fxq $'action\tnvidia-open' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "NVIDIA: nouveau stays, as you chose (--nvidia nouveau), so the edition's NVIDIA driver with HDMI 3D was not installed. Run Hardware Setup again without that choice to install it"
		else
			setup_nvidia || failed=1
		fi
	fi
	if grep -Fxq $'action\tnvidia-legacy-580xx' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "NVIDIA: nouveau stays, as you chose (--nvidia nouveau), with the edition's HDMI 3D, so NVIDIA's 580 driver was not installed. Run Hardware Setup again without that choice to install it"
		else
			setup_nvidia legacy-580xx || failed=1
		fi
	fi
fi
if grep -Fxq $'action\tcreative-msi' "$WORK/plan"; then
	install_step firmware-creative-stereo
	setup_creative || failed=1
fi
for package in "${packages[@]}"; do
	case "$package" in
		evdi-dkms|xpadneo-dkms|steam-devices|sparky-sim-hidraw) install_step "$package" ;;
		hid-tmff2-dkms|hid-fanatecff-dkms|new-lg4ff-dkms) setup_rig_driver "$package" || failed=1 ;;
	esac
done
# The OpenGL stereo default follows the card the desktop runs on; a driver installed now
# binds at the next boot, when sparky-stereo-opengl-default.service writes it again.
if ! run /usr/bin/sparky-stereo-opengl-default; then
	err 49
	failed=1
fi
trap - ERR
finish_run "$LOG" "$failed"
