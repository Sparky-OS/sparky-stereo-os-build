#!/bin/bash
# Created by Paweł "pavroo" Pijanowski and Daniel Ramos (Capitain Jack) 2026/10/03
# Copyright 2026 under the GNU GPL3 License
# Last update 2026/11/25
# Nothing is replaced by something else behind the person's back: a step that fails says what failed, why and what to do
# (ERROR lines, a summary at the end, the same in a window when the menu started it) and the setup exits non-zero; another
# path, nouveau instead of the edition's NVIDIA driver, is only the person's own choice (--nvidia nouveau, or the plan
# window's button). Daniel, 2026-11-01: "either it works or not and the user must know". The edition's NVIDIA driver is the
# one for the card: its open modules with HDMI 3D on Turing and newer, NVIDIA's 580 driver on Maxwell, Pascal and Volta.
set -Eeuo pipefail
if ((EUID != 0)); then echo 'Run as root (use the Hardware Setup menu entry).'; exit 1; fi
SHARE=/usr/share/sparky/sparky-stereo-hardware
LIB=/usr/lib/sparky-stereo-hardware
# Used by the sourced action functions; production always targets the live root.
# shellcheck disable=SC2034
ROOT=
fixture=
dry=false
auto=false
rig_driver=
nvidia_choice=edition
wl_option=
kernel_choice=
nvidia_only=false
nvidia_said=false
while (($#)); do
	case "$1" in
		--auto) auto=true ;;
		--dry-run) dry=true ;;
		--fixture) shift; fixture=${1:?Missing fixture directory} ;;
		--rig-driver) shift; rig_driver=${1:?Missing rig driver package} ;;
		--broadcom-wl) shift; wl_option=${1:?Missing --broadcom-wl value: ask, yes, no, repair, reset, swap or back} ;;
		--kernel) shift; kernel_choice=${1:?Missing --kernel value: v3 or base} ;;
		--nvidia) shift; nvidia_choice=${1:?Missing NVIDIA choice: edition or nouveau}; nvidia_said=true ;;
		# only the NVIDIA step of the run: the edition's driver for a card this machine has not shown before (ORDER 675)
		--nvidia-only) nvidia_only=true ;;
		# the same, kept and said by the engine (the Repair of the problem the card's step keeps)
		--nvidia-card) exec "$LIB/nvidia-card" install ;;
		# NVIDIA's i386 libraries at the installed driver's version, for i386 enabled after the driver (the Repair of the
		# problem dpkg's hook keeps; ORDER 363)
		--nvidia-i386) exec "$LIB/nvidia-i386" install ;;
		# packages built for a processor level above this one's, installed again so apt takes the baseline build (the Repair of the notice, ORDER 108)
		--variants) exec "$LIB/variant-check" repair ;;
		--help) echo 'sparky-stereo-hardware [--auto] [--dry-run] [--fixture DIRECTORY] [--rig-driver PACKAGE] [--nvidia edition|nouveau] [--nvidia-only] [--nvidia-card] [--nvidia-i386] [--broadcom-wl ask|yes|no|repair|reset|swap|back] [--kernel v3|base] [--variants]'
			echo '  --nvidia-card: the edition'"'"'s NVIDIA driver for an NVIDIA graphics card found on this computer, kept and said by sparky-stereo-problems; on a computer without such a card NVIDIA'"'"'s driver is not installed (the image'"'"'s copy is removed once, at the first start)'
			echo '  --auto --nvidia-only: only the NVIDIA step of the setup'
			echo '  --variants: install again the packages built for an x86-64 level above this processor, so apt takes the baseline build'
			echo '  --kernel base: keep the baseline kernel only on an x86-64-v3 processor (the choice is kept for this machine; nothing is removed); --kernel v3: install the x86-64-v3 kernel again, the default on such a processor'
			echo '  --nvidia edition (the default): the edition'"'"'s NVIDIA driver for the card: its open modules with HDMI 3D on Turing and newer, NVIDIA'"'"'s 580 driver on Maxwell, Pascal and Volta'
			echo '  --nvidia nouveau: keep nouveau'
			echo '  --nvidia-i386: only NVIDIA'"'"'s 32-bit libraries (nvidia-driver-libs:i386, libcuda1:i386) at the installed driver'"'"'s version, where dpkg has i386'
			echo '  --broadcom-wl ask: for a Broadcom Wi-Fi card no driver of the kernel drives (BCM4360, BCM4352): show Broadcom'"'"'s licence and install Debian'"'"'s unmodified broadcom-sta-dkms (wl) only on your yes'
			echo '  --broadcom-wl yes: you have read the licence (it is printed) and accept it: install; no: Not now (kept for this machine); repair: go on with what you accepted; reset: be asked again'
			echo '  --broadcom-wl swap: for a Broadcom Wi-Fi card that a free driver of the kernel drives (b43 on a BCM4331) and wl drives too: show Broadcom'"'"'s licence and, on your yes, give the card to wl (undone if a step fails); back: give it to the kernel'"'"'s driver again (broadcom-sta-dkms is purged)'
			echo '  Alone, --broadcom-wl does only this step; with --auto it is one step of the run'
			exit 0 ;;
		*) echo "Unknown option: $1" >&2; exit 2 ;;
	esac
	shift
done
# Detection and plan parsing use stable output; Repair above keeps the person's language.
export LC_ALL=C.UTF-8
case "$wl_option" in ''|ask|yes|no|repair|reset|swap|back) ;; *) echo 'The Broadcom Wi-Fi choice is ask, yes, no, repair, reset, swap or back' >&2; exit 2 ;; esac
case "$kernel_choice" in ''|v3|base) ;; *) echo 'The kernel choice is v3 (the default on an x86-64-v3 processor) or base' >&2; exit 2 ;; esac
case "$rig_driver" in ''|hid-tmff2-dkms|hid-fanatecff-dkms|new-lg4ff-dkms) ;; *) echo 'Unknown rig driver' >&2; exit 2 ;; esac
case "$nvidia_choice" in edition|nouveau) ;; *) echo 'The NVIDIA choice is edition (the default: the edition'"'"'s driver with HDMI 3D) or nouveau' >&2; exit 2 ;; esac
if [[ -n "$fixture" ]] && ! $dry; then echo 'Fixtures require --dry-run' >&2; exit 2; fi
if [[ -e /.dockerenv && -z "$fixture" ]]; then
	echo 'In a container use --fixture DIRECTORY --dry-run; hardware probing is disabled.' >&2
	exit 2
fi
# shellcheck source=../lib/actions.sh
source "$LIB/actions.sh"
# shellcheck source=../lib/broadcom-wl.sh
source "$LIB/broadcom-wl.sh"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
# --broadcom-wl alone does only the Wi-Fi driver's step (with --auto it is one step of the run); reset only forgets Not now
wl_only=false
if [[ -n $wl_option ]] && ! $auto; then wl_only=true; fi
if [[ $wl_option == reset ]]; then
	wl_reset
	echo 'Broadcom Wi-Fi: Not now is forgotten; the next Hardware Setup asks again'
	exit 0
fi
# Started from the menu (not --auto, not a dry run), the person has no terminal: what fails is shown in a window too.
if ! $auto && ! $dry && ! $wl_only; then export SPARKY_STEREO_HARDWARE_GUI=1; fi
# stop_run: the end of a run that cannot go on: its errors, in a window too when the menu started it, and exit 1
stop_run() {
	finish_run "${LOG:-}" 1 || exit 1
	exit 1
}
# An unexpected failure of a command stops the setup (set -e); it is said, with where, and the log's place. set -E carries
# the trap into functions, where set -e alone would end the setup without a word; in a subshell (a command substitution)
# the trap only ends that subshell, so the command that used it fails and is said once, by the setup itself.
trap 'if ((BASHPID != $$)); then exit 1; fi; trap - ERR; err 50 "$LINENO" "$BASH_COMMAND" "${LOG:-the output above}"; stop_run' ERR
if ! $dry; then
	mkdir -p /var/log/sparky-stereo-hardware /run/lock
	exec 9>/run/lock/sparky-stereo-hardware.lock
	flock -n 9 || { echo 'Hardware setup is already running'; exit 1; }
	LOG=/var/log/sparky-stereo-hardware/$(date +%Y%m%d-%H%M%S)-$$.log
	exec > >(tee -a "$LOG") 2>&1
	log "Log: $LOG"
fi
KERNEL_MARK=/var/lib/sparky-stereo-hardware/kernel-base
if [[ -n $kernel_choice ]] && ! $dry; then
	# the person's choice for this machine: base keeps only the baseline kernel from now on (nothing installed is removed)
	if [[ $kernel_choice == base ]]; then
		mkdir -p "${KERNEL_MARK%/*}" && : >"$KERNEL_MARK"
		log 'Kernel: the baseline kernel only, as chosen; the x86-64-v3 kernel is not installed again. An installed one stays until you remove it (apt remove linux-image-sparky-stereo-v3). --kernel v3 undoes this'
	else
		rm -f "$KERNEL_MARK"
		log 'Kernel: the x86-64-v3 kernel is installed again on an x86-64-v3 processor by the next Hardware Setup'
	fi
	$auto || exit 0
fi
if [[ -n "$fixture" ]]; then
	FACTS=$fixture
else
	FACTS=$WORK
	run lspci -Dnnv >"$FACTS/lspci"
	run lsusb >"$FACTS/lsusb"
	cp /proc/cpuinfo "$FACTS/cpuinfo"
	if laptop-detect; then echo 0 >"$FACTS/laptop"; else
		status=$?
		[[ $status == 1 ]] || { err 53 "$status"; stop_run; }
		echo 1 >"$FACTS/laptop"
	fi
	dpkg --print-architecture >"$FACTS/architecture"
	[[ ! -e $KERNEL_MARK ]] || echo base >"$FACTS/kernel-choice"
	# CPU level: the loader's own list (lines marked "supported, searched"); board: DMI
	if [[ -x /lib64/ld-linux-x86-64.so.2 ]] && ! /lib64/ld-linux-x86-64.so.2 --help >"$FACTS/ldso-help" 2>&1; then
		rm -f "$FACTS/ldso-help"
		log 'NOTE the loader did not list its CPU levels (ld-linux-x86-64.so.2 --help failed), so the plan names no CPU level'
	fi
	for file in board_vendor board_name; do
		if [[ -r /sys/class/dmi/id/$file ]]; then cat "/sys/class/dmi/id/$file" >"$FACTS/dmi-${file//_/-}"; fi
	done
	# OpenLinkHub (not in Debian; the edition's package of upstream's program) owns the Corsair hubs, coolers, lighting nodes and power supplies it shares with OpenRGB and liquidctl (ORDER 108)
	# upstream's own install (its scripts put the program in /opt and the unit in /etc) is the person's: the package openlinkhub is not planned beside it
	if [[ -e /etc/systemd/system/OpenLinkHub.service || -e /usr/lib/systemd/system/OpenLinkHub.service || -e /opt/OpenLinkHub ]]; then echo yes >"$FACTS/openlinkhub"; else echo no >"$FACTS/openlinkhub"; fi
	if [[ -e /etc/systemd/system/OpenLinkHub.service || -e /opt/OpenLinkHub || -e /etc/udev/rules.d/99-openlinkhub.rules ]]; then echo yes >"$FACTS/openlinkhub-upstream"; else echo no >"$FACTS/openlinkhub-upstream"; fi
	# a CoreCtrl or a LACT the person installed by hand is theirs: the package lact is not planned beside it (ORDER 108, milestone 10)
	if [[ -e /usr/bin/corectrl ]]; then echo yes >"$FACTS/corectrl"; else echo no >"$FACTS/corectrl"; fi
	if [[ -e /usr/local/bin/lact || -e /usr/local/lib/systemd/system/lactd.service || -e /etc/systemd/system/lactd.service ]]; then echo yes >"$FACTS/lact-local"; else echo no >"$FACTS/lact-local"; fi
	if [[ -e /usr/local/bin/headsetcontrol ]]; then echo yes >"$FACTS/headsetcontrol-local"; else echo no >"$FACTS/headsetcontrol-local"; fi
	# a CoolerControl made by upstream's makefile is the person's (milestone 13); the hwmon folders that already hold a fan channel are read, never probed
	if [[ -e /usr/local/bin/coolercontrold || -e /usr/local/lib/systemd/system/coolercontrold.service || -e /etc/systemd/system/coolercontrold.service ]]; then echo yes >"$FACTS/coolercontrol-local"; else echo no >"$FACTS/coolercontrol-local"; fi
	: >"$FACTS/hwmon-fans"
	for dir in /sys/class/hwmon/hwmon*; do
		[[ -r $dir/name ]] || continue
		count=$(find -L "$dir" -maxdepth 1 -name 'pwm[0-9]*' ! -name '*_*' 2>/dev/null | wc -l)
		printf '%s\t%s\n' "$(cat "$dir/name")" "$count" >>"$FACTS/hwmon-fans"
	done
	: >"$FACTS/hid-uevents"
	for file in /sys/bus/hid/devices/*/uevent; do
		[[ ! -f "$file" ]] || cat "$file" >>"$FACTS/hid-uevents"
	done
	: >"$FACTS/input-properties"
	for file in /sys/class/input/event*; do
		[[ ! -e "$file" ]] || udevadm info --query=property --path="$file" >>"$FACTS/input-properties"
	done
	if isenkram-autoinstall-firmware -l >"$FACTS/firmware-packages" 2>"$WORK/isenkram.log"; then :; else
		status=$?
		if [[ $status != 1 ]] || ! grep -q 'did not find any firmware files' "$WORK/isenkram.log"; then
			cat "$WORK/isenkram.log"; err 54 "$status"; stop_run
		fi
	fi
	cat "$WORK/isenkram.log"
	# NVIDIA's own report, when its tool is there (it comes with NVIDIA's driver); the plan never reads it: which driver a
	# card gets is decided from NVIDIA's tables of supported cards (share/nvidia-open.ids, nvidia-legacy-580xx.ids)
	if command -v nvidia-detect >/dev/null 2>&1; then
		nvidia-detect >"$FACTS/nvidia-detect" 2>&1 || log 'nvidia-detect could not recommend a driver; use the edition compatibility table'
	else
		echo "nvidia-detect is not installed (it comes with NVIDIA's driver); the plan above is the edition's own detection" >"$FACTS/nvidia-detect"
	fi
	# the corrections of the known-machines table that apply to this computer, each with its state (ORDER 665, 669)
	/usr/bin/sparky-stereo-known-machines --list >"$FACTS/known-machines" 2>"$WORK/known-machines.log" || { cat "$WORK/known-machines.log"; : >"$FACTS/known-machines"; }
fi
python3 "$LIB/detect.py" "$FACTS" "$SHARE" >"$WORK/plan"
# known_corrections: "ID<TAB>MESSAGE<TAB>on|off<TAB>KIND<TAB>VALUE" for each correction of this computer
known_corrections() {
	[[ -s $FACTS/known-machines ]] || return 0
	python3 -I -c 'import json,sys
for r in json.load(open(sys.argv[1])).get("corrections", []):
    print("\t".join([r["id"], str(r["message"]), "on" if r["on"] else "off", r["kind"], r.get("table") or r.get("option")]))' "$FACTS/known-machines"
}
while IFS=$'\t' read -r km_id km_message km_state km_kind km_value; do
	printf 'fact\tknown-machine\t%s\t%s\t%s\t%s\n' "$km_id" "$km_state" "$km_kind" "$km_value" >>"$WORK/plan"
done < <(known_corrections)
if [[ -n "$rig_driver" ]]; then
	if ! awk -F '\t' -v package="$rig_driver" '($1 == "candidate" || $1 == "package") && $2 == package {found=1} END {exit !found}' "$WORK/plan"; then
		log "No detected rig matches $rig_driver"; exit 2
	fi
	printf 'package\t%s\n' "$rig_driver" >>"$WORK/plan"
fi
cat "$WORK/plan"
log 'nvidia-detect report:'
cat "$FACTS/nvidia-detect"
if $dry; then
	log 'DRY RUN: no packages, repositories, configuration or hardware probes changed'
	log 'Sensors: would run sensors-detect --auto, persist and load its modules, verify sensors -u'
	if [[ -f "$FACTS/sensors-detect" ]]; then
		log 'Fixture sensor module recommendations:'
		sensor_modules "$FACTS/sensors-detect"
	fi
	if grep -Fxq $'package\tlinux-image-sparky-stereo-v3' "$WORK/plan"; then
		log "Would install linux-image-sparky-stereo-v3 and linux-headers-sparky-stereo-v3 (the kernel built for this x86-64-v3 processor); the baseline kernel stays installed and in GRUB, and the newer release boots first"
	elif grep -Fxq $'fact\tx86-64-v3\tyes' "$WORK/plan"; then
		log "Would not install the x86-64-v3 kernel: the baseline kernel was chosen for this machine (--kernel v3 undoes it)"
	fi
	if grep -Fxq $'action\topenrgb-session' "$WORK/plan"; then
		log "Would mark this machine for OpenRGB at the session start (minimized): the machine has a device OpenRGB drives"
	fi
	if grep -Fxq $'action\ti2c-dev' "$WORK/plan"; then
		log "Would load i2c-dev and the chipset's driver (i2c-i801 on Intel, i2c-piix4 on AMD) now and at every boot (/etc/modules-load.d/sparky-stereo-i2c.conf) so OpenRGB can reach the board's SMBus"
	fi
	if grep -Eq $'^owner\t' "$WORK/plan"; then
		log "Would leave each device named in an owner line of the plan to its owner (62-sparky-stereo-peripheral-owner.rules takes the other tools' access away)"
	fi
	if grep -Fxq $'action\tbroadcom-wl' "$WORK/plan"; then
		if wl_declined; then
			log "Would not ask about Broadcom's wl Wi-Fi driver: Not now was chosen for this machine (--broadcom-wl reset asks again)"
		else
			log "Would show the licence of broadcom-sta-dkms (Broadcom Software License Agreement, read from the package file) and install the package unmodified only on a yes: from $WL_POOL when it is there, else from the network with the download size said first"
		fi
	fi
	if grep -Fxq $'action\tbroadcom-wl-swap' "$WORK/plan"; then
		log "Would leave the Broadcom Wi-Fi card ($(wl_swap_cards "$WORK/plan" | paste -sd, -)) to the kernel's free driver and install nothing; Broadcom's wl is offered as a choice (--broadcom-wl swap: the licence read from the package file, then the swap, undone if a step fails; --broadcom-wl back: the way back)"
	fi
	if grep -Fxq $'action\tnvidia-open' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "Would keep nouveau for the NVIDIA graphics, as chosen (--nvidia nouveau): the edition's NVIDIA driver with HDMI 3D would not be installed"
		elif ! module_info=$(apt-cache show --no-all-versions nvidia-kernel-open-dkms-stereo3d 2>/dev/null) || [[ -z $module_info ]]; then
			log "Would stop with an ERROR: apt finds no nvidia-kernel-open-dkms-stereo3d, the edition's NVIDIA module, in the configured repositories"
		else
			nvidia_version=$(nvidia_version_of "$(sed -n 's/^Version: //p' <<<"$module_info" | head -n1)")
			log "Would install sparky-stereo-nvidia-driver-lock and sparky-stereo-cuda-repo (NVIDIA's CUDA repository and its pins) first, the repository only where none is configured for NVIDIA's URI"
			if [[ -n $nvidia_version ]]; then
				log "Would install nvidia-driver=$nvidia_version nvidia-kernel-open-dkms-stereo3d libnvcuvid1=$nvidia_version nvidia-vaapi-driver by name"
				! foreign_i386 || log "Would install nvidia-driver-libs:i386=$nvidia_version libcuda1:i386=$nvidia_version with them (dpkg has i386: NVIDIA's libraries for 32-bit programs)"
			else
				log "Would stop with an ERROR: the module's version has no +stereo3dN suffix, so the NVIDIA driver version it is built for is unknown"
			fi
		fi
	fi
	if grep -Fxq $'action\tnvidia-legacy-580xx' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "Would keep nouveau for the NVIDIA graphics, as chosen (--nvidia nouveau), with the edition's HDMI 3D: NVIDIA's 580 driver would not be installed"
		elif ! module_info=$(apt-cache show --no-all-versions nvidia-legacy-580xx-kernel-dkms 2>/dev/null) || [[ -z $module_info ]]; then
			log "Would stop with an ERROR: apt finds no nvidia-legacy-580xx-kernel-dkms, the edition's build of NVIDIA's 580 driver, in the configured repositories"
		else
			module_version=$(sed -n 's/^Version: //p' <<<"$module_info" | head -n1)
			nvidia_version=$(nvidia_version_of "$module_version" sparky)
			log "Would install sparky-stereo-nvidia-legacy-580xx-driver-lock and sparky-stereo-cuda-repo (NVIDIA's CUDA repository and its pins, for NVIDIA's EGL platform libraries) first, the repository only where none is configured for NVIDIA's URI"
			if [[ -n $nvidia_version ]]; then
				# the edition carries NVIDIA's 580 user space at the module's own version
				log "Would install nvidia-driver=$module_version nvidia-legacy-580xx-kernel-dkms libnvcuvid1=$module_version nvidia-vaapi-driver by name, downgrades allowed (a newer NVIDIA user space goes back to 580, and the open modules go)"
				! foreign_i386 || log "Would install nvidia-driver-libs:i386=$module_version libcuda1:i386=$module_version with them (dpkg has i386: NVIDIA's libraries for 32-bit programs)"
			else
				log "Would stop with an ERROR: the module's version has no +sparkyN suffix, so the NVIDIA driver version it is built for is unknown"
			fi
		fi
	fi
	exit 0
fi

if $wl_only; then
	# only the Wi-Fi driver's step: a terminal session, no plan window (the step asks on the terminal)
	failed=0
	setup_broadcom_wl "$wl_option" || failed=1
	setup_broadcom_wl_swap "$wl_option" || failed=1
	trap - ERR
	finish_run "$LOG" "$failed"
	exit
fi
if ! $auto; then
	load_strings
	# A known machine's corrections, in the person's language, each with what it does and its switch (ORDER 665, 669).
	# The first one gets the window's button; every one has the command (sparky-stereo-known-machines --off ID, --on ID).
	km_button= km_switch= km_switch_id=
	while IFS=$'\t' read -r km_id km_message km_state km_kind km_value; do
		km_what=$(render_message "$km_message")
		if [[ $km_state == on ]]; then
			text=$(render_message 116 "$km_what" "$km_id")
			[[ -n $km_button ]] || { km_button=--button="$LOCAL118:10"; km_switch=--off; km_switch_id=$km_id; }
		else
			text=$(render_message 117 "$km_what" "$km_id")
			[[ -n $km_button ]] || { km_button=--button="$LOCAL119:12"; km_switch=--on; km_switch_id=$km_id; }
		fi
		printf 'note\tknown-machine\t%s\n' "$text" >>"$WORK/plan"
	done < <(known_corrections)
	# Not now was chosen before: the plan says so, and has a button to be asked again
	wl_again=false
	if grep -Fxq $'action\tbroadcom-wl' "$WORK/plan" && wl_declined; then
		wl_again=true
		text=$(render_message 65 "$(wl_cards "$WORK/plan" | paste -sd, - | sed 's/,/, /g')")
		printf 'note\tbroadcom-wl\t%s\n' "${text//@BUTTON@/$LOCAL66}" >>"$WORK/plan"
	fi
	# The plan, and the person's answer: install it, install it but keep nouveau for the NVIDIA graphics (offered only when
	# the plan installs the edition's NVIDIA driver), or cancel. yad gives 1 for Cancel and 252 for a closed window; any
	# other code means the window itself failed, which is said, never taken as an answer.
	# A Broadcom card that the kernel's driver and wl both drive: the plan says which one has it and offers the other
	# (row 728); the kernel's driver stays unless the person chooses wl here or with --broadcom-wl swap
	wl_swap_button=
	if grep -Fxq $'action\tbroadcom-wl-swap' "$WORK/plan"; then
		swap_card=$(wl_swap_card "$WORK/plan" "$FACTS/lspci")
		if [[ -n $swap_card ]]; then
			IFS=$'\t' read -r swap_id _ swap_free _ swap_driver <<<"$swap_card"
			if [[ $swap_driver == wl ]]; then
				text=$(render_message 102 "$swap_id" "${swap_free%%/*}")
				wl_swap_button=--button="$LOCAL96:8"
			else
				text=$(render_message 101 "$swap_id" "${swap_driver:-${swap_free%%/*}}")
				wl_swap_button=--button="$LOCAL95:6"
			fi
			text=${text//@SWAP@/$LOCAL95}
			printf 'note\tbroadcom-wl-swap\t%s\n' "${text//@BACK@/$LOCAL96}" >>"$WORK/plan"
		fi
	fi
	buttons=(--button="$LOCAL2:1")
	if $wl_again; then buttons+=(--button="$LOCAL66:4"); fi
	if [[ -n $wl_swap_button ]]; then buttons+=("$wl_swap_button"); fi
	if [[ -n $km_button ]]; then buttons+=("$km_button"); fi
	if grep -Eq $'^action\tnvidia-(open|legacy-580xx)$' "$WORK/plan"; then buttons+=(--button="$LOCAL4:2"); fi
	buttons+=(--button="$LOCAL3:0")
	# A Maxwell, Pascal or Volta card has two drivers that give different results: both are said above the plan, in the
	# person's language, with the default marked and why (LOCAL8; its @INSTALL@ and @BUTTON@ are the two buttons' labels).
	explain=()
	if grep -Fxq $'action\tnvidia-legacy-580xx' "$WORK/plan"; then
		text=${LOCAL8//@INSTALL@/$LOCAL3}
		explain=(--text="${text//@BUTTON@/$LOCAL4}")
	fi
	answer=0
	wl_choice=
	yad --text-info --title="$LOCAL1" --filename="$WORK/plan" --width=760 --height=500 "${explain[@]}" "${buttons[@]}" || answer=$?
	case $(plan_answer "$answer") in
		edition) ;;
		wl-again) wl_reset ;;
		wl-swap) wl_choice=swap ;;
		wl-back) wl_choice=back ;;
		nouveau) nvidia_choice=nouveau; nvidia_said=true ;;
		known-off|known-on)
			# the person's switch for this computer's correction: the boot images or the menu are written again now, and it
			# applies at the next restart; nothing else of the setup runs
			if run /usr/bin/sparky-stereo-known-machines "$km_switch" "$km_switch_id"; then
				log "$(render_message 120 "$km_switch_id")"
				yad --info --title="$LOCAL1" --text="$(render_message 120 "$km_switch_id")" --button="$LOCAL7:0" || true
				exit 0
			fi
			err 121 "$km_switch_id"; stop_run ;;
		cancel) log 'Hardware Setup cancelled; nothing was changed'; exit 0 ;;
		*) err 52 "$answer"; stop_run ;;
	esac
	# The child owns the execution lock; release it before launching the visible terminal.
	flock -u 9
	# the licence is asked first in the run's own window (the Wi-Fi driver is what a machine without a cable needs most)
	wl_ask=
	if grep -Fxq $'action\tbroadcom-wl' "$WORK/plan" && ! wl_declined; then wl_ask=ask; fi
	# a swap or the way back the person chose in the plan window is this run's Broadcom step
	if [[ -n $wl_choice ]]; then wl_ask=$wl_choice; fi
	exec env SHELL=/bin/bash SPARKY_STEREO_HARDWARE_GUI=1 sparky-xterm "/usr/bin/sparky-stereo-hardware --auto --nvidia $nvidia_choice ${rig_driver:+--rig-driver $rig_driver} ${wl_ask:+--broadcom-wl $wl_ask}"
fi
failed=0
# The person's own choice between the edition's NVIDIA driver and nouveau is kept for the machine (ORDER 675): a card that
# appears later gets the driver by itself only where nouveau was not chosen. Said choices only (--nvidia, the window's buttons).
NVIDIA_CHOICE_FILE=/var/lib/sparky-stereo-hardware/nvidia-choice
if $nvidia_said && grep -Eq $'^action\tnvidia-(open|legacy-580xx)$' "$WORK/plan"; then
	mkdir -p "${NVIDIA_CHOICE_FILE%/*}"
	if [[ $nvidia_choice == nouveau ]]; then echo nouveau >"$NVIDIA_CHOICE_FILE"; else rm -f "$NVIDIA_CHOICE_FILE"; fi
fi
if $nvidia_only; then
	# only the NVIDIA step (the card's step runs this for a card the machine has not shown before)
	if grep -Fxq $'action\tnvidia-open' "$WORK/plan"; then
		install_only() { apt_install "$@" || { err 47 "$*"; failed=1; }; }
		install_only firmware-nvidia-graphics
		setup_nvidia || failed=1
	elif grep -Fxq $'action\tnvidia-legacy-580xx' "$WORK/plan"; then
		install_only() { apt_install "$@" || { err 47 "$*"; failed=1; }; }
		install_only firmware-nvidia-graphics
		setup_nvidia legacy-580xx || failed=1
	else
		log "NVIDIA: no driver of the edition's is installed for this computer (no NVIDIA card, or a card that keeps nouveau: the plan above says which)"
	fi
	trap - ERR
	finish_run "$LOG" "$failed"
	exit
fi
# the Wi-Fi driver of a Broadcom card no kernel driver drives: the licence and the person's yes first, then the checks
setup_broadcom_wl "$wl_option" || failed=1
# a card the kernel's driver and wl both drive: told, or moved to wl or back when the person chose that (row 728)
setup_broadcom_wl_swap "$wl_option" || failed=1
# install_step PACKAGE... [OPTION...]: apt installs them, or the failure is said and counted; the setup goes on with the
# steps that do not need them
install_step() {
	if ! apt_install "$@"; then
		err 47 "$(printf '%s ' "$@" | sed 's/--[a-z-]* //g; s/ $//')"
		failed=1
	fi
}
mapfile -t packages < <(awk -F '\t' '$1 == "package" {print $2}' "$WORK/plan")
for package in "${packages[@]}"; do
	case "$package" in
		task-laptop) install_step --install-recommends "$package" ;;
		power-profiles-daemon|thermald) install_step "$package" ;;
		linux-image-sparky-stereo-v3|linux-headers-sparky-stereo-v3) install_step "$package" ;;
	esac
done
if [[ -s "$FACTS/firmware-packages" ]]; then
	if ! run env DEBIAN_FRONTEND=noninteractive isenkram-autoinstall-firmware; then
		err 48 "$(tr '\n' ' ' <"$FACTS/firmware-packages" | sed 's/ $//')"
		failed=1
	fi
else
	log 'No missing firmware packages matched by isenkram'
fi
for package in "${packages[@]}"; do
	case "$package" in amd64-microcode|intel-microcode) install_step "$package" ;; esac
done
amdgpu_actions=()
if grep -Fxq $'action\tamdgpu-dpm' "$WORK/plan"; then amdgpu_actions+=(amdgpu_dpm); fi
if grep -Fxq $'action\tamdgpu-panel' "$WORK/plan"; then amdgpu_actions+=(amdgpu_panel_power); fi
if ((${#amdgpu_actions[@]})); then setup_amdgpu "${amdgpu_actions[@]}" || failed=1; fi
setup_sensors || failed=1
if printf '%s\n' "${packages[@]}" | grep -Fxq firmware-nvidia-graphics; then
	# nouveau's firmware, for the driver the card runs on now (and until a reboot into NVIDIA's driver)
	install_step firmware-nvidia-graphics
	if grep -Fxq $'action\tnvidia-open' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "NVIDIA: nouveau stays, as you chose (--nvidia nouveau), so the edition's NVIDIA driver with HDMI 3D was not installed. Run Hardware Setup again without that choice to install it"
		else
			setup_nvidia || failed=1
		fi
	fi
	if grep -Fxq $'action\tnvidia-legacy-580xx' "$WORK/plan"; then
		if [[ $nvidia_choice == nouveau ]]; then
			log "NVIDIA: nouveau stays, as you chose (--nvidia nouveau), with the edition's HDMI 3D, so NVIDIA's 580 driver was not installed. Run Hardware Setup again without that choice to install it"
		else
			setup_nvidia legacy-580xx || failed=1
		fi
	fi
fi
if grep -Fxq $'action\tcreative-msi' "$WORK/plan"; then
	install_step firmware-creative-stereo
	setup_creative || failed=1
fi
for package in "${packages[@]}"; do
	case "$package" in
		evdi-dkms|xpadneo-dkms|steam-devices|sparky-sim-hidraw) install_step "$package" ;;
		hid-tmff2-dkms|hid-fanatecff-dkms|new-lg4ff-dkms) setup_rig_driver "$package" || failed=1 ;;
	esac
done
# Lights and peripherals (ORDER 108): the tool of each device seen, without a question. The kernel module of OpenRazer is DKMS, like the
# wheel drivers: the running kernel's headers with it.
for package in "${packages[@]}"; do
	case "$package" in
		openrgb|i2c-tools|solaar|ratbagd|piper|liquidctl|g810-led|openrazer-daemon) install_step "$package" ;;
		openrazer-driver-dkms) setup_rig_driver "$package" || failed=1 ;;
	esac
done
if grep -Fxq $'action\ti2c-dev' "$WORK/plan"; then setup_i2c_dev "$WORK/plan" || failed=1; fi
setup_openrgb_session "$WORK/plan" || failed=1
# The OpenGL stereo default follows the card the desktop runs on; a driver installed now
# binds at the next boot, when sparky-stereo-opengl-default.service writes it again.
if ! run /usr/bin/sparky-stereo-opengl-default; then
	err 49
	failed=1
fi
trap - ERR
finish_run "$LOG" "$failed"
