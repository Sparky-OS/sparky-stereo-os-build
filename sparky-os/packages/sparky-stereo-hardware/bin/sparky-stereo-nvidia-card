#!/bin/bash
# Created by Paweł "pavroo" Pijanowski and Daniel Ramos (Capitain Jack) 2026/11/25
# Copyright 2026 under the GNU GPL3 License
# NVIDIA's driver only where an NVIDIA graphics card is (ORDER 675; Daniel, 2026-11-18: "I agree on removing nvidia
# from macs that do not have it"). The image carries NVIDIA's driver so that a live session and an installed system
# with such a card work at once (Daniel, 2026-10-23: "user has not to configure, out of the box full experience,
# including the drivers needed to"). On a machine without the card it is installed for nothing, its kernel module is
# built for nothing at every kernel update, and the first start of a MacBookPro9,2 signed it for 13 minutes (ORDER 666).
#   present  prints each NVIDIA display controller of the PCI bus ("ADDRESS 10de:DEVICE"); exit status 0 with one,
#            1 with none, 2 when the bus cannot be read (nothing is ever decided on a bus that cannot be read)
#   auto     the unit's step (sparky-stereo-hardware-nvidia-card.service: at every start, when the package is
#            configured, and from udev when an NVIDIA display controller appears):
#            - once per installed system (the mark nvidia-card-settled): with no card, NVIDIA's driver is removed, said
#              in the journal and to the session; with a card, nothing changes. The cards seen are recorded.
#            - afterwards: a card this machine has not shown before, with no NVIDIA driver installed and nouveau not
#              chosen, gets the edition's driver through Hardware Setup (sparky-stereo-hardware --auto --nvidia-only),
#              said to the session; on a metered connection nothing is downloaded and the problem is kept with its
#              Repair. A card that leaves later takes nothing with it: after the first settling nothing is removed.
#   remove   the removal alone (the Repair of a removal that failed)
#   install  the installation alone (the Repair; sparky-stereo-hardware --nvidia-card)
# What is removed: the driver's own packages by name (the driver, its kernel modules, the video decoding libraries, the
# 32-bit libraries, both driver locks and the CUDA repository package, which are the driver's apt configuration and come
# back first when a card is found), then what is left of it: NVIDIA's by name, installed automatically, removable alone.
# apt's plan is read first, every kind of line: if it would take anything that is not NVIDIA's, or an NVIDIA package the
# person installed by name, or would install anything at all, nothing is removed and that is said and kept. Never an
# autoremove. The notice counts what left by name.
# Purged, not removed: a removed package's configuration files stay active (the module blacklist among them).
# firmware-nvidia-graphics (nouveau's firmware) stays, so a card that appears has a picture at once.
set -uo pipefail
export LC_ALL=C.UTF-8
PKG=sparky-stereo-hardware
KEY=nvidia-card
NOTICE=nvidia-card-told
SELF=/usr/lib/sparky-stereo-hardware/nvidia-card
R=${SPARKY_STEREO_ROOT:-}
STATE=$R/var/lib/sparky-stereo-hardware
SETTLED=$STATE/nvidia-card-settled
SEEN=$STATE/nvidia-cards-seen
CHOICE=$STATE/nvidia-choice
STORE=$R/var/lib/sparky-stereo-problems
SYS=${SPARKY_STEREO_SYSFS:-/sys}
SETUP=${SPARKY_STEREO_HARDWARE_SETUP:-/usr/bin/sparky-stereo-hardware}
REPAIR_REMOVE="[\"$SELF\",\"remove\"]"
REPAIR_INSTALL='["sparky-stereo-hardware","--nvidia-card"]'
ROOTS=(nvidia-driver nvidia-driver-cuda nvidia-driver-libs nvidia-kernel-open-dkms-stereo3d nvidia-kernel-open-dkms
	nvidia-legacy-580xx-kernel-dkms nvidia-kernel-dkms nvidia-kernel-support libnvcuvid1 libcuda1 nvidia-vaapi-driver
	nvidia-settings nvidia-xconfig nvidia-persistenced nvidia-modprobe xserver-xorg-video-nvidia
	sparky-stereo-nvidia-driver-lock sparky-stereo-nvidia-legacy-580xx-driver-lock sparky-stereo-cuda-repo)

say() { logger -t "$PKG" -- "$1" 2>/dev/null || true; echo "$PKG: $1" >&2; }

# each NVIDIA display controller (class 03xx) of the PCI bus: "ADDRESS 10de:DEVICE"
cards() {
	local d class
	[[ -d $SYS/bus/pci/devices ]] || return 2
	for d in "$SYS"/bus/pci/devices/*; do
		[[ -r $d/vendor && -r $d/class && -r $d/device ]] || continue
		[[ $(<"$d/vendor") == 0x10de ]] || continue
		class=$(<"$d/class")
		[[ $class == 0x03* ]] || continue
		printf '%s 10de:%s\n' "${d##*/}" "$(sed 's/^0x//' "$d/device")"
	done
	return 0
}
ids() { awk '{print $2}' | sort -u; }

# a package of NVIDIA's driver by its name; nouveau's firmware is not
nvidia_name() {
	local name=${1%%:*}
	[[ $name == firmware-nvidia-graphics ]] && return 1
	[[ $name == sparky-stereo-cuda-repo || $name =~ nvidia || $name =~ ^(libcuda|libnvcuvid|libnvoptix|libnvfbc|libnvjpeg) ]]
}
# the installed packages of ROOTS, every architecture, as dpkg names them
roots() {
	dpkg-query -W -f '${binary:Package}\t${db:Status-Abbrev}\n' "${ROOTS[@]}" 2>/dev/null | awk -F '\t' '$2 ~ /^ii/ {print $1}'
}
driver_installed() {
	[[ -n $(dpkg-query -W -f '${db:Status-Abbrev}\n' nvidia-driver nvidia-driver-libs nvidia-kernel-open-dkms-stereo3d \
		nvidia-legacy-580xx-kernel-dkms 2>/dev/null | grep '^ii') ]]
}
planned() { sed -n 's/^\(Remv\|Purg\) \([^ ]*\).*/\2/p' | sort -u; }
# what a plan would install, each with its architecture: apt names a package of a foreign architecture NAME:ARCH and gives
# every Inst line its architecture last, "(VERSION ORIGIN [ARCH])". A purge plan with an Inst line is not a removal: on a
# machine with i386 enabled, purging nvidia-installer-cleanup installs its i386 copy in its place, because glx-diversions
# (Debian's, of an NVIDIA driver once installed) pre-depends on it and it is Multi-Arch: foreign (found on an A10, ORDER 675)
installs() { awk '$1 == "Inst" {n = $2; a = $NF; gsub(/[][()]/, "", a); if (n !~ /:/) n = n ":" a; print n}' | sort -u; }
# the installed packages, as dpkg names them (NAME, or NAME:ARCH for a foreign or Multi-Arch: same one)
installed_list() { dpkg-query -W -f '${binary:Package}\t${db:Status-Abbrev}\n' 2>/dev/null | awk -F '\t' '$2 ~ /^ii/ {print $1}' | sort -u; }
# a package may leave with the driver when it is NVIDIA's by name and either one of the driver's own packages (ROOTS) or
# installed automatically; an NVIDIA package the person installed by name (a CUDA or container toolkit) is theirs
AUTO=
NATIVE=$(dpkg --print-architecture 2>/dev/null)
may_leave() {
	local name=${1%:"$NATIVE"} base=${1%%:*} root
	nvidia_name "$1" || return 1
	for root in "${ROOTS[@]}"; do [[ $base == "$root" ]] && return 0; done
	grep -Fxq -e "$name" -e "$1" <<<"$AUTO"
}
wait_for_dpkg() { apt-get -q -o DPkg::Lock::Timeout=-1 check >/dev/null 2>&1 || true; }
notice() { sparky-stereo-problems keep --boot --severity notice --quiet "$PKG" "$NOTICE" "$@" >/dev/null 2>&1 || true; }
clear_problem() {
	[[ -e $STORE/${PKG}_$KEY.json ]] || return 0
	sparky-stereo-problems clear "$PKG" "$KEY" >/dev/null 2>&1 || true
}
# purge_checked [--leftovers] PACKAGE...: apt's plan first, read by every kind of line: only NVIDIA's packages may leave,
# and nothing may come in. The driver's own packages: a plan that would install anything is refused, said and kept, as a
# plan that would take more. What is left of the driver (--leftovers): each was planned alone and brings nothing in, so a
# plan of them together that would install something leaves them all in place, with a line in the journal only
purge_checked() {
	local plan extra came leftovers=0
	[[ $1 == --leftovers ]] && { leftovers=1; shift; }
	plan=$(apt-get -s -q -o Debug::NoLocking=true purge "$@" 2>&1) || {
		sparky-stereo-problems keep --repair "$REPAIR_REMOVE" --output "$(tail -n 40 <<<"$plan")" "$PKG" "$KEY" LOCAL122 'apt-get --simulate purge' 100 >/dev/null 2>&1 || true
		say "apt cannot plan the removal of NVIDIA's driver; nothing was removed"
		return 1
	}
	came=$(installs <<<"$plan" | paste -sd' ' -)
	if [[ -n $came ]]; then
		if ((leftovers)); then
			say "left in place: $*; removing them together would install $came"
			return 0
		fi
		sparky-stereo-problems keep --repair "$REPAIR_REMOVE" --output "$(grep -E '^(Inst|Remv|Purg) ' <<<"$plan")" "$PKG" "$KEY" LOCAL127 "$came" >/dev/null 2>&1 || true
		say "NVIDIA's driver was not removed: the removal would install $came, which this computer does not have now"
		return 1
	fi
	extra=$(planned <<<"$plan" | while read -r p; do may_leave "$p" || printf '%s ' "$p"; done)
	if [[ -n $extra ]]; then
		sparky-stereo-problems keep --repair "$REPAIR_REMOVE" "$PKG" "$KEY" LOCAL121 "${extra% }" >/dev/null 2>&1 || true
		say "NVIDIA's driver was not removed: the removal would also take ${extra% }, which is not part of the driver"
		return 1
	fi
	grep -E '^(Remv|Purg) ' <<<"$plan"
	sparky-stereo-problems run --repair "$REPAIR_REMOVE" "$PKG" "$KEY" LOCAL122 -- \
		env DEBIAN_FRONTEND=noninteractive apt-get -y -q purge "$@"
}
remove() {
	local -a r left
	local before after gone came p q plan alone
	wait_for_dpkg
	mapfile -t r < <(roots)
	if ((${#r[@]} == 0)); then
		clear_problem
		return 0
	fi
	AUTO=$(apt-mark showauto 2>/dev/null | sort -u)
	before=$(installed_list)
	purge_checked "${r[@]}" || return 1
	# what is left of the driver: installed, NVIDIA's by name, installed automatically, and removable alone without
	# taking anything that may not leave. apt's own list of packages nothing needs does not hold them (nvidia-vulkan-icd
	# provides vulkan-icd, which other packages' alternatives name), so the list is by name, as the removal done by hand
	# on two machines was
	# (a package whose removal alone would install something, as nvidia-installer-cleanup on a machine with glx-diversions
	# and i386, is not removable alone: it stays, and nothing is said)
	mapfile -t left < <(installed_list |
		while read -r p; do
			may_leave "$p" || continue
			plan=$(apt-get -s -q -o Debug::NoLocking=true purge "$p" 2>/dev/null) || continue
			[[ -z $(installs <<<"$plan") ]] || continue
			alone=1
			while read -r q; do [[ -z $q ]] || may_leave "$q" || alone=0; done < <(planned <<<"$plan")
			((alone)) && printf '%s\n' "$p"
		done)
	if ((${#left[@]})); then
		purge_checked --leftovers "${left[@]}" || return 1
	fi
	# what left is counted by name, not by the number of packages: a package that left and another that came would cancel out
	after=$(installed_list)
	gone=$(comm -23 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | grep -c .)
	came=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | paste -sd' ' -)
	[[ -z $came ]] || say "installed while NVIDIA's driver was removed, by no plan this step accepted: $came"
	clear_problem
	say "NVIDIA's driver was removed ($gone packages): this computer has no NVIDIA graphics card. Hardware Setup installs it again by itself when one is found"
	notice LOCAL120 "$gone"
	return 0
}
metered() {
	local value
	# at an early start NetworkManager has not said yet what the connection is: wait for it, a minute at most
	if command -v nm-online >/dev/null 2>&1; then nm-online -q -t 60 >/dev/null 2>&1 || true; fi
	value=$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered 2>/dev/null) || return 1
	[[ $value == 'u 1' || $value == 'u 3' ]]
}
record_seen() { mkdir -p "$STATE" && cards | ids >"$SEEN.new" && mv "$SEEN.new" "$SEEN"; }
install() {
	local list
	list=$(cards | ids | paste -sd' ' -)
	if [[ -z $list ]]; then
		say "no NVIDIA graphics card is on this computer: nothing to install"
		clear_problem
		return 0
	fi
	wait_for_dpkg
	if sparky-stereo-problems run --repair "$REPAIR_INSTALL" "$PKG" "$KEY" LOCAL123 "$list" -- "$SETUP" --auto --nvidia-only; then
		record_seen
		if driver_installed; then
			say "an NVIDIA graphics card was found ($list) and its driver was installed; restart the computer to use it"
			notice LOCAL124 "$list"
		fi
		return 0
	fi
	return 1
}
auto() {
	local list rc new
	list=$(cards)
	rc=$?
	if ((rc == 2)); then
		say "the PCI bus cannot be read ($SYS/bus/pci/devices), so nothing is decided about NVIDIA's driver"
		return 0
	fi
	mkdir -p "$STATE"
	if [[ ! -e $SETTLED ]]; then
		if [[ -z $list ]]; then
			remove || return 1
		fi
		record_seen
		: >"$SETTLED"
		return 0
	fi
	new=$(comm -23 <(ids <<<"$list") <(sort -u "$SEEN" 2>/dev/null))
	if [[ -z $new ]]; then
		[[ -z $list ]] || ! driver_installed || clear_problem
		return 0
	fi
	new=$(paste -sd' ' - <<<"$new")
	if driver_installed; then
		record_seen
		clear_problem
		return 0
	fi
	if [[ $(cat "$CHOICE" 2>/dev/null) == nouveau ]]; then
		record_seen
		say "an NVIDIA graphics card was found ($new); nouveau stays, as chosen in Hardware Setup"
		return 0
	fi
	if metered; then
		sparky-stereo-problems keep --repair "$REPAIR_INSTALL" "$PKG" "$KEY" LOCAL125 "$new" >/dev/null 2>&1 || true
		say "an NVIDIA graphics card was found ($new); its driver is not downloaded by itself on a metered connection"
		return 0
	fi
	install
}
case ${1:-} in
present)
	list=$(cards)
	rc=$?
	((rc == 2)) && exit 2
	[[ -n $list ]] || exit 1
	printf '%s\n' "$list"
	;;
auto) auto ;;
remove) remove ;;
install) install ;;
*) echo "usage: ${0##*/} present|auto|remove|install" >&2; exit 2 ;;
esac
