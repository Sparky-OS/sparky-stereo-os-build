<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.sparky-stereo-hardware">
    <description>Configure hardware support</description>
    <description xml:lang="pl">Skonfiguruj obsługę sprzętu</description>
    <description xml:lang="pt_BR">Configurar o suporte a hardware</description>
    <description xml:lang="fr">Configurer la prise en charge du matériel</description>
    <description xml:lang="de">Hardwareunterstützung einrichten</description>
    <description xml:lang="es">Configurar la compatibilidad con el hardware</description>
    <description xml:lang="ja">ハードウェアのサポートを設定する</description>
    <description xml:lang="ko">하드웨어 지원 설정</description>
    <description xml:lang="zh_CN">配置硬件支持</description>
    <description xml:lang="zh_TW">設定硬體支援</description>
    <message>Authentication is required to configure hardware</message>
    <message xml:lang="pl">Konfiguracja sprzętu wymaga uwierzytelnienia</message>
    <message xml:lang="pt_BR">É preciso se autenticar para configurar o hardware</message>
    <message xml:lang="de">Die Einrichtung der Hardware erfordert eine Authentifizierung</message>
    <message xml:lang="es">Se requiere autenticación para configurar el hardware</message>
    <message xml:lang="ja">ハードウェアを設定するには認証が必要です</message>
    <message xml:lang="ko">하드웨어를 설정하려면 인증이 필요합니다</message>
    <message xml:lang="zh_CN">配置硬件需要身份验证</message>
    <message xml:lang="zh_TW">設定硬體需要驗證身分</message>
    <message xml:lang="fr">Une authentification est requise pour configurer le matériel</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/sparky-stereo-hardware</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
