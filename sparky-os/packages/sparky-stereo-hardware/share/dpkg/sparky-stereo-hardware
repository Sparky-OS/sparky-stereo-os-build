# Hardware Setup (Sparky Stereo OS): after every dpkg run, among them dpkg --add-architecture i386, NVIDIA's i386 libraries
# are checked against NVIDIA's driver; a missing one is kept as a problem with its repair (sparky-stereo-hardware --nvidia-i386)
post-invoke=if [ -x /usr/lib/sparky-stereo-hardware/nvidia-i386 ]; then /usr/lib/sparky-stereo-hardware/nvidia-i386 check || true; fi
