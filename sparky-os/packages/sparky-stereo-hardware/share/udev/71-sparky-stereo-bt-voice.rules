# A Bluetooth adapter appears or goes: check again whether the adapters can carry voice.
SUBSYSTEM=="bluetooth", KERNEL=="hci[0-9]*", ACTION=="add|remove", RUN+="/usr/bin/systemctl --no-block start sparky-stereo-hardware-bt-voice.service"
