[Unit]
Description=Apply documented corrections for known machines
Documentation=file:/usr/share/doc/sparky-stereo-hardware/README.md
After=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStart=/usr/bin/sparky-stereo-known-machines --apply

[Install]
WantedBy=multi-user.target
