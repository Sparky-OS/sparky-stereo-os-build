# A correction that is not yet in the boot images or GRUB's menu is put there (ORDER 665, 669): that writes every boot
# image, so the start and the login do not wait for it (Type=exec), and it runs after the step that may remove NVIDIA's
# driver, which writes boot images too. Not in a live session or a container.
[Unit]
Description=Apply documented corrections for known machines
Documentation=file:/usr/share/doc/sparky-stereo-hardware/README.md
After=systemd-udev-settle.service sparky-stereo-hardware-nvidia-card.service
ConditionKernelCommandLine=!boot=live
ConditionVirtualization=!container

[Service]
Type=exec
ExecStart=/usr/bin/sparky-stereo-known-machines --apply

[Install]
WantedBy=multi-user.target
