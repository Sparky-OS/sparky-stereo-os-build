# NVIDIA's driver only where an NVIDIA graphics card is (ORDER 675). Once per installed system: with no card, the
# driver the image carries is removed; afterwards a card the machine has not shown before gets the driver through
# Hardware Setup. Started at every start, when the package is configured and by udev when such a card appears
# (71-sparky-stereo-nvidia-card.rules). The start and the login do not wait for it (no default dependencies: a target
# waits for every unit it wants that has them); dkms-sign-unsigned.service is ordered after it, so NVIDIA's module is
# not built again to be signed just before it leaves. Not in a live session (the image keeps the driver for the
# machine it is started on) or a container.
[Unit]
Description=NVIDIA's driver only where an NVIDIA graphics card is
Documentation=file:/usr/share/doc/sparky-stereo-hardware/README.md
DefaultDependencies=no
After=sysinit.target local-fs.target basic.target
Conflicts=shutdown.target
Before=shutdown.target dkms-sign-unsigned.service
ConditionKernelCommandLine=!boot=live
ConditionVirtualization=!container

[Service]
Type=oneshot
ExecStart=/usr/lib/sparky-stereo-hardware/nvidia-card auto
TimeoutStartSec=infinity
# a running dpkg is never killed (as Debian's apt-daily-upgrade.service)
KillMode=process
TimeoutStopSec=900

[Install]
WantedBy=multi-user.target
