[Unit]
Description=OpenGL stereo default for the graphics card the desktop runs on
Documentation=file:/usr/share/doc/sparky-stereo-hardware/README.md
After=systemd-udevd.service systemd-modules-load.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/sparky-stereo-opengl-default

[Install]
WantedBy=graphical.target
