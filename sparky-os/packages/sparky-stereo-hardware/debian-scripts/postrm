set -e
if [ "$1" = remove ] && command -v sparky-stereo-problems >/dev/null 2>&1; then
	sparky-stereo-problems clear --all sparky-stereo-hardware
fi
if [ "$1" = remove ] && command -v deb-systemd-helper > /dev/null; then
	deb-systemd-helper mask sparky-stereo-opengl-default.service >/dev/null || true
	deb-systemd-helper disable sparky-stereo-weather-default.service >/dev/null
	deb-systemd-helper disable sparky-stereo-known-machines.service >/dev/null || true
	deb-systemd-helper disable sparky-stereo-hardware-bt-voice.service >/dev/null || true
	deb-systemd-helper disable sparky-stereo-hardware-broadcom-wl.service >/dev/null || true
	deb-systemd-helper disable sparky-stereo-hardware-nvidia-card.service >/dev/null || true
fi
# a known machine's kernel option leaves GRUB's menu with the package (the boot option file adds it only while the
# package's tool is there); the boot images are written again by the package's own trigger, without the table
if [ "$1" = remove ] && [ -x /usr/sbin/update-grub ] && grep -qs 'acpi_mask_gpe=' /boot/grub/grub.cfg; then
	update-grub || echo 'sparky-stereo-hardware: update-grub failed; the kernel option of this computer'"'"'s correction leaves the menu at the next update-grub' >&2
fi
# the per-boot Wi-Fi settings this package wrote go with it (a file of that name without its first line is not ours)
f=/run/NetworkManager/conf.d/sparky-stereo-broadcom-wl.conf
if [ "$1" = remove ] && [ -f "$f" ] && head -n1 "$f" | grep -q '^# Written by sparky-stereo-hardware (broadcom-wl-settings)'; then
	rm -f "$f"
	if [ -d /run/systemd/system ] && systemctl is-active --quiet NetworkManager.service; then nmcli general reload conf >/dev/null 2>&1 || true; fi
fi
if [ "$1" = purge ]; then
	if command -v deb-systemd-helper > /dev/null; then
		deb-systemd-helper purge sparky-stereo-opengl-default.service >/dev/null || true
		deb-systemd-helper purge sparky-stereo-weather-default.service >/dev/null
		deb-systemd-helper unmask sparky-stereo-opengl-default.service >/dev/null || true
		deb-systemd-helper purge sparky-stereo-known-machines.service >/dev/null || true
		deb-systemd-helper purge sparky-stereo-hardware-bt-voice.service >/dev/null || true
		deb-systemd-helper purge sparky-stereo-hardware-broadcom-wl.service >/dev/null || true
		deb-systemd-helper purge sparky-stereo-hardware-nvidia-card.service >/dev/null || true
	fi
	weather=/etc/xdg/sparky-stereo-weatherrc
	receipt=/var/lib/sparky-stereo-hardware/weather-default.sha256
	if [ -f "$weather" ] && [ ! -L "$weather" ] && [ -r "$receipt" ] &&
	   [ "$(sha256sum "$weather" | cut -d' ' -f1)" = "$(cat "$receipt")" ]; then
		rm -f "$weather"
	fi
	rm -f "$receipt" /var/lib/sparky-stereo-hardware/weather-default.lock
	rm -f /var/lib/sparky-stereo-hardware/broadcom-wl-cards
	rm -f /var/lib/sparky-stereo-hardware/nvidia-card-settled /var/lib/sparky-stereo-hardware/nvidia-cards-seen /var/lib/sparky-stereo-hardware/nvidia-choice
	rm -rf /var/lib/sparky-stereo-hardware/known-machines-boot-images
	rm -f /etc/sparky-stereo-hardware/known-machines.off
	rmdir /etc/sparky-stereo-hardware 2>/dev/null || true
	rm -f /etc/sparky-stereo/opengl-stereo.conf
	rmdir /etc/sparky-stereo 2>/dev/null || true
fi
