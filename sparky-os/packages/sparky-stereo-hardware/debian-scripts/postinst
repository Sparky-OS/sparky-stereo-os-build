# The OpenGL stereo default: enabled for every boot and written now, for the machine it is
# installed on (in the installer, the machine being installed).
set -e
if [ "$1" = configure ]; then
	deb-systemd-helper unmask sparky-stereo-opengl-default.service >/dev/null || true
	deb-systemd-helper enable sparky-stereo-opengl-default.service >/dev/null || true
	if [ -d /run/udev ]; then udevadm control --reload-rules || true; fi
	# NVIDIA's services wait for NVIDIA's driver (sparky-stereo-hardware.conf); one that failed on a machine
	# without the driver is no longer counted as failed
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		if [ ! -e /sys/module/nvidia ]; then systemctl reset-failed nvidia-persistenced.service nvidia-powerd.service >/dev/null 2>&1 || true; fi
		# thermald (Intel CPUs only) and nvidia-imex (a configured IMEX domain) are skipped where they cannot run; a failure
		# they left from before this package is no longer counted
		grep -qs '^vendor_id[[:space:]]*:[[:space:]]*GenuineIntel' /proc/cpuinfo || systemctl reset-failed thermald.service >/dev/null 2>&1 || true
		[ -e /etc/nvidia-imex/nodes_config.cfg ] || systemctl reset-failed nvidia-imex.service >/dev/null 2>&1 || true
		# an Intel machine that has thermald from an earlier image keeps it: marked manual once, after this apt run
		/usr/lib/sparky-stereo-hardware/thermald-manual check || true
	fi
	sparky-stereo-opengl-default ||
		echo 'sparky-stereo-hardware: the OpenGL stereo default could not be written now (sparky-stereo-opengl-default failed); sparky-stereo-opengl-default.service writes it at the next boot' >&2
fi
