# The OpenGL stereo default: enabled for every boot and written now, for the machine it is
# installed on (in the installer, the machine being installed).
set -e
if [ "$1" = configure ]; then
	deb-systemd-helper unmask sparky-stereo-opengl-default.service >/dev/null || true
	deb-systemd-helper enable sparky-stereo-opengl-default.service >/dev/null || true
	deb-systemd-helper unmask sparky-stereo-weather-default.service >/dev/null
	deb-systemd-helper enable sparky-stereo-weather-default.service >/dev/null
	sparky-stereo-weather-default
	deb-systemd-helper unmask sparky-stereo-hardware-bt-voice.service >/dev/null || true
	deb-systemd-helper enable sparky-stereo-hardware-bt-voice.service >/dev/null || true
	deb-systemd-helper enable sparky-stereo-hardware-variant-check.service >/dev/null || true
	deb-systemd-helper enable sparky-stereo-hardware-peripheral-owner.service >/dev/null || true
	deb-systemd-helper enable sparky-stereo-known-machines.service >/dev/null
	deb-systemd-helper enable sparky-stereo-hardware-broadcom-wl.service >/dev/null || true
	# NVIDIA's driver only where an NVIDIA card is (0.1.43, ORDER 675): at every start, and now for this machine
	deb-systemd-helper enable sparky-stereo-hardware-nvidia-card.service >/dev/null || true
	if [ -d /run/udev ]; then udevadm control --reload-rules || true; fi
	# NVIDIA's services wait for NVIDIA's driver (sparky-stereo-hardware.conf); one that failed on a machine
	# without the driver is no longer counted as failed
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		# after this apt run has ended (the step waits for dpkg's locks): the image's NVIDIA driver leaves a machine without
		# the card, once; then a known machine's corrections are put into its boot images and menu
		systemctl --no-block start sparky-stereo-hardware-nvidia-card.service || true
		systemctl --no-block start sparky-stereo-known-machines.service
		if [ ! -e /sys/module/nvidia ]; then systemctl reset-failed nvidia-persistenced.service nvidia-powerd.service >/dev/null 2>&1 || true; fi
		# thermald from an earlier image: kept on Intel, removed on other CPUs where it is unused and automatic, once, after this apt run
		/usr/lib/sparky-stereo-hardware/thermald-manual check || true
		# a Bluetooth adapter that cannot carry voice is told now, not at the next boot
		systemctl --no-block start sparky-stereo-hardware-bt-voice.service || true
		# NetworkManager's settings for the cards Broadcom's wl can drive, written now for the machine it runs on; from
		# 0.1.39 the file matched on driver:wl alone is gone, so NetworkManager reads its files again once (row 728b)
		reload=--reload
		if [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.1.40; then reload=--force-reload; fi
		/usr/lib/sparky-stereo-hardware/broadcom-wl-settings write "$reload" ||
			echo 'sparky-stereo-hardware: the Wi-Fi settings for a Broadcom card could not be written now; the reason is kept (sparky-stereo-problems list) and they are written again at the next start' >&2
	fi
	sparky-stereo-opengl-default ||
		echo 'sparky-stereo-hardware: the OpenGL stereo default could not be written now (sparky-stereo-opengl-default failed); sparky-stereo-opengl-default.service writes it at the next boot' >&2
fi
