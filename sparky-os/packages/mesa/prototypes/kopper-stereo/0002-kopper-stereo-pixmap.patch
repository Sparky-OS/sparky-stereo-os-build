+/* X11 Present can carry a packed pixmap wider than its window. Vulkan WSI
+ * cannot: its swapchain extent is the native window extent. Keep stereo eyes
+ * offscreen and use the loader's pixmap upload for this route.
+ */
+static bool
+kopper_stereo_pixmap(const struct dri_drawable *drawable)
+{
+   return drawable->is_window && drawable->screen->swrast_loader &&
+          drawable->screen->swrast_loader->putImage2 &&
+          drawable->info.bos.sType == VK_STRUCTURE_TYPE_XCB_SURFACE_CREATE_INFO_KHR &&
+          dri_drawable_has_stereo_buffers(drawable);
+}
+
+static void
+kopper_allocate_stereo(struct dri_context *ctx, struct dri_drawable *drawable,
+                       const enum st_attachment_type *statts, unsigned count)
+{
+   struct pipe_screen *screen = drawable->screen->base.screen;
+   struct pipe_context *pipe = ctx->st->pipe;
+   struct pipe_resource templ = {0};
+
+   /* Offscreen eyes have no WSI acquire to notice a native window resize. */
+   ctx->st->ctx->invalidate_on_gl_viewport = true;
+
+   const bool converting = !drawable->stereo_buffers;
+   const bool resized = drawable->old_w != drawable->w ||
+                        drawable->old_h != drawable->h;
+   unsigned attachments = ST_ATTACHMENT_FRONT_LEFT_MASK |
+                          ST_ATTACHMENT_BACK_LEFT_MASK |
+                          ST_ATTACHMENT_FRONT_RIGHT_MASK |
+                          ST_ATTACHMENT_BACK_RIGHT_MASK;
+
+   for (unsigned i = 0; i < count; i++)
+      attachments |= BITFIELD_BIT(statts[i]);
+
+   templ.target = drawable->screen->target;
+   templ.width0 = drawable->w;
+   templ.height0 = drawable->h;
+   templ.depth0 = templ.array_size = 1;
+   if (resized)
+      pipe_resource_reference(&drawable->stereo_target, NULL);
+
+   for (unsigned i = 0; i < ST_ATTACHMENT_COUNT; i++) {
+      unsigned bind;
+      struct pipe_resource *previous = NULL;
+      if (!(attachments & BITFIELD_BIT(i)))
+         continue;
+      enum pipe_format format;
+      dri_drawable_get_format(drawable, i, &format, &bind);
+      templ.format = format;
+      if (templ.format == PIPE_FORMAT_NONE)
+         continue;
+      if (resized || (converting && i < ST_ATTACHMENT_DEPTH_STENCIL)) {
+         if (converting && !resized)
+            pipe_resource_reference(&previous, drawable->textures[i]);
+         pipe_resource_reference(&drawable->textures[i], NULL);
+         if (resized)
+            pipe_resource_reference(&drawable->msaa_textures[i], NULL);
+      }
+      templ.bind = bind & ~(PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_SCANOUT | PIPE_BIND_SHARED);
+      templ.nr_samples = templ.nr_storage_samples = 0;
+      if (!drawable->textures[i])
+         drawable->textures[i] = screen->resource_create(screen, &templ);
+      if (previous && drawable->textures[i])
+         dri_pipe_blit(pipe, drawable->textures[i], previous);
+      pipe_resource_reference(&previous, NULL);
+      if (drawable->stvis.samples > 1 && !drawable->msaa_textures[i]) {
+         templ.nr_samples = templ.nr_storage_samples = drawable->stvis.samples;
+         drawable->msaa_textures[i] = screen->resource_create(screen, &templ);
+         if (drawable->msaa_textures[i] && drawable->textures[i])
+            dri_pipe_blit(pipe, drawable->msaa_textures[i], drawable->textures[i]);
+      }
+   }
+   if (!drawable->stereo_target && drawable->textures[ST_ATTACHMENT_BACK_LEFT]) {
+      templ = *drawable->textures[ST_ATTACHMENT_BACK_LEFT];
+      templ.width0 *= 2;
+      templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+      templ.nr_samples = templ.nr_storage_samples = 0;
+      drawable->stereo_target = screen->resource_create(screen, &templ);
+   }
+   drawable->stereo_buffers = true;
+   drawable->old_w = drawable->w;
+   drawable->old_h = drawable->h;
+   if (converting || resized)
+      p_atomic_inc(&drawable->base.stamp);
+}
+
+static bool
+kopper_present_stereo(struct dri_context *ctx, struct dri_drawable *drawable,
+                      bool front)
+{
+   struct pipe_context *pipe = ctx->st->pipe;
+   struct pipe_resource *target = drawable->stereo_target;
+   const unsigned left = front ? ST_ATTACHMENT_FRONT_LEFT : ST_ATTACHMENT_BACK_LEFT;
+   const unsigned right = front ? ST_ATTACHMENT_FRONT_RIGHT : ST_ATTACHMENT_BACK_RIGHT;
+   struct pipe_transfer *transfer = NULL;
+   struct pipe_box box;
+
+   if (!target || !drawable->textures[left] || !drawable->textures[right])
+      return false;
+   for (unsigned eye = 0; eye < 2; eye++) {
+      unsigned att = eye ? right : left;
+      if (front && drawable->stvis.samples > 1)
+         dri_pipe_blit(pipe, drawable->textures[att], drawable->msaa_textures[att]);
+      u_box_2d(0, 0, drawable->w, drawable->h, &box);
+      pipe->resource_copy_region(pipe, target, 0, eye * drawable->w, 0, 0,
+                                 drawable->textures[att], 0, &box);
+   }
+   u_box_2d(0, 0, target->width0, target->height0, &box);
+   void *map = pipe->texture_map(pipe, target, 0, PIPE_MAP_READ, &box, &transfer);
+   if (!map)
+      return false;
+   drawable->screen->swrast_loader->putImage2(drawable, __DRI_SWRAST_IMAGE_OP_SWAP,
+      0, 0, target->width0, target->height0, transfer->stride, map,
+      drawable->loaderPrivate);
+   pipe->texture_unmap(pipe, transfer);
+   return true;
+}
