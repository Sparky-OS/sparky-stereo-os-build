+/* The declaration follows the swapchain that is current on the surface: when
+ * the layer's pair is no longer the one presented there (a swapchain the layer
+ * does not pack took its place, or it was destroyed with nothing after it),
+ * the surface no longer declares two views. On Wayland the declaration ends
+ * with the surface's next commit, the first picture of what comes next; on
+ * X11 the window shows one picture from its next frame on. A later pair on the
+ * surface declares it again, from the start.
+ */
+static void
+withdraw(struct surface_data *surface)
+{
+   if (surface->wayland) {
+      stereo_content_destroy(surface->u.wl.content);
+      surface->u.wl.content = NULL;
+      stereo_viewport_destroy(surface->u.wl.viewport);
+      surface->u.wl.viewport = NULL;
+      wl_display_flush(surface->u.wl.display);
+   } else if (surface->declared) {
+      xcb_window_t window = XCB_NONE;
+      xcb_connection_t *conn = x11_connection(surface, &window);
+      if (conn)
+         u_x11_stereo_withdraw(conn, window);
+   }
+   surface->declared = false;
+   surface->stereo_swapchain_created = false;
+   surface->current = NULL;
+   memset(&surface->pair, 0, sizeof(surface->pair));
+}
+
+/* A swapchain the layer does not pack becomes the one presented on the
+ * surface, and a declaration the layer made for an earlier pair there goes.
+ */
+static VkResult
+create_passed_through(struct device_data *data, struct surface_data *surface, VkDevice device,
+                      const VkSwapchainCreateInfoKHR *create_info,
+                      const VkAllocationCallbacks *allocator, VkSwapchainKHR *swapchain_handle)
+{
+   VkResult result = data->CreateSwapchain(device, create_info, allocator, swapchain_handle);
+   if (result == VK_SUCCESS && surface && surface->stereo_swapchain_created)
+      withdraw(surface);
+   return result;
+}
