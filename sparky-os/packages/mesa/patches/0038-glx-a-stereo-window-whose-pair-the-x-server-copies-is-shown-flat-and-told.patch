diff --git a/src/glx/glx_stereo_pair.c b/src/glx/glx_stereo_pair.c
new file mode 100644
index 0000000..5cd7bf6
--- /dev/null
+++ b/src/glx/glx_stereo_pair.c
@@ -0,0 +1,343 @@
+/*
+ * Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <errno.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <X11/Xatom.h>
+
+#include "glxclient.h"
+#include "dri_common.h"
+#include "glx_stereo_pair.h"
+#include "loader.h"
+#include "util/os_time.h"
+#include "util/u_process.h"
+
+#if defined(GLX_DIRECT_RENDERING) && (!defined(GLX_USE_APPLEGL) || defined(GLX_USE_APPLE))
+
+extern char **environ;
+
+/* The messages of the package that holds this library (debian/lang). */
+#define PROBLEMS_PACKAGE "libglx-mesa0"
+#define PROBLEMS_COMMAND "/usr/bin/sparky-stereo-problems"
+/* sparky-stereo-problems.h: the person's own problems */
+#define SSP_PERSON 2
+
+/* How many flips of the left view in a row bring the declaration back. */
+#define FLIPS_TO_RETURN 3
+
+#ifdef SPARKY_STEREO_PROBLEMS_LIBRARY
+
+typedef int (*ssp_keep_fn)(int, const char *, const char *, const char *,
+                           const char *const *, int, const char *);
+typedef int (*ssp_clear_fn)(int, const char *, const char *);
+typedef const char *(*ssp_error_fn)(void);
+
+static pthread_mutex_t problems_mutex = PTHREAD_MUTEX_INITIALIZER;
+static bool problems_opened;
+static ssp_keep_fn ssp_keep;
+static ssp_clear_fn ssp_clear;
+static ssp_error_fn ssp_error_en;
+
+/* The engine's library is private and of one architecture: it is opened at
+ * the first use, never linked, and a process that cannot load it (a 32-bit
+ * program) runs the engine's command.
+ */
+static bool
+problems_library(void)
+{
+   if (!problems_opened) {
+      void *lib = dlopen(SPARKY_STEREO_PROBLEMS_LIBRARY, RTLD_NOW | RTLD_LOCAL);
+
+      problems_opened = true;
+      if (lib) {
+         ssp_keep_fn keep = (ssp_keep_fn) dlsym(lib, "ssp_keep");
+         ssp_clear_fn clear = (ssp_clear_fn) dlsym(lib, "ssp_clear");
+
+         ssp_error_en = (ssp_error_fn) dlsym(lib, "ssp_error_en");
+         if (keep && clear && ssp_error_en) {
+            ssp_keep = keep;
+            ssp_clear = clear;
+         }
+      }
+   }
+   return ssp_keep != NULL;
+}
+
+/* Returns the command's exit status, or -1 when it could not be run. */
+static int
+problems_command(char *const argv[])
+{
+   pid_t pid;
+   int status;
+
+   if (posix_spawn(&pid, PROBLEMS_COMMAND, NULL, NULL, argv, environ) != 0)
+      return -1;
+   while (waitpid(pid, &status, 0) < 0) {
+      /* A program that reaps every child itself took the status. */
+      if (errno != EINTR)
+         return errno == ECHILD ? 0 : -1;
+   }
+   return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+}
+
+/* Writes {"severity":"SEVERITY","text_en":"TEXT"} with TEXT escaped; false when it does not fit. */
+static bool
+problems_details(char *out, size_t size, const char *severity, const char *text)
+{
+   size_t n = snprintf(out, size, "{\"severity\":\"%s\",\"text_en\":\"", severity);
+
+   for (; *text; text++) {
+      const unsigned char c = *text;
+
+      if (n + 8 > size)
+         return false;
+      if (c == '"' || c == '\\') {
+         out[n++] = '\\';
+         out[n++] = c;
+      } else {
+         out[n++] = c < 0x20 ? ' ' : c;
+      }
+   }
+   memcpy(out + n, "\"}", 3);
+   return true;
+}
+
+void
+glx_problem_keep(const char *key, const char *severity, const char *message,
+                 const char *arg0, const char *arg1, const char *text_en)
+{
+   const char *args[2] = { arg0, arg1 };
+   const int nargs = arg1 ? 2 : arg0 ? 1 : 0;
+   char details[2048];
+   bool kept = false;
+
+   glx_message(_LOADER_WARNING, "%s\n", text_en);
+   if (!problems_details(details, sizeof(details), severity, text_en)) {
+      glx_message(_LOADER_FATAL, "sparky-stereo-problems: the text of %s does not fit, the person cannot be told\n", key);
+      return;
+   }
+
+   pthread_mutex_lock(&problems_mutex);
+   if (problems_library()) {
+      kept = ssp_keep(SSP_PERSON, PROBLEMS_PACKAGE, key, message, args, nargs, details) == 0;
+      if (!kept)
+         glx_message(_LOADER_FATAL, "sparky-stereo-problems: %s could not be kept, the person cannot be told: %s\n",
+                     key, ssp_error_en());
+   } else {
+      char *argv[] = { (char *) "sparky-stereo-problems", (char *) "keep", (char *) "--person", (char *) "--quiet",
+                       (char *) "--details", details, (char *) PROBLEMS_PACKAGE, (char *) key, (char *) message,
+                       (char *) arg0, (char *) arg1, NULL };
+
+      kept = problems_command(argv) == 0;
+      if (!kept)
+         glx_message(_LOADER_FATAL, "sparky-stereo-problems: neither %s nor %s could keep %s, the person cannot be told\n",
+                     SPARKY_STEREO_PROBLEMS_LIBRARY, PROBLEMS_COMMAND, key);
+   }
+   pthread_mutex_unlock(&problems_mutex);
+}
+
+void
+glx_problem_clear(const char *key)
+{
+   /* The engine ends nothing that is not there, so a problem an earlier run
+    * of the program kept ends here too.
+    */
+   pthread_mutex_lock(&problems_mutex);
+   if (problems_library()) {
+      if (ssp_clear(SSP_PERSON, PROBLEMS_PACKAGE, key) != 0)
+         glx_message(_LOADER_WARNING, "sparky-stereo-problems: the earlier problem %s could not be ended: %s\n",
+                     key, ssp_error_en());
+   } else {
+      char *argv[] = { (char *) "sparky-stereo-problems", (char *) "clear", (char *) "--person",
+                       (char *) PROBLEMS_PACKAGE, (char *) key, NULL };
+
+      if (problems_command(argv) != 0)
+         glx_message(_LOADER_INFO, "sparky-stereo-problems: neither %s nor %s is here, nothing to end for %s\n",
+                     SPARKY_STEREO_PROBLEMS_LIBRARY, PROBLEMS_COMMAND, key);
+   }
+   pthread_mutex_unlock(&problems_mutex);
+}
+
+#else /* !SPARKY_STEREO_PROBLEMS_LIBRARY */
+
+void
+glx_problem_keep(const char *key, const char *severity, const char *message,
+                 const char *arg0, const char *arg1, const char *text_en)
+{
+   glx_message(_LOADER_WARNING, "%s\n", text_en);
+}
+
+void
+glx_problem_clear(const char *key)
+{
+}
+
+#endif
+
+/* The problem's key: one for each program, so that two programs neither hide
+ * nor end each other's.  The engine takes letters, digits and _ @ : + - .
+ */
+static void
+stereo_pair_key(char *key, size_t size, const char **program)
+{
+   const char *name = util_get_process_name();
+   size_t n;
+
+   if (!name || !*name)
+      name = "program";
+   *program = name;
+   n = snprintf(key, size, "stereo-pair:");
+   for (; *name && n + 1 < size; name++)
+      key[n++] = (*name >= '0' && *name <= '9') || (*name >= 'a' && *name <= 'z') ||
+                 (*name >= 'A' && *name <= 'Z') || strchr("_@+-.", *name) ? *name : '_';
+   key[n] = '\0';
+}
+
+static void
+stereo_pair_take_back(struct glx_stereo_pair *pair, Display *dpy, Window window, int width, int height)
+{
+   const char *program;
+   char key[96], detail[160], text[640];
+
+   /* The compositor shows the window's picture as it is from here: the copy
+    * left the left view in it.
+    */
+   XDeleteProperty(dpy, window, XInternAtom(dpy, "_KDE_NET_WM_STEREO_CONTENT", False));
+   XDeleteProperty(dpy, window, XInternAtom(dpy, "_KDE_NET_WM_STEREO_CONTENT_VERSION", False));
+   glx_x11_undeclare_stereo_child(dpy, window);
+   XFlush(dpy);
+
+   stereo_pair_key(key, sizeof(key), &program);
+   snprintf(detail, sizeof(detail),
+            "the X server completed the present of both pictures of window 0x%lx (%dx%d) as a copy%s",
+            (unsigned long) window, width, height,
+            pair->locked ? ", again after its left picture alone was shown whole" : "");
+   snprintf(text, sizeof(text),
+            "%s is shown flat: the desktop's X server could not show the two pictures of its 3D window "
+            "together, so the window shows the left picture alone. 3D returns by itself when the window can "
+            "show both again. Update Sparky Stereo OS and log in again; if the program stays flat, report it "
+            "with the program's name. Mesa says: %s", program, detail);
+   glx_problem_keep(key, "failed", "LOCAL2", program, detail, text);
+}
+
+enum glx_stereo_pair_change
+glx_stereo_pair_completed(struct glx_stereo_pair *pair, Display *dpy,
+                          Window window, bool flipped, int buffer_width,
+                          int buffer_height, int width, int height)
+{
+   if (width != pair->width || height != pair->height) {
+      /* Another size has other buffers: what failed at the old one is not known to fail here. */
+      pair->width = width;
+      pair->height = height;
+      pair->locked = false;
+      pair->failed_returns = 0;
+      pair->flat_flips = 0;
+   }
+
+   if (pair->flat || !pair->confirmed)
+      glx_message(_LOADER_DEBUG, "stereo pair: window 0x%lx %dx%d: a %dx%d buffer was %s (%s)\n",
+                  (unsigned long) window, width, height, buffer_width, buffer_height,
+                  flipped ? "flipped" : "copied", pair->flat ? "left view alone" : "both eyes");
+
+   /* A frame made for the size the window had before says nothing about
+    * the size it has now.
+    */
+   if (buffer_width != (pair->flat ? width : 2 * width) || buffer_height != height)
+      return GLX_STEREO_PAIR_SAME;
+
+   if (!pair->flat) {
+      if (flipped) {
+         pair->copied_once = false;
+         pair->confirmed = true;
+         pair->failed_returns = 0;
+         if (!pair->cleared) {
+            const char *program;
+            char key[96];
+
+            stereo_pair_key(key, sizeof(key), &program);
+            glx_problem_clear(key);
+            pair->cleared = true;
+         }
+         return GLX_STEREO_PAIR_SAME;
+      }
+
+      /* One copy can be a frame the server dropped while the window was
+       * being managed (unmapped and mapped again by the window manager): it
+       * completes as a copy and nothing was copied.  Two presents in a row,
+       * of the window's own size, are certain: the server says what it did
+       * with these very pixmaps.
+       */
+      if (!pair->copied_once) {
+         pair->copied_once = true;
+         pair->again = true;
+         return GLX_STEREO_PAIR_SAME;
+      }
+      pair->copied_once = false;
+      if (pair->returned && !pair->confirmed && ++pair->failed_returns >= 2)
+         pair->locked = true;
+      pair->flat = true;
+      pair->confirmed = false;
+      pair->cleared = false;
+      pair->flat_flips = 0;
+      stereo_pair_take_back(pair, dpy, window, width, height);
+      return GLX_STEREO_PAIR_TAKEN_BACK;
+   }
+
+   if (!flipped) {
+      pair->flat_flips = 0;
+      return GLX_STEREO_PAIR_SAME;
+   }
+   if (pair->locked || ++pair->flat_flips < FLIPS_TO_RETURN)
+      return GLX_STEREO_PAIR_SAME;
+
+   pair->flat = false;
+   pair->returned = true;
+   pair->flat_flips = 0;
+   return GLX_STEREO_PAIR_RETURNS;
+}
+
+bool
+glx_stereo_pair_wait(struct glx_stereo_pair *pair)
+{
+   const int64_t now = os_time_get();
+   const bool still = now - pair->last_swap > 100000;
+
+   pair->last_swap = now;
+   pair->again = false;
+   return !pair->flat && (!pair->confirmed || still);
+}
+
+bool
+glx_stereo_pair_again(struct glx_stereo_pair *pair)
+{
+   const bool again = pair->again && !pair->flat;
+
+   pair->again = false;
+   return again;
+}
+
+void
+glx_problem_zink_without_dri3(bool happening)
+{
+   static const char text[] =
+      "OpenGL programs draw on the processor in this session: OpenGL was set to run on the graphics card's "
+      "Vulkan driver (zink), which needs an X server with DRI3, and the desktop's X server (Xwayland) runs "
+      "without 3D acceleration. Programs work, more slowly. Log out and in again; if it repeats, look at the "
+      "graphics driver on the Graphics page of System Settings. Mesa says: MESA_LOADER_DRIVER_OVERRIDE=zink, "
+      "DRI3 not available";
+
+   if (happening)
+      glx_problem_keep("zink-without-dri3", "degraded", "LOCAL4", "MESA_LOADER_DRIVER_OVERRIDE=zink, DRI3 not available", NULL, text);
+   else
+      glx_problem_clear("zink-without-dri3");
+}
+
+#endif
diff --git a/src/glx/glx_stereo_pair.h b/src/glx/glx_stereo_pair.h
new file mode 100644
index 0000000..c6639b3
--- /dev/null
+++ b/src/glx/glx_stereo_pair.h
@@ -0,0 +1,93 @@
+/*
+ * Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A stereo window that stays one eye wide presents both eyes in one pixmap
+ * twice its width (declaration version 4).  The X server hands that pixmap to
+ * the compositor whole, or copies it into the window, which keeps the left
+ * eye only: under a stereo declaration the compositor would then show half of
+ * the left view to each eye.  PresentCompleteNotify tells which happened; when
+ * the pair was copied the declaration is taken back, the left view is
+ * presented alone at the window's size, and the person is told.
+ */
+
+#ifndef GLX_STEREO_PAIR_H
+#define GLX_STEREO_PAIR_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <X11/Xlib.h>
+
+struct glx_stereo_pair {
+   /* The declaration was taken back; the left view is presented alone. */
+   bool flat;
+   /* A pair of the window's size was flipped since it was last declared. */
+   bool confirmed;
+   /* The declaration returned at least once. */
+   bool returned;
+   /* It returned twice and the pair was copied at once each time: the
+    * left view flips and the pair does not, so nothing more is tried at
+    * this size.
+    */
+   bool locked;
+   /* An earlier problem of this program was ended. */
+   bool cleared;
+   /* The last pair was copied, and the one before was not. */
+   bool copied_once;
+   /* A swap that waited may present its pair once more to know for certain. */
+   bool again;
+   unsigned flat_flips;
+   unsigned failed_returns;
+   int width, height;
+   int64_t last_swap;
+};
+
+enum glx_stereo_pair_change {
+   GLX_STEREO_PAIR_SAME,
+   /* Present the left view alone from the next frame on. */
+   GLX_STEREO_PAIR_TAKEN_BACK,
+   /* Declare the window again and present both eyes from the next frame on. */
+   GLX_STEREO_PAIR_RETURNS,
+};
+
+/* The X server completed a present of a buffer buffer_width wide for a window
+ * width by height now; flipped: whole (PresentCompleteModeFlip).
+ */
+enum glx_stereo_pair_change
+glx_stereo_pair_completed(struct glx_stereo_pair *pair, Display *dpy,
+                          Window window, bool flipped, int buffer_width,
+                          int buffer_height, int width, int height);
+
+/* Whether a swap of both eyes waits for its own present to complete: until
+ * one pair was flipped, and whenever the program's last swap is more than a
+ * tenth of a second old, since this frame may then be the one that stays on
+ * the screen.  A program that animates learns of a copy at its next frame.
+ */
+bool
+glx_stereo_pair_wait(struct glx_stereo_pair *pair);
+
+/* After such a wait: whether the pair just presented was the first to be
+ * copied, so that the same pair is presented once more and waited for.  A
+ * program that goes on drawing presents its next frame instead.
+ */
+bool
+glx_stereo_pair_again(struct glx_stereo_pair *pair);
+
+/* The person is told through the distribution's place for failures (Sparky
+ * Stereo OS: sparky-stereo-problems) when Mesa is built with it, and the
+ * message goes to the log in every build.  severity is failed or degraded;
+ * message is one of the package's messages; text_en says the same in English
+ * with the arguments in place.
+ */
+void
+glx_problem_keep(const char *key, const char *severity, const char *message,
+                 const char *arg0, const char *arg1, const char *text_en);
+void
+glx_problem_clear(const char *key);
+
+/* MESA_LOADER_DRIVER_OVERRIDE=zink on an X server without DRI3. */
+void
+glx_problem_zink_without_dri3(bool happening);
+
+#endif
diff --git a/src/glx/glxext.c b/src/glx/glxext.c
index a8c8a1e..977e65b 100644
--- a/src/glx/glxext.c
+++ b/src/glx/glxext.c
@@ -19,6 +19,7 @@
 #include <stdarg.h>
 
 #include "glxclient.h"
+#include "glx_stereo_pair.h"
 #include <X11/extensions/Xext.h>
 #include <X11/extensions/extutil.h>
 #include <X11/Xatom.h>
@@ -1052,6 +1053,8 @@ __glXInitialize(Display * dpy)
    Bool glx_accel = !debug_get_bool_option("LIBGL_ALWAYS_SOFTWARE", false);
    Bool kopper = glx_kopper_enabled(dpy, DefaultScreen(dpy));
 
+   Bool zink_without_dri3 = False;
+
    if (env && !strcmp(env, "zink"))
       glx_driver |= GLX_DRIVER_ZINK_YES;
 
@@ -1090,9 +1093,15 @@ __glXInitialize(Display * dpy)
 #if !defined(GLX_USE_APPLEGL)
    if (!dpyPriv->has_multibuffer && glx_accel && !debug_get_bool_option("LIBGL_KOPPER_DRI2", false)) {
       if (glx_driver & GLX_DRIVER_ZINK_YES) {
-         /* only print error if zink was explicitly requested */
-         CriticalErrorMessageF("DRI3 not available\n");
-         goto init_fail;
+         /* zink was asked for and presents through DRI3 here (kopper is off,
+          * or has it no more than this server): the X server has none, as
+          * Xwayland without glamor.  A program would get no configuration at
+          * all; it draws on the software renderer, as with any other driver
+          * on such a server, and the person is told.
+          */
+         glx_problem_zink_without_dri3(true);
+         glx_driver &= ~GLX_DRIVER_ZINK_YES;
+         zink_without_dri3 = True;
       }
       /* if no dri3 and not using dri2, disable zink */
       glx_driver &= ~GLX_DRIVER_ZINK_INFER;
@@ -1114,6 +1123,14 @@ __glXInitialize(Display * dpy)
       goto init_fail;
 #endif
 
+#if defined(GLX_DIRECT_RENDERING) && (!defined(GLX_USE_APPLEGL) || defined(GLX_USE_APPLE))
+   /* zink with DRI3: an earlier session's problem is over */
+   if ((glx_driver & GLX_DRIVER_ZINK_YES) && dpyPriv->has_multibuffer)
+      glx_problem_zink_without_dri3(false);
+   if (zink_without_dri3)
+      env = NULL;
+#endif
+
