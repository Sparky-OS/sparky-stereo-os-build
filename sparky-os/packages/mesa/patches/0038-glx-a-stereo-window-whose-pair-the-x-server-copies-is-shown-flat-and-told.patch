+   xcb_flush(conn);
+   while ((ev = wait ? xcb_wait_for_special_event(conn, pdp->present_events)
+                     : xcb_poll_for_special_event(conn, pdp->present_events))) {
+      xcb_present_generic_event_t *ge = (void *) ev;
+
+      if (ge->evtype == XCB_PRESENT_EVENT_CONFIGURE_NOTIFY) {
+         xcb_present_configure_notify_event_t *ce = (void *) ev;
+
+         pdp->window_width = ce->width;
+         pdp->window_height = ce->height;
+      } else if (ge->evtype == XCB_PRESENT_EVENT_COMPLETE_NOTIFY) {
+         xcb_present_complete_notify_event_t *ce = (void *) ev;
