+static void
+drisw_present_events(struct drisw_drawable *pdp, bool wait)
+{
+   __GLXDRIdrawable *pdraw = &pdp->base;
+   xcb_connection_t *conn = XGetXCBConnection(pdraw->psc->dpy);
+   xcb_generic_event_t *ev;
