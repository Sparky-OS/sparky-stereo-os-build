+/* The window no longer holds two views: its window stops listing it. */
+void
+glx_x11_undeclare_stereo_child(Display *dpy, Window window)
+{
+   struct glx_display *display = __glXInitialize(dpy);
+   struct glx_stereo_tracker *tracker = display ? display->stereo_tracker : NULL;
+
+   if (!tracker)
+      return;
+   pthread_mutex_lock(&tracker->mutex);
+   for (struct glx_stereo_child **link = &tracker->children; *link; link = &(*link)->next) {
+      struct glx_stereo_child *child = *link;
+
+      if (child->window != window)
+         continue;
+      stereo_update_owner(tracker, child->owner, child->window, false);
+      *link = child->next;
+      free(child);
+      break;
+   }
+   stereo_reconcile(tracker);
+   xcb_flush(tracker->conn);
+   pthread_mutex_unlock(&tracker->mutex);
+}
