diff --git a/src/util/u_x11_stereo_doubled.h b/src/util/u_x11_stereo_doubled.h
new file mode 100644
index 0000000..84626d2
--- /dev/null
+++ b/src/util/u_x11_stereo_doubled.h
@@ -0,0 +1,132 @@
+/* Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ *
+ * A stereo window on an X server without DRI3 (Xwayland without glamor). There
+ * a driver's presentation puts its picture into the window itself with
+ * PutImage, so a picture of both views is whole only in a window two views
+ * wide. A compositor that announces version 3 or more of
+ * _KDE_NET_WM_STEREO_CONTENT_SUPPORTED makes a top-level window it manages,
+ * declared full side by side without _KDE_NET_WM_STEREO_CONTENT_VERSION 4,
+ * twice as wide itself, sends the program a synthetic ConfigureNotify of one
+ * view, and shows each half to its eye. With Xcb and Xlib a swapchain must be
+ * the window's size ("minImageExtent, maxImageExtent, and currentExtent must
+ * always equal the window size", VK_KHR_xcb_surface, VK_KHR_xlib_surface), so
+ * the swapchain of both views is made once the window has that width; the
+ * program keeps working in one view's size, the size the compositor tells it.
+ * A child window or an override-redirect one is not doubled.
+ */
+#ifndef U_X11_STEREO_DOUBLED_H
+#define U_X11_STEREO_DOUBLED_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <xcb/xcb.h>
+#include "u_x11_stereo_child.h"
+
+/* The server has DRI3, the route on which a packed pixmap is presented whole. */
+static inline bool
+u_x11_has_dri3(xcb_connection_t *conn)
+{
+   xcb_query_extension_reply_t *dri3 =
+      xcb_query_extension_reply(conn, xcb_query_extension(conn, 4, "DRI3"), NULL);
+   bool present = dri3 && dri3->present;
+   free(dri3);
+   return present;
+}
+
+/* Why the compositor will not make this window two views wide, or NULL when it
+ * will: it announces version 3 or more, and the window is a top-level that is
+ * not override-redirect (below the root, or a window manager's WM_STATE on it,
+ * ICCCM 4.1.3.1, once it was reparented into a frame). */
+static inline const char *
+u_x11_stereo_not_doubled(xcb_connection_t *conn, xcb_window_t window, uint32_t support)
+{
+   if (support < 3)
+      return "the desktop does not make a stereo window two views wide (it announces an older stereo declaration)";
+   xcb_get_window_attributes_reply_t *attributes =
+      xcb_get_window_attributes_reply(conn, xcb_get_window_attributes(conn, window), NULL);
+   if (!attributes)
+      return "the window is gone";
+   bool override_redirect = attributes->override_redirect;
+   free(attributes);
+   if (override_redirect)
+      return "the window is override-redirect: no window manager places it";
+   xcb_query_tree_reply_t *tree = xcb_query_tree_reply(conn, xcb_query_tree(conn, window), NULL);
+   if (!tree)
+      return "the window is gone";
+   bool below_root = tree->parent == tree->root;
+   free(tree);
+   if (below_root)
+      return NULL;
+   xcb_atom_t wm_state = u_x11_stereo_atom(conn, "WM_STATE", true);
+   if (wm_state != XCB_ATOM_NONE) {
+      xcb_get_property_reply_t *state = xcb_get_property_reply(
+         conn, xcb_get_property(conn, 0, window, wm_state, XCB_GET_PROPERTY_TYPE_ANY, 0, 1), NULL);
+      bool managed = state && state->type != XCB_ATOM_NONE;
+      free(state);
+      if (managed)
+         return NULL;
+   }
+   return "the window is a child of another window";
+}
+
+/* Declares the window full side by side for the compositor to make it two
+ * views wide: _KDE_NET_WM_STEREO_CONTENT 3 and no declaration version (version
+ * 3, the default). */
+static inline void
+u_x11_stereo_declare_doubled(xcb_connection_t *conn, xcb_window_t window, uint32_t support)
+{
+   xcb_delete_property(conn, window,
+                       u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT_VERSION", false));
+   const uint32_t layout = 3;
+   xcb_change_property(conn, XCB_PROP_MODE_REPLACE, window,
+                       u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT", false),
+                       XCB_ATOM_CARDINAL, 32, 1, &layout);
+   if (support >= 5)
+      u_x11_stereo_list_child(conn, window);
+   xcb_flush(conn);
+}
+
+/* How long to wait for the compositor to give the window its new width:
+ * MESA_STEREO_DOUBLING_WAIT_MS, 1000 by default, 0 for not at all (as the
+ * gl-stereo layer's GL_STEREO_DOUBLING_WAIT_MS). */
+static inline unsigned
+u_x11_stereo_doubling_wait_ms(void)
+{
+   const char *s = getenv("MESA_STEREO_DOUBLING_WAIT_MS");
+   if (!s || !*s)
+      return 1000;
+   char *end;
+   unsigned long ms = strtoul(s, &end, 10);
+   return *end || ms > 60000 ? 1000 : (unsigned)ms;
+}
+
+/* Waits, at most wait_ms and only while the window is mapped (an unmapped one
+ * is sized when the window manager takes it), for the X server to report the
+ * window WIDTH wide. Returns the width the window has. */
+static inline uint32_t
+u_x11_stereo_wait_width(xcb_connection_t *conn, xcb_window_t window, uint32_t width, unsigned wait_ms)
+{
+   uint32_t now = 0;
+   for (unsigned ms = 0;; ms += 10) {
+      xcb_get_geometry_reply_t *geometry =
+         xcb_get_geometry_reply(conn, xcb_get_geometry(conn, window), NULL);
+      now = geometry ? geometry->width : 0;
+      free(geometry);
+      if (!now || now == width || ms >= wait_ms)
+         return now;
+      xcb_get_window_attributes_reply_t *attributes =
+         xcb_get_window_attributes_reply(conn, xcb_get_window_attributes(conn, window), NULL);
+      bool mapped = attributes && attributes->map_state != XCB_MAP_STATE_UNMAPPED;
+      free(attributes);
+      if (!mapped)
+         return now;
+      nanosleep(&(struct timespec){ 0, 10 * 1000 * 1000 }, NULL);
+   }
+}
+
+#endif
