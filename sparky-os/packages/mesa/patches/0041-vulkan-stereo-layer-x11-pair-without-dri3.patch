+static bool
+x11_without_dri3(struct surface_data *surface)
+{
+   if (surface->wayland)
+      return false;
+   if (surface->dri3 < 0) {
+      xcb_window_t window = XCB_NONE;
+      xcb_connection_t *conn = x11_connection(surface, &window);
+      surface->dri3 = conn && u_x11_has_dri3(conn);
+   }
+   return !surface->dri3;
+}
+
+/* Why the compositor will not make this X11 window two views wide, or NULL. */
+static const char *
+x11_not_doubled(struct surface_data *surface)
+{
+   xcb_window_t window = XCB_NONE;
+   xcb_connection_t *conn = x11_connection(surface, &window);
+   return u_x11_stereo_not_doubled(conn, window, surface_support_version(surface));
+}
+
+/* Without DRI3 the window is declared for the compositor to make it two views
+ * wide (version 3), and the driver's swapchain of both views is made once it
+ * is, as the gl-stereo layer waits: a mapped window, at most
+ * MESA_STEREO_DOUBLING_WAIT_MS. The compositor may double it later (it may be
+ * busy, or the window not mapped yet); the driver's swapchain is then out of
+ * date, as for any resize of an X11 window, and the next one has the width. */
+static void
+x11_double(struct surface_data *surface, uint32_t view_width)
+{
+   xcb_window_t window = XCB_NONE;
+   xcb_connection_t *conn = x11_connection(surface, &window);
+   if (!surface->doubled || !surface->declared) {
+      u_x11_stereo_declare_doubled(conn, window, surface_support_version(surface));
+      surface->declared = true;
+      surface->doubled = true;
+      surface->doubled_seen = false;
+   }
+   surface->view_width = view_width;
+   const unsigned wait_ms = u_x11_stereo_doubling_wait_ms();
+   const uint32_t width = u_x11_stereo_wait_width(conn, window, 2 * view_width, wait_ms);
+   if (width == 2 * view_width)
+      surface->doubled_seen = true;
+   else
+      fprintf(stderr, "Mesa stereo layer: the desktop has not made window 0x%lx two views wide (%u) "
+                      "within %u ms, it is %u wide; the program's swapchain goes out of date when it is.\n",
+              (unsigned long)window, 2 * view_width, wait_ms, width);
+}
+
+/* The window shows its two views: the X server has reported it two views wide. */
+static bool
+x11_doubled_shown(struct surface_data *surface)
+{
+   if (!surface->doubled_seen) {
+      xcb_window_t window = XCB_NONE;
+      xcb_connection_t *conn = x11_connection(surface, &window);
+      xcb_get_geometry_reply_t *geometry =
+         xcb_get_geometry_reply(conn, xcb_get_geometry(conn, window), NULL);
+      surface->doubled_seen = geometry && geometry->width == 2 * surface->view_width;
+      free(geometry);
+   }
+   return surface->doubled_seen;
+}
+
+/* one-view:vulkan:DEVICE, the device's name as vkGetPhysicalDeviceProperties gives it */
+static void
+one_view_key(struct device_data *data, char *key, size_t size, char *device, size_t device_size)
+{
+   VkPhysicalDeviceProperties properties;
+   memset(&properties, 0, sizeof(properties));
+   if (data->instance->GetProperties)
+      data->instance->GetProperties(data->physical, &properties);
+   snprintf(device, device_size, "%s", properties.deviceName[0] ? properties.deviceName : "Vulkan device");
+   size_t n = snprintf(key, size, "one-view:vulkan:");
+   for (const char *c = device; *c && n + 1 < size; c++)
+      key[n++] = (*c >= '0' && *c <= '9') || (*c >= 'a' && *c <= 'z') ||
+                 (*c >= 'A' && *c <= 'Z') || strchr("_@+-.", *c) ? *c : '_';
+   key[n] = 0;
+}
+
+/* A program asked for two views where the layer cannot give them: the person
+ * is told through sparky-stereo-problems, once per device (ORDER 573's shape). */
+static void
+one_view_problem(struct device_data *data, struct surface_data *surface, const char *why)
+{
+   char key[160], device[VK_MAX_PHYSICAL_DEVICE_NAME_SIZE], detail[320], text[1024];
+   xcb_window_t window = XCB_NONE;
+   x11_connection(surface, &window);
+   one_view_key(data, key, sizeof(key), device, sizeof(device));
+   const char *program = util_get_process_name();
+   if (!program || !*program)
+      program = "program";
+   snprintf(detail, sizeof(detail),
+            "the X server has no DRI3, where the two views reach the desktop only in a window it makes two views "
+            "wide, and window 0x%lx cannot be: %s", (unsigned long)window, why);
+   snprintf(text, sizeof(text),
+            "%s asked for two pictures of its window, one for each eye, on %s, and could not be given them: the "
+            "desktop's X server (Xwayland) runs without 3D acceleration, and there the two pictures reach the "
+            "desktop only in a program's own main window. Log out and in again; if it repeats, look at the graphics "
+            "driver on the Graphics page of System Settings, and report it with the program's name. Mesa says: %s",
+            program, device, detail);
+   const char *args[] = { program, device, detail };
+   u_stereo_problem_keep_args("mesa-vulkan-layer-stereo", key, "failed", "LOCAL4", args, 3, text);
+   data->pair_shown = false;
+}
+
+/* A pair of this device was shown, which ends the device's one-view problem;
+ * the engine ends nothing that is not there, so once per process is enough. */
+static void
+pair_shown(struct device_data *data)
+{
+   if (data->pair_shown)
+      return;
+   char key[160], device[VK_MAX_PHYSICAL_DEVICE_NAME_SIZE];
+   one_view_key(data, key, sizeof(key), device, sizeof(device));
+   u_stereo_problem_clear("mesa-vulkan-layer-stereo", key);
+   data->pair_shown = true;
+}
+
