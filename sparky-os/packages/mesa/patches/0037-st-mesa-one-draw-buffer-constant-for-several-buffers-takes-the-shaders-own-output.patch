+/**
+ * The shader's output at location 0 becomes the color that the drivers write
+ * to every color buffer (what gl_FragColor is), and its other color outputs
+ * go: with one glDrawBuffer constant their draw buffers are GL_NONE
+ * (OpenGL 4.6 core, 17.4.1).
+ */
+static bool
+color0_to_all_cbufs_instr(nir_builder *b, nir_intrinsic_instr *intr,
+                          void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+
+   if (sem.location == FRAG_RESULT_DATA0) {
+      sem.location = FRAG_RESULT_COLOR;
+      nir_intrinsic_set_io_semantics(intr, sem);
+      return true;
+   }
+
+   if (sem.location > FRAG_RESULT_DATA0 && sem.location <= FRAG_RESULT_DATA7) {
+      nir_instr_remove(&intr->instr);
+      return true;
+   }
+
+   return false;
+}
+
 static struct st_fp_variant *
 st_create_fp_variant(struct st_context *st,
                      struct gl_program *fp,
@@ -1092,6 +1121,11 @@
       finalize = true;
    }
 
+   if (key->color0_to_all_cbufs) {
+      NIR_PASS(finalize, state.ir.nir, nir_shader_intrinsics_pass,
+               color0_to_all_cbufs_instr, nir_metadata_control_flow, NULL);
+   }
+
    if (key->clamp_color) {
       NIR_PASS(_, state.ir.nir, nir_lower_clamp_color_outputs);
    }
