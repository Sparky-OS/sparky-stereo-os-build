 /**
+ * OpenGL 4.6 core, 17.4.1 "Selecting Buffers for Writing": for the default
+ * framebuffer one glDrawBuffer constant specifies "zero, one, two, or four
+ * buffers", the set "to which fragment color zero is written". GL_BACK of a
+ * stereo window is the left and the right back buffer.
+ *
+ * _mesa_drawbuffers() then lists those buffers as color buffers 0..n-1 while
+ * only ColorDrawBuffer[0] holds a constant. The drivers write gl_FragColor to
+ * every color buffer, but a shader's own output at location 0 only to the
+ * first, so such a shader drew in the left eye alone.
+ */
+static bool
+color0_goes_to_several_buffers(const struct gl_context *ctx,
+                               const struct gl_program *fp)
+{
+   const struct gl_framebuffer *fb = ctx->DrawBuffer;
+
+   return fb && _mesa_is_winsys_fbo(fb) &&
+          fb->_NumColorDrawBuffers > 1 &&
+          fb->_ColorDrawBufferIndexes[1] != BUFFER_NONE &&
+          fb->ColorDrawBuffer[1] == GL_NONE &&
+          (fp->info.outputs_written & BITFIELD64_BIT(FRAG_RESULT_DATA0)) &&
+          !fp->info.fs.color_is_dual_source;
+}
+
+/**
  * Update fragment program state/atom.  This involves translating the
  * Mesa fragment program into a gallium fragment program and binding it.
  */
@@ -125,7 +151,8 @@
