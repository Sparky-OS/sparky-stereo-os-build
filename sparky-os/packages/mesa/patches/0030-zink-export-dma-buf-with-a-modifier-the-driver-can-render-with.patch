+         if (p->drmFormatModifierPlaneCount == 1 && util_bitcount(p->drmFormatModifierTilingFeatures) > util_bitcount(best))
+            best = p->drmFormatModifierTilingFeatures;
       }
+      for (unsigned i = 0; i < prop->drmFormatModifierCount; i++) {
+         const VkDrmFormatModifierPropertiesEXT *p = &prop->pDrmFormatModifierProperties[i];
+         if (p->drmFormatModifierPlaneCount != 1 || (p->drmFormatModifierTilingFeatures & best) != best)
