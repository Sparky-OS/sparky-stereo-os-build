+      const struct zink_modifier_props *prop = zink_get_modifier_props(screen, res->base.b.format);
+      VkFormatFeatureFlags best = 0;
+      bool linear_is_best = false;
+      unsigned candidates = 0;
+      for (unsigned i = 0; i < prop->drmFormatModifierCount; i++) {
