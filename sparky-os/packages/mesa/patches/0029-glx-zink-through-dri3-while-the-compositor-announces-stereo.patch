diff --git a/src/glx/glxext.c b/src/glx/glxext.c
index 5d7dc63..a8c8a1e 100644
--- a/src/glx/glxext.c
+++ b/src/glx/glxext.c
@@ -125,6 +125,19 @@ glx_x11_stereo_supported(Display *dpy, int screen)
    return glx_x11_stereo_support_version(dpy, screen) >= 2;
 }
 
+/* Kopper, zink's own window system path, has no second view of a window:
+ * only zink through DRI3 does. While the compositor announces stereo content,
+ * GLX takes that route on its own. LIBGL_KOPPER_DISABLE=0 keeps kopper and
+ * LIBGL_KOPPER_DISABLE=1 drops it, whatever the compositor says.
+ */
+bool
+glx_kopper_enabled(Display *dpy, int screen)
+{
+   if (os_get_option("LIBGL_KOPPER_DISABLE"))
+      return !debug_get_bool_option("LIBGL_KOPPER_DISABLE", false);
+   return !glx_x11_stereo_supported(dpy, screen);
+}
