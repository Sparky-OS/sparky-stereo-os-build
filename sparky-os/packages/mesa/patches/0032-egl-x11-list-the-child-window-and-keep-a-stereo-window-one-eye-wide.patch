+/* A stereo window that stays one eye wide shows a buffer twice its width:
+ * both eyes go into a pixmap of that size, presented to the window, which
+ * Xwayland hands to the compositor as it is. */
+static xcb_pixmap_t
+swrast_stereo_pixmap(struct dri2_egl_display *dri2_dpy,
+                     struct dri2_egl_surface *dri2_surf, int op, int x, int y,
+                     int *w, int *h)
+{
+   if (!dri2_surf->x11_stereo_one_eye || op != __DRI_SWRAST_IMAGE_OP_SWAP ||
+       x != 0 || y != 0)
+      return XCB_NONE;
+   /* the image is the packed buffer, which may be padded beyond both eyes */
+   *w = MIN2(*w, 2 * dri2_surf->base.Width);
+   *h = MIN2(*h, dri2_surf->base.Height);
+   xcb_pixmap_t pixmap = xcb_generate_id(dri2_dpy->conn);
+   xcb_create_pixmap(dri2_dpy->conn, dri2_surf->depth, pixmap,
+                     dri2_surf->drawable, *w, *h);
+   return pixmap;
+}
+
+static void
+swrast_stereo_present(struct dri2_egl_display *dri2_dpy,
+                      struct dri2_egl_surface *dri2_surf, xcb_pixmap_t pixmap)
+{
+   if (!pixmap)
+      return;
+   xcb_present_pixmap(dri2_dpy->conn, dri2_surf->drawable, pixmap, 0, 0, 0, 0,
+                      0, 0, 0, 0, XCB_PRESENT_OPTION_NONE, 0, 0, 0, 0, NULL);
+   xcb_free_pixmap(dri2_dpy->conn, pixmap);
+}
