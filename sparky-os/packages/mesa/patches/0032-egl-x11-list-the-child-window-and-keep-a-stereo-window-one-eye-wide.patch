+/*
+ * Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ *
+ * The X11 side of a stereo area that is a child window: the window lists the
+ * child in _KDE_NET_WM_STEREO_CONTENT_CHILDREN (WINDOW/32) so that the
+ * compositor shows the child's own surface one view per eye while the rest of
+ * the window stays the same in both eyes. GLX does this with an observer
+ * thread (src/glx/dri_common.c); EGL on X11 and the Vulkan paths use these
+ * calls, once, when the child declares its stereo content.
+ */
+#ifndef U_X11_STEREO_CHILD_H
+#define U_X11_STEREO_CHILD_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xcb/xcb.h>
+
+static inline xcb_atom_t
+u_x11_stereo_atom(xcb_connection_t *conn, const char *name, bool only_if_exists)
+{
+   xcb_intern_atom_reply_t *reply = xcb_intern_atom_reply(
+      conn, xcb_intern_atom(conn, only_if_exists, strlen(name), name), NULL);
+   xcb_atom_t atom = reply ? reply->atom : XCB_ATOM_NONE;
+   free(reply);
+   return atom;
+}
+
+/* The version of the declaration the compositor announces on the root window,
+ * 0 without one. */
+static inline uint32_t
+u_x11_stereo_support_version(xcb_connection_t *conn, xcb_window_t root)
+{
+   xcb_atom_t atom = u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT_SUPPORTED", true);
+   if (atom == XCB_ATOM_NONE)
+      return 0;
+   xcb_get_property_reply_t *reply = xcb_get_property_reply(
+      conn, xcb_get_property(conn, 0, root, atom, XCB_ATOM_CARDINAL, 0, 1), NULL);
+   uint32_t version = reply && reply->format == 32 &&
+                      xcb_get_property_value_length(reply) >= (int)sizeof(uint32_t) ?
+                      *(const uint32_t *)xcb_get_property_value(reply) : 0;
+   free(reply);
+   return version;
+}
+
+/* The window that holds the child: the one below the root on the way up, as
+ * GLX takes it. XCB_WINDOW_NONE when the child is itself below the root or its
+ * ancestors cannot be read. */
+static inline xcb_window_t
+u_x11_stereo_owner(xcb_connection_t *conn, xcb_window_t child)
+{
+   xcb_window_t window = child;
+   for (int depth = 0; depth < 64; depth++) {
+      xcb_query_tree_reply_t *tree =
+         xcb_query_tree_reply(conn, xcb_query_tree(conn, window), NULL);
+      if (!tree)
+         return XCB_WINDOW_NONE;
+      xcb_window_t parent = tree->parent, root = tree->root;
+      free(tree);
+      if (parent == root || parent == XCB_WINDOW_NONE)
+         return window == child ? XCB_WINDOW_NONE : window;
+      window = parent;
+   }
+   return XCB_WINDOW_NONE;
+}
+
+/* Writes _KDE_NET_WM_STEREO_CONTENT_VERSION on the window. */
+static inline void
+u_x11_stereo_set_version(xcb_connection_t *conn, xcb_window_t window, uint32_t version)
+{
+   xcb_atom_t atom = u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT_VERSION", false);
+   if (atom != XCB_ATOM_NONE)
+      xcb_change_property(conn, XCB_PROP_MODE_REPLACE, window, atom,
+                          XCB_ATOM_CARDINAL, 32, 1, &version);
+}
+
+/* Adds the child to its owner's _KDE_NET_WM_STEREO_CONTENT_CHILDREN once, and
+ * leaves it there while its window lives (the compositor follows the child's
+ * DestroyNotify). Windows that are gone leave the list when a child is added.
+ * Nothing is done for a child that is below the root: a stereo top-level
+ * declares itself. */
+static inline void
+u_x11_stereo_list_child(xcb_connection_t *conn, xcb_window_t child)
+{
+   xcb_window_t owner = u_x11_stereo_owner(conn, child);
+   xcb_atom_t atom = u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT_CHILDREN", false);
+   if (owner == XCB_WINDOW_NONE || atom == XCB_ATOM_NONE)
+      return;
+
+   /* the read, the change and the write must not interleave with another client's */
+   xcb_grab_server(conn);
+   xcb_get_property_reply_t *property = xcb_get_property_reply(
+      conn, xcb_get_property(conn, false, owner, atom, XCB_ATOM_WINDOW, 0, UINT32_MAX / 4), NULL);
+   if (property && (property->type == XCB_NONE ||
+                    (property->type == XCB_ATOM_WINDOW && property->format == 32))) {
+      unsigned count = property->type == XCB_NONE ? 0 : xcb_get_property_value_length(property) / 4;
+      const xcb_window_t *old = count ? xcb_get_property_value(property) : NULL;
+      xcb_window_t *updated = malloc((count + 1) * sizeof(*updated));
+      if (updated) {
+         unsigned n = 0;
+         bool found = false;
+         for (unsigned i = 0; i < count; i++) {
+            if (old[i] == child) {
+               if (found)
+                  continue;
+               found = true;
+            } else {
+               xcb_get_window_attributes_reply_t *attributes = xcb_get_window_attributes_reply(
+                  conn, xcb_get_window_attributes(conn, old[i]), NULL);
+               if (!attributes)
+                  continue;
+               free(attributes);
+            }
+            updated[n++] = old[i];
+         }
+         if (!found)
+            updated[n++] = child;
+         if (!found || n != count || memcmp(old, updated, n * sizeof(*updated)))
+            free(xcb_request_check(conn, xcb_change_property_checked(
+               conn, XCB_PROP_MODE_REPLACE, owner, atom, XCB_ATOM_WINDOW, 32, n, updated)));
+         free(updated);
+      }
+   }
+   free(property);
+   xcb_ungrab_server(conn);
+   xcb_flush(conn);
+}
+
+#endif
