diff --git a/src/util/u_x11_stereo_present.h b/src/util/u_x11_stereo_present.h
new file mode 100644
index 0000000..3e0cf34
--- /dev/null
+++ b/src/util/u_x11_stereo_present.h
@@ -0,0 +1,76 @@
+/* Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef U_X11_STEREO_PRESENT_H
+#define U_X11_STEREO_PRESENT_H
+#include <stdio.h>
+#include "u_stereo_pair.h"
+#include "u_stereo_problem.h"
+#include "u_process.h"
+#include "u_x11_stereo_child.h"
+
+static inline void
+u_x11_stereo_unlist_child(xcb_connection_t *conn, xcb_window_t window)
+{
+   xcb_window_t owner = u_x11_stereo_owner(conn, window);
+   if (!owner)
+      return;
+   xcb_atom_t atom = u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT_CHILDREN", false);
+   xcb_grab_server(conn);
+   xcb_get_property_reply_t *r = xcb_get_property_reply(conn,
+      xcb_get_property(conn, false, owner, atom, XCB_ATOM_WINDOW, 0, UINT32_MAX / 4), NULL);
+   if (r && r->type == XCB_ATOM_WINDOW && r->format == 32) {
+      unsigned n = xcb_get_property_value_length(r) / 4, count = 0;
+      xcb_window_t *ids = xcb_get_property_value(r);
+      for (unsigned i=0; i<n; i++)
+         if (ids[i] != window) ids[count++] = ids[i];
+      if (count)
+         xcb_change_property(conn, XCB_PROP_MODE_REPLACE, owner, atom, XCB_ATOM_WINDOW, 32, count, ids);
+      else
+         xcb_delete_property(conn, owner, atom);
+   }
+   free(r);
+   xcb_ungrab_server(conn);
+}
+
+static inline enum u_stereo_pair_change
+u_x11_stereo_present_completed(struct u_stereo_pair *pair, xcb_connection_t *conn,
+ xcb_window_t window, const char *package, bool flipped, int buffer_width,
+ int buffer_height, int width, int height)
+{
+   if (getenv("LIBGL_DEBUG") && strstr(getenv("LIBGL_DEBUG"), "verbose"))
+      fprintf(stderr, "%s stereo Present %s: buffer %dx%d window %dx%d flat=%d\n",
+         package, flipped ? "flip" : "copy", buffer_width, buffer_height, width, height, pair->flat);
+   bool cleared = pair->cleared;
+   enum u_stereo_pair_change change = u_stereo_pair_completed(pair, flipped,
+      buffer_width, buffer_height, width, height);
+   char key[96];
+   const char *program = util_get_process_name();
+   if (!program || !*program) program = "program";
+   unsigned n = snprintf(key, sizeof key, "stereo-pair:");
+   for (const char *s=program; *s && n+1<sizeof key; s++)
+      key[n++] = (*s>='0' && *s<='9') || (*s>='a' && *s<='z') ||
+                  (*s>='A' && *s<='Z') || strchr("_@+-.", *s) ? *s : '_';
+   key[n] = 0;
+   if (change == U_STEREO_PAIR_TAKEN_BACK) {
+      xcb_delete_property(conn, window, u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT", false));
+      xcb_delete_property(conn, window, u_x11_stereo_atom(conn, "_KDE_NET_WM_STEREO_CONTENT_VERSION", false));
+      u_x11_stereo_unlist_child(conn, window);
+      xcb_flush(conn);
+      char detail[160], text[640];
+      snprintf(detail, sizeof detail,
+         "the X server completed the present of both pictures of window 0x%lx (%dx%d) as a copy%s",
+         (unsigned long)window, width, height,
+         pair->locked ? ", again after its left picture alone was shown whole" : "");
+      snprintf(text, sizeof text,
+         "%s is shown flat: the desktop's X server could not show the two pictures of its 3D window "
+         "together, so the window shows the left picture alone. 3D returns by itself when the window can "
+         "show both again. Update Sparky Stereo OS and log in again; if the program stays flat, report it "
+         "with the program's name. Mesa says: %s", program, detail);
+      u_stereo_problem_keep(package, key, "failed", "LOCAL2", program, detail, text);
+   } else if (!cleared && pair->cleared) {
+      u_stereo_problem_clear(package, key);
+   }
+   return change;
+}
+#endif
