+/* The downstream WSI owns packed images, including while the declaration is
+ * taken back. A window-sized Present of its left picture tests whether a
+ * complete single view can flip, without changing the application's swapchain
+ * or reading any image back to the CPU.
+ */
+static bool
+x11_flat_probe(struct swapchain_data *swapchain)
+{
+   struct surface_data *surface = swapchain->surface;
+   xcb_window_t window = XCB_NONE;
+   xcb_connection_t *conn = x11_connection(surface, &window);
+   xcb_get_geometry_reply_t *g = xcb_get_geometry_reply(conn,
+      xcb_get_geometry(conn, window), NULL);
+   if (!g) return false;
+   xcb_pixmap_t pixmap = xcb_generate_id(conn);
+   xcb_gcontext_t gc = xcb_generate_id(conn);
+   xcb_create_pixmap(conn, g->depth, pixmap, window, swapchain->width, swapchain->height);
+   uint32_t include = XCB_SUBWINDOW_MODE_INCLUDE_INFERIORS;
+   xcb_create_gc(conn, gc, pixmap, XCB_GC_SUBWINDOW_MODE, &include);
+   xcb_copy_area(conn, window, pixmap, gc, 0, 0, 0, 0,
