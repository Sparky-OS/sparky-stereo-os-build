new file mode 100644
index 0000000..e37e568
--- /dev/null
+++ b/src/util/tests/stereo_pair_test.cpp
@@ -0,0 +1,65 @@
+/* Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT */
+#include <gtest/gtest.h>
+#include "util/u_stereo_pair.h"
+
+TEST(stereo_pair, copied_pair_and_recovery)
+{
+   u_stereo_pair p = {};
+   EXPECT_TRUE(u_stereo_pair_wait(&p));
+   EXPECT_EQ(U_STEREO_PAIR_SAME, u_stereo_pair_completed(&p, false, 1600,600,800,600));
+   EXPECT_FALSE(p.flat);
+   EXPECT_TRUE(u_stereo_pair_again(&p));
+   EXPECT_FALSE(u_stereo_pair_again(&p));
+   EXPECT_EQ(U_STEREO_PAIR_TAKEN_BACK, u_stereo_pair_completed(&p,false,1600,600,800,600));
+   EXPECT_TRUE(p.flat);
+   EXPECT_FALSE(u_stereo_pair_again(&p));
+   for (int i=0;i<2;i++)
+      EXPECT_EQ(U_STEREO_PAIR_SAME,u_stereo_pair_completed(&p,true,800,600,800,600));
+   EXPECT_EQ(U_STEREO_PAIR_RETURNS,u_stereo_pair_completed(&p,true,800,600,800,600));
+   EXPECT_FALSE(p.flat);
+   EXPECT_EQ(U_STEREO_PAIR_SAME,u_stereo_pair_completed(&p,true,1600,600,800,600));
+   EXPECT_TRUE(p.confirmed);
+   EXPECT_TRUE(p.cleared);
+}
+
+TEST(stereo_pair, dropped_first_frame_and_old_size)
+{
+   u_stereo_pair p = {};
+   u_stereo_pair_completed(&p,false,1600,600,800,600);
+   u_stereo_pair_completed(&p,true,1600,600,800,600);
+   EXPECT_FALSE(p.copied_once);
+   EXPECT_FALSE(p.flat);
+   for(int i=0;i<5;i++)
+      u_stereo_pair_completed(&p,false,1600,600,900,600);
+   EXPECT_FALSE(p.flat);
+   EXPECT_FALSE(p.copied_once);
+}
+
+TEST(stereo_pair, copy_interrupts_recovery)
+{
+   u_stereo_pair p = {};
+   u_stereo_pair_completed(&p,false,1600,600,800,600);
+   u_stereo_pair_completed(&p,false,1600,600,800,600);
+   u_stereo_pair_completed(&p,true,800,600,800,600);
+   u_stereo_pair_completed(&p,true,800,600,800,600);
+   u_stereo_pair_completed(&p,false,800,600,800,600);
+   EXPECT_EQ(0u,p.flat_flips);
+   EXPECT_EQ(U_STEREO_PAIR_SAME,u_stereo_pair_completed(&p,true,800,600,800,600));
+   EXPECT_TRUE(p.flat);
+}
+
+TEST(stereo_pair, repeat_failed_return_locks_only_this_size)
+{
+   u_stereo_pair p = {};
+   for(int attempt=0; attempt<3;attempt++) {
+      u_stereo_pair_completed(&p,false,1600,600,800,600);
+      EXPECT_EQ(U_STEREO_PAIR_TAKEN_BACK,u_stereo_pair_completed(&p,false,1600,600,800,600));
+      for(int i=0;i<3;i++) u_stereo_pair_completed(&p,true,800,600,800,600);
+   }
+   EXPECT_TRUE(p.flat);
+   EXPECT_TRUE(p.locked);
+   u_stereo_pair_completed(&p,true,900,600,900,600);
+   EXPECT_FALSE(p.locked);
+   EXPECT_EQ(0u,p.failed_returns);
+}
diff --git a/src/util/u_stereo_pair.h b/src/util/u_stereo_pair.h
new file mode 100644
index 0000000..5df2527
--- /dev/null
+++ b/src/util/u_stereo_pair.h
@@ -0,0 +1,125 @@
+/* Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef U_STEREO_PAIR_H
+#define U_STEREO_PAIR_H
+#include <stdbool.h>
+#include <stdint.h>
+#include "util/os_time.h"
+struct u_stereo_pair {
+   /* The declaration was taken back; the left view is presented alone. */
+   bool flat;
+   /* A pair of the window's size was flipped since it was last declared. */
+   bool confirmed;
+   /* The declaration returned at least once. */
+   bool returned;
+   /* It returned twice and the pair was copied at once each time: the
+    * left view flips and the pair does not, so nothing more is tried at
+    * this size.
+    */
+   bool locked;
+   /* An earlier problem of this program was ended. */
+   bool cleared;
+   /* The last pair was copied, and the one before was not. */
+   bool copied_once;
+   /* A swap that waited may present its pair once more to know for certain. */
+   bool again;
+   unsigned flat_flips;
+   unsigned failed_returns;
+   int width, height;
+   int64_t last_swap;
+};
+
+enum u_stereo_pair_change {
+   U_STEREO_PAIR_SAME,
+   /* Present the left view alone from the next frame on. */
+   U_STEREO_PAIR_TAKEN_BACK,
+   /* Declare the window again and present both eyes from the next frame on. */
+   U_STEREO_PAIR_RETURNS,
+};
+
+static inline enum u_stereo_pair_change
+u_stereo_pair_completed(struct u_stereo_pair *pair, bool flipped, int buffer_width,
+                          int buffer_height, int width, int height)
+{
+   if (width != pair->width || height != pair->height) {
+      /* Another size has other buffers: what failed at the old one is not known to fail here. */
+      pair->width = width;
+      pair->height = height;
+      pair->locked = false;
+      pair->failed_returns = 0;
+      pair->flat_flips = 0;
+   }
+
+   /* A frame made for the size the window had before says nothing about
+    * the size it has now.
+    */
+   if (buffer_width != (pair->flat ? width : 2 * width) || buffer_height != height)
+      return U_STEREO_PAIR_SAME;
+
+   if (!pair->flat) {
+      if (flipped) {
+         pair->copied_once = false;
+         pair->confirmed = true;
+         pair->failed_returns = 0;
+         if (!pair->cleared) {
+            pair->cleared = true;
+         }
+         return U_STEREO_PAIR_SAME;
+      }
+
+      /* One copy can be a frame the server dropped while the window was
+       * being managed (unmapped and mapped again by the window manager): it
+       * completes as a copy and nothing was copied.  Two presents in a row,
+       * of the window's own size, are certain: the server says what it did
+       * with these very pixmaps.
+       */
+      if (!pair->copied_once) {
+         pair->copied_once = true;
+         pair->again = true;
+         return U_STEREO_PAIR_SAME;
+      }
+      pair->copied_once = false;
+      if (pair->returned && !pair->confirmed && ++pair->failed_returns >= 2)
+         pair->locked = true;
+      pair->flat = true;
+      pair->confirmed = false;
+      pair->cleared = false;
+      pair->flat_flips = 0;
+      return U_STEREO_PAIR_TAKEN_BACK;
+   }
+
+   if (!flipped) {
+      pair->flat_flips = 0;
+      return U_STEREO_PAIR_SAME;
+   }
+   if (pair->locked || ++pair->flat_flips < 3)
+      return U_STEREO_PAIR_SAME;
+
+   pair->flat = false;
+   pair->returned = true;
+   pair->flat_flips = 0;
+   return U_STEREO_PAIR_RETURNS;
+}
+
+static inline bool
+u_stereo_pair_wait(struct u_stereo_pair *pair)
+{
+   const int64_t now = os_time_get();
+   const bool still = now - pair->last_swap > 100000;
+
+   pair->last_swap = now;
+   pair->again = false;
+   return !pair->flat && (!pair->confirmed || still);
+}
+
+static inline bool
+u_stereo_pair_again(struct u_stereo_pair *pair)
+{
+   const bool again = pair->again && !pair->flat;
+
+   pair->again = false;
+   return again;
+}
+
+#endif
diff --git a/src/util/u_stereo_problem.c b/src/util/u_stereo_problem.c
new file mode 100644
index 0000000..5f7dad5
--- /dev/null
+++ b/src/util/u_stereo_problem.c
@@ -0,0 +1,169 @@
+/* Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ */
+#include <errno.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include "u_stereo_problem.h"
+extern char **environ;
+
+/* The messages of the package that holds this library (debian/lang). */
+#define PROBLEMS_COMMAND "/usr/bin/sparky-stereo-problems"
+/* sparky-stereo-problems.h: the person's own problems */
+#define SSP_PERSON 2
+
+#ifdef SPARKY_STEREO_PROBLEMS_LIBRARY
+
+typedef int (*ssp_keep_fn)(int, const char *, const char *, const char *,
+                           const char *const *, int, const char *);
+typedef int (*ssp_clear_fn)(int, const char *, const char *);
+typedef const char *(*ssp_error_fn)(void);
+
+static pthread_mutex_t problems_mutex = PTHREAD_MUTEX_INITIALIZER;
+static bool problems_opened;
+static ssp_keep_fn ssp_keep;
+static ssp_clear_fn ssp_clear;
+static ssp_error_fn ssp_error_en;
+
+/* The engine's library is private and of one architecture: it is opened at
+ * the first use, never linked, and a process that cannot load it (a 32-bit
+ * program) runs the engine's command.
+ */
+static bool
+problems_library(void)
+{
+   if (!problems_opened) {
+      void *lib = dlopen(SPARKY_STEREO_PROBLEMS_LIBRARY, RTLD_NOW | RTLD_LOCAL);
+
+      problems_opened = true;
+      if (lib) {
+         ssp_keep_fn keep = (ssp_keep_fn) dlsym(lib, "ssp_keep");
+         ssp_clear_fn clear = (ssp_clear_fn) dlsym(lib, "ssp_clear");
+
+         ssp_error_en = (ssp_error_fn) dlsym(lib, "ssp_error_en");
+         if (keep && clear && ssp_error_en) {
+            ssp_keep = keep;
+            ssp_clear = clear;
+         }
+      }
+   }
+   return ssp_keep != NULL;
+}
+
+/* Returns the command's exit status, or -1 when it could not be run. */
+static int
+problems_command(char *const argv[])
+{
+   pid_t pid;
+   int status;
+
+   if (posix_spawn(&pid, PROBLEMS_COMMAND, NULL, NULL, argv, environ) != 0)
+      return -1;
+   while (waitpid(pid, &status, 0) < 0) {
+      /* A program that reaps every child itself took the status. */
+      if (errno != EINTR)
+         return errno == ECHILD ? 0 : -1;
+   }
+   return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+}
+
+/* Writes {"severity":"SEVERITY","text_en":"TEXT"} with TEXT escaped; false when it does not fit. */
+static bool
+problems_details(char *out, size_t size, const char *severity, const char *text)
+{
+   size_t n = snprintf(out, size, "{\"severity\":\"%s\",\"text_en\":\"", severity);
+
+   for (; *text; text++) {
+      const unsigned char c = *text;
+
+      if (n + 8 > size)
+         return false;
+      if (c == '"' || c == '\\') {
+         out[n++] = '\\';
+         out[n++] = c;
+      } else {
+         out[n++] = c < 0x20 ? ' ' : c;
+      }
+   }
+   memcpy(out + n, "\"}", 3);
+   return true;
+}
+
+void
+u_stereo_problem_keep(const char *package, const char *key, const char *severity, const char *message,
+                 const char *arg0, const char *arg1, const char *text_en)
+{
+   const char *args[2] = { arg0, arg1 };
+   const int nargs = arg1 ? 2 : arg0 ? 1 : 0;
+   char details[2048];
+   bool kept = false;
+
+   fprintf(stderr, "%s\n", text_en);
+   if (!problems_details(details, sizeof(details), severity, text_en)) {
+      fprintf(stderr, "sparky-stereo-problems: the text of %s does not fit, the person cannot be told\n", key);
+      return;
+   }
+
+   pthread_mutex_lock(&problems_mutex);
+   if (problems_library()) {
+      kept = ssp_keep(SSP_PERSON, package, key, message, args, nargs, details) == 0;
+      if (!kept)
+         fprintf(stderr, "sparky-stereo-problems: %s could not be kept, the person cannot be told: %s\n",
+                     key, ssp_error_en());
+   } else {
+      char *argv[] = { (char *) "sparky-stereo-problems", (char *) "keep", (char *) "--person", (char *) "--quiet",
+                       (char *) "--details", details, (char *) package, (char *) key, (char *) message,
+                       (char *) arg0, (char *) arg1, NULL };
+
+      kept = problems_command(argv) == 0;
+      if (!kept)
+         fprintf(stderr, "sparky-stereo-problems: neither %s nor %s could keep %s, the person cannot be told\n",
+                     SPARKY_STEREO_PROBLEMS_LIBRARY, PROBLEMS_COMMAND, key);
+   }
+   pthread_mutex_unlock(&problems_mutex);
+}
+
+void
+u_stereo_problem_clear(const char *package, const char *key)
+{
+   /* The engine ends nothing that is not there, so a problem an earlier run
+    * of the program kept ends here too.
+    */
+   pthread_mutex_lock(&problems_mutex);
+   if (problems_library()) {
+      if (ssp_clear(SSP_PERSON, package, key) != 0)
+         fprintf(stderr, "sparky-stereo-problems: the earlier problem %s could not be ended: %s\n",
+                     key, ssp_error_en());
+   } else {
+      char *argv[] = { (char *) "sparky-stereo-problems", (char *) "clear", (char *) "--person",
+                       (char *) package, (char *) key, NULL };
+
+      if (problems_command(argv) != 0)
+         fprintf(stderr, "sparky-stereo-problems: neither %s nor %s is here, nothing to end for %s\n",
+                     SPARKY_STEREO_PROBLEMS_LIBRARY, PROBLEMS_COMMAND, key);
+   }
+   pthread_mutex_unlock(&problems_mutex);
+}
+
+#else /* !SPARKY_STEREO_PROBLEMS_LIBRARY */
+
+void
+u_stereo_problem_keep(const char *package, const char *key, const char *severity, const char *message,
+                 const char *arg0, const char *arg1, const char *text_en)
+{
+   fprintf(stderr, "%s\n", text_en);
+}
+
+void
+u_stereo_problem_clear(const char *package, const char *key)
+{
+}
+
+#endif
+
