diff --git a/src/vulkan/stereo-layer/x11_left.h b/src/vulkan/stereo-layer/x11_left.h
new file mode 100644
index 0000000..a1f220b
--- /dev/null
+++ b/src/vulkan/stereo-layer/x11_left.h
@@ -0,0 +1,206 @@
+/* Copyright 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: MIT
+ *
+ * An opaque one-layer WSI still presents a packed image after take-back.
+ * Its copied window is not a source of the left view: an offset or a smaller
+ * pixmap may already have replaced part of it with the right view. Read the
+ * retained left image, without resizing it, into an ordinary window-sized
+ * Present pixmap. This transfer runs only while the pair cannot be presented.
+ */
+#include "util/half_float.h"
+
+static unsigned
+x11_left_pixel_size(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM: case VK_FORMAT_B8G8R8A8_SRGB:
+   case VK_FORMAT_R8G8B8A8_UNORM: case VK_FORMAT_R8G8B8A8_SRGB:
+   case VK_FORMAT_A8B8G8R8_UNORM_PACK32: case VK_FORMAT_A8B8G8R8_SRGB_PACK32:
+   case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+   case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+      return 4;
+   case VK_FORMAT_R16G16B16A16_SFLOAT:
+   case VK_FORMAT_R16G16B16A16_UNORM:
+      return 8;
+   default:
+      return 0;
+   }
+}
+
+/* X11's TrueColor channel masks, including 30-bit visuals. Preserve encoded
+ * sRGB bytes; this is a transfer, not another colour-space conversion.
+ */
+static uint32_t
+x11_left_pixel(const uint8_t *src, VkFormat format, const uint32_t masks[4])
+{
+   uint32_t c[4], max = 255, v;
+   memcpy(&v, src, 4);
+   switch (format) {
+   case VK_FORMAT_B8G8R8A8_UNORM: case VK_FORMAT_B8G8R8A8_SRGB:
+      c[0] = src[2]; c[1] = src[1]; c[2] = src[0]; c[3] = src[3];
+      break;
+   case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+      c[0] = (v >> 20) & 1023; c[1] = (v >> 10) & 1023; c[2] = v & 1023;
+      max = 1023; c[3] = (v >> 30) * 341;
+      break;
+   case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+      c[0] = v & 1023; c[1] = (v >> 10) & 1023; c[2] = (v >> 20) & 1023;
+      max = 1023; c[3] = (v >> 30) * 341;
+      break;
+   case VK_FORMAT_R16G16B16A16_SFLOAT:
+   case VK_FORMAT_R16G16B16A16_UNORM:
+      max = 65535;
+      for (unsigned i = 0; i < 4; i++) {
+         uint16_t h;
+         memcpy(&h, src + 2 * i, 2);
+         if (format == VK_FORMAT_R16G16B16A16_UNORM) c[i] = h;
+         else {
+            float f = _mesa_half_to_float(h);
+            c[i] = !(f > 0) ? 0 : f >= 1 ? max : (uint32_t)(f * max + 0.5f);
+         }
+      }
+      break;
+   default:
+      c[0] = src[0]; c[1] = src[1]; c[2] = src[2]; c[3] = src[3];
+      break;
+   }
+   uint32_t pixel = 0;
+   for (unsigned i = 0; i < 4; i++) {
+      if (!masks[i]) continue;
+      unsigned shift = __builtin_ctz(masks[i]);
+      uint32_t channel_max = masks[i] >> shift;
+      pixel |= (uint32_t)(((uint64_t)c[i] * channel_max + max / 2) / max) << shift;
+   }
+   return pixel;
+}
+
+static void
+x11_left_finish(struct swapchain_data *swapchain)
+{
+   struct device_data *d = swapchain->device;
+   if (swapchain->left_map) d->UnmapMemory(d->device, swapchain->left_memory);
+   if (swapchain->left_buffer) d->DestroyBuffer(d->device, swapchain->left_buffer, NULL);
+   if (swapchain->left_memory) d->FreeMemory(d->device, swapchain->left_memory, NULL);
+   swapchain->left_map = NULL;
+   swapchain->left_buffer = VK_NULL_HANDLE;
+   swapchain->left_memory = VK_NULL_HANDLE;
+}
+
+static bool
+x11_left(struct swapchain_data *swapchain, VkQueue queue, unsigned image)
+{
+   struct device_data *d = swapchain->device;
+   unsigned bpp = x11_left_pixel_size(swapchain->format);
+   if (!bpp) {
+      fprintf(stderr, "Mesa stereo layer: cannot transfer the left view of X11 format %u\n", swapchain->format);
+      return false;
+   }
+   if (!swapchain->left_buffer) {
+      VkBufferCreateInfo buffer = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+         .size = (VkDeviceSize)swapchain->width * swapchain->height * bpp,
+         .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT };
+      if (d->CreateBuffer(d->device, &buffer, NULL, &swapchain->left_buffer) != VK_SUCCESS)
+         goto fail;
+      VkMemoryRequirements req;
+      d->GetBufferMemoryRequirements(d->device, swapchain->left_buffer, &req);
+      unsigned type = 0;
+      for (; type < d->memory.memoryTypeCount; type++)
+         if ((req.memoryTypeBits & (1u << type)) &&
+             (d->memory.memoryTypes[type].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) break;
+      if (type == d->memory.memoryTypeCount) goto fail;
+      VkMemoryAllocateInfo alloc = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+         .allocationSize = req.size, .memoryTypeIndex = type };
+      if (d->AllocateMemory(d->device, &alloc, NULL, &swapchain->left_memory) != VK_SUCCESS ||
+          d->BindBufferMemory(d->device, swapchain->left_buffer, swapchain->left_memory, 0) != VK_SUCCESS ||
+          d->MapMemory(d->device, swapchain->left_memory, 0, VK_WHOLE_SIZE, 0, &swapchain->left_map) != VK_SUCCESS)
+         goto fail;
+   }
+   if (d->QueueWaitIdle(queue) != VK_SUCCESS ||
+       d->ResetCommandBuffer(swapchain->command, 0) != VK_SUCCESS) goto fail;
+   VkCommandBufferBeginInfo begin = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+   if (d->BeginCommandBuffer(swapchain->command, &begin) != VK_SUCCESS) goto fail;
+   VkImageMemoryBarrier barrier = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_MEMORY_READ_BIT, .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = swapchain->images[image], .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 } };
+   d->CmdPipelineBarrier(swapchain->command, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &barrier);
+   VkBufferImageCopy copy = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+      .imageExtent = { swapchain->width, swapchain->height, 1 } };
+   d->CmdCopyImageToBuffer(swapchain->command, swapchain->images[image],
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, swapchain->left_buffer, 1, &copy);
+   barrier.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+   barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT;
+   barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+   barrier.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+   VkBufferMemoryBarrier host = { .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .buffer = swapchain->left_buffer, .size = VK_WHOLE_SIZE };
+   d->CmdPipelineBarrier(swapchain->command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT | VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 1, &host, 1, &barrier);
+   if (d->EndCommandBuffer(swapchain->command) != VK_SUCCESS) goto fail;
+   VkSubmitInfo submit = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1, .pCommandBuffers = &swapchain->command };
+   if (d->QueueSubmit(queue, 1, &submit, VK_NULL_HANDLE) != VK_SUCCESS ||
+       d->QueueWaitIdle(queue) != VK_SUCCESS) goto fail;
+   VkMappedMemoryRange range = { .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+      .memory = swapchain->left_memory, .size = VK_WHOLE_SIZE };
+   if (d->InvalidateMappedMemoryRanges(d->device, 1, &range) != VK_SUCCESS) goto fail;
+   xcb_window_t window = XCB_NONE;
+   xcb_connection_t *conn = x11_connection(swapchain->surface, &window);
+   xcb_get_geometry_reply_t *g = xcb_get_geometry_reply(conn, xcb_get_geometry(conn, window), NULL);
+   xcb_get_window_attributes_reply_t *a = xcb_get_window_attributes_reply(conn,
+      xcb_get_window_attributes(conn, window), NULL);
+   uint32_t masks[4] = {0};
+   const xcb_setup_t *setup = xcb_get_setup(conn);
+   for (xcb_screen_iterator_t s = xcb_setup_roots_iterator(setup); s.rem; xcb_screen_next(&s))
+      for (xcb_depth_iterator_t depth = xcb_screen_allowed_depths_iterator(s.data); depth.rem; xcb_depth_next(&depth))
+         for (xcb_visualtype_iterator_t v = xcb_depth_visuals_iterator(depth.data); v.rem; xcb_visualtype_next(&v))
+            if (a && v.data->visual_id == a->visual) {
+               masks[0] = v.data->red_mask; masks[1] = v.data->green_mask; masks[2] = v.data->blue_mask;
+            }
+   free(a);
+   if (g && g->depth == 32) masks[3] = ~(masks[0] | masks[1] | masks[2]);
+   unsigned pixel_bits = 0;
+   for (xcb_format_iterator_t f = xcb_setup_pixmap_formats_iterator(setup); f.rem; xcb_format_next(&f))
+      if (g && f.data->depth == g->depth) pixel_bits = f.data->bits_per_pixel;
+   if (!g || pixel_bits != 32 || !masks[0] || !masks[1] || !masks[2]) { free(g); goto fail; }
+   uint32_t *pixels = malloc((size_t)swapchain->width * swapchain->height * 4);
+   if (!pixels) { free(g); goto fail; }
+   for (size_t i = 0, n = (size_t)swapchain->width * swapchain->height; i < n; i++) {
+      uint32_t pixel = x11_left_pixel((const uint8_t *)swapchain->left_map + i * bpp, swapchain->format, masks);
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+      if (setup->image_byte_order == XCB_IMAGE_ORDER_MSB_FIRST) pixel = __builtin_bswap32(pixel);
+#else
+      if (setup->image_byte_order == XCB_IMAGE_ORDER_LSB_FIRST) pixel = __builtin_bswap32(pixel);
+#endif
+      pixels[i] = pixel;
+   }
+   xcb_pixmap_t pixmap = xcb_generate_id(conn);
+   xcb_gcontext_t gc = xcb_generate_id(conn);
+   xcb_create_pixmap(conn, g->depth, pixmap, window, swapchain->width, swapchain->height);
+   xcb_create_gc(conn, gc, pixmap, 0, NULL);
+   unsigned rows = (xcb_get_maximum_request_length(conn) * 4 - 128) / (swapchain->width * 4);
+   if (!rows) { free(pixels); free(g); xcb_free_gc(conn, gc); xcb_free_pixmap(conn, pixmap); goto fail; }
+   for (unsigned y = 0; y < swapchain->height; y += rows) {
+      unsigned h = MIN2(rows, swapchain->height - y);
+      xcb_put_image(conn, XCB_IMAGE_FORMAT_Z_PIXMAP, pixmap, gc, swapchain->width, h,
+         0, y, 0, g->depth, swapchain->width * h * 4, (uint8_t *)(pixels + (size_t)y * swapchain->width));
+   }
+   free(pixels); free(g);
+   uint32_t serial = ++swapchain->surface->probe_serial;
+   xcb_present_pixmap(conn, window, pixmap, serial, XCB_NONE, XCB_NONE,
+      0, 0, XCB_NONE, XCB_NONE, XCB_NONE, XCB_PRESENT_OPTION_NONE, 0, 0, 0, 0, NULL);
+   xcb_flush(conn);
+   int mode = x11_completion(swapchain->surface, serial, true);
+   x11_completed(swapchain, mode);
+   xcb_free_gc(conn, gc); xcb_free_pixmap(conn, pixmap);
+   return mode >= 0;
+fail:
+   fprintf(stderr, "Mesa stereo layer: could not transfer its complete left image to the X11 window\n");
+   x11_left_finish(swapchain);
+   return false;
+}
