+/* Each subscriber has its own Present event id. Register it as a special
+ * queue, so neither the application nor the driver's WSI consumes our events.
+ */
+static xcb_connection_t *
+x11_connection(struct surface_data *surface, xcb_window_t *window)
+{
+   if (surface->xcb) {
+      *window = surface->u.xcb.window;
+      return surface->u.xcb.connection;
+   }
+   if (surface->xlib) {
+      *window = surface->u.xlib.window;
+      return XGetXCBConnection(surface->u.xlib.display);
+   }
+   return NULL;
+}
+
+static bool
+x11_watch(struct surface_data *surface)
+{
+   xcb_window_t window = XCB_NONE;
+   xcb_connection_t *conn = x11_connection(surface, &window);
+   if (!conn || surface->wayland)
+      return false;
+   if (surface->present_event)
+      return true;
+   surface->present_eid = xcb_generate_id(conn);
+   surface->present_event = xcb_register_for_special_xge(conn, &xcb_present_id,
+                                                       surface->present_eid, NULL);
+   xcb_void_cookie_t cookie = xcb_present_select_input_checked(conn,
+      surface->present_eid, window, XCB_PRESENT_EVENT_MASK_COMPLETE_NOTIFY);
+   xcb_generic_error_t *error = xcb_request_check(conn, cookie);
+   if (error) {
+      free(error);
+      xcb_unregister_for_special_event(conn, surface->present_event);
+      surface->present_event = NULL;
+   }
+   return surface->present_event != NULL;
+}
+
+static int
+x11_completion(struct surface_data *surface, uint32_t serial, bool own)
+{
+   xcb_window_t window = XCB_NONE;
+   xcb_connection_t *conn = x11_connection(surface, &window);
+   xcb_generic_event_t *event;
+   while ((event = xcb_wait_for_special_event(conn, surface->present_event))) {
+      xcb_present_complete_notify_event_t *complete = (void *)event;
+      bool wanted = complete->event_type == XCB_PRESENT_COMPLETE_NOTIFY &&
+         complete->kind == XCB_PRESENT_COMPLETE_KIND_PIXMAP &&
+         (!own || complete->serial == serial);
+      int mode = complete->mode;
+      free(event);
+      if (wanted)
+         return mode;
+   }
+   return -1;
+}
+
+static void
+x11_completed(struct swapchain_data *swapchain, int mode)
+{
+   if (mode < 0 || mode == XCB_PRESENT_COMPLETE_MODE_SKIP)
+      return;
+   struct surface_data *surface = swapchain->surface;
+   xcb_window_t window = XCB_NONE;
+   xcb_connection_t *conn = x11_connection(surface, &window);
+   xcb_get_geometry_reply_t *geometry = xcb_get_geometry_reply(conn,
+      xcb_get_geometry(conn, window), NULL);
+   if (!geometry)
+      return;
+   enum u_stereo_pair_change change = u_x11_stereo_present_completed(
+      &surface->pair, conn, window, "mesa-vulkan-layer-stereo", mode == XCB_PRESENT_COMPLETE_MODE_FLIP,
+      (surface->pair.flat ? 1 : 2) * swapchain->width, swapchain->height,
+      geometry->width, geometry->height);
+   free(geometry);
+   if (change == U_STEREO_PAIR_RETURNS) {
+      if (surface->xcb) declare_xcb(surface);
+      else declare_xlib(surface);
+   }
+}
