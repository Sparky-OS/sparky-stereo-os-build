+void KItemListStereoSurface::keepPictures(const QImage &holes, QImage *left, QImage *right) const
+{
+    // Only the stereo pictures show through the window: elsewhere the surface stays clear, so that where the window
+    // itself is clear (its rounded corners) whatever is behind it shows, as without stereo.
+    // The holes are the pixels the window's pass left clear, row by row; rows with the same holes make one band.
+    QList<QRect> rects;
+    QList<QPair<int, int>> last;
+    int lastTop = 0;
+    const auto flush = [&rects, &last, &lastTop](int bottom) {
+        for (const auto &run : std::as_const(last)) {
+            rects.append(QRect(run.first, lastTop, run.second - run.first, bottom - lastTop));
+        }
+    };
+    for (int y = 0; y < holes.height(); ++y) {
+        const QRgb *line = reinterpret_cast<const QRgb *>(holes.constScanLine(y));
+        QList<QPair<int, int>> runs;
+        for (int x = 0; x < holes.width(); ++x) {
+            if (qAlpha(line[x]) == 0) {
+                const int start = x;
+                while (x < holes.width() && qAlpha(line[x]) == 0) {
+                    ++x;
+                }
+                runs.append({start, x});
+            }
+        }
+        if (runs != last) {
+            flush(y);
+            last = runs;
+            lastTop = y;
+        }
+    }
+    flush(holes.height());
     QRegion pictures;
-    const auto rects = view->stereoPictureRects();
-    for (const QRectF &rect : rects) {
-        // The pixels the window clears for the picture: its edges rounded, as QPainter fills a rectangle
-        const QRectF mapped = m_graphicsView->viewportTransform().mapRect(rect);
-        const QRect pixels(QPoint(qRound(mapped.left()), qRound(mapped.top())), QPoint(qRound(mapped.right()) - 1, qRound(mapped.bottom()) - 1));
-        pictures += pixels.adjusted(-margin, -margin, margin, margin);
+    pictures.setRects(rects.constData(), rects.size());
+    // A pixel of the window more around each picture covers its edges where the window is opaque; where the view
+    // goes without the window background, the window's own pixels there would be drawn over the surface's, so the
+    // surface keeps the pictures alone.
+    if (m_windowBackgroundBehind) {
+        const int margin = qCeil(holes.devicePixelRatio());
+        QRegion grown;
+        for (const QRect &rect : pictures) {
+            grown += rect.adjusted(-margin, -margin, margin, margin);
+        }
+        pictures = grown;
+    }
+    for (QImage *eye : {left, right}) {
+        // in device pixels
+        const qreal ratio = eye->devicePixelRatio();
+        eye->setDevicePixelRatio(1);
+        QPainter painter(eye);
+        painter.setClipRegion(QRegion(eye->rect()).subtracted(pictures));
+        painter.setCompositionMode(QPainter::CompositionMode_Clear);
+        painter.fillRect(eye->rect(), Qt::transparent);
+        painter.end();
+        eye->setDevicePixelRatio(ratio);
     }
