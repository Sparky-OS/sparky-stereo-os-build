 {
-    return hasStereoPicture() ? QRectF(m_pixmapPos, QSizeF(m_scaledPixmapSize)) : QRectF();
+    if (!hasStereoPicture()) {
+        return QRectF();
+    }
+    // The pixels drawPixmap() covers: at a scale that is not whole the pixmap is drawn with a whole number of device
+    // pixels, which is not m_scaledPixmapSize times the scale but that product rounded
+    const qreal dpr = KItemViewsUtils::devicePixelRatio(this);
+    const QSize pixels = m_scaledPixmapSize != m_pixmap.size() / m_pixmap.devicePixelRatio() ? m_scaledPixmapSize * dpr : m_pixmap.size();
+    return QRectF(m_pixmapPos, QSizeF(pixels) / dpr);
 }
 
