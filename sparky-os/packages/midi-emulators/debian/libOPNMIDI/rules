#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DlibOPNMIDI_SHARED=ON -DlibOPNMIDI_STATIC=OFF -DWITH_HQ_RESAMPLER=ON -DWITH_MIDIPLAY=OFF -DUSE_MAME_EMULATOR=OFF -DUSE_MAME_2608_EMULATOR=OFF -DUSE_NP2_EMULATOR=OFF -DUSE_YMFM_EMULATOR=OFF -DUSE_NUKED_OPNA_LLE_EMULATOR=OFF -DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH)
