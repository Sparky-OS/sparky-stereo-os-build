-    (QWidgetPrivate::paintSiblingsRecursive()), into a backing store twice as wide, the left eye
-    first; the platform hands the pair over as the desktop's own depth (_q_stereo_pair).
-    Render-to-texture widgets are composited per window, and a frame the client draws around the
-    window would be drawn into one half only, so a window that has either is painted once.
+    and awake), or elements inside the window declare their own depth and the platform says the
+    window is awake (declaredDepthShown()). Such a window is painted once per eye, each widget moved
+    by its own eye shift (QWidgetPrivate::paintSiblingsRecursive()), into a backing store twice as
+    wide, the left eye first; the platform hands the pair over as the desktop's own depth
+    (_q_stereo_pair). Render-to-texture widgets are composited per window, and a frame the client
+    draws around the window would be drawn into one half only, so a window that has either is
+    painted once.
 */
 static bool paintsPerEye(QWidget *tlw)
 {
     const QWindow *window = tlw->windowHandle();
-    if (!window || !window->property("_q_stereo_depth").toBool())
+    if (!window || !(window->property("_q_stereo_depth").toBool() || declaredDepthShown(tlw)))
         return false;
     const bool hasFrame = !window->frameMargins().isNull();
     if (hasFrame && !window->property("_q_stereo_csd_pair_supported").toBool())
@@ -786,6 +840,9 @@ void QWidgetRepaintManager::paintAndFlush()
