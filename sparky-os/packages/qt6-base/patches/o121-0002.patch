+namespace {
+// A view that paints a desk (grey, with a red and a blue mark) and a page on it (white, with a green
+// mark), the way a document viewer paints its pages in one widget.
+class PaperView : public QWidget
+{
+public:
+    using QWidget::QWidget;
+    static constexpr QRect page{30, 5, 40, 30};
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.fillRect(rect(), Qt::gray);
+        p.fillRect(QRect(10, 0, 1, height()), Qt::red);
+        p.fillRect(QRect(90, 0, 1, height()), Qt::blue);
+        p.fillRect(page, Qt::white);
+        p.fillRect(QRect(50, page.top(), 1, page.height()), Qt::green);
+    }
+};
+} // namespace
+
+/*
+    A widget declares rectangles inside it at their own depth (_q_stereo_depth_rects), in steps of
+    the person's element limit, which the platform gives the window with whether it is awake
+    (_q_stereo_awake, _q_stereo_element_limit). Its window is then painted once per eye whatever
+    style draws it: here the desk one step down, the page at the view's plane with its mark, the
+    strip of desk beside the page that a shift uncovers continued from the desk next to it, a child
+    widget at the view's plane, nothing moved outside the view. With the limit at 0, or the window
+    not awake, it is painted once, exactly as before.
+*/
+void tst_QWidgetRepaintManager::paintRectsAtTheirDepth()
+{
+    if (QGuiApplication::platformName() != QLatin1String("offscreen"))
+        QSKIP("Reads the offscreen backing store");
+
+    QWidget window(nullptr, Qt::FramelessWindowHint);
+    window.setGeometry(QRect(QPoint(100, 100), QSize(120, 60)));
+    QPalette palette = window.palette();
+    palette.setColor(QPalette::Window, Qt::white);
+    window.setPalette(palette);
+    window.setAutoFillBackground(true);
+    auto *view = new PaperView(&window);
+    view->setGeometry(10, 10, 100, 40);
+    filled(view, QRect(80, 30, 10, 5), Qt::yellow);
+    window.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&window));
+    QPlatformBackingStore *store = window.backingStore()->handle();
+    if (store->toImage().devicePixelRatio() != 1)
+        QSKIP("Measures in whole device pixels");
+    const QImage flat = store->toImage().copy(0, 0, 120, 60);
+
+    view->setProperty("_q_stereo_depth_rects", QVariantList{
+            QVariantMap{{QStringLiteral("rect"), view->rect()}, {QStringLiteral("depth"), -1.0}},
+            QVariantMap{{QStringLiteral("rect"), PaperView::page}, {QStringLiteral("depth"), 0.0}}});
+    QVERIFY(window.windowHandle()->property("_q_stereo_follow_depth").toBool());
+    QTest::qWait(50);
+    // not awake: painted once
+    QCOMPARE(store->toImage().width(), 120);
+    QCOMPARE(store->toImage(), flat);
+
+    // awake, and one step is 2 device pixels on this screen: the desk 1 to the left in the left
+    // eye and 1 to the right in the right eye, as Stereo KWin splits a parallax of -2
+    const int screenWidth = window.screen()->geometry().width();
+    window.windowHandle()->setProperty("_q_stereo_awake", true);
+    window.windowHandle()->setProperty("_q_stereo_element_limit", 2.0 * 1920 / screenWidth);
+    QTRY_COMPARE(store->toImage().width(), 240);
+    QVERIFY(window.windowHandle()->property("_q_stereo_pair").toBool());
+
+    const QImage pair = store->toImage();
+    // a pixel of the view in an eye, at the view's row y
+    auto at = [&pair](int eye, int x, int y = 20) { return QColor(pair.pixel((eye == 2 ? 120 : 0) + 10 + x, 10 + y)); };
+    // the desk's marks moved with the desk
+    QCOMPARE(at(1, 9), QColor(Qt::red));
+    QCOMPARE(at(1, 10), QColor(Qt::gray));
+    QCOMPARE(at(1, 89), QColor(Qt::blue));
+    QCOMPARE(at(2, 11), QColor(Qt::red));
+    QCOMPARE(at(2, 10), QColor(Qt::gray));
+    QCOMPARE(at(2, 91), QColor(Qt::blue));
+    // the page in its place in both eyes, its mark with it
+    for (int eye : {1, 2}) {
+        QCOMPARE(at(eye, 30), QColor(Qt::white));
+        QCOMPARE(at(eye, 69), QColor(Qt::white));
+        QCOMPARE(at(eye, 50), QColor(Qt::green));
+        QCOMPARE(at(eye, 29), QColor(Qt::gray));
+        QCOMPARE(at(eye, 70), QColor(Qt::gray));
+        // the child lies on the view's plane
+        QCOMPARE(at(eye, 80, 32), QColor(Qt::yellow));
+        QCOMPARE(at(eye, 89, 32), QColor(Qt::yellow));
+    }
+    // nothing moved outside the view
+    QCOMPARE(pair.copy(0, 0, 120, 10), flat.copy(0, 0, 120, 10));
+    QCOMPARE(pair.copy(120, 0, 120, 10), flat.copy(0, 0, 120, 10));
+    QCOMPARE(pair.copy(0, 0, 10, 60), flat.copy(0, 0, 10, 60));
+    QCOMPARE(pair.copy(120, 0, 10, 60), flat.copy(0, 0, 10, 60));
+
+    // the person's element limit at 0: painted once, exactly as before
+    window.windowHandle()->setProperty("_q_stereo_element_limit", 0.0);
+    QTRY_COMPARE(store->toImage().width(), 120);
+    QVERIFY(!window.windowHandle()->property("_q_stereo_pair").toBool());
+    QCOMPARE(store->toImage(), flat);
+
+    // not awake (a window lying behind the active one): painted once
+    window.windowHandle()->setProperty("_q_stereo_element_limit", 2.0 * 1920 / screenWidth);
+    QTRY_COMPARE(store->toImage().width(), 240);
+    window.windowHandle()->setProperty("_q_stereo_awake", false);
+    QTRY_COMPARE(store->toImage().width(), 120);
+    QCOMPARE(store->toImage(), flat);
+}
