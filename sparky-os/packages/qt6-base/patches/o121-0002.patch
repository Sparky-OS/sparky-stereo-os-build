 /*
-    Whether the window's style draws its elements in depth now: the style sets the window's
+    One step of depth inside a window, in the window's device pixels: the person's element limit,
+    which the platform hears from the compositor for a window that follows its depth
+    (_q_stereo_element_limit, pixels of a view 1920 wide, the unit of the desktop's depth settings),
+    taken on this screen as that share of the screen's width, as the stereo layer gives a Qt Quick
+    window its limits. It never follows the size of the window or of an element. 0 while the
+    platform has said no limit, or when the person's limit is 0.
+*/
+qreal qt_widget_stereo_element_step(const QWidget *tlw, qreal devicePixelRatio)
+{
+    const QWindow *window = tlw ? tlw->windowHandle() : nullptr;
+    const QScreen *screen = window ? window->screen() : nullptr;
+    if (!screen)
+        return 0;
+    const qreal limit = window->property("_q_stereo_element_limit").toReal();
+    if (!(limit > 0))
+        return 0;
+    return limit * screen->geometry().width() * devicePixelRatio / 1920;
+}
+
+/*
+    A widget inside \a tlw declares rectangles at their own depth (_q_stereo_depth_rects): the
+    window follows its depth with the compositor, through the platform, on every platform window it
+    gets. The top level widget keeps the wish, so a window made after the declaration follows too.
+*/
+void qt_widget_follow_stereo_depth(QWidget *tlw)
+{
+    QWindow *window = tlw ? tlw->windowHandle() : nullptr;
+    if (!window || !window->handle())
+        return;
+    if (!window->property("_q_stereo_follow_depth").toBool())
+        window->setProperty("_q_stereo_follow_depth", true);
+    QPlatformNativeInterface *native = QGuiApplication::platformNativeInterface();
+    const QString name = QStringLiteral("_q_stereo_follow_depth");
+    if (native && !native->windowProperty(window->handle(), name).toBool())
+        native->setWindowProperty(window->handle(), name, true);
+}
+
+/*
+    Whether elements inside the window that declare their own depth may be shown in depth now: the
+    platform follows the window's depth for them and says the window is awake (_q_stereo_awake),
+    and one step of depth is at least half a device pixel.
+*/
+static bool declaredDepthShown(QWidget *tlw)
+{
+    const QWindow *window = tlw->windowHandle();
+    return window && window->property("_q_stereo_follow_depth").toBool() && window->property("_q_stereo_awake").toBool()
+            && qt_widget_stereo_element_step(tlw, window->devicePixelRatio()) >= 0.5;
+}
+
