+/*
+    A widget declares rectangles inside it at their own depth, as the dynamic property
+    _q_stereo_depth_rects: a list of maps, each with a "rect" (QRect or QRectF, in the widget's
+    coordinates) and a "depth" (a fraction of one step of depth inside a window, from -1, one step
+    behind what the rectangle lies on, to 1, one step in front of it). The step is the person's
+    element limit (qt_widget_stereo_element_step()); a program never gives pixels. A rectangle lies
+    on the last rectangle before it in the list that holds it whole, else on the widget, whose own
+    plane is 0; what the widget paints outside every rectangle lies on that plane, and so do its
+    child widgets, which keep their own depth from there. A document viewer, for example, declares
+    its desk (the whole view) at -1 and each page at 0: the desk sinks one step and the paper lies
+    at the window's plane, its text and pictures with it, its shadow on the desk.
+
+    The declaring widget follows its window's depth with the compositor (the platform's
+    _q_stereo_awake and _q_stereo_element_limit on the window), so the window is painted once per
+    eye while the compositor shows depth inside it, whatever style draws it.
+*/
+void QWidgetPrivate::stereoDepthRectsChanged()
+{
+    Q_Q(QWidget);
+    QWidget *tlw = q->window();
+    // the rectangles move only while the window shows depth: elsewhere a program that declares
+    // them as it scrolls keeps its scrolling's partial repaints
+    if (const QWindow *window = tlw->windowHandle(); window && window->property("_q_stereo_awake").toBool())
+        q->update();
+    if (!q->property("_q_stereo_depth_rects").isValid())
+        return;
+    if (!tlw->property("_q_stereo_follow_depth").toBool())
+        tlw->setProperty("_q_stereo_follow_depth", true);
+    qt_widget_follow_stereo_depth(tlw);
+}
+
+/*
+    While a window is painted once per eye, draws a widget that declares rectangles at their own
+    depth (stereoDepthRectsChanged()) a rectangle at a time, each moved by its own eye shift on top
+    of the widget's, in whole pixels, by the rule paintSiblingsRecursive() moves widgets by: one
+    nearer than what it lies on is drawn whole, over its surroundings; a deeper one is seen through
+    its own rectangle, cut to it. What lies beneath a nearer rectangle was drawn with its own shift,
+    so where the two shifts differ a strip of it shows beside the rectangle that the widget never
+    drew (it painted the rectangle there): the strip continues what lies beneath from the column
+    just outside the rectangle, so the rectangle's edge stays at its own depth in both eyes. The
+    widget's children follow, on the widget's own plane. Returns false, having drawn nothing, when
+    the widget declares nothing that moves; the caller then draws it as before.
+*/
+bool QWidgetPrivate::paintStereoDepthRects(QPaintDevice *pdev, const QRegion &rgn, const QPoint &offset, DrawWidgetFlags flags,
+                                           QPainter *sharedPainter, QWidgetRepaintManager *repaintManager)
+{
+    Q_Q(QWidget);
+    const int eye = qt_widget_stereo_eye();
+    if (!eye || sharedPainter || rgn.isEmpty())
+        return false;
+#if QT_CONFIG(graphicseffect)
+    if (graphicsEffect && graphicsEffect->isEnabled())
+        return false;
+#endif
+    const QVariantList declared = q->property("_q_stereo_depth_rects").toList();
+    if (declared.isEmpty())
+        return false;
+    const qreal dpr = pdev->devicePixelRatio() > 0 ? pdev->devicePixelRatio() : 1;
+    const qreal step = qt_widget_stereo_element_step(q->window(), dpr);
+    if (!(step > 0))
+        return false;
+
+    auto eyeShift = [eye](int p) {
+        return eye == 1 ? p - p / 2 : -(p / 2);
+    };
+    const int own = stereoParallax(q);
+    struct Layer {
+        QRect rect;
+        int parallax = 0; // device pixels, relative to the widget's own plane
+        int shift = 0; // logical pixels, relative to where the widget is drawn
+        qsizetype under = 0; // the layer it lies on
+    };
+    QVarLengthArray<Layer, 8> layers;
+    layers.append(Layer{q->rect(), 0, 0, 0});
+    bool moves = false;
+    for (const QVariant &entry : declared) {
+        const QVariantMap map = entry.toMap();
+        const QRect rect = map.value(QStringLiteral("rect")).toRectF().toAlignedRect() & q->rect();
+        if (rect.isEmpty())
+            continue;
+        Layer layer;
+        layer.rect = rect;
+        layer.parallax = qRound(std::clamp(map.value(QStringLiteral("depth")).toReal(), qreal(-1), qreal(1)) * step);
+        layer.shift = qRound((eyeShift(own + layer.parallax) - eyeShift(own)) / dpr);
+        for (qsizetype i = layers.size() - 1; i > 0; --i) {
+            if (layers.at(i).rect.contains(rect)) {
+                layer.under = i;
+                break;
+            }
+        }
+        moves = moves || layer.shift != 0;
+        layers.append(layer);
+    }
+    if (!moves)
+        return false;
+
+    const DrawWidgetFlags ownFlags = flags & ~DrawRecursive;
+    // what the widget paints of itself in the output region \a out (relative to where the widget
+    // is drawn), moved by \a shift
+    auto paintMoved = [&](const QRegion &out, int shift) {
+        const QRegion local = out.translated(-shift, 0);
+        if (!local.isEmpty())
+            drawWidget(pdev, local, offset + QPoint(shift, 0), ownFlags, sharedPainter, repaintManager);
+    };
+    // the widget's own plane, beneath every rectangle
+    paintMoved(rgn, 0);
+    for (qsizetype j = 1; j < layers.size(); ++j) {
+        const Layer &layer = layers.at(j);
+        const Layer &under = layers.at(layer.under);
+        const QRegion underShown = layer.under ? (rgn & under.rect) : rgn;
+        if (layer.parallax >= under.parallax) {
+            // nearer: the strip of what lies beneath that its shift uncovers, then the rectangle whole
+            const int delta = under.shift - layer.shift;
+            const int source = delta < 0 ? layer.rect.left() - 1 : layer.rect.right() + 1;
+            for (int k = 0; k < qAbs(delta); ++k) {
+                const int column = delta < 0 ? layer.rect.left() + under.shift + k : layer.rect.right() + 1 + layer.shift + k;
+                const QRegion out = QRegion(column, layer.rect.top(), 1, layer.rect.height()) & underShown;
+                paintMoved(out, column - source);
+            }
+            paintMoved(QRegion(layer.rect.translated(layer.shift, 0)) & rgn, layer.shift);
+        } else {
+            // deeper: seen through its own rectangle, cut to it
+            paintMoved(QRegion(layer.rect) & rgn & QRegion(layer.rect.translated(layer.shift, 0)), layer.shift);
+        }
+    }
+
+    if ((flags & DrawRecursive) && !children.isEmpty())
+        paintSiblingsRecursive(pdev, children, children.size() - 1, rgn, offset, flags & ~DrawAsRoot,
+                               sharedPainter, repaintManager);
+    return true;
+}
+
