From 4891976c5a1b9df5306889d89c59ca4ff581b84e Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sun, 15 Nov 2026 20:12:18 -0300
Subject: [PATCH 1/2] Wayland: blit each eye of a framed window that an engine
 draws as a pair

A decorated QWaylandEglWindow renders its content into a framebuffer
object and blits it, with the frame Qt draws around the window
(client-side decorations), into the window surface from a second
context. For a surface with two views (EGL_EXT_multiview_window) the
framebuffer object has a slot per eye and the blit draws each slot into
its own back buffer, which needs a desktop OpenGL context.

The blit took the number of eyes and its API from the context's own
format, so it drew both eyes only for a window whose format asked for
stereo. An engine that asks for the two views of its window later, on a
format that did not ask for stereo (Qt Quick while a style shows the
depth of the window's elements, through the window's _q_stereo_views),
got a surface with two views and a slot per eye, and the blit drew the
left slot alone, into GL_BACK, from an OpenGL ES context: the right view
was never drawn, the EGL implementation presented one view and declared
nothing, and the window was shown flat while its depth was marked.

The blit now follows the window: a window whose framebuffer object has a
slot per eye is blitted eye by eye from a desktop OpenGL context, the
context's own one when it was made for stereo, otherwise one made for
such windows the first time one is blitted, sharing the content's
textures as the other one does. Other windows are blitted exactly as
before. The slots of the framebuffer object also follow the surface's
views when the surface is made again with another number of them while
the window is shown; before, the object kept the slots it was made with.

Assisted-by: Claude Opus 5.5
---
 .../wayland-egl/qwaylandeglwindow.cpp         | 12 ++++--
 .../wayland-egl/qwaylandglcontext.cpp         | 43 ++++++++++++++++---
 .../wayland-egl/qwaylandglcontext_p.h         |  9 ++++
 3 files changed, 54 insertions(+), 10 deletions(-)

diff --git a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
index d9a7627..39a3c73 100644
--- a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
+++ b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
@@ -337,14 +337,18 @@ GLuint QWaylandEglWindow::contentFBO() const
     if (!decoration())
         return 0;
 
-    if (m_resize || !m_contentFBO) {
+    // A stereo window has a slot per eye. Its surface may be made again with another number of views while
+    // the window is shown (an engine asking for a pair after the first frame, or no longer asking), so the
+    // slots follow the surface.
+    const int slotCount = m_twoViews ? 2 : 1;
+    if (m_resize || !m_contentFBO || m_contentFBO->textures().size() != slotCount) {
         QOpenGLFramebufferObject *old = m_contentFBO;
         QSize fboSize = geometry().size() * scale();
         if (m_sideBySide)
             fboSize.rwidth() *= 2;
         m_contentFBO = new QOpenGLFramebufferObject(fboSize.width(), fboSize.height(), QOpenGLFramebufferObject::CombinedDepthStencil);
-        // A stereo window has a slot per eye: the right eye is rendered into the second attachment
-        if (m_twoViews) {
+        // the right eye is rendered into the second attachment
+        if (slotCount == 2) {
             m_contentFBO->bind();
             m_contentFBO->addColorAttachment(fboSize);
         }
@@ -363,7 +367,7 @@ GLuint QWaylandEglWindow::contentTexture(int eye) const
 
 int QWaylandEglWindow::contentEyes() const
 {
-    return m_contentFBO->textures().size();
+    return m_contentFBO ? m_contentFBO->textures().size() : 0;
 }
 
 void QWaylandEglWindow::bindContentFBO()
diff --git a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp
index c1baa08..f3c55f3 100644
--- a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp
+++ b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp
@@ -367,8 +367,12 @@ QWaylandGLContext::~QWaylandGLContext()
     QObject::disconnect(m_reconnectionWatcher);
     delete m_blitter;
     m_blitter = nullptr;
+    delete m_pairBlitter;
+    m_pairBlitter = nullptr;
     if (m_decorationsContext != EGL_NO_CONTEXT)
         eglDestroyContext(eglDisplay(), m_decorationsContext);
+    if (m_pairDecorationsContext != EGL_NO_CONTEXT)
+        eglDestroyContext(eglDisplay(), m_pairDecorationsContext);
 }
 
 void QWaylandGLContext::initialize()
@@ -412,6 +416,7 @@ void QWaylandGLContext::initialize()
         }
 
         eglDecorationsContextAttrs << EGL_NONE;
+        m_decorationsContextAttrs = eglDecorationsContextAttrs;
 
         // The blitter of a stereo window draws into the left and right back buffers: desktop OpenGL
         if (m_stereo)
@@ -425,6 +430,24 @@ void QWaylandGLContext::initialize()
     }
 }
 
+// The decorations context of a window whose surface has two views, when this context's own one is OpenGL ES
+// (a format that did not ask for stereo): made the first time such a window is blitted, sharing the content's
+// textures as the other one does.
+EGLContext QWaylandGLContext::pairDecorationsContext()
+{
+    if (!m_pairDecorationsTried && !m_decorationsContextAttrs.isEmpty()) {
+        m_pairDecorationsTried = true;
+        eglBindAPI(EGL_OPENGL_API);
+        m_pairDecorationsContext = eglCreateContext(eglDisplay(), eglConfig(), eglContext(),
+                                                    m_decorationsContextAttrs.constData());
+        if (m_pairDecorationsContext == EGL_NO_CONTEXT)
+            qCWarning(lcQpaWayland, "QWaylandGLContext: Failed to create the decorations EGLContext of a window "
+                                    "with two views (EGL error %#x). Its left eye is shown in both.", eglGetError());
+        eglBindAPI(m_api);
+    }
+    return m_pairDecorationsContext;
+}
+
 void QWaylandGLContext::beginFrame()
 {
     if (!m_currentWindow)
@@ -522,11 +545,19 @@ void QWaylandGLContext::swapBuffers(QPlatformSurface *surface)
     EGLSurface eglSurface = window->eglSurface();
 
     if (window->decoration()) {
-        const EGLenum decorationsApi = m_stereo ? EGL_OPENGL_API : EGL_OPENGL_ES_API;
+        // A window whose surface has two views is blitted eye by eye, which needs desktop OpenGL; its format
+        // may not have asked for stereo when an engine asks for the pair (Qt Quick drawing the depth of its
+        // elements), and then a desktop OpenGL context is made for its decorations.
+        const bool pair = !m_stereo && !window->sideBySidePair() && window->contentEyes() == 2
+                && pairDecorationsContext() != EGL_NO_CONTEXT;
+        const bool desktopGL = m_stereo || pair;
+        const EGLContext decorationsContext = pair ? m_pairDecorationsContext : m_decorationsContext;
+        DecorationsBlitter *&blitter = pair ? m_pairBlitter : m_blitter;
+        const EGLenum decorationsApi = desktopGL ? EGL_OPENGL_API : EGL_OPENGL_ES_API;
         if (m_api != decorationsApi)
             eglBindAPI(decorationsApi);
         // the blitter reads the eyes rendered by this context
-        if (m_stereo)
+        if (desktopGL)
             glFlush();
 
         // save the current EGL content and surface to set it again after the blitter is done
@@ -534,11 +565,11 @@ void QWaylandGLContext::swapBuffers(QPlatformSurface *surface)
         EGLContext currentContext = eglGetCurrentContext();
         EGLSurface currentSurfaceDraw = eglGetCurrentSurface(EGL_DRAW);
         EGLSurface currentSurfaceRead = eglGetCurrentSurface(EGL_READ);
-        eglMakeCurrent(eglDisplay(), eglSurface, eglSurface, m_decorationsContext);
+        eglMakeCurrent(eglDisplay(), eglSurface, eglSurface, decorationsContext);
 
-        if (!m_blitter)
-            m_blitter = new DecorationsBlitter(this, m_stereo);
-        m_blitter->blit(window);
+        if (!blitter)
+            blitter = new DecorationsBlitter(this, desktopGL);
+        blitter->blit(window);
 
         if (m_api != decorationsApi)
             eglBindAPI(m_api);
diff --git a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext_p.h b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext_p.h
index 1e95243..98eadf2 100644
--- a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext_p.h
+++ b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext_p.h
@@ -9,6 +9,7 @@
 #include <QtWaylandClient/private/qwaylanddisplay_p.h>
 #include <QtGui/private/qeglplatformcontext_p.h>
 #include <qpa/qplatformopenglcontext.h>
+#include <QtCore/qlist.h>
 
 QT_BEGIN_NAMESPACE
 
@@ -47,9 +48,17 @@ protected:
     void runGLChecks() override;
 
 private:
+    EGLContext pairDecorationsContext();
+
     QWaylandDisplay *m_display = nullptr;
     EGLContext m_decorationsContext = EGL_NO_CONTEXT;
     DecorationsBlitter *m_blitter = nullptr;
+    // A desktop OpenGL context and its blitter for the decorations of a window whose surface has two views,
+    // when this context was made for a format that did not ask for stereo
+    EGLContext m_pairDecorationsContext = EGL_NO_CONTEXT;
+    DecorationsBlitter *m_pairBlitter = nullptr;
+    bool m_pairDecorationsTried = false;
+    QList<EGLint> m_decorationsContextAttrs;
     bool m_supportNonBlockingSwap = true;
     EGLenum m_api;
     wl_surface *m_wlSurface = nullptr;
-- 
