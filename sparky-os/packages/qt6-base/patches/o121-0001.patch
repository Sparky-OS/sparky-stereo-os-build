+    QPointer<QWindow> target;
+    bool tellNoLimit = false;
+    {
+        QMutexLocker locker(&s_mutex);
+        auto it = windows().find(m_window);
+        if (it == windows().end() || !it->second.follow || it->second.followDepth.get() != this)
+            return;
+        target = it->second.window;
+        if (awake && version() < s_elementLimitVersion && !it->second.toldNoElementLimit) {
+            it->second.toldNoElementLimit = true;
+            tellNoLimit = true;
+        }
+    }
+    if (tellNoLimit)
+        qCWarning(lcStereoDepth).noquote() << "the elements of" << target.data()
+                                           << "that declare their own depth are drawn flat: the compositor does not send the"
+                                              " person's element limit (kde_stereo_depth_v1 version 7)";
+    tellWindow(target, "_q_stereo_awake", awake != 0);
