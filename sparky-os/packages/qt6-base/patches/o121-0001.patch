+void QWaylandStereoDepth::setFollowDepth(QWaylandWindow *window, bool follow)
+{
+    QMutexLocker locker(&s_mutex);
+    ::wl_surface *surface = window->wlSurface();
+    auto it = currentState(window, surface);
+    if (!follow) {
+        if (it != windows().end() && it->second.follow) {
+            it->second.follow = false;
+            it->second.followDepth.reset();
+            tellAsleepLater(it->second.window);
+        }
+        return;
+    }
+    // without a surface yet, the window follows its depth once it has one (surfaceCreated())
+    if (!surface || !isSupportedLocked(window->display()))
+        return;
+
+    WindowState &state = it != windows().end() ? it->second : windows()[window];
+    if (state.follow && state.followDepth)
+        return;
+    state.surface = surface;
+    state.follow = true;
+    state.window = window->window();
+    state.followDepth = std::make_unique<Depth>(managers()[window->display()].manager->get_depth(surface), window);
+}
