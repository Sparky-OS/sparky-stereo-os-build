+// What a followed window hears is said on the window itself, outside the lock, on the gui thread
+// that dispatches the compositor's events.
+void tellWindow(QWindow *window, const char *name, const QVariant &value)
+{
+    if (window && window->property(name) != value)
+        window->setProperty(name, value);
+}
+
+// A window whose surface goes is not awake until its next surface hears so; the window may be
+// going away itself, so it is told after the event at hand, if it is still there.
+void tellAsleepLater(const QPointer<QWindow> &window)
+{
+    if (!window)
+        return;
+    QWindow *target = window.data();
+    QMetaObject::invokeMethod(target, [target] { tellWindow(target, "_q_stereo_awake", false); }, Qt::QueuedConnection);
+}
