+// A window that asks for stereo buffers gets a swapchain with two views, an image layer per eye, where the surface
+// offers them: a framebuffer and an image view per eye, the left eye's where it has one view.
+class TwoViewsRenderer : public QVulkanWindowRenderer
+{
+public:
+    explicit TwoViewsRenderer(QVulkanWindow *w) : m_window(w) { }
+    void startNextFrame() override
+    {
+        QVulkanDeviceFunctions *df = m_window->vulkanInstance()->deviceFunctions(m_window->device());
+        const VkFramebuffer left = m_window->currentFramebuffer(QVulkanWindow::LeftBuffer);
+        const VkFramebuffer right = m_window->currentFramebuffer(QVulkanWindow::RightBuffer);
+        leftIsCurrent = left == m_window->currentFramebuffer();
+        twoFramebuffers = right != left;
+        for (int eye = 0; eye < (twoFramebuffers ? 2 : 1); ++eye) {
+            VkClearValue clear[3] = {};
+            clear[0].color = eye ? VkClearColorValue{{0, 0, 1, 1}} : VkClearColorValue{{1, 0, 0, 1}};
+            clear[1].depthStencil = {1, 0};
+            clear[2].color = clear[0].color;
+            VkRenderPassBeginInfo rp = {};
+            rp.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+            rp.renderPass = m_window->defaultRenderPass();
+            rp.framebuffer = eye ? right : left;
+            const QSize size = m_window->swapChainImageSize();
+            rp.renderArea.extent = {uint32_t(size.width()), uint32_t(size.height())};
+            rp.clearValueCount = m_window->sampleCountFlagBits() > VK_SAMPLE_COUNT_1_BIT ? 3 : 2;
+            rp.pClearValues = clear;
+            df->vkCmdBeginRenderPass(m_window->currentCommandBuffer(), &rp, VK_SUBPASS_CONTENTS_INLINE);
+            df->vkCmdEndRenderPass(m_window->currentCommandBuffer());
+        }
+        ++frames;
+        m_window->frameReady();
+    }
+    QVulkanWindow *m_window;
+    bool leftIsCurrent = false;
+    bool twoFramebuffers = false;
+    int frames = 0;
+};
+
+class TwoViewsWindow : public QVulkanWindow
+{
+public:
+    QVulkanWindowRenderer *createRenderer() override { return renderer = new TwoViewsRenderer(this); }
+    TwoViewsRenderer *renderer = nullptr;
+};
+
+void tst_QVulkan::vulkanWindowTwoViews()
+{
+    QVulkanInstance inst;
+    if (!inst.create())
+        QSKIP("Vulkan init failed; skip");
+
+    for (const bool asked : {false, true}) {
+        TwoViewsWindow w;
+        w.setVulkanInstance(&inst);
+        // grab() swaps red and blue for VK_FORMAT_B8G8R8A8_UNORM only
+        w.setPreferredColorFormats({VK_FORMAT_B8G8R8A8_UNORM, VK_FORMAT_R8G8B8A8_UNORM});
+        if (asked) {
+            QSurfaceFormat format = w.requestedFormat();
+            format.setStereo(true);
+            w.setFormat(format);
+        }
+        w.resize(320, 240);
+        w.show();
+        QVERIFY(QTest::qWaitForWindowExposed(&w));
+        if (w.availablePhysicalDevices().isEmpty())
+            QSKIP("No Vulkan physical devices; skip");
+        QTRY_VERIFY(w.renderer && w.renderer->frames >= 1);
+
+        VkSurfaceCapabilitiesKHR caps = {};
+        auto getCaps = reinterpret_cast<PFN_vkGetPhysicalDeviceSurfaceCapabilitiesKHR>(
+                inst.getInstanceProcAddr("vkGetPhysicalDeviceSurfaceCapabilitiesKHR"));
+        QVERIFY(getCaps);
+        QCOMPARE(getCaps(w.physicalDevice(), QVulkanInstance::surfaceForWindow(&w), &caps), VK_SUCCESS);
+        const bool offered = caps.maxImageArrayLayers > 1;
+        if (asked && !offered) {
+            if (qEnvironmentVariableIntValue("QTEST_STEREO_TWO_VIEWS") == 1)
+                QFAIL("The surface offers one image layer; QTEST_STEREO_TWO_VIEWS=1 asks for two");
+            QSKIP("The surface offers one image layer; skip");
+        }
+
+        QVERIFY(w.renderer->leftIsCurrent);
+        QCOMPARE(w.renderer->twoFramebuffers, asked);
+        const bool twoViews = w.swapChainImageView(0, QVulkanWindow::RightBuffer)
+                != w.swapChainImageView(0, QVulkanWindow::LeftBuffer);
+        QCOMPARE(twoViews, asked);
+        QCOMPARE(w.swapChainImageView(0, QVulkanWindow::LeftBuffer), w.swapChainImageView(0));
+
+        if (w.supportsGrab()) {
+            // the left eye is the window's picture
+            const QImage image = w.grab();
+            QVERIFY(!image.isNull());
+            QCOMPARE_LE(qAbs(qRed(image.pixel(10, 10)) - 255), 1);
+            QCOMPARE_LE(qBlue(image.pixel(10, 10)), 1);
+        }
+        w.destroy();
+    }
+}
