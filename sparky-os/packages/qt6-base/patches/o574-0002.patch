 {
     Q_D(const QVulkanWindow);
@@ -2743,6 +2970,21 @@ VkImage QVulkanWindow::msaaColorImage(int idx) const
     QVulkanWindowRenderer::initSwapChainResources() up until
     QVulkanWindowRenderer::releaseSwapChainResources().
  */
+/*!
+    Returns the view of the multisample color image of swapchain image \a idx
+    for \a targetBuffer, the left or the right eye. With one view the left
+    eye's is returned for both.
+
+    \sa msaaColorImageView()
+ */
+VkImageView QVulkanWindow::msaaColorImageView(int idx, StereoTargetBuffer targetBuffer) const
+{
+    Q_D(const QVulkanWindow);
+    if (targetBuffer == RightBuffer && d->stereo)
+        return idx >= 0 && idx < d->swapChainBufferCount ? d->rightRes[idx].msaaImageView : VK_NULL_HANDLE;
+    return msaaColorImageView(idx);
+}
