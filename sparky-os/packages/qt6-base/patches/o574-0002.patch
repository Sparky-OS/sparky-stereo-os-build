+/*!
+    \enum QVulkanWindow::StereoTargetBuffer
+
+    Selects the eye a framebuffer or an image view of a swapchain with two
+    views belongs to.
+
+    \value LeftBuffer The left eye's, the first image layer. A swapchain with
+    one view has only this one.
+    \value RightBuffer The right eye's, the second image layer.
+ */
+
+/*!
+    Returns a VkFramebuffer for \a targetBuffer, the left or the right eye,
+    of the current swapchain image, using the default render pass.
+
+    A window gets a swapchain with two views, an image layer per eye, when its
+    requested format asks for stereo buffers (QSurfaceFormat::StereoBuffers)
+    and the surface offers two image layers. A renderer then records the
+    default render pass twice in startNextFrame(), once with each eye's
+    framebuffer. When the swapchain has one view, the left eye's framebuffer is
+    returned for both, so a renderer draws the right eye only when this
+    differs from currentFramebuffer().
+
+    The two framebuffers share the depth-stencil buffer; each has its own
+    multisample color image.
+
+    A renderer that never asks for the right eye's framebuffer, or for the
+    right eye's image view with swapChainImageView(), gets its left eye copied
+    into the right one at the end of each frame, so the window shows its
+    picture in both eyes, as an OpenGL program drawing to \c GL_BACK does on a
+    stereo window.
+
+    \note This function must only be called from within startNextFrame() and, in
+    case of asynchronous command generation, up until the call to frameReady().
+
+    \sa currentFramebuffer(), defaultRenderPass()
+ */
+VkFramebuffer QVulkanWindow::currentFramebuffer(StereoTargetBuffer targetBuffer) const
+{
+    Q_D(const QVulkanWindow);
+    if (!d->framePending) {
+        qWarning("QVulkanWindow: Attempted to call currentFramebuffer() without an active frame");
+        return VK_NULL_HANDLE;
+    }
+    if (targetBuffer == RightBuffer && d->stereo) {
+        d->rightEyeUsed = true;
+        return d->rightRes[d->currentImage].fb;
+    }
+    return d->imageRes[d->currentImage].fb;
+}
+
 /*!
     Returns the current frame index in the range [0, concurrentFrameCount() - 1].
 
@@ -2671,6 +2867,22 @@ VkImage QVulkanWindow::swapChainImage(int idx) const
     QVulkanWindowRenderer::initSwapChainResources() up until
     QVulkanWindowRenderer::releaseSwapChainResources().
  */
+/*!
+    Returns the view of swapchain image \a idx for \a targetBuffer, the left or
+    the right eye. With one view the left eye's is returned for both.
+
+    \sa swapChainImageView(), currentFramebuffer()
+ */
+VkImageView QVulkanWindow::swapChainImageView(int idx, StereoTargetBuffer targetBuffer) const
+{
+    Q_D(const QVulkanWindow);
+    if (targetBuffer == RightBuffer && d->stereo) {
+        d->rightEyeUsed = true;
+        return idx >= 0 && idx < d->swapChainBufferCount ? d->rightRes[idx].imageView : VK_NULL_HANDLE;
+    }
+    return swapChainImageView(idx);
+}
