+// Whether the swapchain should have two views, a left and a right image layer. The platform may know more than
+// the window's format (the Wayland platform also asks for them while an engine draws the window's elements once
+// per eye, and only where the compositor takes such a pair) and answers with the number, the window's
+// "_q_stereo_views" native resource, as it does for QRhi's swapchains; elsewhere the window's requested format
+// decides. platformAnswers says which of the two it was.
+bool QVulkanWindowPrivate::wantsTwoViews(bool *platformAnswers)
+{
+    Q_Q(QVulkanWindow);
+    *platformAnswers = false;
+    if (q->handle()) {
+        if (QPlatformNativeInterface *native = QGuiApplication::platformNativeInterface()) {
+            const quintptr views = quintptr(native->nativeResourceForWindow(QByteArrayLiteral("_q_stereo_views"), q));
+            if (views) {
+                *platformAnswers = true;
+                return views == 2;
+            }
+        }
+    }
+    return q->requestedFormat().stereo();
+}
