     QVulkanWindowRenderer::releaseSwapChainResources().
  */
+/*!
+    Returns the multisample color image of swapchain image \a idx for \a
+    targetBuffer, the left or the right eye. With one view the left eye's is
+    returned for both.
+
+    \sa msaaColorImage()
+ */
+VkImage QVulkanWindow::msaaColorImage(int idx, StereoTargetBuffer targetBuffer) const
+{
+    Q_D(const QVulkanWindow);
+    if (targetBuffer == RightBuffer && d->stereo)
+        return idx >= 0 && idx < d->swapChainBufferCount ? d->rightRes[idx].msaaImage : VK_NULL_HANDLE;
+    return msaaColorImage(idx);
+}
+
