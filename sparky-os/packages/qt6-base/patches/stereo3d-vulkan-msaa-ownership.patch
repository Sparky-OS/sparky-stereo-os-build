From d9bb0237d9b5fdf0f904bf29761f5662df51df8b Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 24 Oct 2026 21:00:43 -0300
Subject: [PATCH] RHI: Destroy shared Vulkan stereo MSAA resources only once

The two eye entries refer to the same transient MSAA image and view.
Releasing a stereo swapchain destroys those handles twice, which can
abort on resize or window destruction when multisampling is enabled.

Let the first bufferCount entries own the shared MSAA resources and
clear the borrowed handles in the right-eye entries without destroying
them again. Keep the existing allocation size and rendering order:
each eye pass resolves to its own swapchain layer before the next pass.

Add data-driven resize and destruction coverage for mono and stereo
swapchains across the supported sample counts. Read back the left
resolve after rendering both eyes to check that it remains intact.
The stereo 8x rows abort before this fix, while mono 8x and stereo 1x
controls pass.

Pick-to: 6.12 6.11
Change-Id: I0c959905dcda2ef1e721933342c3d992f5a0c902
Assisted-by: gpt-6-astra (Codex)

Backport to 6.11.2: adjust autotest context without changing the test.
---
diff --git a/src/gui/rhi/qrhivulkan.cpp b/src/gui/rhi/qrhivulkan.cpp
--- a/src/gui/rhi/qrhivulkan.cpp
+++ b/src/gui/rhi/qrhivulkan.cpp
@@ -2559,14 +2559,15 @@
             df->vkDestroyImageView(dev, image.imageView, nullptr);
             image.imageView = VK_NULL_HANDLE;
         }
-        if (image.msaaImageView) {
-            df->vkDestroyImageView(dev, image.msaaImageView, nullptr);
-            image.msaaImageView = VK_NULL_HANDLE;
-        }
-        if (image.msaaImage) {
-            df->vkDestroyImage(dev, image.msaaImage, nullptr);
-            image.msaaImage = VK_NULL_HANDLE;
-        }
+        // The right-eye entries borrow the first eye's MSAA image and view.
+        if (i < swapChainD->bufferCount) {
+            if (image.msaaImageView)
+                df->vkDestroyImageView(dev, image.msaaImageView, nullptr);
+            if (image.msaaImage)
+                df->vkDestroyImage(dev, image.msaaImage, nullptr);
+        }
+        image.msaaImageView = VK_NULL_HANDLE;
+        image.msaaImage = VK_NULL_HANDLE;
         if (image.drawSem) {
             df->vkDestroySemaphore(dev, image.drawSem, nullptr);
             image.drawSem = VK_NULL_HANDLE;
