+void tst_QRhi::vulkanSwapChainLifetime_data()
+{
+    QTest::addColumn<bool>("stereo");
+    QTest::addColumn<int>("samples");
+    QTest::addColumn<bool>("resize");
+
+    for (bool stereo : { false, true }) {
+        for (int samples : { 1, 2, 4, 8, 16, 32, 64 }) {
+            for (bool resize : { false, true }) {
+                const QByteArray name = QByteArray(stereo ? "stereo" : "mono")
+                        + '-' + QByteArray::number(samples) + (resize ? "-resize" : "-destroy");
+                QTest::newRow(name.constData()) << stereo << samples << resize;
+            }
+        }
+    }
+}
+
+void tst_QRhi::vulkanSwapChainLifetime()
+{
+#ifndef TST_VK
+    QSKIP("Vulkan is not available");
+#else
+    if (!vulkanInstance.isValid())
+        QSKIP("Vulkan instance could not be created");
+    if (QGuiApplication::platformName().startsWith(QLatin1String("offscreen")))
+        QSKIP("A window surface is required");
+
+    QFETCH(bool, stereo);
+    QFETCH(int, samples);
+    QFETCH(bool, resize);
+
+    QScopedPointer<QWindow> window(new QWindow);
+    setWindowType(window.data(), QRhi::Vulkan);
+    QSurfaceFormat format = window->format();
+    format.setStereo(stereo);
+    window->setFormat(format);
+    window->resize(320, 240);
+    window->show();
+    QVERIFY(QTest::qWaitForWindowExposed(window.data()));
+
+    QRhiVulkanInitParams params = initParams.vk;
+    params.window = window.data();
+    QScopedPointer<QRhi> rhi(QRhi::create(QRhi::Vulkan, &params));
+    if (!rhi)
+        QSKIP("Vulkan QRhi could not be created");
+    if (!rhi->supportedSampleCounts().contains(samples))
+        QSKIP("Sample count is not supported");
+
+    QScopedPointer<QRhiSwapChain> swapChain(rhi->newSwapChain());
+    swapChain->setWindow(window.data());
+    swapChain->setSampleCount(samples);
+    swapChain->setFlags(QRhiSwapChain::UsedAsTransferSource);
+    QScopedPointer<QRhiRenderPassDescriptor> rpDesc(swapChain->newCompatibleRenderPassDescriptor());
+    swapChain->setRenderPassDescriptor(rpDesc.data());
+    QVERIFY(swapChain->createOrResize());
+    if (stereo && swapChain->currentFrameRenderTarget(QRhiSwapChain::LeftBuffer)
+            == swapChain->currentFrameRenderTarget(QRhiSwapChain::RightBuffer))
+        QSKIP("Stereo swapchains are not supported on this surface");
+
+    const QSize sizes[] = { { 320, 240 }, { 256, 192 }, { 384, 256 }, { 320, 240 } };
+    for (int i = 0; i < (resize ? 4 : 1); ++i) {
+        if (i) {
+            window->resize(sizes[i]);
+            QTRY_COMPARE(window->size(), sizes[i]);
+            QVERIFY(swapChain->createOrResize());
+        }
+        QCOMPARE(swapChain->currentPixelSize(), swapChain->surfacePixelSize());
+        QVERIFY(rhi->beginFrame(swapChain.data()) == QRhi::FrameOpSuccess);
+        QRhiCommandBuffer *cb = swapChain->currentFrameCommandBuffer();
+        cb->beginPass(swapChain->currentFrameRenderTarget(QRhiSwapChain::LeftBuffer),
+                      Qt::red, { 1.0f, 0 });
+        cb->endPass();
+        if (stereo) {
+            cb->beginPass(swapChain->currentFrameRenderTarget(QRhiSwapChain::RightBuffer),
+                          Qt::green, { 1.0f, 0 });
+            cb->endPass();
+        }
+
+        // The left resolve must survive rendering the right eye.
+        QRhiReadbackResult readback;
+        bool completed = false;
+        readback.completed = [&completed] { completed = true; };
+        QRhiResourceUpdateBatch *updates = rhi->nextResourceUpdateBatch();
+        updates->readBackTexture({}, &readback);
+        cb->resourceUpdate(updates);
+        QVERIFY(rhi->endFrame(swapChain.data()) == QRhi::FrameOpSuccess);
+        QVERIFY(rhi->finish() == QRhi::FrameOpSuccess);
+        QVERIFY(completed);
+        QCOMPARE(readback.pixelSize, swapChain->currentPixelSize());
+        QVERIFY(readback.format == QRhiTexture::RGBA8 || readback.format == QRhiTexture::BGRA8);
+        QImage image(reinterpret_cast<const uchar *>(readback.data.constData()),
+                     readback.pixelSize.width(), readback.pixelSize.height(),
+                     readback.format == QRhiTexture::RGBA8 ? QImage::Format_RGBA8888
+                                                           : QImage::Format_ARGB32);
+        QCOMPARE(image.pixelColor(image.width() / 2, image.height() / 2), QColor(Qt::red));
+    }
+    swapChain.reset();
+#endif
+}
