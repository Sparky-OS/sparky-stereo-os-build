+    if (!window || !window->property("_q_stereo_follow_depth").toBool() || !window->property("_q_stereo_awake").toBool())
+        return false;
+    const auto [behind, inFront] = qt_widget_stereo_element_steps(tlw);
+    return qMax(behind, inFront) >= 0.5;
