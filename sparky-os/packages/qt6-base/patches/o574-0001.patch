+// The OpenGL driver that gives one view, as the person would name it: zink when the session asks for it by name,
+// otherwise the EGL implementation's vendor.
+static QString openGLDriver(EGLDisplay display)
+{
+    if (qgetenv("MESA_LOADER_DRIVER_OVERRIDE") == "zink")
+        return QStringLiteral("zink");
+    const char *vendor = eglQueryString(display, EGL_VENDOR);
+    return vendor && *vendor ? QString::fromUtf8(vendor) : QStringLiteral("(unknown)");
+}
+
+void QWaylandEglWindow::tellViews(const QSurfaceFormat &format, bool twoViews)
+{
+    const bool asked = (format.stereo() || (m_pairRequested.load(std::memory_order_acquire) && !m_sideBySide))
+            && QWaylandStereoDepth::isSupported(mDisplay);
+    const int told = !asked ? 0 : twoViews ? 2 : 1;
+    if (told == m_toldViews)
+        return;
+    m_toldViews = told;
+    if (told == 0)
+        return;
+    const QString driver = openGLDriver(m_clientBufferIntegration->eglDisplay());
+    if (told == 2) {
+        QWaylandStereoProblem::twoViewsGiven(QWaylandStereoProblem::Api::OpenGL, driver);
+    } else {
+        QWaylandStereoProblem::oneViewGiven(QWaylandStereoProblem::Api::OpenGL, driver,
+                                            rendererPresentsOneView()
+                                                    ? QWaylandStereoProblem::Reason::ZinkOwnSwapchain
+                                                    : QWaylandStereoProblem::Reason::DriverGivesOneView);
+    }
+}
