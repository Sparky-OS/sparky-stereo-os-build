@@ -0,0 +1,53 @@
+// Copyright (C) 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QWAYLANDSTEREOPROBLEM_P_H
+#define QWAYLANDSTEREOPROBLEM_P_H
+
+//
+//  W A R N I N G
+//  -------------
+//
+// This file is not part of the Qt API.  It exists purely as an
+// implementation detail.  This header file may change from version to
+// version without notice, or even be removed.
+//
+// We mean it.
+//
+
+#include <QtWaylandClient/qtwaylandclientglobal.h>
+
+QT_BEGIN_NAMESPACE
+
+class QString;
+
+namespace QtWaylandClient {
+
+// A window that asked for two views of its surface, one per eye (its own stereo buffers, or an engine drawing
+// the depth of its elements), and was given one is shown flat. The person is told once, as the desktop's own
+// problem for the driver that gives one view (a driver that cannot give a second view gives none to any
+// program), naming the first program that met it; the problem ends when a window gets its two views from the
+// same driver. Where the build names the edition's problems engine (QT_SPARKY_STEREO_PROBLEMS_LIBRARY), the
+// problem goes to it; otherwise, or when it cannot be kept, it is a warning in the program's log.
+namespace QWaylandStereoProblem {
+
+enum class Api { Vulkan, OpenGL };
+
+enum class Reason {
+    // The driver gives a surface one view (Vulkan: one image layer; OpenGL: no EGL_EXT_multiview_window).
+    DriverGivesOneView,
+    // zink presents through its own swapchain (kopper), which shows one view.
+    ZinkOwnSwapchain,
+};
+
+// Any thread; once per driver and program, whatever the number of windows and frames.
+Q_WAYLANDCLIENT_EXPORT void oneViewGiven(Api api, const QString &driver, Reason reason);
+Q_WAYLANDCLIENT_EXPORT void twoViewsGiven(Api api, const QString &driver);
+
+} // namespace QWaylandStereoProblem
+
+} // namespace QtWaylandClient
+
+QT_END_NAMESPACE
+
+#endif // QWAYLANDSTEREOPROBLEM_P_H
