 #include "qwaylandstereodepth_p.h"
+#include "qwaylandstereoproblem_p.h"
 #include "qwaylanddisplay_p.h"
 
 #include <QtCore/QEvent>
@@ -80,20 +81,28 @@ int QWaylandVulkanWindow::viewsWanted() const
