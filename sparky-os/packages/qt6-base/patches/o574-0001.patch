diff --git a/src/plugins/platforms/wayland/qwaylandstereoproblem.cpp b/src/plugins/platforms/wayland/qwaylandstereoproblem.cpp
new file mode 100644
index 00000000..80b6822e
--- /dev/null
+++ b/src/plugins/platforms/wayland/qwaylandstereoproblem.cpp
@@ -0,0 +1,212 @@
+// Copyright (C) 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+// Qt-Security score:significant reason:default
+
+#include "qwaylandstereoproblem_p.h"
+
+#include "qwaylanddisplay_p.h"
+
+#include <QtCore/qjsonarray.h>
+#include <QtCore/qjsondocument.h>
+#include <QtCore/qjsonobject.h>
+#include <QtCore/qlibrary.h>
+#include <QtCore/qmutex.h>
+#include <QtCore/qprocess.h>
+#include <QtCore/qset.h>
+#include <QtGui/qguiapplication.h>
+
+QT_BEGIN_NAMESPACE
+
+namespace QtWaylandClient {
+
+namespace QWaylandStereoProblem {
+
+namespace {
+
+// The package whose catalog holds the messages (debian/lang, built into journal catalogs at package build time)
+constexpr char Package[] = "libqt6waylandclient6";
+// sparky-stereo-problems.h: the person's own problems
+constexpr int ScopePerson = 2;
+
+using KeepFn = int (*)(int, const char *, const char *, const char *, const char *const *, int, const char *);
+using ClearFn = int (*)(int, const char *, const char *);
+using ListFn = char *(*)(const char *, const char *);
+using FreeFn = void (*)(void *);
+using ErrorFn = const char *(*)();
+
+struct Engine
+{
+    bool opened = false;
+    KeepFn keep = nullptr;
+    ClearFn clear = nullptr;
+    ListFn list = nullptr;
+    FreeFn free = nullptr;
+    ErrorFn errorEn = nullptr;
+};
+
+QBasicMutex s_mutex;
+Engine s_engine;
+QSet<QString> s_told;
+QSet<QString> s_ended;
+
+// The engine's library is private and of one architecture: it is opened at the first use, never linked, and a
+// process that cannot load it runs the engine's command.
+Engine &engine()
+{
+    if (!s_engine.opened) {
+        s_engine.opened = true;
+#ifdef QT_SPARKY_STEREO_PROBLEMS_LIBRARY
+        QLibrary library(QStringLiteral(QT_SPARKY_STEREO_PROBLEMS_LIBRARY));
+        if (library.load()) {
+            const auto keep = reinterpret_cast<KeepFn>(library.resolve("ssp_keep"));
+            const auto clear = reinterpret_cast<ClearFn>(library.resolve("ssp_clear"));
+            const auto list = reinterpret_cast<ListFn>(library.resolve("ssp_list_json"));
+            const auto free = reinterpret_cast<FreeFn>(library.resolve("ssp_free"));
+            const auto errorEn = reinterpret_cast<ErrorFn>(library.resolve("ssp_error_en"));
+            if (keep && clear && list && free && errorEn)
+                s_engine = Engine{true, keep, clear, list, free, errorEn};
+        }
+#endif
+    }
+    return s_engine;
+}
+
+QString programName()
+{
+    QString name = QGuiApplication::applicationDisplayName();
+    if (name.isEmpty())
+        name = QCoreApplication::applicationName();
+    return name.isEmpty() ? QStringLiteral("A program") : name;
+}
+
+// One key for each driver that gives one view, the API's own name of it; printable, as the engine's keys are.
+QString key(Api api, const QString &driver)
+{
+    QString name = driver.left(160);
+    for (QChar &c : name) {
+        if (c.unicode() < 0x20 || c.unicode() == 0x7f)
+            c = u'_';
+    }
+    return QStringLiteral("one-view:%1:%2").arg(api == Api::Vulkan ? QStringLiteral("vulkan") : QStringLiteral("opengl"), name);
+}
+
+// The same words as the catalog's English messages, for the program's log and where no catalog is installed.
+QString textEn(Api api, Reason reason, const QString &program, const QString &driver)
+{
+    if (reason == Reason::ZinkOwnSwapchain) {
+        return QStringLiteral("%1 asked for two pictures of its window, one for each eye, and OpenGL runs on zink through "
+                              "its own swapchain, which shows one picture, so the window is shown flat. The desktop "
+                              "session sets LIBGL_KOPPER_DISABLE=1 with zink; start the program with it too.").arg(program);
+    }
+    if (api == Api::Vulkan) {
+        return QStringLiteral("%1 asked for two pictures of its window, one for each eye, and the Vulkan driver %2 gives a "
+                              "window one picture only, so the window is shown flat. Programs that ask for 3D are shown "
+                              "flat on this driver until it gives two. Mesa's Vulkan drivers give two; for other drivers "
+                              "the package mesa-vulkan-layer-stereo gives them: check that it is installed and that "
+                              "DISABLE_LAYER_MESA_STEREO is not set.").arg(program, driver);
+    }
+    return QStringLiteral("%1 asked for two pictures of its window, one for each eye, and the OpenGL driver %2 gives a "
+                          "window one picture only, so the window is shown flat. Programs that ask for 3D are shown flat "
+                          "on this driver until it gives two. Mesa's OpenGL gives two, also on an NVIDIA card through "
+                          "zink, as the desktop session sets it; a program started on NVIDIA's own OpenGL gets them from "
+                          "the gl-stereo layer.").arg(program, driver);
+}
+
+bool isKept(Engine &e, const QByteArray &key)
+{
+    char *text = e.list(Package, nullptr);
+    if (!text)
+        return false;
+    const QJsonArray all = QJsonDocument::fromJson(QByteArray(text)).array();
+    e.free(text);
+    for (const QJsonValue &v : all) {
+        if (v.toObject().value(QLatin1StringView("key")).toString().toUtf8() == key)
+            return true;
+    }
+    return false;
+}
+
+} // namespace
+
+void oneViewGiven(Api api, const QString &driver, Reason reason)
+{
+    const QString k = key(api, driver);
+    QMutexLocker locker(&s_mutex);
+    if (s_told.contains(k))
+        return;
+    s_told.insert(k);
+    s_ended.remove(k);
+
+    const QString program = programName();
+    const QString text = textEn(api, reason, program, driver);
+    qCWarning(lcQpaWayland, "%ls", qUtf16Printable(text));
+
+    const QByteArray message = reason == Reason::ZinkOwnSwapchain ? "LOCAL4"
+            : api == Api::Vulkan ? "LOCAL2" : "LOCAL3";
+    QJsonArray args{program};
+    if (reason != Reason::ZinkOwnSwapchain)
+        args.append(driver);
+    const QJsonObject data{{QStringLiteral("api"), api == Api::Vulkan ? QStringLiteral("vulkan") : QStringLiteral("opengl")},
+                           {QStringLiteral("driver"), driver},
+                           {QStringLiteral("program"), program}};
+    const QByteArray details = QJsonDocument(QJsonObject{{QStringLiteral("severity"), QStringLiteral("failed")},
+                                                         {QStringLiteral("text_en"), text},
+                                                         {QStringLiteral("data"), data}})
+                                       .toJson(QJsonDocument::Compact);
+    const QByteArray keyUtf8 = k.toUtf8();
+
+    Engine &e = engine();
+    if (e.keep) {
+        // One problem for the driver: a program that meets it after the first does not make it new again.
+        if (isKept(e, keyUtf8))
+            return;
+        QList<QByteArray> argsUtf8;
+        for (const QJsonValue &v : std::as_const(args))
+            argsUtf8.append(v.toString().toUtf8());
+        const char *argv[2] = {argsUtf8.at(0).constData(), argsUtf8.size() > 1 ? argsUtf8.at(1).constData() : nullptr};
+        if (e.keep(ScopePerson, Package, keyUtf8.constData(), message.constData(), argv, argsUtf8.size(),
+                   details.constData()) != 0) {
+            qCWarning(lcQpaWayland, "sparky-stereo-problems: %s could not be kept, the person cannot be told: %s",
+                      keyUtf8.constData(), e.errorEn());
+        }
+        return;
+    }
+#ifdef QT_SPARKY_STEREO_PROBLEMS_LIBRARY
+    QStringList command{QStringLiteral("keep"), QStringLiteral("--person"), QStringLiteral("--quiet"),
+                        QStringLiteral("--details"), QString::fromUtf8(details), QLatin1StringView(Package), k,
+                        QString::fromLatin1(message)};
+    for (const QJsonValue &v : std::as_const(args))
+        command.append(v.toString());
+    if (QProcess::execute(QStringLiteral("/usr/bin/sparky-stereo-problems"), command) != 0)
+        qCWarning(lcQpaWayland, "sparky-stereo-problems could not keep %s: the person cannot be told", keyUtf8.constData());
+#endif
+}
+
+void twoViewsGiven(Api api, const QString &driver)
+{
+    const QString k = key(api, driver);
+    QMutexLocker locker(&s_mutex);
+    if (s_ended.contains(k))
+        return;
+    s_ended.insert(k);
+    s_told.remove(k);
+
+    // The engine ends nothing that is not there, so a problem an earlier program kept for this driver ends here.
+    const QByteArray keyUtf8 = k.toUtf8();
+    Engine &e = engine();
+    if (e.clear) {
+        if (e.clear(ScopePerson, Package, keyUtf8.constData()) != 0)
+            qCWarning(lcQpaWayland, "sparky-stereo-problems: %s could not be ended: %s", keyUtf8.constData(), e.errorEn());
+        return;
+    }
+#ifdef QT_SPARKY_STEREO_PROBLEMS_LIBRARY
+    QProcess::execute(QStringLiteral("/usr/bin/sparky-stereo-problems"),
+                      {QStringLiteral("clear"), QStringLiteral("--person"), QLatin1StringView(Package), k});
+#endif
+}
+
+} // namespace QWaylandStereoProblem
+
+} // namespace QtWaylandClient
+
+QT_END_NAMESPACE
