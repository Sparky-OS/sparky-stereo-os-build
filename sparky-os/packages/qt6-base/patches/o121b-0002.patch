From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Subject: [PATCH] Draw declared widget rectangles in graphics effect sources

Effects continue to own the final composite and its bounds. Render their
source with the current eye's rectangle depths and refresh the source
cache per eye. Calligra Words uses this path for its canvas shadow.

Assisted-by: gpt-6.2-sol via Codex

diff --git a/src/widgets/kernel/qwidget.cpp b/src/widgets/kernel/qwidget.cpp
--- a/src/widgets/kernel/qwidget.cpp
+++ b/src/widgets/kernel/qwidget.cpp
@@ -5631,6 +5631,8 @@
         QWidgetEffectSourcePrivate *sourced = static_cast<QWidgetEffectSourcePrivate *>
                                                          (source->d_func());
         if (!sourced->context) {
+            if (repaintManager && qt_widget_stereo_eye() && q->property("_q_stereo_depth_rects").isValid())
+                sourced->invalidateCache(); // a stereo effect source differs between eyes
             const QRegion effectRgn((flags & UseEffectRegionBounds) ? rgn.boundingRect() : rgn);
             QWidgetPaintContext context(pdev, effectRgn, offset, flags, sharedPainter, repaintManager);
             sourced->context = &context;
@@ -6068,8 +6070,11 @@
     if (!eye || sharedPainter || rgn.isEmpty())
         return false;
 #if QT_CONFIG(graphicseffect)
-    if (graphicsEffect && graphicsEffect->isEnabled())
-        return false;
+    if (graphicsEffect && graphicsEffect->isEnabled()) {
+        const auto *source = static_cast<QWidgetEffectSourcePrivate *>(graphicsEffect->d_func()->source->d_func());
+        if (!source->context)
+            return false; // the effect owns the paint, including its source
+    }
 #endif
     const QVariantList declared = q->property("_q_stereo_depth_rects").toList();
     if (declared.isEmpty())
@@ -6206,6 +6211,11 @@
     if (wd->extra && wd->extra->hasMask)
         toBePainted &= wd->extra->mask;
 
+    if (context->repaintManager
+        && wd->paintStereoDepthRects(context->pdev, toBePainted, context->offset, context->flags,
+                                     context->sharedPainter, context->repaintManager)) {
+        return;
+    }
     wd->drawWidget(context->pdev, toBePainted, context->offset, context->flags,
                    context->sharedPainter, context->repaintManager);
 }
@@ -6252,6 +6262,14 @@
     pixmap.setDevicePixelRatio(dpr);
 
     pixmap.fill(Qt::transparent);
+    QWidgetPrivate *wd = qt_widget_private(m_widget);
+    QRegion sourceRegion(m_widget->rect());
+    if (wd->extra && wd->extra->hasMask)
+        sourceRegion &= wd->extra->mask;
+    if (context && context->repaintManager && !context->sharedPainter
+        && wd->paintStereoDepthRects(&pixmap, sourceRegion, pixmapOffset, QWidgetPrivate::DrawRecursive, nullptr, nullptr)) {
+        return pixmap;
+    }
     m_widget->render(&pixmap, pixmapOffset, QRegion(), QWidget::DrawChildren);
     return pixmap;
 }
