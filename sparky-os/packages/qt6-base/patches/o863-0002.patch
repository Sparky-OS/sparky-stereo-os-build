@@ -7361,6 +7425,8 @@ void QWidget::move(const QPoint &p)
 
     if (d->extra && d->extra->hasWindowContainer)
         QWindowContainer::parentWasMoved(this);
+    if (d->extra && d->extra->hasStereoWindow)
+        QWidgetPrivate::placeStereoWindows(this);
 }
 
