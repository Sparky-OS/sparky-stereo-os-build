+// A stereo window under alien ancestors is not moved along when they move (scroll areas, layouts, docks): the widgets
+// from it up to its window are marked, and a move of a marked widget places the stereo windows below it, as
+// QWindowContainer::parentWasMoved() does for window containers. A move inside a flush of the backing store would
+// repaint the top level from within that flush (a synchronous expose on Wayland) and free the texture list it reads.
+void QWidgetPrivate::markStereoWindowParentChain()
+{
+    Q_Q(QWidget);
+    for (QWidget *w = q; w; w = w->parentWidget()) {
+        QWidgetPrivate *wd = w->d_func();
+        wd->createExtra();
+        wd->extra->hasStereoWindow = true;
+        if (w->isWindow())
+            break;
+    }
+}
+
+void QWidgetPrivate::placeStereoWindows(QWidget *widget)
+{
+    QWidgetPrivate *d = widget->d_func();
+    if (!d->extra || !d->extra->hasStereoWindow)
+        return;
+    if (!widget->isWindow() && widget->testAttribute(Qt::WA_WState_Created) && d->hasStereoWindow()) {
+        QWindow *window = widget->windowHandle();
+        QWidget *nativeParent = widget->nativeParentWidget();
+        if (window && nativeParent) {
+            const QPoint posInNativeParent = widget->mapTo(nativeParent, QPoint());
+            if (window->position() != posInNativeParent)
+                window->setPosition(posInNativeParent);
+        }
+    }
+    for (QObject *child : std::as_const(d->children)) {
+        QWidget *w = qobject_cast<QWidget *>(child);
+        if (w && !w->isWindow())
+            placeStereoWindows(w);
+    }
+}
+
+// A marked widget got a new parent: its stereo windows mark their new ancestors, and are placed
+void QWidgetPrivate::stereoWindowParentWasChanged(QWidget *widget)
+{
+    const auto mark = [](QWidget *w, const auto &self) -> void {
+        QWidgetPrivate *wd = w->d_func();
+        if (!wd->extra || !wd->extra->hasStereoWindow)
+            return;
+        if (wd->hasStereoWindow())
+            wd->markStereoWindowParentChain();
+        for (QObject *child : std::as_const(wd->children)) {
+            QWidget *cw = qobject_cast<QWidget *>(child);
+            if (cw && !cw->isWindow())
+                self(cw, self);
+        }
+    };
+    mark(widget, mark);
+    placeStereoWindows(widget);
+}
+
