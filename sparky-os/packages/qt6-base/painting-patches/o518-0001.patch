+qreal QWidgetPrivate::stereoParallaxF(const QWidget *widget)
+{
+    for (; widget; widget = widget->isWindow() ? nullptr : widget->parentWidget()) {
+        const QVariant parallax = widget->property("_q_stereo_parallax");
+        if (parallax.isValid())
+            return parallax.toReal();
+    }
+    return 0;
