+/*
+    GPU painting of widgets (prototype, behind QT_WIDGETS_GPU_PAINT=1): the backing store of a
+    widget window that is flushed through the OpenGL RHI is made by Qt OpenGL, whose paint engine
+    draws the widgets into a texture. Qt Gui cannot link Qt OpenGL, so the library is opened here.
+    A store that cannot be made is said, with the reason, and the window is painted on the CPU.
+*/
+static QPlatformBackingStore *createGpuPaintBackingStore(QWindow *window)
+{
+    static const bool wanted = qEnvironmentVariableIntValue("QT_WIDGETS_GPU_PAINT");
+    if (!wanted || window->surfaceType() != QSurface::OpenGLSurface || !window->inherits("QWidgetWindow"))
+        return nullptr;
+    typedef QPlatformBackingStore *(*Factory)(QWindow *, QString *);
+    static Factory factory = nullptr;
+    static QString failure;
+    static bool resolved = false;
+    if (!resolved) {
+        resolved = true;
+        QLibrary library(QStringLiteral("Qt6OpenGL"), 6);
+        factory = Factory(library.resolve("qt_create_opengl_paint_backingstore"));
+        if (!factory)
+            failure = library.errorString();
+    }
+    QPlatformBackingStore *store = factory ? factory(window, &failure) : nullptr;
+    if (!store) {
+        static bool said = false;
+        if (!said) {
+            said = true;
+            qWarning("QT_WIDGETS_GPU_PAINT: painting on the GPU could not start (%s); "
+                     "this program's widgets are painted on the CPU.", qPrintable(failure));
+        }
+    }
+    return store;
+}
+
 QPlatformBackingStore *QBackingStore::handle() const
 {
     if (!d_ptr->platformBackingStore) {
-        d_ptr->platformBackingStore = QGuiApplicationPrivate::platformIntegration()->createPlatformBackingStore(d_ptr->window);
+        d_ptr->platformBackingStore = createGpuPaintBackingStore(d_ptr->window);
+        if (!d_ptr->platformBackingStore)
+            d_ptr->platformBackingStore = QGuiApplicationPrivate::platformIntegration()->createPlatformBackingStore(d_ptr->window);
         d_ptr->platformBackingStore->setBackingStore(const_cast<QBackingStore*>(this));
     }
     return d_ptr->platformBackingStore;
