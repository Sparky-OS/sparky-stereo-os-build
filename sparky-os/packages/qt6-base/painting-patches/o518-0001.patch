@@ -0,0 +1,352 @@
+// Copyright (C) 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+/*
+    A backing store whose widgets are painted by the OpenGL paint engine (prototype, behind
+    QT_WIDGETS_GPU_PAINT=1).
+
+    The window's widgets are painted into a framebuffer object, multisampled since the engine
+    antialiases by samples only, on a context of its own that shares with the context the window's
+    RHI composes with. The resolved texture is handed to the RHI flush
+    (QPlatformBackingStore::gpuTexture()), so no image is uploaded, and the frame reaches the
+    window's own EGL surface on the GPU the process draws with.
+
+    The contents are kept between paints, as a raster store's are, so a partial update paints
+    its own region only; scroll() moves a region on the GPU.
+*/
+
+#include <QtOpenGL/qopenglframebufferobject.h>
+#include <QtOpenGL/qopenglpaintdevice.h>
+#include <QtOpenGL/private/qopenglpaintdevice_p.h>
+
+#include <QtGui/qoffscreensurface.h>
+#include <QtGui/qopenglcontext.h>
+#include <QtGui/qopenglextrafunctions.h>
+#include <QtGui/qwindow.h>
+#include <QtGui/private/qopenglcontext_p.h>
+#include <qpa/qplatformbackingstore.h>
+#include <rhi/qrhi.h>
+
+#include <QtCore/qdebug.h>
+#include <QtCore/qmath.h>
+
+#include <memory>
+
+QT_BEGIN_NAMESPACE
+
+// The part of a pixel that everything the paint engine draws is moved to the right by
+// (qopenglpaintengine.cpp): an element's eye shift, set by the widgets' repaint manager through
+// QPlatformBackingStore::setPaintSubPixelOffset().
+Q_OPENGL_EXPORT qreal qt_gl_paint_subpixel_offset = 0;
+
+namespace {
+
+struct PaintContext
+{
+    QOpenGLContext *context = nullptr;
+    QOffscreenSurface *surface = nullptr;
+    int samples = 4;
+};
+
+PaintContext *paintContext(QString *failure)
+{
+    static PaintContext s_context;
+    static QString s_failure;
+    static bool s_tried = false;
+    if (!s_tried) {
+        s_tried = true;
+        // Every window's RHI shares with the global share context; the paint context joins it,
+        // so each window's compositor can sample what is painted here.
+        if (!QOpenGLContext::globalShareContext()) {
+            auto *share = new QOpenGLContext;
+            share->setFormat(QSurfaceFormat::defaultFormat());
+            if (!share->create()) {
+                delete share;
+                s_failure = QStringLiteral("no OpenGL context could be created");
+            } else {
+                qt_gl_set_global_share_context(share);
+            }
+        }
+        if (s_failure.isEmpty()) {
+            auto context = std::make_unique<QOpenGLContext>();
+            context->setFormat(QSurfaceFormat::defaultFormat());
+            context->setShareContext(QOpenGLContext::globalShareContext());
+            auto surface = std::make_unique<QOffscreenSurface>();
+            if (!context->create()) {
+                s_failure = QStringLiteral("no OpenGL context could be created");
+            } else {
+                surface->setFormat(context->format());
+                surface->create();
+                if (!context->makeCurrent(surface.get())) {
+                    s_failure = QStringLiteral("the OpenGL context could not be made current");
+                } else if (!QOpenGLFramebufferObject::hasOpenGLFramebufferObjects()
+                           || !QOpenGLFramebufferObject::hasOpenGLFramebufferBlit()) {
+                    s_failure = QStringLiteral("this OpenGL has no framebuffer objects with blit");
+                } else {
+                    bool ok = false;
+                    const int samples = qEnvironmentVariableIntValue("QT_WIDGETS_GPU_PAINT_SAMPLES", &ok);
+                    if (ok)
+                        s_context.samples = qMax(0, samples);
+                    if (qEnvironmentVariableIntValue("QT_WIDGETS_PAINT_STATS")) {
+                        auto *f = context->functions();
+                        qInfo("QT_WIDGETS_GPU_PAINT: OpenGL painting on \"%s\" (%s), %d samples",
+                              reinterpret_cast<const char *>(f->glGetString(GL_RENDERER)),
+                              reinterpret_cast<const char *>(f->glGetString(GL_VERSION)), s_context.samples);
+                    }
+                    s_context.context = context.release();
+                    s_context.surface = surface.release();
+                }
+            }
+        }
+    }
+    if (!s_context.context) {
+        *failure = s_failure;
+        return nullptr;
+    }
+    return &s_context;
+}
+
+class QOpenGLPaintBackingStore;
+
+class BackingStorePaintDevice : public QOpenGLPaintDevice
+{
+public:
+    explicit BackingStorePaintDevice(QOpenGLPaintBackingStore *store) : m_store(store) { }
+    void ensureActiveTarget() override;
+
+private:
+    QOpenGLPaintBackingStore *m_store;
+};
+
+class QOpenGLPaintBackingStore : public QPlatformBackingStore
+{
+public:
+    QOpenGLPaintBackingStore(QWindow *window, PaintContext *context)
+        : QPlatformBackingStore(window), m_context(context)
+    {
+        setGpuTextureProvider([this](QRhi *rhi, TextureFlags *flags) { return texture(rhi, flags); });
+        setPaintSubPixelOffsetSetter([](qreal dx) { qt_gl_paint_subpixel_offset = dx; });
+    }
+
+    ~QOpenGLPaintBackingStore() override
+    {
+        delete m_rhiTexture;
+        if (m_context->context->makeCurrent(m_context->surface)) {
+            m_device.reset();
+            m_paintFbo.reset();
+            m_textureFbo.reset();
+            m_scratchFbo.reset();
+            m_context->context->doneCurrent();
+        }
+    }
+
+    QPaintDevice *paintDevice() override
+    {
+        ensureTargets();
+        return m_device.get();
+    }
+
+    void resize(const QSize &size, const QRegion &) override { m_size = size; }
+
+    void beginPaint(const QRegion &region) override
+    {
+        ensureTargets();
+        m_dirty = QRect();
+        for (const QRect &rect : region)
+            m_dirty |= deviceRect(rect);
+        m_dirty &= QRect(QPoint(), m_pixelSize);
+        activate();
+        // A translucent window starts from nothing where it paints, as a raster store does.
+        if (window()->requestedFormat().hasAlpha() && !m_dirty.isEmpty()) {
+            auto *f = m_context->context->functions();
+            f->glEnable(GL_SCISSOR_TEST);
+            f->glScissor(m_dirty.x(), m_pixelSize.height() - m_dirty.y() - m_dirty.height(), m_dirty.width(), m_dirty.height());
+            f->glClearColor(0, 0, 0, 0);
+            f->glClear(GL_COLOR_BUFFER_BIT);
+            f->glDisable(GL_SCISSOR_TEST);
+        }
+    }
+
+    void endPaint() override
+    {
+        if (!m_paintFbo)
+            return;
+        if (!m_context->context->makeCurrent(m_context->surface))
+            return;
+        if (m_textureFbo != m_paintFbo && !m_dirty.isEmpty()) {
+            // resolve the samples of what was painted
+            const QRect r = glRect(m_dirty);
+            QOpenGLFramebufferObject::blitFramebuffer(m_textureFbo.get(), r, m_paintFbo.get(), r,
+                                                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        }
+        // the window's context samples the texture next
+        m_context->context->functions()->glFlush();
+        m_context->context->doneCurrent();
+    }
+
+    void flush(QWindow *, const QRegion &, const QPoint &) override
+    {
+        qWarning("QOpenGLPaintBackingStore: flushed without the RHI; nothing is shown");
+    }
+
+    bool scroll(const QRegion &area, int dx, int dy) override
+    {
+        if (!m_paintFbo || !m_context->context->makeCurrent(m_context->surface))
+            return false;
+        const qreal dpr = m_dpr;
+        if (!qFuzzyCompare(dx * dpr, qRound(dx * dpr)) || !qFuzzyCompare(dy * dpr, qRound(dy * dpr)))
+            return false;
+        const QPoint delta(qRound(dx * dpr), qRound(dy * dpr));
+        if (!m_scratchFbo || m_scratchFbo->size() != m_pixelSize) {
+            QOpenGLFramebufferObjectFormat format;
+            format.setInternalTextureFormat(GL_RGBA8);
+            m_scratchFbo = std::make_unique<QOpenGLFramebufferObject>(m_pixelSize, format);
+        }
+        const QRect bounds(QPoint(), m_pixelSize);
+        for (const QRect &rect : area) {
+            const QRect source = deviceRect(rect) & bounds;
+            const QRect target = source.translated(delta) & bounds;
+            const QRect from = target.translated(-delta);
+            if (from.isEmpty())
+                continue;
+            // a blit within one framebuffer must not overlap itself (OpenGL 4.6, 18.3.1), so the
+            // region goes through a copy
+            QOpenGLFramebufferObject::blitFramebuffer(m_scratchFbo.get(), glRect(from), m_textureFbo.get(), glRect(from),
+                                                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            QOpenGLFramebufferObject::blitFramebuffer(m_textureFbo.get(), glRect(target), m_scratchFbo.get(), glRect(from),
+                                                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            if (m_textureFbo != m_paintFbo) {
+                QOpenGLFramebufferObject::blitFramebuffer(m_paintFbo.get(), glRect(target), m_scratchFbo.get(), glRect(from),
+                                                          GL_COLOR_BUFFER_BIT, GL_NEAREST);
+            }
+        }
+        m_context->context->functions()->glFlush();
+        m_context->context->doneCurrent();
+        return true;
+    }
+
+    QImage toImage() const override
+    {
+        if (!m_textureFbo || !m_context->context->makeCurrent(m_context->surface))
+            return QImage();
+        QImage image = m_textureFbo->toImage();
+        image.setDevicePixelRatio(m_dpr);
+        m_context->context->doneCurrent();
+        return image;
+    }
+
+    // Makes the paint context current with the framebuffer the widgets are painted into.
+    void activate()
+    {
+        if (QOpenGLContext::currentContext() != m_context->context)
+            m_context->context->makeCurrent(m_context->surface);
+        if (m_paintFbo)
+            m_paintFbo->bind();
+    }
+
+private:
+    QRect deviceRect(const QRect &rect) const
+    {
+        return QRectF(rect.x() * m_dpr, rect.y() * m_dpr, rect.width() * m_dpr, rect.height() * m_dpr).toAlignedRect();
+    }
+
+    // OpenGL counts rows from the bottom.
+    QRect glRect(const QRect &rect) const
+    {
+        return QRect(rect.x(), m_pixelSize.height() - rect.y() - rect.height(), rect.width(), rect.height());
+    }
+
+    void ensureTargets()
+    {
+        const qreal dpr = window()->devicePixelRatio();
+        const QSize pixelSize(qCeil(m_size.width() * dpr), qCeil(m_size.height() * dpr));
+        if (m_paintFbo && pixelSize == m_pixelSize && dpr == m_dpr)
+            return;
+        if (pixelSize.isEmpty() || !m_context->context->makeCurrent(m_context->surface))
+            return;
+        m_pixelSize = pixelSize;
+        m_dpr = dpr;
+
+        QOpenGLFramebufferObjectFormat textureFormat;
+        textureFormat.setInternalTextureFormat(GL_RGBA8);
+        QOpenGLFramebufferObjectFormat paintFormat = textureFormat;
+        paintFormat.setAttachment(QOpenGLFramebufferObject::CombinedDepthStencil);
+        paintFormat.setSamples(m_context->samples);
+
+        m_paintFbo = std::make_shared<QOpenGLFramebufferObject>(pixelSize, paintFormat);
+        if (m_paintFbo->format().samples() > 0)
+            m_textureFbo = std::make_shared<QOpenGLFramebufferObject>(pixelSize, textureFormat);
+        else
+            m_textureFbo = m_paintFbo;
+        m_scratchFbo.reset();
+        delete m_rhiTexture;
+        m_rhiTexture = nullptr;
+
+        auto *f = m_context->context->functions();
+        for (QOpenGLFramebufferObject *fbo : { m_paintFbo.get(), m_textureFbo.get() }) {
+            fbo->bind();
+            f->glClearColor(0, 0, 0, window()->requestedFormat().hasAlpha() ? 0 : 1);
+            f->glClear(GL_COLOR_BUFFER_BIT);
+        }
+
+        if (!m_device)
+            m_device = std::make_unique<BackingStorePaintDevice>(this);
+        m_device->setSize(pixelSize);
+        m_device->setDevicePixelRatio(dpr);
+        m_paintFbo->bind();
+    }
+
+    QRhiTexture *texture(QRhi *rhi, TextureFlags *flags)
+    {
+        if (!m_textureFbo)
+            return nullptr;
+        if (!m_rhiTexture || m_rhi != rhi) {
+            delete m_rhiTexture;
+            m_rhi = rhi;
+            m_rhiTexture = rhi->newTexture(QRhiTexture::RGBA8, m_pixelSize);
+            if (!m_rhiTexture->createFrom({ quint64(m_textureFbo->texture()), 0 })) {
+                delete m_rhiTexture;
+                m_rhiTexture = nullptr;
+                return nullptr;
+            }
+        }
+        // a framebuffer's texture has its first row at the bottom; the engine writes
+        // premultiplied colour
+        *flags = TextureFlip | TexturePremultiplied;
+        return m_rhiTexture;
+    }
+
+    PaintContext *m_context;
+    QSize m_size;
+    QSize m_pixelSize;
+    qreal m_dpr = 1;
+    QRect m_dirty;
+    std::shared_ptr<QOpenGLFramebufferObject> m_paintFbo;
+    std::shared_ptr<QOpenGLFramebufferObject> m_textureFbo;
+    std::unique_ptr<QOpenGLFramebufferObject> m_scratchFbo;
+    std::unique_ptr<BackingStorePaintDevice> m_device;
+    QRhi *m_rhi = nullptr;
+    QRhiTexture *m_rhiTexture = nullptr;
+};
+
+void BackingStorePaintDevice::ensureActiveTarget()
+{
+    m_store->activate();
+}
