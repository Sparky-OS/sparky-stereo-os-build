+/*
+    Makes the backing store of \a window, a widget window flushed through the OpenGL RHI. Returns
+    null, with the reason in \a failure, when OpenGL painting cannot start; QBackingStore then
+    says so and paints on the CPU.
+*/
+extern "C" Q_OPENGL_EXPORT QPlatformBackingStore *qt_create_opengl_paint_backingstore(QWindow *window, QString *failure)
+{
+    PaintContext *context = paintContext(failure);
+    if (!context)
+        return nullptr;
+    return new QOpenGLPaintBackingStore(window, context);
+}
