+// Adds the time of one call of the engine to its store's count (QT_WIDGETS_PAINT_STATS=2); calls
+// the engine makes from inside another are part of that one.
+template <typename Store>
+struct EngineTime
+{
+    explicit EngineTime(Store *store) : store(store)
+    {
+        if (store->timeEngine && store->engineDepth++ == 0)
+            clock.start();
+    }
+    ~EngineTime()
+    {
+        if (store->timeEngine && --store->engineDepth == 0)
+            store->engineNs += clock.nsecsElapsed();
+    }
+    Store *store;
+    QElapsedTimer clock;
+};
+#define QBATCH_TIME EngineTime<QBatchedPaintBackingStore> engineTime(m_store)
+
