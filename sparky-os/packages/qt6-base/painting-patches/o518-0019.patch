From 709b5e236bc61b19cfe70702acba1f1341d6bf4e Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Fri, 13 Nov 2026 11:16:40 -0300
Subject: [PATCH] Wayland: blit a decorated Widgets pair into one buffer

Keep the frame identical in the two halves and select each half of the content texture. The raster store keeps its existing CSD exception.

Assisted-by: GPT-6.1-sol via Codex
---
 .../wayland-egl/qwaylandeglwindow.cpp          | 14 +++++++++-----
 .../wayland-egl/qwaylandeglwindow_p.h          |  1 +
 .../wayland-egl/qwaylandglcontext.cpp          | 18 ++++++++++++------
 src/widgets/kernel/qwidgetrepaintmanager.cpp   |  9 +++++----
 4 files changed, 27 insertions(+), 15 deletions(-)

diff --git a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
index 7be5bb7..affbdba 100644
--- a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
+++ b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
@@ -197,7 +197,7 @@ void QWaylandEglWindow::destroySurface()
 
 bool QWaylandEglWindow::pairWanted(const QSurfaceFormat &format) const
 {
-    return m_pairRequested.load(std::memory_order_acquire)
+    return !m_sideBySide && m_pairRequested.load(std::memory_order_acquire)
             && m_clientBufferIntegration->supportsTwoViews(format)
             && QWaylandStereoDepth::isSupported(mDisplay);
 }
@@ -216,11 +216,13 @@ void QWaylandEglWindow::updateSideBySidePair()
 {
     const QSurfaceFormat fmt = window()->requestedFormat();
     // Only for an engine that composes the pair itself and says so (_q_stereo_pair, set by the widgets'
-    // repaint manager); Qt Quick's renderer draws into two views. A frame the client draws keeps the
-    // window flat, as on every path, and a pair that is 3D content is the program's own.
+    // repaint manager); Qt Quick's renderer draws into two views. With a decoration, keep the
+    // content in one double-width FBO and blit each half with the same frame. A pair that is 3D
+    // content is the program's own.
     const bool want = m_pairRequested.load(std::memory_order_acquire) && window()->property("_q_stereo_pair").toBool()
-            && !m_clientBufferIntegration->supportsTwoViews(fmt) && !m_clientBufferIntegration->supportsStereo(fmt)
-            && QWaylandStereoDepth::isSupported(mDisplay) && !decoration() && !contentPair();
+            && (decoration() || (!m_clientBufferIntegration->supportsTwoViews(fmt)
+                                  && !m_clientBufferIntegration->supportsStereo(fmt)))
+            && QWaylandStereoDepth::isSupported(mDisplay) && !contentPair();
     if (want == m_sideBySide)
         return;
     m_sideBySide = want;
@@ -287,6 +289,8 @@ GLuint QWaylandEglWindow::contentFBO() const
     if (m_resize || !m_contentFBO) {
         QOpenGLFramebufferObject *old = m_contentFBO;
         QSize fboSize = geometry().size() * scale();
+        if (m_sideBySide)
+            fboSize.rwidth() *= 2;
         m_contentFBO = new QOpenGLFramebufferObject(fboSize.width(), fboSize.height(), QOpenGLFramebufferObject::CombinedDepthStencil);
         // A stereo window has a slot per eye: the right eye is rendered into the second attachment
         if (m_twoViews) {
diff --git a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow_p.h b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow_p.h
index ca82222..fa5f5dc 100644
--- a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow_p.h
+++ b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow_p.h
@@ -34,6 +34,7 @@ public:
     GLuint contentFBO() const;
     GLuint contentTexture(int eye = 0) const;
     int contentEyes() const;
+    bool sideBySidePair() const { return m_sideBySide; }
     bool needToUpdateContentFBO() const { return decoration() && (m_resize || !m_contentFBO); }
 
     void bindContentFBO();
diff --git a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp
index 9041347..c1baa08 100644
--- a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp
+++ b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandglcontext.cpp
@@ -123,11 +123,12 @@ public:
         m_blitProgram = new QOpenGLShaderProgram();
         m_blitProgram->addShaderFromSourceCode(QOpenGLShader::Vertex, "attribute vec4 position;\n\
                                                                     attribute vec4 texCoords;\n\
+                                                                    uniform vec2 textureRange;\n\
                                                                     varying vec2 outTexCoords;\n\
                                                                     void main()\n\
                                                                     {\n\
                                                                         gl_Position = position;\n\
-                                                                        outTexCoords = texCoords.xy;\n\
+                                                                        outTexCoords = vec2(textureRange.x + texCoords.x * textureRange.y, texCoords.y);\n\
                                                                     }");
         m_blitProgram->addShaderFromSourceCode(QOpenGLShader::Fragment, "varying highp vec2 outTexCoords;\n\
                                                                         uniform sampler2D texture;\n\
@@ -197,9 +198,9 @@ public:
     void blit(QWaylandEglWindow *window)
     {
         // The decoration is the same in both eyes of a stereo window, and each eye has its own content
-        const int eyes = m_drawBuffer ? window->contentEyes() : 1;
+        const int eyes = window->sideBySidePair() ? 2 : (m_drawBuffer ? window->contentEyes() : 1);
         for (int eye = 0; eye < eyes; ++eye) {
-            if (m_drawBuffer)
+            if (m_drawBuffer && !window->sideBySidePair())
                 m_drawBuffer(eye == 1 ? GL_BACK_RIGHT : GL_BACK_LEFT);
             blit(window, eye);
         }
@@ -217,7 +218,10 @@ public:
         // framebuffer, which displaced a row and a column of it.
         const qreal scale = window->scale();
         const QSize bufferSize = window->surfaceSize() * scale;
-        glViewport(0, 0, bufferSize.width(), bufferSize.height());
+        const bool sideBySide = window->sideBySidePair();
+        const int eyeX = sideBySide ? eye * bufferSize.width() : 0;
+        glViewport(eyeX, 0, bufferSize.width(), bufferSize.height());
+        m_blitProgram->setUniformValue("textureRange", QVector2D(0, 1));
 
         //Draw Decoration
         if (auto *decoration = window->decoration()) {
@@ -233,11 +237,13 @@ public:
 
         //Draw Content
         m_blitProgram->setAttributeBuffer(0, GL_FLOAT, m_squareVerticesOffset, 2);
-        glBindTexture(GL_TEXTURE_2D, window->contentTexture(eye));
+        glBindTexture(GL_TEXTURE_2D, window->contentTexture(sideBySide ? 0 : eye));
+        if (sideBySide)
+            m_blitProgram->setUniformValue("textureRange", QVector2D(eye * 0.5f, 0.5f));
         const QMargins margins = window->clientSideMargins() * scale;
         const QSize contentSize = window->geometry().size() * scale;
         // from the buffer's top, as the shared memory store places the content; OpenGL counts from the bottom
-        glViewport(margins.left(), bufferSize.height() - margins.top() - contentSize.height(), contentSize.width(), contentSize.height());
+        glViewport(eyeX + margins.left(), bufferSize.height() - margins.top() - contentSize.height(), contentSize.width(), contentSize.height());
         glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
     }
 
diff --git a/src/widgets/kernel/qwidgetrepaintmanager.cpp b/src/widgets/kernel/qwidgetrepaintmanager.cpp
index 6bd8af5..03aa4e2 100644
--- a/src/widgets/kernel/qwidgetrepaintmanager.cpp
+++ b/src/widgets/kernel/qwidgetrepaintmanager.cpp
@@ -570,7 +570,11 @@ static bool paintsPerEye(QWidget *tlw)
     const QWindow *window = tlw->windowHandle();
     if (!window || !window->property("_q_stereo_depth").toBool())
         return false;
-    // A window with a frame the client draws around it stays flat: measured, the Wayland EGL
+    // GPU stores can hand a decorated pair to the Wayland frame blitter as one wide texture.
+    static const bool keepExceptions = qEnvironmentVariableIntValue("QT_WIDGETS_GPU_PAINT_FLAT_EXCEPTIONS");
+    if (!keepExceptions && tlw->backingStore() && tlw->backingStore()->handle()->paintsOnGpu())
+        return true;
+    // A window with a frame the client draws around it stays flat on the raster store.
     // window of such a window shows the left eye only, so the pair would cost a second painting
     // and show nothing.
     if (!window->frameMargins().isNull())
@@ -579,9 +583,6 @@ static bool paintsPerEye(QWidget *tlw)
     // surface, and the compositor draws each render-to-texture widget into both, so such a
     // widget no longer keeps the window flat (QT_WIDGETS_GPU_PAINT_FLAT_EXCEPTIONS=1 keeps that
     // exception, for comparing).
-    static const bool keepExceptions = qEnvironmentVariableIntValue("QT_WIDGETS_GPU_PAINT_FLAT_EXCEPTIONS");
-    if (!keepExceptions && tlw->backingStore() && tlw->backingStore()->handle()->paintsOnGpu())
-        return true;
     return !qt_widget_private(tlw)->textureChildSeen;
 }
 
-- 
