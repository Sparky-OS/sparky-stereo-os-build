+/*
+    The device the raster engine's painter is begun on: it says it is a widget and hands the
+    scratch image over as where to draw. The raster engine asks a font for its own kind of mask
+    (the masks by colour channel of LCD antialiasing) only when the painter's device is a widget,
+    and for 8-bit masks otherwise; so text the raster engine draws here is the text it draws
+    into a widget's raster store.
+*/
+class QBatchedScratchDevice : public QPaintDevice
+{
+public:
+    explicit QBatchedScratchDevice(QImage *image) : m_image(image) { }
+    int devType() const override { return QInternal::Widget; }
+    QPaintEngine *paintEngine() const override { return m_image->paintEngine(); }
+
+protected:
+    QPaintDevice *redirected(QPoint *offset) const override
+    {
+        if (offset)
+            *offset = QPoint();
+        return m_image;
+    }
+    int metric(PaintDeviceMetric metric) const override
+    {
+        switch (metric) {
+        case PdmWidth:
+            return m_image->width();
+        case PdmHeight:
+            return m_image->height();
+        case PdmWidthMM:
+            return m_image->widthMM();
+        case PdmHeightMM:
+            return m_image->heightMM();
+        case PdmNumColors:
+            return m_image->colorCount();
+        case PdmDepth:
+            return m_image->depth();
+        case PdmDpiX:
+        case PdmPhysicalDpiX:
+            return m_image->logicalDpiX();
+        case PdmDpiY:
+        case PdmPhysicalDpiY:
+            return m_image->logicalDpiY();
+        case PdmDevicePixelRatio:
+            return 1;
+        case PdmDevicePixelRatioScaled:
+            return int(devicePixelRatioFScale());
+        case PdmDevicePixelRatioF_EncodedA:
+        case PdmDevicePixelRatioF_EncodedB:
+            return QPaintDevice::encodeMetricF(metric, 1.0);
+        }
+        return 0;
+    }
+
+private:
+    QImage *m_image;
+};
