diff --git a/src/gui/painting/shaders/batchpaint_dual.frag b/src/gui/painting/shaders/batchpaint_dual.frag
new file mode 100644
index 0000000..8309645
--- /dev/null
+++ b/src/gui/painting/shaders/batchpaint_dual.frag
@@ -0,0 +1,68 @@
+#version 440
+
+layout(location = 0) in vec2 v_source;
+layout(location = 1) flat in vec4 v_rect;
+layout(location = 2) flat in vec4 v_color;
+layout(location = 3) flat in float v_mode;
+
+// Two outputs for blending with a weight for each colour channel (dual-source blending):
+// what is there is kept by one minus the weights. Text with coloured-fringe (LCD) antialiasing
+// has a mask for each channel; everything else weighs all channels by its alpha.
+layout(location = 0, index = 0) out vec4 fragColor;
+layout(location = 0, index = 1) out vec4 fragWeights;
+
+layout(std140, binding = 0) uniform buf {
+    mat4 deviceToClip;
+    vec4 rowOrder;
+    vec4 glyphsImages;
+    vec4 scratch;
+};
+
+layout(binding = 1) uniform sampler2D glyphTexture;
+layout(binding = 2) uniform sampler2D imageTexture;
+layout(binding = 3) uniform sampler2D scratchTexture;
+
+void main()
+{
+    // The part of this pixel the rectangle covers: all of it for a rectangle on whole pixels,
+    // so such a rectangle is drawn as the raster engine draws it.
+    vec2 pixel = vec2(gl_FragCoord.x, rowOrder.x + rowOrder.y * gl_FragCoord.y);
+    vec2 covered = clamp(min(pixel + 0.5, v_rect.zw) - max(pixel - 0.5, v_rect.xy), 0.0, 1.0);
+    float coverage = covered.x * covered.y;
+
+    vec4 result = v_color;
+    if (v_mode > 5.5) {
+        // modes 6 and 7: a glyph's mask for each colour channel, in the picture texture;
+        // modes 8 and 9: text the raster engine drew as coverage, in its texture.
+        // 7 and 9 weigh all channels by the green one, as the raster engine does for text
+        // that is not opaque.
+        vec3 mask;
+        if (v_mode > 7.5)
+            mask = texture(scratchTexture, (floor(v_source) + 0.5) * scratch.xy).rgb;
+        else
+            mask = texture(imageTexture, (floor(v_source) + 0.5) * glyphsImages.zw).rgb;
+        if ((v_mode > 6.5 && v_mode < 7.5) || v_mode > 8.5)
+            mask = vec3(mask.g);
+        mask *= coverage;
+        float average = (mask.r + mask.g + mask.b) / 3.0;
+        fragColor = vec4(v_color.rgb * mask, v_color.a * average);
+        fragWeights = vec4(v_color.a * mask, v_color.a * average);
+        return;
+    }
+    if (v_mode > 0.5) {
+        // modes 1, 2 and 4 take one texel, unfiltered; 3 and 5 are filtered
+        vec2 texel = v_source;
+        // (where a scaled picture's sample falls between two texels, the raster engine takes the
+        // one before, so the sample is taken a little before its place)
+        if (v_mode < 2.5 || (v_mode > 3.5 && v_mode < 4.5))
+            texel = floor(texel - 0.002) + 0.5;
+        if (v_mode < 1.5)
+            result *= texture(glyphTexture, texel * glyphsImages.xy).r;
+        else if (v_mode < 3.5)
+            result *= texture(imageTexture, texel * glyphsImages.zw);
+        else
+            result *= texture(scratchTexture, texel * scratch.xy);
+    }
+    fragColor = result * coverage;
+    fragWeights = vec4(fragColor.a);
+}
