+// ---------------------------------------------------------------------------------------------
+// the engine
+
+void QBatchedPaintEnginePrivate::systemStateChanged()
+{
+    q_func()->updateClip();
+}
+
+QBatchedPaintEngine::QBatchedPaintEngine(QBatchedPaintBackingStore *store)
+    : QPaintEngineEx(*new QBatchedPaintEnginePrivate), m_store(store)
+{
+    gccaps = AllFeatures;
+}
+
+bool QBatchedPaintEngine::begin(QPaintDevice *)
+{
+    m_rasterStateDirty = true;
+    setActive(true);
+    updateClip();
+    return true;
+}
+
+bool QBatchedPaintEngine::end()
+{
+    setActive(false);
+    return true;
+}
+
+QPainterState *QBatchedPaintEngine::createState(QPainterState *orig) const
+{
+    if (!orig)
+        return new QBatchedPainterState;
+    return new QBatchedPainterState(static_cast<QBatchedPainterState *>(orig));
+}
+
+void QBatchedPaintEngine::setState(QPainterState *s)
+{
+    QPaintEngineEx::setState(s);
+    m_rasterStateDirty = true;
+    updateClip();
+}
+
+void QBatchedPaintEngine::updateClip()
+{
+    Q_D(QBatchedPaintEngine);
+    QRegion clip(m_deviceRect);
+    if (!d->systemClip.isEmpty())
+        clip &= d->systemClip;
+    m_pathClip = false;
+    if (const QBatchedPainterState *s = state(); s && s->clipEnabled && s->userClip) {
+        if (s->userClipIsPath)
+            m_pathClip = true;
+        else
+            clip &= s->userRegion;
+    }
+    m_clip = clip;
+    m_clipBounds = clip.boundingRect();
+    m_clipIsOneRect = clip.rectCount() == 1;
+}
+
+static inline QRect normalizedFillRect(const QRectF &rect)
+{
+    // as QRasterPaintEngine::toNormalizedFillRect()
+    int x1 = qRound(rect.x());
+    int y1 = qRound(rect.y());
+    int x2 = qRound(rect.right());
+    int y2 = qRound(rect.bottom());
+    if (x2 < x1)
+        qSwap(x1, x2);
+    if (y2 < y1)
+        qSwap(y1, y2);
+    return QRect(x1, y1, x2 - x1, y2 - y1);
+}
+
+void QBatchedPaintEngine::clip(const QRect &rect, Qt::ClipOperation op)
+{
+    QBatchedPainterState *s = state();
+    if (op == Qt::NoClip || s->matrix.type() > QTransform::TxScale || (op == Qt::IntersectClip && s->userClip && s->userClipIsPath)) {
+        QPaintEngineEx::clip(rect, op);
+        return;
+    }
+    const QRegion region(normalizedFillRect(s->matrix.mapRect(QRectF(rect))));
+    if (op == Qt::IntersectClip && s->userClip)
+        s->userRegion &= region;
+    else
+        s->userRegion = region;
+    s->userClip = true;
+    s->userClipIsPath = false;
+    updateClip();
+}
+
+void QBatchedPaintEngine::clip(const QRegion &region, Qt::ClipOperation op)
+{
+    QBatchedPainterState *s = state();
+    if (op == Qt::NoClip || s->matrix.type() > QTransform::TxScale || (op == Qt::IntersectClip && s->userClip && s->userClipIsPath)) {
+        QPaintEngineEx::clip(region, op);
+        return;
+    }
+    QRegion mapped;
+    for (const QRect &rect : region)
+        mapped += normalizedFillRect(s->matrix.mapRect(QRectF(rect)));
+    if (op == Qt::IntersectClip && s->userClip)
+        s->userRegion &= mapped;
+    else
+        s->userRegion = mapped;
+    s->userClip = true;
+    s->userClipIsPath = false;
+    updateClip();
+}
+
+void QBatchedPaintEngine::clip(const QVectorPath &path, Qt::ClipOperation op)
+{
+    QBatchedPainterState *s = state();
+    if (op == Qt::NoClip) {
+        s->userClip = false;
+        s->userClipIsPath = false;
+        s->userRegion = QRegion();
+        s->userPath = QPainterPath();
+        updateClip();
+        return;
+    }
+    const bool intersect = op == Qt::IntersectClip && s->userClip;
+    if (path.shape() == QVectorPath::RectangleHint && s->matrix.type() <= QTransform::TxScale
+        && !(intersect && s->userClipIsPath)) {
+        const qreal *p = path.points();
+        const QRegion region(normalizedFillRect(s->matrix.mapRect(QRectF(QPointF(p[0], p[1]), QPointF(p[4], p[5])).normalized())));
+        if (intersect)
+            s->userRegion &= region;
+        else
+            s->userRegion = region;
+        s->userClipIsPath = false;
+    } else {
+        QPainterPath mapped = s->matrix.map(path.convertToPainterPath());
+        if (intersect) {
+            QPainterPath current;
+            if (s->userClipIsPath)
+                current = s->userPath;
+            else
+                current.addRegion(s->userRegion);
+            mapped = current.intersected(mapped);
+        }
+        s->userPath = mapped;
+        s->userClipIsPath = true;
+    }
+    s->userClip = true;
+    updateClip();
+}
+
+QBatchedPaintEngine::Blend QBatchedPaintEngine::blend() const
+{
+    switch (state()->composition_mode) {
+    case QPainter::CompositionMode_SourceOver:
+        return Over;
+    case QPainter::CompositionMode_Source:
+        return Source;
+    default:
+        return Other;
+    }
+}
+
+void QBatchedPaintEngine::push(const Quad &q, Op::Type type)
+{
+    auto &ops = m_store->ops;
+    if (ops.empty() || ops.back().type != type) {
+        Op op;
+        op.type = type;
+        op.first = int(m_store->quads.size());
+        ops.push_back(op);
+    }
+    ++ops.back().count;
+    m_store->quads.push_back(q);
+}
+
+// Records one rectangle, cut to the clip; its source rectangle is cut with it.
+void QBatchedPaintEngine::quad(float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1,
+                               const quint8 *rgba, Mode mode, Op::Type type)
+{
+    if (x1 <= m_clipBounds.left() || y1 <= m_clipBounds.top() || x0 >= m_clipBounds.right() + 1
+        || y0 >= m_clipBounds.bottom() + 1 || x1 <= x0 || y1 <= y0) {
+        return;
+    }
+    Quad q;
+    memcpy(q.rgba, rgba, 4);
+    q.mode = float(mode);
+    const float su = (u1 - u0) / (x1 - x0);
+    const float sv = (v1 - v0) / (y1 - y0);
+    for (const QRect &c : m_clip) {
+        const float cx0 = qMax(x0, float(c.left()));
+        const float cy0 = qMax(y0, float(c.top()));
+        const float cx1 = qMin(x1, float(c.right() + 1));
+        const float cy1 = qMin(y1, float(c.bottom() + 1));
+        if (cx0 >= cx1 || cy0 >= cy1)
+            continue;
+        q.x0 = cx0;
+        q.y0 = cy0;
+        q.x1 = cx1;
+        q.y1 = cy1;
+        q.u0 = u0 + (cx0 - x0) * su;
+        q.v0 = v0 + (cy0 - y0) * sv;
+        q.u1 = u0 + (cx1 - x0) * su;
+        q.v1 = v0 + (cy1 - y0) * sv;
+        push(q, type);
+    }
+}
+
+void QBatchedPaintEngine::sourceRect(const QRect &rect, const QColor &color)
+{
+    quint8 rgba[4];
+    premultiplied(color, 1, rgba);
+    Quad q;
+    q.x0 = rect.left();
+    q.y0 = rect.top();
+    q.x1 = rect.right() + 1;
+    q.y1 = rect.bottom() + 1;
+    q.u0 = q.v0 = q.u1 = q.v1 = 0;
+    memcpy(q.rgba, rgba, 4);
+    q.mode = Solid;
+    push(q, Op::DrawSource);
+}
+
+bool QBatchedPaintEngine::nativeRect(const QRectF &rect, const QColor &color)
+{
+    const QBatchedPainterState *s = state();
+    if (m_pathClip || s->matrix.type() > QTransform::TxScale)
+        return false;
+    const Blend mode = blend();
+    if (mode == Other)
+        return false;
+    quint8 rgba[4];
+    premultiplied(color, s->opacity, rgba);
+    if (mode == Over && rgba[3] == 0)
+        return true;
+    const QRectF mapped = s->matrix.mapRect(rect);
+    float x0, y0, x1, y1;
+    const bool replaces = mode == Source && rgba[3] != 255;
+    if (!(s->renderHints & QPainter::Antialiasing) || replaces) {
+        // without antialiasing the raster engine fills whole pixels
+        const QRect whole = normalizedFillRect(mapped);
+        x0 = whole.left();
+        y0 = whole.top();
+        x1 = whole.left() + whole.width();
+        y1 = whole.top() + whole.height();
+    } else {
+        x0 = mapped.left();
+        y0 = mapped.top();
+        x1 = mapped.right();
+        y1 = mapped.bottom();
+    }
+    if (!replaces) {
+        x0 += m_dx;
+        x1 += m_dx;
+    }
+    ++m_store->counts[NativeRect];
+    quad(x0, y0, x1, y1, 0, 0, 0, 0, rgba, Solid, replaces ? Op::DrawSource : Op::Draw);
+    return true;
+}
+
+// How far beyond its path the pen may draw, in device pixels.
+qreal QBatchedPaintEngine::penReach() const
+{
+    const QBatchedPainterState *s = state();
+    const QPen &pen = s->pen;
+    if (pen.style() == Qt::NoPen)
+        return 1;
+    qreal width = qMax(qreal(1), pen.widthF());
+    if (!pen.isCosmetic()) {
+        const QTransform &m = s->matrix;
+        width *= qMax(qSqrt(m.m11() * m.m11() + m.m12() * m.m12()), qSqrt(m.m21() * m.m21() + m.m22() * m.m22()));
+    }
+    if (pen.joinStyle() == Qt::MiterJoin)
+        width *= qMax(qreal(1), pen.miterLimit());
+    return width + 2;
+}
+
+/*
+    Hands one call to the raster engine: \a draw repeats it on a painter that draws into a
+    transparent part of the scratch image, with the state, the transformation and the clip of
+    this engine, and the part is laid over the target. \a deviceBounds bounds what the call can
+    touch.
+*/
+template <typename Draw>
+void QBatchedPaintEngine::raster(Kind why, const QRectF &deviceBounds, Draw &&draw)
+{
+    QBatchedPainterState *s = state();
+    Kind kind = why;
+    if (m_pathClip)
+        kind = RasterPathClip;
+    if (blend() == Other)
+        kind = RasterComposition;
+    if (m_store->counts[kind]++ == 0) {
+        if (kind == RasterComposition) {
+            qWarning("QT_WIDGETS_GPU_PAINT=batch: composition mode %d is not covered; what is painted in it "
+                     "is laid over the window as SourceOver.", int(s->composition_mode));
+        } else {
+            qCInfo(lcBatchPaint, "drawn by the raster engine into a texture: %s", kindNames[kind]);
+        }
+    }
+
+    const QRect bounds = deviceBounds.toAlignedRect().adjusted(-1, -1, 1, 1) & m_clipBounds;
+    if (bounds.isEmpty() || !m_clip.intersects(bounds))
+        return;
+    QPoint at;
+    QPainter *painter = m_store->scratch(bounds.size(), &at);
+    if (!painter)
+        return;
+    if (m_store->takeFreshScratchPainter())
+        m_rasterStateDirty = true;
+    if (m_rasterStateDirty) {
+        m_rasterStateDirty = false;
+        painter->setPen(s->pen);
+        painter->setBrush(s->brush);
+        painter->setBrushOrigin(s->brushOrigin);
+        painter->setRenderHints(painter->renderHints(), false);
+        painter->setRenderHints(s->renderHints, true);
+        painter->setOpacity(s->opacity);
+        painter->setFont(s->font);
+        painter->setBackground(s->bgBrush);
+        painter->setBackgroundMode(s->bgMode);
+    }
+    const QPoint offset = at - bounds.topLeft();
+    painter->setTransform(QTransform());
+    painter->setClipRegion((m_clip & bounds).translated(offset));
+    if (m_pathClip)
+        painter->setClipPath(s->userPath.translated(offset), Qt::IntersectClip);
+    // an element's part of a pixel goes into what the raster engine draws
+    painter->setTransform(s->matrix * QTransform::fromTranslate(offset.x() + m_dx, offset.y()));
+    draw(painter, offset);
+
+    static const quint8 white[4] = { 255, 255, 255, 255 };
+    Quad q;
+    q.x0 = bounds.left();
+    q.y0 = bounds.top();
+    q.x1 = bounds.right() + 1;
+    q.y1 = bounds.bottom() + 1;
+    q.u0 = at.x();
+    q.v0 = at.y();
+    q.u1 = at.x() + bounds.width();
+    q.v1 = at.y() + bounds.height();
+    memcpy(q.rgba, white, 4);
+    q.mode = ScratchNearest;
+    push(q, Op::Draw);
+}
+
+/*
+    A thin outline around \a rect in device pixels: the raster engine draws the call once for
+    each side, into four narrow parts, instead of into one part as large as the rectangle.
+*/
+void QBatchedPaintEngine::outline(const QRectF &rect, qreal reach, const std::function<void(QPainter *)> &draw)
+{
+    const QRectF outer = rect.adjusted(-reach, -reach, reach, reach);
+    if (rect.width() <= 4 * reach + 8 || rect.height() <= 4 * reach + 8) {
+        raster(RasterRectOutline, outer, [&](QPainter *painter, const QPoint &) { draw(painter); });
+        return;
+    }
+    const QRectF inner = rect.adjusted(reach, reach, -reach, -reach);
+    const QRectF sides[4] = {
+        QRectF(outer.left(), outer.top(), outer.width(), inner.top() - outer.top()),
+        QRectF(outer.left(), inner.bottom(), outer.width(), outer.bottom() - inner.bottom()),
+        QRectF(outer.left(), inner.top(), inner.left() - outer.left(), inner.height()),
+        QRectF(inner.right(), inner.top(), outer.right() - inner.right(), inner.height())
+    };
+    const QRect saved = m_clipBounds;
+    const QRegion savedClip = m_clip;
+    for (const QRectF &side : sides) {
+        // the same call under a narrower clip: nothing else of it is drawn into this part
+        const QRect strip = side.toAlignedRect();
+        m_clip = savedClip & strip;
+        m_clipBounds = m_clip.boundingRect();
+        if (!m_clip.isEmpty())
+            raster(RasterRectOutline, QRectF(strip).adjusted(1, 1, -1, -1), [&](QPainter *painter, const QPoint &) { draw(painter); });
+    }
+    m_clip = savedClip;
+    m_clipBounds = saved;
+}
+
+void QBatchedPaintEngine::fill(const QVectorPath &path, const QBrush &brush)
+{
+    if (path.isEmpty() || brush.style() == Qt::NoBrush)
+        return;
+    const QBatchedPainterState *s = state();
+    if (path.shape() == QVectorPath::RectangleHint && brush.style() == Qt::SolidPattern) {
+        const qreal *p = path.points();
+        if (nativeRect(QRectF(QPointF(p[0], p[1]), QPointF(p[4], p[5])).normalized(), brush.color()))
+            return;
+    }
+    const Kind why = path.shape() == QVectorPath::RectangleHint
+            ? (brush.style() == Qt::SolidPattern ? RasterTransformedRect : RasterPatternRect) : RasterPath;
+    const QPainterPath painterPath = path.convertToPainterPath();
+    raster(why, s->matrix.mapRect(path.controlPointRect()), [&](QPainter *painter, const QPoint &) {
+        painter->fillPath(painterPath, brush);
+    });
+}
+
+void QBatchedPaintEngine::stroke(const QVectorPath &path, const QPen &pen)
+{
+    if (path.isEmpty() || pen.style() == Qt::NoPen)
+        return;
+    const QBatchedPainterState *s = state();
+    const qreal reach = penReach();
+    const QPainterPath painterPath = path.convertToPainterPath();
+    raster(RasterStroke, s->matrix.mapRect(path.controlPointRect()).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) { painter->strokePath(painterPath, pen); });
+}
+
+void QBatchedPaintEngine::fillRect(const QRectF &rect, const QBrush &brush)
+{
+    if (brush.style() == Qt::NoBrush)
+        return;
+    if (brush.style() == Qt::SolidPattern && nativeRect(rect, brush.color()))
+        return;
+    raster(brush.style() == Qt::SolidPattern ? RasterTransformedRect : RasterPatternRect, state()->matrix.mapRect(rect),
+           [&](QPainter *painter, const QPoint &) { painter->fillRect(rect, brush); });
+}
+
+void QBatchedPaintEngine::fillRect(const QRectF &rect, const QColor &color)
+{
+    if (nativeRect(rect, color))
+        return;
+    raster(RasterTransformedRect, state()->matrix.mapRect(rect),
+           [&](QPainter *painter, const QPoint &) { painter->fillRect(rect, color); });
+}
+
+void QBatchedPaintEngine::drawRoundedRect(const QRectF &rect, qreal xrad, qreal yrad, Qt::SizeMode mode)
+{
+    const qreal reach = penReach();
+    raster(RasterRoundedRect, state()->matrix.mapRect(rect).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) { painter->drawRoundedRect(rect, xrad, yrad, mode); });
+}
+
+void QBatchedPaintEngine::drawRects(const QRectF *rects, int rectCount)
+{
+    const QBatchedPainterState *s = state();
+    const bool pen = s->pen.style() != Qt::NoPen;
+    const bool solid = s->brush.style() == Qt::SolidPattern;
+    const bool straight = s->matrix.type() <= QTransform::TxScale && !m_pathClip && blend() != Other;
+    for (int i = 0; i < rectCount; ++i) {
+        const QRectF &rect = rects[i];
+        if (!pen && solid && nativeRect(rect, s->brush.color()))
+            continue;
+        if (!pen && s->brush.style() == Qt::NoBrush)
+            continue;
+        if (pen && straight && (solid || s->brush.style() == Qt::NoBrush)) {
+            // the inside as a rectangle, the pen's line by the raster engine, side by side
+            const qreal reach = penReach();
+            const QRectF mapped = s->matrix.mapRect(rect);
+            if (solid && mapped.width() > 4 * reach + 8 && mapped.height() > 4 * reach + 8) {
+                const QRect whole = normalizedFillRect(mapped).adjusted(int(reach) + 1, int(reach) + 1, -int(reach) - 1, -int(reach) - 1);
+                quint8 rgba[4];
+                premultiplied(s->brush.color(), s->opacity, rgba);
+                if (blend() == Over || rgba[3] == 255) {
+                    ++m_store->counts[NativeRect];
+                    quad(whole.left() + m_dx, whole.top(), whole.left() + whole.width() + m_dx, whole.top() + whole.height(),
+                         0, 0, 0, 0, rgba, Solid);
+                }
+            }
+            outline(mapped, reach, [&](QPainter *painter) { painter->drawRects(&rect, 1); });
+            continue;
+        }
+        const qreal reach = penReach();
+        raster(RasterPatternRect, s->matrix.mapRect(rect).adjusted(-reach, -reach, reach, reach),
+               [&](QPainter *painter, const QPoint &) { painter->drawRects(&rect, 1); });
+    }
+}
+
+void QBatchedPaintEngine::drawRects(const QRect *rects, int rectCount)
+{
+    QVarLengthArray<QRectF, 32> converted(rectCount);
+    for (int i = 0; i < rectCount; ++i)
+        converted[i] = QRectF(rects[i]);
+    // as the raster engine sees whole-number rectangles: the same corners
+    const QBatchedPainterState *s = state();
+    if (s->pen.style() == Qt::NoPen) {
+        drawRects(converted.constData(), rectCount);
+        return;
+    }
+    const bool solid = s->brush.style() == Qt::SolidPattern;
+    const bool straight = s->matrix.type() <= QTransform::TxScale && !m_pathClip && blend() != Other;
+    for (int i = 0; i < rectCount; ++i) {
+        const QRect &rect = rects[i];
+        const qreal reach = penReach();
+        const QRectF mapped = s->matrix.mapRect(QRectF(rect));
+        if (straight && (solid || s->brush.style() == Qt::NoBrush)) {
+            if (solid && mapped.width() > 4 * reach + 8 && mapped.height() > 4 * reach + 8) {
+                const QRect whole = normalizedFillRect(mapped).adjusted(int(reach) + 1, int(reach) + 1, -int(reach) - 1, -int(reach) - 1);
+                quint8 rgba[4];
+                premultiplied(s->brush.color(), s->opacity, rgba);
+                if (blend() == Over || rgba[3] == 255) {
+                    ++m_store->counts[NativeRect];
+                    quad(whole.left() + m_dx, whole.top(), whole.left() + whole.width() + m_dx, whole.top() + whole.height(),
+                         0, 0, 0, 0, rgba, Solid);
+                }
+            }
+            outline(mapped, reach, [&](QPainter *painter) { painter->drawRects(&rect, 1); });
+        } else {
+            raster(RasterPatternRect, mapped.adjusted(-reach, -reach, reach, reach),
+                   [&](QPainter *painter, const QPoint &) { painter->drawRects(&rect, 1); });
+        }
+    }
+}
+
+void QBatchedPaintEngine::drawLines(const QLineF *lines, int lineCount)
+{
+    const QBatchedPainterState *s = state();
+    if (s->pen.style() == Qt::NoPen)
+        return;
+    const qreal reach = penReach();
+    for (int i = 0; i < lineCount; ++i) {
+        const QRectF bounds = s->matrix.mapRect(QRectF(lines[i].p1(), lines[i].p2()).normalized());
+        raster(RasterLines, bounds.adjusted(-reach, -reach, reach, reach),
+               [&](QPainter *painter, const QPoint &) { painter->drawLines(lines + i, 1); });
+    }
+}
+
+void QBatchedPaintEngine::drawLines(const QLine *lines, int lineCount)
+{
+    const QBatchedPainterState *s = state();
+    if (s->pen.style() == Qt::NoPen)
+        return;
+    const qreal reach = penReach();
+    for (int i = 0; i < lineCount; ++i) {
+        const QRectF bounds = s->matrix.mapRect(QRectF(lines[i].p1(), lines[i].p2()).normalized());
+        raster(RasterLines, bounds.adjusted(-reach, -reach, reach, reach),
+               [&](QPainter *painter, const QPoint &) { painter->drawLines(lines + i, 1); });
+    }
+}
+
+void QBatchedPaintEngine::drawEllipse(const QRectF &r)
+{
+    const qreal reach = penReach();
+    raster(RasterEllipse, state()->matrix.mapRect(r).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) { painter->drawEllipse(r); });
+}
+
+void QBatchedPaintEngine::drawEllipse(const QRect &r)
+{
+    const qreal reach = penReach();
+    raster(RasterEllipse, state()->matrix.mapRect(QRectF(r)).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) { painter->drawEllipse(r); });
+}
+
+template <typename Point>
+static QRectF pointBounds(const Point *points, int count)
+{
+    qreal left = points[0].x(), right = left, top = points[0].y(), bottom = top;
+    for (int i = 1; i < count; ++i) {
+        left = qMin(left, qreal(points[i].x()));
+        right = qMax(right, qreal(points[i].x()));
+        top = qMin(top, qreal(points[i].y()));
+        bottom = qMax(bottom, qreal(points[i].y()));
+    }
+    return QRectF(left, top, right - left, bottom - top);
+}
+
+void QBatchedPaintEngine::drawPoints(const QPointF *points, int pointCount)
+{
+    if (pointCount <= 0)
+        return;
+    const qreal reach = penReach();
+    raster(RasterPoints, state()->matrix.mapRect(pointBounds(points, pointCount)).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) { painter->drawPoints(points, pointCount); });
+}
+
+void QBatchedPaintEngine::drawPoints(const QPoint *points, int pointCount)
+{
+    if (pointCount <= 0)
+        return;
+    const qreal reach = penReach();
+    raster(RasterPoints, state()->matrix.mapRect(pointBounds(points, pointCount)).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) { painter->drawPoints(points, pointCount); });
+}
+
+void QBatchedPaintEngine::drawPolygon(const QPointF *points, int pointCount, PolygonDrawMode mode)
+{
+    if (pointCount <= 0)
+        return;
+    const qreal reach = penReach();
+    raster(RasterPolygon, state()->matrix.mapRect(pointBounds(points, pointCount)).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) {
+        if (mode == PolylineMode)
+            painter->drawPolyline(points, pointCount);
+        else if (mode == ConvexMode)
+            painter->drawConvexPolygon(points, pointCount);
+        else
+            painter->drawPolygon(points, pointCount, mode == WindingMode ? Qt::WindingFill : Qt::OddEvenFill);
+    });
+}
+
+void QBatchedPaintEngine::drawPolygon(const QPoint *points, int pointCount, PolygonDrawMode mode)
+{
+    if (pointCount <= 0)
+        return;
+    const qreal reach = penReach();
+    raster(RasterPolygon, state()->matrix.mapRect(pointBounds(points, pointCount)).adjusted(-reach, -reach, reach, reach),
+           [&](QPainter *painter, const QPoint &) {
+        if (mode == PolylineMode)
+            painter->drawPolyline(points, pointCount);
+        else if (mode == ConvexMode)
+            painter->drawConvexPolygon(points, pointCount);
+        else
+            painter->drawPolygon(points, pointCount, mode == WindingMode ? Qt::WindingFill : Qt::OddEvenFill);
+    });
+}
+
+// -- pictures
+
+void QBatchedPaintEngine::drawPixmap(const QRectF &r, const QPixmap &pm, const QRectF &sr)
+{
+    if (pm.isNull())
+        return;
+    if (pm.isQBitmap()) {
+        raster(RasterBitmap, state()->matrix.mapRect(r),
+               [&](QPainter *painter, const QPoint &) { painter->drawPixmap(r, pm, sr); });
+        return;
+    }
+    drawPicture(r, pm.toImage(), sr, Qt::AutoColor);
+}
+
+void QBatchedPaintEngine::drawImage(const QRectF &r, const QImage &image, const QRectF &sr, Qt::ImageConversionFlags flags)
+{
+    if (image.isNull())
+        return;
+    drawPicture(r, image, sr, flags);
+}
+
+void QBatchedPaintEngine::drawTiledPixmap(const QRectF &r, const QPixmap &pixmap, const QPointF &s)
+{
+    raster(RasterTiledPixmap, state()->matrix.mapRect(r),
+           [&](QPainter *painter, const QPoint &) { painter->drawTiledPixmap(r, pixmap, s); });
+}
+
+void QBatchedPaintEngine::drawPicture(const QRectF &r, const QImage &image, const QRectF &sr, Qt::ImageConversionFlags flags)
+{
+    const QBatchedPainterState *s = state();
+    const QTransform &m = s->matrix;
+    const Blend mode = blend();
+    const QRectF mapped = m.mapRect(r);
+    if (m_pathClip || mode == Other || m.type() > QTransform::TxScale || m.m11() < 0 || m.m22() < 0 || image.depth() == 1
+        || r.width() <= 0 || r.height() <= 0 || sr.width() <= 0 || sr.height() <= 0) {
+        raster(image.depth() == 1 ? RasterBitmap : RasterImageTransformed, mapped,
+               [&](QPainter *painter, const QPoint &) { painter->drawImage(r, image, sr, flags); });
+        return;
+    }
+    if (!mapped.intersects(QRectF(m_clipBounds)))
+        return;
+
+    float x0 = mapped.left(), y0 = mapped.top(), x1 = mapped.right(), y1 = mapped.bottom();
+    const bool sameSize = qAbs(mapped.width() - sr.width()) < 0.01 && qAbs(mapped.height() - sr.height()) < 0.01;
+    bool filtered = !sameSize && (s->renderHints & QPainter::SmoothPixmapTransform);
+    const bool replaces = mode == Source && image.hasAlphaChannel();
+    if (sameSize || replaces) {
+        // a picture at its own size lies on whole pixels, as the raster engine blits it
+        const float w = x1 - x0, h = y1 - y0;
+        x0 = qRound(x0);
+        y0 = qRound(y0);
+        x1 = sameSize ? x0 + float(sr.width()) : float(qRound(x0 + w));
+        y1 = sameSize ? y0 + float(sr.height()) : float(qRound(y0 + h));
+    }
+    if (m_dx != 0 && !replaces) {
+        x0 += m_dx;
+        x1 += m_dx;
+        filtered = true;
+    }
+    quint8 rgba[4];
+    const int opacity = qBound(0, qRound(s->opacity * 255), 255);
+    rgba[0] = rgba[1] = rgba[2] = rgba[3] = quint8(opacity);
+    const Op::Type type = replaces ? Op::DrawSource : Op::Draw;
+
+    ImageAtlas *atlas = imageAtlas();
+    if (image.width() <= 256 && image.height() <= 256 && !atlas->full) {
+        atlas->ensure();
+        const qint64 key = image.cacheKey();
+        auto it = atlas->images.constFind(key);
+        if (it == atlas->images.constEnd()) {
+            QPoint at;
+            if (atlas->shelves.place(image.width() + 2, image.height() + 2, &at)) {
+                const QImage converted = image.format() == QImage::Format_RGBA8888_Premultiplied
+                        ? image : image.convertToFormat(QImage::Format_RGBA8888_Premultiplied, flags);
+                copyPadded(converted, converted.rect(), &atlas->image, at);
+                ImageEntry entry;
+                entry.x = quint16(at.x() + 1);
+                entry.y = quint16(at.y() + 1);
+                it = atlas->images.insert(key, entry);
+                ++atlas->version;
+            } else {
+                // emptied before the next paint pass; this pass copies its pictures
+                atlas->full = true;
+            }
+        }
+        if (it != atlas->images.constEnd()) {
+            ++m_store->counts[NativeImage];
+            quad(x0, y0, x1, y1, it->x + float(sr.left()), it->y + float(sr.top()), it->x + float(sr.right()),
+                 it->y + float(sr.bottom()), rgba, filtered ? ImageLinear : ImageNearest, type);
+            return;
+        }
+    }
+
+    // A large picture: the part of it that can show is copied for this frame.
+    const QRectF shown = QRectF(m_clipBounds).intersected(QRectF(x0, y0, x1 - x0, y1 - y0));
+    if (shown.isEmpty())
+        return;
+    const qreal sx = sr.width() / (x1 - x0), sy = sr.height() / (y1 - y0);
+    QRect part = QRectF(sr.left() + (shown.left() - x0) * sx, sr.top() + (shown.top() - y0) * sy,
+                        shown.width() * sx, shown.height() * sy).toAlignedRect().adjusted(-1, -1, 1, 1);
+    part &= image.rect();
+    if (part.isEmpty())
+        return;
+    QPoint at;
+    QImage *scratch = m_store->scratchImage(part.size() + QSize(2, 2), &at);
+    if (!scratch)
+        return;
+    const QImage piece = image.format() == m_store->scratchFormat()
+            ? image : image.copy(part).convertToFormat(m_store->scratchFormat(), flags);
+    copyPadded(piece, piece.size() == image.size() ? part : piece.rect(), scratch, at);
+    ++m_store->counts[NativeCopiedImage];
+    // the picture's source rectangle, in the scratch image's texels
+    const float ox = float(at.x() + 1 - part.left()), oy = float(at.y() + 1 - part.top());
+    quad(x0, y0, x1, y1, ox + float(sr.left()), oy + float(sr.top()), ox + float(sr.right()), oy + float(sr.bottom()),
+         rgba, filtered ? ScratchLinear : ScratchNearest, type);
+}
+
+// -- text
+
+bool QBatchedPaintEngine::shouldDrawCachedGlyphs(QFontEngine *fontEngine, const QTransform &m) const
+{
+    // as the raster engine decides
+    if (m.type() >= QTransform::TxProject)
+        return false;
+    if (!fontEngine->hasInternalCaching() && !fontEngine->supportsTransformation(m))
+        return false;
+    if (fontEngine->supportsTransformation(m) && !fontEngine->isSmoothlyScalable)
+        return true;
+    return QPaintEngineEx::shouldDrawCachedGlyphs(fontEngine, m);
+}
+
+bool QBatchedPaintEngine::requiresPretransformedGlyphPositions(QFontEngine *fontEngine, const QTransform &m) const
+{
+    if (shouldDrawCachedGlyphs(fontEngine, m))
+        return true;
+    return QPaintEngineEx::requiresPretransformedGlyphPositions(fontEngine, m);
+}
+
+bool QBatchedPaintEngine::glyphsDrawable(QFontEngine *fontEngine, const QTransform &m, Kind *why) const
+{
+    const QBatchedPainterState *s = state();
+    if (m_pathClip) {
+        *why = RasterPathClip;
+        return false;
+    }
+    if (blend() != Over) {
+        *why = RasterComposition;
+        return false;
+    }
+    if (m.type() > QTransform::TxScale) {
+        *why = RasterTextTransformed;
+        return false;
+    }
+    if (s->pen.brush().style() != Qt::SolidPattern) {
+        *why = RasterTextPen;
+        return false;
+    }
+    if (!fontEngine->hasInternalCaching()) {
+        *why = RasterTextEngine;
+        return false;
+    }
+    if (fontEngine->glyphFormat == QFontEngine::Format_ARGB) {
+        *why = RasterTextColour;
+        return false;
+    }
+    if (!shouldDrawCachedGlyphs(fontEngine, m)) {
+        *why = RasterTextLarge;
+        return false;
+    }
+    return true;
+}
+
+static const int glyphAtlasKey = 0;
+
+/*
+    Records the glyphs at \a positions (device pixels) as the raster engine would blend them:
+    each glyph's mask for the part of a pixel its position has, on whole pixels. Returns false,
+    with nothing recorded, when the font's masks are of a kind this engine does not draw.
+*/
+bool QBatchedPaintEngine::drawGlyphs(QFontEngine *fontEngine, const glyph_t *glyphs, const QFixedPoint *positions,
+                                     int count, Kind *why)
+{
+    const QBatchedPainterState *s = state();
+    GlyphAtlas *atlas = glyphAtlas();
+    if (atlas->full) {
+        *why = RasterTextAtlasFull;
+        return false;
+    }
+    FontTag *tag = static_cast<FontTag *>(fontEngine->glyphCache(&glyphAtlasKey, QFontEngine::Format_A8, QTransform()));
+    if (!tag) {
+        tag = new FontTag;
+        fontEngine->setGlyphCache(&glyphAtlasKey, tag);
+    }
+    if (tag->format == QFontEngine::Format_A32) {
+        *why = RasterTextSubpixel;
+        return false;
+    }
+    if (tag->format == QFontEngine::Format_ARGB) {
+        *why = RasterTextColour;
+        return false;
+    }
+
+    const bool verticalSubPixel = fontEngine->supportsVerticalSubPixelPositions()
+            && (s->renderHints & QPainter::VerticalSubpixelPositioning);
+    // an element's part of a pixel: the glyph's own mask for that part, so the text stays sharp
+    const QFixed shift = QFixed::fromReal(m_dx);
+    GlyphKey key;
+    key.font = tag->id;
+    key.transform = tag->transformId(s->matrix);
+    quint8 rgba[4];
+    premultiplied(s->pen.color(), s->opacity, rgba);
+    if (rgba[3] == 0)
+        return true;
+
+    const size_t firstQuad = m_store->quads.size();
+    const size_t firstOp = m_store->ops.size();
+    const int firstOpCount = firstOp ? m_store->ops.back().count : 0;
+    int drawn = 0;
+    for (int i = 0; i < count; ++i) {
+        QFixedPoint position = positions[i];
+        position.x += shift;
+        QFixedPoint sub = fontEngine->subPixelPositionFor(position);
+        if (!verticalSubPixel)
+            sub.y = 0;
+        key.glyph = glyphs[i];
+        key.subX = quint8(sub.x.value());
+        key.subY = quint8(sub.y.value());
+        auto it = atlas->glyphs.constFind(key);
+        if (it == atlas->glyphs.constEnd()) {
+            const QFontEngine::Glyph *mask = fontEngine->glyphData(glyphs[i], sub, QFontEngine::Format_None, s->matrix);
+            GlyphEntry entry;
+            if (mask && mask->width && mask->height) {
+                if (tag->format < 0)
+                    tag->format = mask->format;
+                if (mask->format != QFontEngine::Format_A8 && mask->format != QFontEngine::Format_Mono) {
+                    // nothing of this run is kept: the raster engine draws all of it
+                    m_store->quads.resize(firstQuad);
+                    m_store->ops.resize(firstOp);
+                    if (firstOp)
+                        m_store->ops.back().count = firstOpCount;
+                    *why = mask->format == QFontEngine::Format_A32 ? RasterTextSubpixel : RasterTextColour;
+                    return false;
+                }
+                QPoint at;
+                if (!atlas->place(mask->width, mask->height, &at)) {
+                    m_store->quads.resize(firstQuad);
+                    m_store->ops.resize(firstOp);
+                    if (firstOp)
+                        m_store->ops.back().count = firstOpCount;
+                    *why = RasterTextAtlasFull;
+                    return false;
+                }
+                if (mask->format == QFontEngine::Format_A8) {
+                    const int stride = (mask->width + 3) & ~3;
+                    for (int y = 0; y < mask->height; ++y)
+                        memcpy(atlas->image.scanLine(at.y() + y) + at.x(), mask->data + y * stride, mask->width);
+                } else {
+                    const int stride = ((mask->width + 31) & ~31) >> 3;
+                    for (int y = 0; y < mask->height; ++y) {
+                        const uchar *from = mask->data + y * stride;
+                        uchar *to = atlas->image.scanLine(at.y() + y) + at.x();
+                        for (int x = 0; x < mask->width; ++x)
+                            to[x] = (from[x >> 3] & (0x80 >> (x & 7))) ? 255 : 0;
+                    }
+                }
+                entry.x = quint16(at.x());
+                entry.y = quint16(at.y());
+                entry.w = mask->width;
+                entry.h = mask->height;
+                entry.left = mask->x;
+                entry.top = mask->y;
+                ++atlas->version;
+            }
+            it = atlas->glyphs.insert(key, entry);
+        }
+        if (!it->w)
+            continue;
+        const int x = qFloor(position.x) + it->left;
+        const int y = (verticalSubPixel ? qFloor(position.y) : qRound(position.y)) - it->top;
+        quad(x, y, x + it->w, y + it->h, it->x, it->y, it->x + it->w, it->y + it->h, rgba, Glyph);
+        ++drawn;
+    }
+    m_store->counts[NativeGlyph] += drawn;
+    return true;
+}
+
+void QBatchedPaintEngine::drawTextItem(const QPointF &p, const QTextItem &textItem)
+{
+    const QTextItemInt &ti = static_cast<const QTextItemInt &>(textItem);
+    if (ti.glyphs.numGlyphs == 0)
+        return;
+    const QBatchedPainterState *s = state();
+    Kind why = RasterTextTransformed;
+    if (glyphsDrawable(ti.fontEngine, s->matrix, &why)) {
+        QVarLengthArray<QFixedPoint> positions;
+        QVarLengthArray<glyph_t> glyphs;
+        QTransform matrix = s->matrix;
+        matrix.translate(p.x(), p.y());
+        ti.fontEngine->getGlyphPositions(ti.glyphs, matrix, ti.flags, glyphs, positions);
+        if (drawGlyphs(ti.fontEngine, glyphs.constData(), positions.constData(), int(glyphs.size()), &why))
+            return;
+    }
+    const qreal size = ti.fontEngine->fontDef.pixelSize;
+    const QRectF bounds(p.x() - size, p.y() - ti.ascent.toReal() - size, ti.width.toReal() + 2 * size,
+                        (ti.ascent + ti.descent).toReal() + 2 * size);
+    raster(why, s->matrix.mapRect(bounds), [&](QPainter *painter, const QPoint &) {
+        static_cast<QPaintEngineEx *>(painter->paintEngine())->drawTextItem(p, textItem);
+    });
+}
+
+void QBatchedPaintEngine::drawStaticTextItem(QStaticTextItem *item)
+{
+    if (item->numGlyphs == 0)
+        return;
+    const QBatchedPainterState *s = state();
+    QFontEngine *fontEngine = item->fontEngine();
+    Kind why = RasterTextTransformed;
+    if (glyphsDrawable(fontEngine, s->matrix, &why)
+        && drawGlyphs(fontEngine, item->glyphs, item->glyphPositions, item->numGlyphs, &why)) {
+        return;
+    }
+    // The positions are in device pixels where the glyphs come from a cache, else in the
+    // painter's own; the bounds cover both readings.
+    const bool device = requiresPretransformedGlyphPositions(fontEngine, s->matrix);
+    QRectF bounds;
+    for (int i = 0; i < item->numGlyphs; ++i) {
+        const QPointF position = item->glyphPositions[i].toPointF();
+        bounds |= QRectF(position, QSizeF(1, 1));
+    }
+    if (!device)
+        bounds = s->matrix.mapRect(bounds);
+    const qreal size = fontEngine->fontDef.pixelSize * qMax(qreal(1), qMax(qAbs(s->matrix.m11()), qAbs(s->matrix.m22()))) * 2;
+    bounds.adjust(-size, -size, size, size);
+    raster(why, bounds, [&](QPainter *painter, const QPoint &offset) {
+        QFixedPoint *saved = item->glyphPositions;
+        QVarLengthArray<QFixedPoint> moved;
+        if (device) {
+            // device positions do not follow the painter into its part of the scratch image
+            moved.resize(item->numGlyphs);
+            for (int i = 0; i < item->numGlyphs; ++i) {
+                moved[i].x = saved[i].x + QFixed::fromReal(offset.x() + m_dx);
+                moved[i].y = saved[i].y + QFixed(offset.y());
+            }
+            item->glyphPositions = moved.data();
+        }
+        static_cast<QPaintEngineEx *>(painter->paintEngine())->drawStaticTextItem(item);
+        item->glyphPositions = saved;
+    });
+}
+
+// ---------------------------------------------------------------------------------------------
+// the store
+
+QBatchedPaintBackingStore::QBatchedPaintBackingStore(QWindow *window)
+    : QPlatformBackingStore(window), m_device(this)
+{
+    m_stats = qEnvironmentVariableIntValue("QT_WIDGETS_PAINT_STATS");
+    m_translucent = window->requestedFormat().hasAlpha();
+    setGpuTextureProvider([this](QRhi *rhi, QRhiCommandBuffer *cb, TextureFlags *flags) { return realise(rhi, cb, flags); });
+    setPaintSubPixelOffsetSetter([this](qreal dx) { m_device.engine()->setSubPixelOffset(dx); });
+    quads.reserve(16384);
+}
+
+QBatchedPaintBackingStore::~QBatchedPaintBackingStore()
+{
+    endScratchPainter();
+    releaseResources();
+}
+
+void QBatchedPaintBackingStore::releaseResources()
+{
+    m_over.reset();
+    m_source.reset();
+    m_bindings.reset();
+    m_uniforms.reset();
+    m_instances.reset();
+    m_corners.reset();
+    m_sampler.reset();
+    m_scratchTexture.reset();
+    m_imageTexture.reset();
+    m_glyphTexture.reset();
+    m_keep.reset();
+    m_clear.reset();
+    m_pass.reset();
+    m_scrollTexture.reset();
+    m_target.reset();
+    m_cornersUploaded = false;
+    m_glyphEpoch = m_imageEpoch = ~quint64(0);
+}
+
+void QBatchedPaintBackingStore::syncDevice()
+{
+    const qreal dpr = window()->devicePixelRatio();
+    const QSize pixelSize(qCeil(m_size.width() * dpr), qCeil(m_size.height() * dpr));
+    if (pixelSize != m_pixelSize || dpr != m_dpr) {
+        m_pixelSize = pixelSize;
+        m_dpr = dpr;
+        qreal dpi = 96;
+        if (const QScreen *screen = window()->screen())
+            dpi = screen->logicalDotsPerInchY();
+        m_device.set(pixelSize, dpr, dpi * dpr);
+    }
+}
+
+QPaintDevice *QBatchedPaintBackingStore::paintDevice()
+{
+    syncDevice();
+    return &m_device;
+}
+
+void QBatchedPaintBackingStore::beginPaint(const QRegion &region)
+{
+    syncDevice();
+    // between paint passes nothing recorded points into the shared images
+    if (quads.empty()) {
+        if (glyphAtlas()->full)
+            glyphAtlas()->clear();
+        if (imageAtlas()->full)
+            imageAtlas()->clear();
+    }
+    if (m_translucent) {
+        // a translucent window starts from nothing where it paints, as a raster store does
+        for (const QRect &rect : region) {
+            const QRect device = QRectF(rect.x() * m_dpr, rect.y() * m_dpr, rect.width() * m_dpr, rect.height() * m_dpr)
+                                         .toAlignedRect() & QRect(QPoint(), m_pixelSize);
+            if (!device.isEmpty())
+                m_device.engine()->sourceRect(device, Qt::transparent);
+        }
+    }
+}
+
+void QBatchedPaintBackingStore::endPaint()
+{
+    endScratchPainter();
+}
+
+void QBatchedPaintBackingStore::endScratchPainter()
+{
+    if (m_scratchPainter) {
+        m_scratchPainter->end();
+        m_scratchPainter.reset();
+    }
+}
+
+bool QBatchedPaintBackingStore::growScratch(int height)
+{
+    const int width = qMax(1024, (m_pixelSize.width() + 4 + 63) & ~63);
+    if (!m_scratch.isNull() && m_scratch.width() == width && m_scratch.height() >= height)
+        return true;
+    endScratchPainter();
+    int newHeight = qMax(256, m_scratch.isNull() || m_scratch.width() != width ? 0 : m_scratch.height());
+    while (newHeight < height)
+        newHeight *= 2;
+    if (newHeight > 16384)
+        return false;
+    QImage larger(width, newHeight, m_scratchFormat);
+    larger.fill(0);
+    if (!m_scratch.isNull() && m_scratch.width() == width) {
+        const int used = m_scratchShelves.used();
+        for (int y = 0; y < used; ++y)
+            memcpy(larger.scanLine(y), m_scratch.constScanLine(y), size_t(width) * 4);
+    } else {
+        // another width: nothing recorded may point into the old image
+        if (!quads.empty() && m_scratchShelves.used() > 0)
+            return false;
+        m_scratchShelves.reset(width, newHeight);
+    }
+    m_scratch = larger;
+    m_scratchShelves.width = width;
+    m_scratchShelves.height = newHeight;
+    return true;
+}
+
+QImage *QBatchedPaintBackingStore::scratchImage(const QSize &size, QPoint *at)
+{
+    if (m_scratch.isNull() && !growScratch(256))
+        return nullptr;
+    while (!m_scratchShelves.place(size.width() + 1, size.height() + 1, at)) {
+        if (size.width() + 1 > m_scratchShelves.width)
+            return nullptr;
+        if (!growScratch(m_scratchShelves.height * 2)) {
+            static bool said = false;
+            if (!said) {
+                said = true;
+                qWarning("QT_WIDGETS_GPU_PAINT=batch: the scratch image for raster-drawn parts is full; "
+                         "parts of this frame are missing.");
+            }
+            return nullptr;
+        }
+    }
+    return &m_scratch;
+}
+
+QPainter *QBatchedPaintBackingStore::scratch(const QSize &size, QPoint *at)
+{
+    if (!scratchImage(size, at))
+        return nullptr;
+    if (!m_scratchPainter) {
+        m_scratchPainter = std::make_unique<QPainter>(&m_scratch);
+        m_scratchPainterFresh = true;
+    }
+    return m_scratchPainter.get();
+}
+
+bool QBatchedPaintBackingStore::scroll(const QRegion &area, int dx, int dy)
+{
+    if (!m_hasContents || !m_target)
+        return false;
+    if (!qFuzzyCompare(dx * m_dpr, qRound(dx * m_dpr)) || !qFuzzyCompare(dy * m_dpr, qRound(dy * m_dpr)))
+        return false;
+    const QPoint delta(qRound(dx * m_dpr), qRound(dy * m_dpr));
+    const QRect bounds(QPoint(), m_pixelSize);
+    for (const QRect &rect : area) {
+        const QRect source = QRectF(rect.x() * m_dpr, rect.y() * m_dpr, rect.width() * m_dpr, rect.height() * m_dpr)
+                                     .toAlignedRect() & bounds;
+        const QRect target = source.translated(delta) & bounds;
+        const QRect from = target.translated(-delta);
+        if (from.isEmpty())
+            continue;
+        Op op;
+        op.type = Op::Scroll;
+        op.rect = from;
+        op.delta = delta;
+        ops.push_back(op);
+    }
+    return true;
+}
+
+// A rectangle of the window in the target texture's own rows.
+QRect QBatchedPaintBackingStore::textureRect(const QRect &deviceRect) const
+{
+    if (m_rhi && m_rhi->isYUpInFramebuffer())
+        return QRect(deviceRect.x(), m_pixelSize.height() - deviceRect.y() - deviceRect.height(), deviceRect.width(), deviceRect.height());
+    return deviceRect;
+}
+
+static QShader batchShader(const QString &name)
+{
+    QFile f(name);
+    return f.open(QIODevice::ReadOnly) ? QShader::fromSerialized(f.readAll()) : QShader();
+}
+
+bool QBatchedPaintBackingStore::ensureResources(QRhi *rhi)
+{
+    if (m_rhi != rhi) {
+        // the textures of another RHI are gone with it; the window is painted again
+        if (m_rhi && m_hasContents)
+            setPaintContentsLost();
+        releaseResources();
+        m_rhi = rhi;
+        m_hasContents = false;
+        m_scratchFormat = rhi->isTextureFormatSupported(QRhiTexture::BGRA8) ? QImage::Format_ARGB32_Premultiplied
+                                                                             : QImage::Format_RGBA8888_Premultiplied;
+        if (!m_scratch.isNull() && m_scratch.format() != m_scratchFormat)
+            m_scratch.convertTo(m_scratchFormat);
+    }
+    if (m_pixelSize.isEmpty())
+        return false;
+
+    if (!m_target || m_target->pixelSize() != m_pixelSize) {
+        m_keep.reset();
+        m_clear.reset();
+        m_scrollTexture.reset();
+        m_target.reset(rhi->newTexture(QRhiTexture::RGBA8, m_pixelSize, 1,
+                                       QRhiTexture::RenderTarget | QRhiTexture::UsedAsTransferSource));
+        if (!m_target->create())
+            return false;
+        const QRhiTextureRenderTargetDescription description { QRhiColorAttachment(m_target.get()) };
+        m_keep.reset(rhi->newTextureRenderTarget(description, QRhiTextureRenderTarget::PreserveColorContents));
+        m_clear.reset(rhi->newTextureRenderTarget(description));
+        if (!m_pass) {
+            m_pass.reset(m_keep->newCompatibleRenderPassDescriptor());
+            m_over.reset();
+            m_source.reset();
+        }
+        m_keep->setRenderPassDescriptor(m_pass.get());
+        m_clear->setRenderPassDescriptor(m_pass.get());
+        if (!m_keep->create() || !m_clear->create())
+            return false;
+        if (m_hasContents)
+            setPaintContentsLost();
+        m_hasContents = false;
+    }
+
+    if (!m_sampler) {
+        m_sampler.reset(rhi->newSampler(QRhiSampler::Linear, QRhiSampler::Linear, QRhiSampler::None,
+                                        QRhiSampler::ClampToEdge, QRhiSampler::ClampToEdge));
+        m_sampler->create();
+    }
+    if (!m_corners) {
+        m_corners.reset(rhi->newBuffer(QRhiBuffer::Immutable, QRhiBuffer::VertexBuffer, 8 * sizeof(float)));
+        m_corners->create();
+        m_cornersUploaded = false;
+    }
+    if (!m_uniforms) {
+        m_uniforms.reset(rhi->newBuffer(QRhiBuffer::Dynamic, QRhiBuffer::UniformBuffer, 64 + 3 * 16));
+        m_uniforms->create();
+    }
+    const quint32 instanceBytes = quint32(qMax<size_t>(quads.size(), 4096) * sizeof(Quad));
+    if (!m_instances || m_instances->size() < instanceBytes) {
+        m_instances.reset(rhi->newBuffer(QRhiBuffer::Dynamic, QRhiBuffer::VertexBuffer, instanceBytes + instanceBytes / 2));
+        if (!m_instances->create())
+            return false;
+    }
+
+    GlyphAtlas *glyphs = glyphAtlas();
+    glyphs->ensure();
+    glyphs->maxHeight = qMin(8192, rhi->resourceLimit(QRhi::TextureSizeMax));
+    bool rebind = false;
+    if (!m_glyphTexture || m_glyphTexture->pixelSize() != glyphs->image.size()) {
+        m_glyphTexture.reset(rhi->newTexture(QRhiTexture::R8, glyphs->image.size()));
+        if (!m_glyphTexture->create())
+            return false;
+        m_glyphEpoch = ~quint64(0);
+        rebind = true;
+    }
+    ImageAtlas *images = imageAtlas();
+    images->ensure();
+    if (!m_imageTexture) {
+        m_imageTexture.reset(rhi->newTexture(QRhiTexture::RGBA8, images->image.size()));
+        if (!m_imageTexture->create())
+            return false;
+        m_imageEpoch = ~quint64(0);
+        rebind = true;
+    }
+    const QSize scratchSize = m_scratch.isNull() ? QSize(64, 64) : m_scratch.size();
+    if (!m_scratchTexture || m_scratchTexture->pixelSize() != scratchSize) {
+        m_scratchTexture.reset(rhi->newTexture(m_scratchFormat == QImage::Format_ARGB32_Premultiplied ? QRhiTexture::BGRA8
+                                                                                                        : QRhiTexture::RGBA8,
+                                               scratchSize));
+        if (!m_scratchTexture->create())
+            return false;
+        rebind = true;
+    }
+
+    if (!m_bindings || rebind) {
+        m_bindings.reset(rhi->newShaderResourceBindings());
+        m_bindings->setBindings({
+            QRhiShaderResourceBinding::uniformBuffer(0, QRhiShaderResourceBinding::VertexStage | QRhiShaderResourceBinding::FragmentStage, m_uniforms.get()),
+            QRhiShaderResourceBinding::sampledTexture(1, QRhiShaderResourceBinding::FragmentStage, m_glyphTexture.get(), m_sampler.get()),
+            QRhiShaderResourceBinding::sampledTexture(2, QRhiShaderResourceBinding::FragmentStage, m_imageTexture.get(), m_sampler.get()),
+            QRhiShaderResourceBinding::sampledTexture(3, QRhiShaderResourceBinding::FragmentStage, m_scratchTexture.get(), m_sampler.get())
+        });
+        if (!m_bindings->create())
+            return false;
+    }
+
+    if (!m_over) {
+        const QShader vertex = batchShader(u":/qt-project.org/gui/painting/shaders/batchpaint.vert.qsb"_s);
+        const QShader fragment = batchShader(u":/qt-project.org/gui/painting/shaders/batchpaint.frag.qsb"_s);
+        QRhiVertexInputLayout layout;
+        layout.setBindings({ { 2 * sizeof(float) }, { sizeof(Quad), QRhiVertexInputBinding::PerInstance } });
+        layout.setAttributes({ { 0, 0, QRhiVertexInputAttribute::Float2, 0 },
+                               { 1, 1, QRhiVertexInputAttribute::Float4, 0 },
+                               { 1, 2, QRhiVertexInputAttribute::Float4, 16 },
+                               { 1, 3, QRhiVertexInputAttribute::UNormByte4, 32 },
+                               { 1, 4, QRhiVertexInputAttribute::Float, 36 } });
+        for (const bool blended : { true, false }) {
+            std::unique_ptr<QRhiGraphicsPipeline> pipeline(rhi->newGraphicsPipeline());
+            pipeline->setTopology(QRhiGraphicsPipeline::TriangleStrip);
+            pipeline->setShaderStages({ { QRhiShaderStage::Vertex, vertex }, { QRhiShaderStage::Fragment, fragment } });
+            pipeline->setVertexInputLayout(layout);
+            pipeline->setShaderResourceBindings(m_bindings.get());
+            pipeline->setRenderPassDescriptor(m_pass.get());
+            QRhiGraphicsPipeline::TargetBlend target;
+            if (blended) {
+                // premultiplied colour over what is there
+                target.enable = true;
+                target.srcColor = QRhiGraphicsPipeline::One;
+                target.dstColor = QRhiGraphicsPipeline::OneMinusSrcAlpha;
+                target.srcAlpha = QRhiGraphicsPipeline::One;
+                target.dstAlpha = QRhiGraphicsPipeline::OneMinusSrcAlpha;
+            }
+            pipeline->setTargetBlends({ target });
+            if (!pipeline->create())
+                return false;
+            (blended ? m_over : m_source) = std::move(pipeline);
+        }
+    }
+    return true;
+}
+
+/*
+    Draws what was recorded since the last flush into the window's texture, inside the frame
+    \a cb belongs to, and returns the texture.
+*/
+QRhiTexture *QBatchedPaintBackingStore::realise(QRhi *rhi, QRhiCommandBuffer *cb, TextureFlags *flags)
+{
+    QElapsedTimer clock;
+    if (m_stats)
+        clock.start();
+    endScratchPainter();
+    if (!ensureResources(rhi)) {
+        static bool said = false;
+        if (!said) {
+            said = true;
+            qWarning("QT_WIDGETS_GPU_PAINT=batch: the textures and buffers for painting could not be made; "
+                     "the window is not drawn.");
+        }
+        return nullptr;
+    }
+    run(rhi, cb);
+    *flags |= TexturePremultiplied;
+    if (rhi->isYUpInFramebuffer())
+        *flags |= TextureFlip;
+    if (m_stats) {
+        m_statRunNs += clock.nsecsElapsed();
+        report();
+    }
+    return m_target.get();
+}
+
+void QBatchedPaintBackingStore::run(QRhi *rhi, QRhiCommandBuffer *cb)
+{
+    QRhiResourceUpdateBatch *updates = rhi->nextResourceUpdateBatch();
+
+    if (!m_cornersUploaded) {
+        static const float corners[8] = { 0, 0, 1, 0, 0, 1, 1, 1 };
+        updates->uploadStaticBuffer(m_corners.get(), corners);
+        m_cornersUploaded = true;
+    }
+
+    // the glyph masks and the small pictures added since this store last looked
+    GlyphAtlas *glyphs = glyphAtlas();
+    if (m_glyphEpoch != glyphs->epoch || m_glyphVersion != glyphs->version) {
+        const int from = m_glyphEpoch != glyphs->epoch ? 0 : m_glyphRow;
+        const int to = m_glyphEpoch != glyphs->epoch ? glyphs->image.height() : glyphs->shelves.used();
+        if (to > from) {
+            QRhiTextureSubresourceUploadDescription part(glyphs->image.constScanLine(from),
+                                                         quint32(glyphs->image.bytesPerLine() * (to - from)));
+            part.setDataStride(quint32(glyphs->image.bytesPerLine()));
+            part.setSourceSize(QSize(glyphs->image.width(), to - from));
+            part.setDestinationTopLeft(QPoint(0, from));
+            updates->uploadTexture(m_glyphTexture.get(), QRhiTextureUploadDescription({ 0, 0, part }));
+            m_statUploaded += qint64(glyphs->image.width()) * (to - from);
+        }
+        m_glyphEpoch = glyphs->epoch;
+        m_glyphVersion = glyphs->version;
+        m_glyphRow = glyphs->shelves.y;
+    }
+    ImageAtlas *images = imageAtlas();
+    if (m_imageEpoch != images->epoch || m_imageVersion != images->version) {
+        const int from = m_imageEpoch != images->epoch ? 0 : m_imageRow;
+        const int to = images->shelves.used();
+        if (to > from) {
+            QRhiTextureSubresourceUploadDescription part(images->image.constScanLine(from),
+                                                         quint32(images->image.bytesPerLine() * (to - from)));
+            part.setDataStride(quint32(images->image.bytesPerLine()));
+            part.setSourceSize(QSize(images->image.width(), to - from));
+            part.setDestinationTopLeft(QPoint(0, from));
+            updates->uploadTexture(m_imageTexture.get(), QRhiTextureUploadDescription({ 0, 0, part }));
+            m_statUploaded += qint64(images->image.bytesPerLine()) * (to - from);
+        }
+        m_imageEpoch = images->epoch;
+        m_imageVersion = images->version;
+        m_imageRow = images->shelves.y;
+    }
+    // what the raster engine drew for this frame
+    const int scratchRows = m_scratch.isNull() ? 0 : m_scratchShelves.used();
+    if (scratchRows > 0) {
+        QRhiTextureSubresourceUploadDescription part(m_scratch.constBits(), quint32(m_scratch.bytesPerLine() * scratchRows));
+        part.setDataStride(quint32(m_scratch.bytesPerLine()));
+        part.setSourceSize(QSize(m_scratch.width(), scratchRows));
+        updates->uploadTexture(m_scratchTexture.get(), QRhiTextureUploadDescription({ 0, 0, part }));
+        m_statUploaded += qint64(m_scratch.bytesPerLine()) * scratchRows;
+    }
+
+    if (!quads.empty())
+        updates->updateDynamicBuffer(m_instances.get(), 0, quint32(quads.size() * sizeof(Quad)), quads.data());
+
+    QMatrix4x4 deviceToClip;
+    deviceToClip.ortho(0, m_pixelSize.width(), m_pixelSize.height(), 0, -1, 1);
+    deviceToClip = rhi->clipSpaceCorrMatrix() * deviceToClip;
+    float uniforms[16 + 12];
+    memcpy(uniforms, deviceToClip.constData(), 64);
+    const bool rowsFromBottom = rhi->isYUpInFramebuffer();
+    uniforms[16] = rowsFromBottom ? float(m_pixelSize.height()) : 0;
+    uniforms[17] = rowsFromBottom ? -1 : 1;
+    uniforms[18] = uniforms[19] = 0;
+    uniforms[20] = 1.0f / glyphs->image.width();
+    uniforms[21] = 1.0f / glyphs->image.height();
+    uniforms[22] = 1.0f / images->image.width();
+    uniforms[23] = 1.0f / images->image.height();
+    uniforms[24] = 1.0f / m_scratchTexture->pixelSize().width();
+    uniforms[25] = 1.0f / m_scratchTexture->pixelSize().height();
+    uniforms[26] = uniforms[27] = 0;
+    updates->updateDynamicBuffer(m_uniforms.get(), 0, sizeof(uniforms), uniforms);
+
+    bool inPass = false;
+    auto beginPass = [&]() {
+        if (inPass)
+            return;
+        // a new texture starts from nothing (a translucent window) or from black
+        cb->beginPass(m_hasContents ? m_keep.get() : m_clear.get(), m_translucent ? QColor(0, 0, 0, 0) : QColor(0, 0, 0, 255),
+                      { 1.0f, 0 }, updates);
+        updates = nullptr;
+        cb->setViewport(QRhiViewport(0, 0, float(m_pixelSize.width()), float(m_pixelSize.height())));
+        m_hasContents = true;
+        inPass = true;
+    };
+    auto endPass = [&]() {
+        if (inPass)
+            cb->endPass();
+        inPass = false;
+    };
+
+    if (!m_hasContents)
+        beginPass();
+    for (const Op &op : ops) {
+        if (op.type == Op::Scroll) {
+            endPass();
+            if (!m_scrollTexture) {
+                m_scrollTexture.reset(rhi->newTexture(QRhiTexture::RGBA8, m_pixelSize, 1, QRhiTexture::UsedAsTransferSource));
+                if (!m_scrollTexture->create()) {
+                    m_scrollTexture.reset();
+                    continue;
+                }
+            }
+            if (!updates)
+                updates = rhi->nextResourceUpdateBatch();
+            // a region is never copied onto itself, so it goes through a second texture
+            const QRect from = textureRect(op.rect);
+            const QRect to = textureRect(op.rect.translated(op.delta));
+            QRhiTextureCopyDescription out;
+            out.setPixelSize(from.size());
+            out.setSourceTopLeft(from.topLeft());
+            out.setDestinationTopLeft(from.topLeft());
+            updates->copyTexture(m_scrollTexture.get(), m_target.get(), out);
+            QRhiTextureCopyDescription back;
+            back.setPixelSize(from.size());
+            back.setSourceTopLeft(from.topLeft());
+            back.setDestinationTopLeft(to.topLeft());
+            updates->copyTexture(m_target.get(), m_scrollTexture.get(), back);
+            cb->resourceUpdate(updates);
+            updates = nullptr;
+            continue;
+        }
+        if (!op.count)
+            continue;
+        if (!updates && !inPass)
+            updates = rhi->nextResourceUpdateBatch();
+        beginPass();
+        cb->setGraphicsPipeline(op.type == Op::Draw ? m_over.get() : m_source.get());
+        cb->setShaderResources(m_bindings.get());
+        const QRhiCommandBuffer::VertexInput inputs[2] = {
+            { m_corners.get(), 0 }, { m_instances.get(), quint32(op.first * sizeof(Quad)) }
+        };
+        cb->setVertexInput(0, 2, inputs);
+        cb->draw(4, quint32(op.count));
+        ++m_statDraws;
+    }
+    endPass();
+    if (updates)
+        cb->resourceUpdate(updates);
+
+    m_statQuads += qint64(quads.size());
+    ++m_statFlushes;
+    quads.clear();
+    ops.clear();
+    if (scratchRows > 0) {
+        for (int y = 0; y < scratchRows; ++y)
+            memset(m_scratch.scanLine(y), 0, size_t(m_scratch.bytesPerLine()));
+        m_scratchShelves.reset(m_scratch.width(), m_scratch.height());
+    }
+}
+
+QImage QBatchedPaintBackingStore::toImage() const
+{
+    auto *self = const_cast<QBatchedPaintBackingStore *>(this);
+    if (!m_rhi || !m_target)
+        return QImage();
+    QRhiCommandBuffer *cb = nullptr;
+    if (m_rhi->beginOffscreenFrame(&cb) != QRhi::FrameOpSuccess)
+        return QImage();
+    self->endScratchPainter();
+    if (self->ensureResources(m_rhi))
+        self->run(m_rhi, cb);
+    QRhiReadbackResult result;
+    QRhiResourceUpdateBatch *updates = m_rhi->nextResourceUpdateBatch();
+    updates->readBackTexture(QRhiReadbackDescription(m_target.get()), &result);
+    cb->resourceUpdate(updates);
+    m_rhi->endOffscreenFrame();
+    if (result.data.isEmpty())
+        return QImage();
+    QImage image(reinterpret_cast<const uchar *>(result.data.constData()), result.pixelSize.width(), result.pixelSize.height(),
+                 QImage::Format_RGBA8888_Premultiplied);
+    image = m_rhi->isYUpInFramebuffer() ? image.flipped(Qt::Vertical) : image.copy();
+    image.setDevicePixelRatio(m_dpr);
+    return image;
+}
+
+void QBatchedPaintBackingStore::report()
+{
+    if (!m_statsTime.isValid())
+        m_statsTime.start();
+    if (m_statsTime.elapsed() < 1000 || !m_statFlushes)
+        return;
+    m_statsTime.restart();
+    QByteArray rastered;
+    qint64 native = 0, byRaster = 0;
+    for (int kind = 0; kind < KindCount; ++kind) {
+        if (kind < FirstRaster) {
+            native += counts[kind];
+        } else if (counts[kind]) {
+            byRaster += counts[kind];
+            rastered += ' ' + QByteArray(kindNames[kind]).replace(' ', '_') + '=' + QByteArray::number(counts[kind] / m_statFlushes);
+        }
+    }
+    fprintf(stderr, "QWBATCH flushes=%lld per_flush: draw_calls=%.2f records=%lld rectangles=%lld glyphs=%lld pictures=%lld "
+                    "copied_pictures=%lld raster_drawn=%lld uploaded_kB=%lld run_ms=%.3f raster_kinds:%s\n",
+            static_cast<long long>(m_statFlushes), double(m_statDraws) / m_statFlushes,
+            static_cast<long long>(m_statQuads / m_statFlushes), static_cast<long long>(counts[NativeRect] / m_statFlushes),
+            static_cast<long long>(counts[NativeGlyph] / m_statFlushes), static_cast<long long>(counts[NativeImage] / m_statFlushes),
+            static_cast<long long>(counts[NativeCopiedImage] / m_statFlushes), static_cast<long long>(byRaster / m_statFlushes),
+            static_cast<long long>(m_statUploaded / 1024 / m_statFlushes), m_statRunNs / 1e6 / m_statFlushes,
+            rastered.isEmpty() ? " none" : rastered.constData());
+    Q_UNUSED(native);
+    // the kinds keep their "named once" memory; the counts start again
+    for (qint64 &count : counts)
+        count = count ? 1 : 0;
+    m_statFlushes = m_statDraws = m_statQuads = m_statUploaded = m_statRunNs = 0;
+}
+
+/*
+    Makes the batched backing store of \a window, a widget window flushed through the RHI.
+    Returns null, with the reason in \a failure, when batched painting cannot start; QBackingStore
+    then says so and the window is painted on the CPU.
+*/
+QPlatformBackingStore *qt_create_batched_paint_backingstore(QWindow *window, QString *failure)
+{
+    static int usable = -1;
+    static QString reason;
+    if (usable < 0) {
+        usable = 1;
+#if QT_CONFIG(opengl)
+        if (window->surfaceType() == QSurface::OpenGLSurface) {
+            // The OpenGL the window's RHI will get: it must draw instances, and on a GPU.
+            QOpenGLContext context;
+            context.setFormat(QSurfaceFormat::defaultFormat());
+            context.setShareContext(QOpenGLContext::globalShareContext());
+            QOffscreenSurface surface;
+            surface.setFormat(context.format());
+            if (!context.create()) {
+                reason = u"no OpenGL context could be created"_s;
+            } else {
+                surface.setFormat(context.format());
+                surface.create();
+                if (!context.makeCurrent(&surface)) {
+                    reason = u"the OpenGL context could not be made current"_s;
+                } else {
+                    const QByteArray renderer(reinterpret_cast<const char *>(context.functions()->glGetString(GL_RENDERER)));
+                    const QSurfaceFormat format = context.format();
+                    const bool instancing = context.isOpenGLES() ? format.majorVersion() >= 3
+                                                                 : (format.majorVersion() > 3 || (format.majorVersion() == 3 && format.minorVersion() >= 3));
+                    if (!instancing) {
+                        reason = u"this OpenGL (%1.%2) does not draw instances"_s.arg(format.majorVersion()).arg(format.minorVersion());
+                    } else if ((renderer.startsWith("llvmpipe") || renderer.startsWith("softpipe") || renderer.contains("SwiftShader"))
+                               && !qEnvironmentVariableIntValue("QT_WIDGETS_GPU_PAINT_ALLOW_SOFTWARE")) {
+                        // An OpenGL that the CPU draws is no GPU painting: it is said, never used quietly.
+                        reason = u"the OpenGL of this program is drawn by the CPU (%1)"_s.arg(QLatin1StringView(renderer));
+                    } else if (qEnvironmentVariableIntValue("QT_WIDGETS_PAINT_STATS")) {
+                        qInfo("QT_WIDGETS_GPU_PAINT=batch: painting on \"%s\" (%s)", renderer.constData(),
+                              reinterpret_cast<const char *>(context.functions()->glGetString(GL_VERSION)));
+                    }
+                    context.doneCurrent();
+                }
+            }
+            if (!reason.isEmpty())
+                usable = 0;
+        }
+#endif
+    }
+    if (!usable) {
+        *failure = reason;
+        return nullptr;
+    }
+    return new QBatchedPaintBackingStore(window);
+}
+
+QT_END_NAMESPACE
