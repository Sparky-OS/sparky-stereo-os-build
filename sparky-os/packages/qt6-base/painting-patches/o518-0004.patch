+    void drawTiledPixmap(const QRectF &r, const QPixmap &pixmap, const QPointF &s) override;
+
+    void drawTextItem(const QPointF &p, const QTextItem &textItem) override;
+    void drawStaticTextItem(QStaticTextItem *item) override;
+
+    bool requiresPretransformedGlyphPositions(QFontEngine *fontEngine, const QTransform &m) const override;
+    bool shouldDrawCachedGlyphs(QFontEngine *fontEngine, const QTransform &m) const override;
+
+    void setDeviceRect(const QRect &rect) { m_deviceRect = rect; updateClip(); }
+    void setSubPixelOffset(qreal dx) { m_dx = float(dx); }
+    void updateClip();
+
+    // A rectangle of one colour on whole pixels, taking the place of what is there.
+    void sourceRect(const QRect &rect, const QColor &color);
+
+private:
+    enum Blend { Over, Source, Other };
+    Blend blend() const;
+    bool nativeRect(const QRectF &rect, const QColor &color);
+    bool glyphsDrawable(QFontEngine *fontEngine, const QTransform &m, Kind *why) const;
+    bool drawGlyphs(QFontEngine *fontEngine, const glyph_t *glyphs, const QFixedPoint *positions, int count,
+                    Kind *why);
+    void drawPicture(const QRectF &r, const QImage &image, const QRectF &sr, Qt::ImageConversionFlags flags);
+    void quad(float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1,
+              const quint8 *rgba, Mode mode, Op::Type type = Op::Draw);
+    void push(const Quad &q, Op::Type type);
+    template <typename Draw> void raster(Kind why, const QRectF &deviceBounds, Draw &&draw);
+    void outline(const QRectF &rect, qreal penWidth, const std::function<void(QPainter *)> &draw);
+    qreal penReach() const;
+
+    QBatchedPaintBackingStore *m_store;
+    QRect m_deviceRect;
+    QRegion m_clip;
+    QRect m_clipBounds;
+    bool m_clipIsOneRect = true;
+    bool m_pathClip = false;
+    bool m_rasterStateDirty = true;
