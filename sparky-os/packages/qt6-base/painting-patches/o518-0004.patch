+class QBatchedPaintDevice : public QPaintDevice
+{
+public:
+    explicit QBatchedPaintDevice(QBatchedPaintBackingStore *store) : m_engine(store) { }
+    QPaintEngine *paintEngine() const override { return &m_engine; }
+    int devType() const override { return QInternal::UnknownDevice; }
+    void set(const QSize &pixelSize, qreal dpr, qreal dpi)
+    {
+        m_pixelSize = pixelSize;
+        m_dpr = dpr;
+        m_dpi = dpi;
+        m_engine.setDeviceRect(QRect(QPoint(), pixelSize));
+    }
+    QBatchedPaintEngine *engine() { return &m_engine; }
+
+protected:
+    int metric(PaintDeviceMetric metric) const override
+    {
+        switch (metric) {
+        case PdmWidth:
+            return qCeil(m_pixelSize.width() / m_dpr);
+        case PdmHeight:
+            return qCeil(m_pixelSize.height() / m_dpr);
+        case PdmWidthMM:
+            return qRound(m_pixelSize.width() / m_dpr * 25.4 / m_dpi);
+        case PdmHeightMM:
+            return qRound(m_pixelSize.height() / m_dpr * 25.4 / m_dpi);
+        case PdmNumColors:
+            return 0;
+        case PdmDepth:
+            return 32;
+        case PdmDpiX:
+        case PdmDpiY:
+        case PdmPhysicalDpiX:
+        case PdmPhysicalDpiY:
+            return qRound(m_dpi);
+        case PdmDevicePixelRatio:
+            return qRound(m_dpr);
+        case PdmDevicePixelRatioScaled:
+            return qRound(m_dpr * devicePixelRatioFScale());
+        case PdmDevicePixelRatioF_EncodedA:
+        case PdmDevicePixelRatioF_EncodedB:
+            return QPaintDevice::encodeMetricF(metric, m_dpr);
+        }
+        return 0;
+    }
+
+private:
+    mutable QBatchedPaintEngine m_engine;
+    QSize m_pixelSize;
+    qreal m_dpr = 1;
+    qreal m_dpi = 96;
+};
