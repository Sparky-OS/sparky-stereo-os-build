diff --git a/src/gui/painting/shaders/batchpaint.frag b/src/gui/painting/shaders/batchpaint.frag
new file mode 100644
index 0000000..406660e
--- /dev/null
+++ b/src/gui/painting/shaders/batchpaint.frag
@@ -0,0 +1,43 @@
+#version 440
+
+layout(location = 0) in vec2 v_source;
+layout(location = 1) flat in vec4 v_rect;
+layout(location = 2) flat in vec4 v_color;
+layout(location = 3) flat in float v_mode;
+
+layout(location = 0) out vec4 fragColor;
+
+layout(std140, binding = 0) uniform buf {
+    mat4 deviceToClip;
+    vec4 rowOrder;
+    vec4 glyphsImages;
+    vec4 scratch;
+};
+
+layout(binding = 1) uniform sampler2D glyphTexture;
+layout(binding = 2) uniform sampler2D imageTexture;
+layout(binding = 3) uniform sampler2D scratchTexture;
+
+void main()
+{
+    // The part of this pixel the rectangle covers: all of it for a rectangle on whole pixels,
+    // so such a rectangle is drawn as the raster engine draws it.
+    vec2 pixel = vec2(gl_FragCoord.x, rowOrder.x + rowOrder.y * gl_FragCoord.y);
+    vec2 covered = clamp(min(pixel + 0.5, v_rect.zw) - max(pixel - 0.5, v_rect.xy), 0.0, 1.0);
+    float coverage = covered.x * covered.y;
+
+    vec4 result = v_color;
+    if (v_mode > 0.5) {
+        // modes 1, 2 and 4 take one texel, unfiltered; 3 and 5 are filtered
+        vec2 texel = v_source;
+        if (v_mode < 2.5 || (v_mode > 3.5 && v_mode < 4.5))
+            texel = floor(texel) + 0.5;
+        if (v_mode < 1.5)
+            result *= texture(glyphTexture, texel * glyphsImages.xy).r;
+        else if (v_mode < 3.5)
+            result *= texture(imageTexture, texel * glyphsImages.zw);
+        else
+            result *= texture(scratchTexture, texel * scratch.xy);
+    }
+    fragColor = result * coverage;
+}
diff --git a/src/gui/painting/shaders/batchpaint.vert b/src/gui/painting/shaders/batchpaint.vert
new file mode 100644
index 0000000..e3001e1
--- /dev/null
+++ b/src/gui/painting/shaders/batchpaint.vert
@@ -0,0 +1,34 @@
+#version 440
+
+// One instance is one rectangle of a recorded paint pass: a fill, a glyph, a picture or a part
+// the raster engine drew (qbatchedpaintengine.cpp).
+
+layout(location = 0) in vec2 corner;
+layout(location = 1) in vec4 rect;      // left, top, right, bottom in device pixels
+layout(location = 2) in vec4 source;    // the same corners in texels of the instance's texture
+layout(location = 3) in vec4 color;     // premultiplied
+layout(location = 4) in float mode;
+
+layout(location = 0) out vec2 v_source;
+layout(location = 1) flat out vec4 v_rect;
+layout(location = 2) flat out vec4 v_color;
+layout(location = 3) flat out float v_mode;
+
+layout(std140, binding = 0) uniform buf {
+    mat4 deviceToClip;
+    vec4 rowOrder;      // device y = rowOrder.x + rowOrder.y * gl_FragCoord.y
+    vec4 glyphsImages;  // 1 / size of the glyph texture, 1 / size of the picture texture
+    vec4 scratch;       // 1 / size of the texture of raster-drawn parts
+};
+
+void main()
+{
+    // every pixel the rectangle touches; the fragment shader weighs the edge pixels
+    vec2 point = mix(floor(rect.xy), ceil(rect.zw), corner);
+    vec2 along = (point - rect.xy) / max(rect.zw - rect.xy, vec2(0.000001));
+    v_source = mix(source.xy, source.zw, along);
+    v_rect = rect;
+    v_color = color;
+    v_mode = mode;
+    gl_Position = deviceToClip * vec4(point, 0.0, 1.0);
+}
