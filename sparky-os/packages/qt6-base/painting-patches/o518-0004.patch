+// One instance of the quad: 40 bytes, the layout batchpaint.vert reads.
+struct Quad
+{
+    float x0, y0, x1, y1;
+    float u0, v0, u1, v1;
+    quint8 rgba[4];
+    float mode;
+};
+static_assert(sizeof(Quad) == 40);
+
+enum Mode { Solid = 0, Glyph = 1, ImageNearest = 2, ImageLinear = 3, ScratchNearest = 4, ScratchLinear = 5 };
+
+// What the engine draws itself, and what it hands to the raster engine, by kind.
+enum Kind {
+    NativeRect, NativeGlyph, NativeImage, NativeCopiedImage,
+    FirstRaster,
+    RasterPath = FirstRaster, RasterStroke, RasterLines, RasterRectOutline, RasterPatternRect,
+    RasterTransformedRect, RasterEllipse, RasterPolygon, RasterPoints, RasterRoundedRect,
+    RasterTextTransformed, RasterTextPen, RasterTextLarge, RasterTextSubpixel, RasterTextColour,
+    RasterTextEngine, RasterTextAtlasFull, RasterImageTransformed, RasterBitmap, RasterTiledPixmap,
+    RasterPathClip, RasterComposition,
+    KindCount
+};
+
+static const char *const kindNames[KindCount] = {
+    "rectangles", "glyphs", "pictures", "copied pictures",
+    "path fills", "path strokes", "lines", "rectangle outlines", "pattern or gradient rectangles",
+    "rotated or sheared rectangles", "ellipses", "polygons", "points", "rounded rectangles",
+    "rotated or sheared text", "text with a pattern pen", "text above the glyph cache size",
+    "text with coloured-fringe (LCD) antialiasing", "colour glyphs", "text of a font engine without its own glyph store",
+    "text while the glyph texture is full", "rotated or sheared pictures", "one-bit pictures", "tiled pictures",
+    "anything under a clip that is not rectangles", "anything in a composition mode other than SourceOver or Source"
+};
+
+struct Op
+{
+    enum Type { Draw, DrawSource, Scroll } type;
+    int first = 0;
+    int count = 0;
+    QRect rect;
+    QPoint delta;
+};
+
+struct Shelves
+{
+    int width = 0, height = 0;
+    int x = 0, y = 0, row = 0;
+
+    void reset(int w, int h) { width = w; height = h; x = y = row = 0; }
+    bool place(int w, int h, QPoint *at)
+    {
+        if (w > width)
+            return false;
+        if (x + w > width) {
+            y += row;
+            x = 0;
+            row = 0;
+        }
+        if (y + h > height)
+            return false;
+        *at = QPoint(x, y);
+        x += w;
+        row = qMax(row, h);
+        return true;
+    }
+    int used() const { return y + row; }
+};
+
+static inline void premultiplied(const QColor &color, qreal opacity, quint8 *rgba)
+{
+    QRgb c = color.rgba();
+    if (opacity < 1) {
+        const int a = qRound(qAlpha(c) * opacity);
+        c = (c & 0x00ffffff) | (uint(a) << 24);
+    }
+    c = qPremultiply(c);
+    rgba[0] = qRed(c);
+    rgba[1] = qGreen(c);
+    rgba[2] = qBlue(c);
+    rgba[3] = qAlpha(c);
+}
+
+/*
+    The glyph masks of every font this process paints with, in one image; each window's store
+    keeps a texture of it. A font engine carries a tag with a number that is never used twice,
+    so a new engine at an old address does not find the old one's glyphs.
+*/
+struct GlyphKey
+{
+    quint32 font;
+    quint32 glyph;
+    quint16 transform;
+    quint8 subX, subY;
+    friend bool operator==(const GlyphKey &a, const GlyphKey &b) noexcept
+    {
+        return a.font == b.font && a.glyph == b.glyph && a.transform == b.transform && a.subX == b.subX
+                && a.subY == b.subY;
+    }
+};
+
+inline size_t qHash(const GlyphKey &key, size_t seed = 0) noexcept
+{
+    return qHashMulti(seed, key.font, key.glyph, quint32(key.transform) << 16 | quint32(key.subX) << 8 | key.subY);
+}
+
+struct GlyphEntry
+{
+    quint16 x = 0, y = 0, w = 0, h = 0;
+    qint16 left = 0, top = 0;
+};
+
+class FontTag : public QFontEngineGlyphCache
+{
+public:
+    FontTag() : QFontEngineGlyphCache(QFontEngine::Format_A8, QTransform())
+    {
+        static quint32 next = 0;
+        id = ++next;
+    }
+    quint16 transformId(const QTransform &m)
+    {
+        for (qsizetype i = 0; i < transforms.size(); ++i) {
+            const auto &t = transforms.at(i);
+            if (t[0] == m.m11() && t[1] == m.m12() && t[2] == m.m21() && t[3] == m.m22())
+                return quint16(i);
+        }
+        transforms.append({ m.m11(), m.m12(), m.m21(), m.m22() });
+        return quint16(transforms.size() - 1);
+    }
+    quint32 id;
+    // -1 not known yet, else a QFontEngine::GlyphFormat
+    int format = -1;
+    QVarLengthArray<std::array<qreal, 4>, 2> transforms;
+};
+
+struct GlyphAtlas
+{
+    QImage image;
+    Shelves shelves;
+    QHash<GlyphKey, GlyphEntry> glyphs;
+    quint64 version = 0;    // counts the masks added
+    quint64 epoch = 0;      // counts the times the image was emptied or enlarged
+    bool full = false;
+    int maxHeight = 4096;
+
+    void ensure()
+    {
+        if (image.isNull()) {
+            image = QImage(2048, 1024, QImage::Format_Alpha8);
+            image.fill(0);
+            shelves.reset(image.width(), image.height());
+        }
+    }
+
+    // Empties the image: only between paint passes, since records point into it.
+    void clear()
+    {
+        glyphs.clear();
+        if (!image.isNull())
+            image.fill(0);
+        shelves.reset(image.width(), image.height());
+        full = false;
+        ++epoch;
+        ++version;
+    }
+
+    bool place(int w, int h, QPoint *at)
+    {
+        ensure();
+        while (!shelves.place(w + 1, h + 1, at)) {
+            if (image.height() >= maxHeight || w + 1 > image.width()) {
+                full = true;
+                return false;
+            }
+            // texel positions stay valid in a taller image
+            QImage taller(image.width(), image.height() * 2, QImage::Format_Alpha8);
+            taller.fill(0);
+            for (int y = 0; y < image.height(); ++y)
+                memcpy(taller.scanLine(y), image.constScanLine(y), image.width());
+            image = taller;
+            shelves.height = image.height();
+            ++epoch;
+        }
+        return true;
+    }
+};
+
+Q_GLOBAL_STATIC(GlyphAtlas, glyphAtlas)
+
+/*
+    Small pictures (icons, pixmap cache entries), whole, with their edge repeated around them so
+    that a filtered sample at the edge takes nothing of a neighbour.
+*/
+struct ImageEntry
+{
+    quint16 x = 0, y = 0;
+};
+
+struct ImageAtlas
+{
+    QImage image;
+    Shelves shelves;
+    QHash<qint64, ImageEntry> images;
+    quint64 version = 0;
+    quint64 epoch = 0;
+    bool full = false;
+
+    void ensure()
+    {
+        if (image.isNull()) {
+            image = QImage(2048, 2048, QImage::Format_RGBA8888_Premultiplied);
+            image.fill(0);
+            shelves.reset(image.width(), image.height());
+        }
+    }
+
+    void clear()
+    {
+        images.clear();
+        shelves.reset(image.width(), image.height());
+        full = false;
+        ++epoch;
+        ++version;
+    }
+};
+
+Q_GLOBAL_STATIC(ImageAtlas, imageAtlas)
+
+// Copies \a part of \a source to \a at in \a target with one more pixel around it, the edge repeated.
+static void copyPadded(const QImage &source, const QRect &part, QImage *target, const QPoint &at)
+{
+    const int bpp = 4;
+    for (int row = -1; row <= part.height(); ++row) {
+        const int sy = qBound(part.top(), part.top() + row, part.bottom());
+        const uchar *from = source.constScanLine(sy) + part.left() * bpp;
+        uchar *to = target->scanLine(at.y() + 1 + row) + at.x() * bpp;
+        memcpy(to, from, bpp);
+        memcpy(to + bpp, from, size_t(part.width()) * bpp);
+        memcpy(to + (part.width() + 1) * bpp, from + (part.width() - 1) * bpp, bpp);
+    }
+}
