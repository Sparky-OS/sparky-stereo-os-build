<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.sparky-stereo-locales">
    <message>Authentication is required to run Sparky Stereo Locales</message>
    <message xml:lang="pl">Uruchomienie Sparky Stereo Locales wymaga uwierzytelnienia</message>
    <message xml:lang="pt_BR">É preciso se autenticar para executar o Sparky Stereo Locales</message>
    <message xml:lang="de">Zum Starten von Sparky Stereo Locales ist eine Authentifizierung erforderlich</message>
    <message xml:lang="es">Se requiere autenticación para ejecutar Sparky Stereo Locales</message>
    <message xml:lang="ko">Sparky Stereo Locales를 실행하려면 인증이 필요합니다</message>
    <message xml:lang="zh_CN">运行 Sparky Stereo Locales 需要身份验证</message>
    <message xml:lang="zh_TW">執行 Sparky Stereo Locales 需要驗證身分</message>
    <message xml:lang="fr">Une authentification est requise pour exécuter Sparky Stereo Locales</message>
  <message xml:lang="ja">Sparky Stereo Locales を実行するには認証が必要です</message>
    <icon_name>preferences-desktop-locale</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/sparky-stereo-locales</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
