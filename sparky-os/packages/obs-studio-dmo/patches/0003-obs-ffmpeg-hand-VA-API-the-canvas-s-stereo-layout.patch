Description: obs-ffmpeg: hand VA-API the canvas's stereo layout
 AV_FRAME_DATA_STEREO3D in the codec context's decoded_side_data before avcodec_open2() and on the frame every
 submitted surface copies its properties from, so an FFmpeg that writes the frame packing arrangement SEI from side data
 (the edition's, 10:9.0.2-dmo1+stereo3d15 and later) marks VA-API recordings and streams. Nothing changes in 2D.
Author: Daniel Campos Ramos
Origin: other, Sparky Stereo OS (ORDER 61, milestone 2)
Forwarded: no, OBS asks for human-written submissions only (CONTRIBUTING.md, AI/Machine Learning Policy)
Last-Update: 2026-11-21
---
diff --git a/libobs/obs.c b/libobs/obs.c
index 6c04afb..3219997 100644
--- a/libobs/obs.c
+++ b/libobs/obs.c
@@ -1677,7 +1677,7 @@ float obs_get_video_hdr_nominal_peak_level(void)
 void obs_set_video_stereo3d(enum obs_stereo3d_type type, uint32_t flags)
 {
 	struct obs_core_video *video = &obs->video;
-	if (type < OBS_STEREO3D_2D || type > OBS_STEREO3D_COLUMNS) {
+	if (type < OBS_STEREO3D_2D || type > OBS_STEREO3D_COLUMNS_QUINCUNX || (int)type == 8) {
 		blog(LOG_WARNING, "obs_set_video_stereo3d: unknown layout %d, the canvas is taken as 2D", (int)type);
 		type = OBS_STEREO3D_2D;
 	}
diff --git a/libobs/obs.h b/libobs/obs.h
index 7e4182b..d0730b2 100644
--- a/libobs/obs.h
+++ b/libobs/obs.h
@@ -492,6 +492,11 @@ enum obs_stereo3d_type {
 	OBS_STEREO3D_SIDE_BY_SIDE_QUINCUNX = 5,
 	OBS_STEREO3D_LINES = 6,
 	OBS_STEREO3D_COLUMNS = 7,
+	/* 8 is FFmpeg's "unspecified", never a canvas layout */
+	OBS_STEREO3D_TILED = 9,
+	OBS_STEREO3D_TOP_BOTTOM_QUINCUNX = 10,
+	OBS_STEREO3D_LINES_QUINCUNX = 11,
+	OBS_STEREO3D_COLUMNS_QUINCUNX = 12,
 };
 
 /** The right eye's view comes first (content_interpretation_type 2, H.264 Table D-10). */
diff --git a/plugins/obs-ffmpeg/obs-ffmpeg-vaapi.c b/plugins/obs-ffmpeg/obs-ffmpeg-vaapi.c
index 32d5f4f..283223f 100644
--- a/plugins/obs-ffmpeg/obs-ffmpeg-vaapi.c
+++ b/plugins/obs-ffmpeg/obs-ffmpeg-vaapi.c
@@ -34,6 +34,7 @@
 
 #include <libavutil/opt.h>
 #include <libavutil/pixdesc.h>
+#include <libavutil/stereo3d.h>
 #include <libavutil/hwcontext.h>
 #include <libavutil/hwcontext_vaapi.h>
 #include <libavcodec/avcodec.h>
@@ -196,6 +197,34 @@ static bool vaapi_init_codec(struct vaapi_encoder *enc, const char *path)
 	enc->context->pix_fmt = AV_PIX_FMT_VAAPI;
 	enc->context->hw_frames_ctx = av_buffer_ref(enc->vaframes_ref);
 
+	/* The canvas's stereo layout, for the edition's FFmpeg to write the frame packing arrangement SEI while it encodes:
+	 * the stream's initial layout before the encoder opens (HEVC's parameter sets depend on it) and the same on every
+	 * frame, which each submitted surface copies with av_frame_copy_props(). */
+	uint32_t stereo_flags = 0;
+	const enum obs_stereo3d_type stereo = obs_encoder_get_stereo3d(enc->encoder, &stereo_flags);
+	if (stereo != OBS_STEREO3D_2D) {
+		size_t size = 0;
+		AVStereo3D *initial = av_stereo3d_alloc_size(&size);
+		AVStereo3D *per_frame = av_stereo3d_create_side_data(enc->vframe);
+		AVBufferRef *buffer = initial ? av_buffer_create((uint8_t *)initial, size, NULL, NULL, 0) : NULL;
+		if (!buffer || !per_frame) {
+			av_free(buffer ? NULL : initial);
+			av_buffer_unref(&buffer);
+			warn("Failed to attach the canvas's stereo layout");
+			return false;
+		}
+		initial->type = per_frame->type = (enum AVStereo3DType)stereo;
+		initial->flags = per_frame->flags = (stereo_flags & OBS_STEREO3D_FLAG_INVERT) ? AV_STEREO3D_FLAG_INVERT : 0;
+		if (!av_frame_side_data_add(&enc->context->decoded_side_data, &enc->context->nb_decoded_side_data,
+					    AV_FRAME_DATA_STEREO3D, &buffer, 0)) {
+			av_buffer_unref(&buffer);
+			warn("Failed to attach the canvas's stereo layout");
+			return false;
+		}
+		info("stereo: layout %d%s from the canvas", (int)stereo,
+		     (stereo_flags & OBS_STEREO3D_FLAG_INVERT) ? ", right eye first" : "");
+	}
+
 	ret = avcodec_open2(enc->context, enc->vaapi, NULL);
 	if (ret < 0) {
 		warn("Failed to open VAAPI codec: %s", av_err2str(ret));
