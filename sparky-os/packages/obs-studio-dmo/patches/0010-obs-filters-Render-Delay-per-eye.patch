Description: obs-filters: Render Delay keeps the right eye's frames apart on a side by side canvas
 A side by side canvas draws each source once per eye (obs_get_render_eye()). Render Delay kept one frame a tick and,
 in the second eye pass, drew the frame it had already taken: the right eye showed the left eye's delayed picture.
 The right eye now has a queue of its own, as long as the left one's, kept only while the canvas is side by side; a
 2D canvas keeps one queue as before.
Author: Daniel Campos Ramos
Origin: other, Sparky Stereo OS (ORDER 61, milestone 3)
Forwarded: no, OBS asks for human-written submissions only (CONTRIBUTING.md, AI/Machine Learning Policy)
Last-Update: 2026-11-22
---
diff --git a/plugins/obs-filters/gpu-delay.c b/plugins/obs-filters/gpu-delay.c
index 2e69f61..374656e 100644
--- a/plugins/obs-filters/gpu-delay.c
+++ b/plugins/obs-filters/gpu-delay.c
@@ -20,6 +20,10 @@ struct gpu_delay_filter_data {
 	uint32_t cy;
 	bool target_valid;
 	bool processed_frame;
+	/* a side by side canvas draws each source once per eye (obs_get_render_eye()): the right eye keeps frames of its
+	 * own, so neither eye is shown the other's delayed picture; empty while the canvas is not side by side */
+	struct deque right_frames;
+	bool processed_right;
 };
 
 static const char *gpu_delay_filter_get_name(void *unused)
@@ -28,15 +32,21 @@ static const char *gpu_delay_filter_get_name(void *unused)
 	return obs_module_text("GPUDelayFilter");
 }
 
-static void free_textures(struct gpu_delay_filter_data *f)
+static void free_frames(struct deque *frames)
 {
-	obs_enter_graphics();
-	while (f->frames.size) {
+	while (frames->size) {
 		struct frame frame;
-		deque_pop_front(&f->frames, &frame, sizeof(frame));
+		deque_pop_front(frames, &frame, sizeof(frame));
 		gs_texrender_destroy(frame.render);
 	}
-	deque_free(&f->frames);
+	deque_free(frames);
+}
+
+static void free_textures(struct gpu_delay_filter_data *f)
+{
+	obs_enter_graphics();
+	free_frames(&f->frames);
+	free_frames(&f->right_frames);
 	obs_leave_graphics();
 }
 
@@ -45,36 +55,28 @@ static size_t num_frames(struct deque *buf)
 	return buf->size / sizeof(struct frame);
 }
 
-static void update_interval(struct gpu_delay_filter_data *f, uint64_t new_interval_ns)
+static void set_frame_count(struct deque *frames, size_t num)
 {
-	if (!f->target_valid) {
-		free_textures(f);
-		return;
-	}
-
-	f->interval_ns = new_interval_ns;
-	size_t num = (size_t)(f->delay_ns / new_interval_ns);
-
-	if (num > num_frames(&f->frames)) {
-		size_t prev_num = num_frames(&f->frames);
+	if (num > num_frames(frames)) {
+		size_t prev_num = num_frames(frames);
 
 		obs_enter_graphics();
 
-		deque_upsize(&f->frames, num * sizeof(struct frame));
+		deque_upsize(frames, num * sizeof(struct frame));
 
 		for (size_t i = prev_num; i < num; i++) {
-			struct frame *frame = deque_data(&f->frames, i * sizeof(*frame));
+			struct frame *frame = deque_data(frames, i * sizeof(*frame));
 			frame->render = gs_texrender_create(GS_RGBA, GS_ZS_NONE);
 		}
 
 		obs_leave_graphics();
 
-	} else if (num < num_frames(&f->frames)) {
+	} else if (num < num_frames(frames)) {
 		obs_enter_graphics();
 
-		while (num_frames(&f->frames) > num) {
+		while (num_frames(frames) > num) {
 			struct frame frame;
-			deque_pop_front(&f->frames, &frame, sizeof(frame));
+			deque_pop_front(frames, &frame, sizeof(frame));
 			gs_texrender_destroy(frame.render);
 		}
 
@@ -82,6 +84,28 @@ static void update_interval(struct gpu_delay_filter_data *f, uint64_t new_interv
 	}
 }
 
+/* the right eye's frames follow the left's count while the canvas is side by side */
+static void check_right_frames(struct gpu_delay_filter_data *f)
+{
+	const size_t num = obs_get_video_eye_size(NULL, NULL) ? num_frames(&f->frames) : 0;
+	if (num != num_frames(&f->right_frames))
+		set_frame_count(&f->right_frames, num);
+}
+
+static void update_interval(struct gpu_delay_filter_data *f, uint64_t new_interval_ns)
+{
+	if (!f->target_valid) {
+		free_textures(f);
+		return;
+	}
+
+	f->interval_ns = new_interval_ns;
+	size_t num = (size_t)(f->delay_ns / new_interval_ns);
+
+	set_frame_count(&f->frames, num);
+	check_right_frames(f);
+}
+
 static inline void check_interval(struct gpu_delay_filter_data *f)
 {
 	struct obs_video_info ovi = {0};
@@ -177,10 +201,12 @@ static void gpu_delay_filter_tick(void *data, float t)
 	struct gpu_delay_filter_data *f = data;
 
 	f->processed_frame = false;
+	f->processed_right = false;
 
 	if (check_size(f))
 		return;
 	check_interval(f);
+	check_right_frames(f);
 }
 
 static const char *get_tech_name_and_multiplier(enum gs_color_space current_space, enum gs_color_space source_space,
@@ -230,10 +256,10 @@ static const char *get_tech_name_and_multiplier(enum gs_color_space current_spac
 	return tech_name;
 }
 
-static void draw_frame(struct gpu_delay_filter_data *f)
