-	deque_peek_front(&f->frames, &frame, sizeof(frame));
+	deque_peek_front(frames, &frame, sizeof(frame));
 
 	const enum gs_color_space current_space = gs_get_color_space();
 	float multiplier;
@@ -261,18 +287,22 @@ static void gpu_delay_filter_render(void *data, gs_effect_t *effect)
 	obs_source_t *target = obs_filter_get_target(f->context);
 	obs_source_t *parent = obs_filter_get_parent(f->context);
 
-	if (!f->target_valid || !target || !parent || !f->frames.size) {
+	const bool right = obs_get_render_eye() == OBS_RENDER_EYE_RIGHT && f->right_frames.size;
+	struct deque *frames = right ? &f->right_frames : &f->frames;
+	bool *processed = right ? &f->processed_right : &f->processed_frame;
+
+	if (!f->target_valid || !target || !parent || !frames->size) {
 		obs_source_skip_video_filter(f->context);
 		return;
 	}
 
-	if (f->processed_frame) {
-		draw_frame(f);
+	if (*processed) {
+		draw_frame(f, frames);
 		return;
 	}
 
 	struct frame frame;
-	deque_pop_front(&f->frames, &frame, sizeof(frame));
+	deque_pop_front(frames, &frame, sizeof(frame));
 
 	const enum gs_color_space preferred_spaces[] = {
 		GS_CS_SRGB,
@@ -314,9 +344,9 @@ static void gpu_delay_filter_render(void *data, gs_effect_t *effect)
 
 	gs_blend_state_pop();
 
-	deque_push_back(&f->frames, &frame, sizeof(frame));
-	draw_frame(f);
-	f->processed_frame = true;
+	deque_push_back(frames, &frame, sizeof(frame));
+	draw_frame(f, frames);
+	*processed = true;
 
 	UNUSED_PARAMETER(effect);
 }
