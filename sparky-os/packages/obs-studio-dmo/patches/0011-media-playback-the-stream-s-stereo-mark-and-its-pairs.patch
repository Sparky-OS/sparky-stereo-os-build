+/* One side by side picture of two frames of the same size and format, each copied as it is, the left eye first, dated
+ * as props (frame 0 of the pair); the copy libstereo-av makes of two views of one time (join_views()). */
+static int mp_stereo_join(AVFrame *out, const AVFrame *left, const AVFrame *right, const AVFrame *props)
+{
+	const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(left->format);
+	if (!desc || (desc->flags & (AV_PIX_FMT_FLAG_HWACCEL | AV_PIX_FMT_FLAG_PAL | AV_PIX_FMT_FLAG_BITSTREAM)) ||
+	    left->width != right->width || left->height != right->height || left->format != right->format ||
+	    left->width > INT_MAX / 2 || left->width % (1 << desc->log2_chroma_w))
+		return AVERROR(EINVAL);
+	av_frame_unref(out);
+	out->format = left->format;
+	out->width = left->width * 2;
+	out->height = left->height;
+	int ret = av_frame_get_buffer(out, 32);
+	if (ret < 0 || (ret = av_frame_copy_props(out, props)) < 0)
+		return ret;
+	int rowsize[4];
+	ptrdiff_t strides[4];
+	size_t sizes[4];
+	if ((ret = av_image_fill_linesizes(rowsize, left->format, left->width)) < 0)
+		return ret;
+	for (int p = 0; p < 4; p++)
+		strides[p] = rowsize[p];
+	if ((ret = av_image_fill_plane_sizes(sizes, left->format, left->height, strides)) < 0)
+		return ret;
+	for (int p = 0; p < 4 && rowsize[p]; p++) {
+		for (size_t y = 0; y < sizes[p] / rowsize[p]; y++) {
+			memcpy(out->data[p] + y * out->linesize[p], left->data[p] + (ptrdiff_t)y * left->linesize[p],
+			       rowsize[p]);
+			memcpy(out->data[p] + y * out->linesize[p] + rowsize[p],
+			       right->data[p] + (ptrdiff_t)y * right->linesize[p], rowsize[p]);
+		}
+	}
+	return 0;
+}
+
+static void mp_stereo_publish(struct mp_decode *d, int type, int flags, int paired)
+{
+	long mark = ((long)(type >= 0 ? type + 1 : 0) & 0xff) | (((long)flags & 0xff) << 8) | ((long)paired << 16);
+	os_atomic_set_long(&d->m->stereo_mark, mark);
+}
+
+/* The mark of the frame decoded, and its pairing as the person's filter asks. Returns true when d->frame is a picture
+ * to hand on, false when it is kept for its pair or dropped. Frames in turn: frame 0 starts a pair and a frame 1
+ * without its frame 0 is dropped while the frames' marks say which they are (current_frame_is_frame0_flag, H.264
+ * D.2.26, H.265 D.3.16; FFmpeg's AVStereo3D.view, VIEW_LEFT for frame 0 whatever the eye order); without such marks
+ * (Matroska's StereoMode 13 and 14, the person's choice) two frames in turn from the first. */
+static bool mp_stereo_frame(struct mp_decode *d)
+{
+	const long request = os_atomic_load_long(&d->m->stereo_request);
+	const int pairing = (int)(request & 3);
+
+	if (d->stereo_views) {
+		int r = stereo_av_pair_frame(d->stereo_views, d->decoder, d->frame, pairing != 0);
+		if (r == 0)
+			return false;
+		if (r < 0) {
+			blog(LOG_WARNING, "MP: the two views of '%s' could not be paired: %s", d->m->path, av_err2str(r));
+			return false;
+		}
+		if (r == 2) {
+			mp_stereo_publish(d, AV_STEREO3D_SIDEBYSIDE, 0, 2);
+			return true;
+		}
+	}
+
+	const AVFrameSideData *sd = av_frame_get_side_data(d->frame, AV_FRAME_DATA_STEREO3D);
+	const AVStereo3D *s = sd && sd->size >= sizeof(AVStereo3D) ? (const AVStereo3D *)sd->data : NULL;
+	const int type = s ? (int)s->type : d->stereo_stream_type;
+	const int flags = s ? s->flags : d->stereo_stream_flags;
+	const int view = s ? (int)s->view : AV_STEREO3D_VIEW_UNSPEC;
+	const bool sequence = type == AV_STEREO3D_FRAMESEQUENCE;
+
+	if (!(pairing == 2 || (pairing == 1 && sequence))) {
+		av_frame_unref(d->stereo_first);
+		mp_stereo_publish(d, type, flags, 0);
+		return true;
+	}
+
+	const bool by_marks = sequence && (view == AV_STEREO3D_VIEW_LEFT || view == AV_STEREO3D_VIEW_RIGHT);
+	const bool first_right = pairing == 2 ? (request & 4) != 0 : (flags & AV_STEREO3D_FLAG_INVERT) != 0;
+	const bool frame0 = by_marks ? view == AV_STEREO3D_VIEW_LEFT : !d->stereo_first->buf[0];
+	if (frame0) {
+		av_frame_unref(d->stereo_first);
+		av_frame_ref(d->stereo_first, d->frame);
+		return false;
+	}
+	if (!d->stereo_first->buf[0])
+		return false;
+
+	const AVFrame *first = d->stereo_first;
+	int ret = mp_stereo_join(d->stereo_joined, first_right ? d->frame : first, first_right ? first : d->frame, first);
+	if (ret >= 0)
+		d->stereo_joined->duration = first->duration > 0 && d->frame->duration > 0
+						     ? first->duration + d->frame->duration
+						     : 0;
+	av_frame_unref(d->stereo_first);
+	if (ret < 0) {
+		blog(LOG_WARNING, "MP: two frames in turn of '%s' could not be paired: %s", d->m->path, av_err2str(ret));
+		return false;
+	}
+	d->frame = d->stereo_joined;
+	mp_stereo_publish(d, sequence ? AV_STEREO3D_FRAMESEQUENCE : type, flags, 1);
+	return true;
+}
