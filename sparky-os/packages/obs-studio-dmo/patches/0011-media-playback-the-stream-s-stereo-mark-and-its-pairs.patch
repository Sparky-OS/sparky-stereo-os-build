+/* Sparky Stereo OS: the stereo mark of the frames this source hands on, as FFmpeg reads it from the stream (the frame
+ * packing arrangement SEI) and the container (Matroska StereoMode, MP4 st3d): type is the AVStereo3DType, -1 for none,
+ * flags its AVStereo3D flags, paired 1 for frames in turn and 2 for two views made into one side by side picture, left
+ * eye first; stereo_mode Matroska's StereoMode as FFmpeg's stream tag. */
+static void get_stereo3d(void *data, calldata_t *cd)
+{
+	struct ffmpeg_source *s = data;
+	const char *tag = "";
+	long mark = media_playback_get_stereo3d(s->media, &tag);
+	calldata_set_int(cd, "type", (long long)(mark & 0xff) - 1);
+	calldata_set_int(cd, "flags", (mark >> 8) & 0xff);
+	calldata_set_int(cd, "paired", (mark >> 16) & 3);
+	calldata_set_string(cd, "stereo_mode", tag);
+}
+
+/* mode: 0 nothing paired, 1 what the stream marks (frames in turn, two views), 2 frames in turn as the person chose;
+ * right_first: the first frame of a pair is the right eye's */
+static void set_stereo3d_pairing(void *data, calldata_t *cd)
+{
+	struct ffmpeg_source *s = data;
+	long request = (long)(calldata_int(cd, "mode") & 3) | (calldata_bool(cd, "right_first") ? 4 : 0);
+	os_atomic_set_long(&s->stereo_request, request);
+	media_playback_set_stereo3d_pairing(s->media, request);
+}
