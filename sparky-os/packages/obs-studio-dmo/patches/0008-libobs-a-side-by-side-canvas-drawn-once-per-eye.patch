diff --git a/libobs/graphics/graphics.c b/libobs/graphics/graphics.c
index 00abe2e..6ae1a3b 100644
--- a/libobs/graphics/graphics.c
+++ b/libobs/graphics/graphics.c
@@ -1139,9 +1139,36 @@ void gs_reset_viewport(void)
 		return;
 
 	gs_get_size(&cx, &cy);
+	if (thread_graphics->view_cx && !gs_get_render_target())
+		cx = (uint32_t)thread_graphics->view_cx;
 	gs_set_viewport(0, 0, (int)cx, (int)cy);
 }
 
+void gs_set_swap_view(int x, int cx)
+{
+	if (!gs_valid("gs_set_swap_view"))
+		return;
+
+	thread_graphics->view_x = cx > 0 ? x : 0;
+	thread_graphics->view_cx = cx > 0 ? cx : 0;
+}
+
+void gs_texrender_new_pass(void)
+{
+	if (gs_valid("gs_texrender_new_pass"))
+		thread_graphics->texrender_pass++;
+}
+
+uint32_t gs_texrender_pass(void)
+{
+	return thread_graphics ? thread_graphics->texrender_pass : 0;
+}
+
+static inline int swap_view_x(graphics_t *graphics)
+{
+	return graphics->view_cx && !graphics->exports.device_get_render_target(graphics->device) ? graphics->view_x : 0;
+}
