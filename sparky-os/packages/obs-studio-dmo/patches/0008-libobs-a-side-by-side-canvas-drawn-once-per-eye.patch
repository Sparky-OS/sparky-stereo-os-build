+void obs_display_set_views(obs_display_t *display, uint32_t views)
+{
+	if (!obs_ptr_valid(display, "obs_display_set_views"))
+		return;
+
+	pthread_mutex_lock(&display->draw_info_mutex);
+	display->next_views = views == 2 ? 2 : 1;
+	pthread_mutex_unlock(&display->draw_info_mutex);
+}
+
+uint32_t obs_display_get_views(obs_display_t *display)
+{
+	uint32_t views = 1;
+
+	if (!obs_ptr_valid(display, "obs_display_get_views"))
+		return views;
+
+	pthread_mutex_lock(&display->draw_info_mutex);
+	views = display->next_views;
+	pthread_mutex_unlock(&display->draw_info_mutex);
+	return views;
+}
