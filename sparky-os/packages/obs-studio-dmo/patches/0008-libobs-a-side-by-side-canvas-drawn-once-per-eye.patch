+bool obs_get_video_eye_size(uint32_t *cx, uint32_t *cy)
+{
+	uint32_t width = 0, height = 0;
+	bool side_by_side = false;
+
+	if (obs && obs->data.main_canvas && obs->data.main_canvas->mix) {
+		width = obs->data.main_canvas->mix->ovi.base_width;
+		height = obs->data.main_canvas->mix->ovi.base_height;
+		side_by_side = obs_get_video_stereo3d(NULL) == OBS_STEREO3D_SIDE_BY_SIDE && width >= 2;
+		if (side_by_side)
+			width /= 2;
+	}
+	if (cx)
+		*cx = width;
+	if (cy)
+		*cy = height;
+	return side_by_side;
+}
+
+enum obs_render_eye obs_get_render_eye(void)
+{
+	return obs ? (enum obs_render_eye)(obs->video.render_eye_pass - 1) : OBS_RENDER_EYE_NONE;
+}
