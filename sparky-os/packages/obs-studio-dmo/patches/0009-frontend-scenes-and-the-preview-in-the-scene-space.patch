diff --git a/frontend/utility/StereoScene.hpp b/frontend/utility/StereoScene.hpp
new file mode 100644
index 0000000..fdfd5f2
--- /dev/null
+++ b/frontend/utility/StereoScene.hpp
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <obs.h>
+
+/* The main canvas's scene space, where scenes are laid out and the preview places them: one eye of a side by side
+ * canvas, which libobs draws once per eye (obs_get_video_eye_size()), else the canvas itself. Outputs and encoders keep
+ * the canvas's whole size. */
+static inline uint32_t SceneCX()
+{
+	uint32_t cx = 0;
+	obs_get_video_eye_size(&cx, nullptr);
+	return cx;
+}
+
+static inline uint32_t SceneCY()
+{
+	uint32_t cy = 0;
+	obs_get_video_eye_size(nullptr, &cy);
+	return cy;
+}
