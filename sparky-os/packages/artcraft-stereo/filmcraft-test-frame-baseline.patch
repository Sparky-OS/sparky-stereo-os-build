Description: Snapshot frame count before the sequence-change command
 The command pumps the UI and may already deliver the 2D frame. Taking
 the baseline afterwards can wait for an extra frame that is not needed.
 Keep the geometry and mono-mark assertions unchanged.
Author: Daniel Ramos (Capitain Jack)
Forwarded: no

--- a/crates/ui-egui/tests/stereo_monitor_ui.rs
+++ b/crates/ui-egui/tests/stereo_monitor_ui.rs
@@ -184,8 +184,8 @@
     assert!(d.log.lock().unwrap().shown[0].3);
     // a new 2D sequence becomes the active one; the window follows it and the picture says 2D,
     // which is what keeps the window from declaring it
+    let before = d.log.lock().unwrap().shown.len();
     d.exec("file.newSequence", json!({"name": "Flat", "width": 128, "height": 36, "stereo": false}));
-    let before = d.log.lock().unwrap().shown.len();
     d.until_shown(before + 1);
     let last = *d.log.lock().unwrap().shown.last().unwrap();
     assert_eq!(last, (128, 36, 128 * 36 * 4, false));
