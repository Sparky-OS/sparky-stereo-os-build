#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export QT_QPA_PLATFORM = offscreen
export CAPTIOND_TEST_MODEL =
export CAPTIOND_TEST_VAD_MODEL =

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DKAPTION_BUNDLED_CORE=OFF -DKAPTION_BUILD_KDE=ON -DKAPTION_BUILD_QT=ON -DKAPTION_KI18N=ON

override_dh_auto_test:
	cd obj-* && ctest --output-on-failure -j2 -LE model
