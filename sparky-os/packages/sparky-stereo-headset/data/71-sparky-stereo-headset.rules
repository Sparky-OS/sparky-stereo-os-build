# Start the headset service of the person at the seat when a headset that HeadsetControl supports appears.
# Written by tools/make-rules.sh from `headsetcontrol -u` (the program carries the list); do not edit by hand.
ACTION!="add", GOTO="sparky_headset_end"
SUBSYSTEM!="hidraw", GOTO="sparky_headset_end"

# Logitech ASTRO A50 Gen 4
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="9886", ATTRS{idProduct}=="002c", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="sparky-stereo-headset.service"

# Logitech ASTRO A50 Gen 5
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0b1c", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="sparky-stereo-headset.service"

# Logitech G522 LIGHTSPEED
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0b18", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="sparky-stereo-headset.service"

