# THE REAL headsetcontrol on its own built-in test device (`--test-device`): every capability, its JSON and its option parsing are the
# program's; only the HID device is not there. Used to show the page with all the controls a headset can have.
exec /usr/bin/headsetcontrol --test-device "$@"
