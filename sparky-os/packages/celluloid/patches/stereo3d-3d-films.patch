+
+#define STEREO_KEY "celluloid-stereo"
+#define HALVES_TRIES 3
+#define HALVES_ASKS 10
+#define HALVES_WIDTH 640
+
+/* The packings a film can come in, with the words the edition's stereo layer
+ * shows for them (Stereo::FileChoiceMenu), the value of mpv's
+ * video-stereo-input for views squeezed into the frame and for views at
+ * their own size, and the stereo policy's layout for the save into the file.
+ *
+ * The list follows H.264 Table D-9 and H.265 Table D.8 (frame packing
+ * arrangement types 0 to 5 with quincunx sampling), RFC 9559 section
+ * 5.1.4.1.28.3 (StereoMode 1 to 14) and the layer's depth layouts. mpv takes
+ * every packing apart; nothing here decodes.
+ */
+enum
+{
+	GROUP_TOP,
+	GROUP_WHOLE,
+	GROUP_INTERLEAVED,
+	GROUP_SEQUENCE,
+	GROUP_ANAGLYPH,
+	GROUP_DEPTH,
+	GROUP_N
+};
+
+typedef struct
+{
+	const gchar *word;
+	const gchar *label;
+	const gchar *half;
+	const gchar *full;
+	gint group;
+	gint layout;
+	gint order;
+	gint anaglyph;
+}
+StereoInput;
+
+static const StereoInput inputs[] =
+{
+	{"automatic", NC_("Stereo::FileChoiceMenu", "Automatic"), "no", "no", GROUP_TOP, STEREO_POLICY_LAYOUT_NONE, 0, 0},
+	{"mono", NC_("Stereo::FileChoiceMenu", "Not 3D"), "mono", "mono", GROUP_TOP, STEREO_POLICY_LAYOUT_NONE, 0, 0},
+	{"sideBySideLeftFirst", NC_("Stereo::FileChoiceMenu", "Side by side, left eye first"), "sbs2l", "sbsl", GROUP_WHOLE, STEREO_POLICY_LAYOUT_SIDE_BY_SIDE, STEREO_POLICY_LEFT_FIRST, 0},
+	{"sideBySideRightFirst", NC_("Stereo::FileChoiceMenu", "Side by side, right eye first"), "sbs2r", "sbsr", GROUP_WHOLE, STEREO_POLICY_LAYOUT_SIDE_BY_SIDE, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"topBottomLeftFirst", NC_("Stereo::FileChoiceMenu", "Top and bottom, left eye first"), "ab2l", "abl", GROUP_WHOLE, STEREO_POLICY_LAYOUT_TOP_AND_BOTTOM, STEREO_POLICY_LEFT_FIRST, 0},
+	{"topBottomRightFirst", NC_("Stereo::FileChoiceMenu", "Top and bottom, right eye first"), "ab2r", "abr", GROUP_WHOLE, STEREO_POLICY_LAYOUT_TOP_AND_BOTTOM, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"rowInterleavedLeftFirst", NC_("Stereo::FileChoiceMenu", "Rows, left eye first"), "irl", "irl", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_ROWS, STEREO_POLICY_LEFT_FIRST, 0},
+	{"rowInterleavedRightFirst", NC_("Stereo::FileChoiceMenu", "Rows, right eye first"), "irr", "irr", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_ROWS, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"columnInterleavedLeftFirst", NC_("Stereo::FileChoiceMenu", "Columns, left eye first"), "icl", "icl", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_COLUMNS, STEREO_POLICY_LEFT_FIRST, 0},
+	{"columnInterleavedRightFirst", NC_("Stereo::FileChoiceMenu", "Columns, right eye first"), "icr", "icr", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_COLUMNS, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"checkerboardLeftFirst", NC_("Stereo::FileChoiceMenu", "Checkerboard, left eye first"), "checkl", "checkl", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_CHECKERBOARD, STEREO_POLICY_LEFT_FIRST, 0},
+	{"checkerboardRightFirst", NC_("Stereo::FileChoiceMenu", "Checkerboard, right eye first"), "checkr", "checkr", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_CHECKERBOARD, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"sideBySideQuincunxLeftFirst", NC_("Stereo::FileChoiceMenu", "Side by side quincunx, left eye first"), "sbs2l", "sbsl", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_SIDE_BY_SIDE_QUINCUNX, STEREO_POLICY_LEFT_FIRST, 0},
+	{"sideBySideQuincunxRightFirst", NC_("Stereo::FileChoiceMenu", "Side by side quincunx, right eye first"), "sbs2r", "sbsr", GROUP_INTERLEAVED, STEREO_POLICY_LAYOUT_SIDE_BY_SIDE_QUINCUNX, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"frameSequentialLeftFirst", NC_("Stereo::FileChoiceMenu", "Frames in turn, left eye first"), "al", "al", GROUP_SEQUENCE, STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL, STEREO_POLICY_LEFT_FIRST, 0},
+	{"frameSequentialRightFirst", NC_("Stereo::FileChoiceMenu", "Frames in turn, right eye first"), "ar", "ar", GROUP_SEQUENCE, STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"blockLacedLeftFirst", NC_("Stereo::FileChoiceMenu", "Both views in one block, left eye first"), "al", "al", GROUP_SEQUENCE, STEREO_POLICY_LAYOUT_BLOCK_LACED, STEREO_POLICY_LEFT_FIRST, 0},
+	{"blockLacedRightFirst", NC_("Stereo::FileChoiceMenu", "Both views in one block, right eye first"), "ar", "ar", GROUP_SEQUENCE, STEREO_POLICY_LAYOUT_BLOCK_LACED, STEREO_POLICY_RIGHT_FIRST, 0},
+	{"anaglyphCyanRed", NC_("Stereo::FileChoiceMenu", "Red/cyan"), "arcc", "arcc", GROUP_ANAGLYPH, STEREO_POLICY_LAYOUT_NONE, 0, STEREO_POLICY_ANAGLYPH_RED_CYAN},
+	{"anaglyphGreenMagenta", NC_("Stereo::FileChoiceMenu", "Green/magenta"), "agmc", "agmc", GROUP_ANAGLYPH, STEREO_POLICY_LAYOUT_NONE, 0, STEREO_POLICY_ANAGLYPH_GREEN_MAGENTA},
+	{"depthSideBySidePictureFirst", NC_("Stereo::FileChoiceMenu", "Side by side, picture first"), "depth-sbs", "depth-sbs", GROUP_DEPTH, STEREO_POLICY_LAYOUT_DEPTH_SIDE_BY_SIDE, STEREO_POLICY_PICTURE_FIRST, 0},
+	{"depthSideBySideDepthFirst", NC_("Stereo::FileChoiceMenu", "Side by side, depth first"), "depth-sbs-depth-first", "depth-sbs-depth-first", GROUP_DEPTH, STEREO_POLICY_LAYOUT_DEPTH_SIDE_BY_SIDE, STEREO_POLICY_DEPTH_FIRST, 0},
+	{"depthTopBottomPictureFirst", NC_("Stereo::FileChoiceMenu", "Top and bottom, picture first"), "depth-ab", "depth-ab", GROUP_DEPTH, STEREO_POLICY_LAYOUT_DEPTH_TOP_AND_BOTTOM, STEREO_POLICY_PICTURE_FIRST, 0},
+	{"depthTopBottomDepthFirst", NC_("Stereo::FileChoiceMenu", "Top and bottom, depth first"), "depth-ab-depth-first", "depth-ab-depth-first", GROUP_DEPTH, STEREO_POLICY_LAYOUT_DEPTH_TOP_AND_BOTTOM, STEREO_POLICY_DEPTH_FIRST, 0},
+	{"depthGraphicsTopBottom", NC_("Stereo::FileChoiceMenu", "Four rows: picture, depth, graphics, graphics depth"), "depth-graphics", "depth-graphics", GROUP_DEPTH, STEREO_POLICY_LAYOUT_DEPTH_GRAPHICS, 0, 0},
+	{"depthBackgroundQuarters", NC_("Stereo::FileChoiceMenu", "Four quarters: picture, depth, background, background depth"), "depth-background", "depth-background", GROUP_DEPTH, STEREO_POLICY_LAYOUT_DEPTH_BACKGROUND, 0, 0},
+};
+
+static const gchar *const group_titles[GROUP_N] =
+{
+	NULL,
+	NULL,
+	NC_("Stereo::FileChoiceMenu", "Interleaved"),
+	NC_("Stereo::FileChoiceMenu", "One view after the other"),
+	NC_("Stereo::FileChoiceMenu", "Anaglyph"),
+	NC_("Stereo::FileChoiceMenu", "Picture and depth"),
+};
+
+#define LAYER(text) g_dpgettext2(NULL, "Stereo::FileChoiceMenu", (text))
+
+typedef struct
+{
+	CelluloidController *controller;
+	GSettings *settings;
+	GtkGLArea *area;
+
+	/* What mpv said at the last frame: whether its render API draws one
+	 * view per call, and how many views the film's frames hold. */
+	gboolean supported;
+	gint views;
+
+	/* What the video area is asked for, applied outside its render */
+	gboolean want_stereo;
+	gint want_width;
+	gint want_height;
+	guint apply_id;
+	guint state_id;
+
+	/* The person's corrections of the playing film */
+	const StereoInput *input;
+	gboolean swap;
+
+	/* A film that shows flat and could be a pair, by its shape or by its
+	 * two halves (the stereo policy's rules) */
+	gboolean could_be_pair;
+	gint halves_tries;
+	gint halves_asks;
+	guint halves_id;
+	gboolean want_picture;
+
+	/* The sizes last written to the debug log */
+	gint traced_width;
+	gint traced_height;
+	gint traced_shown_width;
+	gint traced_shown_height;
+
+	gboolean failure_told;
+	gboolean fitted;
+}
+CelluloidStereo;
+
+static void
+look_for_a_pair(CelluloidStereo *stereo);
+
+static gboolean
+look_again(gpointer data);
+
+static gboolean
+update_state_idle(gpointer data);
+
+static CelluloidStereo *
+get_stereo(CelluloidController *controller)
+{
+	return g_object_get_data(G_OBJECT(controller), STEREO_KEY);
+}
+
+static CelluloidMpv *
+get_mpv(CelluloidStereo *stereo)
+{
+	return CELLULOID_MPV(stereo->controller->model);
+}
+
+static GActionMap *
+get_action_map(CelluloidStereo *stereo)
+{
+	return	G_ACTION_MAP
+		(celluloid_view_get_main_window(stereo->controller->view));
+}
+
+static const StereoInput *
+input_from_word(const gchar *word)
+{
+	for(guint i = 0; i < G_N_ELEMENTS(inputs); i++)
+	{
+		if(g_strcmp0(inputs[i].word, word) == 0)
+		{
+			return &inputs[i];
+		}
+	}
+
+	return NULL;
+}
+
+static const StereoInput *
+input_from_mpv(const gchar *value)
+{
+	for(guint i = 0; value && i < G_N_ELEMENTS(inputs); i++)
+	{
+		if(	g_strcmp0(inputs[i].half, value) == 0 ||
+			g_strcmp0(inputs[i].full, value) == 0 )
+		{
+			return &inputs[i];
+		}
+	}
+
+	return &inputs[0];
+}
+
+/* Whether the film is shown with one view to each eye: its frames hold two
+ * views, 3D is enabled, and the video area has not said that it cannot.
+ */
+static gboolean
+shown_in_3d(CelluloidStereo *stereo)
+{
+	return	stereo->supported &&
+		stereo->views == 2 &&
+		g_settings_get_boolean(stereo->settings, "stereo-enable") &&
+		gtk_gl_area_get_stereo_error(stereo->area) == NULL;
+}
+
+static gboolean
+has_correction(CelluloidStereo *stereo)
+{
+	return stereo->input != &inputs[0] || stereo->swap;
+}
+
+static void
+set_action_enabled(CelluloidStereo *stereo, const gchar *name, gboolean enabled)
+{
+	GAction *action = g_action_map_lookup_action(get_action_map(stereo), name);
+
+	if(action)
+	{
+		g_simple_action_set_enabled(G_SIMPLE_ACTION(action), enabled);
+	}
+}
+
+static void
+set_action_state(CelluloidStereo *stereo, const gchar *name, GVariant *state)
+{
+	GAction *action = g_action_map_lookup_action(get_action_map(stereo), name);
+
+	if(action)
+	{
+		g_simple_action_set_state(G_SIMPLE_ACTION(action), state);
+	}
+	else
+	{
+		g_variant_unref(g_variant_ref_sink(state));
+	}
+}
+
+/* The input format is offered for a film shown in 3D, for a film that has a
+ * correction, and for a film that shows flat and could be a pair. The swap
+ * and the save are corrections of what is shown in 3D, and are not offered on
+ * a flat picture.
+ */
+static void
+update_actions(CelluloidStereo *stereo)
+{
+	const gboolean shown = shown_in_3d(stereo);
+	const gboolean offered =	stereo->supported &&
+					(	stereo->views == 2 ||
+						has_correction(stereo) ||
+						stereo->could_be_pair );
+
+	set_action_enabled(stereo, "stereo-input", offered);
+	set_action_enabled(stereo, "stereo-input-offered", offered);
+	set_action_enabled(stereo, "stereo-swap", shown);
+	set_action_enabled(stereo, "stereo-save", shown && has_correction(stereo));
+	set_action_state
+		(stereo, "stereo-input", g_variant_new_string(stereo->input->word));
+	set_action_state
+		(stereo, "stereo-swap", g_variant_new_boolean(stereo->swap));
+	set_action_state
+		(	stereo,
+			"stereo-enable",
+			g_variant_new_boolean
+			(g_settings_get_boolean(stereo->settings, "stereo-enable")) );
+}
+
+static gboolean
+update_state_idle(gpointer data)
+{
+	CelluloidStereo *stereo = data;
+
+	stereo->state_id = 0;
+
+	/* The window was fitted to the film before its frames were known to
+	 * hold two views: it is fitted again, to one view. */
+	if(stereo->views == 2 && !stereo->fitted)
+	{
+		stereo->fitted = TRUE;
+		g_signal_emit_by_name(stereo->controller->model, "autofit");
+	}
+	else if(stereo->views != 2)
+	{
+		stereo->fitted = FALSE;
+	}
+
+	look_for_a_pair(stereo);
+	update_actions(stereo);
+
+	return G_SOURCE_REMOVE;
+}
+
+static gboolean
+apply_idle(gpointer data)
+{
+	CelluloidStereo *stereo = data;
+	GtkGLArea *area = stereo->area;
+
+	stereo->apply_id = 0;
+
+	if(stereo->want_stereo)
+	{
+		gtk_gl_area_set_stereo_view_size
+			(area, stereo->want_width, stereo->want_height);
+	}
+
+	if(gtk_gl_area_get_stereo(area) != stereo->want_stereo)
+	{
+		stereo->failure_told = FALSE;
+		gtk_gl_area_set_stereo(area, stereo->want_stereo);
+	}
+
+	gtk_gl_area_queue_render(area);
+
+	return G_SOURCE_REMOVE;
+}
+
+/* The video area cannot show the two views, one to each eye: the person is
+ * told once for the film, and the area shows the left view.
+ */
+static void
+stereo_error_handler(GObject *object, GParamSpec *pspec, gpointer data)
+{
+	CelluloidStereo *stereo = data;
+	const GError *error = gtk_gl_area_get_stereo_error(GTK_GL_AREA(object));
+
+	update_actions(stereo);
+
+	if(error && !stereo->failure_told)
+	{
+		stereo->failure_told = TRUE;
+		g_warning("The film cannot be shown in 3D: %s", error->message);
+		celluloid_view_show_message_toast
+			(	stereo->controller->view,
+				_("This film cannot be shown in 3D on this screen. It is shown flat.") );
+	}
+}
+
+static gboolean
+get_int_property(CelluloidStereo *stereo, const gchar *name, gint64 *value)
+{
+	return	celluloid_mpv_get_property
+		(get_mpv(stereo), name, MPV_FORMAT_INT64, value) >= 0;
+}
+
+/* The shape of one view decides between squeezed and whole views of a side by
+ * side or top and bottom frame chosen by hand, as the stereo policy decides it
+ * for a marked one: the person never chooses half or full.
+ */
+static gboolean
+full_views(CelluloidStereo *stereo, const StereoInput *input)
+{
+	gint64 dw = 0;
+	gint64 dh = 0;
+
+	if(	input->half == input->full ||
+		!get_int_property(stereo, "video-params/dw", &dw) ||
+		!get_int_property(stereo, "video-params/dh", &dh) )
+	{
+		return FALSE;
+	}
+
+	return	stereo_policy_video_views_by_shape
+		((int)dw, (int)dh, input->layout == STEREO_POLICY_LAYOUT_SIDE_BY_SIDE_QUINCUNX ? STEREO_POLICY_LAYOUT_SIDE_BY_SIDE : input->layout) == 1;
+}
+
+/* The corrections are kept where mpv keeps what it remembers of a file, its
+ * watch-later entry, beside the position to resume from, and never in the
+ * film: the entry is written when a correction is in effect and removed when
+ * none is. mpv removes an entry when it resumes from it, so the entry is
+ * written again once the film is loaded. Only the corrections are written
+ * here; the position is mpv's to save, when the person asked for that.
+ */
+static void
+keep_corrections(CelluloidStereo *stereo)
+{
+	CelluloidMpv *mpv = get_mpv(stereo);
+
+	if(has_correction(stereo))
+	{
+		gchar *options =	celluloid_mpv_get_property_string
+					(mpv, "watch-later-options");
+
+		celluloid_mpv_set_property_string
+			(	mpv,
+				"watch-later-options",
+				"video-stereo-input,video-stereo-swap" );
+		celluloid_mpv_command_string(mpv, "write-watch-later-config");
+
+		if(options)
+		{
+			celluloid_mpv_set_property_string
+				(mpv, "watch-later-options", options);
+			mpv_free(options);
+		}
+	}
+	else
+	{
+		celluloid_mpv_command_string(mpv, "delete-watch-later-config");
+	}
+}
+
+static void
+apply_corrections(CelluloidStereo *stereo)
+{
+	CelluloidMpv *mpv = get_mpv(stereo);
+	const StereoInput *input = stereo->input;
+
+	celluloid_mpv_set_property_string
+		(	mpv,
+			"video-stereo-input",
+			full_views(stereo, input) ? input->full : input->half );
+	celluloid_mpv_set_property_flag(mpv, "video-stereo-swap", stereo->swap);
+	keep_corrections(stereo);
+	update_actions(stereo);
+}
+
+/* A film that says nothing and shows flat: whether its picture is two similar
+ * halves, by the stereo policy's test. The picture is the one just drawn into
+ * the bound framebuffer, read back once: mpv cannot hand over a frame that
+ * the machine's decoder keeps in the graphics card's memory. Called from the
+ * video area's render, with its OpenGL context current.
+ */
+static void
+test_drawn_picture(CelluloidStereo *stereo, gint framebuffer, gint width, gint height)
+{
+	const gint step = MAX(1, width/HALVES_WIDTH);
+	const gint luma_width = width/step;
+	const gint luma_height = height/step;
+	guint8 *pixels = NULL;
+	guint8 *luma = NULL;
+	gint halves = STEREO_POLICY_HALVES_UNKNOWN;
+
+	stereo->want_picture = FALSE;
+
+	if(luma_width < 16 || luma_height < 16)
+	{
+		return;
+	}
+
+	pixels = g_malloc((gsize)width*(gsize)height*4);
+	luma = g_malloc((gsize)luma_width*(gsize)luma_height);
+	/* mpv leaves its own framebuffers bound for reading */
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)framebuffer);
+	glReadBuffer(GL_COLOR_ATTACHMENT0);
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+
+	for(gint y = 0; y < luma_height; y++)
+	{
+		const guint8 *row = pixels+(gsize)(y*step)*(gsize)width*4;
+
+		for(gint x = 0; x < luma_width; x++)
+		{
+			const guint8 *pixel = row+4*x*step;
+
+			luma[y*luma_width+x] =
+				(guint8)((77*pixel[0]+150*pixel[1]+29*pixel[2])>>8);
+		}
+	}
+
+	halves = stereo_policy_halves_test(luma, luma_width, luma_height, luma_width);
+	stereo->halves_tries++;
+	stereo->could_be_pair = halves != STEREO_POLICY_HALVES_UNKNOWN;
+	g_debug(	"The halves of the film's picture (%dx%d): %s",
+			luma_width,
+			luma_height,
+			halves == STEREO_POLICY_HALVES_SIDE_BY_SIDE ?
+			"alike side by side" :
+			halves == STEREO_POLICY_HALVES_TOP_AND_BOTTOM ?
+			"alike top and bottom" :
+			"not alike" );
+	g_free(luma);
+	g_free(pixels);
+
+	if(stereo->could_be_pair && stereo->state_id == 0)
+	{
+		stereo->state_id = g_idle_add(update_state_idle, stereo);
+	}
+}
+
+static void
+look_for_a_pair(CelluloidStereo *stereo)
+{
+	gint64 dw = 0;
+	gint64 dh = 0;
+
+	g_debug(	"Looking for a pair: views %d, supported %d, tries %d, found %d",
+			stereo->views,
+			stereo->supported,
+			stereo->halves_tries,
+			stereo->could_be_pair );
+
+	if(stereo->could_be_pair || stereo->views != 1 || !stereo->supported)
+	{
+		return;
+	}
+
+	if(	get_int_property(stereo, "video-params/dw", &dw) &&
+		get_int_property(stereo, "video-params/dh", &dh) &&
+		stereo_policy_video_side_by_side_by_shape((int)dw, (int)dh) == 1 )
+	{
+		stereo->could_be_pair = TRUE;
+	}
+	else if(stereo->halves_tries < HALVES_TRIES)
+	{
+		/* the next picture the video area draws is looked at */
+		stereo->want_picture = TRUE;
+		gtk_gl_area_queue_render(stereo->area);
+	}
+
+	if(stereo->could_be_pair)
+	{
+		update_actions(stereo);
+	}
+	else if(	stereo->halves_tries < HALVES_TRIES &&
+			stereo->halves_asks++ < HALVES_ASKS &&
+			stereo->halves_id == 0 )
+	{
+		/* the film's first picture may not be there yet, or may be
+		 * a black lead-in that says nothing: look again in a moment */
+		stereo->halves_id = g_timeout_add_seconds(1, look_again, stereo);
+	}
+}
+
+static gboolean
+look_again(gpointer data)
+{
+	CelluloidStereo *stereo = data;
+
+	stereo->halves_id = 0;
+	look_for_a_pair(stereo);
+
+	return G_SOURCE_REMOVE;
+}
+
+/* A film with a picture and no audio track says so, beside a volume control
+ * that stays usable: the sentence and the rule of the edition's stereo layer
+ * (Stereo::NoSound).
+ */
+static void
+tell_no_sound(CelluloidStereo *stereo)
+{
+	CelluloidMpv *mpv = get_mpv(stereo);
+	gint64 count = 0;
+	gboolean picture = FALSE;
+	gboolean sound = FALSE;
+
+	get_int_property(stereo, "track-list/count", &count);
+
+	for(gint64 i = 0; i < count; i++)
+	{
+		gchar *name = g_strdup_printf("track-list/%" G_GINT64_FORMAT "/type", i);
+		gchar *type = celluloid_mpv_get_property_string(mpv, name);
+
+		if(g_strcmp0(type, "audio") == 0)
+		{
+			sound = TRUE;
+		}
+		else if(g_strcmp0(type, "video") == 0)
+		{
+			gchar *art = g_strdup_printf("track-list/%" G_GINT64_FORMAT "/albumart", i);
+
+			picture |= !celluloid_mpv_get_property_flag(mpv, art);
+			g_free(art);
+		}
+
+		mpv_free(type);
+		g_free(name);
+	}
+
+	if(picture && !sound)
+	{
+		const gchar *sentence =
+			g_dpgettext2(NULL, "Stereo::NoSound", NC_("Stereo::NoSound", "This film has no sound."));
+
+		g_debug("Told the person: %s", sentence);
+		celluloid_view_show_message_toast(stereo->controller->view, sentence);
+	}
+}
+
+static void
+file_loaded(CelluloidStereo *stereo)
+{
+	CelluloidMpv *mpv = get_mpv(stereo);
+	gchar *value = celluloid_mpv_get_property_string(mpv, "video-stereo-input");
+
+	/* What mpv took from the film's watch-later entry is the person's
+	 * correction of this film */
+	stereo->input = input_from_mpv(value);
+	stereo->swap = celluloid_mpv_get_property_flag(mpv, "video-stereo-swap");
+	stereo->could_be_pair = FALSE;
+	stereo->halves_tries = 0;
+	stereo->halves_asks = 0;
+	stereo->want_picture = FALSE;
+	stereo->failure_told = FALSE;
+	stereo->fitted = FALSE;
+	mpv_free(value);
+
+	if(has_correction(stereo))
+	{
+		keep_corrections(stereo);
+	}
+
+	tell_no_sound(stereo);
+	update_actions(stereo);
+}
+
+static void
+mpv_event_handler(CelluloidMpv *mpv, gint event_id, gpointer event_data, gpointer data)
+{
+	if(event_id == MPV_EVENT_FILE_LOADED)
+	{
+		file_loaded(data);
+	}
+	else if(event_id == MPV_EVENT_PLAYBACK_RESTART)
+	{
+		CelluloidStereo *stereo = data;
+
+		/* after a seek the picture is another one: one more look, so
+		 * that a film with a black lead-in can still be found a pair */
+		stereo->halves_tries = MIN(stereo->halves_tries, HALVES_TRIES-1);
+		stereo->halves_asks = 0;
+		look_for_a_pair(stereo);
+	}
+}
+
+static void
+enable_handler(GSimpleAction *action, GVariant *value, gpointer data)
+{
+	CelluloidStereo *stereo = get_stereo(data);
+
+	g_settings_set_boolean
+		(stereo->settings, "stereo-enable", g_variant_get_boolean(value));
+	g_simple_action_set_state(action, value);
+	update_actions(stereo);
+	gtk_gl_area_queue_render(stereo->area);
+}
+
+static void
+input_handler(GSimpleAction *action, GVariant *value, gpointer data)
+{
+	CelluloidStereo *stereo = get_stereo(data);
+	const StereoInput *input = input_from_word(g_variant_get_string(value, NULL));
+
+	if(input)
+	{
+		stereo->input = input;
+		apply_corrections(stereo);
+	}
+}
+
+static void
+swap_handler(GSimpleAction *action, GVariant *value, gpointer data)
+{
+	CelluloidStereo *stereo = get_stereo(data);
+
+	stereo->swap = g_variant_get_boolean(value);
+	apply_corrections(stereo);
+}
+
+static void
+display_settings_handler(GSimpleAction *action, GVariant *param, gpointer data)
+{
+	CelluloidStereo *stereo = get_stereo(data);
+	GError *error = NULL;
+
+	if(!g_spawn_command_line_async("kcmshell6 kcm_kscreen", &error))
+	{
+		g_warning("Display Settings could not be opened: %s", error->message);
+		celluloid_view_show_message_toast
+			(	stereo->controller->view,
+				_("Display Settings could not be opened.") );
+		g_clear_error(&error);
+	}
+}
+
+static gchar *
+playing_file(CelluloidStereo *stereo)
+{
+	CelluloidMpv *mpv = get_mpv(stereo);
+	gchar *path = celluloid_mpv_get_property_string(mpv, "path");
+	gchar *result = NULL;
+
+	if(path && g_str_has_prefix(path, "file://"))
+	{
+		result = g_filename_from_uri(path, NULL, NULL);
+	}
+	else if(path && !strstr(path, "://"))
+	{
+		gchar *directory =	celluloid_mpv_get_property_string
+					(mpv, "working-directory");
+
+		result = g_canonicalize_filename(path, directory);
+		mpv_free(directory);
+	}
+
+	mpv_free(path);
+
+	return result;
+}
+
+/* What the film is with the corrections applied: the packing chosen by hand,
+ * or else the one mpv read from the film, with the eye order the swap gives.
+ */
+static gboolean
+corrected_layout(	CelluloidStereo *stereo,
+			gint *layout,
+			gint *order,
+			gint *anaglyph,
+			gint *views )
+{
+	const StereoInput *input = stereo->input;
+
+	*views = STEREO_MARK_VIEWS_UNSPECIFIED;
+
+	if(input == &inputs[0])
+	{
+		gchar *value =	celluloid_mpv_get_property_string
+				(get_mpv(stereo), "video-params/stereo-in");
+
+		input = input_from_mpv(value);
+		mpv_free(value);
+
+		if(input == &inputs[0])
+		{
+			return FALSE;
+		}
+	}
+	else if(input->half != input->full)
+	{
+		*views =	full_views(stereo, input) ?
+				STEREO_MARK_VIEWS_FULL :
+				STEREO_MARK_VIEWS_HALF;
+	}
+
+	*layout = input->layout;
+	*order = input->order;
+	*anaglyph = input->anaglyph;
+
+	if(	stereo->swap &&
+		input->anaglyph == STEREO_POLICY_ANAGLYPH_NONE &&
+		!stereo_policy_is_depth_layout(input->layout) &&
+		input->layout != STEREO_POLICY_LAYOUT_NONE )
+	{
+		*order =	*order == STEREO_POLICY_LEFT_FIRST ?
+				STEREO_POLICY_RIGHT_FIRST :
+				STEREO_POLICY_LEFT_FIRST;
+	}
+	else if(stereo->swap)
+	{
+		/* a layout that has no eye order to write */
+		return FALSE;
+	}
+
+	return TRUE;
+}
+
+static const gchar *
+refusal_reason(gint status)
+{
+	switch(status)
+	{
+		case STEREO_MARK_NOT_LOCAL:
+		return _("it is not a file on this computer");
+
+		case STEREO_MARK_STREAM_DECLARES:
+		return _("its video stream declares its own 3D format, which comes first");
+
+		case STEREO_MARK_CONTAINER:
+		case STEREO_MARK_LAYOUT:
+		case STEREO_MARK_WEBM_LAYOUT:
+		case STEREO_MARK_MP4_DEPTH:
+		case STEREO_MARK_MP4_NO_ROOM:
+		case STEREO_MARK_MP4_ENTRIES:
+		case STEREO_MARK_NOT_LACED:
+		return _("this kind of file cannot hold this 3D format");
+
+		case STEREO_MARK_TOOL_MISSING:
+		return _("mkvpropedit is not installed");
+
+		default:
+		return _("the file could not be written");
+	}
+}
+
+/* The person chose to save: the film's own mark is written by the stereo
+ * layer's writer, which reads every write back and puts a failed one back.
+ * The film then carries the correction: the corrections are unmarked, their
+ * entry is removed, and the film is loaded again from where it was, so that
+ * what is shown comes from the film's own mark.
+ */
+static void
+save_handler(GSimpleAction *action, GVariant *param, gpointer data)
+{
+	CelluloidStereo *stereo = get_stereo(data);
+	CelluloidMpv *mpv = get_mpv(stereo);
+	gchar *path = playing_file(stereo);
+	gchar *name = path ? g_path_get_basename(path) : g_strdup("");
+	gint layout = STEREO_POLICY_LAYOUT_NONE;
+	gint order = STEREO_POLICY_LEFT_FIRST;
+	gint anaglyph = STEREO_POLICY_ANAGLYPH_NONE;
+	gint views = STEREO_MARK_VIEWS_UNSPECIFIED;
+	gint status = STEREO_MARK_LAYOUT;
+	stereo_mark_views_result result = {0};
+
+	if(!path)
+	{
+		status = STEREO_MARK_NOT_LOCAL;
+	}
+	else if(corrected_layout(stereo, &layout, &order, &anaglyph, &views))
+	{
+		status =	stereo_mark_save_views
+				(path, 1, layout, order, anaglyph, views, &result);
+
+		if(status == STEREO_MARK_MP4_VIEWS || status == STEREO_MARK_VIEWS_LAYOUT)
+		{
+			/* a mark that says the packing and the eye order only */
+			status =	stereo_mark_save
+					(path, 1, layout, order, anaglyph, &result.base);
+		}
+	}
+
+	if(status == STEREO_MARK_WRITTEN || status == STEREO_MARK_UNCHANGED)
+	{
+		gchar *options =	celluloid_mpv_get_property_string
+					(mpv, "watch-later-options");
+		gchar *message =	g_strdup_printf
+					(_("The correction was saved into %s."), name);
+
+		stereo->input = &inputs[0];
+		stereo->swap = FALSE;
+		celluloid_mpv_set_property_string(mpv, "video-stereo-input", "no");
+		celluloid_mpv_set_property_flag(mpv, "video-stereo-swap", FALSE);
+
+		/* load the film again from this position: the position alone
+		 * goes through the entry, which mpv removes as it resumes */
+		celluloid_mpv_set_property_string(mpv, "watch-later-options", "start");
+		celluloid_mpv_command_string(mpv, "write-watch-later-config");
+
+		if(options)
+		{
+			celluloid_mpv_set_property_string
+				(mpv, "watch-later-options", options);
+			mpv_free(options);
+		}
+
+		celluloid_mpv_command_string(mpv, "playlist-play-index current");
+		celluloid_view_show_message_toast(stereo->controller->view, message);
+		update_actions(stereo);
+		g_free(message);
+	}
+	else
+	{
+		gchar *message =	g_strdup_printf
+					(	_("%1$s was not changed and its correction is kept: %2$s"),
+						name,
+						refusal_reason(status) );
+
+		g_warning(	"The correction was not saved into %s: %s %s",
+				path ?: "(no file)",
+				stereo_mark_status_name(status),
+				result.base.details );
+		celluloid_view_show_message_toast(stereo->controller->view, message);
+		g_free(message);
+	}
+
+	g_free(name);
+	g_free(path);
+}
+
+static void
+stereo_free(gpointer data)
+{
+	CelluloidStereo *stereo = data;
+
+	g_clear_handle_id(&stereo->apply_id, g_source_remove);
+	g_clear_handle_id(&stereo->state_id, g_source_remove);
+	g_clear_handle_id(&stereo->halves_id, g_source_remove);
+	g_clear_object(&stereo->settings);
+	g_free(stereo);
+}
+
+void
+celluloid_stereo_attach(CelluloidController *controller)
+{
+	const GActionEntry entries[] =
+		{	{.name = "stereo-enable",
+			.state = "true",
+			.change_state = enable_handler},
+			{.name = "stereo-input",
+			.state = "'automatic'",
+			.parameter_type = "s",
+			.change_state = input_handler},
+			{.name = "stereo-input-offered"},
+			{.name = "stereo-swap",
+			.state = "false",
+			.change_state = swap_handler},
+			{.name = "stereo-save",
+			.activate = save_handler},
+			{.name = "stereo-display-settings",
+			.activate = display_settings_handler} };
+	CelluloidStereo *stereo = g_new0(CelluloidStereo, 1);
+	CelluloidMainWindow *window = celluloid_view_get_main_window(controller->view);
+
+	stereo->controller = controller;
+	stereo->settings = g_settings_new(CONFIG_ROOT);
+	stereo->area =	celluloid_video_area_get_gl_area
+			(celluloid_main_window_get_video_area(window));
+	stereo->input = &inputs[0];
+
+	g_object_set_data_full(G_OBJECT(controller), STEREO_KEY, stereo, stereo_free);
+	g_action_map_add_action_entries
+		(G_ACTION_MAP(window), entries, G_N_ELEMENTS(entries), controller);
+	g_signal_connect(	controller->model,
+				"mpv-event-notify",
+				G_CALLBACK(mpv_event_handler),
+				stereo );
+	g_signal_connect(	stereo->area,
+				"notify::stereo-error",
+				G_CALLBACK(stereo_error_handler),
+				stereo );
+
+	update_actions(stereo);
+}
+
+void
+celluloid_stereo_render(CelluloidController *controller, gint width, gint height)
+{
+	CelluloidStereo *stereo = get_stereo(controller);
+	mpv_render_context *render_ctx =
+		celluloid_mpv_get_render_context(CELLULOID_MPV(controller->model));
+	GtkGLAreaEye eye = GTK_GL_AREA_EYE_NONE;
+	gint fbo = -1;
+
+	if(!stereo || !render_ctx)
+	{
+		celluloid_model_render_frame(controller->model, width, height);
+		return;
+	}
+
+	eye = gtk_gl_area_get_current_eye(stereo->area);
+
+	/* Once for a frame, before its first view: what the film's frames hold
+	 * now, and the size of a view that holds the video area measured in the
+	 * film's own samples, so that mpv copies each view and the compositor
+	 * does the one resize */
+	if(eye != GTK_GL_AREA_EYE_RIGHT)
+	{
+		mpv_render_stereo_view info = {.shown_w = width, .shown_h = height};
+		const gboolean supported =
+			mpv_render_context_get_info
+			(	render_ctx,
+				(mpv_render_param)
+				{MPV_RENDER_PARAM_STEREO_VIEW, &info} ) >= 0;
+		const gint views = supported ? info.views : 1;
+		const gboolean want =	supported &&
+					views == 2 &&
+					info.target_w > 0 &&
+					info.target_h > 0 &&
+					g_settings_get_boolean
+					(stereo->settings, "stereo-enable");
+
+		if(supported != stereo->supported || views != stereo->views)
+		{
+			stereo->supported = supported;
+			stereo->views = views;
+
+			if(stereo->state_id == 0)
+			{
+				stereo->state_id = g_idle_add(update_state_idle, stereo);
+			}
+		}
+
+		if(	want != gtk_gl_area_get_stereo(stereo->area) ||
+			(	want &&
+				(	info.target_w != stereo->want_width ||
+					info.target_h != stereo->want_height ) ) )
+		{
+			stereo->want_stereo = want;
+			stereo->want_width = info.target_w;
+			stereo->want_height = info.target_h;
+
+			if(stereo->apply_id == 0)
+			{
+				stereo->apply_id = g_idle_add(apply_idle, stereo);
+			}
+		}
+	}
+
+	if(stereo->supported && stereo->views == 2)
+	{
+		mpv_render_stereo_view view =
+			{	.view = eye == GTK_GL_AREA_EYE_RIGHT ? 2 : 1,
+				.shown_w = width,
+				.shown_h = height };
+		gint target_width = width;
+		gint target_height = height;
+
+		/* an area that asks for stereo has the viewport of the
+		 * framebuffer it gives each view */
+		if(gtk_gl_area_get_stereo(stereo->area))
+		{
+			gint viewport[4] = {0, 0, width, height};
+
+			glGetIntegerv(GL_VIEWPORT, viewport);
+			target_width = viewport[2];
+			target_height = viewport[3];
+		}
+
+		glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fbo);
+
+		if(	target_width != stereo->traced_width ||
+			target_height != stereo->traced_height ||
+			width != stereo->traced_shown_width ||
+			height != stereo->traced_shown_height )
+		{
+			stereo->traced_width = target_width;
+			stereo->traced_height = target_height;
+			stereo->traced_shown_width = width;
+			stereo->traced_shown_height = height;
+			g_debug(	"A view of %dx%d for an area of %dx%d (%s)",
+					target_width,
+					target_height,
+					width,
+					height,
+					gtk_gl_area_get_stereo_shown(stereo->area) ?
+					"one view to each eye" :
+					"the left view alone" );
+		}
+
+		mpv_opengl_fbo opengl_fbo =
+			{fbo, target_width, target_height, 0};
+		mpv_render_param params[] =
+			{	{MPV_RENDER_PARAM_OPENGL_FBO, &opengl_fbo},
+				{MPV_RENDER_PARAM_FLIP_Y, &(int){1}},
+				{MPV_RENDER_PARAM_STEREO_VIEW, &view},
+				{0, NULL} };
+
+		mpv_render_context_render(render_ctx, params);
+
+	}
+	else
+	{
+		glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fbo);
+		celluloid_model_render_frame(controller->model, width, height);
+
+		if(stereo->want_picture && stereo->views == 1 && fbo > 0)
+		{
+			test_drawn_picture(stereo, fbo, width, height);
+		}
+	}
+}
+
+static void
+append_input(GMenu *menu, const StereoInput *input)
+{
+	gchar *action = g_strdup_printf("win.stereo-input('%s')", input->word);
+
+	g_menu_append(menu, LAYER(input->label), action);
+	g_free(action);
+}
+
+static void
+append_hidden_when_disabled(GMenu *menu, const gchar *label, const gchar *action, GMenuModel *submenu)
+{
+	GMenuItem *item =	submenu ?
+				g_menu_item_new_submenu(label, submenu) :
+				g_menu_item_new(label, action);
+
+	if(submenu)
+	{
+		g_menu_item_set_attribute(item, "action", "s", action);
+	}
+
+	g_menu_item_set_attribute(item, "hidden-when", "s", "action-disabled");
+	g_menu_append_item(menu, item);
+	g_object_unref(item);
+}
+
+GMenu *
+celluloid_stereo_build_menu(void)
+{
+	GMenu *menu = g_menu_new();
+	GMenu *program = g_menu_new();
+	GMenu *film = g_menu_new();
+	GMenu *format = g_menu_new();
+	GMenu *sections[GROUP_N] = {NULL};
+
+	g_menu_append(program, LAYER(NC_("Stereo::FileChoiceMenu", "Enable 3D")), "win.stereo-enable");
+	g_menu_append(program, _("Display Settings…"), "win.stereo-display-settings");
+
+	for(guint i = 0; i < G_N_ELEMENTS(inputs); i++)
+	{
+		const gint group = inputs[i].group;
+
+		if(!sections[group])
+		{
+			sections[group] = g_menu_new();
+
+			if(group_titles[group])
+			{
+				g_menu_append_submenu
+					(	format,
+						LAYER(group_titles[group]),
+						G_MENU_MODEL(sections[group]) );
+			}
+			else
+			{
+				g_menu_append_section
+					(format, NULL, G_MENU_MODEL(sections[group]));
+			}
+		}
+
+		append_input(sections[group], &inputs[i]);
+	}
+
+	append_hidden_when_disabled
+		(	film,
+			LAYER(NC_("Stereo::FileChoiceMenu", "3D Input Format")),
+			"win.stereo-input-offered",
+			G_MENU_MODEL(format) );
+	append_hidden_when_disabled
+		(	film,
+			LAYER(NC_("Stereo::FileChoiceMenu", "Swap left and right eyes")),
+			"win.stereo-swap",
+			NULL );
+	append_hidden_when_disabled
+		(	film,
+			LAYER(NC_("Stereo::FileChoiceMenu", "Save the correction into the file")),
+			"win.stereo-save",
+			NULL );
+
+	g_menu_append_section(menu, NULL, G_MENU_MODEL(program));
+	g_menu_append_section(menu, NULL, G_MENU_MODEL(film));
+
+	for(gint i = 0; i < GROUP_N; i++)
+	{
+		g_clear_object(&sections[i]);
+	}
+
+	g_object_unref(format);
+	g_object_unref(film);
+	g_object_unref(program);
+
+	return menu;
+}
