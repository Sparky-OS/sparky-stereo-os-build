 	celluloid_mpv_get_property(mpv, "dheight", MPV_FORMAT_INT64, height);
+
+	/* mpv hands a 3D film over as its two views side by side, and the
+	 * frame then has the shape of both: the window shows one view. */
+	gchar *stereo_in =	celluloid_mpv_get_property_string
+				(mpv, "video-out-params/stereo-in");
+
+	if(g_strcmp0(stereo_in, "sbsl") == 0 && *width >= 2)
+	{
+		*width /= 2;
+	}
+
+	mpv_free(stereo_in);
 }
 
