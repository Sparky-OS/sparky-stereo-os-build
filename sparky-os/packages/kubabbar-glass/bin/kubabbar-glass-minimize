# Last update 2026/11/04
# Choose the minimise effect of Kubabbar Glass: Magic Lamp (default of the menu bar and dock layout) or Squash, both built into KWin.
# A failure to save or to apply is said and kept (sparky-stereo-problems, person scope); "done" is printed only after
# KWin itself reports the effect loaded (ORDER 346f-5, audit 343 U39). The saved setting is never replaced.
set -eu
package=sparky-stereo-look-kubabbar-glass-menubar
key=minimize

dir=/usr/share/sparky/kubabbar-glass-minimize
[ -d "$dir" ] || dir=$(dirname "$0")/../lang/minimize
code=${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}
[ -n "$code" ] || code=$(sed -n 's/^LANG=//p' /etc/default/locale 2>/dev/null | head -n 1 | tr -d '"')
code=${code%%.*}
case "$code" in
	zh_HK|zh_MO) code=zh_TW ;;
	zh_SG) code=zh_CN ;;
esac
for try in "$code" "${code%%_*}" en; do
	if [ -f "$dir/$try" ]; then . "$dir/$try"; break; fi
done

msg() {
	case "$1" in
		head) echo "$LOCAL1" ;;
		magiclamp) echo "$LOCAL2" ;;
		squash) echo "$LOCAL3" ;;
		done) echo "$LOCAL4" ;;
		unknown) echo "$LOCAL5" ;;
	esac
}

usage() {
	msg head
	for effect in magiclamp squash; do
		printf '  %-10s %s\n' "$effect" "$(msg "$effect")"
	done
}

[ $# -eq 1 ] || { usage; exit 0; }
case "$1" in
	magiclamp) lamp=true; squash=false ;;
	squash) lamp=false; squash=true ;;
	*) printf "$(msg unknown)\n" "$1" >&2; usage >&2; exit 2 ;;
esac
command="kubabbar-glass-minimize $1"
repair=$(printf '["kubabbar-glass-minimize","%s"]' "$1")
problem() { # message-id setting reason
	sparky-stereo-problems keep --person --repair "$repair" "$package" "$key" "$1" "$2" "$3" "$command" || true
}
save() { # key value
	if err=$(kwriteconfig6 --file kwinrc --group Plugins --key "$1" "$2" 2>&1); then
		return 0
	fi
	problem LOCAL2 "$1" "${err:-kwriteconfig6 failed}"
	exit 1
}
# Both keys are written, or the first is put back when the second cannot be.
old_lamp=$(kreadconfig6 --file kwinrc --group Plugins --key magiclampEnabled 2>/dev/null) || old_lamp=
save magiclampEnabled "$lamp"
if ! err=$(kwriteconfig6 --file kwinrc --group Plugins --key squashEnabled "$squash" 2>&1); then
	[ -z "$old_lamp" ] || kwriteconfig6 --file kwinrc --group Plugins --key magiclampEnabled "$old_lamp" 2>/dev/null || true
	problem LOCAL2 squashEnabled "${err:-kwriteconfig6 failed}"
	exit 1
fi
# Ask KWin and read its answer: the effect is applied only when KWin says it is loaded.
kwin() { # method effect -> prints KWin's boolean answer, if any
	dbus-send --session --print-reply=literal --type=method_call --dest=org.kde.KWin /Effects "org.kde.kwin.Effects.$1" "string:$2" 2>&1
}
live_failure=
ask() { # method effect
	if ! answer=$(kwin "$1" "$2"); then
		live_failure="KWin did not answer $1 $2: $(printf '%s' "$answer" | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')"
		return 1
	fi
}
if [ "$lamp" = true ]; then want=magiclamp; other=squash; else want=squash; other=magiclamp; fi
if ask unloadEffect "$other" && ask loadEffect "$want" && ask isEffectLoaded "$want"; then
	case $answer in
		*true*) ;;
		*) live_failure="KWin reports that the $want effect is not loaded" ;;
	esac
fi
if [ -z "$live_failure" ] && ask isEffectLoaded "$other"; then
	case $answer in
		*true*) live_failure="KWin reports that the $other effect is still loaded" ;;
	esac
fi
if [ -n "$live_failure" ]; then
	problem LOCAL3 "$1" "$live_failure"
	exit 1
fi
sparky-stereo-problems clear --person "$package" "$key" || true
printf "$(msg done)\n" "$1"
