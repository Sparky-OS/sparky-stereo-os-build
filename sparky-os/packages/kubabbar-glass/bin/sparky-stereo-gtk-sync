#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Make GTK 3 and GTK 4 programs follow the active KDE look.
# The KDE colour scheme names the GTK theme; kde-gtk-config keeps its colours in step, this script picks the theme.
set -eu
package=sparky-stereo-gtk
repair='["sparky-stereo-gtk-sync"]'
run() {
	key=$1
	shift
	sparky-stereo-problems run --person --repair "$repair" "$package" "$key" LOCAL2 -- "$@"
}
config=${XDG_CONFIG_HOME:-$HOME/.config}
# kreadconfig6 returns zero for a string even when its file cannot be read.
# Check each existing cascading input before asking KConfig to resolve the value.
old_ifs=$IFS
IFS=:
for directory in "$config" ${XDG_CONFIG_DIRS:-/etc/xdg}; do
	if [ -e "$directory/kdeglobals" ] && [ ! -r "$directory/kdeglobals" ]; then
		IFS=$old_ifs
		sparky-stereo-problems keep --person --repair "$repair" "$package" scheme LOCAL3 "$directory/kdeglobals"
		exit 1
	fi
done
IFS=$old_ifs
if scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme); then
	sparky-stereo-problems clear --person "$package" scheme
else
	status=$?
	sparky-stereo-problems keep --person --repair "$repair" --status "$status" \
		--command '["kreadconfig6","--file","kdeglobals","--group","General","--key","ColorScheme"]' \
		"$package" scheme LOCAL2 kreadconfig6 "$status"
	exit "$status"
fi
dark=false
case "$scheme" in
	kubabbar-glass) theme=Kubabbar-Glass ;;
	kubabbar-glass-9) theme=Kubabbar-Glass-9 ;;
	kubabbar-glass-9-graphite) theme=Kubabbar-Glass-9-Graphite ;;
	kubabbar-glass-9-ivy) theme=Kubabbar-Glass-9-Ivy ;;
	kubabbar-glass-9-rose) theme=Kubabbar-Glass-9-Rose ;;
	kubabbar-glass-9-gold) theme=Kubabbar-Glass-9-Gold ;;
	kubabbar-glass-9-teal) theme=Kubabbar-Glass-9-Teal ;;
	SparkyStereoOxygen|Oxygen) theme=Sparky-Stereo-Oxygen ;;
	SparkyStereoOxygenDark|OxygenDark) theme=Sparky-Stereo-Oxygen-Dark; dark=true ;;
	*Dark*) theme=Breeze-Dark; dark=true ;;
	*) theme=Breeze ;;
esac
case "$theme" in
	Kubabbar-Glass-9*)
		# The person's choice of scroll arrows for Kubabbar Glass 9 (kubabbar-glass-9-scrolling): at both ends is the
		# theme's Apart twin; together at the end, the default, is the theme itself.
		arrows=$config/kubabbar-glass-9rc
		if [ -e "$arrows" ] && [ ! -r "$arrows" ]; then
			sparky-stereo-problems keep --person --repair "$repair" "$package" arrows LOCAL3 "$arrows"
			exit 1
		fi
		sparky-stereo-problems clear --person "$package" arrows
		if [ -e "$arrows" ] && [ "$(kreadconfig6 --file "$arrows" --group Scrolling --key Arrows)" = apart ]; then
			theme=$theme-Apart
		fi
		;;
esac
for version in 3.0 4.0; do
	run "gtk-$version-directory" mkdir -p "$config/gtk-$version"
	file=$config/gtk-$version/settings.ini
	run "gtk-$version-theme" kwriteconfig6 --file "$file" --group Settings --key gtk-theme-name "$theme"
	run "gtk-$version-dark" kwriteconfig6 --file "$file" --group Settings --key gtk-application-prefer-dark-theme "$dark"
done
# GTK 2 programs read the theme from XSETTINGS when xsettingsd runs, otherwise from ~/.gtkrc-2.0 (Plasma's GTK2_RC_FILES),
# which KDE's GTK module writes with its own theme name: the chosen theme goes there too, every other line kept
gtk2=$HOME/.gtkrc-2.0
if [ -f "$gtk2" ] && grep -q '^gtk-theme-name=' "$gtk2"; then
	run gtk-2.0-theme sed -i "s|^gtk-theme-name=.*|gtk-theme-name=\"$theme\"|" "$gtk2"
else
	run gtk-2.0-theme sh -c 'printf "gtk-theme-name=\"%s\"\n" "$1" >> "$2"' sh "$theme" "$gtk2"
fi
run gsettings-theme gsettings set org.gnome.desktop.interface gtk-theme "$theme"
# dconf can report a failed commit while gsettings exits zero. Read from a new
# process so its in-memory value cannot stand in for the saved setting.
run gsettings-theme-verify sh -c 'value=$(gsettings get org.gnome.desktop.interface "$1") || exit "$?"; [ "$value" = "$2" ]' sh gtk-theme "'$theme'"
if [ "$dark" = true ]; then colour=prefer-dark; else colour=default; fi
run gsettings-colour gsettings set org.gnome.desktop.interface color-scheme "$colour"
run gsettings-colour-verify sh -c 'value=$(gsettings get org.gnome.desktop.interface "$1") || exit "$?"; [ "$value" = "$2" ]' sh color-scheme "'$colour'"
if [ -f "$config/xsettingsd/xsettingsd.conf" ]; then
	run xsettings-config sed -i "s|^Net/ThemeName .*|Net/ThemeName \"$theme\"|" "$config/xsettingsd/xsettingsd.conf"
	if pids=$(pgrep -u "$(id -u)" -x xsettingsd); then
		# Signal only this person's daemon, by PID. The repair must discover new PIDs.
		for pid in $pids; do run xsettings-reload /bin/kill -HUP "$pid"; done
	elif [ "$?" -eq 1 ]; then
		sparky-stereo-problems say "$package" LOCAL4
	else
		sparky-stereo-problems keep --person --repair "$repair" "$package" xsettings-reload LOCAL5
		exit 1
	fi
else
	sparky-stereo-problems say "$package" LOCAL6
fi
# Kubabbar Glass 9 is a classic look whose scroll bars always show (its Kvantum themes: transient_scrollbar=false), so its
# GTK bars always show too: overlay scrolling off for its themes only. GTK reads it from settings.ini, and on Wayland from
# the settings portal, which serves the GSettings key above settings.ini. A person's own value is kept: the script
# records what it wrote, changes nothing it did not write, and when another look is applied removes only what it wrote
# and what still holds that value.
state=${XDG_STATE_HOME:-$HOME/.local/state}/sparky-stereo-gtk
record=$state/overlay-scrolling.written
if [ -e "$record" ] && [ ! -r "$record" ]; then
	sparky-stereo-problems keep --person --repair "$repair" "$package" overlay-scrolling LOCAL3 "$record"
	exit 1
fi
sparky-stereo-problems clear --person "$package" overlay-scrolling
run overlay-scrolling-state mkdir -p "$state"
newrecord=$(mktemp "$state/.overlay-scrolling.XXXXXX")
trap 'rm -f "$newrecord"' EXIT
dconf_key=/org/gnome/desktop/interface/overlay-scrolling
for target in gtk-3.0 gtk-4.0 gsettings; do
	if [ "$target" = gsettings ]; then
		# dconf, unlike gsettings, prints nothing for a key nobody has set
		current=$(dconf read "$dconf_key") || { run overlay-scrolling-read dconf read "$dconf_key"; exit 1; }
		sparky-stereo-problems clear --person "$package" overlay-scrolling-read
	else
		ini=$config/$target/settings.ini
		current=
		if [ -f "$ini" ]; then
			current=$(sed -n 's/^gtk-overlay-scrolling *= *//p' "$ini" | tail -n 1)
		fi
	fi
	wrote=
	if [ -f "$record" ]; then
		wrote=$(sed -n "s/^$target //p" "$record")
	fi
	case "$theme" in
		Kubabbar-Glass-9*)
			if [ -z "$current" ] || { [ -n "$wrote" ] && [ "$current" = "$wrote" ]; }; then
				if [ "$target" = gsettings ]; then
					run overlay-scrolling-gsettings gsettings set org.gnome.desktop.interface overlay-scrolling false
					run overlay-scrolling-gsettings-verify sh -c '[ "$(dconf read "$1")" = false ]' sh "$dconf_key"
				else
					run "$target-overlay-scrolling" kwriteconfig6 --file "$ini" --group Settings --key gtk-overlay-scrolling false
				fi
				printf '%s false\n' "$target" >> "$newrecord"
			fi
			;;
		*)
			if [ -n "$wrote" ] && [ "$current" = "$wrote" ]; then
				if [ "$target" = gsettings ]; then
					run overlay-scrolling-gsettings gsettings reset org.gnome.desktop.interface overlay-scrolling
				else
					run "$target-overlay-scrolling" kwriteconfig6 --file "$ini" --group Settings --key gtk-overlay-scrolling --delete
				fi
			fi
			;;
	esac
done
if [ -s "$newrecord" ]; then
	run overlay-scrolling-record mv "$newrecord" "$record"
else
	run overlay-scrolling-record rm -f "$newrecord" "$record"
fi
sparky-stereo-problems say "$package" LOCAL7 "$scheme" "$theme" "$dark"
