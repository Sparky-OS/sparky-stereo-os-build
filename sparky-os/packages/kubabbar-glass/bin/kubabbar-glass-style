# Last update 2026/11/04
# Choose the application style of Kubabbar Glass: Breeze (default), Fusion, Kvantum or Oxygen, all in the look's palette.
# A style that cannot be used, saved or announced is said and kept (sparky-stereo-problems, person scope); "done" is
# printed only after the saved value reads back (ORDER 346f-5, audit 343 U39). The saved setting is never replaced.
set -eu
package=sparky-stereo-look-kubabbar-glass
key=style

dir=/usr/share/sparky/kubabbar-glass-style
[ -d "$dir" ] || dir=$(dirname "$0")/../lang
code=${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}
[ -n "$code" ] || code=$(sed -n 's/^LANG=//p' /etc/default/locale 2>/dev/null | head -n 1 | tr -d '"')
code=${code%%.*}
case "$code" in
	zh_HK|zh_MO) code=zh_TW ;;
	zh_SG) code=zh_CN ;;
esac
for try in "$code" "${code%%_*}" en; do
	if [ -f "$dir/$try" ]; then . "$dir/$try"; break; fi
done

msg() {
	case "$1" in
		head) echo "$LOCAL1" ;;
		breeze) echo "$LOCAL2" ;;
		fusion) echo "$LOCAL3" ;;
		kvantum) echo "$LOCAL4" ;;
		oxygen) echo "$LOCAL5" ;;
		done) echo "$LOCAL6" ;;
		unknown) echo "$LOCAL7" ;;
	esac
}

usage() {
	msg head
	for style in breeze fusion kvantum oxygen; do
		printf '  %-8s %s\n' "$style" "$(msg "$style")"
	done
}

[ $# -eq 1 ] || { usage; exit 0; }
case "$1" in
	breeze) value=Breeze ;;
	fusion) value=Fusion ;;
	kvantum) value=kvantum ;;
	oxygen) value=Oxygen ;;
	*) printf "$(msg unknown)\n" "$1" >&2; usage >&2; exit 2 ;;
esac
config=${XDG_CONFIG_HOME:-$HOME/.config}
command="kubabbar-glass-style $1"
repair=$(printf '["kubabbar-glass-style","%s"]' "$1")
problem() { # message-id arg1 arg2 [arg3]
	sparky-stereo-problems keep --person --repair "$repair" "$package" "$key" "$@" || true
}
# Qt falls back to its own style, without a word, when the style plugin is missing: check it first, and change nothing.
case "$value" in
	Oxygen) plugin=oxygen; owner=kde-style-oxygen-qt6 ;;
	kvantum) plugin=kvantum; owner=qt6-style-kvantum ;;
	Breeze) plugin=breeze; owner=kde-style-breeze ;;
	*) plugin=; owner= ;;
esac
if [ -n "$plugin" ]; then
	found=
	for dir in /usr/lib/*/qt6/plugins/styles /usr/lib/qt6/plugins/styles ${QT_PLUGIN_PATH:+$(printf '%s' "$QT_PLUGIN_PATH" | tr ':' ' ')}; do
		case $dir in */styles) ;; *) dir=$dir/styles ;; esac
		for file in "$dir"/*; do
			case $(basename "$file" | tr 'A-Z' 'a-z') in
				*"$plugin"*.so) found=$file; break 2 ;;
			esac
		done
	done
	if [ -z "$found" ]; then
		problem LOCAL4 "$1" "$owner"
		exit 1
	fi
fi
save() { # file group key value
	if err=$(kwriteconfig6 --file "$1" --group "$2" --key "$3" "$4" 2>&1); then
		return 0
	fi
	problem LOCAL2 "$3" "${err:-kwriteconfig6 failed}" "$command"
	exit 1
}
if [ "$value" = kvantum ]; then
	if ! err=$(mkdir -p "$config/Kvantum" 2>&1); then
		problem LOCAL2 "$config/Kvantum" "$err" "$command"
		exit 1
	fi
	save "$config/Kvantum/kvantum.kvconfig" General theme KubabbarGlass
fi
save kdeglobals KDE widgetStyle "$value"
# Read the saved value back before saying it is done.
saved=$(kreadconfig6 --file kdeglobals --group KDE --key widgetStyle 2>&1) || saved="kreadconfig6 failed: $saved"
if [ "$saved" != "$value" ]; then
	problem LOCAL2 widgetStyle "the saved value reads back as '$saved'" "$command"
	exit 1
fi
# Tell the running programs (a signal has no reply: only its delivery to the bus can be confirmed).
if ! err=$(dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:2 int32:0 2>&1); then
	problem LOCAL3 "$1" "the running programs could not be told: $(printf '%s' "$err" | tr '\n' ' ')" "$command"
	exit 1
fi
sparky-stereo-problems clear --person "$package" "$key" || true
printf "$(msg done)\n" "$1"
