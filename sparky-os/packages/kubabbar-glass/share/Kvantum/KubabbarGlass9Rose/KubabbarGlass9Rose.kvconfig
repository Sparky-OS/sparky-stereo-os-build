[%General]
author=Daniel Ramos and EchoSystems AI studios
comment=Kubabbar Glass 9: classic bevelled controls in the Rose accent, original drawings. Scroll arrows together at the end.
comment[pl]=Kubabbar Glass 9: klasyczne, wypukłe kontrolki w akcencie Różany, oryginalne rysunki. Strzałki przewijania razem na końcu.
comment[pt_BR]=Kubabbar Glass 9: controles clássicos em relevo no destaque Rosa, desenhos originais. Setas de rolagem juntas no fim.
comment[fr]=Kubabbar Glass 9 : commandes classiques en relief, accent Rose, dessins originaux. Flèches de défilement groupées à la fin.
comment[de]=Kubabbar Glass 9: klassische, plastische Bedienelemente in der Akzentfarbe Rosé, eigene Zeichnungen. Bildlaufpfeile zusammen am Ende.
comment[es]=Kubabbar Glass 9: controles clásicos en relieve con el acento Rosa, dibujos originales. Flechas de desplazamiento juntas al final.
comment[ja]=Kubabbar Glass 9: アクセント ローズ の立体的なクラシックコントロール、オリジナルの描画。スクロール矢印は末端にまとめて配置。
comment[ko]=Kubabbar Glass 9: 로즈 강조색의 입체적인 클래식 컨트롤, 독자적인 그림. 스크롤 화살표는 끝에 함께 있음.
comment[zh_CN]=Kubabbar Glass 9：玫瑰粉强调色的经典立体控件，原创绘制。滚动箭头集中在末端。
comment[zh_TW]=Kubabbar Glass 9：玫瑰粉強調色的經典立體控制項，原創繪製。捲動箭頭集中在末端。
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
joined_inactive_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
composite=false
menu_shadow_depth=0
tooltip_shadow_depth=0
splitter_width=7
scroll_width=16
scroll_min_extent=28
scroll_arrows=true
scroll_arrows_together=true
center_scrollbar_indicator=true
transient_scrollbar=false
scrollbar_in_view=false
slider_width=6
slider_handle_width=16
slider_handle_length=16
check_size=13
vertical_spin_indicators=true
spread_progressbar=true
progressbar_thickness=12
tree_branch_line=false
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
button_contents_shift=false
fill_rubberband=false
respect_DE=true
translucent_windows=false
blurring=false
popup_blurring=false
animate_states=false
no_inactiveness=false

[Hacks]
respect_darkness=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.size=9
indicator.element=arrow
text.press.color=#ffffff
text.toggle.color=#ffffff
text.shadow=false
text.margin.top=1
text.margin.bottom=1
text.margin.left=6
text.margin.right=6
text.iconspacing=4

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.press.color=none
text.toggle.color=none
text.margin.left=3
text.margin.right=3

