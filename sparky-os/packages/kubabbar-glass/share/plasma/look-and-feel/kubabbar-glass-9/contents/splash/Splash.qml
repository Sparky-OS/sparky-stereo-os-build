// Kubabbar Glass 9's loading screen (generated by tools/make_login9.py). The boot splash's clean background and, in the
// middle, a classic window frame at the family's glass for dialogs, holding one under the other: the Sparky logo when the
// system has it, the system's name and version from os-release in big black letters, the theme's name, and a classic
// progress bar that fills as the session starts. A distribution without the Sparky logo shows the theme's name in its
// place; without os-release the theme's name stands alone. The theme never carries the logo.
// On a 3D screen the background stays at the screen and the box with everything in it stands at the person's popped limit
// (StereoDepth of org.sparky.stereo); on a 2D screen it is the same picture, plain.
import QtQuick
import QtQuick.Effects
import org.kde.coreaddons
import org.sparky.stereo

Rectangle {
    id: root
    color: "#000000"

    property int stage
    readonly property string themeName: "Kubabbar Glass 9"
    // the edition's swirl, installed by its artwork package (sparkyos-artwork), drawn in the text colour
    readonly property url logoSource: "file:///usr/share/pixmaps/sparkyos.png"
    // KOSRelease gives os-release's own defaults (Linux, linux) when neither /etc/os-release nor /usr/lib/os-release
    // can be read; then only the theme's name is shown
    readonly property bool osRead: !(KOSRelease.name === "Linux" && KOSRelease.id === "linux"
                                     && KOSRelease.prettyName === "Linux" && KOSRelease.version === ""
                                     && KOSRelease.versionId === "")
    readonly property string osName: osRead ? (KOSRelease.version !== "" ? KOSRelease.name + " " + KOSRelease.version
                                                                         : KOSRelease.name) : ""
    readonly property bool logoShown: logoImage.status === Image.Ready
    readonly property real progress: Math.max(0, Math.min(1, (stage - 1) / 6))

    Image {
        anchors.fill: parent
        source: "images/background.png"
        fillMode: Image.PreserveAspectCrop
        smooth: true
    }

    Item {
        id: box
        width: 460
        height: content.implicitHeight + 2 * 30
        anchors.centerIn: parent
        StereoDepth.depth: StereoDepth.Popped
        // the family's glass for dialogs; the frame's parts do not overlap, so every pixel of it is at that level (a
        // layer would make one picture of it, but the stereo layer moves items, not a layer's texture, per eye)
        opacity: 0.91015625

        Rectangle { anchors.fill: parent; color: "transparent"; border.color: "#1e1e1e"; border.width: 1 }
        Rectangle { x: 1; y: 1; width: parent.width - 2; height: 1; color: "#ffffff" }
        Rectangle { x: 1; y: 2; width: 1; height: parent.height - 3; color: "#ffffff" }
        Rectangle { x: 2; y: parent.height - 2; width: parent.width - 3; height: 1; color: "#999999" }
        Rectangle { x: parent.width - 2; y: 2; width: 1; height: parent.height - 4; color: "#999999" }
        Rectangle { x: 2; y: 2; width: parent.width - 4; height: parent.height - 4; color: "#dddddd" }

        Column {
            id: content
            anchors.horizontalCenter: parent.horizontalCenter
            y: 30
            spacing: 8

            Item {
                anchors.horizontalCenter: parent.horizontalCenter
                width: 80
                height: 80
                visible: root.logoShown
                Image {
                    id: logoImage
                    anchors.fill: parent
                    source: root.logoSource
                    fillMode: Image.PreserveAspectFit
                    smooth: true
                    mipmap: true
                    visible: false
                }
                MultiEffect {
                    anchors.fill: parent
                    source: logoImage
                    colorization: 1.0
                    colorizationColor: "#000000"
                }
            }
            Text {
                // the theme's name in the logo's place when the system has no Sparky logo
                anchors.horizontalCenter: parent.horizontalCenter
                visible: !root.logoShown && root.osName !== ""
                text: root.themeName
                color: "#000000"
                font.family: "Charcoal"
                font.pixelSize: 20
                font.bold: true
            }
            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                text: root.osName !== "" ? root.osName : root.themeName
                color: "#000000"
                font.family: "Charcoal"
                font.pixelSize: 34
                font.bold: true
            }
            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                visible: root.logoShown && root.osName !== ""
                text: root.themeName
                color: "#505050"
                font.family: "Charcoal"
                font.pixelSize: 14
            }
            Item {
                width: 1
                height: 6
            }
            Item {
                id: bar
                anchors.horizontalCenter: parent.horizontalCenter
                width: 260
                height: 14
                // a sunken track: the outline, a darker upper and left edge, a lighter lower and right edge
                Rectangle { anchors.fill: parent; color: "#1e1e1e" }
                Rectangle { x: 1; y: 1; width: parent.width - 2; height: parent.height - 2; color: "#f6f6f6" }
                Rectangle { x: 1; y: 1; width: parent.width - 3; height: parent.height - 3; color: "#969696" }
                Rectangle { id: trough; x: 2; y: 2; width: parent.width - 4; height: parent.height - 4; color: "#e8e8e8" }
                Rectangle {
                    x: 2
                    y: 2
                    height: parent.height - 4
                    width: Math.round(trough.width * root.progress)
                    Behavior on width { NumberAnimation { duration: 250 } }
                    gradient: Gradient {
                            GradientStop { position: 0.0417; color: "#bebede" }
                            GradientStop { position: 0.1250; color: "#9c9ccd" }
                            GradientStop { position: 0.2083; color: "#8787c2" }
                            GradientStop { position: 0.2917; color: "#7676b9" }
                            GradientStop { position: 0.3750; color: "#6969b2" }
                            GradientStop { position: 0.4583; color: "#5454a8" }
                            GradientStop { position: 0.5417; color: "#5454a8" }
                            GradientStop { position: 0.6250; color: "#5454a8" }
                            GradientStop { position: 0.7083; color: "#5454a8" }
                            GradientStop { position: 0.7917; color: "#4d4d9b" }
                            GradientStop { position: 0.8750; color: "#47478d" }
                            GradientStop { position: 0.9583; color: "#3c3c79" }
                    }
                }
            }
        }
    }
}
