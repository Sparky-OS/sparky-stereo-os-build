[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=kubabbar-glass

[kdeglobals][Icons]
Theme=kubabbar-glass-stereo

[plasmarc][Theme]
name=kubabbar-glass

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=kubabbar-glass
ButtonsOnLeft=MS
ButtonsOnRight=HIAX

[Wallpaper]
Image=kubabbar-glass

[kwinrc][Plugins]
glideEnabled=true
wobblywindowsEnabled=true
magiclampEnabled=true
squashEnabled=false
translucencyEnabled=true
blurEnabled=false
contrastEnabled=false

[kwinrc][Effect-translucency]
ComboboxPopups=92
Dialogs=91
DropdownMenus=96
ExcludeFullScreen=true
Inactive=91
IndividualMenuConfig=true
Menus=90
MoveResize=49
PopupMenus=97
TornOffMenus=94

[kwinrc][Windows]
FocusPolicy=FocusFollowsMouse
DelayFocusInterval=300
AutoRaise=true
AutoRaiseInterval=750
ClickRaise=true

[kcminputrc][Mouse]
cursorTheme=kubabbar-glass-cursors

[ksplashrc][KSplash]
Engine=KSplashQML
Theme=kubabbar-glass-menubar
