// SPDX-License-Identifier: GPL-3.0-only
// Kubabbar Glass 9's login screen (generated by tools/make_login9.py), after the classic Multiple Users window: choose
// your name in the list or type it, then log in, and the password is asked in a box of its own. The artwork is
// original. Plain Qt Quick and SDDM's own objects (sddm, userModel, sessionModel, keyboard, TextConstants); depth through
// the edition's stereo layer, which draws everything flat on a screen without depth.
// Depth, as on the lock screen: the pattern behind sinks to the person's sunk limit, the window is at the screen, the
// password box and the session's pop-up menu stand popped, each text at the depth of the element it is on.
import QtQuick
import QtQuick.Controls.Basic
import SddmComponents 2.0 as Sddm
import org.sparky.stereo

Rectangle {
    id: root
    width: 1280
    height: 800
    color: "#aaaade"

    // SDDM's own texts, translated by SDDM (SddmComponents; its Button and ComboBox stay behind the namespace)
    Sddm.TextConstants {
        id: textConstants
    }

    property string failure: ""
    property bool asking: false
    readonly property var texts: {"cancel": {"de": "Abbrechen", "en": "Cancel", "es": "Cancelar", "fr": "Annuler", "ja": "キャンセル", "ko": "취소", "pl": "Anuluj", "pt_BR": "Cancelar", "zh_CN": "取消", "zh_TW": "取消"}, "prompt": {"de": "Wählen Sie Ihren Namen in der Liste oder geben Sie ihn ein.", "en": "Choose your name in the list, or type it.", "es": "Elija su nombre en la lista o escríbalo.", "fr": "Choisissez votre nom dans la liste, ou saisissez-le.", "ja": "一覧から名前を選ぶか、名前を入力してください。", "ko": "목록에서 이름을 고르거나 직접 입력하세요.", "pl": "Wybierz swoją nazwę z listy lub ją wpisz.", "pt_BR": "Escolha o seu nome na lista ou digite-o.", "zh_CN": "请在列表中选择您的名字，或直接输入。", "zh_TW": "請在清單中選擇您的名稱，或直接輸入。"}}

    // the edition's lookup: the whole locale, then the bare language, then English; Chinese keeps its script
    function tr(key) {
        var name = Qt.locale().name
        if (name === "zh_HK" || name === "zh_MO")
            name = "zh_TW"
        else if (name === "zh_SG")
            name = "zh_CN"
        var t = texts[key]
        if (t[name] !== undefined)
            return t[name]
        var bare = name.split("_")[0]
        return t[bare] !== undefined ? t[bare] : t["en"]
    }

    function selectByName(text) {
        var wanted = text.toLowerCase()
        for (var i = 0; i < people.count; ++i) {
            var item = people.itemAtIndex(i)
            if (item && wanted !== "" && (item.login.toLowerCase().indexOf(wanted) === 0
                                          || item.shown.toLowerCase().indexOf(wanted) === 0)) {
                people.currentIndex = i
                return
            }
        }
        people.currentIndex = -1
    }

    function ask() {
        if (nameField.text === "")
            return
        root.failure = ""
        root.asking = true
        password.text = ""
        password.forceActiveFocus()
    }

    function logIn() {
        sddm.login(nameField.text, password.text, sessionBox.currentIndex)
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            root.failure = textConstants.loginFailed
            password.text = ""
            password.forceActiveFocus()
        }
    }

    Image {
        anchors.fill: parent
        source: "file:///usr/share/wallpapers/kubabbar-glass-9/contents/images/1920x1080.png"
        fillMode: Image.PreserveAspectCrop
        StereoDepth.depth: StereoDepth.Sunk
    }

    component Bevel: Item {
        // a classic raised box: the outline, a light upper and left edge, a shadowed lower and right edge
        property color face: "#dddddd"
        property bool sunken: false
        Rectangle { anchors.fill: parent; color: "#1e1e1e" }
        Rectangle { x: 1; y: 1; width: parent.width - 2; height: parent.height - 2; color: parent.sunken ? "#787878" : "#ffffff" }
        Rectangle { x: 2; y: 2; width: parent.width - 3; height: parent.height - 3; color: parent.sunken ? "#bebebe" : "#999999" }
        Rectangle { x: 2; y: 2; width: parent.width - 4; height: parent.height - 4; color: parent.face }
    }

    component ClassicButton: Button {
        id: control
        property bool isDefault: false
        implicitHeight: 26
        implicitWidth: Math.max(88, contentItem.implicitWidth + 28)
        font.family: "Charcoal"
        font.pixelSize: 13
        background: Item {
            Rectangle {
                // the default button's ring
                anchors.fill: parent
                visible: control.isDefault
                color: "transparent"
                border.color: "#1e1e1e"
                border.width: 2
                radius: 5
            }
            Bevel {
                anchors.fill: parent
                anchors.margins: 3
                face: control.down ? "#666666" : "#dddddd"
                sunken: control.down
            }
        }
        contentItem: Text {
            text: control.text
            font: control.font
            color: control.down ? "#ffffff" : "#000000"
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
        }
    }

    component ClassicField: TextField {
        id: field
        implicitHeight: 24
        color: "#000000"
        selectionColor: "#ccccff"
        selectedTextColor: "#000000"
        font.pixelSize: 13
        leftPadding: 6
        background: Item {
            Rectangle { anchors.fill: parent; color: field.activeFocus ? "#9999dd" : "#ffffff" }
            Rectangle { x: 1; y: 1; width: parent.width - 2; height: parent.height - 2; color: field.activeFocus ? "#9999dd" : "#999999" }
            Rectangle { x: 2; y: 2; width: parent.width - 4; height: parent.height - 4; color: "#1e1e1e" }
            Rectangle { x: 3; y: 3; width: parent.width - 6; height: parent.height - 6; color: "#ffffff" }
        }
    }

    Item {
        id: win
        width: 470
        height: 470
        anchors.centerIn: parent

        Bevel { anchors.fill: parent }

        Item {
            id: titleBar
            x: 2
            y: 2
            width: parent.width - 4
            height: 22
            Repeater {
                model: 5
                Item {
                    y: 4 + index * 3
                    width: titleBar.width
                    height: 2
                    Rectangle { x: 6; width: parent.width - 12; height: 1; color: "#aaaaaa" }
                    Rectangle { x: 6; y: 1; width: parent.width - 12; height: 1; color: "#ffffff" }
                }
            }
            Rectangle {
                anchors.centerIn: parent
                width: title.implicitWidth + 16
                height: parent.height
                color: "#dddddd"
                Text {
                    id: title
                    anchors.centerIn: parent
                    text: textConstants.welcomeText.arg(sddm.hostName)
                    color: "#000000"
                    font.family: "Charcoal"
                    font.pixelSize: 13
                    font.bold: true
                }
            }
        }

        Column {
            x: 18
            y: titleBar.height + 14
            width: parent.width - 36
            spacing: 8

            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                text: root.tr("prompt")
                color: "#000000"
                font.pixelSize: 13
            }

            Item {
                // the list of people: a sunken frame round a white list, the chosen one in the highlight colour
                width: parent.width
                height: 200
                Rectangle { anchors.fill: parent; color: "#ffffff" }
                Rectangle { width: parent.width - 1; height: parent.height - 1; color: "#999999" }
                Rectangle { x: 1; y: 1; width: parent.width - 2; height: parent.height - 2; color: "#1e1e1e" }
                Rectangle { x: 2; y: 2; width: parent.width - 4; height: parent.height - 4; color: "#ffffff" }
                ListView {
                    id: people
                    x: 2
                    y: 2
                    width: parent.width - 4
                    height: parent.height - 4
                    clip: true
                    model: userModel
                    currentIndex: userModel.lastIndex
                    keyNavigationEnabled: true
                    focus: true
                    highlightMoveDuration: 0
                    onCurrentItemChanged: if (currentItem && nameField.text !== currentItem.login) nameField.text = currentItem.login
                    Keys.onReturnPressed: root.ask()
                    Keys.onEnterPressed: root.ask()
                    highlight: Rectangle { color: "#ccccff" }
                    delegate: Item {
                        required property int index
                        required property string name
                        required property string realName
                        required property string icon
                        readonly property string login: name
                        readonly property string shown: realName !== "" ? realName : name
                        width: ListView.view.width
                        height: 40
                        Image {
                            id: face
                            x: 6
                            anchors.verticalCenter: parent.verticalCenter
                            width: 32
                            height: 32
                            source: icon
                            sourceSize.width: 32
                            sourceSize.height: 32
                            fillMode: Image.PreserveAspectFit
                        }
                        Text {
                            anchors.left: face.right
                            anchors.leftMargin: 10
                            anchors.verticalCenter: parent.verticalCenter
                            text: parent.shown
                            color: "#000000"
                            font.pixelSize: 14
                        }
                        MouseArea {
                            anchors.fill: parent
                            onClicked: people.currentIndex = parent.index
                            onDoubleClicked: { people.currentIndex = parent.index; root.ask() }
                        }
                    }
                }
            }

            Row {
                spacing: 8
                Text {
                    width: 110
                    height: nameField.height
                    verticalAlignment: Text.AlignVCenter
                    text: textConstants.userName
                    color: "#000000"
                    font.pixelSize: 13
                }
                ClassicField {
                    id: nameField
                    width: win.width - 36 - 118
                    text: userModel.lastUser
                    onTextEdited: root.selectByName(text)
                    onAccepted: root.ask()
                }
            }

            Row {
                spacing: 8
                Text {
                    width: 110
                    height: sessionBox.height
                    verticalAlignment: Text.AlignVCenter
                    text: textConstants.session
                    color: "#000000"
                    font.pixelSize: 13
                }
                ComboBox {
                    id: sessionBox
                    width: win.width - 36 - 118
                    implicitHeight: 24
                    model: sessionModel
                    textRole: "name"
                    currentIndex: sessionModel.lastIndex
                    font.pixelSize: 13
                    background: Bevel { }
                    contentItem: Text {
                        leftPadding: 8
                        rightPadding: 24
                        text: sessionBox.displayText
                        font: sessionBox.font
                        color: "#000000"
                        verticalAlignment: Text.AlignVCenter
                        elide: Text.ElideRight
                    }
                    indicator: Canvas {
                        x: sessionBox.width - width - 8
                        y: (sessionBox.height - height) / 2
                        width: 9
                        height: 6
                        onPaint: {
                            var c = getContext("2d")
                            c.fillStyle = "#1e1e1e"
                            c.beginPath(); c.moveTo(0, 0); c.lineTo(width, 0); c.lineTo(width / 2, height); c.closePath(); c.fill()
                        }
                    }
                    popup: Popup {
                        y: sessionBox.height
                        width: sessionBox.width
                        implicitHeight: contentItem.implicitHeight + 2
                        padding: 1
                        background: Rectangle {
                            color: "#dddddd"
                            border.color: "#1e1e1e"
                            StereoDepth.depth: StereoDepth.Popped
                        }
                        contentItem: ListView {
                            clip: true
                            implicitHeight: contentHeight
                            model: sessionBox.popup.visible ? sessionBox.delegateModel : null
                            currentIndex: sessionBox.highlightedIndex
                            StereoDepth.depth: StereoDepth.Popped
                        }
                    }
                    delegate: ItemDelegate {
                        required property int index
                        required property string name
                        width: sessionBox.width - 2
                        height: 22
                        highlighted: sessionBox.highlightedIndex === index
                        background: Rectangle { color: parent.highlighted ? "#5454a8" : "transparent" }
                        contentItem: Text {
                            leftPadding: 8
                            text: parent.name
                            font.pixelSize: 13
                            color: parent.highlighted ? "#ffffff" : "#000000"
                            verticalAlignment: Text.AlignVCenter
                        }
                    }
                }
            }
        }

        Row {
            x: 14
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 14
            spacing: 6
            ClassicButton {
                text: textConstants.shutdown
                visible: sddm.canPowerOff
                onClicked: sddm.powerOff()
            }
            ClassicButton {
                text: textConstants.reboot
                visible: sddm.canReboot
                onClicked: sddm.reboot()
            }
        }
        ClassicButton {
            anchors.right: parent.right
            anchors.rightMargin: 14
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 14
            isDefault: true
            text: textConstants.login
            onClicked: root.ask()
        }

        MouseArea {
            // while the password is asked, the window behind it does not take the pointer
            anchors.fill: parent
            visible: root.asking
        }

        Item {
            id: sheet
            visible: root.asking
            width: 360
            height: sheetColumn.implicitHeight + 64
            anchors.centerIn: parent
            StereoDepth.depth: StereoDepth.Popped
            Bevel { anchors.fill: parent }
            Column {
                id: sheetColumn
                x: 18
                y: 16
                width: parent.width - 36
                spacing: 8
                Text {
                    text: nameField.text
                    color: "#000000"
                    font.family: "Charcoal"
                    font.pixelSize: 14
                    font.bold: true
                }
                Text {
                    text: textConstants.password
                    color: "#000000"
                    font.pixelSize: 13
                }
                ClassicField {
                    id: password
                    width: parent.width
                    echoMode: TextInput.Password
                    onAccepted: root.logIn()
                    Keys.onEscapePressed: { root.asking = false; people.forceActiveFocus() }
                }
                Text {
                    visible: keyboard.capsLock
                    text: textConstants.capslockWarning
                    color: "#505050"
                    font.pixelSize: 12
                }
                Text {
                    visible: root.failure !== ""
                    width: parent.width
                    wrapMode: Text.WordWrap
                    text: root.failure
                    color: "#a00000"
                    font.pixelSize: 12
                }
            }
            Row {
                anchors.right: parent.right
                anchors.rightMargin: 12
                anchors.bottom: parent.bottom
                anchors.bottomMargin: 10
                spacing: 6
                ClassicButton {
                    text: root.tr("cancel")
                    onClicked: { root.asking = false; people.forceActiveFocus() }
                }
                ClassicButton {
                    isDefault: true
                    text: textConstants.login
                    onClicked: root.logIn()
                }
            }
        }
    }
}
