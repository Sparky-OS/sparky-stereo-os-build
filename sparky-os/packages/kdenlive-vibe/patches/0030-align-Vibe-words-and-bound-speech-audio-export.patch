+
+SpeechAudioJob::SpeechAudioJob(QObject *parent)
+    : QObject(parent)
+{
+    m_timer.setInterval(250);
+    connect(&m_timer, &QTimer::timeout, this, [this]() {
+        const qint64 size = QFileInfo(m_output).size();
+        if (size > m_size && size > 44) {
+            m_size = size;
+            m_progress.restart();
+        } else if (m_progress.hasExpired(idleSeconds * 1000)) {
+            complete(i18n("Audio export timed out after %1 seconds without audio.", idleSeconds));
+        }
+    });
+    connect(&m_renderer, &QProcess::errorOccurred, this, [this]() { complete(i18n("Audio export failed")); });
+    connect(&m_renderer, &QProcess::finished, this, [this](int exitCode, QProcess::ExitStatus status) {
+        const bool success = exitCode == 0 && status == QProcess::NormalExit && QFileInfo(m_output).size() > 44;
+        complete(success ? QString() : i18n("Audio export failed"));
+    });
+}
+
+SpeechAudioJob::~SpeechAudioJob()
+{
+    if (m_renderer.state() != QProcess::NotRunning) {
+        m_renderer.disconnect(this);
+        m_renderer.kill();
+        m_renderer.waitForFinished(1000);
+    }
+}
+
+void SpeechAudioJob::start(const QStringList &arguments, const QString &output)
+{
+    Q_ASSERT(!m_running);
+    m_running = true;
+    m_output = output;
+    m_size = 0;
+    m_progress.start();
+    m_timer.start();
+    m_renderer.setStandardOutputFile(QProcess::nullDevice());
+    m_renderer.setStandardErrorFile(QProcess::nullDevice());
+    m_renderer.start(KdenliveSettings::kdenliverendererpath(), arguments);
+}
+
+void SpeechAudioJob::cancel()
+{
+    complete(i18n("Speech recognition aborted."));
+}
+
+bool SpeechAudioJob::isRunning() const
+{
+    return m_running;
+}
+
+void SpeechAudioJob::complete(const QString &error)
+{
+    if (!m_running) {
+        return;
+    }
+    m_running = false;
+    m_timer.stop();
+    if (m_renderer.state() != QProcess::NotRunning) {
+        m_renderer.kill();
+        m_renderer.waitForFinished(1000);
+    }
+    Q_EMIT finished(error);
+}
