+void TextBasedEdit::startVibeRecognition(double endPos)
+{
+    m_playlistWav.remove();
+    m_playlistWav.setFileTemplate(QDir::temp().absoluteFilePath(QStringLiteral("kdenlive-XXXXXX.wav")));
+    if (!m_playlistWav.open()) {
+        showMessage(i18n("Cannot create temporary file."), KMessageWidget::Warning);
+        return;
+    }
+    m_playlistWav.close();
+    const double fps = pCore->getCurrentFps();
+    const int first = GenTime(m_clipOffset).frames(fps);
+    const int last = std::max(first, first + GenTime(endPos > 0 ? endPos : m_clipDuration).frames(fps) - 1);
+    enableEditActions(false, false);
+    showMessage(i18n("Starting audio export"), KMessageWidget::Information);
+    speech_progress->setRange(0, 0);
+    frame_progress->show();
+    m_audioExport->start({QStringLiteral("speech-audio"), m_sourceUrl, m_playlistWav.fileName(), QString::number(first), QString::number(last),
+                          QStringLiteral("0"), QStringLiteral("-1"), QStringLiteral("mono"), pCore->getCurrentProfilePath()},
+                         m_playlistWav.fileName());
+}
