+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#include "vibetiming.h"
+
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QtEndian>
+
+#include <algorithm>
+#include <cmath>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+struct Span
+{
+    double start;
+    double end;
+};
+
+struct AudioActivity
+{
+    double duration{0};
+    QList<Span> spans;
+};
+
+constexpr double frameSeconds = 0.020;
+constexpr double pauseSeconds = 1.0;
+
+AudioActivity speechActivity(const QString &path)
+{
+    QFile wav(path);
+    if (!wav.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    const QByteArray riff = wav.read(12);
+    if (riff.size() != 12 || riff.first(4) != "RIFF" || riff.last(4) != "WAVE") {
+        return {};
+    }
+    bool formatOk = false;
+    while (wav.pos() + 8 <= wav.size()) {
+        const QByteArray header = wav.read(8);
+        if (header.size() != 8) {
+            return {};
+        }
+        const auto size = qFromLittleEndian<quint32>(header.constData() + 4);
+        const qint64 offset = wav.pos();
+        if (offset + size > wav.size()) {
+            return {};
+        }
+        if (header.startsWith("fmt ") && size >= 16) {
+            const QByteArray format = wav.read(16);
+            formatOk = format.size() == 16 && qFromLittleEndian<quint16>(format.constData()) == 1
+                && qFromLittleEndian<quint16>(format.constData() + 2) == 1
+                && qFromLittleEndian<quint32>(format.constData() + 4) == 16000
+                && qFromLittleEndian<quint16>(format.constData() + 14) == 16;
+        } else if (header.startsWith("data") && formatOk) {
+            constexpr int samplesPerFrame = 320;
+            constexpr int bytesPerFrame = samplesPerFrame * 2;
+            QList<double> energy;
+            energy.reserve(size / bytesPerFrame);
+            int previous = 0;
+            for (qint64 remaining = size; remaining >= bytesPerFrame; remaining -= bytesPerFrame) {
+                const QByteArray samples = wav.read(bytesPerFrame);
+                if (samples.size() != bytesPerFrame) {
+                    return {};
+                }
+                double sum = 0;
+                for (int i = 0; i < bytesPerFrame; i += 2) {
+                    const int sample = qFromLittleEndian<qint16>(samples.constData() + i);
+                    const double difference = sample - previous;
+                    sum += difference * difference;
+                    previous = sample;
+                }
+                energy.append(std::sqrt(sum / samplesPerFrame));
+            }
+            AudioActivity result{size / 32000.0, {}};
+            if (energy.isEmpty()) {
+                return result;
+            }
+            auto levels = energy;
+            std::sort(levels.begin(), levels.end());
+            const double floor = levels.at(levels.size() / 10);
+            const double loud = levels.at(levels.size() * 95 / 100);
+            // A quiet background is useful evidence only when the recording has
+            // enough contrast. Differencing rejects steady low-frequency energy.
+            if (loud < 2 * std::max(2.0, floor)) {
+                return result;
+            }
+            const double threshold = std::max({4.0, floor * 1.65, loud * 0.005});
+            qsizetype first = -1;
+            qsizetype last = -1;
+            auto append = [&]() {
+                if (last - first >= 4) {
+                    result.spans.append({first * frameSeconds, (last + 1) * frameSeconds});
+                }
+            };
+            for (qsizetype i = 0; i < energy.size(); ++i) {
+                if (energy.at(i) < threshold) {
+                    continue;
+                }
+                if (first < 0 || (i - last) * frameSeconds >= 0.45) {
+                    if (first >= 0) {
+                        append();
+                    }
+                    first = i;
+                }
+                last = i;
+            }
+            if (first >= 0) {
+                append();
+            }
+            return result;
+        }
+        if (!wav.seek(offset + size + (size & 1))) {
+            break;
+        }
+    }
+    return {};
+}
+
+Span extent(const QList<VibeWord> &words)
+{
+    return {words.first().start, words.last().end};
+}
+
+double intersection(const Span &a, const Span &b)
+{
+    return std::max(0.0, std::min(a.end, b.end) - std::max(a.start, b.start));
+}
+
+void adjustEdges(VibeCues &cues, const QList<Span> &activity)
+{
+    QList<QList<Span>> spansByCue(cues.size());
+    qsizetype firstPossible = 0;
+    for (const auto &span : activity) {
+        while (firstPossible < cues.size() && cues.at(firstPossible).last().end < span.start) {
+            ++firstPossible;
+        }
+        qsizetype owner = -1;
+        double best = 0;
+        for (qsizetype i = firstPossible; i < cues.size(); ++i) {
+            const double overlap = intersection(span, extent(cues.at(i)));
+            if (overlap > best) {
+                owner = i;
+                best = overlap;
+            }
+            if (cues.at(i).first().start > span.end) {
+                break;
+            }
+        }
+        if (owner >= 0 && best >= (span.end - span.start) * 0.60) {
+            spansByCue[owner].append(span);
+        }
+    }
+    for (qsizetype i = 0; i < cues.size(); ++i) {
+        const auto &spans = spansByCue.at(i);
+        if (spans.isEmpty()) {
+            continue;
+        }
+        auto &words = cues[i];
+        const auto rough = extent(words);
+        double start = rough.start;
+        double end = rough.end;
+        if (spans.first().start >= rough.start - 0.30
+            && (i == 0 || spans.first().start >= cues.at(i - 1).last().end)) {
+            start = spans.first().start;
+        }
+        if (spans.last().end <= rough.end + 0.30
+            && (i + 1 == cues.size() || spans.last().end <= cues.at(i + 1).first().start + 0.30)) {
+            end = spans.last().end;
+        }
+        if (start < end) {
+            words.first().start = start;
+            words.last().end = end;
+        }
+    }
+}
+
+bool sentenceEnd(const QString &text)
+{
+    static const QString terminal = u".!?。！？…"_s;
+    const QString word = text.trimmed();
+    return !word.isEmpty() && terminal.contains(word.back());
+}
+
+void normalizeWords(QList<VibeWord> &words, double start, double end)
+{
+    // Preserve timings inside the cue. Redistribute only the words for which
+    // the recognizer left no usable positive interval inside its speech.
+    double position = start;
+    const double minimum = std::min(0.020, (end - start) / words.size());
+    for (qsizetype i = 0; i < words.size(); ++i) {
+        auto &word = words[i];
+        const double remaining = (words.size() - i - 1) * minimum;
+        const double latest = std::max(position, end - remaining - minimum);
+        word.start = std::clamp(word.start, position, latest);
+        word.end = std::clamp(word.end, std::min(end - remaining, word.start + minimum), end - remaining);
+        position = word.end;
+    }
+    words.first().start = start;
+    words.last().end = end;
+}
+
+QString srtTime(double seconds)
+{
+    const qint64 ms = qRound64(seconds * 1000);
+    return u"%1:%2:%3,%4"_s.arg(ms / 3600000, 2, 10, u'0').arg(ms / 60000 % 60, 2, 10, u'0')
+        .arg(ms / 1000 % 60, 2, 10, u'0').arg(ms % 1000, 3, 10, u'0');
+}
+}
+
+VibeCues vibeTimedWords(const QByteArray &reply, const QString &audioPath, bool voiceActivity)
+{
+    const auto parsed = QJsonDocument::fromJson(reply);
+    const auto segments = parsed.object().value("segments"_L1).toArray();
+    const auto audio = speechActivity(audioPath);
+    if (audio.duration <= 0) {
+        return {};
+    }
+    VibeCues cues;
+    for (const auto &entry : segments) {
+        const QJsonObject segment = entry.toObject();
+        const Span bounds{std::clamp(segment.value("start"_L1).toDouble(-1), 0.0, audio.duration),
+                          std::clamp(segment.value("end"_L1).toDouble(-1), 0.0, audio.duration)};
+        QList<VibeWord> cue;
+        for (const auto &value : segment.value("words"_L1).toArray()) {
+            const QJsonObject item = value.toObject();
+            const double start = item.value("start"_L1).toDouble(-1);
+            const double end = item.value("end"_L1).toDouble(-1);
+            const QString text = item.value("text"_L1).toString();
+            if (start < 0 || end < start || start >= audio.duration || text.trimmed().isEmpty()) {
+                continue;
+            }
+            if (!cue.isEmpty() && sentenceEnd(cue.last().text)) {
+                const double previous = cue.last().end;
+                const auto &spans = audio.spans;
+                bool pause = start - previous >= pauseSeconds;
+                for (qsizetype i = 1; !pause && i < spans.size(); ++i) {
+                    const double before = spans.at(i - 1).end;
+                    const double after = spans.at(i).start;
+                    const double boundary = (previous + start) / 2;
+                    if (before > boundary) {
+                        break;
+                    }
+                    pause = after - before >= pauseSeconds && boundary <= after;
+                }
+                if (pause) {
+                    cues.append(cue);
+                    cue.clear();
+                }
+            }
+            cue.append({text, start, std::min(end, audio.duration)});
+        }
+        if (!cue.isEmpty()) {
+            // Stable timestamps provides VAD windows. Whisper can still
+            // return word times from before that window.
+            if (voiceActivity && bounds.start < bounds.end) {
+                cue.first().start = std::clamp(cue.first().start, bounds.start, bounds.end);
+                cue.last().end = std::clamp(cue.last().end, bounds.start, bounds.end);
+            }
+            cues.append(cue);
+        }
+    }
+    adjustEdges(cues, audio.spans);
+    VibeCues result;
+    double previous = 0;
+    for (auto &cue : cues) {
+        const double start = std::max(previous, cue.first().start);
+        const double end = cue.last().end;
+        if (end > start) {
+            normalizeWords(cue, start, end);
+            result.append(cue);
+            previous = end;
+        }
+    }
+    return result;
+}
+
+QByteArray vibeSubtitles(const VibeCues &cues)
+{
+    QString subtitles;
+    for (qsizetype i = 0; i < cues.size(); ++i) {
+        const auto &words = cues.at(i);
+        QString text;
+        for (const auto &word : words) {
+            text += word.text;
+        }
+        subtitles += u"%1\n%2 --> %3\n%4\n\n"_s.arg(i + 1).arg(srtTime(words.first().start), srtTime(words.last().end), text.trimmed());
+    }
+    return subtitles.toUtf8();
+}
