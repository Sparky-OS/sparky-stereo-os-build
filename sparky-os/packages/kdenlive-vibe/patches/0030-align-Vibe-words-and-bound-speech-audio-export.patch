+static int exportSpeechAudio(const QStringList &args)
+{
+    if (args.size() != 9) {
+        return 1;
+    }
+    bool ok = false;
+    const int in = args.at(3).toInt(&ok);
+    if (!ok || in < 0) {
+        return 1;
+    }
+    const int out = args.at(4).toInt(&ok);
+    if (!ok || out < in) {
+        return 1;
+    }
+    const int tracksCount = args.at(5).toInt(&ok);
+    if (!ok || tracksCount < 0) {
+        return 1;
+    }
+    const int trackPos = args.at(6).toInt(&ok);
+    if (!ok) {
+        return 1;
+    }
+    const bool mono = args.at(7) == QStringLiteral("mono");
+    const bool timeline = tracksCount > 0;
+    const QString repoPath = getCIMltRepositoryPath();
+    Mlt::Factory::init(repoPath.isEmpty() ? nullptr : repoPath.toUtf8().constData());
+    LocaleHandling::resetAllLocale();
+
+    const QString profilePath = args.at(8);
+    Mlt::Profile profile(profilePath.isEmpty() ? nullptr : profilePath.toUtf8().constData());
+    profile.set_explicit(true);
+    Mlt::Producer producer(profile, timeline ? "xml" : nullptr, args.at(1).toUtf8().constData());
+    if (!producer.is_valid()) {
+        return 1;
+    }
+    if (timeline) {
+        auto service = std::make_unique<Mlt::Service>(producer);
+        for (int i = 0; i < 10; ++i) {
+            service.reset(service->producer());
+            if (!service || !service->is_valid()) {
+                break;
+            }
+            if (service->type() != mlt_service_multitrack_type) {
+                continue;
+            }
+            Mlt::Multitrack tracks(*service);
+            if (tracks.count() != tracksCount) {
+                continue;
+            }
+            for (int track = 0; track < tracksCount; ++track) {
+                std::unique_ptr<Mlt::Producer> input(tracks.track(track));
+                if (input && (input->get_int("hide") == 1 || track == 0 || (trackPos >= 0 && track != trackPos))) {
+                    input->set("hide", 3);
+                }
+            }
+            break;
+        }
+    }
+    Mlt::Consumer consumer(profile, "avformat", args.at(2).toUtf8().constData());
+    if (!consumer.is_valid()) {
+        return 1;
+    }
+    consumer.set("terminate_on_pause", 1);
+    consumer.set("properties", "WAV");
+    if (mono) {
+        consumer.set("ar", 16000);
+        consumer.set("ac", 1);
+        consumer.set("acodec", "pcm_s16le");
+    }
+    producer.set_in_and_out(in, out);
+    if (consumer.connect(producer) != 0 || consumer.start() != 0) {
+        return 1;
+    }
+    // Consumer::run registers for consumer-stopped after checking the state.
+    // Polling avoids losing a stop that happens in that interval. The editor
+    // enforces the deadline even if start or stop blocks inside MLT.
+    while (!consumer.is_stopped()) {
+        QThread::msleep(10);
+    }
+    return consumer.stop();
 }
 
