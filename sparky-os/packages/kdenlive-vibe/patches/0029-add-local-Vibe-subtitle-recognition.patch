+
+#include "vibespeechjob.h"
+
+#include <KLocalizedString>
+#include <QFile>
+#include <QFileInfo>
+#include <QHttpMultiPart>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QLocale>
+#include <QNetworkProxy>
+#include <QNetworkReply>
+#include <QRegularExpression>
+#include <QSaveFile>
+#include <QStandardPaths>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+bool readableModel(const QString &path)
+{
+    const QFileInfo info(path);
+    return info.isAbsolute() && info.isFile() && info.isReadable();
+}
+
+QJsonObject vibeStore()
+{
+    const QString data = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation);
+    QFile file(data + u"/github.com.thewh1teagle.vibe/app_config.json"_s);
+    return file.open(QIODevice::ReadOnly) ? QJsonDocument::fromJson(file.readAll()).object() : QJsonObject{};
+}
+
+QHttpPart field(const QByteArray &name, const QByteArray &value)
+{
+    QHttpPart part;
+    part.setRawHeader("Content-Disposition", "form-data; name=\"" + name + "\"");
+    part.setBody(value);
+    return part;
+}
+}
+
+VibeSpeechJob::VibeSpeechJob(QObject *parent)
+    : QObject(parent)
+{
+    m_network.setProxy(QNetworkProxy::NoProxy);
+    m_timer.setSingleShot(true);
+    connect(&m_timer, &QTimer::timeout, this, [this]() {
+        complete(m_resolving ? i18n("System Settings, Partners did not answer.") : i18n("Vibe's speech server did not become ready."));
+    });
+    connect(&m_resolver, &QProcess::finished, this, &VibeSpeechJob::resolved);
+    connect(&m_resolver, &QProcess::errorOccurred, this, [this]() { complete(i18n("Could not read the speech settings from System Settings, Partners.")); });
+    connect(&m_server, &QProcess::readyReadStandardOutput, this, &VibeSpeechJob::readServerOutput);
+    connect(&m_server, &QProcess::errorOccurred, this, [this]() { complete(i18n("Could not start Vibe's speech server: %1", m_server.errorString())); });
+    connect(&m_server, &QProcess::finished, this, [this]() {
+        const QString detail = QString::fromUtf8(m_server.readAllStandardError().right(4096)).trimmed();
+        complete(detail.isEmpty() ? i18n("Vibe's speech server stopped.") : i18n("Vibe's speech server stopped: %1", detail));
+    });
+}
+
+VibeSpeechJob::~VibeSpeechJob()
+{
+    stop();
+}
+
+bool VibeSpeechJob::isVibeEngine(const QString &engine)
+{
+    return engine == "vibe"_L1 || engine == "system-default"_L1;
+}
+
+bool VibeSpeechJob::isRunning() const
+{
+    return m_running;
+}
+
+void VibeSpeechJob::start(const QString &audioPath, const QString &subtitlePath, bool systemDefault)
+{
+    if (m_running) {
+        return;
+    }
+    m_running = true;
+    m_audioPath = audioPath;
+    m_subtitlePath = subtitlePath;
+    m_serverProgram = QStandardPaths::findExecutable(u"vibe-server"_s);
+    if (m_serverProgram.isEmpty()) {
+        complete(i18n("Vibe is missing. Install Vibe from Stereo APTus."));
+        return;
+    }
+
+    if (systemDefault) {
+        const QString partners = QStandardPaths::findExecutable(u"sparky-stereo-partners"_s);
+        if (partners.isEmpty()) {
+            complete(i18n("System Settings, Partners is missing. Install it to use the system default."));
+            return;
+        }
+        m_resolving = true;
+        Q_EMIT phaseChanged(i18n("Reading the speech settings from Partners"));
+        m_timer.start(12000);
+        m_resolver.start(partners, {u"resolve"_s, u"--kind"_s, u"speech"_s, u"--program"_s, u"org.kde.kdenlive"_s});
+    } else {
+        startServer({}, QProcessEnvironment::systemEnvironment());
+    }
+}
+
+void VibeSpeechJob::resolved(int exitCode, QProcess::ExitStatus status)
+{
+    if (!m_running) {
+        return;
+    }
+    m_timer.stop();
+    m_resolving = false;
+    QString engine;
+    QString model;
+    QProcessEnvironment environment = QProcessEnvironment::systemEnvironment();
+    static const QRegularExpression environmentName(u"^[A-Z_][A-Z0-9_]*$"_s);
+    const auto lines = QString::fromUtf8(m_resolver.readAllStandardOutput()).split(u'\n');
+    for (const QString &line : lines) {
+        const qsizetype separator = line.indexOf(u'=');
+        if (separator <= 0) {
+            continue;
+        }
+        const QString key = line.left(separator);
+        const QString value = line.mid(separator + 1);
+        if (key == "PARTNER_INTERFACE"_L1) {
+            engine = value;
+        } else if (key == "PARTNER_MODEL"_L1) {
+            model = value;
+        } else if (!key.startsWith("PARTNER_"_L1) && environmentName.match(key).hasMatch()) {
+            environment.insert(key, value);
+        }
+    }
+    if (status != QProcess::NormalExit || (exitCode != 0 && (exitCode != 1 || !model.isEmpty()))) {
+        complete(i18n("Could not use the speech settings from Partners: %1", QString::fromUtf8(m_resolver.readAllStandardError()).trimmed()));
+        return;
+    }
+    if (engine != "vibe-local"_L1) {
+        complete(i18n("Select Vibe for speech in System Settings, Partners."));
+        return;
+    }
+    if (!model.isEmpty() && !readableModel(model)) {
+        complete(i18n("Kdenlive cannot read the speech model selected in Partners: %1", model));
+        return;
+    }
+    startServer(model, environment);
+}
+
+void VibeSpeechJob::startServer(const QString &model, const QProcessEnvironment &environment)
+{
+    const QJsonObject settings = vibeStore();
+    const QString selectedModel = model.isEmpty() ? settings.value("model.path"_L1).toString() : model;
+    if (!readableModel(selectedModel)) {
+        complete(i18n("Select an installed model in Vibe. Its large-v3-turbo model is %1. Vibe shows download sizes before you choose.",
+                      QLocale().formattedDataSize(1624555275)));
+        return;
+    }
+    m_language = settings.value("transcription.modelOptions"_L1).toObject().value("lang"_L1).toString().trimmed();
+    if (m_language.compare("auto"_L1, Qt::CaseInsensitive) == 0) {
+        m_language.clear();
+    }
+    m_serverOutput.clear();
+    m_server.setProcessEnvironment(environment);
+    Q_EMIT phaseChanged(i18n("Starting Vibe's speech server"));
+    m_timer.start(180000);
+    m_server.start(m_serverProgram, {u"serve"_s, selectedModel, u"--host"_s, u"127.0.0.1"_s, u"--port"_s, u"0"_s});
+}
+
+void VibeSpeechJob::readServerOutput()
+{
+    const QByteArray output = m_server.readAllStandardOutput();
+    if (!m_running || m_reply) {
+        return;
+    }
+    m_serverOutput.append(output);
+    for (qsizetype end = m_serverOutput.indexOf('\n'); end >= 0; end = m_serverOutput.indexOf('\n')) {
+        const QJsonObject ready = QJsonDocument::fromJson(m_serverOutput.left(end)).object();
+        m_serverOutput.remove(0, end + 1);
+        const int port = ready.value("port"_L1).toInt();
+        if (ready.value("status"_L1).toString() == "ready"_L1 && port > 0 && port <= 65535) {
+            m_timer.stop();
+            postAudio(port);
+            return;
+        }
+    }
+    if (m_serverOutput.size() > 65536) {
+        complete(i18n("Vibe's speech server did not report a valid address."));
+    }
+}
+
+void VibeSpeechJob::postAudio(int port)
+{
+    auto *multipart = new QHttpMultiPart(QHttpMultiPart::FormDataType);
+    auto *file = new QFile(m_audioPath, multipart);
+    if (!file->open(QIODevice::ReadOnly)) {
+        delete multipart;
+        complete(i18n("Audio export failed"));
+        return;
+    }
+    QHttpPart audio;
+    audio.setRawHeader("Content-Disposition", "form-data; name=\"file\"; filename=\"speech.wav\"");
+    audio.setRawHeader("Content-Type", "audio/wav");
+    audio.setBodyDevice(file);
+    multipart->append(audio);
+    multipart->append(field("response_format", "srt"));
+    // In Vibe 3.3.5 detect_language requests detection without transcription.
+    if (!m_language.isEmpty()) {
+        multipart->append(field("language", m_language.toUtf8()));
+    }
+
+    QNetworkRequest request(QUrl(u"http://127.0.0.1:%1/v1/audio/transcriptions"_s.arg(port)));
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+    m_reply = m_network.post(request, multipart);
+    multipart->setParent(m_reply);
+    Q_EMIT phaseChanged(i18n("Recognizing speech with Vibe"));
+    connect(m_reply.data(), &QNetworkReply::finished, this, &VibeSpeechJob::replyFinished);
+}
+
+void VibeSpeechJob::replyFinished()
+{
+    const QByteArray result = m_reply->readAll();
+    const int status = m_reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+    if (m_reply->error() != QNetworkReply::NoError || status != 200) {
+        const QJsonObject error = QJsonDocument::fromJson(result).object().value("error"_L1).toObject();
+        const QString message = error.value("message"_L1).toString();
+        complete(i18n("Vibe could not recognize the speech: %1", message.isEmpty() ? m_reply->errorString() : message));
+        return;
+    }
+    if (!result.contains(" --> ")) {
+        complete(i18n("Vibe returned no timed subtitles."));
+        return;
+    }
+    QSaveFile subtitles(m_subtitlePath);
+    if (!subtitles.open(QIODevice::WriteOnly) || subtitles.write(result) != result.size() || !subtitles.commit()) {
+        complete(i18n("Could not save Vibe's subtitles: %1", subtitles.errorString()));
+        return;
+    }
+    complete({});
+}
+
+void VibeSpeechJob::cancel()
+{
+    if (m_running) {
+        complete(i18n("Speech recognition aborted."));
+    }
+}
+
+void VibeSpeechJob::complete(const QString &error)
+{
+    if (!m_running) {
+        return;
+    }
+    stop();
+    Q_EMIT finished(error);
+}
+
+void VibeSpeechJob::stop()
+{
+    m_running = false;
+    m_resolving = false;
+    m_timer.stop();
+    if (m_reply) {
+        m_reply->disconnect(this);
+        m_reply->abort();
+        m_reply->deleteLater();
+        m_reply.clear();
+    }
+    for (auto *process : {&m_resolver, &m_server}) {
+        if (process->state() != QProcess::NotRunning) {
+            process->terminate();
+            if (!process->waitForFinished(500)) {
+                process->kill();
+                process->waitForFinished(500);
+            }
+        }
+    }
+}
