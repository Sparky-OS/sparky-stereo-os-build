+static void reportSpeechAudioProgress(int phase, int frame = -1)
+{
+    std::fprintf(stdout, "speech-audio %d %d\n", phase, frame);
+    std::fflush(stdout);
+}
+
+static void reportSpeechAudioFrame(mlt_properties, void *data, mlt_event_data eventData)
+{
+    auto *lastFrame = static_cast<std::atomic<int> *>(data);
+    if (auto frame = mlt_event_data_to_frame(eventData)) {
+        lastFrame->store(mlt_frame_get_position(frame), std::memory_order_relaxed);
+    }
+}
