+void SpeechAudioJob::readProgress()
+{
+    while (m_renderer.canReadLine()) {
+        const auto fields = m_renderer.readLine().simplified().split(' ');
+        if (fields.size() != 3 || fields.at(0) != "speech-audio") {
+            continue;
+        }
+        bool phaseOk = false;
+        bool frameOk = false;
+        const int phase = fields.at(1).toInt(&phaseOk);
+        const int frame = fields.at(2).toInt(&frameOk);
+        if (phaseOk && frameOk && (phase > m_phase || (phase == m_phase && frame > m_lastFrame))) {
+            m_phase = phase;
+            m_lastFrame = qMax(m_lastFrame, frame);
+            progressed();
+        }
+    }
+}
+
+void SpeechAudioJob::progressed()
+{
+    m_longestWait = qMax(m_longestWait, m_progress.restart());
+}
