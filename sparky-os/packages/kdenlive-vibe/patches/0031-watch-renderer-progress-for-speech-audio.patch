+namespace
+{
+struct RendererUse
+{
+    qint64 cpuTicks{-1};
+    qint64 cpuMs{-1};
+    int threads{-1};
+};
+
+// The processor time the renderer has used and its number of threads, where the system tells (/proc on Linux).
+RendererUse rendererUse(qint64 pid)
+{
+    RendererUse use;
+#ifdef Q_OS_LINUX
+    QFile stat(QStringLiteral("/proc/%1/stat").arg(pid));
+    if (pid > 0 && stat.open(QIODevice::ReadOnly)) {
+        const QByteArray text = stat.readAll();
+        // The program's name stands in parentheses and may hold spaces: the fields are counted after its last ')'.
+        const QList<QByteArray> fields = text.mid(text.lastIndexOf(')') + 2).split(' ');
+        if (fields.size() > 17) {
+            use.cpuTicks = fields.at(11).toLongLong() + fields.at(12).toLongLong();
+            use.threads = fields.at(17).toInt();
+            const long perSecond = sysconf(_SC_CLK_TCK);
+            use.cpuMs = perSecond > 0 ? use.cpuTicks * 1000 / perSecond : -1;
+        }
+    }
+#else
+    Q_UNUSED(pid)
+#endif
+    return use;
+}
+
+const char *phaseName(int phase)
+{
+    static const char *const names[] = {"not-started", "started", "mlt-ready", "project-loaded", "consumer-made", "consumer-running", "done"};
+    return phase >= 0 && phase <= 6 ? names[phase] : "unknown";
+}
+}
