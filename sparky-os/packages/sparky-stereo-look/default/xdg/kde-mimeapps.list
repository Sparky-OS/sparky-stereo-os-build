# Sparky Stereo OS: VLC Stereo is the default video player (Daniel Ramos, 2026-10-05). The types are the video
# types of vlc-stereo.desktop. The file sits between a user's own ~/.config/mimeapps.list, which still wins,
# and the KDE file of plasma-desktop (/usr/share/applications/kde-mimeapps.list), which names Haruna.
# Audio files keep the KDE default (Elisa).
# Stereo pictures open in Gwenview, the edition's stereo photo viewer (Daniel Ramos, 2026-10-24). Their types come
# from kimageformats-stereo.xml and are sub-classes of JPEG or PNG, so without a line here KDE handed them to any
# JPEG viewer (ImageMagick's display on the A10). Every other viewer stays in Open With.

[Default Applications]
application/vnd.debian.binary-package=debi-tool.desktop
application/x-deb=debi-tool.desktop
image/x-mpo=org.kde.gwenview.desktop
image/x-jps=org.kde.gwenview.desktop
image/x-pns=org.kde.gwenview.desktop
video/3gp=vlc-stereo.desktop
video/3gpp=vlc-stereo.desktop
video/3gpp2=vlc-stereo.desktop
video/avi=vlc-stereo.desktop
video/divx=vlc-stereo.desktop
video/dv=vlc-stereo.desktop
video/fli=vlc-stereo.desktop
video/flv=vlc-stereo.desktop
video/mp2t=vlc-stereo.desktop
video/mp4=vlc-stereo.desktop
video/mp4v-es=vlc-stereo.desktop
video/mpeg=vlc-stereo.desktop
video/mpeg-system=vlc-stereo.desktop
video/msvideo=vlc-stereo.desktop
video/ogg=vlc-stereo.desktop
