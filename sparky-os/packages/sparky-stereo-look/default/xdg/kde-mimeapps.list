# Sparky Stereo OS: VLC Stereo is the default video player (Daniel Ramos, 2026-10-05). The types are the video
# types of vlc-stereo.desktop. The file sits between a user's own ~/.config/mimeapps.list, which still wins,
# and the KDE file of plasma-desktop (/usr/share/applications/kde-mimeapps.list), which names Haruna.
# Audio files keep the KDE default (Elisa).
# Stereo pictures open in Gwenview, the edition's stereo photo viewer (Daniel Ramos, 2026-10-24). Their types come
# from kimageformats-stereo.xml and are sub-classes of JPEG or PNG, so without a line here KDE handed them to any
# JPEG viewer (ImageMagick's display on the A10). Every other viewer stays in Open With.

[Default Applications]
application/vnd.debian.binary-package=debi-tool.desktop
application/x-deb=debi-tool.desktop
image/x-mpo=org.kde.gwenview.desktop
image/x-jps=org.kde.gwenview.desktop
image/x-pns=org.kde.gwenview.desktop
# A 3D model opens in the Stereo Model Viewer, the edition's simple KDE 3D model viewer (ORDER 17, milestone 7). Daniel's words are
# "a simple KDE 3D model viewer" (2026-10-09); that it is the default opener, with F3D in Open With, is the edition's reading of them,
# told to him and not contradicted, not a quoted decision. The types are the viewer's own (its desktop file's MimeType) and the
# models.xml of sparky-stereo-mime-models. A person's own ~/.config/mimeapps.list still wins.
model/gltf-binary=org.sparkystereo.ModelViewer.desktop
model/gltf+json=org.sparkystereo.ModelViewer.desktop
model/obj=org.sparkystereo.ModelViewer.desktop
model/stl=org.sparkystereo.ModelViewer.desktop
model/3mf=org.sparkystereo.ModelViewer.desktop
model/iges=org.sparkystereo.ModelViewer.desktop
model/vrml=org.sparkystereo.ModelViewer.desktop
model/x-ply=org.sparkystereo.ModelViewer.desktop
model/x-gaussian-splat=org.sparkystereo.ModelViewer.desktop
model/x-spz=org.sparkystereo.ModelViewer.desktop
model/x-pts=org.sparkystereo.ModelViewer.desktop
model/x-fbx=org.sparkystereo.ModelViewer.desktop
model/vnd.collada+xml=org.sparkystereo.ModelViewer.desktop
model/x-off=org.sparkystereo.ModelViewer.desktop
model/x-draco=org.sparkystereo.ModelViewer.desktop
model/step=org.sparkystereo.ModelViewer.desktop
model/x-brep=org.sparkystereo.ModelViewer.desktop
image/vnd.dxf=org.sparkystereo.ModelViewer.desktop
video/3gp=vlc-stereo.desktop
