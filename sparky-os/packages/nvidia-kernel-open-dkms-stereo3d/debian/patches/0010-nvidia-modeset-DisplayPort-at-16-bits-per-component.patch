From f3fac9f253c4abfa1d2c6a13c2d4bf6ab07d2117 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Wed, 14 Oct 2026 21:38:35 -0300
Subject: [PATCH 10/11] nvidia-modeset: DisplayPort at 16 bits per component

DisplayPort carries RGB and YCbCr 4:4:4 at 6, 8, 10, 12 and 16 bits per
component: the Main Stream Attributes colour depth field (MISC0 bits
7:5, value 100b for 16 bpc; DisplayPort 1.4a section 2.2.4.3) and the
VSC SDP pixel encoding/colorimetry format (DB17 bits 2:0, 16 bpc; DP
1.4a section 2.2.5.7.5, Table 2-120, the values of dpsdp.h). A sink
declares the depth in EDID 1.4 byte 0x14 bits 6:4 (110b = 16 bpc, parsed
to input.u.digital.bpc = 16 in nvt_edid.c). NVKMS clamped the
EDID depth at 12 in GetMaxOutputColorBpc() and had no 16 bpc arm for
the VSC SDP, so a 16-bit DisplayPort sink ran at 12 bpc.

 - GetMaxOutputColorBpc(): return 16 when the EDID and
   max_output_color_depth both allow it. The DP branch of
   nvDpyGetOutputColorFormatInfo() then offers 16 bpc for RGB and
   YCbCr 4:4:4; the head is programmed with PIXEL_DEPTH_BPP_48_444 by
   the existing nvEvoDpyColorToPixelDepth(), and the DP library gets
   depth = 48 bpp and bitsPerComponent = 16 for its link bandwidth
   check (InitDpModesetParams).
 - GetVscSdpBitDepth(): SDP_VSC_BIT_DEPTH_RGB_16BPC and
   SDP_VSC_BIT_DEPTH_YCBCR_16BPC.
 - GetYuv422MaxBpc(): stay at 12 bpc. The 4:2:2 head depths stop at
   24_422 (12 bpc) and HDMI carries 4:2:2 in a 12-bit container
   (HDMI 1.4b section 6.6), so the new 16 from GetMaxOutputColorBpc()
   is capped there.
 - Active DP-to-HDMI adapters: 16 bpc only when the HDMI VSDB sets
   DC_48bit (hdmiLlcInfo.dc_48_bit), the same way the existing rule
   keeps them at 8 bpc without DC_30bit; otherwise 12 bpc as before.

Sinks that declare up to 12 bpc are unchanged: GetMaxOutputColorBpc()
returns 12 or less for them, the new VSC SDP arms are not reached, and
the 4:2:2 cap only lowers a 16.

If the link has no bandwidth for 48 bpp, nvDPValidateModeEvo() steps
the colour down through nvDowngradeColorFormatAndBpc() (16 to 12 to 10
to 8) as it does today for 12. DSC at 16 bpc is not possible on DP: the
DPCD DSC decoder colour depth capability (DPCD 0006Ah) has no 16 bpc
bit and the PPS generator accepts 8, 10 and 12 only, so the DP library
reports the DSC attempt as not possible and the uncompressed check or
the downgrade decides.

Not verified on hardware: no 16 bpc DisplayPort sink is at hand. The
MSA colour depth itself is generated by the SOR from the head's pixel
depth; NVKMS writes no MISC0 field (the MSA override control has none).
Build-tested only.

Assisted-by: Claude Fable via Claude Code
---
 src/nvidia-modeset/src/nvkms-dpy.c | 35 ++++++++++++++++++++++++++++--
 1 file changed, 33 insertions(+), 2 deletions(-)

diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 29f6a37..9379d8c 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -2908,6 +2908,8 @@ static NvU8 GetVscSdpBitDepth(
 {
     if (format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_RGB) {
         switch (bpc) {
+            case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_16:
+                return SDP_VSC_BIT_DEPTH_RGB_16BPC;
             case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12:
                 return SDP_VSC_BIT_DEPTH_RGB_12BPC;
             case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_10:
@@ -2922,6 +2924,8 @@ static NvU8 GetVscSdpBitDepth(
         }
     } else {
         switch (bpc) {
+            case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_16:
+                return SDP_VSC_BIT_DEPTH_YCBCR_16BPC;
             case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12:
                 return SDP_VSC_BIT_DEPTH_YCBCR_12BPC;
             case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_10:
@@ -3612,7 +3616,10 @@ static enum NvKmsDpyAttributeColorBpcValue GetMaxOutputColorBpc(
     const NvU32 moduleParamBpc = nvkms_max_output_color_bpc();
     const NvU32 maxBpc = NV_MIN(edidBpc, moduleParamBpc);
 
-    if (maxBpc >= 12) {
+    /* EDID 1.4 byte 0x14 bits 6:4 declare 6, 8, 10, 12, 14 or 16 bpc. */
+    if (maxBpc >= 16) {
+        return NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_16;
+    } else if (maxBpc >= 12) {
         return NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12;
     } else if (maxBpc >= 10) {
         return NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_10;
@@ -3637,7 +3644,13 @@ static enum NvKmsDpyAttributeColorBpcValue GetYuv422MaxBpc(
 
     if (pDpyEvo->parsedEdid.info.version >= NVT_EDID_VER_1_4) {
         if (pDpyEvo->parsedEdid.info.u.feature_ver_1_4_digital.support_ycrcb_422) {
-            return GetMaxOutputColorBpc(&pDpyEvo->parsedEdid.info);
+            /*
+             * The 4:2:2 pixel depths stop at 24 bits per pixel (12 bpc):
+             * there is no 32_422 head depth and HDMI carries 4:2:2 in a
+             * 12-bit container.
+             */
+            return NV_MIN(GetMaxOutputColorBpc(&pDpyEvo->parsedEdid.info),
+                          NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12);
         }
     } else {
         nvAssert(!nvConnectorUsesDPLib(pDpyEvo->pConnectorEvo));
@@ -3782,6 +3795,24 @@ NvKmsDpyOutputColorFormatInfo nvDpyGetOutputColorFormatInfo(
                     colorFormatsInfo.yuv444.maxBpc =
                         NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8;
                 }
+
+                /*
+                 * 16 BPC through an active DP-to-HDMI adapter needs the
+                 * HDMI side to declare 48-bit Deep Colour (DC_48bit in the
+                 * HDMI VSDB); otherwise stop at 12 BPC.
+                 */
+                if (!info->hdmiLlcInfo.dc_48_bit) {
+                    if (colorFormatsInfo.rgb444.maxBpc ==
+                        NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_16) {
+                        colorFormatsInfo.rgb444.maxBpc =
+                            NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12;
+                    }
+                    if (colorFormatsInfo.yuv444.maxBpc ==
+                        NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_16) {
+                        colorFormatsInfo.yuv444.maxBpc =
+                            NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12;
+                    }
+                }
             }
         } else {
             if (nvDpyIsHdmiDepth48Evo(pDpyEvo)) {
-- 
