# Debian's real detector (Hardware Setup chains it). Without this record the
# src:nvidia-graphics-drivers records below pick NVIDIA's documentation-only
# nvidia-detect, which has no command. apt_preferences(5): "The first
# specific-form record matching an available package version determines the
# priority of the package version"; 1010 is above the 1005 of the NVIDIA
# dummy, which does not come from Debian's archive and so skips this record.
Package: nvidia-detect
Pin: release o=Debian
Pin-Priority: 1010

Package: nvidia-kernel-open-dkms nvidia-kernel-dkms nvidia-open-kernel-dkms
Pin: version *
Pin-Priority: -1

Package: nvidia-kernel-open-dkms-stereo3d src:nvidia-graphics-drivers:any src:nvidia-open:any cuda-drivers* src:nvidia-modprobe src:nvidia-persistenced src:nvidia-settings src:nvidia-xconfig src:libnvidia-nscq src:libnvsdm src:nvidia-fabricmanager src:nvidia-imex
Pin: version @NV_VERSION@*
Pin-Priority: 1005

Package: nvidia-kernel-open-dkms-stereo3d src:nvidia-graphics-drivers:any src:nvidia-open:any cuda-drivers* src:nvidia-modprobe src:nvidia-persistenced src:nvidia-settings src:nvidia-xconfig src:libnvidia-nscq src:libnvsdm src:nvidia-fabricmanager src:nvidia-imex
Pin: version *
Pin-Priority: 100

Package: sparky-stereo-nvidia-driver-lock
Pin: release o=Sparky Stereo OS
Pin-Priority: 1001
