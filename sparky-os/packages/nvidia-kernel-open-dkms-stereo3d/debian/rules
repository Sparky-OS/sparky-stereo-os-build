#!/usr/bin/make -f
include /usr/share/dpkg/pkg-info.mk

# NVIDIA's version of the driver this build carries (615.71.09-2 for 615.71.09-2+stereo3d4):
# the control fields and the APT lock are generated from it.
NV_VERSION := $(firstword $(subst +stereo3d, ,$(DEB_VERSION)))
NV_UPSTREAM := $(DEB_VERSION_UPSTREAM)
MOD := debian/nvidia-kernel-open-dkms-stereo3d
LOCK := debian/sparky-stereo-nvidia-driver-lock

%:
	dh $@ --with dkms

override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_clean:

override_dh_auto_install:
	mkdir -p $(MOD)/usr/src/nvidia-$(NV_UPSTREAM)
	tar --exclude=./debian --exclude=./.pc -cf - . | tar -xf - -C $(MOD)/usr/src/nvidia-$(NV_UPSTREAM)
	mkdir -p $(LOCK)/etc/apt/preferences.d
	sed 's/@NV_VERSION@/$(NV_VERSION)/g' debian/nvidia-driver-lock.in >$(LOCK)/etc/apt/preferences.d/10sparky-stereo-nvidia-driver-lock

override_dh_dkms:
	dh_dkms -p nvidia-kernel-open-dkms-stereo3d -V $(NV_UPSTREAM)

override_dh_gencontrol:
	dh_gencontrol -- -Vnvidia:Version=$(NV_VERSION) -Vnvidia:Upstream=$(NV_UPSTREAM)
