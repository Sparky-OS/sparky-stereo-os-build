Package: nvidia-kernel-open-dkms-stereo3d
Architecture: amd64
Multi-Arch: foreign
Pre-Depends: nvidia-installer-cleanup
Depends: dkms (>= 3.1.8), firmware-nvidia-gsp (= ${nvidia:Version}), g++, sparky-stereo-nvidia-driver-lock (>= ${source:Version}), ${misc:Depends}
Recommends: nvidia-driver (= ${nvidia:Version}) | nvidia-driver-cuda (= ${nvidia:Version}), nvidia-kernel-support
Breaks: nvidia-kernel-dkms (<< ${nvidia:Version})
Conflicts: nvidia-kernel-open-dkms
