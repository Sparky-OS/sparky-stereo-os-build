+//! The synchronized folder as an entry of the file manager's Places on KDE.
+//!
+//! KDE file dialogs, Dolphin and the Places panel read `$XDG_DATA_HOME/user-places.xbel`
+//! (XBEL with the freedesktop.org bookmark extensions). An entry is added only when the
+//! person asks for it and only to a file KDE already created; the rest of the file is
+//! kept byte for byte, and the file is replaced atomically.
+use adw::gtk::glib;
+use std::path::PathBuf;
+
+fn file() -> PathBuf {
+    glib::user_data_dir().join("user-places.xbel")
+}
+
+/// True when the desktop keeps KDE Places for this person.
+pub(crate) fn available() -> bool {
+    file().is_file()
+}
+
+fn escape(text: &str) -> String {
+    text.replace('&', "&amp;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+        .replace('"', "&quot;")
+}
+
+/// Adds `uri` under `title`. Returns `Ok(false)` when the entry already exists.
+pub(crate) fn add(uri: &str, title: &str) -> Result<bool, String> {
+    let path = file();
+    let text = std::fs::read_to_string(&path).map_err(|error| error.to_string())?;
+    let href = escape(uri);
+    if text.contains(&format!("href=\"{href}\"")) {
+        return Ok(false);
+    }
+    let end = text
+        .rfind("</xbel>")
+        .ok_or_else(|| "user-places.xbel has no closing xbel element".to_owned())?;
+    let icon = if text.contains("xmlns:bookmark=") {
+        "   <metadata owner=\"http://freedesktop.org\">\n    <bookmark:icon name=\"folder-gdrive\"/>\n   </metadata>\n"
+    } else {
+        ""
+    };
+    let id = format!("{}/{}", glib::real_time() / 1_000_000, std::process::id());
+    let entry = format!(
+        " <bookmark href=\"{href}\">\n  <title>{}</title>\n  <info>\n{icon}   <metadata owner=\"http://www.kde.org\">\n    <ID>{id}</ID>\n    <isSystemItem>false</isSystemItem>\n   </metadata>\n  </info>\n </bookmark>\n",
+        escape(title)
+    );
+    let mut updated = String::with_capacity(text.len() + entry.len());
+    updated.push_str(&text[..end]);
+    updated.push_str(&entry);
+    updated.push_str(&text[end..]);
+    glib::file_set_contents(&path, updated.as_bytes()).map_err(|error| error.to_string())?;
+    Ok(true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn adds_once_and_keeps_the_rest() {
+        let home = std::env::temp_dir().join(format!("drivesync-places-{}", std::process::id()));
+        std::fs::create_dir_all(&home).unwrap();
+        std::env::set_var("XDG_DATA_HOME", &home);
+        let original = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xbel xmlns:bookmark=\"http://www.freedesktop.org/standards/desktop-bookmarks\">\n <bookmark href=\"file:///home/a\">\n  <title>Home</title>\n </bookmark>\n</xbel>\n";
+        let path = home.join("user-places.xbel");
+        std::fs::write(&path, original).unwrap();
+        if glib::user_data_dir() != home {
+            // GLib caches the data directory at first use; nothing more can be checked here.
+            return;
+        }
+        assert_eq!(
+            add("file:///home/a/Drive%20&%20more", "Drive <A>"),
+            Ok(true)
+        );
+        assert_eq!(
+            add("file:///home/a/Drive%20&%20more", "Drive <A>"),
+            Ok(false)
+        );
+        let text = std::fs::read_to_string(&path).unwrap();
+        assert!(text.starts_with(&original[..original.len() - "</xbel>\n".len()]));
+        assert!(text.contains("href=\"file:///home/a/Drive%20&amp;%20more\""));
+        assert!(text.contains("<title>Drive &lt;A&gt;</title>"));
+        assert!(text.ends_with("</xbel>\n"));
+        std::fs::remove_dir_all(&home).unwrap();
+    }
+}
