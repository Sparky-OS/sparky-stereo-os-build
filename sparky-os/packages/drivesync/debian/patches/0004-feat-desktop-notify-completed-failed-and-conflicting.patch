+++ b/src/application/desktop/notifications.rs
@@ -0,0 +1,72 @@
+//! Desktop notifications for synchronization outcomes.
+//!
+//! Each account keeps one notification per kind, replaced rather than repeated, and every
+//! notification opens the window, where the item that needs attention stays listed.
+use super::status::Event;
+use adw::{gtk::gio, prelude::*};
+use gettextrs::gettext;
+
+pub(crate) struct Notifier {
+    app: adw::gtk::glib::WeakRef<adw::Application>,
+}
+
+impl Notifier {
+    pub(crate) fn new(app: &adw::Application) -> Self {
+        Self {
+            app: app.downgrade(),
+        }
+    }
+
+    fn send(&self, id: &str, notification: &gio::Notification) {
+        if let Some(app) = self.app.upgrade() {
+            notification.set_default_action("app.show");
+            notification.add_button(&gettext("Open DriveSync"), "app.show");
+            app.send_notification(Some(id), notification);
+        }
+    }
+
+    /// Reports one account's transition. `account` is the name the person gave it.
+    pub(crate) fn event(&self, account_id: &str, account: &str, event: Event) {
+        let (kind, title, body, priority) = match event {
+            Event::Completed => (
+                "completed",
+                gettext("Google Drive is up to date"),
+                gettext("{account}: the changes were synchronized.").replace("{account}", account),
+                gio::NotificationPriority::Normal,
+            ),
+            Event::Failed => (
+                "failed",
+                gettext("Synchronization failed"),
+                gettext("{account}: an item could not be synchronized. It stays listed in DriveSync until it is resolved.")
+                    .replace("{account}", account),
+                gio::NotificationPriority::High,
+            ),
+            Event::Conflict => (
+                "conflict",
+                gettext("A file changed on both sides"),
+                gettext("{account}: choose which version to keep. Nothing was overwritten.")
+                    .replace("{account}", account),
+                gio::NotificationPriority::High,
+            ),
+            Event::Attention => (
+                "attention",
+                gettext("DriveSync needs your decision"),
+                gettext("{account}: synchronization waits until you review the folder in DriveSync.")
+                    .replace("{account}", account),
+                gio::NotificationPriority::High,
+            ),
+        };
+        let notification = gio::Notification::new(&title);
+        notification.set_body(Some(&body));
+        notification.set_priority(priority);
+        if let Some(app) = self.app.upgrade() {
+            // A completed run supersedes an earlier failure or conflict of the same account.
+            if event == Event::Completed {
+                for old in ["failed", "conflict", "attention"] {
+                    app.withdraw_notification(&format!("sync-{old}-{account_id}"));
+                }
+            }
+        }
+        self.send(&format!("sync-{kind}-{account_id}"), &notification);
+    }
+}
