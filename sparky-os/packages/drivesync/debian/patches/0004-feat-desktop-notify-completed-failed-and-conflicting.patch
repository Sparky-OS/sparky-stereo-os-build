 use drivesync_engine::{
     SynchronizationIssueKind as Kind, SynchronizationState as State, SynchronizationStatus,
 };
@@ -24,6 +25,27 @@ pub(crate) enum Phase {
     Failed,
 }
 
+/// A transition worth one notification.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Event {
+    Completed,
+    Failed,
+    Conflict,
+    Attention,
+}
+
+impl Event {
+    /// The phase the event reports; it is told only while the account is still in it.
+    pub(crate) fn phase(self) -> Phase {
+        match self {
+            Event::Completed => Phase::Idle,
+            Event::Failed => Phase::Failed,
+            Event::Conflict => Phase::Conflict,
+            Event::Attention => Phase::Attention,
+        }
+    }
+}
+
 /// Classifies one status. Retryable waits stay `Working`; only blockers that need the
 /// person, or failures that are not retried, leave it.
 pub(crate) fn classify(status: &SynchronizationStatus) -> Phase {
@@ -84,6 +106,52 @@ impl Phase {
     }
 }
 
+/// Follows one account's statuses and reports transitions.
+#[derive(Debug, Default)]
+pub(crate) struct Tracker {
+    phase: Phase,
+    /// A confirmed operation was dispatched since the account was last idle.
+    changed: bool,
+}
+
+impl Tracker {
+    pub(crate) fn phase(&self) -> Phase {
+        self.phase
+    }
+
+    /// Records that the account's worker could not be opened.
+    pub(crate) fn fail(&mut self) -> Option<Event> {
+        self.changed = false;
+        (std::mem::replace(&mut self.phase, Phase::Failed) != Phase::Failed)
+            .then_some(Event::Failed)
+    }
+
+    /// Records a status and returns the event its transition deserves, if any.
+    pub(crate) fn update(&mut self, status: &SynchronizationStatus) -> Option<Event> {
+        let next = classify(status);
+        if status.current_operation.is_some() {
+            self.changed = true;
+        }
+        let previous = std::mem::replace(&mut self.phase, next);
+        if previous == next {
+            return None;
+        }
+        match next {
+            Phase::Idle if previous == Phase::Working && std::mem::take(&mut self.changed) => {
+                Some(Event::Completed)
+            }
+            Phase::Idle | Phase::Stopped => {
+                self.changed = false;
+                None
+            }
+            Phase::Failed => Some(Event::Failed),
+            Phase::Conflict => Some(Event::Conflict),
+            Phase::Attention => Some(Event::Attention),
+            Phase::Working => None,
+        }
+    }
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
@@ -148,4 +216,31 @@ mod tests {
             Phase::Conflict
         );
     }
+
+    #[test]
+    fn completion_is_reported_once_and_only_after_changes() {
+        let mut tracker = Tracker::default();
+        assert_eq!(tracker.update(&status(State::Running, None, false)), None);
+        assert_eq!(tracker.update(&status(State::Idle, None, false)), None);
+        assert_eq!(tracker.update(&status(State::Running, None, true)), None);
+        assert_eq!(
+            tracker.update(&status(State::Idle, None, false)),
+            Some(Event::Completed)
+        );
+        assert_eq!(tracker.update(&status(State::Idle, None, false)), None);
+    }
+
+    #[test]
+    fn failures_and_conflicts_are_reported_on_entry() {
+        let mut tracker = Tracker::default();
+        let failed = status(State::Failed, None, false);
+        assert_eq!(tracker.update(&failed), Some(Event::Failed));
+        assert_eq!(tracker.update(&failed), None);
+        let conflict = status(State::Waiting, Some((Kind::Conflict, false)), false);
+        assert_eq!(tracker.update(&conflict), Some(Event::Conflict));
+        assert_eq!(
+            Phase::most_urgent([Phase::Idle, Phase::Conflict, Phase::Working]),
+            Phase::Conflict
+        );
+    }
 }
