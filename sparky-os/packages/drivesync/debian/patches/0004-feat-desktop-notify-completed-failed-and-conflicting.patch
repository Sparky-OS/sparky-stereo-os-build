+
+/// Tells an event once its phase has lasted SETTLE, and a failure, conflict or decision only
+/// once until the account is idle again; the window keeps listing the item meanwhile.
+async fn tell(shared: std::rc::Weak<Shared>, id: String, event: Event) {
+    glib::timeout_future(SETTLE).await;
+    let Some(shared) = shared.upgrade() else {
+        return;
+    };
+    let name = {
+        let mut accounts = shared.accounts.borrow_mut();
+        let Some(entry) = accounts.get_mut(&id) else {
+            return;
+        };
+        if entry.phase != event.phase() || entry.told.contains(&event) {
+            return;
+        }
+        if event != Event::Completed {
+            entry.told.push(event);
+        }
+        entry.name.clone()
+    };
+    shared.notifier.event(&id, &name, event);
+}
