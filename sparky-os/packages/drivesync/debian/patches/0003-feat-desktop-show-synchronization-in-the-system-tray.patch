+//! System tray entry through the StatusNotifierItem D-Bus interface (KDE Plasma and other
+//! hosts of `org.kde.StatusNotifierWatcher`), with its menu exported as `com.canonical.dbusmenu`.
+//!
+//! The item exists only while a watcher with a registered host is present; without one the
+//! application keeps its portal-based background behaviour. All D-Bus traffic runs on the
+//! GTK main context.
+use super::status::Phase;
+use adw::{
+    gtk::{gio, glib},
+    prelude::*,
+};
+use gettextrs::gettext;
+use std::{cell::RefCell, collections::HashMap, rc::Rc};
+
+const WATCHER: &str = "org.kde.StatusNotifierWatcher";
+const WATCHER_PATH: &str = "/StatusNotifierWatcher";
+const ITEM_PATH: &str = "/StatusNotifierItem";
+const MENU_PATH: &str = "/MenuBar";
+const ITEM_INTERFACE: &str = "org.kde.StatusNotifierItem";
+const MENU_INTERFACE: &str = "com.canonical.dbusmenu";
+
+const XML: &str = r#"<node>
+  <interface name="org.kde.StatusNotifierItem">
+    <property name="Category" type="s" access="read"/>
+    <property name="Id" type="s" access="read"/>
+    <property name="Title" type="s" access="read"/>
+    <property name="Status" type="s" access="read"/>
+    <property name="WindowId" type="i" access="read"/>
+    <property name="IconName" type="s" access="read"/>
+    <property name="IconPixmap" type="a(iiay)" access="read"/>
+    <property name="OverlayIconName" type="s" access="read"/>
+    <property name="OverlayIconPixmap" type="a(iiay)" access="read"/>
+    <property name="AttentionIconName" type="s" access="read"/>
+    <property name="AttentionIconPixmap" type="a(iiay)" access="read"/>
+    <property name="AttentionMovieName" type="s" access="read"/>
+    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
+    <property name="ItemIsMenu" type="b" access="read"/>
+    <property name="Menu" type="o" access="read"/>
+    <property name="IconThemePath" type="s" access="read"/>
+    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
+    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
+    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
+    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
+    <signal name="NewTitle"/>
+    <signal name="NewIcon"/>
+    <signal name="NewAttentionIcon"/>
+    <signal name="NewOverlayIcon"/>
+    <signal name="NewToolTip"/>
+    <signal name="NewStatus"><arg name="status" type="s"/></signal>
+  </interface>
+  <interface name="com.canonical.dbusmenu">
+    <property name="Version" type="u" access="read"/>
+    <property name="TextDirection" type="s" access="read"/>
+    <property name="Status" type="s" access="read"/>
+    <property name="IconThemePath" type="as" access="read"/>
+    <method name="GetLayout">
+      <arg name="parentId" type="i" direction="in"/>
+      <arg name="recursionDepth" type="i" direction="in"/>
+      <arg name="propertyNames" type="as" direction="in"/>
+      <arg name="revision" type="u" direction="out"/>
+      <arg name="layout" type="(ia{sv}av)" direction="out"/>
+    </method>
+    <method name="GetGroupProperties">
+      <arg name="ids" type="ai" direction="in"/>
+      <arg name="propertyNames" type="as" direction="in"/>
+      <arg name="properties" type="a(ia{sv})" direction="out"/>
+    </method>
+    <method name="GetProperty">
+      <arg name="id" type="i" direction="in"/>
+      <arg name="name" type="s" direction="in"/>
+      <arg name="value" type="v" direction="out"/>
+    </method>
+    <method name="Event">
+      <arg name="id" type="i" direction="in"/>
+      <arg name="eventId" type="s" direction="in"/>
+      <arg name="data" type="v" direction="in"/>
+      <arg name="timestamp" type="u" direction="in"/>
+    </method>
+    <method name="EventGroup">
+      <arg name="events" type="a(isvu)" direction="in"/>
+      <arg name="idErrors" type="ai" direction="out"/>
+    </method>
+    <method name="AboutToShow">
+      <arg name="id" type="i" direction="in"/>
+      <arg name="needUpdate" type="b" direction="out"/>
+    </method>
+    <method name="AboutToShowGroup">
+      <arg name="ids" type="ai" direction="in"/>
+      <arg name="updatesNeeded" type="ai" direction="out"/>
+      <arg name="idErrors" type="ai" direction="out"/>
+    </method>
+    <signal name="ItemsPropertiesUpdated">
+      <arg name="updatedProps" type="a(ia{sv})"/>
+      <arg name="removedProps" type="a(ias)"/>
+    </signal>
+    <signal name="LayoutUpdated"><arg name="revision" type="u"/><arg name="parent" type="i"/></signal>
+    <signal name="ItemActivationRequested"><arg name="id" type="i"/><arg name="timestamp" type="u"/></signal>
+  </interface>
+</node>"#;
+
+/// Menu entries: identifier, label and the application action it activates.
+const OPEN: i32 = 1;
+const SEPARATOR: i32 = 2;
+const QUIT: i32 = 3;
+
+#[derive(Default)]
+struct State {
+    phase: Phase,
+    held: bool,
+    detail: String,
+    connection: Option<gio::DBusConnection>,
+    hosted: bool,
+}
+
+/// One status notifier item for the application instance.
+#[derive(Clone)]
+pub(crate) struct Tray {
+    app: glib::WeakRef<adw::Application>,
+    state: Rc<RefCell<State>>,
+    name: Rc<String>,
+}
+
+impl Tray {
+    pub(crate) fn new(app: &adw::Application) -> Self {
+        let tray = Self {
+            app: app.downgrade(),
+            state: Rc::default(),
+            name: Rc::new(format!(
+                "org.kde.StatusNotifierItem-{}-1",
+                std::process::id()
+            )),
+        };
+        tray.start();
+        tray
+    }
+
+    /// True while a tray host shows this item, so closing the window can hide it there.
+    pub(crate) fn is_hosted(&self) -> bool {
+        self.state.borrow().hosted
+    }
+
+    /// Updates the icon state and tooltip; emits the item's change signals.
+    pub(crate) fn set_status(&self, phase: Phase, held: bool, detail: String) {
+        {
+            let mut state = self.state.borrow_mut();
+            if state.phase == phase && state.held == held && state.detail == detail {
+                return;
+            }
+            state.phase = phase;
+            state.held = held;
+            state.detail = detail;
+        }
+        let connection = self.state.borrow().connection.clone();
+        if let Some(connection) = connection {
+            for signal in ["NewIcon", "NewOverlayIcon", "NewToolTip"] {
+                let _ = connection.emit_signal(None, ITEM_PATH, ITEM_INTERFACE, signal, None);
+            }
+            let status = self.status_name();
+            let _ = connection.emit_signal(
+                None,
+                ITEM_PATH,
+                ITEM_INTERFACE,
+                "NewStatus",
+                Some(&(status,).to_variant()),
+            );
+        }
+    }
+
+    fn status_name(&self) -> &'static str {
+        let state = self.state.borrow();
+        match state.phase {
+            Phase::Failed | Phase::Conflict | Phase::Attention => "NeedsAttention",
+            _ => "Active",
+        }
+    }
+
+    fn overlay(&self) -> &'static str {
+        let state = self.state.borrow();
+        if state.held {
+            return "media-playback-pause";
+        }
+        match state.phase {
+            Phase::Failed => "emblem-error",
+            Phase::Conflict | Phase::Attention => "emblem-warning",
+            Phase::Working => "emblem-synchronizing",
+            Phase::Idle | Phase::Stopped => "",
+        }
+    }
+
+    fn summary(&self) -> String {
+        let state = self.state.borrow();
+        if state.held {
+            return gettext("Synchronization waits: the connection is metered");
+        }
+        match state.phase {
+            Phase::Stopped => gettext("Synchronization is not running"),
+            Phase::Idle => gettext("Google Drive is up to date"),
+            Phase::Working => gettext("Synchronizing with Google Drive…"),
+            Phase::Conflict => gettext("A file changed on both sides"),
+            Phase::Attention => gettext("DriveSync needs your decision"),
+            Phase::Failed => gettext("Synchronization failed"),
+        }
+    }
+
+    fn start(&self) {
+        let tray = self.clone();
+        let tray_lost = self.clone();
+        // The watch lives as long as the application; plasmashell restarting re-registers.
+        let _ = gio::bus_watch_name(
+            gio::BusType::Session,
+            WATCHER,
+            gio::BusNameWatcherFlags::NONE,
+            move |connection, _, _| tray.register(connection),
+            move |_, _| tray_lost.state.borrow_mut().hosted = false,
+        );
+    }
+
+    /// Exports the item once per connection and registers it with the watcher.
+    fn register(&self, connection: gio::DBusConnection) {
+        if self.state.borrow().connection.is_none() {
+            if let Err(error) = self.export(&connection) {
+                glib::g_warning!("drivesync", "Status notifier item unavailable: {error}");
+                return;
+            }
+            let _ = gio::bus_own_name_on_connection(
+                &connection,
+                &self.name,
+                gio::BusNameOwnerFlags::NONE,
+                |_, _| {},
+                |_, _| {},
+            );
+            self.state.borrow_mut().connection = Some(connection.clone());
+        }
+        let tray = self.clone();
+        let name = self.name.to_string();
+        glib::spawn_future_local(async move {
+            let registered = connection
+                .call_future(
+                    Some(WATCHER),
+                    WATCHER_PATH,
+                    WATCHER,
+                    "RegisterStatusNotifierItem",
+                    Some(&(name,).to_variant()),
+                    None,
+                    gio::DBusCallFlags::NONE,
+                    5_000,
+                )
+                .await
+                .is_ok();
+            let host = connection
+                .call_future(
+                    Some(WATCHER),
+                    WATCHER_PATH,
+                    "org.freedesktop.DBus.Properties",
+                    "Get",
+                    Some(&(WATCHER, "IsStatusNotifierHostRegistered").to_variant()),
+                    None,
+                    gio::DBusCallFlags::NONE,
+                    5_000,
+                )
+                .await
+                .ok()
+                .and_then(|reply| reply.child_value(0).as_variant())
+                .and_then(|value| value.get::<bool>())
+                .unwrap_or(false);
+            tray.state.borrow_mut().hosted = registered && host;
+        });
+    }
+
+    fn export(&self, connection: &gio::DBusConnection) -> Result<(), glib::Error> {
+        let node = gio::DBusNodeInfo::for_xml(XML)?;
+        let item = node
+            .lookup_interface(ITEM_INTERFACE)
+            .expect("item interface is declared");
+        let menu = node
+            .lookup_interface(MENU_INTERFACE)
+            .expect("menu interface is declared");
+        let tray = self.clone();
+        let tray_properties = self.clone();
+        connection
+            .register_object(ITEM_PATH, &item)
+            .method_call(move |_, _, _, _, method, _, invocation| {
+                match method {
+                    "Activate" | "SecondaryActivate" => tray.activate("show"),
+                    _ => {}
+                }
+                invocation.return_value(None);
+            })
+            .property(move |_, _, _, _, property| tray_properties.item_property(property))
+            .build()?;
+        let tray = self.clone();
+        connection
+            .register_object(MENU_PATH, &menu)
+            .method_call(move |_, _, _, _, method, parameters, invocation| {
+                tray.menu_call(method, &parameters, invocation)
+            })
+            .property(|_, _, _, _, property| match property {
+                "Version" => 3u32.to_variant(),
+                "TextDirection" => "ltr".to_variant(),
+                "Status" => "normal".to_variant(),
+                _ => Vec::<String>::new().to_variant(),
+            })
+            .build()?;
+        Ok(())
+    }
+
+    fn item_property(&self, property: &str) -> glib::Variant {
+        let none: Vec<(i32, i32, Vec<u8>)> = Vec::new();
+        match property {
+            "Category" => "ApplicationStatus".to_variant(),
+            "Id" => crate::application::APP_ID.to_variant(),
+            "Title" => "DriveSync".to_variant(),
+            "Status" => self.status_name().to_variant(),
+            "WindowId" => 0i32.to_variant(),
+            "IconName" => crate::application::APP_ID.to_variant(),
+            "OverlayIconName" => self.overlay().to_variant(),
+            "AttentionIconName" => crate::application::APP_ID.to_variant(),
+            "AttentionMovieName" | "IconThemePath" => "".to_variant(),
+            "ToolTip" => {
+                let detail = self.state.borrow().detail.clone();
+                (crate::application::APP_ID, none, self.summary(), detail).to_variant()
+            }
+            "ItemIsMenu" => false.to_variant(),
+            "Menu" => glib::variant::ObjectPath::try_from(MENU_PATH)
+                .expect("constant object path is valid")
+                .to_variant(),
+            _ => none.to_variant(),
+        }
+    }
+
+    fn entry(id: i32) -> glib::Variant {
+        let mut properties: HashMap<String, glib::Variant> = HashMap::new();
+        match id {
+            OPEN => {
+                properties.insert("label".into(), gettext("Open DriveSync").to_variant());
+            }
+            SEPARATOR => {
+                properties.insert("type".into(), "separator".to_variant());
+            }
+            QUIT => {
+                properties.insert("label".into(), gettext("Quit").to_variant());
+                properties.insert("icon-name".into(), "application-exit".to_variant());
+            }
+            _ => {
+                properties.insert("children-display".into(), "submenu".to_variant());
+            }
+        }
+        let children: Vec<glib::Variant> = if id == 0 {
+            // Each element of an `av` is boxed once by the array itself.
+            [OPEN, SEPARATOR, QUIT]
+                .into_iter()
+                .map(Self::entry)
+                .collect()
+        } else {
+            Vec::new()
+        };
+        (id, properties, children).to_variant()
+    }
+
+    /// GetLayout's reply, `(u(ia{sv}av))`: the layout is a structure, not a boxed variant.
+    fn layout(parent: i32) -> glib::Variant {
+        glib::Variant::tuple_from_iter([1u32.to_variant(), Self::entry(parent)])
+    }
+
+    fn menu_call(
+        &self,
+        method: &str,
+        parameters: &glib::Variant,
+        invocation: gio::DBusMethodInvocation,
+    ) {
+        match method {
+            "GetLayout" => {
+                let parent = parameters.child_value(0).get::<i32>().unwrap_or(0);
+                invocation.return_value(Some(&Self::layout(parent)));
+            }
+            "GetGroupProperties" => {
+                let ids = parameters
+                    .child_value(0)
+                    .get::<Vec<i32>>()
+                    .unwrap_or_default();
+                let entries: Vec<(i32, HashMap<String, glib::Variant>)> = ids
+                    .into_iter()
+                    .filter_map(|id| {
+                        Self::entry(id)
+                            .child_value(1)
+                            .get::<HashMap<String, glib::Variant>>()
+                            .map(|properties| (id, properties))
+                    })
+                    .collect();
+                invocation.return_value(Some(&(entries,).to_variant()));
+            }
+            "GetProperty" => {
+                let id = parameters.child_value(0).get::<i32>().unwrap_or(0);
+                let name = parameters
+                    .child_value(1)
+                    .get::<String>()
+                    .unwrap_or_default();
+                let value = glib::VariantDict::new(Some(&Self::entry(id).child_value(1)))
+                    .lookup_value(&name, None)
+                    .unwrap_or_else(|| "".to_variant());
+                invocation.return_value(Some(&(value.to_variant(),).to_variant()));
+            }
+            "Event" => {
+                let id = parameters.child_value(0).get::<i32>().unwrap_or(0);
+                let event = parameters
+                    .child_value(1)
+                    .get::<String>()
+                    .unwrap_or_default();
+                invocation.return_value(None);
+                if event == "clicked" {
+                    self.menu_activated(id);
+                }
+            }
+            "EventGroup" => {
+                let events = parameters.child_value(0);
+                for index in 0..events.n_children() {
+                    let event = events.child_value(index);
+                    if event.child_value(1).get::<String>().as_deref() == Some("clicked") {
+                        self.menu_activated(event.child_value(0).get::<i32>().unwrap_or(0));
+                    }
+                }
+                invocation.return_value(Some(&(Vec::<i32>::new(),).to_variant()));
+            }
+            "AboutToShow" => invocation.return_value(Some(&(false,).to_variant())),
+            "AboutToShowGroup" => {
+                invocation.return_value(Some(&(Vec::<i32>::new(), Vec::<i32>::new()).to_variant()))
+            }
+            _ => invocation
+                .return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", "Unknown method"),
+        }
+    }
+
+    fn menu_activated(&self, id: i32) {
+        match id {
+            OPEN => self.activate("show"),
+            QUIT => self.activate("quit"),
+            _ => {}
+        }
+    }
+
+    fn activate(&self, action: &str) {
+        if let Some(app) = self.app.upgrade() {
+            app.activate_action(action, None);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn menu_replies_have_the_dbusmenu_types() {
+        assert_eq!(Tray::layout(0).type_().as_str(), "(u(ia{sv}av))");
+        let root = Tray::entry(0);
+        assert_eq!(root.child_value(2).n_children(), 3);
+        let open = root.child_value(2).child_value(0).as_variant().unwrap();
+        assert_eq!(open.type_().as_str(), "(ia{sv}av)");
+        assert_eq!(open.child_value(0).get::<i32>(), Some(OPEN));
+    }
+}
