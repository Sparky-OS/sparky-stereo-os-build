diff --git a/src/application/desktop/mod.rs b/src/application/desktop/mod.rs
new file mode 100644
index 0000000..45195f7
--- /dev/null
+++ b/src/application/desktop/mod.rs
@@ -0,0 +1,165 @@
+//! Desktop integration outside the window: a status notifier item in the system tray.
+//!
+//! It observes the public Engine API only; it owns no credentials and decides nothing
+//! about synchronization.
+mod status;
+mod tray;
+
+use super::Context;
+use adw::gtk::glib;
+use drivesync_engine::{Account, Engine, ListAccountsRequest};
+use gettextrs::gettext;
+use status::{classify, Phase};
+use std::{cell::RefCell, collections::HashMap, rc::Rc, time::Duration};
+use tray::Tray;
+
+const ACCOUNTS_REFRESH: Duration = Duration::from_secs(20);
+
+thread_local! { static TRAY: RefCell<Option<Tray>> = const { RefCell::new(None) }; }
+
+/// True while a tray host shows DriveSync, so a closed window can live in the tray.
+pub(crate) fn tray_hosted() -> bool {
+    TRAY.with(|tray| tray.borrow().as_ref().is_some_and(Tray::is_hosted))
+}
+
+struct Watched {
+    name: String,
+    phase: Phase,
+    task: glib::JoinHandle<()>,
+}
+
+struct Shared {
+    tray: Tray,
+    accounts: RefCell<HashMap<String, Watched>>,
+}
+
+impl Shared {
+    fn refresh(&self) {
+        let accounts = self.accounts.borrow();
+        let phase = Phase::most_urgent(accounts.values().map(|watched| watched.phase));
+        let mut lines: Vec<String> = accounts
+            .values()
+            .map(|watched| format!("{}: {}", watched.name, describe(watched.phase)))
+            .collect();
+        lines.sort();
+        self.tray.set_status(phase, false, lines.join("\n"));
+    }
+}
+
+fn describe(phase: Phase) -> String {
+    match phase {
+        Phase::Stopped => gettext("Synchronization is not running"),
+        Phase::Idle => gettext("Google Drive is up to date"),
+        Phase::Working => gettext("Synchronizing with Google Drive…"),
+        Phase::Conflict => gettext("A file changed on both sides"),
+        Phase::Attention => gettext("DriveSync needs your decision"),
+        Phase::Failed => gettext("Synchronization failed"),
+    }
+}
+
+fn account_name(account: &Account) -> String {
+    account
+        .display_name
+        .clone()
+        .or_else(|| account.email.clone())
+        .unwrap_or_else(|| gettext("Google Drive"))
+}
+
+/// Starts the tray item at once and the status observers when the Engine becomes available.
+pub(crate) fn install(app: &adw::Application, context: &Context) {
+    let tray = Tray::new(app);
+    TRAY.with(|slot| *slot.borrow_mut() = Some(tray.clone()));
+    let shared = Rc::new(Shared {
+        tray,
+        accounts: RefCell::default(),
+    });
+    let context = context.clone();
+    glib::spawn_future_local(async move {
+        let engine = loop {
+            if let Some(engine) = context.engine.borrow().clone() {
+                break engine;
+            }
+            glib::timeout_future(Duration::from_millis(250)).await;
+        };
+        start(shared, engine);
+    });
+}
+
+fn start(shared: Rc<Shared>, engine: Engine) {
+    shared.refresh();
+    glib::spawn_future_local(async move {
+        loop {
+            follow_accounts(&shared, &engine).await;
+            glib::timeout_future(ACCOUNTS_REFRESH).await;
+        }
+    });
+}
+
+/// Starts a watcher for each new account and drops the ones that were removed.
+async fn follow_accounts(shared: &Rc<Shared>, engine: &Engine) {
+    let Ok(result) = engine
+        .list_accounts(ListAccountsRequest { provider: None })
+        .await
+    else {
+        return;
+    };
+    let current: HashMap<String, Account> = result
+        .accounts
+        .into_iter()
+        .map(|account| (account.id.0.clone(), account))
+        .collect();
+    {
+        let mut watched = shared.accounts.borrow_mut();
+        watched.retain(|id, entry| {
+            let keep = current.contains_key(id);
+            if !keep {
+                entry.task.abort();
+            }
+            keep
+        });
+        for (id, account) in &current {
+            if let Some(entry) = watched.get_mut(id) {
+                entry.name = account_name(account);
+                continue;
+            }
+            let task = glib::spawn_future_local(watch(
+                Rc::downgrade(shared),
+                engine.clone(),
+                account.clone(),
+            ));
+            watched.insert(
+                id.clone(),
+                Watched {
+                    name: account_name(account),
+                    phase: Phase::Stopped,
+                    task,
+                },
+            );
+        }
+    }
+    shared.refresh();
+}
+
+/// Follows one account's worker for the tray.
+async fn watch(shared: std::rc::Weak<Shared>, engine: Engine, account: Account) {
+    let mut monitor = engine.monitor_synchronization(account.id.clone());
+    loop {
+        let phase = match monitor.current().await {
+            Ok(status) => classify(&status),
+            Err(_) => Phase::Failed,
+        };
+        let Some(shared) = shared.upgrade() else {
+            return;
+        };
+        {
+            let mut accounts = shared.accounts.borrow_mut();
+            let Some(entry) = accounts.get_mut(&account.id.0) else {
+                return;
+            };
+            entry.phase = phase;
+        }
+        shared.refresh();
+        drop(shared);
+        monitor.changed().await;
+    }
+}
diff --git a/src/application/desktop/status.rs b/src/application/desktop/status.rs
new file mode 100644
index 0000000..188d7b5
--- /dev/null
+++ b/src/application/desktop/status.rs
@@ -0,0 +1,151 @@
+//! Account-level summary of synchronization status for desktop surfaces.
+//!
+//! The summary is derived only from the public status; it never decides or retries
+//! synchronization.
+use drivesync_engine::{
+    SynchronizationIssueKind as Kind, SynchronizationState as State, SynchronizationStatus,
+};
+
+/// What a desktop surface shows for one account.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum Phase {
+    /// No worker is running for the account.
+    #[default]
+    Stopped,
+    /// The worker is idle and reports no blocker.
+    Idle,
+    /// Observing, analyzing or applying changes.
+    Working,
+    /// A file changed on both sides and needs a decision.
+    Conflict,
+    /// The account needs the person's decision before synchronization continues.
+    Attention,
+    /// An operation or the worker failed and will not be retried on its own.
+    Failed,
+}
+
+/// Classifies one status. Retryable waits stay `Working`; only blockers that need the
+/// person, or failures that are not retried, leave it.
+pub(crate) fn classify(status: &SynchronizationStatus) -> Phase {
+    let issues = status
+        .issue
+        .iter()
+        .chain(status.pending.as_ref().map(|pending| &pending.issue));
+    let mut phase = None;
+    for issue in issues {
+        let found = match issue.kind {
+            Kind::Conflict => Phase::Conflict,
+            Kind::AdoptionRequired => Phase::Attention,
+            Kind::OperationFailed
+            | Kind::WorkerFailed
+            | Kind::RecoveryRequired
+            | Kind::TrashRefused
+            | Kind::TrashRecoveryRequired
+                if !issue.retryable =>
+            {
+                Phase::Failed
+            }
+            _ => continue,
+        };
+        phase = Some(phase.map_or(found, |current: Phase| current.max(found)));
+    }
+    if let Some(phase) = phase {
+        return phase;
+    }
+    match status.state {
+        State::Failed => Phase::Failed,
+        State::Stopped => Phase::Stopped,
+        State::Running | State::Waiting => Phase::Working,
+        State::Idle => Phase::Idle,
+    }
+}
+
+impl Phase {
+    fn rank(self) -> u8 {
+        match self {
+            Phase::Stopped => 0,
+            Phase::Idle => 1,
+            Phase::Working => 2,
+            Phase::Attention => 3,
+            Phase::Conflict => 4,
+            Phase::Failed => 5,
+        }
+    }
+    fn max(self, other: Phase) -> Phase {
+        if other.rank() > self.rank() {
+            other
+        } else {
+            self
+        }
+    }
+    /// The most urgent phase among several accounts.
+    pub(crate) fn most_urgent(phases: impl IntoIterator<Item = Phase>) -> Phase {
+        phases.into_iter().fold(Phase::Stopped, Phase::max)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use drivesync_engine::{
+        AccountId, SynchronizationActivity, SynchronizationIssue, SynchronizationOperation,
+        SynchronizationWork,
+    };
+
+    fn status(state: State, issue: Option<(Kind, bool)>, operation: bool) -> SynchronizationStatus {
+        SynchronizationStatus {
+            account_id: AccountId("a".into()),
+            work: SynchronizationWork::default(),
+            pending: None,
+            state,
+            activity: SynchronizationActivity::None,
+            current_item: None,
+            current_operation: operation.then(|| SynchronizationOperation {
+                id: "op".into(),
+                item_id: drivesync_engine::models::ItemId("i".into()),
+                display_name: None,
+                newly_observed_remote: false,
+                newly_observed_local: true,
+                updates_local_content: false,
+                updates_remote_content: false,
+                rename: None,
+                movement: None,
+                workspace_shortcut: None,
+                directory_creation: None,
+                trash: None,
+            }),
+            progress: None,
+            verification: None,
+            issue: issue.map(|(kind, retryable)| SynchronizationIssue { kind, retryable }),
+            updated_at: drivesync_engine::models::Timestamp { unix_millis: 0 },
+        }
+    }
+
+    #[test]
+    fn retryable_waits_are_work_not_failures() {
+        assert_eq!(
+            classify(&status(
+                State::Waiting,
+                Some((Kind::OperationFailed, true)),
+                false
+            )),
+            Phase::Working
+        );
+        assert_eq!(
+            classify(&status(
+                State::Waiting,
+                Some((Kind::OperationFailed, false)),
+                false
+            )),
+            Phase::Failed
+        );
+        assert_eq!(
+            classify(&status(
+                State::Running,
+                Some((Kind::Conflict, false)),
+                false
+            )),
+            Phase::Conflict
+        );
+    }
+}
