+//! Metered-connection policy. Synchronization waits while the desktop reports the
+//! connection as metered, unless the person allowed metered connections in Preferences.
+//! The metered state is GLib's network monitor (NetworkManager on most desktops).
+use adw::gtk::gio::{self, prelude::*};
+
+/// True when saved synchronization scopes must not run now.
+pub(crate) fn held() -> bool {
+    !super::preferences::Preferences::load().sync_on_metered && metered()
+}
+
+/// The desktop's current metered state.
+pub(crate) fn metered() -> bool {
+    gio::NetworkMonitor::default().is_network_metered()
+}
