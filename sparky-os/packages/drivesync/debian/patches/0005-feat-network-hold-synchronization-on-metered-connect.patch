+/// Holds or restores every saved scope when the policy's answer changes.
+async fn apply_policy(shared: Rc<Shared>, engine: Engine) {
+    let held = network::held();
+    if shared.held.replace(held) == held {
+        return;
+    }
+    if let Ok(result) = engine
+        .list_accounts(ListAccountsRequest { provider: None })
+        .await
+    {
+        if held {
+            for account in &result.accounts {
+                if let Ok(Some(_)) = configuration::load(&account.id).await {
+                    let _ = engine.stop_synchronization(account.id.clone()).await;
+                }
+            }
+        } else {
+            configuration::restore_synchronization(&engine, &result.accounts).await;
+        }
+    }
+    shared.notifier.metered(held);
+    shared.refresh();
+}
