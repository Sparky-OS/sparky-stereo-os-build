index 0000000..e0ce219
--- /dev/null
+++ b/po/de.po
@@ -0,0 +1,96 @@
+msgid ""
+msgstr ""
+"Project-Id-Version: DriveSync\n"
+"Report-Msgid-Bugs-To: \n"
+"PO-Revision-Date: 2026-11-27 00:00+0000\n"
+"Last-Translator: Sparky Stereo OS\n"
+"Language-Team: German\n"
+"Language: de\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+msgid "Synchronization is not running"
+msgstr "Die Synchronisation läuft nicht"
+
+msgid "Google Drive is up to date"
+msgstr "Google Drive ist auf dem neuesten Stand"
+
+msgid "Synchronizing with Google Drive…"
+msgstr "Wird mit Google Drive synchronisiert …"
+
+msgid "A file changed on both sides"
+msgstr "Eine Datei wurde auf beiden Seiten geändert"
+
+msgid "DriveSync needs your decision"
+msgstr "DriveSync braucht Ihre Entscheidung"
+
+msgid "Synchronization failed"
+msgstr "Synchronisation fehlgeschlagen"
+
+msgid "Google Drive"
+msgstr "Google Drive"
+
+msgid "Synchronization waits because the connection is metered."
+msgstr "Die Synchronisation wartet, weil die Verbindung getaktet ist."
+
+msgid "Open DriveSync"
+msgstr "DriveSync öffnen"
+
+msgid "{account}: the changes were synchronized."
+msgstr "{account}: Die Änderungen wurden synchronisiert."
+
+msgid "{account}: an item could not be synchronized. It stays listed in DriveSync until it is resolved."
+msgstr "{account}: Ein Element konnte nicht synchronisiert werden. Es bleibt in DriveSync aufgeführt, bis es gelöst ist."
+
+msgid "{account}: choose which version to keep. Nothing was overwritten."
+msgstr "{account}: Wählen Sie, welche Version behalten werden soll. Nichts wurde überschrieben."
+
+msgid "{account}: synchronization waits until you review the folder in DriveSync."
+msgstr "{account}: Die Synchronisation wartet, bis Sie den Ordner in DriveSync überprüfen."
+
+msgid "Synchronization waits"
+msgstr "Die Synchronisation wartet"
+
+msgid "The connection is metered, so DriveSync does not download or upload. It continues by itself on a connection that is not metered, or when you allow metered connections in Preferences."
+msgstr "Die Verbindung ist getaktet, daher lädt DriveSync nichts herunter oder hoch. Es setzt von selbst fort, sobald die Verbindung nicht mehr getaktet ist oder wenn Sie getaktete Verbindungen in den Einstellungen erlauben."
+
+msgid "Synchronization waits: the connection is metered"
+msgstr "Die Synchronisation wartet: Die Verbindung ist getaktet"
+
+msgid "Quit"
+msgstr "Beenden"
+
+msgid "Network"
+msgstr "Netzwerk"
+
+msgid "Synchronize on Metered Connections"
+msgstr "Über getaktete Verbindungen synchronisieren"
+
+msgid "When off, synchronization waits while the connection is metered and continues by itself afterwards"
+msgstr "Wenn ausgeschaltet, wartet die Synchronisation, solange die Verbindung getaktet ist, und setzt danach von selbst fort"
+
+msgid "Add local folder to Places"
+msgstr "Lokalen Ordner zu den Orten hinzufügen"
+
+msgid "Google Drive ({account})"
+msgstr "Google Drive ({account})"
+
+msgid "The local folder was added to Places."
+msgstr "Der lokale Ordner wurde zu den Orten hinzugefügt."
+
+msgid "The local folder is already in Places."
+msgstr "Der lokale Ordner ist bereits unter den Orten."
+
+msgid "Places could not be changed. Nothing was written."
+msgstr "Die Orte konnten nicht geändert werden. Es wurde nichts geschrieben."
+
+msgid "Preferences"
+msgstr "Einstellungen"
+
+msgid "The configuration is incomplete."
+msgstr "Die Konfiguration ist unvollständig."
+
+msgid "Saved configuration could not be read. Your account has been preserved."
+msgstr "Die gespeicherte Konfiguration konnte nicht gelesen werden. Ihr Konto wurde beibehalten."
