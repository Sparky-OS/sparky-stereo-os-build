diff --git a/src/qml/mediaview/StereoMenu.qml b/src/qml/mediaview/StereoMenu.qml
new file mode 100644
index 0000000..78e3226
--- /dev/null
+++ b/src/qml/mediaview/StereoMenu.qml
@@ -0,0 +1,108 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+ *
+ * SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+ */
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import org.sparky.stereo as Stereo
+
+/**
+ * The 3D menu of the image view.
+ *
+ * What corrects one file (its input packing, Not 3D, the swap of its eyes, and
+ * saving the correction into the file) is the stereo layer's own menu, and the
+ * choice is kept in the layer's per-file store, which the file manager, the
+ * thumbnailers and the other viewers read; the file is not written unless the
+ * person chooses the save. Which eye is shown is this view's own choice.
+ */
+QQC2.Menu {
+    id: menu
+
+    // The picture shown, and whether it is shown as a pair now
+    required property url source
+    required property bool presenting
+    // The view's own choices: view (0 stereo, 1 left eye only, 2 right eye only) and revision
+    required property QtObject choices
+
+    // A choice could not be kept, or a save into the file was refused
+    signal failed(string message)
+    // The person asked to take an anaglyph apart: the page asks for the colour pair
+    signal anaglyphRequested()
+
+    function toggleSwap() {
+        if (fileChoice.swapEnabled) {
+            fileChoice.swapEyes = !fileChoice.swapEyes;
+        }
+    }
+
+    function toggleNotThreeD() {
+        fileChoice.choose(fileChoice.chosen === "mono" ? "automatic" : "mono");
+    }
+
+    function chooseAnaglyph(pair: int) {
+        fileChoice.choose(["anaglyphCyanRed", "anaglyphGreenMagenta", "anaglyphAmberBlue"][pair]);
+    }
+
+    title: i18nc("@action:inmenu Stereoscopic 3D pictures", "3D")
+
+    Stereo.FileChoice {
+        id: fileChoice
+
+        sources: [menu.source]
+        shownAsPair: menu.presenting
+        onChanged: menu.choices.revision += 1
+        onFailed: message => menu.failed(message)
+    }
+
+    Stereo.FileChoiceMenu {
+        choice: fileChoice
+    }
+
+    QQC2.MenuItem {
+        text: i18nc("@action:inmenu Stereo picture", "&Anaglyph to side by side")
+        enabled: fileChoice.available
+        onTriggered: menu.anaglyphRequested()
+    }
+
+    QQC2.MenuSeparator {}
+
+    QQC2.MenuItem {
+        id: stereoItem
+
+        text: i18nc("@action:inmenu Stereo picture view", "Stereo")
+        checkable: true
+        checked: menu.choices.view === 0
+        onTriggered: {
+            menu.choices.view = 0;
+            checked = Qt.binding(() => menu.choices.view === 0);
+        }
+    }
+
+    QQC2.MenuItem {
+        id: leftItem
+
+        text: i18nc("@action:inmenu Stereo picture view", "Left eye only")
+        checkable: true
+        checked: menu.choices.view === 1
+        onTriggered: {
+            menu.choices.view = 1;
+            checked = Qt.binding(() => menu.choices.view === 1);
+        }
+    }
+
+    QQC2.MenuItem {
+        id: rightItem
+
+        text: i18nc("@action:inmenu Stereo picture view", "Right eye only")
+        checkable: true
+        checked: menu.choices.view === 2
+        onTriggered: {
+            menu.choices.view = 2;
+            checked = Qt.binding(() => menu.choices.view === 2);
+        }
+    }
+}
