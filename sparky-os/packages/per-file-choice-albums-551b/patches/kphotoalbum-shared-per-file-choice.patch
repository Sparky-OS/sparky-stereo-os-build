+/**
+ * The viewer's 3D menu.
+ *
+ * What corrects one file (its input packing, Not 3D, the swap of its eyes, and
+ * saving the correction into the file) is the stereo layer's menu, and the
+ * choice is kept in the layer's per-file store, the one the file manager, the
+ * thumbnailers and the other viewers read; the photograph is not written unless
+ * the person chooses the save. Which view is shown (both eyes, one eye, or every
+ * photograph flat) is this viewer's own choice, for the session, as before.
+ */
 class StereoPictureMenu : public QMenu
 {
     Q_OBJECT
 
 public:
     explicit StereoPictureMenu(QWidget *parent);
-    void setOptions(const Stereo::Picture::Options &options);
+    /**
+     * The photograph shown, and whether it is shown as a pair now: a flat one is offered no swap.
+     */
+    void setFile(const QString &path, bool shownAsPair);
+    /**
+     * This viewer's own choice: which view is shown (Stereo, LeftOnly, RightOnly, or Mono for every photograph flat).
+     */
     Stereo::Picture::Options options() const;
 
 Q_SIGNALS:
-
+    /**
+     * The viewer's own choice changed.
+     */
     void optionsChanged();
+    /**
+     * The file's stored choice changed (or was saved into the file): decode it again.
+     */
+    void fileChoiceChanged();
 
 private:
     void convert();
+    void fileChanged(const QStringList &paths);
+    void failed(const QString &message);
     Stereo::Picture::Options m_options;
-    QActionGroup *m_formats;
+    Stereo::FileChoiceMenu *m_fileChoice;
     QActionGroup *m_views;
-    QAction *m_swap;
+    QAction *m_conversion;
+    QString m_path;
 };
 
 } // namespace Viewer
