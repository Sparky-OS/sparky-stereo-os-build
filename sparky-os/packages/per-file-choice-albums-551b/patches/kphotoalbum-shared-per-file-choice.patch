+void StereoPictureMenu::fileChanged(const QStringList &paths)
+{
+    QList<QUrl> urls;
+    for (const QString &path : paths) {
+        urls.append(QUrl::fromLocalFile(path));
+    }
+    Q_EMIT fileChoiceChanged();
+    // the file manager and the other viewers show the file again
+    org::kde::KDirNotify::emitFilesChanged(urls);
+}
