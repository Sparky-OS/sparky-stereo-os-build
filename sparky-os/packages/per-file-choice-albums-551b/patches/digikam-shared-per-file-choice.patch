+void StereoPictureMenu::setFile(const QString& path, bool shownAsPair)
+{
+    m_path = path;
+    m_fileChoice->setShownAsPair(shownAsPair);
+    m_fileChoice->setFiles(path.isEmpty() ? QStringList() : QStringList{path});
+    m_fileChoice->menuAction()->setEnabled(!path.isEmpty());
+    m_conversion->setEnabled(!path.isEmpty());
