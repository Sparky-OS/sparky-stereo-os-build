+
+void StereoPictureMenu::fileChanged(const QStringList& paths)
+{
+    Q_EMIT fileChoiceChanged(paths);
+
+    // The file manager and the other viewers show the files again: the desktop's own notice of changed files
+
+    QStringList urls;
+
+    for (const QString& path : paths)
+    {
+        urls.append(QUrl::fromLocalFile(path).toString());
+    }
+
+    QDBusMessage notice = QDBusMessage::createSignal(QLatin1String("/"), QLatin1String("org.kde.KDirNotify"), QLatin1String("FilesChanged"));
+    notice << urls;
+    QDBusConnection::sessionBus().send(notice);
+}
