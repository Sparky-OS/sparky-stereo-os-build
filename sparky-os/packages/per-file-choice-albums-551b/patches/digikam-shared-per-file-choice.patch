+
+#include "stereofilechoice.h"
+
+// Local includes
+
+#include "digikam_debug.h"
+
+#ifdef HAVE_STEREO_LAYER
+#   include <picture.h>
+#endif
+
+namespace Digikam
+{
+
+void stereoFileMoved(const QString& from, const QString& to)
+{
+#ifdef HAVE_STEREO_LAYER
+
+    QString error;
+    bool failed = false;
+    Stereo::Picture::moveFileChoice(from, to, &error, &failed);
+
+    if (failed)
+    {
+        // The choice is still kept under the old path; the file shows as its own marks say until it is chosen again
+
+        qCWarning(DIGIKAM_WIDGETS_LOG) << "The 3D choice of" << from << "could not follow it to" << to << ":" << error;
+    }
+
+#else
+
+    Q_UNUSED(from);
+    Q_UNUSED(to);
+
+#endif
+}
+
+} // namespace Digikam
