# System defaults of the edition's integration packs (Dolphin right click menus of Sparky Stereo OS).
# A person's own ~/.config/sparky-stereo-integrationrc wins; "sparky-stereo-integration hide-missing on|off" writes it.
[General]
# false: an action whose program is not installed offers the package (command-not-found's index and message).
# true: such actions are hidden (needs KIO's TryExec support to follow the program at once; until then they hide at the next sync).
HideMissing=false
# sparky-stereo-align: crop both eyes to the area every picture covers.
AlignCrop=true
