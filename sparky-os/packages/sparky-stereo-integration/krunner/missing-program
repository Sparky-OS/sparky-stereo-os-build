# KRunner's missing program runner (a D-Bus runner, org.kde.krunner1): a typed program that is not installed names the package
# that provides it, with command-not-found's own message, and the match installs it by the same route as Dolphin's actions
# (sparky-stereo-integration install). It matches only when command-not-found names exactly one package, or when it names a
# package that Debian installs the command from under another name (its renamed-commands table: `fd` is fd-find's `fdfind`,
# `ts` is task-spooler's `tsp`); then each package it names is a match, in its order. A renamed program that is installed
# (command-not-found names its path) is a match too, in the same place, that runs it with the query's arguments in the
# person's terminal. When the table cannot be read, command-not-found's line that says so is the subtext of every match.
import os, re, shlex, shutil, subprocess, sys
import dbus, dbus.mainloop.glib, dbus.service
from gi.repository import GLib

NAME = 'org.sparky.stereo.MissingProgram'
CNF = '/usr/lib/command-not-found'
RENAMED = '/usr/share/command-not-found/renamed-commands'
HELPER_MATCH = 70
IDLE_SECONDS = 120


LANGDIR = '/usr/share/sparky/sparky-stereo-integration'
# where command-not-found looks for an installed program (CommandNotFound.prefixes, without /snap/bin)
PREFIXES = ('/bin', '/usr/bin', '/usr/local/bin', '/sbin', '/usr/sbin', '/usr/local/sbin', '/usr/games')


def renamed(command):
    # [(package, installed name)] of the table's rows for this command, or None when the table cannot be read
    try:
        with open(RENAMED) as fp:
            rows = [line.split() for line in fp if line.strip() and not line.lstrip().startswith('#')]
    except OSError:
        return None
    return [(row[1], row[2]) for row in rows if len(row) == 4 and row[0] == command]


def lookup(query):
    # command-not-found's own lookup and message: [(match id, text, subtext)] in its order
    words = query.split()
    command = words[0] if words else ''
    if not re.fullmatch(r'[a-z0-9][a-z0-9._+-]{1,60}', command) or shutil.which(command):
        return []
    try:
        out = subprocess.run([CNF, '--', command], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return []
    lines = [l for l in out.stdout.splitlines() if l.strip()]
    rows = renamed(command)
    problem = None
    if rows is None:
        rows = []
        problem = next((l for l in lines if RENAMED in l), None)
    # the installed renamed programs, the longest path first, so /usr/bin/tsp is found whole and not as /bin/tsp
    installed = sorted({os.path.join(prefix, name) for _, name in rows for prefix in PREFIXES if os.path.isfile(os.path.join(prefix, name))},
                       key=len, reverse=True)
    offers, header, named = [], None, False
    for line in lines:
        if line == problem:
            continue
        m = re.search(r'apt install ([a-z0-9][a-z0-9.+-]*)', line)
        place = next((path for path in installed if re.search(r'(?<![\w/])' + re.escape(path) + r'(?![\w/-])', line)), None)
        if m and m.group(1) not in [offer[0] for offer in offers]:
            offers.append(('install:' + m.group(1), (header or line).rstrip(':'), line))
            named = named or m.group(1) in [package for package, _ in rows]
        elif place:
            argv = [place] + words[1:]
            offers.append(('run:' + shlex.join(argv), line, shlex.join([os.path.basename(place)] + words[1:])))
            named = True
        elif not m:
            header = line
    if not (named or len(offers) == 1):
        return []
    if problem:
        offers = [(match, text, problem + ' ' + sub) for match, text, sub in offers]
    return offers


def kdeglobals(key):
    # [General] KEY of kdeglobals, the person's file first, then the system's (KConfig's cascade)
    home = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    dirs = [home] + (os.environ.get('XDG_CONFIG_DIRS') or '/etc/xdg').split(':')
    for folder in dirs:
        group = None
        try:
            with open(os.path.join(folder, 'kdeglobals')) as fp:
                for line in fp:
                    line = line.strip()
                    if line.startswith('['):
                        group = line
                    elif group == '[General]' and re.match(re.escape(key) + r'(\[\$[a-z]+\])?\s*=', line):
                        return line.split('=', 1)[1].strip()
        except OSError:
            continue
    return ''


def terminal(argv):
    # the person's terminal, found as KIO's KTerminalLauncherJob finds it (src/gui/kterminallauncherjob.cpp): kdeglobals'
    # TerminalService (a desktop entry), then TerminalApplication, then Konsole, then xterm; Konsole keeps its window
    # open with --noclose and xterm with -hold, so the program's output stays to be read
    command = ''
    service = kdeglobals('TerminalService')
    data = [os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share')]
    data += (os.environ.get('XDG_DATA_DIRS') or '/usr/local/share:/usr/share').split(':')
    for folder in data if service else []:
        try:
            with open(os.path.join(folder, 'applications', service)) as fp:
                command = next((l.split('=', 1)[1].strip() for l in fp if l.startswith('Exec=')), '')
        except OSError:
            continue
        command = re.sub(r'\s*%[a-zA-Z]', '', command)
        break
    command = command or kdeglobals('TerminalApplication')
    if not command:
        command = next((t for t in ('konsole', 'xterm') if shutil.which(t)), '')
    if not command:
        return None
    exec_ = shlex.split(command)
    if command == 'konsole':
        exec_.append('--noclose')
    elif command == 'xterm':
        exec_.append('-hold')
    return exec_ + ['-e'] + argv


def say(key, arg):
    # one of the package's own messages (its lang files), in the person's language
    code = os.environ.get('LC_ALL') or os.environ.get('LC_MESSAGES') or os.environ.get('LANG') or 'en'
    code = code.split('.')[0].split('@')[0]
    for name in (code, code.split('_')[0], 'en'):
        try:
            with open(os.path.join(LANGDIR, name)) as fp:
                for line in fp:
                    m = re.match(key + r'="(.*)"$', line.strip())
                    if m:
                        return m.group(1).replace('\\"', '"') % arg
        except OSError:
            continue
    return arg


class Runner(dbus.service.Object):
    def __init__(self, bus):
        super().__init__(bus, '/runner')
        self.timer = None
        self.touch()

    def touch(self):
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add_seconds(IDLE_SECONDS, lambda: sys.exit(0))

    @dbus.service.method('org.kde.krunner1', in_signature='s', out_signature='a(sssida{sv})')
    def Match(self, query):
        self.touch()
        offers = lookup(query.strip())
        # command-not-found's message as it is: its header line as the text of an install, each install line as its subtext;
        # its line naming an installed renamed program as the text of the match that runs it
        return [(match, text, 'utilities-terminal' if match.startswith('run:') else 'system-software-install', HELPER_MATCH,
                 0.6 - 0.01 * i, {'subtext': sub}) for i, (match, text, sub) in enumerate(offers)]

    @dbus.service.method('org.kde.krunner1', in_signature='ss')
    def Run(self, match_id, action_id):
        self.touch()
        if match_id.startswith('install:'):
            subprocess.Popen(['sparky-stereo-integration', 'install', match_id[len('install:'):]], start_new_session=True)
        elif match_id.startswith('run:'):
            argv = shlex.split(match_id[len('run:'):])
            command = terminal(argv)
            if command:
                subprocess.Popen(command, cwd=os.path.expanduser('~'), start_new_session=True)
            else:
                text = say('LOCAL11', os.path.basename(argv[0]))
                if shutil.which('kdialog'):
                    subprocess.Popen(['kdialog', '--error', text], start_new_session=True)
                print(text, file=sys.stderr)

    @dbus.service.method('org.kde.krunner1', out_signature='a(sss)')
    def Actions(self):
        return []


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    name = dbus.service.BusName(NAME, bus, do_not_queue=True)
    Runner(bus)
    GLib.MainLoop().run()


main()
