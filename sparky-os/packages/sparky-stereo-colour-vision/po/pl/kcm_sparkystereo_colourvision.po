msgctxt "@item colour vision kind, used inside a sentence"
msgid "protan colour vision"
msgstr "widzenie barw typu protan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "deutan colour vision"
msgstr "widzenie barw typu deutan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "tritan colour vision"
msgstr "widzenie barw typu tritan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "monochromacy"
msgstr "monochromatyzm"

msgctxt "@info reason a file could not be written"
msgid "permission denied"
msgstr "brak uprawnień"

msgctxt "@info reason a file could not be written"
msgid "the disk is read-only"
msgstr "dysk jest tylko do odczytu"

msgctxt "@info reason a file could not be written"
msgid "the disk is full"
msgstr "dysk jest pełny"

msgctxt "@info %1 is a program name"
msgid "%1 is not installed"
msgstr "%1 nie jest zainstalowany"

msgctxt "@info %1 is a program name, %2 its exit status"
msgid "%1 ended with status %2"
msgstr "%1 zakończył się ze stanem %2"

msgctxt "@info"
msgid "your colour scheme file was not found"
msgstr "nie znaleziono pliku Twojego schematu kolorów"

msgctxt "@info"
msgid "the setting did not read back as it was written"
msgstr "ustawienie odczytane ponownie różni się od zapisanego"

msgctxt "@info"
msgid "Screen correction: on, for %1."
msgstr "Korekcja ekranu: włączona, dla %1."

msgctxt "@info"
msgid "Screen correction: saved for %1; the compositor did not answer, so it starts at your next login."
msgstr "Korekcja ekranu: zapisana dla %1; kompozytor nie odpowiedział, więc zacznie działać przy następnym logowaniu."

msgctxt "@info"
msgid "Screen correction: off."
msgstr "Korekcja ekranu: wyłączona."

msgctxt "@info %1 file, %2 reason"
msgid "Screen correction: not set. Could not write %1: %2."
msgstr "Korekcja ekranu: nie ustawiono. Nie można zapisać %1: %2."

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1, which keeps the colours that carry meaning apart."
msgstr "Kolory: %1, który utrzymuje rozróżnialność kolorów niosących znaczenie."

msgctxt "@info"
msgid "Colours: your own colour scheme, as you had it."
msgstr "Kolory: Twój własny schemat kolorów, taki jak był."

msgctxt "@info %1 colour scheme name, %2 reason"
msgid "Colours: %1 not applied: %2."
msgstr "Kolory: nie zastosowano %1: %2."

msgctxt "@info"
msgid "Konsole: new windows and tabs use the colour-safe colours; your own profile is kept and lends them everything else."
msgstr "Konsole: nowe okna i karty używają bezpiecznych kolorów; Twój własny profil zostaje i dostarcza całą resztę."

msgctxt "@info"
msgid "Konsole: not changed."
msgstr "Konsole: bez zmian."

msgctxt "@info %1 file, %2 reason"
msgid "Konsole: not set. Could not write %1: %2."
msgstr "Konsole: nie ustawiono. Nie można zapisać %1: %2."

msgctxt "@info %1 file"
msgid "nano: its selection and guide colours follow the terminal's colours (%1)."
msgstr "nano: kolory zaznaczenia i linii pomocniczej idą za kolorami terminala (%1)."

msgctxt "@info %1 the person's file, %2 lines to add"
msgid "nano: not changed, because %1 is your own file and stays as you wrote it. To get the same colours, add these lines to it: %2"
msgstr "nano: bez zmian, bo %1 to Twój własny plik i zostaje taki, jak go napisałeś. Aby mieć te same kolory, dodaj do niego te wiersze: %2"

msgctxt "@info"
msgid "nano: not changed."
msgstr "nano: bez zmian."

msgctxt "@info %1 file, %2 reason"
msgid "nano: not set. Could not write %1: %2."
msgstr "nano: nie ustawiono. Nie można zapisać %1: %2."

msgctxt "@info"
msgid "Text console, outside the desktop: the colour-safe palette from your next login there."
msgstr "Konsola tekstowa poza pulpitem: bezpieczna paleta od Twojego następnego logowania w niej."

msgctxt "@info"
msgid "Text console: not changed."
msgstr "Konsola tekstowa: bez zmian."

msgctxt "@info %1 file, %2 reason"
msgid "Text console: not set. Could not write %1: %2."
msgstr "Konsola tekstowa: nie ustawiono. Nie można zapisać %1: %2."

msgctxt "@info %1 program"
msgid "%1 did not answer."
msgstr "%1 nie odpowiedział."

msgctxt "@info %1 program, %2 its message"
msgid "%1 failed: %2"
msgstr "%1 nie powiódł się: %2"

msgctxt "@option:radio"
msgid "None"
msgstr "Brak"

msgctxt "@info"
msgid "Typical colour vision: nothing is changed."
msgstr "Typowe widzenie barw: nic się nie zmienia."

msgctxt "@option:radio"
msgid "Protan"
msgstr "Protan"

msgctxt "@info"
msgid "Reds look darker, and red and green are hard to tell apart."
msgstr "Czerwienie wyglądają ciemniej, a czerwień i zieleń trudno odróżnić."

msgctxt "@option:radio"
msgid "Deutan"
msgstr "Deutan"

msgctxt "@info"
msgid "Red and green are hard to tell apart."
msgstr "Czerwień i zieleń trudno odróżnić."

msgctxt "@option:radio"
msgid "Tritan"
msgstr "Tritan"

msgctxt "@info"
msgid "Blue and yellow, and blue and green, are hard to tell apart."
msgstr "Niebieski i żółty oraz niebieski i zielony trudno odróżnić."

msgctxt "@option:radio"
msgid "Monochromacy"
msgstr "Monochromatyzm"

msgctxt "@info"
msgid "No colours, only light and dark."
msgstr "Bez kolorów, tylko jasne i ciemne."

msgctxt "@info"
msgid "Choose your kind of colour vision. The desktop then keeps apart the colours that carry meaning: errors and successes, links, a terminal's prompt."
msgstr "Wybierz swój rodzaj widzenia barw. Pulpit utrzyma wtedy rozróżnialność kolorów niosących znaczenie: błędów i powodzeń, odnośników, znaku zachęty terminala."

msgctxt "@label"
msgid "Colour vision:"
msgstr "Widzenie barw:"

msgctxt "@label"
msgid "Terminals:"
msgstr "Terminale:"

msgctxt "@option:check"
msgid "Also change the colours of Konsole, nano and the text console"
msgstr "Zmień też kolory Konsole, nano i konsoli tekstowej"

msgctxt "@title:group"
msgid "What is set now"
msgstr "Co jest teraz ustawione"

msgctxt "@info"
msgid "For 3D, red-cyan glasses are the last choice for you: they rebuild the picture's colours from red and cyan, and red and green already run together for you. A 3D television or another of the screen's 3D outputs keeps every colour."
msgstr "W 3D okulary czerwono-cyjanowe to dla Ciebie ostateczność: odtwarzają kolory obrazu z czerwieni i cyjanu, a czerwień i zieleń już Ci się zlewają. Telewizor 3D lub inne wyjście 3D ekranu zachowuje każdy kolor."

msgctxt "@action:button"
msgid "Open Display Settings"
msgstr "Otwórz ustawienia ekranu"

msgctxt "@info"
msgid "The strength of the screen correction is set on the Accessibility page, which shows this same choice."
msgstr "Siłę korekcji ekranu ustawia się na stronie Dostępność, która pokazuje ten sam wybór."

msgctxt "@action:button"
msgid "Open Accessibility"
msgstr "Otwórz Dostępność"

msgctxt "@item colour role"
msgid "error text"
msgstr "tekst błędu"

msgctxt "@item colour role"
msgid "success text"
msgstr "tekst powodzenia"

msgctxt "@item colour role"
msgid "warning text"
msgstr "tekst ostrzeżenia"

msgctxt "@item colour role"
msgid "links"
msgstr "odnośniki"

msgctxt "@item colour role"
msgid "visited links"
msgstr "odwiedzone odnośniki"

msgctxt "@item colour role"
msgid "normal text"
msgstr "zwykły tekst"

msgctxt "@item colour role"
msgid "the focus frame"
msgstr "ramka fokusu"

msgctxt "@item two colours that look alike"
msgid "%1 and %2"
msgstr "%1 i %2"

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1. This colour scheme was not measured; its colours that carry meaning now take the colour-vision map's colours."
msgstr "Kolory: %1. Ten schemat kolorów nie został zmierzony; jego kolory niosące znaczenie przyjmują kolory z mapy widzenia barw."

msgctxt "@info %1 colour scheme name, %2 list of colour pairs"
msgid "Colours: %1. In this colour scheme some colours stay close for you: %2. Sparky Stereo Oxygen Dark keeps them apart."
msgstr "Kolory: %1. W tym schemacie kolorów niektóre kolory pozostają dla Ciebie zbliżone: %2. Sparky Stereo Oxygen Dark je rozdziela."

msgid "Colour vision"
msgstr "Widzenie barw"
