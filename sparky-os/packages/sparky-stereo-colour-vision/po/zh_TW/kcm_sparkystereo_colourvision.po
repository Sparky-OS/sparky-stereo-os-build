msgctxt "@item colour vision kind, used inside a sentence"
msgid "protan colour vision"
msgstr "紅色覺異常（protan）"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "deutan colour vision"
msgstr "綠色覺異常（deutan）"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "tritan colour vision"
msgstr "藍色覺異常（tritan）"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "monochromacy"
msgstr "全色盲"

msgctxt "@info reason a file could not be written"
msgid "permission denied"
msgstr "權限不足"

msgctxt "@info reason a file could not be written"
msgid "the disk is read-only"
msgstr "磁碟為唯讀"

msgctxt "@info reason a file could not be written"
msgid "the disk is full"
msgstr "磁碟已滿"

msgctxt "@info %1 is a program name"
msgid "%1 is not installed"
msgstr "未安裝 %1"

msgctxt "@info %1 is a program name, %2 its exit status"
msgid "%1 ended with status %2"
msgstr "%1 以狀態 %2 結束"

msgctxt "@info"
msgid "your colour scheme file was not found"
msgstr "找不到你的配色方案檔案"

msgctxt "@info"
msgid "the setting did not read back as it was written"
msgstr "重新讀取的設定與寫入的不一致"

msgctxt "@info"
msgid "Screen correction: on, for %1."
msgstr "螢幕校正：已開啟，適用於%1。"

msgctxt "@info"
msgid "Screen correction: saved for %1; the compositor did not answer, so it starts at your next login."
msgstr "螢幕校正：已為%1儲存；合成器沒有回應，將在你下次登入時生效。"

msgctxt "@info"
msgid "Screen correction: off."
msgstr "螢幕校正：已關閉。"

msgctxt "@info %1 file, %2 reason"
msgid "Screen correction: not set. Could not write %1: %2."
msgstr "螢幕校正：未設定。無法寫入 %1：%2。"

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1, which keeps the colours that carry meaning apart."
msgstr "顏色：%1，讓表示含義的顏色保持可分辨。"

msgctxt "@info"
msgid "Colours: your own colour scheme, as you had it."
msgstr "顏色：你自己的配色方案，維持原樣。"

msgctxt "@info %1 colour scheme name, %2 reason"
msgid "Colours: %1 not applied: %2."
msgstr "顏色：未套用 %1：%2。"

msgctxt "@info"
msgid "Konsole: new windows and tabs use the colour-safe colours; your own profile is kept and lends them everything else."
msgstr "Konsole：新視窗與分頁使用易於分辨的顏色；你自己的設定檔維持不變，並提供其餘所有設定。"

msgctxt "@info"
msgid "Konsole: not changed."
msgstr "Konsole：未變更。"

msgctxt "@info %1 file, %2 reason"
msgid "Konsole: not set. Could not write %1: %2."
msgstr "Konsole：未設定。無法寫入 %1：%2。"

msgctxt "@info %1 file"
msgid "nano: its selection and guide colours follow the terminal's colours (%1)."
msgstr "nano：選取和參考線的顏色跟隨終端機的顏色（%1）。"

msgctxt "@info %1 the person's file, %2 lines to add"
msgid "nano: not changed, because %1 is your own file and stays as you wrote it. To get the same colours, add these lines to it: %2"
msgstr "nano：未變更，因為 %1 是你自己的檔案，會保持你寫的樣子。要得到相同的顏色，請在其中加入以下幾行：%2"

msgctxt "@info"
msgid "nano: not changed."
msgstr "nano：未變更。"

msgctxt "@info %1 file, %2 reason"
msgid "nano: not set. Could not write %1: %2."
msgstr "nano：未設定。無法寫入 %1：%2。"

msgctxt "@info"
msgid "Text console, outside the desktop: the colour-safe palette from your next login there."
msgstr "桌面之外的文字主控台：從你下次在其中登入起使用易於分辨的調色盤。"

msgctxt "@info"
msgid "Text console: not changed."
msgstr "文字主控台：未變更。"

msgctxt "@info %1 file, %2 reason"
msgid "Text console: not set. Could not write %1: %2."
msgstr "文字主控台：未設定。無法寫入 %1：%2。"

msgctxt "@info %1 program"
msgid "%1 did not answer."
msgstr "%1 沒有回應。"

msgctxt "@info %1 program, %2 its message"
msgid "%1 failed: %2"
msgstr "%1 失敗：%2"

msgctxt "@option:radio"
msgid "None"
msgstr "無"

msgctxt "@info"
msgid "Typical colour vision: nothing is changed."
msgstr "常見色覺：不做任何變更。"

msgctxt "@option:radio"
msgid "Protan"
msgstr "紅色覺異常（protan）"

msgctxt "@info"
msgid "Reds look darker, and red and green are hard to tell apart."
msgstr "紅色看起來較暗，難以分辨紅色和綠色。"

msgctxt "@option:radio"
msgid "Deutan"
msgstr "綠色覺異常（deutan）"

msgctxt "@info"
msgid "Red and green are hard to tell apart."
msgstr "難以分辨紅色和綠色。"

msgctxt "@option:radio"
msgid "Tritan"
msgstr "藍色覺異常（tritan）"

msgctxt "@info"
msgid "Blue and yellow, and blue and green, are hard to tell apart."
msgstr "難以分辨藍色和黃色，以及藍色和綠色。"

msgctxt "@option:radio"
msgid "Monochromacy"
msgstr "全色盲"

msgctxt "@info"
msgid "No colours, only light and dark."
msgstr "沒有顏色，只有明暗。"

msgctxt "@info"
msgid "Choose your kind of colour vision. The desktop then keeps apart the colours that carry meaning: errors and successes, links, a terminal's prompt."
msgstr "選擇你的色覺類型。桌面會讓表示含義的顏色保持可分辨：錯誤與成功、連結、終端機的提示字元。"

msgctxt "@label"
msgid "Colour vision:"
msgstr "色覺："

msgctxt "@label"
msgid "Terminals:"
msgstr "終端機："

msgctxt "@option:check"
msgid "Also change the colours of Konsole, nano and the text console"
msgstr "同時變更 Konsole、nano 與文字主控台的顏色"

msgctxt "@title:group"
msgid "What is set now"
msgstr "目前的設定"

msgctxt "@info"
msgid "For 3D, red-cyan glasses are the last choice for you: they rebuild the picture's colours from red and cyan, and red and green already run together for you. A 3D television or another of the screen's 3D outputs keeps every colour."
msgstr "對於 3D，紅青眼鏡是你最後的選擇：它用紅色和青色重建畫面的顏色，而紅色和綠色在你看來本就混在一起。3D 電視或螢幕的其他 3D 輸出會保留所有顏色。"

msgctxt "@action:button"
msgid "Open Display Settings"
msgstr "開啟顯示設定"

msgctxt "@info"
msgid "The strength of the screen correction is set on the Accessibility page, which shows this same choice."
msgstr "螢幕校正的強度在「無障礙」頁面中設定，該頁面顯示同樣的選擇。"

msgctxt "@action:button"
msgid "Open Accessibility"
msgstr "開啟無障礙"

msgctxt "@item colour role"
msgid "error text"
msgstr "錯誤文字"

msgctxt "@item colour role"
msgid "success text"
msgstr "成功文字"

msgctxt "@item colour role"
msgid "warning text"
msgstr "警告文字"

msgctxt "@item colour role"
msgid "links"
msgstr "連結"

msgctxt "@item colour role"
msgid "visited links"
msgstr "已造訪的連結"

msgctxt "@item colour role"
msgid "normal text"
msgstr "一般文字"

msgctxt "@item colour role"
msgid "the focus frame"
msgstr "焦點框"

msgctxt "@item two colours that look alike"
msgid "%1 and %2"
msgstr "%1和%2"

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1. This colour scheme was not measured; its colours that carry meaning now take the colour-vision map's colours."
msgstr "顏色：%1。此配色方案未經測量；其表示含義的顏色改用色覺配色表中的顏色。"

msgctxt "@info %1 colour scheme name, %2 list of colour pairs"
msgid "Colours: %1. In this colour scheme some colours stay close for you: %2. Sparky Stereo Oxygen Dark keeps them apart."
msgstr "顏色：%1。在此配色方案中，以下顏色對你來說仍然相近：%2。Sparky Stereo Oxygen Dark 能讓它們保持可分辨。"

msgid "Colour vision"
msgstr "色覺"
