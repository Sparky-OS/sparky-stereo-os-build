msgstr "texte d’avertissement"

msgctxt "@item colour role"
msgid "links"
msgstr "liens"

msgctxt "@item colour role"
msgid "visited links"
msgstr "liens visités"

msgctxt "@item colour role"
msgid "normal text"
msgstr "texte normal"

msgctxt "@item colour role"
msgid "the focus frame"
msgstr "le cadre de focus"

