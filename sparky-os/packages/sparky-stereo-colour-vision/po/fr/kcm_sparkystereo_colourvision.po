msgid "%1 and %2"
msgstr "%1 et %2"

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1. This colour scheme was not measured; its colours that carry meaning now take the colour-vision map's colours."
msgstr "Couleurs : %1. Ce jeu de couleurs n’a pas été mesuré ; ses couleurs porteuses de sens prennent celles de la table de vision des couleurs."

msgctxt "@info %1 colour scheme name, %2 list of colour pairs"
msgid "Colours: %1. In this colour scheme some colours stay close for you: %2. Sparky Stereo Oxygen Dark keeps them apart."
msgstr "Couleurs : %1. Dans ce jeu de couleurs, certaines couleurs restent proches pour vous : %2. Sparky Stereo Oxygen Dark les garde distinctes."

msgid "Colour vision"
msgstr "Vision des couleurs"
