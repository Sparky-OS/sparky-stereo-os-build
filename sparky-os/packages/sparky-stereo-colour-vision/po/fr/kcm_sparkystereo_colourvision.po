msgctxt "@item colour vision kind, used inside a sentence"
msgid "protan colour vision"
msgstr "vision des couleurs protan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "deutan colour vision"
msgstr "vision des couleurs deutan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "tritan colour vision"
msgstr "vision des couleurs tritan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "monochromacy"
msgstr "monochromatisme"

msgctxt "@info reason a file could not be written"
msgid "permission denied"
msgstr "permission refusée"

msgctxt "@info reason a file could not be written"
msgid "the disk is read-only"
msgstr "le disque est en lecture seule"

msgctxt "@info reason a file could not be written"
msgid "the disk is full"
msgstr "le disque est plein"

msgctxt "@info %1 is a program name"
msgid "%1 is not installed"
msgstr "%1 n’est pas installé"

msgctxt "@info %1 is a program name, %2 its exit status"
msgid "%1 ended with status %2"
msgstr "%1 s’est terminé avec le code %2"

msgctxt "@info"
msgid "your colour scheme file was not found"
msgstr "le fichier de votre jeu de couleurs est introuvable"

msgctxt "@info"
msgid "the setting did not read back as it was written"
msgstr "le réglage relu ne correspond pas à ce qui a été écrit"

msgctxt "@info"
msgid "Screen correction: on, for %1."
msgstr "Correction de l’écran : activée, pour %1."

msgctxt "@info"
msgid "Screen correction: saved for %1; the compositor did not answer, so it starts at your next login."
msgstr "Correction de l’écran : enregistrée pour %1 ; le compositeur n’a pas répondu, elle commencera à votre prochaine connexion."

msgctxt "@info"
msgid "Screen correction: off."
msgstr "Correction de l’écran : désactivée."

msgctxt "@info %1 file, %2 reason"
msgid "Screen correction: not set. Could not write %1: %2."
msgstr "Correction de l’écran : non appliquée. Impossible d’écrire %1 : %2."

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1, which keeps the colours that carry meaning apart."
msgstr "Couleurs : %1, qui garde distinctes les couleurs porteuses de sens."

msgctxt "@info"
msgid "Colours: your own colour scheme, as you had it."
msgstr "Couleurs : votre propre jeu de couleurs, tel que vous l’aviez."

msgctxt "@info %1 colour scheme name, %2 reason"
msgid "Colours: %1 not applied: %2."
msgstr "Couleurs : %1 non appliqué : %2."

msgctxt "@info"
msgid "Konsole: new windows and tabs use the colour-safe colours; your own profile is kept and lends them everything else."
msgstr "Konsole : les nouvelles fenêtres et onglets utilisent les couleurs adaptées ; votre propre profil est conservé et fournit tout le reste."

msgctxt "@info"
msgid "Konsole: not changed."
msgstr "Konsole : inchangé."

msgctxt "@info %1 file, %2 reason"
msgid "Konsole: not set. Could not write %1: %2."
msgstr "Konsole : non appliqué. Impossible d’écrire %1 : %2."

msgctxt "@info %1 file"
msgid "nano: its selection and guide colours follow the terminal's colours (%1)."
msgstr "nano : ses couleurs de sélection et de repère suivent les couleurs du terminal (%1)."

msgctxt "@info %1 the person's file, %2 lines to add"
msgid "nano: not changed, because %1 is your own file and stays as you wrote it. To get the same colours, add these lines to it: %2"
msgstr "nano : inchangé, car %1 est votre propre fichier et reste tel que vous l’avez écrit. Pour obtenir les mêmes couleurs, ajoutez-y ces lignes : %2"

msgctxt "@info"
msgid "nano: not changed."
msgstr "nano : inchangé."

msgctxt "@info %1 file, %2 reason"
msgid "nano: not set. Could not write %1: %2."
msgstr "nano : non appliqué. Impossible d’écrire %1 : %2."

msgctxt "@info"
msgid "Text console, outside the desktop: the colour-safe palette from your next login there."
msgstr "Console texte, hors du bureau : la palette adaptée dès votre prochaine connexion sur celle-ci."

msgctxt "@info"
msgid "Text console: not changed."
msgstr "Console texte : inchangée."

msgctxt "@info %1 file, %2 reason"
msgid "Text console: not set. Could not write %1: %2."
msgstr "Console texte : non appliquée. Impossible d’écrire %1 : %2."

msgctxt "@info %1 program"
msgid "%1 did not answer."
msgstr "%1 n’a pas répondu."

msgctxt "@info %1 program, %2 its message"
msgid "%1 failed: %2"
msgstr "%1 a échoué : %2"

msgctxt "@option:radio"
msgid "None"
msgstr "Aucune"

msgctxt "@info"
msgid "Typical colour vision: nothing is changed."
msgstr "Vision des couleurs habituelle : rien n’est modifié."

msgctxt "@option:radio"
msgid "Protan"
msgstr "Protan"

msgctxt "@info"
msgid "Reds look darker, and red and green are hard to tell apart."
msgstr "Les rouges paraissent plus sombres, et le rouge et le vert sont difficiles à distinguer."

msgctxt "@option:radio"
msgid "Deutan"
msgstr "Deutan"

msgctxt "@info"
msgid "Red and green are hard to tell apart."
msgstr "Le rouge et le vert sont difficiles à distinguer."

msgctxt "@option:radio"
msgid "Tritan"
msgstr "Tritan"

msgctxt "@info"
msgid "Blue and yellow, and blue and green, are hard to tell apart."
msgstr "Le bleu et le jaune, ainsi que le bleu et le vert, sont difficiles à distinguer."

msgctxt "@option:radio"
msgid "Monochromacy"
msgstr "Monochromatisme"

msgctxt "@info"
msgid "No colours, only light and dark."
msgstr "Pas de couleurs, seulement le clair et le sombre."

msgctxt "@info"
msgid "Choose your kind of colour vision. The desktop then keeps apart the colours that carry meaning: errors and successes, links, a terminal's prompt."
msgstr "Choisissez votre type de vision des couleurs. Le bureau garde alors distinctes les couleurs porteuses de sens : erreurs et réussites, liens, l’invite d’un terminal."

msgctxt "@label"
msgid "Colour vision:"
msgstr "Vision des couleurs :"

msgctxt "@label"
msgid "Terminals:"
msgstr "Terminaux :"

msgctxt "@option:check"
msgid "Also change the colours of Konsole, nano and the text console"
msgstr "Changer aussi les couleurs de Konsole, de nano et de la console texte"

msgctxt "@title:group"
msgid "What is set now"
msgstr "Ce qui est appliqué maintenant"

msgctxt "@info red-cyan glasses for protan and deutan colour vision"
msgid "With red-cyan glasses, 3D pictures keep all their depth for you, and fewer of their colours stay apart: the glasses rebuild the colours from red and cyan, and red and green already run together for you. A 3D television or another of the screen's 3D outputs keeps every colour."
msgstr "Avec des lunettes rouge-cyan, les images 3D gardent pour vous toute leur profondeur, et moins de leurs couleurs restent distinctes : les lunettes reconstruisent les couleurs à partir du rouge et du cyan, et pour vous le rouge et le vert se confondent déjà. Un téléviseur 3D ou une autre sortie 3D de l’écran garde toutes les couleurs."

msgctxt "@info red-cyan glasses for monochromacy"
msgid "With red-cyan glasses you see 3D pictures with all their depth, as anyone does: each eye gets its own picture through its lens, and the colours play no part."
msgstr "Avec des lunettes rouge-cyan, vous voyez les images 3D avec toute leur profondeur, comme tout le monde : chaque œil reçoit sa propre image par son verre, et les couleurs n’y jouent aucun rôle."

msgctxt "@action:button"
msgid "Open Display Settings"
msgstr "Ouvrir la configuration de l’affichage"

msgctxt "@info"
msgid "The strength of the screen correction is set on the Accessibility page, which shows this same choice."
msgstr "L’intensité de la correction de l’écran se règle sur la page Accessibilité, qui montre ce même choix."

msgctxt "@action:button"
msgid "Open Accessibility"
msgstr "Ouvrir Accessibilité"

