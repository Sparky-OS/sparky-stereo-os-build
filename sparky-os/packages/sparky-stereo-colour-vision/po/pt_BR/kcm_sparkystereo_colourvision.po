msgctxt "@item colour vision kind, used inside a sentence"
msgid "protan colour vision"
msgstr "visão de cores protan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "deutan colour vision"
msgstr "visão de cores deutan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "tritan colour vision"
msgstr "visão de cores tritan"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "monochromacy"
msgstr "monocromacia"

msgctxt "@info reason a file could not be written"
msgid "permission denied"
msgstr "permissão negada"

msgctxt "@info reason a file could not be written"
msgid "the disk is read-only"
msgstr "o disco é somente leitura"

msgctxt "@info reason a file could not be written"
msgid "the disk is full"
msgstr "o disco está cheio"

msgctxt "@info %1 is a program name"
msgid "%1 is not installed"
msgstr "%1 não está instalado"

msgctxt "@info %1 is a program name, %2 its exit status"
msgid "%1 ended with status %2"
msgstr "%1 terminou com o estado %2"

msgctxt "@info"
msgid "your colour scheme file was not found"
msgstr "o arquivo do seu esquema de cores não foi encontrado"

msgctxt "@info"
msgid "the setting did not read back as it was written"
msgstr "a configuração relida não corresponde ao que foi gravado"

msgctxt "@info"
msgid "Screen correction: on, for %1."
msgstr "Correção da tela: ligada, para %1."

msgctxt "@info"
msgid "Screen correction: saved for %1; the compositor did not answer, so it starts at your next login."
msgstr "Correção da tela: salva para %1; o compositor não respondeu, então ela começa no seu próximo login."

msgctxt "@info"
msgid "Screen correction: off."
msgstr "Correção da tela: desligada."

msgctxt "@info %1 file, %2 reason"
msgid "Screen correction: not set. Could not write %1: %2."
msgstr "Correção da tela: não definida. Não foi possível gravar %1: %2."

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1, which keeps the colours that carry meaning apart."
msgstr "Cores: %1, que mantém distintas as cores que têm significado."

msgctxt "@info"
msgid "Colours: your own colour scheme, as you had it."
msgstr "Cores: o seu próprio esquema de cores, como você tinha."

msgctxt "@info %1 colour scheme name, %2 reason"
msgid "Colours: %1 not applied: %2."
msgstr "Cores: %1 não aplicado: %2."

msgctxt "@info"
msgid "Konsole: new windows and tabs use the colour-safe colours; your own profile is kept and lends them everything else."
msgstr "Konsole: novas janelas e abas usam as cores seguras; o seu próprio perfil é mantido e fornece todo o resto."

msgctxt "@info"
msgid "Konsole: not changed."
msgstr "Konsole: sem alterações."

msgctxt "@info %1 file, %2 reason"
msgid "Konsole: not set. Could not write %1: %2."
msgstr "Konsole: não definido. Não foi possível gravar %1: %2."

msgctxt "@info %1 file"
msgid "nano: its selection and guide colours follow the terminal's colours (%1)."
msgstr "nano: as cores de seleção e de guia seguem as cores do terminal (%1)."

msgctxt "@info %1 the person's file, %2 lines to add"
msgid "nano: not changed, because %1 is your own file and stays as you wrote it. To get the same colours, add these lines to it: %2"
msgstr "nano: sem alterações, porque %1 é um arquivo seu e fica como você o escreveu. Para ter as mesmas cores, acrescente estas linhas a ele: %2"

msgctxt "@info"
msgid "nano: not changed."
msgstr "nano: sem alterações."

msgctxt "@info %1 file, %2 reason"
msgid "nano: not set. Could not write %1: %2."
msgstr "nano: não definido. Não foi possível gravar %1: %2."

msgctxt "@info"
msgid "Text console, outside the desktop: the colour-safe palette from your next login there."
msgstr "Console de texto, fora da área de trabalho: a paleta segura a partir do seu próximo login nele."

msgctxt "@info"
msgid "Text console: not changed."
msgstr "Console de texto: sem alterações."

msgctxt "@info %1 file, %2 reason"
msgid "Text console: not set. Could not write %1: %2."
msgstr "Console de texto: não definido. Não foi possível gravar %1: %2."

msgctxt "@info %1 program"
msgid "%1 did not answer."
msgstr "%1 não respondeu."

msgctxt "@info %1 program, %2 its message"
msgid "%1 failed: %2"
msgstr "%1 falhou: %2"

msgctxt "@option:radio"
msgid "None"
msgstr "Nenhuma"

msgctxt "@info"
msgid "Typical colour vision: nothing is changed."
msgstr "Visão de cores típica: nada é alterado."

msgctxt "@option:radio"
msgid "Protan"
msgstr "Protan"

msgctxt "@info"
msgid "Reds look darker, and red and green are hard to tell apart."
msgstr "Os vermelhos parecem mais escuros, e é difícil distinguir vermelho de verde."

msgctxt "@option:radio"
msgid "Deutan"
msgstr "Deutan"

msgctxt "@info"
msgid "Red and green are hard to tell apart."
msgstr "É difícil distinguir vermelho de verde."

msgctxt "@option:radio"
msgid "Tritan"
msgstr "Tritan"

msgctxt "@info"
msgid "Blue and yellow, and blue and green, are hard to tell apart."
msgstr "É difícil distinguir azul de amarelo e azul de verde."

msgctxt "@option:radio"
msgid "Monochromacy"
msgstr "Monocromacia"

msgctxt "@info"
msgid "No colours, only light and dark."
msgstr "Sem cores, só claro e escuro."

msgctxt "@info"
msgid "Choose your kind of colour vision. The desktop then keeps apart the colours that carry meaning: errors and successes, links, a terminal's prompt."
msgstr "Escolha o seu tipo de visão de cores. A área de trabalho então mantém distintas as cores que têm significado: erros e acertos, links, o prompt de um terminal."

msgctxt "@label"
msgid "Colour vision:"
msgstr "Visão de cores:"

msgctxt "@label"
msgid "Terminals:"
msgstr "Terminais:"

msgctxt "@option:check"
msgid "Also change the colours of Konsole, nano and the text console"
msgstr "Mudar também as cores do Konsole, do nano e do console de texto"

msgctxt "@title:group"
msgid "What is set now"
msgstr "O que está definido agora"

msgctxt "@info"
msgid "For 3D, red-cyan glasses are the last choice for you: they rebuild the picture's colours from red and cyan, and red and green already run together for you. A 3D television or another of the screen's 3D outputs keeps every colour."
msgstr "No 3D, os óculos vermelho-ciano são a sua última opção: eles refazem as cores da imagem a partir do vermelho e do ciano, e para você o vermelho e o verde já se misturam. Uma TV 3D ou outra saída 3D da tela mantém todas as cores."

msgctxt "@action:button"
msgid "Open Display Settings"
msgstr "Abrir as configurações de tela"

msgctxt "@info"
msgid "The strength of the screen correction is set on the Accessibility page, which shows this same choice."
msgstr "A intensidade da correção da tela é definida na página Acessibilidade, que mostra esta mesma escolha."

msgctxt "@action:button"
msgid "Open Accessibility"
msgstr "Abrir Acessibilidade"

msgctxt "@item colour role"
msgid "error text"
msgstr "texto de erro"

msgctxt "@item colour role"
msgid "success text"
msgstr "texto de sucesso"

msgctxt "@item colour role"
msgid "warning text"
msgstr "texto de aviso"

msgctxt "@item colour role"
msgid "links"
msgstr "links"

msgctxt "@item colour role"
msgid "visited links"
msgstr "links visitados"

msgctxt "@item colour role"
msgid "normal text"
msgstr "texto normal"

msgctxt "@item colour role"
msgid "the focus frame"
msgstr "a moldura de foco"

msgctxt "@item two colours that look alike"
msgid "%1 and %2"
msgstr "%1 e %2"

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1. This colour scheme was not measured; its colours that carry meaning now take the colour-vision map's colours."
msgstr "Cores: %1. Este esquema de cores não foi medido; as cores que têm significado passam a usar as cores do mapa de visão de cores."

msgctxt "@info %1 colour scheme name, %2 list of colour pairs"
msgid "Colours: %1. In this colour scheme some colours stay close for you: %2. Sparky Stereo Oxygen Dark keeps them apart."
msgstr "Cores: %1. Neste esquema de cores algumas cores continuam parecidas para você: %2. O Sparky Stereo Oxygen Dark as mantém distintas."

msgid "Colour vision"
msgstr "Visão de cores"
