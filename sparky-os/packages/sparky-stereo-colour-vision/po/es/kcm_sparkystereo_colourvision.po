msgctxt "@info %1 is a program name"
msgid "%1 is not installed"
msgstr "%1 no está instalado"

msgctxt "@info %1 is a program name, %2 its exit status"
msgid "%1 ended with status %2"
msgstr "%1 terminó con el estado %2"

msgctxt "@info"
msgid "your colour scheme file was not found"
msgstr "no se encontró el archivo de tu esquema de colores"

msgctxt "@info"
msgid "the setting did not read back as it was written"
msgstr "el ajuste no se leyó tal como se escribió"

msgctxt "@info"
msgid "Screen correction: on, for %1."
msgstr "Corrección de pantalla: activada, para %1."

msgctxt "@info"
msgid "Screen correction: saved for %1; the compositor did not answer, so it starts at your next login."
msgstr "Corrección de pantalla: guardada para %1; el compositor no respondió, así que empezará en tu próximo inicio de sesión."

msgctxt "@info"
msgid "Screen correction: off."
msgstr "Corrección de pantalla: desactivada."

msgctxt "@info %1 file, %2 reason"
msgid "Screen correction: not set. Could not write %1: %2."
msgstr "Corrección de pantalla: no se aplicó. No se pudo escribir %1: %2."

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1, which keeps the colours that carry meaning apart."
msgstr "Colores: %1, que mantiene distinguibles los colores con significado."

msgctxt "@info"
msgid "Colours: your own colour scheme, as you had it."
msgstr "Colores: tu propio esquema de colores, tal como lo tenías."

msgctxt "@info %1 colour scheme name, %2 reason"
msgid "Colours: %1 not applied: %2."
msgstr "Colores: no se aplicó %1: %2."

msgctxt "@info"
msgid "Konsole: new windows and tabs use the colour-safe colours; your own profile is kept and lends them everything else."
msgstr "Konsole: las ventanas y pestañas nuevas usan los colores seguros; tu propio perfil se conserva y aporta todo lo demás."

msgctxt "@info"
msgid "Konsole: not changed."
msgstr "Konsole: sin cambios."

msgctxt "@info %1 file, %2 reason"
msgid "Konsole: not set. Could not write %1: %2."
msgstr "Konsole: no se aplicó. No se pudo escribir %1: %2."

msgctxt "@info %1 file"
msgid "nano: its selection and guide colours follow the terminal's colours (%1)."
msgstr "nano: sus colores de selección y de guía siguen los colores del terminal (%1)."

msgctxt "@info %1 the person's file, %2 lines to add"
msgid "nano: not changed, because %1 is your own file and stays as you wrote it. To get the same colours, add these lines to it: %2"
msgstr "nano: sin cambios, porque %1 es tu propio archivo y se queda como lo escribiste. Para tener los mismos colores, añádele estas líneas: %2"

msgctxt "@info"
msgid "nano: not changed."
msgstr "nano: sin cambios."

msgctxt "@info %1 file, %2 reason"
msgid "nano: not set. Could not write %1: %2."
msgstr "nano: no se aplicó. No se pudo escribir %1: %2."

msgctxt "@info"
msgid "Text console, outside the desktop: the colour-safe palette from your next login there."
msgstr "Consola de texto, fuera del escritorio: la paleta segura desde tu próximo inicio de sesión en ella."

msgctxt "@info"
msgid "Text console: not changed."
msgstr "Consola de texto: sin cambios."

msgctxt "@info %1 file, %2 reason"
msgid "Text console: not set. Could not write %1: %2."
msgstr "Consola de texto: no se aplicó. No se pudo escribir %1: %2."

msgctxt "@info %1 program"
msgid "%1 did not answer."
msgstr "%1 no respondió."

msgctxt "@info %1 program, %2 its message"
msgid "%1 failed: %2"
msgstr "%1 falló: %2"

msgctxt "@option:radio"
msgid "None"
msgstr "Ninguna"

msgctxt "@info"
msgid "Typical colour vision: nothing is changed."
msgstr "Visión del color típica: no se cambia nada."

msgctxt "@option:radio"
msgid "Protan"
msgstr "Protán"

msgctxt "@info"
msgid "Reds look darker, and red and green are hard to tell apart."
msgstr "Los rojos se ven más oscuros, y el rojo y el verde cuestan de distinguir."

msgctxt "@option:radio"
msgid "Deutan"
msgstr "Deután"

msgctxt "@info"
msgid "Red and green are hard to tell apart."
msgstr "El rojo y el verde cuestan de distinguir."

msgctxt "@option:radio"
msgid "Tritan"
msgstr "Tritán"

msgctxt "@info"
msgid "Blue and yellow, and blue and green, are hard to tell apart."
msgstr "El azul y el amarillo, y el azul y el verde, cuestan de distinguir."

msgctxt "@option:radio"
msgid "Monochromacy"
msgstr "Monocromatismo"

msgctxt "@info"
msgid "No colours, only light and dark."
msgstr "Sin colores, solo claro y oscuro."

msgctxt "@info"
msgid "Choose your kind of colour vision. The desktop then keeps apart the colours that carry meaning: errors and successes, links, a terminal's prompt."
msgstr "Elige tu tipo de visión del color. El escritorio mantendrá distinguibles los colores con significado: errores y aciertos, enlaces, el indicador de un terminal."

msgctxt "@label"
msgid "Colour vision:"
msgstr "Visión del color:"

msgctxt "@label"
msgid "Terminals:"
msgstr "Terminales:"

msgctxt "@option:check"
msgid "Also change the colours of Konsole, nano and the text console"
msgstr "Cambiar también los colores de Konsole, nano y la consola de texto"

msgctxt "@title:group"
msgid "What is set now"
msgstr "Lo que está aplicado ahora"

msgctxt "@info red-cyan glasses for protan and deutan colour vision"
msgid "With red-cyan glasses, 3D pictures keep all their depth for you, and fewer of their colours stay apart: the glasses rebuild the colours from red and cyan, and red and green already run together for you. A 3D television or another of the screen's 3D outputs keeps every colour."
msgstr "Con gafas rojo-cian, las imágenes 3D conservan para ti toda su profundidad, y menos de sus colores se distinguen: las gafas reconstruyen los colores a partir del rojo y el cian, y para ti el rojo y el verde ya se confunden. Un televisor 3D u otra salida 3D de la pantalla conserva todos los colores."

msgctxt "@info red-cyan glasses for monochromacy"
msgid "With red-cyan glasses you see 3D pictures with all their depth, as anyone does: each eye gets its own picture through its lens, and the colours play no part."
msgstr "Con gafas rojo-cian ves las imágenes 3D con toda su profundidad, como cualquier persona: cada ojo recibe su propia imagen por su lente, y los colores no influyen."

msgctxt "@action:button"
msgid "Open Display Settings"
msgstr "Abrir la configuración de pantalla"

msgctxt "@info"
msgid "The strength of the screen correction is set on the Accessibility page, which shows this same choice."
msgstr "La intensidad de la corrección de pantalla se ajusta en la página de Accesibilidad, que muestra esta misma elección."

msgctxt "@action:button"
msgid "Open Accessibility"
msgstr "Abrir Accesibilidad"

