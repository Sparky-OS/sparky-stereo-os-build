msgctxt "@item colour vision kind, used inside a sentence"
msgid "protan colour vision"
msgstr "Protan-Farbsehen"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "deutan colour vision"
msgstr "Deutan-Farbsehen"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "tritan colour vision"
msgstr "Tritan-Farbsehen"

msgctxt "@item colour vision kind, used inside a sentence"
msgid "monochromacy"
msgstr "Monochromasie"

msgctxt "@info reason a file could not be written"
msgid "permission denied"
msgstr "Zugriff verweigert"

msgctxt "@info reason a file could not be written"
msgid "the disk is read-only"
msgstr "der Datenträger ist schreibgeschützt"

msgctxt "@info reason a file could not be written"
msgid "the disk is full"
msgstr "der Datenträger ist voll"

msgctxt "@info %1 is a program name"
msgid "%1 is not installed"
msgstr "%1 ist nicht installiert"

msgctxt "@info %1 is a program name, %2 its exit status"
msgid "%1 ended with status %2"
msgstr "%1 endete mit Status %2"

msgctxt "@info"
msgid "your colour scheme file was not found"
msgstr "die Datei Ihres Farbschemas wurde nicht gefunden"

msgctxt "@info"
msgid "the setting did not read back as it was written"
msgstr "die Einstellung ließ sich nicht so zurücklesen, wie sie geschrieben wurde"

msgctxt "@info"
msgid "Screen correction: on, for %1."
msgstr "Bildschirmkorrektur: ein, für %1."

msgctxt "@info"
msgid "Screen correction: saved for %1; the compositor did not answer, so it starts at your next login."
msgstr "Bildschirmkorrektur: für %1 gespeichert; der Compositor hat nicht geantwortet, daher beginnt sie bei Ihrer nächsten Anmeldung."

msgctxt "@info"
msgid "Screen correction: off."
msgstr "Bildschirmkorrektur: aus."

msgctxt "@info %1 file, %2 reason"
msgid "Screen correction: not set. Could not write %1: %2."
msgstr "Bildschirmkorrektur: nicht gesetzt. %1 konnte nicht geschrieben werden: %2."

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1, which keeps the colours that carry meaning apart."
msgstr "Farben: %1, das bedeutungstragende Farben unterscheidbar hält."

msgctxt "@info"
msgid "Colours: your own colour scheme, as you had it."
msgstr "Farben: Ihr eigenes Farbschema, so wie Sie es hatten."

msgctxt "@info %1 colour scheme name, %2 reason"
msgid "Colours: %1 not applied: %2."
msgstr "Farben: %1 nicht angewendet: %2."

msgctxt "@info"
msgid "Konsole: new windows and tabs use the colour-safe colours; your own profile is kept and lends them everything else."
msgstr "Konsole: neue Fenster und Unterfenster nutzen die farbsicheren Farben; Ihr eigenes Profil bleibt erhalten und liefert alles andere."

msgctxt "@info"
msgid "Konsole: not changed."
msgstr "Konsole: nicht geändert."

msgctxt "@info %1 file, %2 reason"
msgid "Konsole: not set. Could not write %1: %2."
msgstr "Konsole: nicht gesetzt. %1 konnte nicht geschrieben werden: %2."

msgctxt "@info %1 file"
msgid "nano: its selection and guide colours follow the terminal's colours (%1)."
msgstr "nano: Auswahl- und Hilfslinienfarben folgen den Farben des Terminals (%1)."

msgctxt "@info %1 the person's file, %2 lines to add"
msgid "nano: not changed, because %1 is your own file and stays as you wrote it. To get the same colours, add these lines to it: %2"
msgstr "nano: nicht geändert, weil %1 Ihre eigene Datei ist und so bleibt, wie Sie sie geschrieben haben. Für dieselben Farben fügen Sie diese Zeilen hinzu: %2"

msgctxt "@info"
msgid "nano: not changed."
msgstr "nano: nicht geändert."

msgctxt "@info %1 file, %2 reason"
msgid "nano: not set. Could not write %1: %2."
msgstr "nano: nicht gesetzt. %1 konnte nicht geschrieben werden: %2."

msgctxt "@info"
msgid "Text console, outside the desktop: the colour-safe palette from your next login there."
msgstr "Textkonsole außerhalb der Arbeitsfläche: die farbsichere Palette ab Ihrer nächsten Anmeldung dort."

msgctxt "@info"
msgid "Text console: not changed."
msgstr "Textkonsole: nicht geändert."

msgctxt "@info %1 file, %2 reason"
msgid "Text console: not set. Could not write %1: %2."
msgstr "Textkonsole: nicht gesetzt. %1 konnte nicht geschrieben werden: %2."

msgctxt "@info %1 program"
msgid "%1 did not answer."
msgstr "%1 hat nicht geantwortet."

msgctxt "@info %1 program, %2 its message"
msgid "%1 failed: %2"
msgstr "%1 ist fehlgeschlagen: %2"

msgctxt "@option:radio"
msgid "None"
msgstr "Keine"

msgctxt "@info"
msgid "Typical colour vision: nothing is changed."
msgstr "Übliches Farbsehen: nichts wird geändert."

msgctxt "@option:radio"
msgid "Protan"
msgstr "Protan"

msgctxt "@info"
msgid "Reds look darker, and red and green are hard to tell apart."
msgstr "Rot wirkt dunkler, und Rot und Grün sind schwer zu unterscheiden."

msgctxt "@option:radio"
msgid "Deutan"
msgstr "Deutan"

msgctxt "@info"
msgid "Red and green are hard to tell apart."
msgstr "Rot und Grün sind schwer zu unterscheiden."

msgctxt "@option:radio"
msgid "Tritan"
msgstr "Tritan"

msgctxt "@info"
msgid "Blue and yellow, and blue and green, are hard to tell apart."
msgstr "Blau und Gelb sowie Blau und Grün sind schwer zu unterscheiden."

msgctxt "@option:radio"
msgid "Monochromacy"
msgstr "Monochromasie"

msgctxt "@info"
msgid "No colours, only light and dark."
msgstr "Keine Farben, nur Hell und Dunkel."

msgctxt "@info"
msgid "Choose your kind of colour vision. The desktop then keeps apart the colours that carry meaning: errors and successes, links, a terminal's prompt."
msgstr "Wählen Sie Ihre Art des Farbsehens. Die Arbeitsfläche hält dann die bedeutungstragenden Farben unterscheidbar: Fehler und Erfolge, Verknüpfungen, die Eingabeaufforderung eines Terminals."

msgctxt "@label"
msgid "Colour vision:"
msgstr "Farbsehen:"

msgctxt "@label"
msgid "Terminals:"
msgstr "Terminals:"

msgctxt "@option:check"
msgid "Also change the colours of Konsole, nano and the text console"
msgstr "Auch die Farben von Konsole, nano und der Textkonsole ändern"

msgctxt "@title:group"
msgid "What is set now"
msgstr "Was jetzt eingestellt ist"

msgctxt "@info"
msgid "For 3D, red-cyan glasses are the last choice for you: they rebuild the picture's colours from red and cyan, and red and green already run together for you. A 3D television or another of the screen's 3D outputs keeps every colour."
msgstr "Für 3D sind Rot-Cyan-Brillen für Sie die letzte Wahl: Sie setzen die Farben des Bildes aus Rot und Cyan zusammen, und Rot und Grün fließen für Sie ohnehin ineinander. Ein 3D-Fernseher oder eine andere 3D-Ausgabe des Bildschirms erhält jede Farbe."

msgctxt "@action:button"
msgid "Open Display Settings"
msgstr "Anzeige-Einstellungen öffnen"

msgctxt "@info"
msgid "The strength of the screen correction is set on the Accessibility page, which shows this same choice."
msgstr "Die Stärke der Bildschirmkorrektur stellen Sie auf der Seite Barrierefreiheit ein, die dieselbe Wahl zeigt."

msgctxt "@action:button"
msgid "Open Accessibility"
msgstr "Barrierefreiheit öffnen"

msgctxt "@item colour role"
msgid "error text"
msgstr "Fehlertext"

msgctxt "@item colour role"
msgid "success text"
msgstr "Erfolgstext"

msgctxt "@item colour role"
msgid "warning text"
msgstr "Warnungstext"

msgctxt "@item colour role"
msgid "links"
msgstr "Verknüpfungen"

msgctxt "@item colour role"
msgid "visited links"
msgstr "besuchte Verknüpfungen"

msgctxt "@item colour role"
msgid "normal text"
msgstr "normaler Text"

msgctxt "@item colour role"
msgid "the focus frame"
msgstr "der Fokusrahmen"

msgctxt "@item two colours that look alike"
msgid "%1 and %2"
msgstr "%1 und %2"

msgctxt "@info %1 colour scheme name"
msgid "Colours: %1. This colour scheme was not measured; its colours that carry meaning now take the colour-vision map's colours."
msgstr "Farben: %1. Dieses Farbschema wurde nicht vermessen; seine bedeutungstragenden Farben übernehmen die Farben der Farbsehen-Tabelle."

msgctxt "@info %1 colour scheme name, %2 list of colour pairs"
msgid "Colours: %1. In this colour scheme some colours stay close for you: %2. Sparky Stereo Oxygen Dark keeps them apart."
msgstr "Farben: %1. In diesem Farbschema bleiben für Sie einige Farben einander nah: %2. Sparky Stereo Oxygen Dark hält sie auseinander."

msgid "Colour vision"
msgstr "Farbsehen"
