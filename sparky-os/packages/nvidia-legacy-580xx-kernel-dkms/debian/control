Pre-Depends: nvidia-installer-cleanup
Depends: dkms (>= 3.1.8), gcc, nvidia-kernel-support, sparky-stereo-nvidia-legacy-580xx-driver-lock (>= ${source:Version}), ${misc:Depends}
Recommends: nvidia-driver (= ${nvidia:Version}) | nvidia-driver-cuda (= ${nvidia:Version})
Conflicts: nvidia-kernel-dkms, nvidia-kernel-open-dkms
Replaces: nvidia-kernel-dkms
