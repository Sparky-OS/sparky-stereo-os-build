--- a/thumbnail/threemfcreator.cpp
+++ b/thumbnail/threemfcreator.cpp
@@ -0,0 +1,87 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+ *
+ * SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+ */
+
+#include "threemfcreator.h"
+
+#include <QImage>
+#include <QProcess>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+
+#include <KConfigGroup>
+#include <KPluginFactory>
+#include <KSharedConfig>
+#include <KZip>
+
+K_PLUGIN_CLASS_WITH_JSON(ThreeMFCreator, "threemfthumbnail.json")
+
+ThreeMFCreator::ThreeMFCreator(QObject *parent, const QVariantList &args)
+    : KIO::ThumbnailCreator(parent, args)
+{
+}
+
+ThreeMFCreator::~ThreeMFCreator() = default;
+
+static QImage embeddedPicture(const QString &path)
+{
+    KZip zip(path);
+    if (!zip.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    // Where slicers write it (PrusaSlicer, Bambu Studio, Cura: Metadata/thumbnail.png; the package relationship type
+    // http://schemas.openxmlformats.org/package/2006/relationships/metadata/thumbnail names the same part)
+    const KArchiveEntry *entry = zip.directory()->entry(QStringLiteral("Metadata/thumbnail.png"));
+    if (entry && entry->isFile()) {
+        QImage image;
+        if (image.loadFromData(static_cast<const KZipFileEntry *>(entry)->data(), "PNG")) {
+            return image;
+        }
+    }
+    return {};
+}
+
+static QImage renderedPair(const QString &path, int size)
+{
+    // F3D's thumbnailer of Sparky Stereo OS draws the model as a stereo pair, marked with X-KDE::Stereo3DLayout
+    const QString program = QStandardPaths::findExecutable(QStringLiteral("f3d-thumbnail-pair"));
+    if (program.isEmpty()) {
+        return {};
+    }
+    QTemporaryDir dir;
+    if (!dir.isValid()) {
+        return {};
+    }
+    const QString out = dir.filePath(QStringLiteral("pair.png"));
+    QProcess process;
+    process.start(program, {QStringLiteral("assimp"), QString::number(size), path, out});
+    if (!process.waitForFinished(30000) || process.exitCode() != 0) {
+        return {};
+    }
+    QImage image(out);
+    if (!image.isNull()) {
+        image.setText(QStringLiteral("Stereo3DLayout"), image.text(QStringLiteral("X-KDE::Stereo3DLayout")));
+    }
+    return image;
+}
+
+KIO::ThumbnailResult ThreeMFCreator::create(const KIO::ThumbnailRequest &request)
+{
+    const QString path = request.url().toLocalFile();
+    const bool preferRender = KSharedConfig::openConfig(QStringLiteral("kdeglobals"))->group(QStringLiteral("PreviewSettings")).readEntry("ThreeMFPreferRender", false);
+    const int size = qMax(request.targetSize().width(), 64);
+
+    for (int pass = 0; pass < 2; ++pass) {
+        const bool renderNow = (pass == 0) == preferRender;
+        const QImage image = renderNow ? renderedPair(path, size) : embeddedPicture(path);
+        if (!image.isNull()) {
+            return KIO::ThumbnailResult::pass(image);
+        }
+    }
+    return KIO::ThumbnailResult::fail();
+}
+
+#include "moc_threemfcreator.cpp"
+#include "threemfcreator.moc"
