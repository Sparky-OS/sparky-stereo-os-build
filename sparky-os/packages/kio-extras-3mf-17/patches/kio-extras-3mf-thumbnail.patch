+/*
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+ *
+ * SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+ */
+
+#pragma once
+
+#include <KIO/ThumbnailCreator>
+
+/*
+ * The thumbnail of a 3MF file: the picture the slicer embedded in it (Metadata/thumbnail.png, 3MF Core specification 1.4,
+ * Annex "Thumbnail") or, when it has none or the person prefers it, the model drawn by F3D's f3d-thumbnail-pair as a
+ * stereo pair. The person's choice is ThreeMFPreferRender in the PreviewSettings group of kdeglobals (default false: the
+ * slicer's picture first).
+ */
+class ThreeMFCreator : public KIO::ThumbnailCreator
+{
+    Q_OBJECT
+public:
+    ThreeMFCreator(QObject *parent, const QVariantList &args);
+    ~ThreeMFCreator() override;
+
+    KIO::ThumbnailResult create(const KIO::ThumbnailRequest &request) override;
+};
