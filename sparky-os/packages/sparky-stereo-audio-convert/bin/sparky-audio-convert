#!/bin/bash
# Created by Paweł "pavroo" Pijanowski and Daniel Ramos (Capitain Jack) 2026/10/06
# Copyright 2026 under the GNU GPL3 License
# Last update 2026/10/06
# Converts audio files to FLAC, Ogg Vorbis, Opus, MP3 or WAV with FFmpeg, keeping the tags.
# Called by the Dolphin service menu: sparky-audio-convert FORMAT FILE...
# Runs as the user (no root check: it only writes next to the files it is given).
set -u
DIR=/usr/share/sparky/sparky-audio-convert
LANGCODE=$(grep -m1 '^LANG=' /etc/default/locale 2>/dev/null | cut -d= -f2 | tr -d '"')
LANGCODE=${LANG:-$LANGCODE}
LANGCODE=${LANGCODE%%.*}
if [ -f "$DIR/$LANGCODE" ]; then
	. "$DIR/$LANGCODE"
elif [ -f "$DIR/${LANGCODE%%_*}" ]; then
	. "$DIR/${LANGCODE%%_*}"
else
	. "$DIR/en"
fi

FORMAT=${1:-}
shift || true
case "$FORMAT" in
	flac) EXT=flac; LABEL=FLAC; CODEC=(-c:a flac) ;;
	ogg) EXT=ogg; LABEL="Ogg Vorbis"; CODEC=(-c:a libvorbis -q:a 5) ;;
	opus) EXT=opus; LABEL=Opus; CODEC=(-c:a libopus -b:a 128k) ;;
	mp3) EXT=mp3; LABEL=MP3; CODEC=(-c:a libmp3lame -q:a 2 -id3v2_version 3) ;;
	wav) EXT=wav; LABEL=WAV; CODEC=(-c:a pcm_s16le) ;;
	*) echo "usage: sparky-audio-convert flac|ogg|opus|mp3|wav FILE..." >&2; exit 2 ;;
esac
[ $# -gt 0 ] || { echo "usage: sparky-audio-convert flac|ogg|opus|mp3|wav FILE..." >&2; exit 2; }

say() { # text, seconds: a KDE popup when there is a desktop, the terminal otherwise
	if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v kdialog >/dev/null; then
		# in the background: the popup stays for its time and the menu action must not wait for it
		kdialog --title "$LOCAL1" --passivepopup "$1" "${2:-6}" >/dev/null 2>&1 &
	else
		echo "$1"
	fi
}
fail() {
	if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v kdialog >/dev/null; then
		kdialog --title "$LOCAL1" --error "$1"
	else
		echo "$1" >&2
	fi
}

command -v ffmpeg >/dev/null || { fail "$LOCAL2"; exit 1; }

ok=0
bad=0
for f in "$@"; do
	[ -f "$f" ] || continue
	base=${f%.*}
	out=$base.$EXT
	n=1
	# never overwrite: the source file, or an earlier conversion, stays
	while [ -e "$out" ]; do
		out=$base-$n.$EXT
		n=$((n + 1))
	done
	if ffmpeg -nostdin -loglevel error -i "$f" -vn -map_metadata 0 "${CODEC[@]}" "$out"; then
		ok=$((ok + 1))
	else
		rm -f "$out"
		bad=$((bad + 1))
		fail "$LOCAL3: $(basename "$f")"
	fi
done

if [ "$bad" -eq 0 ]; then
	say "$(printf "$LOCAL4" "$ok" "$LABEL")" 6
else
	say "$(printf "$LOCAL5" "$ok" "$bad")" 10
fi
[ "$bad" -eq 0 ]
