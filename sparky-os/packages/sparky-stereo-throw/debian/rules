#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack)
# SPDX-License-Identifier: GPL-2.0-or-later
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo

override_dh_auto_install:
	dh_auto_install
	# a Throw's failures are kept by the edition's one engine: its sentences, word for word from the .po files, as
	# journal catalogs the engine reads in the person's language
	mkdir -p debian/sparky-stereo-throw/usr/lib/systemd/catalog
	sparky-stereo-problems catalog sparky-stereo-throw po debian/sparky-stereo-throw/usr/lib/systemd/catalog \
		--domain sparky-stereo-throw --context "@info a Throw failed" --context "@info a Throw cannot start" \
		--context "@info a Cast device whose model is not in the table; %1 its name" \
		--subject "@title notification the subject of a kept Throw problem|A Throw could not go on"

# dh_auto_test runs ctest: the hand-written CastMessage against pychromecast's generated module, both ways

# the problems engine's library lives in its own folder with no shlibs file (as sparky-stereo-cec's build reads it):
# found there, and its package is named in Depends
override_dh_shlibdeps:
	dh_shlibdeps -l$(shell pkg-config --variable=libdir sparky-stereo-problems) -- --ignore-missing-info
