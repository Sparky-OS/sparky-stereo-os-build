msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 why the stream could not start"
msgid "The Throw to %1 could not start its stream: %2"
msgstr "El Throw a %1 no pudo iniciar la transmisión: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 what KWin answered"
msgid "KWin could not make the network screen for %1: %2"
msgstr "KWin no pudo crear la pantalla de red para %1: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 what the encoder said"
msgid "The picture for %1 could not be encoded: %2"
msgstr "No se pudo codificar la imagen para %1: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 the reason it gave"
msgid "%1 refused to start its media player: %2"
msgstr "%1 se negó a iniciar su reproductor multimedia: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 the reason it gave"
msgid "%1 refused the stream: %2"
msgstr "%1 rechazó la transmisión: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 the reason it gave"
msgid "%1 could not be reached: %2"
msgstr "No se pudo conectar con %1: %2"

msgctxt "@info a Throw ended; %1 is the Cast device's name"
msgid "%1 stopped answering. The Throw to it has ended."
msgstr "%1 dejó de responder. El Throw a ese dispositivo terminó."

msgctxt "@info:status a Throw ended on the device's side; %1 is its name"
msgid "%1 closed the Throw."
msgstr "%1 cerró el Throw."

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 a number of seconds"
msgid "%1 did not fetch the stream within %2 seconds."
msgstr "%1 no obtuvo la transmisión en %2 segundos."

msgctxt "@info a Throw cannot start; %1 is the Cast device's name"
msgid "%1 is a speaker or a group: it has no screen to throw to."
msgstr "%1 es un altavoz o un grupo: no tiene pantalla para el Throw."

msgctxt "@info:status a Throw ended; %1 is the Cast device's name"
msgid "The Throw to %1 has ended."
msgstr "El Throw a %1 terminó."

msgctxt "@info:status a Throw runs; %1 is the Cast device's name"
msgid "Throwing to %1."
msgstr "Throw a %1 en curso."

msgctxt "@info a Cast device whose model is not in the table; %1 its name, %2 its model"
msgid "%1 (model %2) is not in the device table. Its Throw uses the limits of the first Chromecast: 1920x1080 at 30 frames a second, H.264."
msgstr "%1 (modelo %2) no está en la tabla de dispositivos. Su Throw usa los límites del primer Chromecast: 1920x1080 a 30 fotogramas por segundo, H.264."

msgctxt "@info:usage the command's help; keep the words in angle brackets' meaning"
msgid "Usage: sparky-stereo-throw list | throw <id> [--wait SECONDS] | stop <id> | info <id> | volume <id> <0..1|-> [mute|unmute]\n"
msgstr "Uso: sparky-stereo-throw list | throw <id> [--wait SEGUNDOS] | stop <id> | info <id> | volume <id> <0..1|-> [mute|unmute]\n"

msgctxt "@title notification the subject of a kept Throw problem"
msgid "A Throw could not go on"
msgstr "Un Throw no pudo continuar"

msgctxt "@info the daemon is not on the session bus"
msgid "The Throw service is not running (org.sparky.Throw)."
msgstr "El servicio de Throw no está en ejecución (org.sparky.Throw)."

msgctxt "@info a Cast model's generation, from the device table"
msgid "Chromecast, first, second or third generation (the model name does not tell them apart)"
msgstr "Chromecast, primera, segunda o tercera generación (el nombre del modelo no las distingue)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Nest Hub (display)"
msgstr "Google Nest Hub (pantalla)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Nest Hub Max (display)"
msgstr "Google Nest Hub Max (pantalla)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Chromecast Audio (speaker, no screen)"
msgstr "Chromecast Audio (altavoz, sin pantalla)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Home (speaker, no screen)"
msgstr "Google Home (altavoz, sin pantalla)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Home Mini (speaker, no screen)"
msgstr "Google Home Mini (altavoz, sin pantalla)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Nest Mini (speaker, no screen)"
msgstr "Google Nest Mini (altavoz, sin pantalla)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Nest Audio (speaker, no screen)"
msgstr "Nest Audio (altavoz, sin pantalla)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "a group of speakers"
msgstr "un grupo de altavoces"

msgctxt "@info a Cast model's generation, from the device table"
msgid "not in the table: the first Chromecast's limits"
msgstr "no está en la tabla: los límites del primer Chromecast"

msgctxt "@info a Cast device's model and what the model name tells; %1 model, %2 generation"
msgid "%1 — %2"
msgstr "%1 — %2"

msgctxt "@info a Cast device whose model is not in the table; %1 its model"
msgid "%1 — not in the device table: the first Chromecast's limits are used"
msgstr "%1 — no está en la tabla de dispositivos: se usan los límites del primer Chromecast"

msgctxt "@info:status a Throw is being set up"
msgid "Starting…"
msgstr "Iniciando…"

msgctxt "@info a Cast device's address and the mode its Throw uses; %1 address, %2 mode"
msgid "%1 · %2"
msgstr "%1 · %2"

msgctxt "@action:button start a Throw to this device"
msgid "Throw"
msgstr "Throw"

msgctxt "@action:button end the running Throw"
msgid "Stop Throwing"
msgstr "Detener el Throw"

msgctxt "@action:button open this device's page"
msgid "Details"
msgstr "Detalles"

msgctxt "@info no Cast device announced itself"
msgid "No Cast device found on this network."
msgstr "No se encontró ningún dispositivo Cast en esta red."

msgctxt "@info"
msgid "A Chromecast, a Google TV or a TV with Google Cast built in appears here by itself when it is switched on and on the same network as this computer."
msgstr "Un Chromecast, un Google TV o un televisor con Google Cast integrado aparece aquí solo cuando está encendido y en la misma red que este equipo."

msgctxt "@title:group what the device says about itself"
msgid "This device"
msgstr "Este dispositivo"

msgctxt "@label the name the person gave the device"
msgid "Name:"
msgstr "Nombre:"

msgctxt "@label"
msgid "Model:"
msgstr "Modelo:"

msgctxt "@label"
msgid "Maker:"
msgstr "Fabricante:"

msgctxt "@label what the model name tells about the device"
msgid "Generation:"
msgstr "Generación:"

msgctxt "@label"
msgid "Address:"
msgstr "Dirección:"

msgctxt "@label the device's software version"
msgid "Firmware:"
msgstr "Firmware:"

msgctxt "@info the device did not give it"
msgid "not given by the device"
msgstr "el dispositivo no lo indica"

msgctxt "@label the picture a Throw sends"
msgid "Throw mode:"
msgstr "Modo del Throw:"

msgctxt "@info %1 the mode, %2 the codec, %3 its level"
msgid "%1, %2 level %3"
msgstr "%1, %2 nivel %3"

msgctxt "@action:button the network screen's 3D format and eye swap are in Display Settings"
msgid "3D Format and Eye Swap…"
msgstr "Formato 3D e intercambio de ojos…"

msgctxt "@title:group settings the device takes from this computer with no account"
msgid "Set from here"
msgstr "Ajustar desde aquí"

msgctxt "@label the device's own volume"
msgid "Volume:"
msgstr "Volumen:"

msgctxt "@info a percentage"
msgid "%1%"
msgstr "%1 %"

msgctxt "@option:check the device's sound off"
msgid "Muted"
msgstr "Silenciado"

msgctxt "@info the device's volume is set by the TV or receiver it is connected to"
msgid "The volume is set on the TV or receiver this device is connected to."
msgstr "El volumen se ajusta en el televisor o receptor al que está conectado este dispositivo."

msgctxt "@title:group settings that need the person's Google account"
msgid "Needs your Google account"
msgstr "Necesita tu cuenta de Google"

msgctxt "@item a device setting that needs the Google account"
msgid "Name"
msgstr "Nombre"

msgctxt "@item a device setting that needs the Google account"
msgid "Time zone and language"
msgstr "Zona horaria e idioma"

msgctxt "@item a device setting that needs the Google account"
msgid "Wi-Fi network"
msgstr "Red Wi-Fi"

msgctxt "@item a device setting that needs the Google account"
msgid "Restart and factory reset"
msgstr "Reinicio y restablecimiento de fábrica"

msgctxt "@item a device setting that needs the Google account"
msgid "Ambient screen and photos"
msgstr "Pantalla ambiente y fotos"

msgctxt "@item a device setting that needs the Google account"
msgid "Guest mode"
msgstr "Modo invitado"

msgctxt "@item a device setting that needs the Google account"
msgid "Speaker groups"
msgstr "Grupos de altavoces"

msgctxt "@info why the settings above cannot be changed here"
msgid "These need a key the device gives only to your Google account. Sign in under Online Accounts; the Google account there does not give that key yet, so for now they are changed in the Google Home app."
msgstr "Estos ajustes necesitan una clave que el dispositivo solo da a tu cuenta de Google. Inicia sesión en Cuentas en línea; la cuenta de Google de allí aún no da esa clave, así que por ahora se cambian en la app Google Home."

msgctxt "@action:button open KDE's Online Accounts page"
msgid "Open Online Accounts…"
msgstr "Abrir Cuentas en línea…"
