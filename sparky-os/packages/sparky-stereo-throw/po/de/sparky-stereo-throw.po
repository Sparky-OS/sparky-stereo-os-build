msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 why the stream could not start"
msgid "The Throw to %1 could not start its stream: %2"
msgstr "Der Throw an %1 konnte seinen Stream nicht starten: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 what KWin answered"
msgid "KWin could not make the network screen for %1: %2"
msgstr "KWin konnte den Netzwerkbildschirm für %1 nicht anlegen: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 what the encoder said"
msgid "The picture for %1 could not be encoded: %2"
msgstr "Das Bild für %1 konnte nicht kodiert werden: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 the reason it gave"
msgid "%1 refused to start its media player: %2"
msgstr "%1 hat den Start seines Medienplayers abgelehnt: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 the reason it gave"
msgid "%1 refused the stream: %2"
msgstr "%1 hat den Stream abgelehnt: %2"

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 the reason it gave"
msgid "%1 could not be reached: %2"
msgstr "%1 ist nicht erreichbar: %2"

msgctxt "@info a Throw ended; %1 is the Cast device's name"
msgid "%1 stopped answering. The Throw to it has ended."
msgstr "%1 antwortet nicht mehr. Der Throw an dieses Gerät wurde beendet."

msgctxt "@info:status a Throw ended on the device's side; %1 is its name"
msgid "%1 closed the Throw."
msgstr "%1 hat den Throw geschlossen."

msgctxt "@info a Throw failed; %1 is the Cast device's name, %2 a number of seconds"
msgid "%1 did not fetch the stream within %2 seconds."
msgstr "%1 hat den Stream nicht innerhalb von %2 Sekunden abgerufen."

msgctxt "@info a Throw cannot start; %1 is the Cast device's name"
msgid "%1 is a speaker or a group: it has no screen to throw to."
msgstr "%1 ist ein Lautsprecher oder eine Gruppe: Es hat keinen Bildschirm für den Throw."

msgctxt "@info:status a Throw ended; %1 is the Cast device's name"
msgid "The Throw to %1 has ended."
msgstr "Der Throw an %1 wurde beendet."

msgctxt "@info:status a Throw runs; %1 is the Cast device's name"
msgid "Throwing to %1."
msgstr "Throw an %1 läuft."

msgctxt "@info a Cast device whose model is not in the table; %1 its name, %2 its model"
msgid "%1 (model %2) is not in the device table. Its Throw uses the limits of the first Chromecast: 1920x1080 at 30 frames a second, H.264."
msgstr "%1 (Modell %2) steht nicht in der Gerätetabelle. Sein Throw nutzt die Grenzen des ersten Chromecast: 1920x1080 bei 30 Bildern pro Sekunde, H.264."

msgctxt "@info:usage the command's help; keep the words in angle brackets' meaning"
msgid "Usage: sparky-stereo-throw list | throw <id> [--wait SECONDS] | stop <id> | info <id> | volume <id> <0..1|-> [mute|unmute] | status <id> | choose <id> <codec|-> [<mode>|-] | sound <id> <sound|->\n"
msgstr "Aufruf: sparky-stereo-throw list | throw <id> [--wait SEKUNDEN] | stop <id> | info <id> | volume <id> <0..1|-> [mute|unmute] | status <id> | choose <id> <codec|-> [<mode>|-] | sound <id> <sound|->\n"

msgctxt "@title notification the subject of a kept Throw problem"
msgid "A Throw could not go on"
msgstr "Ein Throw konnte nicht fortgesetzt werden"

msgctxt "@info the daemon is not on the session bus"
msgid "The Throw service is not running (org.sparky.Throw)."
msgstr "Der Throw-Dienst läuft nicht (org.sparky.Throw)."

msgctxt "@info a Cast model's generation, from the device table"
msgid "Chromecast, first, second or third generation (the model name does not tell them apart)"
msgstr "Chromecast, erste, zweite oder dritte Generation (der Modellname unterscheidet sie nicht)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Nest Hub (display)"
msgstr "Google Nest Hub (Display)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Nest Hub Max (display)"
msgstr "Google Nest Hub Max (Display)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Chromecast Audio (speaker, no screen)"
msgstr "Chromecast Audio (Lautsprecher, ohne Bildschirm)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Home (speaker, no screen)"
msgstr "Google Home (Lautsprecher, ohne Bildschirm)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Home Mini (speaker, no screen)"
msgstr "Google Home Mini (Lautsprecher, ohne Bildschirm)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Google Nest Mini (speaker, no screen)"
msgstr "Google Nest Mini (Lautsprecher, ohne Bildschirm)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "Nest Audio (speaker, no screen)"
msgstr "Nest Audio (Lautsprecher, ohne Bildschirm)"

msgctxt "@info a Cast model's generation, from the device table"
msgid "a group of speakers"
msgstr "eine Lautsprechergruppe"

msgctxt "@info a Cast model's generation, from the device table"
msgid "not in the table: the first Chromecast's limits"
msgstr "nicht in der Tabelle: die Grenzen des ersten Chromecast"

msgctxt "@info why a Throw cannot be made as chosen; %1 a codec"
msgid "the device does not take %1"
msgstr "das Gerät nimmt kein %1 an"

msgctxt "@info why a Throw cannot be made as chosen; %1 a codec, %2 the encoders looked for"
msgid "this computer cannot encode %1: %2"
msgstr "dieser Rechner kann kein %1 kodieren: %2"

msgctxt "@info why a Throw cannot be made"
msgid "this computer cannot encode any codec the device takes"
msgstr "dieser Rechner kann keinen Codec kodieren, den das Gerät annimmt"

msgctxt "@info why a Throw cannot be made as chosen; %1 a mode, %2 a codec"
msgid "%1 in %2 is not a mode the device takes"
msgstr "%1 in %2 ist kein Modus, den das Gerät annimmt"

msgctxt "@info a device gets less than it can show; %1 and %3 sizes, %2 codecs, %4 a codec"
msgid "It shows up to %1 in %2; this computer has no encoder for it, so it gets %3 in %4."
msgstr "Es zeigt bis zu %1 in %2; dieser Rechner hat dafür keinen Encoder, daher bekommt es %3 in %4."

msgctxt "@info a Throw cannot start as chosen; %1 is the Cast device's name, %2 why"
msgid "The Throw to %1 cannot start as chosen: %2. Choose another codec or mode on its page."
msgstr "Der Throw zu %1 kann nicht wie gewählt starten: %2. Wählen Sie auf seiner Seite einen anderen Codec oder Modus."

msgctxt "@item the sound output of a Throw; %1 is the Cast device's name"
msgid "Throw: %1"
msgstr "Throw: %1"

msgctxt "@info a Cast model in a few words, from the device table"
msgid "1st to 3rd generation"
msgstr "1. bis 3. Generation"

msgctxt "@info a Cast model in a few words, from the device table"
msgid "display, 720p"
msgstr "Display, 720p"

msgctxt "@info a Cast model in a few words, from the device table"
msgid "speaker"
msgstr "Lautsprecher"

msgctxt "@info a Cast model in a few words, from the device table"
msgid "speaker group"
msgstr "Lautsprechergruppe"

msgctxt "@info a Cast model in a few words, from the device table"
msgid "not in the table"
msgstr "nicht in der Tabelle"

msgctxt "@info the sound a Throw carries; %1 a sound, %2 kilohertz, %3 channels"
msgid "%1, %2 kHz, %3 channels (compressed: the WebM stream the device takes carries Opus or Vorbis only)"
msgstr "%1, %2 kHz, %3 Kanäle (komprimiert: der WebM-Stream, den das Gerät annimmt, trägt nur Opus oder Vorbis)"

msgctxt "@info the sound a Throw carries; %1 a sound, %2 kilohertz, %3 channels"
msgid "%1, %2 kHz, %3 channels (lossless)"
msgstr "%1, %2 kHz, %3 Kanäle (verlustfrei)"

msgctxt "@info the sound a Throw carries; %1 a sound, %2 kilohertz, %3 channels"
msgid "%1, %2 kHz, %3 channels (compressed)"
msgstr "%1, %2 kHz, %3 Kanäle (komprimiert)"

msgctxt "@info the sound a Throw carries; %1 a sound, %2 kilohertz"
msgid "%1, %2 kHz (the device, or the television or receiver behind it, decodes it; a stereo source plays on the front speakers)"
msgstr "%1, %2 kHz (das Gerät oder der Fernseher bzw. Receiver dahinter dekodiert es; eine Stereoquelle spielt auf den Frontlautsprechern)"

msgctxt "@info why a Throw cannot be made as chosen; %1 a sound, %2 a codec"
msgid "the stream of %2 cannot carry %1 sound"
msgstr "der %2-Stream kann keinen %1-Ton tragen"

msgctxt "@info a Throw ended; %1 the Cast device's name, %2 seconds, %3 the device's player state, %4 its time in seconds, %5 a sound"
msgid "%1 did not start playing within %2 seconds (it said %3, at %4 s). The Throw has ended. It carried %5 sound; the next Throw to it takes another one, or choose one on its page."
msgstr "%1 hat nicht innerhalb von %2 Sekunden mit der Wiedergabe begonnen (es meldete %3, bei %4 s). Der Throw ist beendet. Er trug %5-Ton; der nächste Throw zu ihm nimmt einen anderen, oder wählen Sie einen auf seiner Seite."

msgctxt "@item a sound format; keep the format's name"
msgid "PCM, 24 bit"
msgstr "PCM, 24 Bit"

msgctxt "@item a sound format; keep the format's name"
msgid "FLAC, 24 bit"
msgstr "FLAC, 24 Bit"

msgctxt "@item a sound format; keep the format's name"
msgid "PCM, 16 bit"
msgstr "PCM, 16 Bit"

msgctxt "@info what a sound format means for a person"
msgid "Six channels, for a television or receiver with 5.1 speakers, which decodes them. A stereo source plays on the front speakers only: nothing is spread to the other speakers."
msgstr "Sechs Kanäle, für einen Fernseher oder Receiver mit 5.1-Lautsprechern, der sie dekodiert. Eine Stereoquelle spielt nur auf den Frontlautsprechern: nichts wird auf die anderen Lautsprecher verteilt."

msgctxt "@info what a sound format means for a person; %1 megabits a second"
msgid "Lossless: the sound exactly as this computer plays it, not compressed. It takes the most of the network, about %1 Mbit/s."
msgstr "Verlustfrei: der Ton genau so, wie dieser Rechner ihn abspielt, unkomprimiert. Er braucht am meisten vom Netzwerk, etwa %1 Mbit/s."

msgctxt "@info what a sound format means for a person"
msgid "Lossless: the sound exactly as this computer plays it, packed smaller without leaving anything out."
msgstr "Verlustfrei: der Ton genau so, wie dieser Rechner ihn abspielt, kleiner gepackt, ohne etwas wegzulassen."

msgctxt "@info what a sound format means for a person"
msgid "Compressed: a smaller stream that leaves out some of the sound, which few people hear."
msgstr "Komprimiert: ein kleinerer Stream, der einen Teil des Tons weglässt, was nur wenige hören."

msgctxt "@info a Cast device's model and what the model name tells; %1 model, %2 generation"
msgid "%1 — %2"
msgstr "%1 — %2"

msgctxt "@info a Cast device whose model is not in the table; %1 its model"
msgid "%1 — not in the device table: the first Chromecast's limits are used"
msgstr "%1 — nicht in der Gerätetabelle: Es gelten die Grenzen des ersten Chromecast"

msgctxt "@info:status a Throw is being set up"
msgid "Starting…"
msgstr "Wird gestartet …"

msgctxt "@info a Cast device's address and the mode its Throw uses; %1 address, %2 mode"
msgid "%1 · %2"
msgstr "%1 · %2"

msgctxt "@action:button start a Throw to this device"
msgid "Throw"
msgstr "Throw"

msgctxt "@action:button end the running Throw"
msgid "Stop Throwing"
msgstr "Throw beenden"

msgctxt "@action:button open this device's page"
msgid "Details"
msgstr "Details"

msgctxt "@info no Cast device announced itself"
msgid "No Cast device found on this network."
msgstr "Kein Cast-Gerät in diesem Netzwerk gefunden."

msgctxt "@info"
msgid "A Chromecast, a Google TV or a TV with Google Cast built in appears here by itself when it is switched on and on the same network as this computer."
msgstr "Ein Chromecast, ein Google TV oder ein Fernseher mit integriertem Google Cast erscheint hier von selbst, wenn er eingeschaltet und im selben Netzwerk wie dieser Rechner ist."

msgctxt "@title:group what the device says about itself"
msgid "This device"
msgstr "Dieses Gerät"

msgctxt "@label the name the person gave the device"
msgid "Name:"
msgstr "Name:"

msgctxt "@label"
msgid "Model:"
msgstr "Modell:"

msgctxt "@label"
msgid "Maker:"
msgstr "Hersteller:"

msgctxt "@label what the model name tells about the device"
msgid "Generation:"
msgstr "Generation:"

msgctxt "@label"
msgid "Address:"
msgstr "Adresse:"

msgctxt "@label the device's software version"
msgid "Firmware:"
msgstr "Firmware:"

msgctxt "@info the device did not give it"
msgid "not given by the device"
msgstr "vom Gerät nicht angegeben"

msgctxt "@label the picture a Throw sends"
msgid "Throw mode:"
msgstr "Throw-Modus:"

msgctxt "@info %1 the mode, %2 the codec, %3 its level"
msgid "%1, %2 level %3"
msgstr "%1, %2 Level %3"

msgctxt "@action:button the network screen's 3D format and eye swap are in Display Settings"
msgid "3D Format and Eye Swap…"
msgstr "3D-Format und Augentausch …"

msgctxt "@title:group settings the device takes from this computer with no account"
msgid "Set from here"
msgstr "Von hier einstellen"

msgctxt "@label the device's own volume"
msgid "Volume:"
msgstr "Lautstärke:"

msgctxt "@info a percentage"
msgid "%1%"
msgstr "%1 %"

msgctxt "@option:check the device's sound off"
msgid "Muted"
msgstr "Stumm"

msgctxt "@info the device's volume is set by the TV or receiver it is connected to"
msgid "The volume is set on the TV or receiver this device is connected to."
msgstr "Die Lautstärke wird am Fernseher oder Receiver eingestellt, an dem dieses Gerät hängt."

msgctxt "@title:group settings that need the person's Google account"
msgid "Needs your Google account"
msgstr "Benötigt Ihr Google-Konto"

msgctxt "@item a device setting that needs the Google account"
msgid "Name"
msgstr "Name"

msgctxt "@item a device setting that needs the Google account"
msgid "Time zone and language"
msgstr "Zeitzone und Sprache"

msgctxt "@item a device setting that needs the Google account"
msgid "Wi-Fi network"
msgstr "WLAN"

msgctxt "@item a device setting that needs the Google account"
msgid "Restart and factory reset"
msgstr "Neustart und Zurücksetzen auf Werkseinstellungen"

msgctxt "@item a device setting that needs the Google account"
msgid "Ambient screen and photos"
msgstr "Ambient-Bildschirm und Fotos"

msgctxt "@item a device setting that needs the Google account"
msgid "Guest mode"
msgstr "Gastmodus"

msgctxt "@item a device setting that needs the Google account"
msgid "Speaker groups"
msgstr "Lautsprechergruppen"

msgctxt "@info why the settings above cannot be changed here"
msgid "These need a key the device gives only to your Google account. Sign in under Online Accounts; the Google account there does not give that key yet, so for now they are changed in the Google Home app."
msgstr "Diese Einstellungen brauchen einen Schlüssel, den das Gerät nur Ihrem Google-Konto gibt. Melden Sie sich unter Online-Konten an; das Google-Konto dort liefert diesen Schlüssel noch nicht, daher werden sie vorerst in der Google-Home-App geändert."

msgctxt "@action:button open KDE's Online Accounts page"
msgid "Open Online Accounts…"
msgstr "Online-Konten öffnen …"

msgctxt "@title:group how a Throw to this device is made"
msgid "Throw"
msgstr "Throw"

msgctxt "@label the video codec a Throw sends"
msgid "Codec:"
msgstr "Codec:"

msgctxt "@item the table's choice; %1 what it is"
msgid "Automatic (%1)"
msgstr "Automatisch (%1)"

msgctxt "@item a codec this computer cannot encode; %1 its name"
msgid "%1 (no encoder on this computer)"
msgstr "%1 (kein Encoder auf diesem Rechner)"

msgctxt "@label the picture's size and rate a Throw sends"
msgid "Mode:"
msgstr "Modus:"

msgctxt "@label the sound a Throw sends"
msgid "Sound:"
msgstr "Ton:"

msgctxt "@label the sound format a Throw sends"
msgid "Sound format:"
msgstr "Tonformat:"

msgctxt "@item a sound this device played; %1 its name"
msgid "%1 (played on this device)"
msgstr "%1 (auf diesem Gerät gespielt)"

msgctxt "@item a sound this device did not start playing; %1 its name"
msgid "%1 (did not start on this device)"
msgstr "%1 (startete auf diesem Gerät nicht)"

msgctxt "@item a sound this device played; %1 its name, %2 seconds"
msgid "%1 (played on this device, started after %2 s)"
msgstr "%1 (auf diesem Gerät gespielt, Start nach %2 s)"

msgctxt "@info how long this device took to start with this sound; %1 seconds"
msgid "On this device it started %1 s after the Throw began; until then the television shows its own loading screen."
msgstr "Auf diesem Gerät startete es %1 s nach Beginn des Throw; bis dahin zeigt der Fernseher seinen eigenen Ladebildschirm."
