+
+bool RecentsMRL::stereoSwap(const QString &mrl)
+{
+    const int index = recents.indexOf(mrl);
+    return isActive && index >= 0 && stereoSwaps.value(index) == "1";
+}
+
+void RecentsMRL::setStereoSwap(const QString &mrl, bool swapped)
+{
+    addRecent(mrl);
+    const int index = recents.indexOf(mrl);
+    if (index >= 0) {
+        stereoSwaps[index] = swapped ? "1" : "0";
+        save();
+        getSettings()->sync();
+    }
+}
+
+bool RecentsMRL::hasStereoSwap(const QString &mrl)
+{
+    const int index = recents.indexOf(mrl);
+    return isActive && index >= 0 && !stereoSwaps.value(index).isEmpty();
+}
