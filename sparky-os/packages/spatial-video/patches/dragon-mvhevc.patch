     return new BackendAttachedType(videoSink, object);
 }
+
+static QString stereoKey(const QUrl &url)
+{
+    return QString::fromLatin1(QCryptographicHash::hash(url.toEncoded(), QCryptographicHash::Sha256).toHex());
+}
+
+bool Backend::stereoSwap(const QUrl &url) const
+{
+    return KConfigGroup(KSharedConfig::openConfig(), QStringLiteral("StereoVideo")).readEntry(stereoKey(url), false);
+}
+
+void Backend::setStereoSwap(const QUrl &url, bool swap)
+{
+    if (url.isEmpty()) return;
+    KConfigGroup group(KSharedConfig::openConfig(), QStringLiteral("StereoVideo"));
+    group.writeEntry(stereoKey(url), swap);
+    group.sync();
+}
