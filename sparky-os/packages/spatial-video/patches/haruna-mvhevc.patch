 #include "moc_database.cpp"
+
+// Corrections live beside playback positions, never in the media or its attributes.
+bool Database::stereoSwap(const QUrl &url)
+{
+    QSqlQuery query(db());
+    query.prepare(u"SELECT swap FROM media_stereo WHERE url = ?"_s);
+    query.addBindValue(url.toString(QUrl::FullyEncoded));
+    return query.exec() && query.next() && query.value(0).toBool();
+}
+
+bool Database::setStereoSwap(const QUrl &url, bool swap)
+{
+    if (url.isEmpty()) return false;
+    QSqlQuery query(db());
+    query.prepare(u"INSERT OR REPLACE INTO media_stereo (url, swap) VALUES (?, ?)"_s);
+    query.addBindValue(url.toString(QUrl::FullyEncoded));
+    query.addBindValue(swap);
+    if (query.exec()) return true;
+    qWarning() << "Could not save stereo correction:" << query.lastError();
+    return false;
+}
