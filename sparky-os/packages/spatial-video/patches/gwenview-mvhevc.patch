 namespace Gwenview
 {
+class StereoVideoItem : public QGraphicsVideoItem
+{
+public:
+    using QGraphicsVideoItem::QGraphicsVideoItem;
+    QImage mono;
+    void paint(QPainter *painter, const QStyleOptionGraphicsItem *option, QWidget *widget) override
+    {
+        if (mono.isNull()) {
+            QGraphicsVideoItem::paint(painter, option, widget);
+            return;
+        }
+        QSizeF fitted = mono.size();
+        fitted.scale(size(), Qt::KeepAspectRatio);
+        QRectF target(QPointF(), fitted);
+        target.moveCenter(QRectF(QPointF(), size()).center());
+        painter->drawImage(target, mono);
+    }
+};
+
