+static enum AVPixelFormat get_format_stereo(AVCodecContext *avctx,
+                                            const enum AVPixelFormat *formats)
+{
+    struct mp_filter *vd = avctx->opaque;
+    vd_ffmpeg_ctx *ctx = vd->priv;
+    stereo_av_pair_configure(ctx->multiview, avctx);
+    return avcodec_default_get_format(avctx, formats);
+}
