[Unit]
Description=Watch the list of rates the system service writes

[Path]
PathChanged=/etc/pipewire/pipewire.conf.d/00-sparky-stereo-audio.conf
Unit=sparky-stereo-audio-apply.service

[Install]
WantedBy=default.target
