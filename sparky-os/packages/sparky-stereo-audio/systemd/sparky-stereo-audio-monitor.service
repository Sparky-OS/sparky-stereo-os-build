[Unit]
Description=sparky-stereo-audio monitor
After=pipewire.service wireplumber.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/sparky-stereo-audio monitor
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
