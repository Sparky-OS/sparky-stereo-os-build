[Desktop Entry]
Type=Application
Name=Hibernate check
Name[de]=Ruhezustand prüfen
Name[pl]=Sprawdzanie hibernacji
Name[pt_BR]=Verificação de hibernação
Name[fr]=Vérification de l’hibernation
Name[ja]=休止状態の確認
Name[ko]=최대 절전 모드 확인
Name[zh_CN]=休眠检查
Name[zh_TW]=休眠檢查
Exec=/usr/libexec/sparky-stereo/hibernate-check --check
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-phase=2
