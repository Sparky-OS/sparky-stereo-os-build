+void DolphinView::refreshStereoPreviews(const QStringList &paths)
+{
+#if HAVE_STEREO_LAYER
+    QList<QUrl> changed;
+    for (const QString &path : paths) {
+        const QUrl url = QUrl::fromLocalFile(path);
+        const int index = m_model->index(url);
+        if (index >= 0) {
+            // a changed value makes the model report the item, and its preview is asked again
+            m_model->setData(index, {{"stereoEyesSwapped", Stereo::Picture::fileChoice(path).swapEyes}, {"stereoChoiceSerial", ++m_stereoChoiceSerial}});
         }
-        m_model->setData(index, {{"stereoEyesSwapped", swapped}});
-        changed.append(item.url());
+        changed.append(url);
     }
     // Whatever shows these files (the information panel, other windows, other programs) shows them again
     if (!changed.isEmpty()) {
         org::kde::KDirNotify::emitFilesChanged(changed);
     }
+#else
+    Q_UNUSED(paths)
+#endif
+}
+
+void DolphinView::setStereoEyesSwapped(const KFileItemList &items, bool swapped)
+{
+#if HAVE_STEREO_LAYER
+    // The correction goes into the stereo layer's per-file store and the file is left as it is; the layer drops the
+    // file's cached thumbnails, so they are made again, and says why when the store cannot be written.
+    QStringList changed;
+    for (const KFileItem &item : items) {
+        if (!item.isLocalFile() || !(hasStereoPreview({item}) || Stereo::Picture::hasFileChoice(item.localPath()))) {
+            continue;
+        }
+        Stereo::Picture::Options choice = Stereo::Picture::fileChoice(item.localPath());
+        if (choice.swapEyes == swapped) {
+            continue;
+        }
+        choice.swapEyes = swapped;
+        QString error;
+        if (!Stereo::Picture::setFileChoice(item.localPath(), choice, &error)) {
+            Q_EMIT errorMessage(item.text() + QLatin1String(": ") + error, KIO::ERR_CANNOT_WRITE);
+            continue;
+        }
+        changed.append(item.localPath());
+    }
+    refreshStereoPreviews(changed);
 #else
     Q_UNUSED(items)
     Q_UNUSED(swapped)
