+
+#include <algorithm>
+
+#include "View3DStereoFit.h"
+
+using namespace Gui;
+
+StereoFitDistances Gui::stereoFitDistances(
+    const StereoFitPixels& in,
+    const std::function<double(float)>& distance
+)
+{
+    StereoFitDistances out;
+    if (!in.sceneDepth) {
+        return out;
+    }
+    auto count = [&](double d) {
+        if (!out.seen) {
+            out.nearest = d;
+            out.farthest = d;
+            out.seen = true;
+        }
+        out.nearest = std::min(out.nearest, d);
+        out.farthest = std::max(out.farthest, d);
+        ++out.pixels;
+    };
+    // Each pixel counts at the depth of its nearest surface, the scene's and the annotations'
+    for (std::size_t i = 0; i < in.count; ++i) {
+        if (in.sceneDepth[i] < 1.0F) {
+            count(distance(in.sceneDepth[i]));
+        }
+        if (in.annotationDepth && in.annotationDepth[i] < 1.0F) {
+            count(distance(in.annotationDepth[i]));
+        }
+    }
+    return out;
+}
