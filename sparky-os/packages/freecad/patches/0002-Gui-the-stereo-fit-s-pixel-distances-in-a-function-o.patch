diff --git a/tests/src/Gui/View3DStereoFit.cpp b/tests/src/Gui/View3DStereoFit.cpp
new file mode 100644
index 0000000..6dcbc64
--- /dev/null
+++ b/tests/src/Gui/View3DStereoFit.cpp
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include <gtest/gtest.h>
+
+#include <vector>
+
+#include <Gui/View3DStereoFit.h>
+
+// The stereo 3D view's fit counts a pixel at the contribution-weighted mean distance of what it
+// shows. Each pixel here is made the way the measuring pass draws it: an opaque surface (or the
+// background, cleared to the screen's distance in the pass fogged toward white and to 0 in the
+// other), then translucent layers blended over it, each fragment fogged linearly from the camera
+// (distance 0) to fogEnd toward white in one pass and toward black in the other.
+
+namespace
+{
+
+constexpr double fogEnd = 1000.0;
+constexpr double screen = 180.0;
+
+// window depth <-> distance: any monotonic map will do for the function under test
+double distanceOf(float depth)
+{
+    return double(depth) * fogEnd;
+}
+float depthOf(double distance)
+{
+    return float(distance / fogEnd);
+}
+
+struct Layer
+{
+    double distance;
+    double alpha;   // 1: opaque
+    double colour;  // the fragment's own colour (red), lit
+};
+
+struct Pixel
+{
+    float sceneDepth = 1.0F;
+    float annotationDepth = 1.0F;
+    float white = 0.0F;
+    float black = 0.0F;
+};
+
+// layers from the back to the front; an opaque one writes depth, a translucent one does not
+Pixel draw(const std::vector<Layer>& layers, bool fogged = true)
+{
+    Pixel p;
+    double white = screen / fogEnd;
+    double black = 0.0;
+    for (const Layer& l : layers) {
+        const double f = fogged ? 1.0 - l.distance / fogEnd : 1.0;  // share of the fragment's colour
+        const double w = f * l.colour + (1.0 - f);
+        const double b = f * l.colour;
+        white = l.alpha * w + (1.0 - l.alpha) * white;
+        black = l.alpha * b + (1.0 - l.alpha) * black;
+        if (l.alpha >= 1.0) {
+            p.sceneDepth = depthOf(l.distance);
+        }
+    }
+    p.white = float(white);
+    p.black = float(black);
+    return p;
+}
+
+Gui::StereoFitDistances measure(const std::vector<Pixel>& pixels, bool colours = true)
+{
+    static std::vector<float> scene, annotation, white, black;
+    scene.clear();
+    annotation.clear();
+    white.clear();
+    black.clear();
+    for (const Pixel& p : pixels) {
+        scene.push_back(p.sceneDepth);
+        annotation.push_back(p.annotationDepth);
+        white.push_back(p.white);
+        black.push_back(p.black);
+    }
+    Gui::StereoFitPixels in;
+    in.sceneDepth = scene.data();
+    in.annotationDepth = annotation.data();
+    in.towardWhite = colours ? white.data() : nullptr;
+    in.towardBlack = colours ? black.data() : nullptr;
+    in.count = pixels.size();
+    in.fogEnd = fogEnd;
+    in.screen = screen;
+    in.nearPlane = 1.0;
+    return Gui::stereoFitDistances(in, distanceOf);
+}
+
+}  // namespace
+
+TEST(View3DStereoFit, opaqueSurfaceCountsAtItsDistance)
+{
+    const auto d = measure({draw({{200.0, 1.0, 0.3}}), draw({{250.0, 1.0, 0.7}})});
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 200.0, 0.01);
+    EXPECT_NEAR(d.farthest, 250.0, 0.01);
+    EXPECT_EQ(d.translucent, 0U);
+}
+
+TEST(View3DStereoFit, halfTransparentLayerCountsAtTheWeightedMean)
+{
+    // 50 % of the pixel is the layer at 100, 50 % the surface behind at 200
+    const auto d = measure({draw({{200.0, 1.0, 0.3}, {100.0, 0.5, 0.8}})});
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 150.0, 0.01);
+    EXPECT_NEAR(d.farthest, 150.0, 0.01);
+    EXPECT_EQ(d.translucent, 1U);
+}
+
+TEST(View3DStereoFit, nearlyInvisibleLayerBarelyMovesThePixel)
+{
+    // 90 % transparency: 10 % of the pixel at 100
+    const auto d = measure({draw({{200.0, 1.0, 0.3}, {100.0, 0.1, 0.8}})});
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 190.0, 0.01);
+}
+
+TEST(View3DStereoFit, layerOverTheBackgroundCountsWithTheScreen)
+{
+    const auto d = measure({draw({{100.0, 0.5, 0.8}})});
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 0.5 * 100.0 + 0.5 * screen, 0.01);
+}
+
+TEST(View3DStereoFit, twoLayersCountByTheirShares)
+{
+    const auto d = measure({draw({{200.0, 1.0, 0.3}, {150.0, 0.5, 0.1}, {100.0, 0.5, 0.9}})});
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 0.5 * 100.0 + 0.25 * 150.0 + 0.25 * 200.0, 0.01);
+}
+
+TEST(View3DStereoFit, annotationCountsWhereItHidesTheScene)
+{
+    // drawn last over a cleared depth: the pixel shows the annotation only
+    Pixel p = draw({{200.0, 1.0, 0.3}, {120.0, 1.0, 0.0}});
+    p.sceneDepth = depthOf(200.0);
+    p.annotationDepth = depthOf(120.0);
+    const auto d = measure({p});
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 120.0, 0.01);
+    EXPECT_NEAR(d.farthest, 120.0, 0.01);
+}
+
+TEST(View3DStereoFit, surfaceDrawnWithoutTheFogCountsAtItsDepth)
+{
+    const auto d = measure({draw({{200.0, 1.0, 0.3}}, false)});
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 200.0, 0.01);
+    EXPECT_EQ(d.unfogged, 1U);
+}
+
+TEST(View3DStereoFit, backgroundAloneIsNotCounted)
+{
+    const auto d = measure({draw({})});
+    EXPECT_FALSE(d.seen);
+    EXPECT_EQ(d.pixels, 0U);
+}
+
+TEST(View3DStereoFit, withoutColoursEachPixelCountsAtItsNearestSurface)
+{
+    const auto d = measure({draw({{200.0, 1.0, 0.3}, {100.0, 0.5, 0.8}})}, false);
+    ASSERT_TRUE(d.seen);
+    EXPECT_NEAR(d.nearest, 200.0, 0.01);
+}
