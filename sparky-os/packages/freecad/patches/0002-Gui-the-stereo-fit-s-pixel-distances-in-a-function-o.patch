+#ifndef GUI_VIEW3DSTEREOFIT_H
+#define GUI_VIEW3DSTEREOFIT_H
+
+#include <cstddef>
+#include <functional>
+
+#include <FCGlobal.h>
+
+/*
+ * The distances the stereo 3D view keeps inside the person's limits, from the pictures of its
+ * measuring pass (the scene drawn from the camera between the eyes, see View3DStereo).
+ *
+ * A pixel's distance is the distance of what it shows. Where a translucent shape stands in front,
+ * the pixel shows several layers, and its distance is their contribution-weighted mean: each
+ * layer's distance weighted by its share of the pixel's colour, a background seen through a
+ * layer counting at the screen. Single faint layers inside a pixel may pass a limit; no pixel
+ * does.
+ *
+ * The measuring pass gives the window depth after the scene and after the annotations (drawn
+ * over a cleared depth), and, drawn twice with linear fog from the camera (distance 0) to
+ * fogEnd, the colour of the pass fogged toward white and of the pass fogged toward black. Every
+ * fragment's own colour is the same in both, so their difference at a pixel is the fog's share
+ * blended exactly as the layers are: the weighted mean distance over fogEnd. A background seen
+ * through a layer is cleared to the screen's distance over fogEnd in the first and to 0 in the
+ * second.
+ */
+
+namespace Gui
+{
+
+struct GuiExport StereoFitPixels
+{
+    // One value per pixel, as glReadPixels gives them. sceneDepth is required; the others may be
+    // null: without the two colours each pixel counts at the depth of its nearest surface.
+    const float* sceneDepth = nullptr;       // window depth after the scene (1: nothing drawn)
+    const float* annotationDepth = nullptr;  // after the annotations, over a cleared depth
+    const float* towardWhite = nullptr;      // red channel of the pass fogged toward white
+    const float* towardBlack = nullptr;      // red channel of the pass fogged toward black
+    std::size_t count = 0;
+    double fogEnd = 0.0;     // the distance where the fog reaches its colour
+    double screen = 0.0;     // the distance where both eyes meet: the background's
+    double nearPlane = 0.0;  // no fragment stands nearer than this
+};
+
+struct GuiExport StereoFitDistances
+{
+    bool seen = false;
+    double nearest = 0.0;
+    double farthest = 0.0;
+    std::size_t pixels = 0;       // pixels counted
+    std::size_t translucent = 0;  // of them, pixels whose distance is a mean over translucent layers
+    std::size_t unfogged = 0;     // of them, pixels drawn without the fog: counted at their depth
+};
+
+// distance: from a window depth to the distance from the camera, by the measuring pass's projection
+GuiExport StereoFitDistances stereoFitDistances(
+    const StereoFitPixels& in,
+    const std::function<double(float)>& distance
+);
+
+}  // namespace Gui
+
+#endif  // GUI_VIEW3DSTEREOFIT_H
