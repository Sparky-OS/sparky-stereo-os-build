     SoState* state = action->getState();
     if (self->measuring) {
         self->projection = SoProjectionMatrixElement::get(state);
-        self->nearPlane = SoViewVolumeElement::get(state).getNearDist();
+        const SbViewVolume& volume = SoViewVolumeElement::get(state);
+        self->nearPlane = volume.getNearDist();
         self->projectionSeen = true;
+        if (self->floatBuffer && self->measuringPass == 1 && !self->fogSet) {
+            // Fog takes the distance without its sign: an orthographic volume that reaches behind the
+            // camera's plane is moved along its axis for the fog (and the projection the other way, so
+            // the picture is the same)
+            const double nearDist = volume.getNearDist();
+            const double depth = volume.getDepth();
+            self->fogOffset = nearDist > 0.0 ? 0.0 : 0.05 * depth - nearDist;
+            self->fogEnd = 1.25 * (nearDist + depth + self->fogOffset);
+            self->screenDistance = self->perspective ? std::max(self->focal, nearDist) : self->focal;
+        }
+        if (self->floatBuffer && self->fogOffset > 0.0) {
+            // on every traversal of the pass, the annotations' paths too: their state passes this node
+            SbMatrix away;
+            away.setTranslate(SbVec3f(0.0F, 0.0F, -float(self->fogOffset)));
+            SbMatrix back;
+            back.setTranslate(SbVec3f(0.0F, 0.0F, float(self->fogOffset)));
+            SbMatrix viewing = SoViewingMatrixElement::get(state);
+            viewing.multRight(away);
+            back.multRight(self->projection);
+            SoViewingMatrixElement::set(state, self->eyeNode, viewing);
+            SoProjectionMatrixElement::set(state, self->eyeNode, back);
+        }
+        if (self->floatBuffer && !self->fogSet) {
+            // Once per pass, before the first shape (the annotations' paths pass this node again):
+            // linear fog from the camera to beyond the far plane, toward white in the first pass and
+            // toward black in the second, and the background, which a translucent shape may show,
+            // at the screen's fog distance in the first and at 0 in the second. The fog is set on the
+            // viewer's own environment node, which is traversed after this node (and again on the
+            // delayed paths of translucent shapes and annotations): its fog, none by default, would
+            // switch off a fog set here with GL alone. Its fields change without notification, and
+            // measure() gives them back after the passes.
+            if (SoEnvironment* environment = self->viewer->getEnvironment()) {
+                const SbBool notify = environment->enableNotify(FALSE);
+                environment->fogType = SoEnvironment::HAZE;
+                environment->fogColor =
+                    self->measuringPass == 1 ? SbColor(1.0F, 1.0F, 1.0F) : SbColor(0.0F, 0.0F, 0.0F);
+                environment->fogVisibility = float(self->fogEnd);
+                environment->enableNotify(notify);
+            }
+            const float background =
+                self->measuringPass == 1 ? float((self->screenDistance + self->fogOffset) / self->fogEnd) : 0.0F;
+            glClearColor(background, 0.0F, 0.0F, 0.0F);
+            glClear(GL_COLOR_BUFFER_BIT);
+            self->fogSet = true;
+        }
         return;
     }
     if (self->perspective || self->eyeSign == 0 || self->separation == 0.0) {
