+    // The environment's fog fields, which the passes change, as the person's view has them
+    SoEnvironment* environment = viewer->getEnvironment();
+    const int fogType = environment ? environment->fogType.getValue() : 0;
+    const SbColor fogColor = environment ? environment->fogColor.getValue() : SbColor(1.0F, 1.0F, 1.0F);
+    const float fogVisibility = environment ? environment->fogVisibility.getValue() : 0.0F;
+    for (measuringPass = 1; measuringPass <= (floatBuffer ? 2 : 1); ++measuringPass) {
+        drawnCount = 0;
+        fogSet = false;
+        viewer->renderScene();
+    }
+    measuringPass = 0;
+    action->setDelayedObjDepthWrite(depthWrite);
+    if (environment && floatBuffer) {
+        const SbBool notify = environment->enableNotify(FALSE);
+        environment->fogType = fogType;
+        environment->fogColor = fogColor;
+        environment->fogVisibility = fogVisibility;
+        environment->enableNotify(notify);
+    }
+    glDisable(GL_FOG);
     measuring = false;
     // Back to the left buffer of the viewport, which the left eye draws into
     widget->makeCurrent(QOpenGLWidget::LeftBuffer);
@@ -457,19 +541,27 @@ void View3DStereo::sceneDrawn()
     if (w <= 0 || h <= 0) {
         return;
     }
-    std::vector<GLfloat>& depth = drawnCount++ == 0 ? sceneDepth : annotationDepth;
-    depth.assign(static_cast<size_t>(w) * h, 1.0F);
-    while (glGetError() != GL_NO_ERROR) {
+    const bool afterScene = drawnCount++ == 0;
+    auto read = [&](std::vector<GLfloat>& into, GLenum format) {
+        into.assign(static_cast<size_t>(w) * h, format == GL_DEPTH_COMPONENT ? 1.0F : 0.0F);
+        while (glGetError() != GL_NO_ERROR) {
+        }
+        GLint alignment = 4;
+        glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glReadPixels(viewport[0], viewport[1], w, h, format, GL_FLOAT, into.data());
+        const bool failed = glGetError() != GL_NO_ERROR;
+        glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+        if (failed) {
+            depthUnreadable = true;
+            into.clear();
+        }
+    };
+    if (measuringPass <= 1) {
+        read(afterScene ? sceneDepth : annotationDepth, GL_DEPTH_COMPONENT);
     }
-    GLint alignment = 4;
-    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
-    glPixelStorei(GL_PACK_ALIGNMENT, 1);
-    glReadPixels(viewport[0], viewport[1], w, h, GL_DEPTH_COMPONENT, GL_FLOAT, depth.data());
-    const bool failed = glGetError() != GL_NO_ERROR;
-    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
-    if (failed) {
-        depthUnreadable = true;
-        depth.clear();
+    if (!afterScene && floatBuffer) {
