  ***************************************************************************/
 
 #include <algorithm>
+#include <cmath>
 
 #include "View3DStereoFit.h"
 
@@ -46,13 +47,54 @@ StereoFitDistances Gui::stereoFitDistances(
         out.farthest = std::max(out.farthest, d);
         ++out.pixels;
     };
-    // Each pixel counts at the depth of its nearest surface, the scene's and the annotations'
+    const bool colours = in.towardWhite && in.towardBlack && in.fogEnd > 0.0;
+    if (!colours) {
+        // Each pixel counts at the depth of its nearest surface, the scene's and the annotations'
+        for (std::size_t i = 0; i < in.count; ++i) {
+            if (in.sceneDepth[i] < 1.0F) {
+                count(distance(in.sceneDepth[i]));
+            }
+            if (in.annotationDepth && in.annotationDepth[i] < 1.0F) {
+                count(distance(in.annotationDepth[i]));
+            }
+        }
+        return out;
+    }
+    // The pass fogged toward white minus the pass fogged toward black: at every fragment the fog's
+    // share, its distance over fogEnd, blended as the layers are; the fragments' own colours cancel
+    const float backgroundWhite = float((in.screen + in.fogOffset) / in.fogEnd);
     for (std::size_t i = 0; i < in.count; ++i) {
-        if (in.sceneDepth[i] < 1.0F) {
-            count(distance(in.sceneDepth[i]));
+        // the weighted mean fog distance; no fragment's is under the near plane's, which is above 0
+        const double fog = (double(in.towardWhite[i]) - double(in.towardBlack[i])) * in.fogEnd;
+        const bool fogged = fog > 0.5 * (in.nearPlane + in.fogOffset);
+        const double mean = fog - in.fogOffset;
+        // the surface the pixel shows: an annotation drawn over a cleared depth hides the scene
+        const float depth = in.annotationDepth && in.annotationDepth[i] < 1.0F ? in.annotationDepth[i]
+                                                                                 : in.sceneDepth[i];
+        if (depth < 1.0F) {
+            const double surface = distance(depth);
+            const double tolerance = std::max(1e-4 * in.fogEnd, 1e-3 * std::abs(surface));
+            if (!fogged || mean > surface + tolerance) {
+                // drawn without the fog (a shader of its own): its colour says nothing of its distance
+                ++out.unfogged;
+                count(surface);
+                continue;
+            }
+            if (mean < surface - tolerance) {
+                ++out.translucent;  // translucent layers in front of the surface
+            }
+            count(mean);
         }
-        if (in.annotationDepth && in.annotationDepth[i] < 1.0F) {
-            count(distance(in.annotationDepth[i]));
+        else {
+            // no opaque surface: the background alone, or translucent layers over it
+            if (in.towardWhite[i] == backgroundWhite && in.towardBlack[i] == 0.0F) {
+                continue;
+            }
+            if (!fogged) {
+                continue;
+            }
+            ++out.translucent;
+            count(mean);
         }
     }
     return out;
