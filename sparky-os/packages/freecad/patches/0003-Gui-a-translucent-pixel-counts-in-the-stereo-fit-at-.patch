-            want,
-            QOpenGLFramebufferObject::CombinedDepthStencil
-        );
+        QOpenGLFramebufferObjectFormat format;
+        format.setAttachment(QOpenGLFramebufferObject::CombinedDepthStencil);
+        format.setInternalTextureFormat(GL_RGBA32F);
+        measuringBuffer = std::make_unique<QOpenGLFramebufferObject>(want, format);
+        // the driver may give another format than the one asked for (QOpenGLFramebufferObject::format())
+        floatBuffer = measuringBuffer->isValid() && measuringBuffer->format().internalTextureFormat() == GL_RGBA32F;
+        if (!floatBuffer) {
+            measuringBuffer = std::make_unique<QOpenGLFramebufferObject>(
+                want,
+                QOpenGLFramebufferObject::CombinedDepthStencil
+            );
+        }
     }
     if (!measuringBuffer->isValid() || !measuringBuffer->bind()) {
         depthUnreadable = true;
@@ -421,9 +482,10 @@ void View3DStereo::measure()
         return;
     }
