+View3DStereo::View3DStereo(View3DInventorViewer* viewer)
+    : viewer(viewer)
+{
+    limitsTimer.setInterval(limitsPollMs);
+    QObject::connect(&limitsTimer, &QTimer::timeout, viewer, [this]() { pollLimits(); });
+}
+
+View3DStereo::~View3DStereo()
+{
+    limitsTimer.stop();
+    if (eyeNode) {
+        if (auto superscene = dynamic_cast<SoGroup*>(viewer->getSoRenderManager()->getSceneGraph())) {
+            const int index = superscene->findChild(eyeNode);
+            if (index >= 0) {
+                superscene->removeChild(index);
+            }
+        }
+        eyeNode->unref();
+        eyeNode = nullptr;
+    }
+}
+
+bool View3DStereo::enabledByPreference()
+{
+    return viewParameters()->GetBool("Enable3D", true);
+}
+
+void View3DStereo::setEnabledByPreference(bool on)
+{
+    viewParameters()->SetBool("Enable3D", on);
+}
+
+QSurfaceFormat View3DStereo::viewFormat(QSurfaceFormat format)
+{
+    return viewFormat(format, enabledByPreference());
+}
+
+QSurfaceFormat View3DStereo::viewFormat(QSurfaceFormat format, bool on)
+{
+    // QOpenGLWidget draws for each eye only if its own format asks for stereo buffers, and that
+    // must be known before its window is created. Only the 3D view's viewport asks: the rest of the
+    // window stays one picture, the same in both eyes.
+    format.setStereo(on);
+    return format;
+}
+
+bool View3DStereo::desktopOffersStereo()
+{
+    static int offered = -1;
+    if (offered < 0) {
+        // Qt picks the framebuffer configuration when it creates the context, and QOpenGLWidget
+        // draws each eye only when its own context's format is stereo, so a context with the
+        // viewport's format gives the same answer the viewport gets.
+        QSurfaceFormat format;
+        format.setRenderableType(QSurfaceFormat::OpenGL);
+        format.setProfile(QSurfaceFormat::CompatibilityProfile);
+        format.setOption(QSurfaceFormat::DeprecatedFunctions, true);
+        format.setStereo(true);
+        QOpenGLContext probe;
+        probe.setFormat(format);
+        offered = probe.create() && probe.format().stereo() ? 1 : 0;
+    }
+    return offered == 1;
+}
+
+void View3DStereo::openDisplaySettings()
+{
+    const QStringList module {QStringLiteral("kcm_kscreen")};
+    if (!QProcess::startDetached(QStringLiteral("systemsettings"), module)
+        && !QProcess::startDetached(QStringLiteral("kcmshell6"), module)) {
+        const QString sentence = tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "Display Settings could not be opened."));
+        Base::Console().warning("%s\n", sentence.toUtf8().constData());
+        if (tracing()) {
+            std::fprintf(stderr, "freecad stereo3d told: %s\n", sentence.toUtf8().constData());
+        }
+    }
+}
+
+void View3DStereo::tellOnce(const QString& sentence)
+{
+    static std::set<QString> told;
+    if (!told.insert(sentence).second) {
+        return;
+    }
+    Base::Console().warning("%s\n", sentence.toUtf8().constData());
+    if (tracing()) {
+        std::fprintf(stderr, "freecad stereo3d told: %s\n", sentence.toUtf8().constData());
+    }
+}
