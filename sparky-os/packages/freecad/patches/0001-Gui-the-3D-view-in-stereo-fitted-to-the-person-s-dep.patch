+// The fit of each frame and what is told, for a check against a prediction: FREECAD_STEREO3D_TRACE=1
+bool tracing()
+{
+    static const bool on = std::getenv("FREECAD_STEREO3D_TRACE") != nullptr;
+    return on;
+}
