+void View3DInventorViewer::setStereoEnabled(bool on, bool byPerson)
+{
+    if (on == stereoAsked) {
+        return;
+    }
+    // The viewport chooses its buffers when its context is made: a new viewport, the scene unchanged. The request
+    // is recorded first: the new viewport can be painted while it is being set.
+    stereoAsked = on;
+    stereo->viewportMade(on, byPerson);
+    replaceViewport(View3DStereo::viewFormat(viewportFormat(), on));
+    redraw();
+}
+
+bool View3DInventorViewer::isStereoEnabled() const
+{
+    return stereoAsked;
+}
+
+bool View3DInventorViewer::drawsStereoEyes()
+{
+    return stereo && stereo->drawsEyes();
+}
+
+void View3DInventorViewer::beginStereoEye(int eye)
+{
+    stereo->beginEye(eye);
+}
+
+void View3DInventorViewer::endStereoEyes()
+{
+    stereo->endEyes();
+}
+
+bool View3DInventorViewer::isMeasurable() const
+{
+    return renderType == Native;
+}
