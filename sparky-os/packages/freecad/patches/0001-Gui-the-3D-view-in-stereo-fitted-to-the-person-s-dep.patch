+    if (this->drawsStereoEyes()) {
+      // One frame per eye: the left buffer of the viewport, then the right one, each with the
+      // graphics view's own painting, which follows the buffer made current
+      for (int eye = 0; eye < 2; ++eye) {
+        w->makeCurrent(eye == 0 ? QOpenGLWidget::LeftBuffer : QOpenGLWidget::RightBuffer);
+        this->beginStereoEye(eye);
+        this->actualRedraw();
+        glPushAttrib(GL_MULTISAMPLE_BIT_EXT);
+        inherited::paintEvent(event);
+        glPopAttrib();
+      }
+      this->endStereoEyes();
+      w->makeCurrent(QOpenGLWidget::LeftBuffer);
+    }
+    else {
+      this->actualRedraw();
+
+      //start the standard graphics view processing for all widgets and graphic items. As
+      //QGraphicsView initaliizes a QPainter which changes the Opengl context in an unpredictable
+      //manner we need to store the context and recreate it after Qt is done.
+      glPushAttrib(GL_MULTISAMPLE_BIT_EXT);
+      inherited::paintEvent(event);
+      glPopAttrib();
