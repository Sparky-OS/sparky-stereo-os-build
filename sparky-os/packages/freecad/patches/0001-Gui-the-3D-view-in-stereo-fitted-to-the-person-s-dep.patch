+#ifndef GUI_VIEW3DSTEREO_H
+#define GUI_VIEW3DSTEREO_H
+
+#include <memory>
+#include <set>
+#include <string>
+
+#include <QImage>
+#include <QPointer>
+#include <QString>
+#include <QSurfaceFormat>
+#include <QTimer>
+
+#include <Inventor/SbMatrix.h>
+
+#include <FCGlobal.h>
+
+#include "View3DStereoLimits.h"
+
+class QOpenGLFramebufferObject;
+class QOpenGLWidget;
+class SoAction;
+class SoCallback;
+
+namespace Gui
+{
+class View3DInventorViewer;
+
+/*
+ * The stereo 3D view. With "Enable 3D" on, a 3D view's OpenGL viewport asks for stereo buffers
+ * in its own format; the edition's Qt shows such a viewport as a stereo window of its own, which
+ * the desktop receives as full side by side, while the rest of FreeCAD's window stays one picture,
+ * the same in both eyes. Quarter then draws each frame once per buffer, and this class sets the
+ * camera of each eye: two parallel cameras meeting at the camera's focal distance, an off-axis
+ * frustum in perspective (Coin's own stereo camera) and a shear about the focal plane in
+ * orthographic (a view volume of our own, set right after the camera).
+ *
+ * The separation is not a setting. The person sets the depth limits once, in the desktop's 3D
+ * settings; the view reads them through libstereo-declare and, before the left eye, draws the
+ * scene once from the camera between the eyes into a framebuffer of its own and reads its depth.
+ * The separation is then the largest for which every pixel of the view stays inside the limits.
+ * Without limits both eyes are the same picture, and the report view says why, once.
+ *
+ * Picking, preselection and every other action use the camera between the eyes: what the person
+ * fuses under the pointer. The overlays drawn in window coordinates (the navigation cube, the
+ * corner coordinate system, the rubber band, the background) are drawn once per eye at the same
+ * place, at the screen's depth.
+ */
+class GuiExport View3DStereo
+{
+public:
+    explicit View3DStereo(View3DInventorViewer* viewer);
+    ~View3DStereo();
+
+    View3DStereo(const View3DStereo&) = delete;
+    View3DStereo& operator=(const View3DStereo&) = delete;
+
+    // The person's choice, "Enable 3D" (User parameter:BaseApp/Preferences/View, Enable3D, on by
+    // default): the 3D views made after it ask for stereo buffers, and View3DSettings applies a
+    // change to the open ones
+    static bool enabledByPreference();
+    static void setEnabledByPreference(bool on);
+    // The format a 3D view's viewport asks for: stereo buffers when Enable 3D is on
+    static QSurfaceFormat viewFormat(QSurfaceFormat format);
+    static QSurfaceFormat viewFormat(QSurfaceFormat format, bool on);
+    // Whether this desktop gives OpenGL contexts stereo buffers, found out once per session
+    static bool desktopOffersStereo();
+    // Opens the desktop's display settings, where the 3D modes and the depth limits are set
+    static void openDisplaySettings();
+    // Says a sentence once in the report view
+    static void tellOnce(const QString& sentence);
+
+    // Whether this view's viewport has two buffers: Quarter then draws each frame twice
+    bool drawsEyes();
+    // Before the left (0) and the right (1) buffer of a frame; before the left one the scene is
+    // drawn and measured from the camera between the eyes
+    void beginEye(int index);
+    // After both eyes: the camera between the eyes again
+    void endEyes();
+    // From renderScene(): whether this pass only measures the scene's depth, and the moments it does
+    bool isMeasuring() const
+    {
+        return measuring;
+    }
+    void sceneDrawn();
+    // A viewport is being made: whether this view asks for stereo buffers and whether a person did
+    void viewportMade(bool askedForStereo, bool byPerson);
+    // A mouse selection freezes the view as a picture (View3DInventorViewer::Image): each eye keeps its own, read
+    // from its own buffer, and each eye pass draws its own. left is the viewer's own picture, replaced by the left eye's
+    void freezeEyes(QImage& left);
+    const QImage& frozenPicture(const QImage& left) const
+    {
+        return eyeSign > 0 && !frozenRight.isNull() ? frozenRight : left;
+    }
+
+private:
+    static void eyeNodeCallback(void* data, SoAction* action);
+    void insertEyeNode();
+    void checkViewport();
+    void measure();
+    void fit();
+    void pollLimits();
+    void trace(const std::string& line);
+    QImage grabEye(int index);
+
+    View3DInventorViewer* viewer;
+    SoCallback* eyeNode = nullptr;
+    std::unique_ptr<QOpenGLFramebufferObject> measuringBuffer;
+    QPointer<QOpenGLWidget> checkedViewport;
+    QTimer limitsTimer;
+    StereoDepthLimits::Result limits;
+    int pollsWithoutLimits = 0;
+
+    bool asked = false;      // the viewport asked for stereo buffers
+    bool personAsked = false;
+    bool granted = false;    // and got them
+
+    // The measuring pass
+    bool measuring = false;
+    bool depthRead = false;
+    bool depthUnreadable = false;
+    float depthNear = 1.0F;  // window depth of the nearest and the farthest pixel
+    float depthFar = 0.0F;
+    bool projectionSeen = false;
+    SbMatrix projection;     // the projection of the camera between the eyes, as Coin set it
+    float nearPlane = 0.0F;
+    int bufferWidth = 0;
+    size_t depthPixels = 0;  // pixels of the scene the measuring pass saw, for the trace
+
+    // The eyes
+    bool perspective = true;
+    double focal = 0.0;      // the distance where both eyes meet
+    double separation = 0.0; // perspective: the eye distance; orthographic: the shear's slope
+    int eyeSign = 0;         // -1 left, 1 right, 0 the camera between the eyes
+    std::string lastTrace;
+    QImage frozenRight;      // the right eye's picture while a mouse selection freezes the view
+};
+
+}  // namespace Gui
+
+#endif  // GUI_VIEW3DSTEREO_H
