@@ -204,6 +204,16 @@ protected:
   virtual void actualRedraw();
   virtual bool updateDevicePixelRatio();
 
+  // Stereo: when the viewport has two buffers (its format asked for stereo buffers and got them),
+  // paintEvent() draws each frame once into the left buffer and once into the right one, with
+  // everything drawn over the scene, calling beginStereoEye() before each and endStereoEyes() after
+  virtual bool drawsStereoEyes() { return false; }
+  virtual void beginStereoEye(int eye) { Q_UNUSED(eye); }
+  virtual void endStereoEyes() {}
+  // A new viewport with another surface format (stereo buffers or not), the scene unchanged
+  void replaceViewport(const QSurfaceFormat & format);
+  QSurfaceFormat viewportFormat() const;
+
 private:
   void constructor(const QSurfaceFormat& format, const QOpenGLWidget* sharewidget);
   friend class QuarterWidgetP;
