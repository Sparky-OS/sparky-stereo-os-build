+QImage View3DStereo::grabEye(int index)
+{
+    // The eye's own buffer, copied into a single-sampled framebuffer (the viewport may be multisampled) and read as
+    // FreeCAD's own grabFramebuffer() reads one: bottom row first, BGRA
+    auto widget = qobject_cast<QOpenGLWidget*>(viewer->getGLWidget());
+    const SbVec2s size = viewer->getSoRenderManager()->getViewportRegion().getViewportSizePixels();
+    const int w = size[0];
+    const int h = size[1];
+    if (!widget || w <= 0 || h <= 0) {
+        return {};
+    }
+    const auto buffer = index == 0 ? QOpenGLWidget::LeftBuffer : QOpenGLWidget::RightBuffer;
+    widget->makeCurrent(buffer);
+    QOpenGLExtraFunctions* f = QOpenGLContext::currentContext()->extraFunctions();
+    QOpenGLFramebufferObject copy(QSize(w, h));
+    f->glBindFramebuffer(GL_READ_FRAMEBUFFER, widget->defaultFramebufferObject(buffer));
+    f->glBindFramebuffer(GL_DRAW_FRAMEBUFFER, copy.handle());
+    f->glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    f->glBindFramebuffer(GL_FRAMEBUFFER, copy.handle());
+    QImage image(QSize(w, h), QImage::Format_RGB32);
+    GLint alignment = 4;
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, w, h, GL_BGRA, GL_UNSIGNED_BYTE, image.bits());
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    widget->makeCurrent(QOpenGLWidget::LeftBuffer);
+    return image;
+}
+
+void View3DStereo::freezeEyes(QImage& left)
+{
+    frozenRight = QImage();
+    if (!drawsEyes()) {
+        return;
+    }
+    QImage l = grabEye(0);
+    QImage r = grabEye(1);
+    if (!l.isNull() && !r.isNull()) {
+        left = l;
+        frozenRight = r;
+    }
+}
+
+void View3DStereo::checkViewport()
+{
+    auto widget = qobject_cast<QOpenGLWidget*>(viewer->getGLWidget());
+    if (!widget || widget == checkedViewport || !widget->isValid()) {
+        return;
+    }
+    // A viewport that asked for stereo buffers knows from its own context whether it got them
+    checkedViewport = widget;
+    granted = asked && widget->format().stereo();
+    if (asked && !granted && desktopOffersStereo()) {
+        tellOnce(tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "3D: this view got no stereo buffers, so it is shown in 2D")));
+    }
+    if (tracing()) {
+        std::fprintf(
+            stderr,
+            "freecad stereo3d viewport asked=%d granted=%d platform=%s\n",
+            int(asked),
+            int(granted),
+            qPrintable(QGuiApplication::platformName())
+        );
+    }
+    if (granted) {
+        insertEyeNode();
+        pollsWithoutLimits = 0;
+        pollLimits();
+        limitsTimer.start();
+    }
+    else {
+        limitsTimer.stop();
+    }
+}
+
+bool View3DStereo::drawsEyes()
+{
+    checkViewport();
+    if (granted) {
+        insertEyeNode();
+    }
+    return granted;
+}
+
+void View3DStereo::insertEyeNode()
+{
+    // Right after the camera in the render manager's scene: the camera has set the view volume
+    // between the eyes there, and every node after it, the view providers' annotations included,
+    // takes the eye's view volume set by this node. A new scene graph (a split view's panes are
+    // given one) is a new scene of the render manager: the node follows it.
+    auto superscene = dynamic_cast<SoGroup*>(viewer->getSoRenderManager()->getSceneGraph());
+    SoCamera* camera = viewer->getSoRenderManager()->getCamera();
+    if (!superscene || !camera) {
+        return;
+    }
+    const int index = superscene->findChild(camera);
+    if (index < 0) {
+        return;
+    }
+    if (!eyeNode) {
+        eyeNode = new SoCallback;
+        eyeNode->ref();
+        eyeNode->setName("StereoEye");
+        eyeNode->setCallback(eyeNodeCallback, this);
+    }
+    const int at = superscene->findChild(eyeNode);
+    if (at == index + 1) {
+        return;
+    }
+    if (at >= 0) {
+        superscene->removeChild(at);
+    }
+    superscene->insertChild(eyeNode, superscene->findChild(camera) + 1);
+}
+
+void View3DStereo::eyeNodeCallback(void* data, SoAction* action)
+{
+    if (!action->isOfType(SoGLRenderAction::getClassTypeId())) {
+        return;
+    }
+    auto self = static_cast<View3DStereo*>(data);
+    SoState* state = action->getState();
+    if (self->measuring) {
+        self->projection = SoProjectionMatrixElement::get(state);
+        self->nearPlane = SoViewVolumeElement::get(state).getNearDist();
+        self->projectionSeen = true;
+        return;
+    }
+    if (self->perspective || self->eyeSign == 0 || self->separation == 0.0) {
+        return;
+    }
+    // Orthographic: the scene as each eye sees it is the scene sheared about the focal plane, a
+    // point at the distance d from the camera moving s (d - c) along the camera's right vector.
+    // Moving the view volume by the inverse shear shows exactly that: its projection of a point is
+    // the projection, from the camera between the eyes, of the sheared point. The height of a
+    // point on the screen and the lighting are the same in both eyes.
+    SbViewVolume volume = SoViewVolumeElement::get(state);
+    const SbVec3f direction = volume.getProjectionDirection();
+    const SbVec3f point = volume.getProjectionPoint();
+    SbVec3f right = direction.cross(volume.getViewUp());
+    right.normalize();
+    const float s = float(self->eyeSign * self->separation / 2.0);
+    const float c = float(self->focal);
+    SbMatrix inverseShear = SbMatrix::identity();
+    for (int i = 0; i < 3; ++i) {
+        for (int j = 0; j < 3; ++j) {
+            inverseShear[i][j] -= s * direction[i] * right[j];
+        }
+    }
+    const float offset = s * (direction.dot(point) + c);
+    for (int j = 0; j < 3; ++j) {
+        inverseShear[3][j] = offset * right[j];
+    }
+    volume.transform(inverseShear);
+    SbMatrix affine;
+    SbMatrix proj;
+    volume.getMatrices(affine, proj);
+    SoCullElement::setViewVolume(state, volume);
+    SoViewVolumeElement::set(state, self->eyeNode, volume);
+    SoProjectionMatrixElement::set(state, self->eyeNode, proj);
+    SoViewingMatrixElement::set(state, self->eyeNode, affine);
+}
+
+void View3DStereo::beginEye(int index)
+{
+    SoCamera* camera = viewer->getSoRenderManager()->getCamera();
+    if (index == 0) {
+        separation = 0.0;
+        if (camera && eyeNode && viewer->isMeasurable()) {
+            measure();
+        }
+        eyeSign = -1;
+    }
+    else {
+        eyeSign = 1;
+    }
+    if (!camera) {
+        return;
+    }
+    if (perspective && separation > 0.0 && camera->focalDistance.getValue() > 0.0F) {
+        // Coin's own stereo camera: the eye moved half the separation along the camera's right
+        // vector, the frustum skewed so that both eyes meet at the focal distance
+        camera->setStereoMode(eyeSign < 0 ? SoCamera::LEFT_VIEW : SoCamera::RIGHT_VIEW);
+        camera->setStereoAdjustment(float(separation));
+        camera->setBalanceAdjustment(float(focal / camera->focalDistance.getValue()));
+    }
+    else {
+        camera->setStereoMode(SoCamera::MONOSCOPIC);
+    }
+}
+
+void View3DStereo::endEyes()
+{
+    // Picking, preselection and every other action use the camera between the eyes
+    eyeSign = 0;
+    if (SoCamera* camera = viewer->getSoRenderManager()->getCamera()) {
+        camera->setStereoMode(SoCamera::MONOSCOPIC);
+    }
+}
+
+void View3DStereo::measure()
+{
+    auto widget = qobject_cast<QOpenGLWidget*>(viewer->getGLWidget());
+    const SbVec2s size = viewer->getSoRenderManager()->getViewportRegion().getViewportSizePixels();
+    if (!widget || size[0] <= 0 || size[1] <= 0) {
+        return;
+    }
+    // The measuring pass: the scene and its annotations from the camera between the eyes, into a
+    // framebuffer of its own, single-sampled so that its depth can be read whatever the viewport's
+    // anti-aliasing
+    const QSize want(size[0], size[1]);
+    if (!measuringBuffer || measuringBuffer->size() != want) {
+        measuringBuffer = std::make_unique<QOpenGLFramebufferObject>(
+            want,
+            QOpenGLFramebufferObject::CombinedDepthStencil
+        );
+    }
+    if (!measuringBuffer->isValid() || !measuringBuffer->bind()) {
+        depthUnreadable = true;
+        tellOnce(tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "3D depth: the depth of this view could not be read, so both eyes show the same picture")));
+        widget->makeCurrent(QOpenGLWidget::LeftBuffer);
+        return;
+    }
+    measuring = true;
+    depthRead = false;
+    depthPixels = 0;
+    depthUnreadable = false;
+    depthNear = 1.0F;
+    depthFar = 0.0F;
+    projectionSeen = false;
+    if (SoCamera* camera = viewer->getSoRenderManager()->getCamera()) {
+        camera->setStereoMode(SoCamera::MONOSCOPIC);
+        perspective = !camera->isOfType(SoOrthographicCamera::getClassTypeId());
+        focal = camera->focalDistance.getValue();
+    }
+    viewer->renderScene();
+    measuring = false;
+    // Back to the left buffer of the viewport, which the left eye draws into
+    widget->makeCurrent(QOpenGLWidget::LeftBuffer);
+    bufferWidth = size[0];
+    if (depthUnreadable) {
+        tellOnce(tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "3D depth: the depth of this view could not be read, so both eyes show the same picture")));
+        return;
+    }
+    fit();
+}
+
+void View3DStereo::sceneDrawn()
+{
+    if (!measuring) {
+        return;
+    }
+    // The scene is drawn (or, the second time, its annotations, over a cleared depth) and nothing
+    // of the overlays yet: the depth buffer holds the nearest pixel everywhere
+    GLint viewport[4];
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    const int w = viewport[2];
+    const int h = viewport[3];
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    std::vector<GLfloat> depth(static_cast<size_t>(w) * h);
+    while (glGetError() != GL_NO_ERROR) {
+    }
+    GLint alignment = 4;
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(viewport[0], viewport[1], w, h, GL_DEPTH_COMPONENT, GL_FLOAT, depth.data());
+    const bool failed = glGetError() != GL_NO_ERROR;
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    if (failed) {
+        depthUnreadable = true;
+        return;
+    }
+    size_t seen = 0;
+    for (const GLfloat d : depth) {
+        if (d >= 1.0F) {
+            continue;  // the cleared depth: no scene there
+        }
+        depthNear = std::min(depthNear, d);
+        depthFar = std::max(depthFar, d);
+        ++seen;
+    }
+    depthRead = true;
+    depthPixels += seen;
+}
+
+void View3DStereo::fit()
+{
+    separation = 0.0;
+    std::ostringstream line;
+    line.precision(6);
+    if (limits.status != StereoDepthLimits::State::Ok || !projectionSeen || bufferWidth <= 0) {
+        line << "freecad stereo3d fit limits=" << static_cast<int>(limits.status) << " separation=0";
+        trace(line.str());
+        return;
+    }
+    // k: pixels per unit of the image plane, half the buffer's width times the projection's x
+    // scale; c: the distance of the focal point, where both eyes meet. With the separation t as a
+    // fraction of c, a point at the distance d is shifted between the eyes by k t (1 - c/d) in
+    // perspective; with the shear's slope t, by k t (d - c) in orthographic. The separation is the
+    // largest that keeps the nearest pixel inside the popped limit and the farthest inside the sunk
+    // limit.
+    const double k = bufferWidth / 2.0 * projection[0][0];
+    const double a = projection[2][2];
+    const double b = projection[3][2];
+    const double c = perspective ? std::max(focal, double(nearPlane)) : focal;
+    auto distance = [&](double d) {
+        const double z = 2.0 * d - 1.0;
+        return perspective ? b / (z + a) : (b - z) / a;
+    };
+    if (k <= 0.0 || (perspective && c <= 0.0)) {
+        trace("freecad stereo3d fit k<=0 separation=0");
+        return;
+    }
+    constexpr double none = std::numeric_limits<double>::infinity();
+    double t = none;
+    const bool seen = depthRead && depthNear <= depthFar;
+    double nearest = 0.0;
+    double farthest = 0.0;
+    if (seen) {
+        nearest = distance(depthNear);
+        farthest = distance(depthFar);
+        const double front = perspective ? c / nearest - 1.0 : c - nearest;
+        const double behind = perspective ? 1.0 - c / farthest : farthest - c;
+        if (front > 0.0) {
+            t = std::min(t, limits.popped / (k * front));
+        }
+        if (behind > 0.0) {
+            t = std::min(t, limits.sunk / (k * behind));
+        }
+    }
+    if (t == none) {
+        // Nothing off the focal plane: in perspective, infinity stands at the sunk limit; an
+        // orthographic view has no depth to show
+        t = perspective ? limits.sunk / k : 0.0;
+    }
+    focal = c;
+    separation = perspective ? t * c : t;
+    if (tracing()) {
+        auto disparity = [&](double d) {
+            return perspective ? k * t * (1.0 - c / d) : k * t * (d - c);
+        };
+        line << "freecad stereo3d fit pixels=" << depthPixels
+             << " projection=" << (perspective ? "perspective" : "orthographic")
+             << " limits sunk=" << limits.sunk << " popped=" << limits.popped << " width=" << bufferWidth
+             << " k=" << k << " c=" << c << " nearest=" << (seen ? nearest : 0.0)
+             << " farthest=" << (seen ? farthest : 0.0) << " separation=" << separation
+             << " disparity nearest=" << (seen ? disparity(nearest) : 0.0)
+             << " farthest=" << (seen ? disparity(farthest) : 0.0);
+        trace(line.str());
+    }
+}
+
+void View3DStereo::trace(const std::string& line)
+{
+    if (!tracing() || line == lastTrace) {
+        return;
+    }
+    lastTrace = line;
+    std::fprintf(stderr, "%s\n", line.c_str());
+}
+
+void View3DStereo::pollLimits()
+{
+    if (!granted) {
+        return;
+    }
+    QWidget* widget = viewer->getGLWidget();
+    const double width = std::round(widget->width() * widget->devicePixelRatioF());
+    if (width <= 0) {
+        return;
+    }
+    StereoDepthLimits::Result r;
+    QPlatformNativeInterface* native = QGuiApplication::platformNativeInterface();
+    const QString platform = QGuiApplication::platformName();
+    if (platform.startsWith(QLatin1String("wayland"))) {
+        QWindow* top = viewer->window() ? viewer->window()->windowHandle() : nullptr;
+        void* display = native ? native->nativeResourceForIntegration("wl_display") : nullptr;
+        void* surface = native && top ? native->nativeResourceForWindow("surface", top) : nullptr;
+        // A stereo desktop gives the limits for the top-level window's surface, not for the view's
+        // own subsurface
+        r = StereoDepthLimits::wayland(display, surface, width, width);
+    }
+    else if (platform == QLatin1String("xcb")) {
+        void* display = native ? native->nativeResourceForIntegration("display") : nullptr;
+        // The viewport's own window is the declared stereo child window that carries the limits
+        r = StereoDepthLimits::x11(display, widget->winId(), width, width);
+    }
+    else {
+        r.status = StereoDepthLimits::State::Unreadable;
+    }
+    const bool changed = r.status != limits.status || r.sunk != limits.sunk || r.popped != limits.popped;
+    limits = r;
+    if (changed && tracing()) {
+        std::fprintf(
+            stderr,
+            "freecad stereo3d limits platform=%s status=%d sunk=%g popped=%g width=%g\n",
+            qPrintable(platform),
+            static_cast<int>(r.status),
+            r.sunk,
+            r.popped,
+            width
+        );
+    }
+    if (r.status == StereoDepthLimits::State::Ok) {
+        pollsWithoutLimits = 0;
+    }
+    else if (++pollsWithoutLimits == pollsBeforeTelling) {
+        switch (r.status) {
+            case StereoDepthLimits::State::NotOffered:
+                tellOnce(tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "3D depth: this desktop offers no depth limits, so both eyes show the same picture")));
+                break;
+            case StereoDepthLimits::State::NotDelivered:
+                tellOnce(tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now")));
+                break;
+            default:
+                tellOnce(tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture")));
+                break;
+        }
+    }
+    if (changed) {
+        viewer->redraw();
+    }
+}
