+void View3DStereo::viewportMade(bool askedForStereo, bool byPerson)
+{
+    asked = askedForStereo;
+    personAsked = byPerson;
+    granted = false;
+    checkedViewport = nullptr;
+    frozenRight = QImage();
+    measuringBuffer.reset();
+    limitsTimer.stop();
+    if (asked && personAsked && !desktopOffersStereo()) {
+        tellOnce(tr(QT_TRANSLATE_NOOP("Gui::View3DStereo", "This desktop offers no stereo buffers, so the 3D view stays 2D.")));
+    }
+}
