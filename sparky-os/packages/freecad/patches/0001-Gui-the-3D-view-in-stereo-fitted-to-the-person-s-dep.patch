+void
+QuarterWidget::replaceViewport(const QSurfaceFormat & format)
+{
+  CustomGLWidget* oldvp = static_cast<CustomGLWidget*>(viewport());
+  QWidget* focusProxy = oldvp->focusProxy();
+  CustomGLWidget* newvp = new CustomGLWidget(format, this);
+  PRIVATE(this)->replaceGLWidget(newvp);
+  setViewport(newvp);
+  newvp->setFocusProxy(focusProxy);
+
+  setAutoFillBackground(false);
+  viewport()->setAutoFillBackground(false);
+  // the render manager reinitializes for the new context at the next frame
+  initialized = false;
+}
+
+QSurfaceFormat
+QuarterWidget::viewportFormat() const
+{
+  return static_cast<CustomGLWidget*>(viewport())->myFormat;
+}
