+bool PartitionManagerWidget::onFormatPartition()
+{
+    Partition* partition = selectedPartition();
+    Device* device = selectedDevice();
+    if (!partition || !device || !device->partitionTable() || device->partitionTable()->isReadOnly() ||
+        partition->roles().has(PartitionRole::Extended) || partition->roles().has(PartitionRole::Luks))
+        return false;
+
+    FormatDialog dialog(this, *partition);
+    if (dialog.exec() != QDialog::Accepted)
+        return false;
+
+    if (partition->isMounted()) {
+        Report report(nullptr);
+        if (!partition->unmount(report)) {
+            KMessageBox::detailedError(this,
+                xi18nc("@info", "Could not unmount <filename>%1</filename>.", partition->deviceNode()), report.toText());
+            return false;
+        }
+    }
+
+    operationStack().push(new CreateFileSystemOperation(*device, *partition, dialog.fileSystemType()));
+    operationStack().push(new SetFileSystemLabelOperation(*partition, dialog.label()));
+    return true;
+}
