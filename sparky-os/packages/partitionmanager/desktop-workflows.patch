+/*
+    SPDX-FileCopyrightText: 2026 Daniel Ramos
+    SPDX-License-Identifier: GPL-3.0-or-later
+*/
+
+#include "gui/formatdialog.h"
+
+#include <core/partition.h>
+#include <fs/filesystemfactory.h>
+
+#include <KLocalizedString>
+#include <KMessageBox>
+
+#include <QComboBox>
+#include <QDialogButtonBox>
+#include <QFormLayout>
+#include <QLabel>
+#include <QLineEdit>
+#include <QPushButton>
+#include <QValidator>
+#include <QVBoxLayout>
+
+#include <memory>
+
+FormatDialog::FormatDialog(QWidget* parent, const Partition& partition) :
+    QDialog(parent),
+    m_DeviceNode(partition.deviceNode()),
+    m_FileSystem(new QComboBox(this)),
+    m_Label(new QLineEdit(partition.fileSystem().label(), this)),
+    m_LabelError(new QLabel(this))
+{
+    setWindowTitle(i18nc("@title:window", "Format"));
+    setObjectName(QStringLiteral("formatDialog"));
+    m_FileSystem->setObjectName(QStringLiteral("fileSystem"));
+    m_Label->setObjectName(QStringLiteral("volumeLabel"));
+    m_LabelError->setWordWrap(true);
+
+    const QList<QPair<FileSystem::Type, QString>> types = {
+        {FileSystem::Type::Fat32, QStringLiteral("FAT32")},
+        {FileSystem::Type::Exfat, QStringLiteral("exFAT")},
+        {FileSystem::Type::Ntfs, QStringLiteral("NTFS")}
+    };
+    for (const auto& [type, name] : types) {
+        const auto fs = FileSystemFactory::map().value(type);
+        if (fs && fs->supportCreate() != FileSystem::cmdSupportNone &&
+            fs->supportSetLabel() != FileSystem::cmdSupportNone &&
+            partition.capacity() >= fs->minCapacity() && partition.capacity() <= fs->maxCapacity())
+            m_FileSystem->addItem(name, static_cast<int>(type));
+    }
+    const int current = m_FileSystem->findData(static_cast<int>(partition.fileSystem().type()));
+    if (current >= 0)
+        m_FileSystem->setCurrentIndex(current);
+
+    auto layout = new QVBoxLayout(this);
+    auto form = new QFormLayout;
+    auto deviceLabel = new QLabel(m_DeviceNode, this);
+    deviceLabel->setTextFormat(Qt::PlainText);
+    form->addRow(i18nc("@label", "Device:"), deviceLabel);
+    form->addRow(i18nc("@label", "File system:"), m_FileSystem);
+    form->addRow(i18nc("@label", "Label:"), m_Label);
+    layout->addLayout(form);
+    layout->addWidget(m_LabelError);
+
+    auto buttons = new QDialogButtonBox(QDialogButtonBox::Cancel, this);
+    m_FormatButton = buttons->addButton(i18nc("@action:button", "Format"), QDialogButtonBox::AcceptRole);
+    m_FormatButton->setObjectName(QStringLiteral("formatButton"));
+    auto cancel = buttons->button(QDialogButtonBox::Cancel);
+    cancel->setDefault(true);
+    cancel->setFocus();
+    layout->addWidget(buttons);
+    connect(buttons, &QDialogButtonBox::accepted, this, &FormatDialog::accept);
+    connect(buttons, &QDialogButtonBox::rejected, this, &FormatDialog::reject);
+    connect(m_FileSystem, &QComboBox::currentIndexChanged, this, [this] { validateLabel(); });
+    connect(m_Label, &QLineEdit::textChanged, this, [this] { validateLabel(); });
+    validateLabel();
+}
+
+FileSystem::Type FormatDialog::fileSystemType() const
+{
+    return static_cast<FileSystem::Type>(m_FileSystem->currentData().toInt());
+}
+
+QString FormatDialog::label() const
+{
+    return m_Label->text();
+}
+
+void FormatDialog::validateLabel()
+{
+    const auto fs = FileSystemFactory::map().value(fileSystemType());
+    bool valid = m_FileSystem->currentIndex() >= 0 && fs;
+    if (valid) {
+        QString text = label();
+        int position = 0;
+        std::unique_ptr<QValidator> validator(fs->labelValidator(nullptr));
+        valid = text.size() <= fs->maxLabelLength() &&
+            (text.isEmpty() || !validator || validator->validate(text, position) == QValidator::Acceptable);
+    }
+    m_FormatButton->setEnabled(valid);
+    if (m_FileSystem->currentIndex() < 0)
+        m_LabelError->setText(i18nc("@info", "No supported format is available for this drive."));
+    else
+        m_LabelError->setText(valid ? QString() : i18nc("@info", "This label cannot be used with %1. Change the label or choose another file system.", m_FileSystem->currentText()));
+}
+
+void FormatDialog::accept()
+{
+    if (!m_FormatButton->isEnabled())
+        return;
+    if (KMessageBox::warningContinueCancel(this,
+            xi18nc("@info", "Formatting <filename>%1</filename> will erase all its files.", m_DeviceNode),
+            i18nc("@title:window", "Format"), KGuiItem(i18nc("@action:button", "Format"))) == KMessageBox::Continue)
+        QDialog::accept();
+}
