+bool PartitionManagerWidget::setCurrentPartitionByDeviceNode(const QString& deviceNode)
+{
+    for (auto device : operationStack().previewDevices()) {
+        if (!device->partitionTable())
+            continue;
+        auto candidates = device->partitionTable()->children();
+        while (!candidates.isEmpty()) {
+            auto candidate = candidates.takeFirst();
+            if (candidate->deviceNode() == deviceNode) {
+                setSelectedDevice(device);
+                setSelectedPartition(candidate);
+                return selectedPartition() == candidate;
+            }
+            candidates.append(candidate->children());
+        }
+    }
+    return false;
+}
