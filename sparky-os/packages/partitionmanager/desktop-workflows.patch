@@ -0,0 +1,157 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Ramos
+    SPDX-License-Identifier: GPL-3.0-or-later
+*/
+
+#include "gui/partitionmanagerwidget.h"
+
+#include <core/diskdevice.h>
+#include <core/partition.h>
+#include <core/partitiontable.h>
+#include <fs/filesystemfactory.h>
+#include <ops/createfilesystemoperation.h>
+#include <ops/setfilesystemlabeloperation.h>
+
+#include <QApplication>
+#include <QComboBox>
+#include <QDialog>
+#include <QLineEdit>
+#include <QPushButton>
+#include <QStandardPaths>
+#include <QTest>
+#include <QTimer>
+
+class FormatActionTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void format_data();
+    void format();
+    void selectDeviceNode_data();
+    void selectDeviceNode();
+};
+
+void FormatActionTest::initTestCase()
+{
+    QStandardPaths::setTestModeEnabled(true);
+    FileSystemFactory::init();
+}
+
+void FormatActionTest::format_data()
+{
+    QTest::addColumn<FileSystem::Type>("type");
+    QTest::addColumn<bool>("consent");
+    QTest::newRow("cancel") << FileSystem::Type::Fat32 << false;
+    QTest::newRow("FAT32") << FileSystem::Type::Fat32 << true;
+    QTest::newRow("exFAT") << FileSystem::Type::Exfat << true;
+    QTest::newRow("NTFS") << FileSystem::Type::Ntfs << true;
+}
+
+void FormatActionTest::format()
+{
+    QFETCH(FileSystem::Type, type);
+    QFETCH(bool, consent);
+    const auto fs = FileSystemFactory::map().value(type);
+    const bool supported = fs->supportCreate() != FileSystem::cmdSupportNone && fs->supportSetLabel() != FileSystem::cmdSupportNone;
+    if (consent && !supported) {
+        QVERIFY2(!qEnvironmentVariableIsSet("REQUIRE_ALL_FORMATS"), "Required filesystem tools are unavailable");
+        QSKIP("Filesystem tools or the private KPMcore helper are unavailable");
+    }
+
+    constexpr qint64 sectors = 128 * 1024;
+    OperationStack stack;
+    auto device = new DiskDevice(QStringLiteral("USB"), QStringLiteral("/dev/test"), 512, sectors);
+    auto table = new PartitionTable(PartitionTable::gpt, 0, sectors - 1);
+    device->setPartitionTable(table);
+    auto partition = new Partition(table, *device, PartitionRole(PartitionRole::Primary),
+        FileSystemFactory::create(FileSystem::Type::Ntfs, 0, sectors - 1, 512, -1, QStringLiteral("MEDIA")),
+        0, sectors - 1, QStringLiteral("/dev/test1"));
+    table->append(partition);
+    stack.previewDevices().append(device);
+    PartitionManagerWidget widget;
+    widget.init(&stack);
+    widget.setSelectedDevice(device);
+    widget.setSelectedPartition(partition);
+    QCOMPARE(widget.selectedPartition(), partition);
+    bool labelPreserved = false;
+    bool emptyBeforeConsent = false;
+    QTimer::singleShot(0, &widget, [&] {
+        auto dialog = widget.findChild<QDialog*>(QStringLiteral("formatDialog"));
+        if (!dialog) {
+            if (auto unexpected = qobject_cast<QDialog*>(QApplication::activeModalWidget()))
+                unexpected->reject();
+            return;
+        }
+        auto label = dialog->findChild<QLineEdit*>(QStringLiteral("volumeLabel"));
+        labelPreserved = label && label->text() == QStringLiteral("MEDIA");
+        emptyBeforeConsent = stack.size() == 0;
+        if (!consent) {
+            dialog->reject();
+            return;
+        }
+        auto combo = dialog->findChild<QComboBox*>(QStringLiteral("fileSystem"));
+        combo->setCurrentIndex(combo->findData(static_cast<int>(type)));
+        QTimer::singleShot(0, dialog, [&] {
+            auto confirmation = qobject_cast<QDialog*>(QApplication::activeModalWidget());
+            if (!confirmation)
+                return;
+            for (auto button : confirmation->findChildren<QPushButton*>()) {
+                QString text = button->text();
+                text.remove(QLatin1Char('&'));
+                if (text == QStringLiteral("Format")) {
+                    button->click();
+                    return;
+                }
+            }
+            confirmation->reject();
+        });
+        dialog->findChild<QPushButton*>(QStringLiteral("formatButton"))->click();
+    });
+    QCOMPARE(widget.onFormatPartition(), consent);
+    QVERIFY(labelPreserved);
+    QVERIFY(emptyBeforeConsent);
+    QCOMPARE(stack.size(), consent ? 2 : 0);
+    QCOMPARE(partition->fileSystem().label(), QStringLiteral("MEDIA"));
+    if (consent) {
+        QCOMPARE(partition->fileSystem().type(), type);
+        QVERIFY(dynamic_cast<CreateFileSystemOperation*>(stack.operations().at(0)));
+        QVERIFY(dynamic_cast<SetFileSystemLabelOperation*>(stack.operations().at(1)));
+    }
+}
+
+void FormatActionTest::selectDeviceNode_data()
+{
+    QTest::addColumn<QString>("node");
+    QTest::newRow("USB partition") << QStringLiteral("/dev/sda1");
+    QTest::newRow("multi-digit partition") << QStringLiteral("/dev/sda10");
+    QTest::newRow("SD card partition") << QStringLiteral("/dev/mmcblk0p1");
+    QTest::newRow("whole disk filesystem") << QStringLiteral("/dev/mmcblk0");
+}
+
+void FormatActionTest::selectDeviceNode()
+{
+    QFETCH(QString, node);
+    constexpr qint64 sectors = 128 * 1024;
+    OperationStack stack;
+    auto device = new DiskDevice(QStringLiteral("USB"), QStringLiteral("/dev/test"), 512, sectors);
+    auto table = new PartitionTable(PartitionTable::gpt, 0, sectors - 1);
+    device->setPartitionTable(table);
+    auto partition = new Partition(table, *device, PartitionRole(PartitionRole::Primary),
+        FileSystemFactory::create(FileSystem::Type::Ntfs, 0, sectors - 1, 512, -1, QStringLiteral("MEDIA")),
+        0, sectors - 1, node);
+    table->append(partition);
+    stack.previewDevices().append(device);
+    PartitionManagerWidget widget;
+    widget.init(&stack);
+    QVERIFY(widget.setCurrentPartitionByDeviceNode(node));
+    QCOMPARE(widget.selectedDevice(), device);
+    QCOMPARE(widget.selectedPartition(), partition);
+    QVERIFY(!widget.setCurrentPartitionByDeviceNode(node + QLatin1Char('1')));
+    QCOMPARE(widget.selectedPartition(), partition);
+    QCOMPARE(stack.size(), 0);
+}
+
+QTEST_MAIN(FormatActionTest)
+#include "formatactiontest.moc"
