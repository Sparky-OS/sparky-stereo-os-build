+    QFETCH(FileSystem::Type, type);
+    constexpr qint64 sectors = 128 * 1024;
+    DiskDevice device(QStringLiteral("USB"), QStringLiteral("/dev/test"), 512, sectors);
+    PartitionTable table(PartitionTable::gpt, 0, sectors - 1);
+    Partition partition(&table, device, PartitionRole(PartitionRole::Primary),
+        FileSystemFactory::create(type, 0, sectors - 1, 512, -1, QStringLiteral("MEDIA")),
+        0, sectors - 1, QStringLiteral("/dev/test1"));
+    FormatDialog dialog(nullptr, partition);
+    auto label = dialog.findChild<QLineEdit*>(QStringLiteral("volumeLabel"));
+    QVERIFY(label);
+    QCOMPARE(label->text(), QStringLiteral("MEDIA"));
+    auto combo = dialog.findChild<QComboBox*>(QStringLiteral("fileSystem"));
+    QVERIFY(combo);
+    const QMap<FileSystem::Type, QString> names = {
+        {FileSystem::Type::Fat32, QStringLiteral("FAT32")},
+        {FileSystem::Type::Exfat, QStringLiteral("exFAT")},
+        {FileSystem::Type::Ntfs, QStringLiteral("NTFS")}
+    };
+    int expectedCount = 0;
+    for (auto it = names.cbegin(); it != names.cend(); ++it) {
+        const auto fs = FileSystemFactory::map().value(it.key());
+        const bool supported = fs->supportCreate() != FileSystem::cmdSupportNone && fs->supportSetLabel() != FileSystem::cmdSupportNone;
+        const int index = combo->findData(static_cast<int>(it.key()));
+        QCOMPARE(index >= 0, supported);
+        if (supported) {
+            ++expectedCount;
+            QCOMPARE(combo->itemText(index), it.value());
+        }
+    }
+    QCOMPARE(combo->count(), expectedCount);
+    if (qEnvironmentVariableIsSet("REQUIRE_ALL_FORMATS"))
+        QCOMPARE(combo->count(), 3);
+    auto format = dialog.findChild<QPushButton*>(QStringLiteral("formatButton"));
+    QVERIFY(format);
+    QCOMPARE(format->isEnabled(), expectedCount > 0);
+    const QString images = qEnvironmentVariable("DOLPHIN_PROOF_IMAGES");
+    if (!images.isEmpty()) {
+        QVERIFY(QDir().mkpath(images));
+        QVERIFY(dialog.grab().save(images + QStringLiteral("/format-") + QString::fromLatin1(QTest::currentDataTag()) +
+            QLatin1Char('-') + QGuiApplication::platformName() + QStringLiteral(".png")));
+    }
+    if (combo->findData(static_cast<int>(type)) >= 0)
+        QCOMPARE(dialog.fileSystemType(), type);
+    auto buttons = dialog.findChild<QDialogButtonBox*>();
+    QVERIFY(buttons);
+    QVERIFY(buttons->button(QDialogButtonBox::Cancel)->isDefault());
+    buttons->button(QDialogButtonBox::Cancel)->click();
+    QCOMPARE(dialog.result(), static_cast<int>(QDialog::Rejected));
+    QCOMPARE(partition.fileSystem().label(), QStringLiteral("MEDIA"));
+}
+
+void FormatDialogTest::doesNotTruncateLabel()
+{
+    constexpr qint64 sectors = 128 * 1024;
+    const QString originalLabel(129, QLatin1Char('A'));
+    DiskDevice device(QStringLiteral("USB"), QStringLiteral("/dev/test"), 512, sectors);
+    PartitionTable table(PartitionTable::gpt, 0, sectors - 1);
+    Partition partition(&table, device, PartitionRole(PartitionRole::Primary),
+        FileSystemFactory::create(FileSystem::Type::Ntfs, 0, sectors - 1, 512, -1, originalLabel),
+        0, sectors - 1, QStringLiteral("/dev/test1"));
+    FormatDialog dialog(nullptr, partition);
+    auto button = dialog.findChild<QPushButton*>(QStringLiteral("formatButton"));
+    QVERIFY(button);
+    QCOMPARE(dialog.label(), originalLabel);
+    QVERIFY(!button->isEnabled());
+    dialog.accept();
+    QCOMPARE(dialog.result(), static_cast<int>(QDialog::Rejected));
+    QCOMPARE(dialog.label(), originalLabel);
+}
