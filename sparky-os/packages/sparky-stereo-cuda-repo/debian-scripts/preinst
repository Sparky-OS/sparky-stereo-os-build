# Before this package, the image (iso-build/apt-setup.sh) and the hardware setup (sparky-stereo-hardware's setup_nvidia,
# up to 0.1.14) wrote NVIDIA's CUDA source and its pin themselves, under the names this package uses. On the first
# install dpkg would ask about the pin, a conffile of this package, as a file created locally, and stop there without a
# terminal; the source would stay as the image wrote it. A file still byte for byte as those tools wrote it, and owned by
# no package, is moved aside here, so dpkg installs the pin and postinst writes the source without asking, and postinst
# removes the old copies. A file a person changed stays where it is: dpkg asks about the pin (its default keeps the
# person's file), and postinst keeps the person's source. dpkg-maintscript-helper's rm_conffile moves a file aside the
# same way (FILE.dpkg-remove).
set -e
take() {
	[ -f "$1" ] && [ ! -L "$1" ] || return 0
	! dpkg-query -S "$1" >/dev/null 2>&1 || return 0
	[ "$(md5sum <"$1" | cut -d' ' -f1)" = "$2" ] || return 0
	mv -f "$1" "$1.dpkg-remove"
}
if [ "$1" = install ] && [ -z "${2:-}" ]; then
	take /etc/apt/sources.list.d/sparky-stereo-cuda.sources 4abd712910958234d3642f537286ec8f
	take /etc/apt/preferences.d/91sparky-stereo-cuda a1933e8737ed1dcdb105f6a6da42d36c
fi
# NVIDIA's cuda-keyring installs the key file this package installs too (Replaces). NVIDIA's package for another Debian
# release holds another key there (Debian 12's: 3BF863CC); dpkg replaces it, and that is said, never done quietly.
KEY=/usr/share/keyrings/cuda-archive-keyring.gpg
if [ -f "$KEY" ] && dpkg-query -S "$KEY" 2>/dev/null | grep -q '^cuda-keyring:' &&
	[ "$(md5sum <"$KEY" | cut -d' ' -f1)" != 672a16cb3b8c6e53844563ae8c441557 ]; then
	echo "sparky-stereo-cuda-repo: $KEY, from cuda-keyring, holds another key; it now holds NVIDIA's key for Debian 13 (02182E60104FCDC26EAE1B8597A5D4CB8793F200), which this repository is signed with; cuda-keyring stays installed"
fi
