From 609b59091ebaaf19abc296129c0c27287acc70bb Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 19 Nov 2026 07:01:42 -0300
Subject: [PATCH] Keep the chosen stereo packing when activating HEVC

Assisted-by: GPT-6 via Codex
---
 src/VideoStream.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/VideoStream.cpp b/src/VideoStream.cpp
index d9206e5..a779bf3 100644
--- a/src/VideoStream.cpp
+++ b/src/VideoStream.cpp
@@ -269,7 +269,7 @@ void VideoStream::setActiveEncodingMode(EncodingMode mode)
 
     d->activeEncodingMode = mode;
 
-    if (d->packing != PipeWireBaseEncodedStream::StereoPacking::SideBySide && mode != EncodingMode::H264) {
+    if (d->packing != PipeWireBaseEncodedStream::StereoPacking::SideBySide && mode != EncodingMode::H264 && mode != EncodingMode::HEVC) {
         d->session->close(RdpConnection::CloseReason::VideoInitFailed);
         return;
     }
