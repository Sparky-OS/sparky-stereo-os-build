set -e
#DEBHELPER#
unit=OpenLinkHub.service
case "$1" in
remove)
	if [ -d /run/systemd/system ]; then systemctl --system daemon-reload >/dev/null || true; fi
	if [ -d /run/udev ]; then udevadm control --reload-rules >/dev/null 2>&1 || true; fi ;;
purge)
	# the unit's enable records and the state this package made (profiles, config.json); the system user stays, as Debian policy has it
	deb-systemd-helper purge $unit >/dev/null || true
	deb-systemd-helper unmask $unit >/dev/null || true
	if ! [ -d /opt/OpenLinkHub ]; then rm -rf /var/lib/openlinkhub; fi ;;
esac
exit 0
