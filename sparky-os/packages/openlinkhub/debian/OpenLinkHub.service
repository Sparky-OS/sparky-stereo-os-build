[Unit]
Description=Open source interface for iCUE LINK System Hub, Corsair AIOs and Hubs
After=sleep.target systemd-sysusers.service systemd-udevd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=openlinkhub
# upstream's unit, three lines changed for the filesystem hierarchy: the program is in /usr/bin, its working folder (everything it reads
# and writes is relative to it) is the state folder, and a seed step links the page's files and copies the default database there
StateDirectory=openlinkhub
WorkingDirectory=/var/lib/openlinkhub
ExecStartPre=/usr/libexec/openlinkhub/openlinkhub-seed
ExecStartPre=+/usr/bin/udevadm control --reload-rules
ExecStartPre=+/usr/bin/udevadm trigger --subsystem-match=usb --attr-match=idVendor=1b1c
ExecStartPre=+/usr/bin/udevadm settle --timeout=30
ExecStart=/usr/bin/OpenLinkHub
ExecReload=/bin/kill -s HUP $MAINPID
RestartSec=5
Restart=always

[Install]
WantedBy=multi-user.target
