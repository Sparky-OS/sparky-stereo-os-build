set -e
#DEBHELPER#
unit=OpenLinkHub.service
# stops only the service this package installed: never upstream's own install of the same name
if [ "$1" = remove ] && [ -d /run/systemd/system ] && ! [ -d /opt/OpenLinkHub ] && ! [ -e /etc/systemd/system/$unit ]; then
	deb-systemd-invoke stop $unit >/dev/null || true
fi
exit 0
