export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# upstream's defaults and its own tests (QtWebEngine runs without a display: the tests set the offscreen platform, --disable-gpu
# and --no-sandbox themselves). The package's documents come from dh, not from upstream's CPack step.
override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON

override_dh_auto_test:
	dh_auto_test -- ARGS="--output-on-failure --no-tests=error"

override_dh_installchangelogs:
	dh_installchangelogs packaging/changelog
