+/**
+ * gtk_gl_area_set_format:
+ * @area: a `GtkGLArea`
+ * @format: the format of the picture
+ *
+ * Sets the format of the picture the area renders into.
+ *
+ * The default, %GDK_MEMORY_R8G8B8A8_PREMULTIPLIED, is 8 bits a channel.
+ * A program whose picture is deeper asks for it here:
+ * %GDK_MEMORY_ABGR2101010_PREMULTIPLIED for 10 bits a channel,
+ * %GDK_MEMORY_R16G16B16A16_PREMULTIPLIED for 16 bits a channel (and for
+ * pictures of 12 bits, which have no format of their own),
+ * %GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED and
+ * %GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED for half and single float.
+ * Other formats are not accepted.
+ *
+ * The framebuffer of [signal@Gtk.GLArea::render], the texture GTK draws and
+ * the buffer a compositor gets all have that format; a stereo area's picture
+ * is opaque. If the OpenGL context cannot render into the format, the area
+ * shows that as its error (see [method@Gtk.GLArea.get_error]).
+ *
+ * The picture of a stereo area reaches the compositor as a dma-buf. Half
+ * float is the deepest float format a dma-buf has, so the views of a single
+ * float area are rendered in single floats and their picture is kept in half
+ * floats. Where the OpenGL driver exports no dma-buf of the area's format
+ * (16 bits a channel on some drivers), the area cannot be shown per eye and
+ * says so in [property@Gtk.GLArea:stereo-error].
+ *
+ * What the values mean is said with [method@Gtk.GLArea.set_color_state].
+ * On X11 a stereo area's window has the depth of the toplevel's visual.
+ *
+ * Since: 4.24
+ */
+void
+gtk_gl_area_set_format (GtkGLArea       *area,
+                        GdkMemoryFormat  format)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+  g_return_if_fail (gtk_gl_area_format_is_valid (format));
+
+  if (priv->format == format)
+    return;
+
+  priv->format = format;
+  priv->needs_render = TRUE;
+
+  g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_FORMAT]);
+  gtk_widget_queue_draw (GTK_WIDGET (area));
+}
+
+/**
+ * gtk_gl_area_get_format:
+ * @area: a `GtkGLArea`
+ *
+ * Gets the format of the picture the area renders into.
+ *
+ * See [method@Gtk.GLArea.set_format].
+ *
+ * Returns: the format
+ *
+ * Since: 4.24
+ */
+GdkMemoryFormat
+gtk_gl_area_get_format (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), GDK_MEMORY_R8G8B8A8_PREMULTIPLIED);
+
+  return priv->format;
+}
+
+/**
+ * gtk_gl_area_set_color_state:
+ * @area: a `GtkGLArea`
+ * @color_state: (nullable): the color state of the picture, or %NULL for sRGB
+ *
+ * Sets the color state of the picture the area renders.
+ *
+ * The values the program renders are taken as values of that color state:
+ * sRGB by default, or for example [func@Gdk.ColorState.get_rec2100_pq] for
+ * a Rec. 2100 picture with the perceptual quantizer, a color state built
+ * from [struct@Gdk.CicpParams] for hybrid log-gamma, or
+ * [func@Gdk.ColorState.get_rec2100_linear]. GTK converts the picture when
+ * it draws it into the window. Where the picture goes to the compositor on
+ * a surface of its own (a stereo area, an area in a
+ * [class@Gtk.GraphicsOffload]), the color state goes with it as the
+ * surface's color description, so the picture keeps its depth and its
+ * colors to the output; a stereo area's two views share it.
+ *
+ * On X11 a stereo area's window carries no color description, so a stereo
+ * area in another color state than sRGB is not shown per eye there (see
+ * [property@Gtk.GLArea:stereo-error]): GTK draws its left view, converted.
+ *
+ * Since: 4.24
+ */
+void
+gtk_gl_area_set_color_state (GtkGLArea     *area,
+                             GdkColorState *color_state)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+
+  if (color_state == NULL)
+    color_state = gdk_color_state_get_srgb ();
+
+  if (priv->color_state != NULL && gdk_color_state_equal (priv->color_state, color_state))
+    return;
+  if (priv->color_state == NULL && gdk_color_state_equal (color_state, gdk_color_state_get_srgb ()))
+    return;
+
+  g_clear_pointer (&priv->color_state, gdk_color_state_unref);
+  priv->color_state = gdk_color_state_ref (color_state);
+  priv->needs_render = TRUE;
+
+  g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_COLOR_STATE]);
+  gtk_widget_queue_draw (GTK_WIDGET (area));
+}
+
+/**
+ * gtk_gl_area_get_color_state:
+ * @area: a `GtkGLArea`
+ *
+ * Gets the color state of the picture the area renders.
+ *
+ * See [method@Gtk.GLArea.set_color_state].
+ *
+ * Returns: (transfer none): the color state
+ *
+ * Since: 4.24
+ */
+GdkColorState *
+gtk_gl_area_get_color_state (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), NULL);
+
+  return priv->color_state ? priv->color_state : gdk_color_state_get_srgb ();
+}
