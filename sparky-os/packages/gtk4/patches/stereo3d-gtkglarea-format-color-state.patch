+/* The format and the color state of the picture: 8 bits and sRGB until the
+ * program says otherwise, every depth the area takes, and the color states. */
+static void
+test_format_and_color_state (void)
+{
+  static const GdkMemoryFormat formats[] = {
+    GDK_MEMORY_ABGR2101010_PREMULTIPLIED,
+    GDK_MEMORY_R16G16B16A16_PREMULTIPLIED,
+    GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED,
+    GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED,
+    GDK_MEMORY_R8G8B8A8_PREMULTIPLIED,
+  };
+  GtkWidget *area = gtk_gl_area_new ();
+  GdkColorState *state = NULL;
+  GdkMemoryFormat format;
+  int notified = 0;
+
+  g_object_ref_sink (area);
+
+  g_assert_cmpint (gtk_gl_area_get_format (GTK_GL_AREA (area)), ==, GDK_MEMORY_R8G8B8A8_PREMULTIPLIED);
+  g_assert_true (gdk_color_state_equal (gtk_gl_area_get_color_state (GTK_GL_AREA (area)),
+                                        gdk_color_state_get_srgb ()));
+
+  g_signal_connect (area, "notify::format", G_CALLBACK (count_notify), &notified);
+  for (gsize i = 0; i < G_N_ELEMENTS (formats); i++)
+    {
+      gtk_gl_area_set_format (GTK_GL_AREA (area), formats[i]);
+      g_assert_cmpint (gtk_gl_area_get_format (GTK_GL_AREA (area)), ==, formats[i]);
+      g_object_get (area, "format", &format, NULL);
+      g_assert_cmpint (format, ==, formats[i]);
+    }
+  g_assert_cmpint (notified, ==, G_N_ELEMENTS (formats));
+
+  notified = 0;
+  g_signal_connect (area, "notify::color-state", G_CALLBACK (count_notify), &notified);
+  gtk_gl_area_set_color_state (GTK_GL_AREA (area), gdk_color_state_get_rec2100_pq ());
+  g_assert_true (gdk_color_state_equal (gtk_gl_area_get_color_state (GTK_GL_AREA (area)),
+                                        gdk_color_state_get_rec2100_pq ()));
+  g_assert_cmpint (notified, ==, 1);
+  gtk_gl_area_set_color_state (GTK_GL_AREA (area), gdk_color_state_get_rec2100_pq ());
+  g_assert_cmpint (notified, ==, 1);
+
+  g_object_get (area, "color-state", &state, NULL);
