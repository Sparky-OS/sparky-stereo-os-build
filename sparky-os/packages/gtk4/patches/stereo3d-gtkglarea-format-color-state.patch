+/*
+ * Whether @format is one an area renders into: the 8 bit default, and the
+ * deeper formats that OpenGL can render into and a dma-buf can carry (10 bits
+ * a channel packed, 16 bits a channel, half and single float). All are
+ * premultiplied, as the default is.
+ */
+static gboolean
+gtk_gl_area_format_is_valid (GdkMemoryFormat format)
+{
+  switch ((int) format)
+    {
+    case GDK_MEMORY_R8G8B8A8_PREMULTIPLIED:
+    case GDK_MEMORY_ABGR2101010_PREMULTIPLIED:
+    case GDK_MEMORY_R16G16B16A16_PREMULTIPLIED:
+    case GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED:
+    case GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED:
+      return TRUE;
+    default:
+      return FALSE;
+    }
+}
+
+/* The opaque form of an area's format, for the picture of a stereo area */
+static GdkMemoryFormat
+gtk_gl_area_opaque_format (GdkMemoryFormat format)
+{
+  switch ((int) format)
+    {
+    case GDK_MEMORY_ABGR2101010_PREMULTIPLIED:
+      return GDK_MEMORY_XBGR2101010;
+    case GDK_MEMORY_R16G16B16A16_PREMULTIPLIED:
+      return GDK_MEMORY_R16G16B16;
+    case GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED:
+      return GDK_MEMORY_R16G16B16_FLOAT;
+    case GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED:
+      return GDK_MEMORY_R32G32B32_FLOAT;
+    default:
+      return GDK_MEMORY_R8G8B8X8;
+    }
+}
+
+/* The dma-buf format that ignores the alpha of @fourcc: a stereo picture is
+ * opaque, whatever the program left in its alpha */
+static guint32
+gtk_gl_area_opaque_fourcc (guint32 fourcc)
+{
+  switch (fourcc)
+    {
+    case DRM_FORMAT_ABGR8888: return DRM_FORMAT_XBGR8888;
+    case DRM_FORMAT_ARGB8888: return DRM_FORMAT_XRGB8888;
+    case DRM_FORMAT_ABGR2101010: return DRM_FORMAT_XBGR2101010;
+    case DRM_FORMAT_ARGB2101010: return DRM_FORMAT_XRGB2101010;
+    case DRM_FORMAT_ABGR16161616: return DRM_FORMAT_XBGR16161616;
+    case DRM_FORMAT_ARGB16161616: return DRM_FORMAT_XRGB16161616;
+    case DRM_FORMAT_ABGR16161616F: return DRM_FORMAT_XBGR16161616F;
+    case DRM_FORMAT_ARGB16161616F: return DRM_FORMAT_XRGB16161616F;
+    default: return fourcc;
+    }
+}
+
+/* The format of the picture GTK shows. It is the area's format, with one
+ * exception: the picture of a stereo area goes to the compositor as a dma-buf,
+ * and half float is the deepest float format a dma-buf has. The views of a
+ * 32 bit float area are rendered in 32 bit floats and their picture is kept in
+ * half floats. */
+static GdkMemoryFormat
+gtk_gl_area_get_picture_format (GtkGLArea *area,
+                                gboolean   stereo)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  if (stereo && priv->format == GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED)
+    return GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED;
+
+  return priv->format;
+}
+
+/* Allocates the storage of a texture of the format @memory_format. The 8 bit
+ * default is allocated as it always was. */
+static void
+gtk_gl_area_tex_image (GtkGLArea       *area,
+                       GdkMemoryFormat  memory_format,
+                       gboolean         opaque,
+                       int              width,
+                       int              height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  gboolean gles = gdk_gl_context_get_api (priv->context) == GDK_GL_API_GLES;
+  GLint internal_format, internal_srgb_format;
+  GLenum format, type;
+  GdkSwizzle swizzle;
+
+  if (memory_format != GDK_MEMORY_R8G8B8A8_PREMULTIPLIED &&
+      gdk_memory_format_gl_format (memory_format, 0, gles,
+                                   &internal_format, &internal_srgb_format,
+                                   &format, &type, &swizzle))
+    {
+      /* A deeper picture keeps its alpha channel also when it is opaque:
+       * the formats with three channels need not be renderable */
+      glTexImage2D (GL_TEXTURE_2D, 0, internal_format, width, height, 0, format, type, NULL);
+      return;
+    }
+
+  if (opaque)
+    glTexImage2D (GL_TEXTURE_2D, 0, GL_RGB8, width, height, 0, gles ? GL_RGB : GL_BGRA, GL_UNSIGNED_BYTE, NULL);
+  else
+    glTexImage2D (GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, gles ? GL_RGBA : GL_BGRA, GL_UNSIGNED_BYTE, NULL);
+}
