+/* The picture of a stereo area is opaque. The 8 and the 10 bit pictures say
+ * so in their format; a deeper picture keeps its alpha channel (the dma-buf
+ * formats of 16 bits and of half floats that GDK knows have one), and its
+ * alpha is made one here, whatever the program left in it. */
+static void
+gtk_gl_area_stereo_fill_alpha (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  GLboolean scissor, mask[4];
+  GLfloat color[4];
+
+  if (priv->format == GDK_MEMORY_R8G8B8A8_PREMULTIPLIED ||
+      priv->format == GDK_MEMORY_ABGR2101010_PREMULTIPLIED)
+    return;
+
+  scissor = glIsEnabled (GL_SCISSOR_TEST);
+  glGetBooleanv (GL_COLOR_WRITEMASK, mask);
+  glGetFloatv (GL_COLOR_CLEAR_VALUE, color);
+
+  glBindFramebuffer (GL_DRAW_FRAMEBUFFER, priv->blit_frame_buffer);
+  glDisable (GL_SCISSOR_TEST);
+  glColorMask (GL_FALSE, GL_FALSE, GL_FALSE, GL_TRUE);
+  glClearColor (0, 0, 0, 1);
+  glClear (GL_COLOR_BUFFER_BIT);
+
+  glClearColor (color[0], color[1], color[2], color[3]);
+  glColorMask (mask[0], mask[1], mask[2], mask[3]);
+  if (scissor)
+    glEnable (GL_SCISSOR_TEST);
+  glBindFramebuffer (GL_FRAMEBUFFER, priv->frame_buffer);
+}
