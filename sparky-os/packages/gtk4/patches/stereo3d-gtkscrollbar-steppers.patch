+/* A held stepper goes on scrolling after GTK 3's initial delay */
+#define STEPPER_REPEAT_DELAY 500
+
+/* The steppers in their order along the scrollbar; the range is between B and C */
+enum {
+  STEPPER_A,  /* backward */
+  STEPPER_B,  /* secondary forward */
+  STEPPER_C,  /* secondary backward */
+  STEPPER_D,  /* forward */
+  N_STEPPERS
+};
+
+typedef struct _GtkScrollbarStepper      GtkScrollbarStepper;
+typedef struct _GtkScrollbarStepperClass GtkScrollbarStepperClass;
+
+struct _GtkScrollbarStepper
+{
+  GtkWidget parent_instance;
+
+  gboolean backward; /* moves the slider up or left */
+};
+
+struct _GtkScrollbarStepperClass
+{
+  GtkWidgetClass parent_class;
+};
+
+static GType gtk_scrollbar_stepper_get_type (void) G_GNUC_CONST;
