+static void
+gtk_scrollbar_stepper_snapshot (GtkWidget   *widget,
+                                GtkSnapshot *snapshot)
+{
+  GtkCssStyle *style = gtk_css_node_get_style (gtk_widget_get_css_node (widget));
+  int width = gtk_widget_get_width (widget);
+  int height = gtk_widget_get_height (widget);
+  int size;
+
+  size = MIN (gtk_css_number_value_get (style->icon->icon_size, 100), MIN (width, height));
+  if (size <= 0)
+    return;
+
+  gtk_snapshot_save (snapshot);
+  gtk_snapshot_translate (snapshot, &GRAPHENE_POINT_INIT ((width - size) / 2, (height - size) / 2));
+  gtk_css_style_snapshot_icon (style, snapshot, size, size);
+  gtk_snapshot_restore (snapshot);
+}
