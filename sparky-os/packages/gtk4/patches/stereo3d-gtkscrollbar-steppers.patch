+/* Whether a stepper moves the adjustment's value back: a backward stepper moves
+ * the slider up or left, and a horizontal scrollbar's range is flipped in
+ * right-to-left text (it is flippable and never inverted), as in GTK 3 */
+static gboolean
+stepper_moves_value_back (GtkScrollbar *self,
+                          GtkWidget    *stepper)
+{
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+  gboolean backward = ((GtkScrollbarStepper *) stepper)->backward;
+
+  if (priv->orientation == GTK_ORIENTATION_HORIZONTAL &&
+      gtk_widget_get_direction (GTK_WIDGET (self)) == GTK_TEXT_DIR_RTL)
+    return !backward;
+
+  return backward;
+}
+
+static void
+stop_stepper (GtkScrollbar *self)
+{
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+
+  g_clear_handle_id (&priv->repeat_id, g_source_remove);
+
+  if (priv->pressed_stepper)
+    {
+      gtk_widget_unset_state_flags (priv->pressed_stepper, GTK_STATE_FLAG_ACTIVE);
+      priv->pressed_stepper = NULL;
+      if (priv->range)
+        gtk_range_stop_autoscroll (GTK_RANGE (priv->range));
+    }
+}
+
+static void
+stepper_repeat (gpointer data)
+{
+  GtkScrollbar *self = data;
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+
+  priv->repeat_id = 0;
+  gtk_range_start_autoscroll (GTK_RANGE (priv->range), priv->repeat_scroll);
+}
+
+static void
+stepper_begin (GtkGesture       *gesture,
+               GdkEventSequence *sequence,
+               GtkScrollbar     *self)
+{
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+  GtkWidget *stepper = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture));
+  gboolean back = stepper_moves_value_back (self, stepper);
+  GtkScrollType scroll;
+
+  switch (gtk_gesture_single_get_current_button (GTK_GESTURE_SINGLE (gesture)))
+    {
+    case 0: /* touch */
+    case GDK_BUTTON_PRIMARY:
+      scroll = back ? GTK_SCROLL_STEP_BACKWARD : GTK_SCROLL_STEP_FORWARD;
+      break;
+    case GDK_BUTTON_SECONDARY:
+      scroll = back ? GTK_SCROLL_PAGE_BACKWARD : GTK_SCROLL_PAGE_FORWARD;
+      break;
+    case GDK_BUTTON_MIDDLE:
+      scroll = back ? GTK_SCROLL_START : GTK_SCROLL_END;
+      break;
+    default:
+      gtk_gesture_set_state (gesture, GTK_EVENT_SEQUENCE_DENIED);
+      return;
+    }
+
+  gtk_gesture_set_state (gesture, GTK_EVENT_SEQUENCE_CLAIMED);
+
+  stop_stepper (self);
+  priv->pressed_stepper = stepper;
+  gtk_widget_set_state_flags (stepper, GTK_STATE_FLAG_ACTIVE, FALSE);
+
+  g_signal_emit_by_name (priv->range, "move-slider", scroll);
+
+  if (scroll != GTK_SCROLL_START && scroll != GTK_SCROLL_END)
+    {
+      priv->repeat_scroll = scroll;
+      priv->repeat_id = g_timeout_add_once (STEPPER_REPEAT_DELAY, stepper_repeat, self);
+      gdk_source_set_static_name_by_id (priv->repeat_id, "[gtk] stepper_repeat");
+    }
+}
+
+static void
+stepper_end (GtkGesture       *gesture,
+             GdkEventSequence *sequence,
+             GtkScrollbar     *self)
+{
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+
+  if (priv->pressed_stepper == gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture)))
+    stop_stepper (self);
+}
+
+static void
+gtk_scrollbar_update_steppers (GtkScrollbar *self)
+{
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+  GtkAdjustment *adjustment;
+  gboolean can_back, can_forward;
+  int i;
+
+  if (!priv->range)
+    return;
+
+  adjustment = gtk_range_get_adjustment (GTK_RANGE (priv->range));
+  can_back = gtk_adjustment_get_value (adjustment) > gtk_adjustment_get_lower (adjustment);
+  can_forward = gtk_adjustment_get_value (adjustment) <
+                gtk_adjustment_get_upper (adjustment) - gtk_adjustment_get_page_size (adjustment);
+
+  for (i = 0; i < N_STEPPERS; i++)
+    {
+      gboolean sensitive = stepper_moves_value_back (self, priv->steppers[i]) ? can_back : can_forward;
+
+      if (!sensitive && priv->pressed_stepper == priv->steppers[i])
+        stop_stepper (self);
+
+      gtk_widget_set_sensitive (priv->steppers[i], sensitive);
+    }
+}
+
+static void
+gtk_scrollbar_measure (GtkWidget      *widget,
+                       GtkOrientation  orientation,
+                       int             for_size,
+                       int            *minimum,
+                       int            *natural,
+                       int            *minimum_baseline,
+                       int            *natural_baseline)
+{
+  GtkScrollbar *self = GTK_SCROLLBAR (widget);
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+  GtkWidget *child;
+
+  *minimum = *natural = 0;
+
+  for (child = gtk_widget_get_first_child (widget);
+       child != NULL;
+       child = gtk_widget_get_next_sibling (child))
+    {
+      int child_min, child_nat;
+
+      if (!gtk_widget_should_layout (child))
+        continue;
+
+      if (orientation == priv->orientation)
+        {
+          gtk_widget_measure (child, orientation, for_size, &child_min, &child_nat, NULL, NULL);
+          *minimum += child_min;
+          *natural += child_nat;
+        }
+      else
+        {
+          gtk_widget_measure (child, orientation, -1, &child_min, &child_nat, NULL, NULL);
+          *minimum = MAX (*minimum, child_min);
+          *natural = MAX (*natural, child_nat);
+        }
+    }
+}
+
+static void
+gtk_scrollbar_size_allocate (GtkWidget *widget,
+                             int        width,
+                             int        height,
+                             int        baseline)
+{
+  GtkScrollbar *self = GTK_SCROLLBAR (widget);
+  GtkScrollbarPrivate *priv = gtk_scrollbar_get_instance_private (self);
+  gboolean horizontal = priv->orientation == GTK_ORIENTATION_HORIZONTAL;
+  int length = horizontal ? width : height;
+  int thickness = horizontal ? height : width;
+  int sizes[N_STEPPERS];
+  int steppers = 0;
+  int range_min, room, pos, i;
+
+  gtk_widget_measure (priv->range, priv->orientation, thickness, &range_min, NULL, NULL, NULL);
+
+  for (i = 0; i < N_STEPPERS; i++)
+    {
+      sizes[i] = 0;
+      if (gtk_widget_should_layout (priv->steppers[i]))
+        gtk_widget_measure (priv->steppers[i], priv->orientation, thickness, &sizes[i], NULL, NULL, NULL);
+      steppers += sizes[i];
+    }
+
+  /* The steppers give way to the range on a scrollbar shorter than both */
+  room = MAX (0, length - range_min);
+  if (steppers > room)
+    {
+      int given = 0;
+
+      for (i = 0; i < N_STEPPERS; i++)
+        {
+          sizes[i] = sizes[i] * room / steppers;
+          given += sizes[i];
+        }
+      steppers = given;
+    }
+
+  pos = 0;
+  for (i = 0; i < N_STEPPERS; i++)
+    {
+      GtkWidget *child = priv->steppers[i];
+      int size = sizes[i];
+
+      if (i == STEPPER_C)
+        {
+          int range_length = length - steppers;
+
+          gtk_widget_size_allocate (priv->range,
+                                    &(GtkAllocation) {
+                                      horizontal ? pos : 0,
+                                      horizontal ? 0 : pos,
+                                      horizontal ? range_length : width,
+                                      horizontal ? height : range_length
+                                    }, -1);
+          pos += range_length;
+        }
+
+      if (!gtk_widget_should_layout (child))
+        continue;
+
+      gtk_widget_size_allocate (child,
+                                &(GtkAllocation) {
+                                  horizontal ? pos : 0,
+                                  horizontal ? 0 : pos,
+                                  horizontal ? size : width,
+                                  horizontal ? height : size
+                                }, -1);
+      pos += size;
+    }
+}
