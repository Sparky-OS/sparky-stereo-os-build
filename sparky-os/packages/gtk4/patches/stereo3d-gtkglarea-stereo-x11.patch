+#ifdef GDK_WINDOWING_X11
+/* The window manager takes the declared child out of the toplevel's clipping
+ * a little after the declaration, and what is drawn on the half of the child
+ * outside the frame before that is lost: the first frames are drawn again. */
+static gboolean
+gtk_gl_area_x11_repeat (gpointer data)
+{
+  GtkGLArea *area = data;
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  priv->needs_render = TRUE;
+  gtk_widget_queue_draw (GTK_WIDGET (area));
+
+  if (--priv->x11_repeats > 0)
+    return G_SOURCE_CONTINUE;
+
+  priv->x11_repeat_id = 0;
+  return G_SOURCE_REMOVE;
+}
+
+/* Reads the two views back and hands them to the stereo child window of the
+ * area, at the area's place in the toplevel's X window. The picture takes one
+ * copy through the CPU; the views stay at the resolution they were drawn at. */
+static gboolean
+gtk_gl_area_x11_present (GtkGLArea *area,
+                         int        width,
+                         int        height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  GtkWidget *widget = GTK_WIDGET (area);
+  GtkNative *native = gtk_widget_get_native (widget);
+  graphene_rect_t bounds;
+  double nx, ny;
+  gsize stride = (gsize) 2 * width * 4;
+  gsize size = stride * height;
+  int scale = gtk_widget_get_scale_factor (widget);
+  GError *error = NULL;
+
+  if (size != priv->x11_size)
+    {
+      g_free (priv->x11_pixels);
+      g_free (priv->x11_rows);
+      priv->x11_pixels = g_malloc (size);
+      priv->x11_rows = g_malloc (size);
+      priv->x11_size = size;
+    }
+
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, priv->blit_frame_buffer);
+  glReadBuffer (GL_COLOR_ATTACHMENT0);
+  glPixelStorei (GL_PACK_ALIGNMENT, 1);
+  glReadPixels (0, 0, 2 * width, height, GL_RGBA, GL_UNSIGNED_BYTE, priv->x11_pixels);
+  glBindFramebuffer (GL_FRAMEBUFFER, priv->frame_buffer);
+
+  /* OpenGL's first row is the bottom one */
+  for (int row = 0; row < height; row++)
+    memcpy (priv->x11_rows + (gsize) row * stride,
+            priv->x11_pixels + (gsize) (height - 1 - row) * stride,
+            stride);
+
+  if (!gtk_widget_compute_bounds (widget, GTK_WIDGET (native), &bounds))
+    return FALSE;
+  gtk_native_get_surface_transform (native, &nx, &ny);
+
+  if (!gdk_x11_stereo_child_present (priv->x11_child,
+                                     (int) ((bounds.origin.x + nx) * scale),
+                                     (int) ((bounds.origin.y + ny) * scale),
+                                     width, height, priv->x11_rows, &error))
+    {
+      gtk_gl_area_stereo_fail (area, error);
+      return FALSE;
+    }
+
+  if (!priv->stereo_shown)
+    {
+      priv->stereo_shown = TRUE;
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_SHOWN]);
+      priv->x11_repeats = 10;
+      if (priv->x11_repeat_id == 0)
+        priv->x11_repeat_id = g_timeout_add (100, gtk_gl_area_x11_repeat, area);
+    }
+
+  return TRUE;
+}
+#endif
