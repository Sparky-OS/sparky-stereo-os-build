diff --git a/gdk/x11/gdkx11stereochild.c b/gdk/x11/gdkx11stereochild.c
new file mode 100644
index 0000000..d872066
--- /dev/null
+++ b/gdk/x11/gdkx11stereochild.c
@@ -0,0 +1,285 @@
+/* GDK - The GIMP Drawing Kit
+ *
+ * gdkx11stereochild.c: a stereo area on X11
+ *
+ * An area that holds the two views of a stereo picture is a child window of
+ * the toplevel's X window, and the window manager shows each view to one eye
+ * and the rest of the window the same to both. The child is declared with
+ * the library that writes the properties, libstereo-declare, loaded when the
+ * first stereo area asks, so that GTK does not depend on it.
+ *
+ * The area's place is a frame window of the size of one view. Inside it lies
+ * a window twice as wide, which holds the two views side by side at the
+ * resolution they were drawn at; it is the window that is declared, with the
+ * size one view is shown at (the frame's size). X clips it to the frame.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#include "gdkx11stereochild-private.h"
+
+#include <glib/gi18n-lib.h>
+#include <gdk/x11/gdkx11display.h>
+#include <gdk/x11/gdkx11surface.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <gmodule.h>
+
+#include <errno.h>
+#include <string.h>
+
+/* enum stereo_layout, enum stereo_class of libstereo-declare's header */
+#define STEREO_SBS_FULL    3
+#define STEREO_CLASS_NONE  0
+
+/* Support version 8 of _KDE_NET_WM_STEREO_CONTENT_SUPPORTED takes the size
+ * one view is shown at from a child that holds its views at full width. */
+#define NEEDED_SUPPORT 8
+
+typedef struct
+{
+  GModule *module;
+  unsigned (* supported)   (Display *display);
+  int      (* declare)     (Display *display, Window parent, Window child, int layout,
+                            int content_class, unsigned subclass,
+                            unsigned view_width, unsigned view_height);
+  int      (* one_view)    (Display *display, Window window, unsigned width, unsigned height);
+  int      (* remove)      (Display *display, Window parent, Window child);
+} StereoDeclare;
+
+static StereoDeclare *
+stereo_declare_load (GError **error)
+{
+  static StereoDeclare lib;
+  static gboolean tried;
+  static GError *load_error;
+
+  if (!tried)
+    {
+      tried = TRUE;
+      lib.module = g_module_open ("libstereo-declare.so.1", G_MODULE_BIND_LAZY | G_MODULE_BIND_LOCAL);
+      if (lib.module == NULL)
+        {
+          g_set_error (&load_error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "libstereo-declare.so.1 cannot be loaded: %s", g_module_error ());
+        }
+      else if (!g_module_symbol (lib.module, "stereo_supported_x11", (gpointer *) &lib.supported) ||
+               !g_module_symbol (lib.module, "stereo_declare_x11_child", (gpointer *) &lib.declare) ||
+               !g_module_symbol (lib.module, "stereo_declare_x11_one_view_size", (gpointer *) &lib.one_view) ||
+               !g_module_symbol (lib.module, "stereo_remove_x11_child", (gpointer *) &lib.remove))
+        {
+          g_set_error (&load_error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "libstereo-declare.so.1 is older than 1.7.0, which declares X11 children: %s",
+                       g_module_error ());
+          g_clear_pointer (&lib.module, g_module_close);
+        }
+    }
+
+  if (lib.module == NULL)
+    {
+      g_propagate_error (error, g_error_copy (load_error));
+      return NULL;
+    }
+
+  return &lib;
+}
+
+struct _GdkX11StereoChild
+{
+  GdkDisplay *display;
+  Display *xdisplay;
+  Window toplevel;
+  Window frame;
+  Window own;
+  GC gc;
+  StereoDeclare *lib;
+
+  int x, y, view_width, view_height;
+  gboolean mapped;
+  gboolean declared;
+};
+
+GdkX11StereoChild *
+gdk_x11_stereo_child_new (GdkSurface  *surface,
+                          GError     **error)
+{
+  GdkDisplay *display = gdk_surface_get_display (surface);
+  Display *xdisplay;
+  StereoDeclare *lib;
+  GdkX11StereoChild *child;
+  unsigned support;
+
+  if (!GDK_IS_X11_DISPLAY (display))
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                           "This display is not an X11 display");
+      return NULL;
+    }
+
+  lib = stereo_declare_load (error);
+  if (lib == NULL)
+    return NULL;
+
+  xdisplay = gdk_x11_display_get_xdisplay (display);
+  support = lib->supported (xdisplay);
+  if (support < NEEDED_SUPPORT)
+    {
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                   support == 0 ? "The window manager does not announce stereo content (_KDE_NET_WM_STEREO_CONTENT_SUPPORTED)"
+                                : "The window manager announces stereo content version %u, a child that holds both views needs %d",
+                   support, NEEDED_SUPPORT);
+      return NULL;
+    }
+
+  child = g_new0 (GdkX11StereoChild, 1);
+  child->display = display;
+  child->xdisplay = xdisplay;
+  child->toplevel = gdk_x11_surface_get_xid (surface);
+  child->lib = lib;
+
+  return child;
+}
+
+static void
+child_create_windows (GdkX11StereoChild *child)
+{
+  XSetWindowAttributes attributes = { 0, };
+  XWindowAttributes toplevel;
+
+  XGetWindowAttributes (child->xdisplay, child->toplevel, &toplevel);
+
+  attributes.event_mask = 0;
+  attributes.colormap = toplevel.colormap;
+  attributes.border_pixel = 0;
+  attributes.background_pixel = 0;
+  attributes.backing_store = NotUseful;
+
+  /* No events are selected on either window, so the pointer and the keys go to the toplevel */
+  child->frame = XCreateWindow (child->xdisplay, child->toplevel, 0, 0, 1, 1, 0,
+                                toplevel.depth, InputOutput, toplevel.visual,
+                                CWEventMask | CWColormap | CWBorderPixel | CWBackPixel, &attributes);
+  child->own = XCreateWindow (child->xdisplay, child->frame, 0, 0, 1, 1, 0,
+                              toplevel.depth, InputOutput, toplevel.visual,
+                              CWEventMask | CWColormap | CWBorderPixel | CWBackPixel, &attributes);
+  child->gc = XCreateGC (child->xdisplay, child->own, 0, NULL);
+}
+
+void
+gdk_x11_stereo_child_hide (GdkX11StereoChild *child)
+{
+  if (child->frame == None || !child->mapped)
+    return;
+
+  gdk_x11_display_error_trap_push (child->display);
+  XUnmapWindow (child->xdisplay, child->frame);
+  gdk_x11_display_error_trap_pop_ignored (child->display);
+  child->mapped = FALSE;
+}
+
+void
+gdk_x11_stereo_child_free (GdkX11StereoChild *child)
+{
+  if (child == NULL)
+    return;
+
+  gdk_x11_display_error_trap_push (child->display);
+  if (child->declared)
+    child->lib->remove (child->xdisplay, child->toplevel, child->own);
+  if (child->gc)
+    XFreeGC (child->xdisplay, child->gc);
+  if (child->frame != None)
+    XDestroyWindow (child->xdisplay, child->frame);
+  XSync (child->xdisplay, False);
+  gdk_x11_display_error_trap_pop_ignored (child->display);
+
+  g_free (child);
+}
+
+/* @rgba holds the two views side by side, 2 * view_width samples wide and
+ * view_height high, four bytes a sample with red first, the top row first. */
+gboolean
+gdk_x11_stereo_child_present (GdkX11StereoChild  *child,
+                              int                 x,
+                              int                 y,
+                              int                 view_width,
+                              int                 view_height,
+                              const guint8       *rgba,
+                              GError            **error)
+{
+  XWindowAttributes attributes;
+  XImage *image;
+  guint8 *data;
+  gsize n = (gsize) 2 * view_width * view_height;
+  gboolean resized;
+  int result;
+
+  gdk_x11_display_error_trap_push (child->display);
+
+  if (child->frame == None)
+    child_create_windows (child);
+
+  resized = view_width != child->view_width || view_height != child->view_height;
+
+  if (resized)
+    {
+      XResizeWindow (child->xdisplay, child->own, 2 * view_width, view_height);
+      XResizeWindow (child->xdisplay, child->frame, view_width, view_height);
+    }
+
+  if (x != child->x || y != child->y)
+    XMoveWindow (child->xdisplay, child->frame, x, y);
+
+  child->x = x;
+  child->y = y;
+  child->view_width = view_width;
+  child->view_height = view_height;
+
+  if (!child->declared)
+    {
+      result = child->lib->declare (child->xdisplay, child->toplevel, child->own,
+                                    STEREO_SBS_FULL, STEREO_CLASS_NONE, 0,
+                                    view_width, view_height);
+      if (result < 0)
+        {
+          XSync (child->xdisplay, False);
+          gdk_x11_display_error_trap_pop_ignored (child->display);
+          g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "libstereo-declare could not declare the child: %s", g_strerror (-result));
+          return FALSE;
+        }
+      child->declared = TRUE;
+    }
+  else if (resized)
+    child->lib->one_view (child->xdisplay, child->own, view_width, view_height);
+
+  if (!child->mapped)
+    {
+      XMapWindow (child->xdisplay, child->own);
+      XMapWindow (child->xdisplay, child->frame);
+      child->mapped = TRUE;
+    }
+
+  XGetWindowAttributes (child->xdisplay, child->own, &attributes);
+
+  /* Xlib wants the samples as the visual lays them out: blue, green, red, then the unused or alpha byte */
+  data = malloc (n * 4);
+  for (gsize i = 0; i < n; i++)
+    {
+      data[4 * i + 0] = rgba[4 * i + 2];
+      data[4 * i + 1] = rgba[4 * i + 1];
+      data[4 * i + 2] = rgba[4 * i + 0];
+      data[4 * i + 3] = 0xff;
+    }
+
+  image = XCreateImage (child->xdisplay, attributes.visual, attributes.depth, ZPixmap, 0,
+                        (char *) data, 2 * view_width, view_height, 32, 0);
+  XPutImage (child->xdisplay, child->own, child->gc, image, 0, 0, 0, 0, 2 * view_width, view_height);
+  XDestroyImage (image);
+  XFlush (child->xdisplay);
+
+  gdk_x11_display_error_trap_pop_ignored (child->display);
+
+  return TRUE;
+}
