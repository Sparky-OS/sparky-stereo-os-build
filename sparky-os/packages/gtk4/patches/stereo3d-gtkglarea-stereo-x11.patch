+static void
+gtk_gl_area_unmap (GtkWidget *widget)
+{
+#ifdef GDK_WINDOWING_X11
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (GTK_GL_AREA (widget));
