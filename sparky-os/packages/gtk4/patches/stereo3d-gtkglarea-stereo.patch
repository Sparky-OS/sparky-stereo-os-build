+static void
+gtk_gl_area_blit_eye (GtkGLArea    *area,
+                      GtkGLAreaEye  eye,
+                      int           width,
+                      int           height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  GLboolean scissor = glIsEnabled (GL_SCISSOR_TEST);
+  int x = eye == GTK_GL_AREA_EYE_RIGHT ? width : 0;
