+   * Since: 4.24
+   */
+  obj_props[PROP_STEREO_SHOWN] =
+    g_param_spec_boolean ("stereo-shown", NULL, NULL,
+                          FALSE,
+                          G_PARAM_READABLE | G_PARAM_STATIC_NAME |
+                          G_PARAM_EXPLICIT_NOTIFY);
+
+  /**
+   * GtkGLArea:stereo-error:
+   *
+   * Why the area, though [property@Gtk.GLArea:stereo] is set, cannot
+   * show its views per eye. It is %NULL otherwise.
+   *
+   * Since: 4.24
+   */
+  obj_props[PROP_STEREO_ERROR] =
+    g_param_spec_boxed ("stereo-error", NULL, NULL,
+                        G_TYPE_ERROR,
+                        G_PARAM_READABLE | G_PARAM_STATIC_NAME |
+                        G_PARAM_EXPLICIT_NOTIFY);
+
+  gobject_class->finalize = gtk_gl_area_finalize;
   gobject_class->set_property = gtk_gl_area_set_property;
   gobject_class->get_property = gtk_gl_area_get_property;
   gobject_class->notify = gtk_gl_area_notify;
@@ -1019,6 +1457,10 @@ gtk_gl_area_class_init (GtkGLAreaClass *klass)
    * The @context is bound to the @area prior to emitting this function,
    * and the buffers are painted to the window once the emission terminates.
    *
+   * If [property@Gtk.GLArea:stereo] is set, the signal is emitted twice for
+   * each frame, once for each view, and [method@Gtk.GLArea.get_current_eye]
+   * tells which one.
+   *
    * Returns: %TRUE to stop other handlers from being invoked for the event.
    *   %FALSE to propagate the event further.
    */
@@ -1571,3 +2013,144 @@ gtk_gl_area_make_current (GtkGLArea *area)
   if (priv->context != NULL)
     gdk_gl_context_make_current (priv->context);
 }
+
+/**
+ * gtk_gl_area_set_stereo:
+ * @area: a `GtkGLArea`
+ * @stereo: whether to render one view for each eye
+ *
+ * Sets whether the area renders one view for each eye.
+ *
+ * See [property@Gtk.GLArea:stereo].
+ *
+ * Since: 4.24
+ */
+void
+gtk_gl_area_set_stereo (GtkGLArea *area,
+                        gboolean   stereo)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+
+  stereo = !!stereo;
+
+  if (priv->stereo == stereo)
+    return;
+
+  priv->stereo = stereo;
+
+  gtk_gl_area_stereo_release (area);
+
+  if (priv->stereo_shown || priv->stereo_error != NULL)
+    {
+      priv->stereo_shown = FALSE;
+      g_clear_error (&priv->stereo_error);
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_SHOWN]);
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_ERROR]);
+    }
+
+  if (gtk_widget_get_realized (GTK_WIDGET (area)) && priv->context != NULL)
+    {
+      gtk_gl_area_make_current (area);
+      gtk_gl_area_delete_buffers (area);
+      gtk_gl_area_delete_textures (area);
+    }
+
+  priv->needs_resize = TRUE;
+  priv->needs_render = TRUE;
+
+  g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO]);
+  gtk_widget_queue_draw (GTK_WIDGET (area));
+}
+
+/**
+ * gtk_gl_area_get_stereo:
+ * @area: a `GtkGLArea`
+ *
+ * Returns whether the area is set to render one view for each eye.
+ *
+ * See [property@Gtk.GLArea:stereo].
+ *
+ * Returns: %TRUE if the area asks for stereo
+ *
+ * Since: 4.24
+ */
+gboolean
+gtk_gl_area_get_stereo (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), FALSE);
+
+  return priv->stereo;
+}
+
+/**
+ * gtk_gl_area_get_stereo_shown:
+ * @area: a `GtkGLArea`
+ *
+ * Returns whether the two views are shown per eye.
+ *
+ * See [property@Gtk.GLArea:stereo-shown].
+ *
+ * Returns: %TRUE if the compositor shows the views per eye
+ *
+ * Since: 4.24
+ */
+gboolean
+gtk_gl_area_get_stereo_shown (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), FALSE);
+
+  return priv->stereo_shown;
+}
+
+/**
+ * gtk_gl_area_get_stereo_error:
+ * @area: a `GtkGLArea`
+ *
+ * Gets why the area cannot show its views per eye.
+ *
+ * See [property@Gtk.GLArea:stereo-error].
+ *
+ * Returns: (transfer none) (nullable): the reason, or %NULL
+ *
+ * Since: 4.24
+ */
+const GError *
+gtk_gl_area_get_stereo_error (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), NULL);
+
+  return priv->stereo_error;
+}
+
+/**
+ * gtk_gl_area_get_current_eye:
+ * @area: a `GtkGLArea`
+ *
+ * Gets the eye whose view the [signal@Gtk.GLArea::render] handler is
+ * drawing.
+ *
+ * Outside of the signal, and for an area that does not ask for stereo,
+ * it is %GTK_GL_AREA_EYE_NONE. For an area that asks for stereo but
+ * cannot show it per eye, it is %GTK_GL_AREA_EYE_LEFT.
+ *
+ * Returns: the eye
+ *
+ * Since: 4.24
+ */
+GtkGLAreaEye
+gtk_gl_area_get_current_eye (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), GTK_GL_AREA_EYE_NONE);
+
+  return priv->current_eye;
+}
