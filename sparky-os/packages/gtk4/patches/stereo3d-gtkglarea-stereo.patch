@@ -929,6 +929,56 @@ gdk_wayland_subsurface_get_background_rect (GdkSubsurface   *sub,
 /* }}} */
 /* {{{ GObject boilerplate */
 
+static gboolean
+gdk_wayland_subsurface_set_stereo (GdkSubsurface  *sub,
+                                   gboolean        stereo,
+                                   GError        **error)
+{
+  GdkWaylandSubsurface *self = GDK_WAYLAND_SUBSURFACE (sub);
+  GdkWaylandDisplay *display;
+
+  if (sub->parent == NULL)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                           "The subsurface was destroyed");
+      return FALSE;
+    }
+
+  display = GDK_WAYLAND_DISPLAY (gdk_surface_get_display (sub->parent));
+
+  if (!stereo)
+    {
+      if (self->stereo_content)
+        {
+          kde_stereo_content_v1_destroy (self->stereo_content);
+          self->stereo_content = NULL;
+          GDK_DISPLAY_DEBUG (gdk_surface_get_display (sub->parent), OFFLOAD,
+                             "[%p] Stereo content declaration removed", self);
+        }
+      return TRUE;
+    }
+
+  if (self->stereo_content)
+    return TRUE;
+
+  if (display->stereo_content_manager == NULL)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                           "The compositor does not announce kde_stereo_content_manager_v1 version 2 or later");
+      return FALSE;
+    }
+
+  self->stereo_content = kde_stereo_content_manager_v1_create (display->stereo_content_manager,
+                                                               self->surface);
+  kde_stereo_content_v1_set_content (self->stereo_content,
+                                     KDE_STEREO_CONTENT_V1_CONTENT_SIDE_BY_SIDE_FULL);
+
+  GDK_DISPLAY_DEBUG (gdk_surface_get_display (sub->parent), OFFLOAD,
+                     "[%p] Declared as full side by side stereo content", self);
+
+  return TRUE;
+}
+
 G_DEFINE_TYPE (GdkWaylandSubsurface, gdk_wayland_subsurface, GDK_TYPE_SUBSURFACE)
 
 static void
@@ -952,6 +1002,7 @@ gdk_wayland_subsurface_finalize (GObject *object)
