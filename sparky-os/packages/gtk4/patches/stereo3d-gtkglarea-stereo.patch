diff --git a/testsuite/gtk/glarea.c b/testsuite/gtk/glarea.c
new file mode 100644
index 0000000..c318570
--- /dev/null
+++ b/testsuite/gtk/glarea.c
@@ -0,0 +1,164 @@
+/* GtkGLArea: the stereo property, the eye getter, and the honest failure
+ * when the views cannot be shown per eye.
+ *
+ * The test displays have no compositor that takes stereo content, so a stereo
+ * area must say so: stereo-shown stays FALSE, stereo-error is set, and the area
+ * renders its left view alone, once for each frame.
+ */
+
+#include <gtk/gtk.h>
+
+typedef struct
+{
+  int renders;
+  GtkGLAreaEye eyes[4];
+  gboolean timed_out;
+} RenderLog;
+
+static gboolean
+render_cb (GtkGLArea *area,
+           GdkGLContext *context,
+           RenderLog *log)
+{
+  if (log->renders < G_N_ELEMENTS (log->eyes))
+    log->eyes[log->renders] = gtk_gl_area_get_current_eye (area);
+  log->renders++;
+
+  return TRUE;
+}
+
+static gboolean
+timeout_cb (gpointer data)
+{
+  RenderLog *log = data;
+
+  log->timed_out = TRUE;
+
+  return G_SOURCE_REMOVE;
+}
+
+static void
+count_notify (GObject *object, GParamSpec *pspec, gpointer data)
+{
+  int *count = data;
+
+  (*count)++;
+}
+
+static void
+test_stereo_property (void)
+{
+  GtkWidget *area = gtk_gl_area_new ();
+  int notified = 0;
+  gboolean shown = TRUE;
+  GError *error = NULL;
+
+  g_object_ref_sink (area);
+
+  g_assert_false (gtk_gl_area_get_stereo (GTK_GL_AREA (area)));
+  g_assert_false (gtk_gl_area_get_stereo_shown (GTK_GL_AREA (area)));
+  g_assert_null (gtk_gl_area_get_stereo_error (GTK_GL_AREA (area)));
+  g_assert_cmpint (gtk_gl_area_get_current_eye (GTK_GL_AREA (area)), ==, GTK_GL_AREA_EYE_NONE);
+
+  g_signal_connect (area, "notify::stereo", G_CALLBACK (count_notify), &notified);
+
+  gtk_gl_area_set_stereo (GTK_GL_AREA (area), TRUE);
+  g_assert_true (gtk_gl_area_get_stereo (GTK_GL_AREA (area)));
+  g_assert_cmpint (notified, ==, 1);
+
+  gtk_gl_area_set_stereo (GTK_GL_AREA (area), TRUE);
+  g_assert_cmpint (notified, ==, 1);
+
+  g_object_get (area, "stereo-shown", &shown, "stereo-error", &error, NULL);
+  g_assert_false (shown);
+  g_assert_null (error);
+
+  g_object_set (area, "stereo", FALSE, NULL);
+  g_assert_false (gtk_gl_area_get_stereo (GTK_GL_AREA (area)));
+  g_assert_cmpint (notified, ==, 2);
+
+  g_object_unref (area);
+}
+
+static void
+test_stereo_unavailable (void)
+{
+  GtkWidget *window = gtk_window_new ();
+  GtkWidget *area = gtk_gl_area_new ();
+  RenderLog log = { 0, };
+  guint timeout;
+
+  gtk_widget_set_size_request (area, 64, 48);
+  gtk_window_set_child (GTK_WINDOW (window), area);
+  g_signal_connect (area, "render", G_CALLBACK (render_cb), &log);
+  gtk_gl_area_set_stereo (GTK_GL_AREA (area), TRUE);
+
+  gtk_window_present (GTK_WINDOW (window));
+
+  timeout = g_timeout_add_seconds (10, timeout_cb, &log);
+  while (log.renders == 0 && !log.timed_out &&
+         gtk_gl_area_get_error (GTK_GL_AREA (area)) == NULL)
+    g_main_context_iteration (NULL, TRUE);
+  g_source_remove (timeout);
+
+  if (gtk_gl_area_get_error (GTK_GL_AREA (area)) != NULL)
+    {
+      g_test_skip ("No OpenGL context");
+      gtk_window_destroy (GTK_WINDOW (window));
+      return;
+    }
+
+  g_assert_false (log.timed_out);
+  g_assert_cmpint (log.renders, >=, 1);
+
+  /* the stereo views were rendered at most once, and only if GTK could try
+   * to offload them: whatever came, the area then renders the left view alone */
+  g_assert_cmpint (log.eyes[0], ==, GTK_GL_AREA_EYE_LEFT);
+
+  /* a frame later the area knows it cannot show the views per eye */
+  timeout = g_timeout_add_seconds (10, timeout_cb, &log);
+  while (gtk_gl_area_get_stereo_error (GTK_GL_AREA (area)) == NULL && !log.timed_out)
+    g_main_context_iteration (NULL, TRUE);
+  g_source_remove (timeout);
+
+  g_assert_false (log.timed_out);
+  g_assert_false (gtk_gl_area_get_stereo_shown (GTK_GL_AREA (area)));
+  g_assert_nonnull (gtk_gl_area_get_stereo_error (GTK_GL_AREA (area)));
+  g_assert_error ((GError *) gtk_gl_area_get_stereo_error (GTK_GL_AREA (area)),
+                  GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE);
+
+  /* the area keeps drawing, the left view, never both side by side */
+  log.renders = 0;
+  gtk_widget_queue_draw (area);
+  timeout = g_timeout_add_seconds (10, timeout_cb, &log);
+  while (log.renders == 0 && !log.timed_out)
+    g_main_context_iteration (NULL, TRUE);
+  g_source_remove (timeout);
+  g_assert_cmpint (log.renders, ==, 1);
+  g_assert_cmpint (log.eyes[0], ==, GTK_GL_AREA_EYE_LEFT);
+
+  /* without the request, no eye and no error */
+  gtk_gl_area_set_stereo (GTK_GL_AREA (area), FALSE);
+  g_assert_null (gtk_gl_area_get_stereo_error (GTK_GL_AREA (area)));
+  log.renders = 0;
+  gtk_widget_queue_draw (area);
+  timeout = g_timeout_add_seconds (10, timeout_cb, &log);
+  while (log.renders == 0 && !log.timed_out)
+    g_main_context_iteration (NULL, TRUE);
+  g_source_remove (timeout);
+  g_assert_cmpint (log.renders, ==, 1);
+  g_assert_cmpint (log.eyes[0], ==, GTK_GL_AREA_EYE_NONE);
+
+  gtk_window_destroy (GTK_WINDOW (window));
+}
+
+int
+main (int argc, char *argv[])
+{
+  gtk_test_init (&argc, &argv);
+
+  g_test_add_func ("/glarea/stereo-property", test_stereo_property);
+  g_test_add_func ("/glarea/stereo-unavailable", test_stereo_unavailable);
+
+  return g_test_run ();
+}
