@@ -43,12 +44,27 @@ gdk_subsurface_finalize (GObject *object)
   G_OBJECT_CLASS (gdk_subsurface_parent_class)->finalize (object);
 }
 
+static gboolean
+gdk_subsurface_real_set_stereo (GdkSubsurface  *subsurface,
+                                gboolean        stereo,
+                                GError        **error)
+{
+  if (!stereo)
+    return TRUE;
+
+  g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "This windowing system has no way to declare a subsurface as stereo content");
+  return FALSE;
+}
+
 static void
 gdk_subsurface_class_init (GdkSubsurfaceClass *class)
 {
   GObjectClass *object_class = G_OBJECT_CLASS (class);
 
   object_class->finalize = gdk_subsurface_finalize;
+
+  class->set_stereo = gdk_subsurface_real_set_stereo;
 }
 
 /*< private >
@@ -379,3 +395,57 @@ gdk_subsurface_get_bounds (GdkSubsurface   *subsurface,
   if (gdk_subsurface_get_background_rect (subsurface, &background))
     graphene_rect_union (bounds, &background, bounds);
 }
+
+/*< private >
+ * gdk_subsurface_set_stereo:
+ * @subsurface: a `GdkSubsurface`
+ * @stereo: whether the contents attached to @subsurface hold two views
+ * @error: return location for an error
+ *
+ * Declares that the textures attached to @subsurface hold two views,
+ * the left eye and the right eye, full side by side with the left
+ * eye first, each at the resolution it was rendered at.
+ *
+ * The destination rectangle given to [method@Gdk.Subsurface.attach]
+ * is then the size of one view, and the texture is twice as wide as
+ * the view is shown. The compositor shows the left view to the left
+ * eye and the right view to the right eye.
+ *
+ * The declaration takes effect with the next attach. If the compositor
+ * cannot take the declaration, @error says why and the subsurface is
+ * unchanged.
+ *
+ * Returns: %TRUE if the declaration was made (or removed)
+ */
+gboolean
+gdk_subsurface_set_stereo (GdkSubsurface  *subsurface,
+                           gboolean        stereo,
+                           GError        **error)
+{
+  g_return_val_if_fail (GDK_IS_SUBSURFACE (subsurface), FALSE);
+  g_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+
+  if (!GDK_SUBSURFACE_GET_CLASS (subsurface)->set_stereo (subsurface, stereo, error))
+    return FALSE;
+
+  subsurface->stereo = !!stereo;
+
+  return TRUE;
+}
+
+/*< private >
+ * gdk_subsurface_is_stereo:
+ * @subsurface: a `GdkSubsurface`
+ *
+ * Returns whether @subsurface was declared as stereo content with
+ * gdk_subsurface_set_stereo().
+ *
+ * Returns: %TRUE if the textures attached hold two views
+ */
+gboolean
+gdk_subsurface_is_stereo (GdkSubsurface *subsurface)
+{
+  g_return_val_if_fail (GDK_IS_SUBSURFACE (subsurface), FALSE);
+
+  return subsurface->stereo;
+}
