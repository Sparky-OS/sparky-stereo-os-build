+/* Whether the window manager holds the child: what is drawn on it is kept
+ * whole from then on. Always %FALSE with a window manager that does not say. */
+gboolean
+gdk_x11_stereo_child_get_taken (GdkX11StereoChild *child)
+{
+  Atom type = None;
+  int format;
+  unsigned long n_items, after;
+  unsigned char *data = NULL;
+
+  if (child->taken || child->own == None || child->support < TAKEN_SUPPORT)
+    return child->taken;
+
+  gdk_x11_display_error_trap_push (child->display);
+  if (XGetWindowProperty (child->xdisplay, child->own,
+                          gdk_x11_get_xatom_by_name_for_display (child->display, "_KDE_NET_WM_STEREO_DEPTH_LIMITS"),
+                          0, 2, False, AnyPropertyType,
+                          &type, &format, &n_items, &after, &data) == Success &&
+      type != None)
+    child->taken = TRUE;
+  if (data != NULL)
+    XFree (data);
+  gdk_x11_display_error_trap_pop_ignored (child->display);
+
+  return child->taken;
+}
