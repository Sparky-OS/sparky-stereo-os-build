+/* A window surface on the window that holds both views, of the configuration
+ * the display's contexts have: the window was made with the toplevel's visual,
+ * which is that configuration's. */
+static gboolean
+child_ensure_gl_surface (GdkX11StereoChild  *child,
+                         GError            **error)
+{
+  EGLDisplay egl_display = gdk_display_get_egl_display (child->display);
+
+  if (child->egl_surface != EGL_NO_SURFACE || child->glx_window != None)
+    return TRUE;
+
+  if (child->gl_tried)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                           "No OpenGL surface could be made on the window");
+      return FALSE;
+    }
+  child->gl_tried = TRUE;
+
+  if (egl_display != EGL_NO_DISPLAY)
+    {
+      child->egl_surface = eglCreateWindowSurface (egl_display,
+                                                   gdk_display_get_egl_config (child->display, GDK_MEMORY_U8),
+                                                   (EGLNativeWindowType) child->own,
+                                                   NULL);
+      if (child->egl_surface == EGL_NO_SURFACE)
+        {
+          g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "eglCreateWindowSurface failed on the window (EGL error 0x%x)", eglGetError ());
+          return FALSE;
+        }
+    }
+  else
+    {
+      GdkX11Display *display_x11 = GDK_X11_DISPLAY (child->display);
+
+      if (display_x11->glx_config == NULL)
+        {
+          g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                               "The display has neither EGL nor GLX");
+          return FALSE;
+        }
+
+      child->glx_window = glXCreateWindow (child->xdisplay, display_x11->glx_config, child->own, NULL);
+      XSync (child->xdisplay, False);
+      if (child->glx_window == None)
+        {
+          g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                               "glXCreateWindow failed on the window");
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
+/* A context that was first made current with no window has no draw buffer for
+ * the window it gets later (OpenGL 4.6, section 17.4.1: the initial draw
+ * buffer is NONE when the context has no default framebuffer), and a blit
+ * then draws nothing. */
+static void
+child_draw_to_back_buffer (void)
+{
+  if (epoxy_is_desktop_gl ())
+    glDrawBuffer (GL_BACK);
+  else
+    {
+      GLenum buffer = GL_BACK;
+
+      glDrawBuffers (1, &buffer);
+    }
+}
+
+/* @framebuffer holds the two views side by side, 2 * view_width samples wide
+ * and view_height high, in the OpenGL context that is current. They are
+ * copied to the window with one blit and a swap that does not wait, and the
+ * context is given back as it was. One view is shown at
+ * place_width x place_height, at x, y in the toplevel. Fails, with nothing
+ * changed, where no OpenGL surface can be made on the window. */
+gboolean
+gdk_x11_stereo_child_present_gl (GdkX11StereoChild  *child,
+                                 guint               framebuffer,
+                                 int                 x,
+                                 int                 y,
+                                 int                 place_width,
+                                 int                 place_height,
+                                 int                 view_width,
+                                 int                 view_height,
+                                 GError            **error)
+{
+  GLboolean scissor;
+  gboolean result = FALSE;
+
+  gdk_x11_display_error_trap_push (child->display);
+
+  if (!child_prepare (child, x, y, place_width, place_height, view_width, view_height, error) ||
+      !child_ensure_gl_surface (child, error))
+    {
+      gdk_x11_display_error_trap_pop_ignored (child->display);
+      return FALSE;
+    }
+
+  scissor = glIsEnabled (GL_SCISSOR_TEST);
+
+  if (child->egl_surface != EGL_NO_SURFACE)
+    {
+      EGLDisplay egl_display = gdk_display_get_egl_display (child->display);
+      EGLContext context = eglGetCurrentContext ();
+      EGLSurface draw = eglGetCurrentSurface (EGL_DRAW);
+      EGLSurface read = eglGetCurrentSurface (EGL_READ);
+
+      if (eglMakeCurrent (egl_display, child->egl_surface, child->egl_surface, context))
+        {
+          eglSwapInterval (egl_display, 0);
+          glBindFramebuffer (GL_DRAW_FRAMEBUFFER, 0);
+          child_draw_to_back_buffer ();
+          glBindFramebuffer (GL_READ_FRAMEBUFFER, framebuffer);
+          glReadBuffer (GL_COLOR_ATTACHMENT0);
+          glDisable (GL_SCISSOR_TEST);
+          glBlitFramebuffer (0, 0, 2 * view_width, view_height,
+                             0, 0, 2 * view_width, view_height,
+                             GL_COLOR_BUFFER_BIT, GL_NEAREST);
+          result = eglSwapBuffers (egl_display, child->egl_surface);
+          eglMakeCurrent (egl_display, draw, read, context);
+        }
+      if (!result)
+        g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                     "The views could not be drawn on the window (EGL error 0x%x)", eglGetError ());
+    }
+  else
+    {
+      GLXContext context = glXGetCurrentContext ();
+      GLXDrawable draw = glXGetCurrentDrawable ();
+      GLXDrawable read = glXGetCurrentReadDrawable ();
+
+      if (glXMakeContextCurrent (child->xdisplay, child->glx_window, child->glx_window, context))
+        {
+          if (epoxy_has_glx_extension (child->xdisplay, DefaultScreen (child->xdisplay), "GLX_EXT_swap_control"))
+            glXSwapIntervalEXT (child->xdisplay, child->glx_window, 0);
+          glBindFramebuffer (GL_DRAW_FRAMEBUFFER, 0);
+          child_draw_to_back_buffer ();
+          glBindFramebuffer (GL_READ_FRAMEBUFFER, framebuffer);
+          glReadBuffer (GL_COLOR_ATTACHMENT0);
+          glDisable (GL_SCISSOR_TEST);
+          glBlitFramebuffer (0, 0, 2 * view_width, view_height,
+                             0, 0, 2 * view_width, view_height,
+                             GL_COLOR_BUFFER_BIT, GL_NEAREST);
+          glXSwapBuffers (child->xdisplay, child->glx_window);
+          glXMakeContextCurrent (child->xdisplay, draw, read, context);
+          result = TRUE;
+        }
+      else
+        g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                             "The views could not be drawn on the window (glXMakeContextCurrent failed)");
+    }
+
+  if (scissor)
+    glEnable (GL_SCISSOR_TEST);
+
+  if (gdk_x11_display_error_trap_pop (child->display) && result)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                           "The X server refused the OpenGL surface on the window");
+      result = FALSE;
+    }
+
+  if (!result)
+    {
+      /* the other route takes over, on a window with no surface of this one */
+      gdk_x11_display_error_trap_push (child->display);
+      if (child->egl_surface != EGL_NO_SURFACE)
+        eglDestroySurface (gdk_display_get_egl_display (child->display), child->egl_surface);
+      if (child->glx_window != None)
+        glXDestroyWindow (child->xdisplay, child->glx_window);
+      gdk_x11_display_error_trap_pop_ignored (child->display);
+      child->egl_surface = EGL_NO_SURFACE;
+      child->glx_window = None;
+    }
+
+  return result;
+}
