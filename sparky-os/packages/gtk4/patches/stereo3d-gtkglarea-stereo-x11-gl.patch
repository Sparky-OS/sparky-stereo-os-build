+#ifdef GDK_WINDOWING_X11
+/* Whether no parent that clips its children (a scrolled window's viewport, a
+ * widget with hidden overflow, the window itself) cuts the area */
+static gboolean
+gtk_gl_area_x11_unclipped (GtkGLArea *area)
+{
+  GtkWidget *widget = GTK_WIDGET (area);
+  GtkWidget *parent;
+
+  for (parent = gtk_widget_get_parent (widget); parent != NULL; parent = gtk_widget_get_parent (parent))
+    {
+      graphene_rect_t bounds;
+
+      if (gtk_widget_get_overflow (parent) != GTK_OVERFLOW_HIDDEN && !GTK_IS_NATIVE (parent))
+        continue;
+
+      if (!gtk_widget_compute_bounds (widget, parent, &bounds) ||
+          bounds.origin.x < -0.5 || bounds.origin.y < -0.5 ||
+          bounds.origin.x + bounds.size.width > gtk_widget_get_width (parent) + 0.5 ||
+          bounds.origin.y + bounds.size.height > gtk_widget_get_height (parent) + 0.5)
+        return FALSE;
+    }
+
+  return TRUE;
+}
+#endif
