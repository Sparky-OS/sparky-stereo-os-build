+/*
+ * The size of what one emission of the render signal draws: the area in
+ * device pixels, or, for the views of a stereo area, the size the program
+ * set for one view.
+ */
+static void
+gtk_gl_area_get_render_size (GtkGLArea *area,
+                             int       *width,
+                             int       *height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  GtkWidget *widget = GTK_WIDGET (area);
+  int scale = gtk_widget_get_scale_factor (widget);
+
+  if (priv->stereo_rendering && priv->stereo_view_width > 0 && priv->stereo_view_height > 0)
+    {
+      *width = priv->stereo_view_width;
+      *height = priv->stereo_view_height;
+    }
+  else
+    {
+      *width = gtk_widget_get_width (widget) * scale;
+      *height = gtk_widget_get_height (widget) * scale;
+    }
+}
