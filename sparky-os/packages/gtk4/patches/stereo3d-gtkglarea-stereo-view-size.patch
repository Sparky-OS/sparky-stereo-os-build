+/**
+ * gtk_gl_area_set_stereo_view_size:
+ * @area: a `GtkGLArea`
+ * @width: the width of one view in pixels, or -1
+ * @height: the height of one view in pixels, or -1
+ *
+ * Sets the size at which each view of a stereo area is rendered.
+ *
+ * By default, and when @width or @height is -1, each view has the size of
+ * the area in device pixels. A program whose picture has a resolution of its
+ * own (a video's views, a scene at a chosen render resolution) sets it here:
+ * [signal@Gtk.GLArea::render] then draws each view into a framebuffer of
+ * that size, [signal@Gtk.GLArea::resize] gives that size, and the compositor
+ * resizes the views once, to the place of the area. The area keeps its size
+ * and its place in the window.
+ *
+ * The size is used only while the area is shown per eye. An area that
+ * cannot be (see [property@Gtk.GLArea:stereo-error]) renders its left view
+ * alone at the size of the area, as an area without stereo does. In both
+ * cases the viewport is set to the size of the framebuffer before each
+ * emission of [signal@Gtk.GLArea::render] of an area that asks for stereo.
+ *
+ * Since: 4.24
+ */
+void
+gtk_gl_area_set_stereo_view_size (GtkGLArea *area,
+                                  int        width,
+                                  int        height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+  g_return_if_fail (width >= -1 && height >= -1);
+
+  if (width == 0)
+    width = -1;
+  if (height == 0)
+    height = -1;
+
+  if (priv->stereo_view_width == width && priv->stereo_view_height == height)
+    return;
+
+  g_object_freeze_notify (G_OBJECT (area));
+
+  if (priv->stereo_view_width != width)
+    {
+      priv->stereo_view_width = width;
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_VIEW_WIDTH]);
+    }
+  if (priv->stereo_view_height != height)
+    {
+      priv->stereo_view_height = height;
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_VIEW_HEIGHT]);
+    }
+
+  g_object_thaw_notify (G_OBJECT (area));
+
+  if (priv->stereo && gtk_widget_get_realized (GTK_WIDGET (area)))
+    {
+      priv->needs_resize = TRUE;
+      priv->needs_render = TRUE;
+      gtk_widget_queue_draw (GTK_WIDGET (area));
+    }
+}
+
+/**
+ * gtk_gl_area_get_stereo_view_size:
+ * @area: a `GtkGLArea`
+ * @width: (out) (optional): return location for the width of one view, or -1
+ * @height: (out) (optional): return location for the height of one view, or -1
+ *
+ * Gets the size set with [method@Gtk.GLArea.set_stereo_view_size].
+ *
+ * Since: 4.24
+ */
+void
+gtk_gl_area_get_stereo_view_size (GtkGLArea *area,
+                                  int       *width,
+                                  int       *height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+
+  if (width)
+    *width = priv->stereo_view_width;
+  if (height)
+    *height = priv->stereo_view_height;
+}
