Description: gtk-demo: the glarea demo in stereo, one camera for each eye
 The OpenGL Area demo gets a check button for the stereo property (GTK_DEMO_GLAREA_STEREO in the environment starts it on) and draws the triangle with the camera of the eye gtk_gl_area_get_current_eye() names, so the toolkit's own demo shows a GtkGLArea in 3D.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: other, Sparky Stereo OS
Forwarded: no
Last-Update: 2026-11-08
---
diff --git a/demos/gtk-demo/glarea.c b/demos/gtk-demo/glarea.c
index 089d2d5..dde98b9 100644
--- a/demos/gtk-demo/glarea.c
+++ b/demos/gtk-demo/glarea.c
@@ -22,6 +22,11 @@ enum {
 
 /* Rotation angles on each axis */
 static float rotation_angles[N_AXIS] = { 0.0 };
+static GtkWidget *stereo_label = NULL;
+
+/* Half the distance between the two cameras, and the distance of the triangle behind the screen, in clip space */
+#define EYE_SEPARATION 0.06f
+#define EYE_PLANE 1.0f
 
 /* The object we are drawing */
 static const GLfloat vertex_data[] = {
@@ -263,6 +268,21 @@ static void
 draw_triangle (void)
 {
   float mvp[16];
+  float eye = 0.f;
+
+  /* A stereo area draws the scene twice, once for each camera */
+  switch (gtk_gl_area_get_current_eye (GTK_GL_AREA (gl_area)))
+    {
+    case GTK_GL_AREA_EYE_LEFT:
+      eye = -EYE_SEPARATION;
+      break;
+    case GTK_GL_AREA_EYE_RIGHT:
+      eye = EYE_SEPARATION;
+      break;
+    case GTK_GL_AREA_EYE_NONE:
+    default:
+      break;
+    }
 
   /* Compute the model view projection matrix using the
    * rotation angles specified through the GtkRange widgets
@@ -272,6 +292,14 @@ draw_triangle (void)
                rotation_angles[Y_AXIS],
                rotation_angles[Z_AXIS]);
 
+  /* The camera of the eye is shifted sideways: what lies behind the plane of the
+   * screen moves with the shift, what lies in front of it against it. The triangle
+   * lies a little behind that plane, and turning it brings one side forward.
+   */
+  for (int i = 0; i < 4; i++)
+    mvp[4 * i] += eye * mvp[4 * i + 2];
+  mvp[12] += eye * EYE_PLANE;
+
   /* Use our shaders */
   glUseProgram (program);
 
@@ -314,6 +342,37 @@ render (GtkGLArea    *area,
   return TRUE;
 }
 
+static void
+update_stereo_label (GtkGLArea *area)
+{
+  const GError *error = gtk_gl_area_get_stereo_error (area);
+
+  if (!gtk_gl_area_get_stereo (area))
+    gtk_label_set_text (GTK_LABEL (stereo_label), "");
+  else if (error != NULL)
+    gtk_label_set_text (GTK_LABEL (stereo_label), error->message);
+  else if (gtk_gl_area_get_stereo_shown (area))
+    gtk_label_set_text (GTK_LABEL (stereo_label), "Shown in 3D");
+  else
+    gtk_label_set_text (GTK_LABEL (stereo_label), "Waiting for the first frame");
+}
+
+static void
+on_stereo_toggled (GtkCheckButton *check,
+                   gpointer        data)
+{
+  gtk_gl_area_set_stereo (GTK_GL_AREA (gl_area), gtk_check_button_get_active (check));
+  update_stereo_label (GTK_GL_AREA (gl_area));
+}
+
+static void
+on_stereo_state_changed (GtkGLArea *area,
+                         GParamSpec *pspec,
+                         gpointer    data)
+{
+  update_stereo_label (area);
+}
+
 static void
 on_axis_value_change (GtkAdjustment *adjustment,
                       gpointer       data)
@@ -385,7 +444,7 @@ close_window (GtkWidget *widget)
 static GtkWidget *
 create_glarea_window (GtkWidget *do_widget)
 {
-  GtkWidget *window, *box, *button, *controls;
+  GtkWidget *window, *box, *button, *controls, *stereo_check;
   int i;
 
   window = gtk_window_new ();
@@ -417,6 +476,18 @@ create_glarea_window (GtkWidget *do_widget)
   /* The main "draw" call for GtkGLArea */
   g_signal_connect (gl_area, "render", G_CALLBACK (render), NULL);
 
+  stereo_check = gtk_check_button_new_with_label ("Stereo (one view for each eye)");
+  stereo_label = gtk_label_new ("");
+  gtk_widget_set_halign (stereo_label, GTK_ALIGN_START);
+  gtk_label_set_wrap (GTK_LABEL (stereo_label), TRUE);
+  g_signal_connect (stereo_check, "toggled", G_CALLBACK (on_stereo_toggled), NULL);
+  g_signal_connect (gl_area, "notify::stereo-shown", G_CALLBACK (on_stereo_state_changed), NULL);
+  g_signal_connect (gl_area, "notify::stereo-error", G_CALLBACK (on_stereo_state_changed), NULL);
+  if (g_getenv ("GTK_DEMO_GLAREA_STEREO") != NULL)
+    gtk_check_button_set_active (GTK_CHECK_BUTTON (stereo_check), TRUE);
+  gtk_box_append (GTK_BOX (box), stereo_check);
+  gtk_box_append (GTK_BOX (box), stereo_label);
+
   controls = gtk_box_new (GTK_ORIENTATION_VERTICAL, FALSE);
   gtk_box_append (GTK_BOX (box), controls);
   gtk_widget_set_hexpand (controls, TRUE);
