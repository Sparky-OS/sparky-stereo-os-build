   if (!entry.fourcc)
     goto refuse_caps;
 
+  if (multiview_mode) {
+    GstVideoMultiviewMode mode = gst_video_multiview_mode_from_caps_string (multiview_mode);
+    guint flags = 0;
+    gint st3d_mode = -1;
+    gst_structure_get_flagset (structure, "multiview-flags", &flags, NULL);
+    /* st3d has no transform flags. Do not describe transformed views as a
+     * plain pair. Existing svmi remains available for other arrangements. */
+    if (!(flags & ~(GST_VIDEO_MULTIVIEW_FLAGS_RIGHT_VIEW_FIRST | GST_VIDEO_MULTIVIEW_FLAGS_HALF_ASPECT))) {
+      if (mode == GST_VIDEO_MULTIVIEW_MODE_MONO)
+        st3d_mode = 0;
+      else if (mode == GST_VIDEO_MULTIVIEW_MODE_SIDE_BY_SIDE)
+        st3d_mode = flags & GST_VIDEO_MULTIVIEW_FLAGS_RIGHT_VIEW_FIRST ? 4 : 2;
+      else if (mode == GST_VIDEO_MULTIVIEW_MODE_TOP_BOTTOM && !(flags & GST_VIDEO_MULTIVIEW_FLAGS_RIGHT_VIEW_FIRST))
+        st3d_mode = 1;
+    }
+    if (st3d_mode >= 0)
+      ext_atom_list = g_list_append (ext_atom_list, build_st3d_extension (st3d_mode));
+    else
+      GST_WARNING_OBJECT (qtmux, "st3d cannot represent multiview-mode %s with flags 0x%x", multiview_mode, flags);
+  }
