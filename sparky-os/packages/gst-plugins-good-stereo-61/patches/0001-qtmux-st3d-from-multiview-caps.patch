--- a/gst/isomp4/atoms.c
+++ b/gst/isomp4/atoms.c
@@ -5337,6 +5337,15 @@
       atom_esds_free);
 }
 
+/* Spherical Video V2: version/flags zero, then stereo_mode. */
+AtomInfo *
+build_st3d_extension (guint8 mode)
+{
+  const guint8 data[5] = { 0, 0, 0, 0, mode };
+  AtomData *atom = atom_data_new_from_data (GST_MAKE_FOURCC ('s', 't', '3', 'd'), data, sizeof (data));
+  return build_atom_info_wrapper ((Atom *) atom, atom_data_copy_data, atom_data_free);
+}
+
 AtomInfo *
 build_btrt_extension (guint32 buffer_size_db, guint32 avg_bitrate,
     guint32 max_bitrate)
