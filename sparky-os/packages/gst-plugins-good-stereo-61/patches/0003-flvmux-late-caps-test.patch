+typedef GstClockTime (*GetNextTimeFunc) (GstAggregator * aggregator);
+
+typedef struct
+{
+  GstElement *element;
+  GstAggregatorClass *klass;
+  GetNextTimeFunc original_get_next_time;
+  GstHarness *mux, *a_src, *v_src;
+  DemuxHarnesses sinks;
+  GMutex lock;
+  GCond cond;
+  gboolean waiting_for_video_caps;
+} VideoCapsLate;
+
+static VideoCapsLate *video_caps_late;
+
+static GstClockTime
+video_caps_late_get_next_time (GstAggregator * aggregator)
+{
+  VideoCapsLate *data = video_caps_late;
+  GstClockTime next_time = data->original_get_next_time (aggregator);
+  GstPad *audio =
+      gst_element_get_static_pad (GST_ELEMENT (aggregator), "audio");
+  GstPad *video =
+      gst_element_get_static_pad (GST_ELEMENT (aggregator), "video");
+
+  if (next_time == GST_CLOCK_TIME_NONE && audio && video &&
+      !gst_pad_has_current_caps (video) &&
+      gst_aggregator_pad_has_buffer (GST_AGGREGATOR_PAD (audio))) {
+    g_mutex_lock (&data->lock);
+    data->waiting_for_video_caps = TRUE;
+    g_cond_signal (&data->cond);
+    g_mutex_unlock (&data->lock);
+  }
+
+  gst_clear_object (&audio);
+  gst_clear_object (&video);
+  return next_time;
+}
+
+static void
+video_caps_late_teardown (void)
+{
+  VideoCapsLate *data = video_caps_late;
+
+  if (!data)
+    return;
+
+  /* Stop the worker before restoring the shared class, including on failure
+   * when Check runs without forking. Keep the element alive until restoration. */
+  if (data->element)
+    gst_element_set_state (data->element, GST_STATE_NULL);
+  if (data->a_src)
+    gst_harness_teardown (data->a_src);
+  if (data->v_src)
+    gst_harness_teardown (data->v_src);
+  if (data->mux)
+    gst_harness_teardown (data->mux);
+  if (data->sinks.a_sink)
+    gst_harness_teardown (data->sinks.a_sink);
+  if (data->sinks.v_sink)
+    gst_harness_teardown (data->sinks.v_sink);
+  if (data->klass)
+    data->klass->get_next_time = data->original_get_next_time;
+  gst_clear_object (&data->element);
+  g_cond_clear (&data->cond);
+  g_mutex_clear (&data->lock);
+  g_clear_pointer (&video_caps_late, g_free);
+}
+
+static void
+video_caps_late_push_to_sink (GstHarness * mux, GstHarness * demux)
+{
+  GstBuffer *buffer = gst_harness_pull (mux);
+
+  fail_unless (buffer != NULL, "Muxer did not produce the expected output");
+  fail_unless_equals_int (gst_harness_push (demux, buffer), GST_FLOW_OK);
+}
