# Built with Qt 6 as upstream's own Arch package does (-DBUILD_WITH_QT6=ON). The tests need a systemd user session on a
# session bus, so the package build leaves them out.
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_WITH_QT6=ON -DBUILD_TESTING=OFF
