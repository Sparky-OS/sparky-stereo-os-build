+class TestPlasmaDepth : public QObject
+{
+    Q_OBJECT
+
+    QTemporaryDir m_configHome;
+    PlatformPlugin *m_plugin = nullptr;
+
+    void writeLimits(std::optional<qreal> sunk, std::optional<qreal> popped)
+    {
+        auto config = KSharedConfig::openConfig(u"kwinrc"_s);
+        KConfigGroup group(config, u"StereoDepth"_s);
+        if (sunk) {
+            group.writeEntry("SunkLimit", sunk.value(), KConfig::Notify);
+        }
+        if (popped) {
+            group.writeEntry("PoppedLimit", popped.value(), KConfig::Notify);
+        }
+        config->sync();
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QVERIFY(m_configHome.isValid());
+        qputenv("XDG_CONFIG_HOME", m_configHome.path().toUtf8());
+        qRegisterMetaType<QWindow *>();
+    }
+
+    void testDefaults()
+    {
+        // Without settings the limits are Stereo KWin's defaults (kwin.kcfg, StereoDepth).
+        QPluginLoader loader(QCoreApplication::applicationDirPath() + u"/union/union-platform-plasma.so"_s);
+        auto instance = loader.instance();
+        QVERIFY2(instance, qPrintable(loader.errorString()));
+        QCOMPARE(instance->metaObject()->className(), "PlasmaPlatformPlugin");
+        // As PluginRegistry does: platform plugins do not declare Q_INTERFACES.
+        m_plugin = static_cast<PlatformPlugin *>(instance);
+
+        QCOMPARE(m_plugin->depthLimits(), (Depth::Limits{.sunk = 10.0, .popped = 4.0}));
+
+        // Nothing tells a window it may show depth yet, so every window is drawn as on a 2D output.
+        QWindow window;
+        QVERIFY(!m_plugin->depthEnabled(&window));
+    }
+
+    void testUserLimits()
+    {
+        QVERIFY(m_plugin);
+
+        // The user's limits from System Settings' 3D Depth page.
+        QSignalSpy spy(m_plugin, &PlatformPlugin::depthChanged);
+        writeLimits(16.0, 6.0);
+        QTRY_COMPARE(m_plugin->depthLimits(), (Depth::Limits{.sunk = 16.0, .popped = 6.0}));
+        QVERIFY(spy.count() >= 1);
+        QVERIFY(spy.last().at(0).isValid());
+        QCOMPARE(spy.last().at(0).value<QWindow *>(), nullptr);
+
+        // Both at zero switch depth off.
+        writeLimits(0.0, 0.0);
+        QTRY_COMPARE(m_plugin->depthLimits(), (Depth::Limits{.sunk = 0.0, .popped = 0.0}));
+        QVERIFY(!m_plugin->depthLimits().isEnabled());
+
+        // Below zero is not a limit.
+        writeLimits(-5.0, 3.0);
+        QTRY_COMPARE(m_plugin->depthLimits(), (Depth::Limits{.sunk = 0.0, .popped = 3.0}));
+    }
+};
+
+QTEST_MAIN(TestPlasmaDepth)
+
+#include "TestPlasmaDepth.moc"
