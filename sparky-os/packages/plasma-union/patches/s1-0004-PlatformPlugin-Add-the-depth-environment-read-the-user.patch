+Union::Depth::Limits PlasmaPlatformPlugin::depthLimits()
+{
+    return m_depthLimits;
+}
+
+void PlasmaPlatformPlugin::readDepthLimits()
+{
+    m_kwinWatcher->config()->reparseConfiguration();
+
+    const KConfigGroup group(m_kwinWatcher->config(), DepthGroup);
+    const Union::Depth::Limits limits{
+        .sunk = std::max(0.0, group.readEntry(u"SunkLimit"_s, DefaultSunkLimit)),
+        .popped = std::max(0.0, group.readEntry(u"PoppedLimit"_s, DefaultPoppedLimit)),
+    };
+
+    if (limits == m_depthLimits) {
+        return;
+    }
+
+    m_depthLimits = limits;
+    sendDepthChangedEvent(nullptr);
+}
