+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#pragma once
+
+#include <functional>
+
+#include <QHash>
+#include <QObject>
+
+class QWindow;
+struct wl_surface;
+struct stereo_depth_state;
+
+/*
+ * What Stereo KWin tells each window about depth, through libstereo-declare:
+ * whether the elements inside it may be shown in depth now (the window is on a
+ * stereo output and awake, not lying flat behind the active one) and which of
+ * its edges lie on the output's edge. Only on Wayland; elsewhere no window is
+ * awake.
+ */
+class PlasmaDepthExchange : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit PlasmaDepthExchange(std::function<void(QWindow *)> changed, QObject *parent = nullptr);
+    ~PlasmaDepthExchange() override;
+
+    bool isAwake(QWindow *window);
+    Qt::Edges outputEdges(QWindow *window);
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    struct State {
+        wl_surface *surface = nullptr;
+        bool awake = false;
+        Qt::Edges edges;
+    };
+
+    State *follow(QWindow *window);
+    void watch(QWindow *window, State &state);
+    void unwatch(QWindow *window, State &state);
+    static void handleState(void *data, wl_surface *surface, const stereo_depth_state *state);
+
+    std::function<void(QWindow *)> m_changed;
+    QHash<QWindow *, State> m_windows;
+    bool m_initialized = false;
+};
