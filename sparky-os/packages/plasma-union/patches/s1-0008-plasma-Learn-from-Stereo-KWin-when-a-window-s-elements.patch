+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "PlasmaDepthExchange.h"
+
+#include <cerrno>
+
+#include <QGuiApplication>
+#include <QPlatformSurfaceEvent>
+#include <QWindow>
+#include <qpa/qplatformnativeinterface.h>
+
+#include <stereo-declare.h>
+
+PlasmaDepthExchange::PlasmaDepthExchange(std::function<void(QWindow *)> changed, QObject *parent)
+    : QObject(parent)
+    , m_changed(std::move(changed))
+{
+    auto wayland = qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+    if (!wayland || !wayland->display()) {
+        return;
+    }
+
+    // The library binds its globals on Qt's own queue; the edition's Qt may have
+    // started it on this thread already for its stereo windows.
+    const int result = stereo_declare_wayland_init(wayland->display(), nullptr);
+    m_initialized = result == 0 || result == -EBUSY;
+}
+
+PlasmaDepthExchange::~PlasmaDepthExchange()
+{
+    for (auto itr = m_windows.begin(); itr != m_windows.end(); ++itr) {
+        unwatch(itr.key(), itr.value());
+    }
+}
+
+bool PlasmaDepthExchange::isAwake(QWindow *window)
+{
+    auto state = follow(window);
+    return state && state->awake;
+}
+
+Qt::Edges PlasmaDepthExchange::outputEdges(QWindow *window)
+{
+    auto state = follow(window);
+    return state ? state->edges : Qt::Edges{};
+}
+
+PlasmaDepthExchange::State *PlasmaDepthExchange::follow(QWindow *window)
+{
+    if (!m_initialized || !window) {
+        return nullptr;
+    }
+
+    auto itr = m_windows.find(window);
+    if (itr == m_windows.end()) {
+        itr = m_windows.insert(window, State{});
+        window->installEventFilter(this);
+        connect(window, &QObject::destroyed, this, [this, window]() {
+            m_windows.remove(window);
+        });
+    }
+
+    if (!itr->surface) {
+        watch(window, itr.value());
+    }
+    return &itr.value();
+}
+
+void PlasmaDepthExchange::watch(QWindow *window, State &state)
+{
+    auto native = QGuiApplication::platformNativeInterface();
+    auto surface = native ? static_cast<wl_surface *>(native->nativeResourceForWindow("surface", window)) : nullptr;
+    if (!surface || stereo_depth_wayland_watch(surface, &PlasmaDepthExchange::handleState, this) != 0) {
+        return;
+    }
+    state.surface = surface;
+}
+
+void PlasmaDepthExchange::unwatch(QWindow *window, State &state)
+{
+    if (state.surface) {
+        stereo_depth_wayland_unwatch(state.surface);
+        state.surface = nullptr;
+    }
+
+    if (state.awake) {
+        state.awake = false;
+        m_changed(window);
+    }
+}
+
+bool PlasmaDepthExchange::eventFilter(QObject *watched, QEvent *event)
+{
+    auto window = qobject_cast<QWindow *>(watched);
+    auto itr = window ? m_windows.find(window) : m_windows.end();
+    if (itr != m_windows.end()) {
+        if (event->type() == QEvent::PlatformSurface
+            && static_cast<QPlatformSurfaceEvent *>(event)->surfaceEventType() == QPlatformSurfaceEvent::SurfaceAboutToBeDestroyed) {
+            unwatch(window, itr.value());
+        } else if (event->type() == QEvent::Expose && !itr->surface) {
+            // The surface exists once the window is shown.
+            watch(window, itr.value());
+        }
+    }
+
+    return QObject::eventFilter(watched, event);
+}
+
+void PlasmaDepthExchange::handleState(void *data, wl_surface *surface, const stereo_depth_state *state)
+{
+    auto self = static_cast<PlasmaDepthExchange *>(data);
+    for (auto itr = self->m_windows.begin(); itr != self->m_windows.end(); ++itr) {
+        if (itr->surface != surface) {
+            continue;
+        }
+
+        Qt::Edges edges;
+        edges.setFlag(Qt::LeftEdge, state->output_edges & STEREO_DEPTH_EDGE_LEFT);
+        edges.setFlag(Qt::TopEdge, state->output_edges & STEREO_DEPTH_EDGE_TOP);
+        edges.setFlag(Qt::RightEdge, state->output_edges & STEREO_DEPTH_EDGE_RIGHT);
+        edges.setFlag(Qt::BottomEdge, state->output_edges & STEREO_DEPTH_EDGE_BOTTOM);
+
+        const bool awake = state->awake != 0;
+        if (awake != itr->awake || edges != itr->edges) {
+            itr->awake = awake;
+            itr->edges = edges;
+            self->m_changed(itr.key());
+        }
+        return;
+    }
+}
+
+#include "moc_PlasmaDepthExchange.cpp"
