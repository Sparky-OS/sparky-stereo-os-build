+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include <QtTest>
+
+#include <QApplication>
+#include <QFrame>
+#include <QPainter>
+#include <QPluginLoader>
+#include <QPushButton>
+#include <QStylePlugin>
+#include <QTabBar>
+#include <QWindow>
+
+#include <Depth.h>
+
+using namespace Union;
+using namespace Qt::StringLiterals;
+
+// Limits large enough to measure, in pixels of a view 1920 wide.
+static constexpr qreal SunkLimit = 40.0;
+static constexpr qreal PoppedLimit = 20.0;
+
+class TestWidgetsDepth : public QObject
+{
+    Q_OBJECT
+
+    std::unique_ptr<QWidget> m_window;
+    QPushButton *m_raised = nullptr;
+    QPushButton *m_checked = nullptr;
+    QPushButton *m_flat = nullptr;
+    QFrame *m_frame = nullptr;
+    QPushButton *m_onFrame = nullptr;
+    QTabBar *m_tabs = nullptr;
+
+    int viewWidth() const
+    {
+        auto screen = m_window->windowHandle()->screen();
+        return qRound(screen->geometry().width() * screen->devicePixelRatio());
+    }
+
+    int parallax(qreal depth) const
+    {
+        return Depth::parallax(depth, Depth::Limits{.sunk = SunkLimit, .popped = PoppedLimit}, viewWidth());
+    }
+
+    // What the engine that draws a window once per eye does with the style's
+    // parallax: each widget is drawn moved by its own eye shift, and a widget
+    // behind the widget it lies on is cut to its own rectangle.
+    static void drawWidget(QWidget *widget, QPainter &painter, QPoint origin, Depth::Eye eye, int parentParallax)
+    {
+        const int parallax = widget->property(Depth::ParallaxProperty).toInt();
+        painter.save();
+        if (eye != Depth::Eye::None && parallax < parentParallax) {
+            painter.setClipRect(QRect(origin, widget->size()), Qt::IntersectClip);
+        }
+        widget->render(&painter, origin + QPoint(Depth::eyeShift(parallax, eye), 0), QRegion{}, QWidget::DrawWindowBackground);
+        painter.restore();
+
+        const auto children = widget->children();
+        for (auto child : children) {
+            auto childWidget = qobject_cast<QWidget *>(child);
+            if (childWidget && childWidget->isVisible() && !childWidget->isWindow()) {
+                drawWidget(childWidget, painter, origin + childWidget->pos(), eye, parallax);
+            }
+        }
+    }
+
+    QImage draw(Depth::Eye eye)
+    {
+        m_window->windowHandle()->setProperty(Depth::EyeProperty, int(eye));
+        QImage image(m_window->size(), QImage::Format_RGB32);
+        image.fill(Qt::white);
+        QPainter painter(&image);
+        drawWidget(m_window.get(), painter, QPoint{}, eye, 0);
+        painter.end();
+        m_window->windowHandle()->setProperty(Depth::EyeProperty, int(Depth::Eye::None));
+        return image;
+    }
+
+    static QRect rectInWindow(QWidget *widget)
+    {
+        return QRect(widget->mapTo(widget->window(), QPoint{}), widget->size());
+    }
+
+    // The horizontal shift that makes the picture of `area` in `reference` appear
+    // in `image`, or INT_MIN when no shift within `range` matches it exactly.
+    static int shiftOf(const QImage &reference, const QImage &image, const QRect &area, int range)
+    {
+        for (int distance = 0; distance <= range; ++distance) {
+            for (int dx : {distance, -distance}) {
+                bool same = true;
+                for (int y = area.top(); same && y <= area.bottom(); ++y) {
+                    for (int x = area.left(); x <= area.right(); ++x) {
+                        if (reference.pixel(x, y) != image.pixel(x + dx, y)) {
+                            same = false;
+                            break;
+                        }
+                    }
+                }
+                if (same) {
+                    return dx;
+                }
+            }
+        }
+        return std::numeric_limits<int>::min();
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        qputenv("UNION_FORCE_PLATFORM", "depthtest");
+        qputenv("UNION_TEST_STYLE_PATH", QFINDTESTDATA("../../DepthTestData").toUtf8());
+        qputenv("UNION_TEST_DEPTH_LIMITS", QByteArray(QByteArray::number(SunkLimit) + "," + QByteArray::number(PoppedLimit)));
+
+        QPluginLoader loader(QCoreApplication::applicationDirPath() + u"/UnionWidgetsStyle.so"_s);
+        auto plugin = qobject_cast<QStylePlugin *>(loader.instance());
+        QVERIFY2(plugin, qPrintable(loader.errorString()));
+        QApplication::setStyle(plugin->create(u"Union"_s));
+
+        m_window = std::make_unique<QWidget>();
+        m_window->resize(640, 260);
+
+        m_raised = new QPushButton(u"Raised"_s, m_window.get());
+        m_raised->setGeometry(30, 30, 120, 48);
+        m_checked = new QPushButton(u"Checked"_s, m_window.get());
+        m_checked->setCheckable(true);
+        m_checked->setChecked(true);
+        m_checked->setGeometry(190, 30, 120, 48);
+        m_flat = new QPushButton(u"Flat"_s, m_window.get());
+        m_flat->setFlat(true);
+        m_flat->setGeometry(350, 30, 120, 48);
+
+        m_frame = new QFrame(m_window.get());
+        m_frame->setFrameShape(QFrame::StyledPanel);
+        m_frame->setGeometry(30, 130, 300, 110);
+        m_onFrame = new QPushButton(u"On frame"_s, m_frame);
+        m_onFrame->setGeometry(20, 12, 120, 48);
+
+        m_tabs = new QTabBar(m_window.get());
+        m_tabs->addTab(u"One"_s);
+        m_tabs->addTab(u"Two"_s);
+        m_tabs->setCurrentIndex(1);
+        m_tabs->setGeometry(380, 150, 240, 40);
+
+        m_window->show();
+        QVERIFY(QTest::qWaitForWindowExposed(m_window.get()));
+
+        // The depths are recorded while the widgets are drawn.
+        m_window->grab();
+        QCoreApplication::processEvents();
+    }
+
+    void testParallax()
+    {
+        // From the style: a shadow raises one step, a declared sunk sinks to the limit, a flat
+        // button lies on the window, the frame declares 50% and the button on it stands on it.
+        QTRY_COMPARE(m_raised->property(Depth::ParallaxProperty).toInt(), parallax(0.5));
+        QCOMPARE(m_checked->property(Depth::ParallaxProperty).toInt(), parallax(-1.0));
+        QCOMPARE(m_flat->property(Depth::ParallaxProperty).toInt(), 0);
+        QCOMPARE(m_frame->property(Depth::ParallaxProperty).toInt(), parallax(0.5));
+        QCOMPARE(m_onFrame->property(Depth::ParallaxProperty).toInt(), parallax(1.0));
+        QCOMPARE(m_tabs->property(Depth::ParallaxProperty).toInt(), 0);
+    }
+
+    void testFlatPictureIsUnchanged()
+    {
+        const auto before = m_window->grab().toImage();
+        draw(Depth::Eye::Left);
+        draw(Depth::Eye::Right);
+        const auto after = m_window->grab().toImage();
+        QCOMPARE(after, before);
+    }
+
+    void testEyes_data()
+    {
+        QTest::addColumn<QString>("name");
+        QTest::addColumn<qreal>("depth");
+
+        QTest::addRow("raised") << u"raised"_s << 0.5;
+        QTest::addRow("sunk") << u"checked"_s << -1.0;
+        QTest::addRow("flat") << u"flat"_s << 0.0;
+        QTest::addRow("on a raised frame") << u"onFrame"_s << 1.0;
+    }
+
+    void testEyes()
+    {
+        QFETCH(QString, name);
+        QFETCH(qreal, depth);
+
+        QWidget *widget = name == u"raised" ? m_raised : name == u"checked" ? m_checked : name == u"flat" ? m_flat : m_onFrame;
+
+        const auto flat = draw(Depth::Eye::None);
+        const auto left = draw(Depth::Eye::Left);
+        const auto right = draw(Depth::Eye::Right);
+
+        if (const auto directory = qEnvironmentVariable("UNION_TEST_SAVE_IMAGES"); !directory.isEmpty() && name == u"raised") {
+            flat.save(directory + u"/widgets-flat.png"_s);
+            QImage pair(left.width() * 2, left.height(), QImage::Format_RGB32);
+            QPainter painter(&pair);
+            painter.drawImage(0, 0, left);
+            painter.drawImage(left.width(), 0, right);
+            painter.end();
+            pair.save(directory + u"/widgets-full-sbs.png"_s);
+        }
+
+        // The label, inside the widget: the widget moves as a whole, its text with it.
+        const auto label = rectInWindow(widget).adjusted(30, 10, -30, -10);
+        const int leftShift = shiftOf(flat, left, label, 40);
+        const int rightShift = shiftOf(flat, right, label, 40);
+
+        QCOMPARE(leftShift, Depth::eyeShift(parallax(depth), Depth::Eye::Left));
+        QCOMPARE(rightShift, Depth::eyeShift(parallax(depth), Depth::Eye::Right));
+        QCOMPARE(leftShift - rightShift, parallax(depth));
+    }
+
+    void testSelectedTabSinksWithinTheTabBar()
+    {
+        // The current tab is a part of the tab bar: the style moves it, cut to its own rectangle.
+        const auto flat = draw(Depth::Eye::None);
+        const auto tab = m_tabs->tabRect(1).translated(rectInWindow(m_tabs).topLeft());
+        const auto other = m_tabs->tabRect(0).translated(rectInWindow(m_tabs).topLeft());
+
+        for (auto eye : {Depth::Eye::Left, Depth::Eye::Right}) {
+            const auto image = draw(eye);
+            const int expected = Depth::eyeShift(parallax(-1.0), eye);
+            QCOMPARE(shiftOf(flat, image, tab.adjusted(28, 8, -28, -8), 40), expected);
+
+            // The tab that is not selected stays, and nothing of the sunk tab is drawn beside it.
+            QCOMPARE(shiftOf(flat, image, other, 40), 0);
+            for (int y = tab.top(); y <= tab.bottom(); ++y) {
+                for (int x = tab.right() + 1; x <= std::min(tab.right() + std::abs(expected), flat.width() - 1); ++x) {
+                    QCOMPARE(image.pixel(x, y), flat.pixel(x, y));
+                }
+            }
+        }
+    }
+};
+
+QTEST_MAIN(TestWidgetsDepth)
+
+#include "TestWidgetsDepth.moc"
