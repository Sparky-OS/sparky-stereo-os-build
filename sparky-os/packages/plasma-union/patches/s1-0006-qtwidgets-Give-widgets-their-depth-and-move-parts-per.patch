@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "WidgetDepth.h"
+
+#include <QScreen>
+#include <QWidget>
+#include <QWindow>
+
+#include <PlatformPlugin.h>
+#include <StyleRegistry.h>
+
+#include "StyleUtils.h"
+#include "elements/AbstractElement.h"
+
+using namespace Union;
+
+// Whether the element is the widget's own, rather than one of its parts: its
+// element hierarchy is the widget's.
+static bool isOwnElement(const QWidget *widget, const AbstractElement *element)
+{
+    const auto types = widget->property(property_union_member_list).toStringList();
+    const auto &elements = element->elementList();
+    return !types.isEmpty() && elements.size() == types.size() && elements.last()->type() == types.last();
+}
+
+WidgetDepth::WidgetDepth(QObject *parent)
+    : QObject(parent)
+{
+    StyleRegistry::instance()->platform()->installEventFilter(this);
+}
+
+WidgetDepth::~WidgetDepth() = default;
+
+void WidgetDepth::elementDrawn(const QWidget *widget, const AbstractElement *element)
+{
+    if (!widget || !element || !isOwnElement(widget, element)) {
+        return;
+    }
+
+    auto window = windowFor(widget);
+    if (!window || !window->enabled) {
+        return;
+    }
+
+    // The widget stands on the nearest widget around it that has a depth; the
+    // top of a window lies at the window, where the window sits is the compositor's.
+    const QWidget *parent = nullptr;
+    if (!widget->isWindow()) {
+        for (auto ancestor = widget->parentWidget(); ancestor; ancestor = ancestor->isWindow() ? nullptr : ancestor->parentWidget()) {
+            if (window->tree.contains(ancestor)) {
+                parent = ancestor;
+                break;
+            }
+        }
+    }
+    const qreal depth = widget->isWindow() ? Depth::Screen : Depth::elementDepth(element->elementProperties());
+
+    if (!m_widgetWindows.contains(widget)) {
+        m_widgetWindows.insert(widget, widget->window());
+        const_cast<QWidget *>(widget)->installEventFilter(this);
+        connect(widget, &QObject::destroyed, this, [this, widget]() {
+            removeWidget(widget);
+        });
+    }
+
+    window->tree.setElement(widget, parent, depth);
+    applyChanges(*window);
+}
+
+std::optional<WidgetDepth::PartShift> WidgetDepth::partShift(const QWidget *widget, const AbstractElement *element) const
+{
+    if (!widget || !element) {
+        return std::nullopt;
+    }
+
+    auto window = windowFor(widget);
+    if (!window || !window->enabled || !window->handle) {
+        return std::nullopt;
+    }
+
+    const auto eye = Depth::Eye(window->handle->property(Depth::EyeProperty).toInt());
+    if (eye == Depth::Eye::None || isOwnElement(widget, element)) {
+        return std::nullopt;
+    }
+
+    const qreal relativeDepth = Depth::elementDepth(element->elementProperties());
+    if (relativeDepth == Depth::Screen) {
+        return std::nullopt;
+    }
+
+    const auto limits = StyleRegistry::instance()->platform()->depthLimits();
+    const qreal widgetDepth = window->tree.depth(widget);
+    const qreal partDepth = std::clamp(widgetDepth + relativeDepth, Depth::Sunk, Depth::Popped);
+
+    const int shift = Depth::eyeShift(Depth::parallax(partDepth, limits, window->viewWidth), eye);
+    const int widgetShift = Depth::eyeShift(Depth::parallax(widgetDepth, limits, window->viewWidth), eye);
+    if (shift == widgetShift) {
+        return std::nullopt;
+    }
+
+    return PartShift{.shift = (shift - widgetShift) / window->devicePixelRatio, .clip = partDepth < widgetDepth};
+}
+
+bool WidgetDepth::eventFilter(QObject *watched, QEvent *event)
+{
+    if (event->type() == DepthChangedEvent::s_type) {
+        auto depthEvent = static_cast<DepthChangedEvent *>(event);
+        for (auto &window : m_windows) {
+            if (!depthEvent->window || depthEvent->window == window->handle) {
+                refresh(*window);
+            }
+        }
+    } else if (event->type() == QEvent::Hide && watched->isWidgetType()) {
+        // What is not shown takes no place.
+        auto widget = static_cast<QWidget *>(watched);
+        if (auto window = m_windows.value(m_widgetWindows.value(widget))) {
+            widget->setProperty(Depth::ParallaxProperty, QVariant{});
+            window->tree.removeElement(widget);
+            applyChanges(*window);
+        }
+    }
+
+    return QObject::eventFilter(watched, event);
+}
+
+WidgetDepth::Window *WidgetDepth::windowFor(const QWidget *widget) const
+{
+    const auto topLevel = widget->window();
+
+    auto window = m_windows.value(topLevel);
+    if (!window) {
+        window = std::make_shared<Window>();
+        m_windows.insert(topLevel, window);
+        connect(topLevel, &QObject::destroyed, this, [this, topLevel]() {
+            m_windows.remove(topLevel);
+        });
+    }
+
+    // The native window may be created after the first paint.
+    if (!window->handle && topLevel->windowHandle()) {
+        window->handle = topLevel->windowHandle();
+        connect(window->handle, &QWindow::screenChanged, this, [this, topLevel]() {
+            if (auto window = m_windows.value(topLevel)) {
+                refresh(*window);
+            }
+        });
+        refresh(*window);
+    }
+
+    return window.get();
+}
+
+void WidgetDepth::refresh(Window &window) const
+{
+    const bool wasEnabled = window.enabled;
+
+    auto platform = StyleRegistry::instance()->platform();
+    window.enabled = window.handle && platform->depthEnabled(window.handle) && platform->depthLimits().isEnabled();
+    if (window.handle) {
+        auto screen = window.handle->screen();
+        window.viewWidth = screen ? qRound(screen->geometry().width() * screen->devicePixelRatio()) : 0;
+        window.devicePixelRatio = std::max(window.handle->devicePixelRatio(), 1e-3);
+    }
+    window.enabled = window.enabled && window.viewWidth > 0;
+
+    // Every widget of the window looks at its depth again when it is drawn next.
+    for (auto itr = m_widgetWindows.cbegin(); itr != m_widgetWindows.cend(); ++itr) {
+        if (m_windows.value(itr.value()).get() != &window) {
+            continue;
+        }
+        auto widget = const_cast<QWidget *>(itr.key());
+        if (!window.enabled) {
+            widget->setProperty(Depth::ParallaxProperty, QVariant{});
+        }
+        widget->update();
+    }
+
+    if (!window.enabled) {
+        for (auto itr = m_widgetWindows.cbegin(); itr != m_widgetWindows.cend(); ++itr) {
+            window.tree.removeElement(itr.key());
+        }
+        window.tree.takeChanges();
+    } else if (!wasEnabled) {
+        for (auto itr = m_windows.cbegin(); itr != m_windows.cend(); ++itr) {
+            if (itr.value().get() == &window) {
+                const auto widgets = itr.key()->findChildren<QWidget *>();
+                for (auto widget : widgets) {
+                    widget->update();
+                }
+                const_cast<QWidget *>(itr.key())->update();
+            }
+        }
+    }
+}
+
+void WidgetDepth::applyChanges(Window &window) const
+{
+    const auto limits = StyleRegistry::instance()->platform()->depthLimits();
+    const auto changes = window.tree.takeChanges();
+    for (auto key : changes) {
+        auto widget = static_cast<const QWidget *>(key);
+        if (!m_widgetWindows.contains(widget) || !window.tree.contains(widget)) {
+            continue;
+        }
+
+        auto mutableWidget = const_cast<QWidget *>(widget);
+        mutableWidget->setProperty(Depth::ParallaxProperty, Depth::parallax(window.tree.depth(widget), limits, window.viewWidth));
+        mutableWidget->update();
+    }
+}
+
+void WidgetDepth::removeWidget(const QWidget *widget) const
+{
+    const auto topLevel = m_widgetWindows.take(widget);
+    if (auto window = m_windows.value(topLevel)) {
+        window->tree.removeElement(widget);
+        applyChanges(*window);
+    }
+}
+
+#include "moc_WidgetDepth.cpp"
