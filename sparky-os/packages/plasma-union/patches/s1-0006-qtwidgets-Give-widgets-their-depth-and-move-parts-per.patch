+
+#include <memory>
+#include <optional>
+
+#include <QHash>
+#include <QObject>
+#include <QPointer>
+
+#include <Depth.h>
+
+class AbstractElement;
+class QWidget;
+class QWindow;
+
+/*
+ * The depth of widgets on stereo outputs.
+ *
+ * When the style draws a widget's own element, that element gives the widget
+ * its depth, relative to the nearest widget around it that has one, in a
+ * DepthTree per window. The widget then carries its parallax as
+ * Depth::ParallaxProperty, for whoever draws the window once per eye to move
+ * the whole widget, its text included.
+ *
+ * Parts drawn inside one widget, such as a tab of a tab bar, are moved by the
+ * style itself while an eye is drawn, which the window's Depth::EyeProperty
+ * says. A part behind its widget is cut to its own rectangle.
+ *
+ * In a window that shows no depth nothing is recorded and nothing moves.
+ */
+class WidgetDepth : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit WidgetDepth(QObject *parent = nullptr);
+    ~WidgetDepth() override;
+
+    struct PartShift {
+        qreal shift = 0.0;
+        bool clip = false;
+    };
+
+    /*
+     * Called when the style drew \a element for \a widget.
+     */
+    void elementDrawn(const QWidget *widget, const AbstractElement *element);
+
+    /*
+     * How far the style moves \a element, a part of \a widget, in the eye being
+     * drawn, in logical pixels; nothing when it does not move.
+     */
+    std::optional<PartShift> partShift(const QWidget *widget, const AbstractElement *element) const;
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    struct Window {
+        QPointer<QWindow> handle;
+        Union::DepthTree tree;
+        bool enabled = false;
+        int viewWidth = 0;
+        qreal devicePixelRatio = 1.0;
+    };
+
+    Window *windowFor(const QWidget *widget) const;
+    void refresh(Window &window) const;
+    void applyChanges(Window &window) const;
+    void removeWidget(const QWidget *widget) const;
+
+    mutable QHash<const QWidget *, std::shared_ptr<Window>> m_windows;
+    mutable QHash<const QWidget *, const QWidget *> m_widgetWindows;
+};
