+void UnionStyle::drawElement(const AbstractElement *element, QPainter *painter, DrawEnums enums, const QStyleOption *option, const QWidget *widget) const
+{
+    m_depth->elementDrawn(widget, element);
+
+    // A part of a widget at another depth than the widget, drawn for one eye.
+    const auto part = m_depth->partShift(widget, element);
+    if (!part) {
+        element->draw(painter, enums);
+        return;
+    }
+
+    painter->save();
+    if (part->clip) {
+        painter->setClipRect(option->rect, Qt::IntersectClip);
+    }
+    painter->translate(part->shift, 0.0);
+    element->draw(painter, enums);
+    painter->restore();
+}
