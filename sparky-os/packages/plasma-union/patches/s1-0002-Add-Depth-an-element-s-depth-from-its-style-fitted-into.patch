+#pragma once
+
+#include <chrono>
+#include <memory>
+#include <optional>
+
+#include <QList>
+#include <QtGlobal>
+
+#include "union_export.h"
+
+namespace Union
+{
+
+namespace Properties
+{
+class StylePropertyGroup;
+class ShadowPropertyGroup;
+}
+
+/*!
+ * \namespace Union::Depth
+ * \inmodule core
+ * \ingroup core-namespaces
+ *
+ * \brief Where elements are shown in depth on a stereo output.
+ *
+ * A depth is a fraction of the user's range: -1.0 is the sunk limit, behind the
+ * screen, 0.0 the screen and 1.0 the popped limit, in front of it. Anything in
+ * between is valid, nothing beyond. The limits are the user's settings, in
+ * pixels of a view 1920 pixels wide, the unit Stereo KWin uses for them.
+ *
+ * An element's depth is relative to what it lies on, and moves the whole
+ * element: its background, border, text and icon. It never changes the layout,
+ * and a 2D output shows the element exactly as it is without depth.
+ */
+namespace Depth
+{
+/*!
+ * The sunk limit.
+ */
+inline constexpr qreal Sunk = -1.0;
+/*!
+ * The plane of what an element lies on.
+ */
+inline constexpr qreal Screen = 0.0;
+/*!
+ * The popped limit.
+ */
+inline constexpr qreal Popped = 1.0;
+/*!
+ * The depth an outer shadow gives an element that declares none: one step,
+ * half of the popped limit.
+ */
+inline constexpr qreal OuterShadow = 0.5;
+/*!
+ * The depth an inset shadow gives an element that declares none: sunk.
+ */
+inline constexpr qreal InsetShadow = Sunk;
+
+/*!
+ * The name of the dynamic property of a QWindow that says which eye is being
+ * drawn, as an int with the values of Eye. Whoever draws a window once per eye
+ * sets it before drawing each eye and resets it to Eye::None afterwards.
+ */
+inline constexpr char EyeProperty[] = "_q_stereo_eye";
+/*!
+ * The name of the dynamic property of an item or a widget that holds its
+ * parallax on its surface, an int in device pixels, positive when it is nearer
+ * than the screen. It is only set while the surface shows depth.
+ */
+inline constexpr char ParallaxProperty[] = "_q_stereo_parallax";
+
+/*!
+ * \enum Union::Depth::Eye
+ *
+ * The eye a picture is drawn for.
+ *
+ * \value None
+ *      A single picture, for both eyes or a 2D output.
+ * \value Left
+ *      The left eye's picture.
+ * \value Right
+ *      The right eye's picture.
+ */
+enum class Eye {
+    None = 0,
+    Left = 1,
+    Right = 2,
+};
+
+/*!
+ * \class Union::Depth::Limits
+ * \inmodule core
+ *
+ * \brief The user's limits, in pixels of a view 1920 pixels wide.
+ */
+struct UNION_EXPORT Limits {
+    qreal sunk = 0.0;
+    qreal popped = 0.0;
+
+    /*!
+     * Whether either limit is above zero. With both at zero nothing has depth.
+     */
+    bool isEnabled() const;
+
+    bool operator==(const Limits &other) const = default;
+};
+
+/*!
+ * Returns the depth \a shadow gives an element that declares none, or no value
+ * when the shadow draws nothing.
+ *
+ * CSS Backgrounds and Borders 3, section 6.1: an outer shadow is cast "as if [the
+ * box] were lifted above the canvas", so it raises the element by OuterShadow;
+ * an inset shadow is cast "as if the box were cut out of the canvas", so it
+ * sinks it to InsetShadow.
+ */
+UNION_EXPORT std::optional<qreal> shadowDepth(const Properties::ShadowPropertyGroup *shadow);
+
+/*!
+ * Returns the depth of an element with \a properties, relative to what it lies
+ * on: the depth the style declares, or else the depth its shadow gives it, or
+ * else Screen, lying on what it is drawn on. A declared depth always wins.
+ */
+UNION_EXPORT qreal elementDepth(const Properties::StylePropertyGroup *properties);
+
+/*!
+ * Returns the parallax of \a depth in whole pixels of a view \a viewWidth pixels
+ * wide, positive when nearer than the screen, as Stereo KWin computes it.
+ */
+UNION_EXPORT int parallax(qreal depth, const Limits &limits, int viewWidth);
+
+/*!
+ * Returns how far \a eye's picture moves for \a parallax: the left eye's to the
+ * right and the right eye's to the left for a positive parallax, so that the two
+ * end up \a parallax pixels apart, as Stereo KWin moves windows.
+ */
+UNION_EXPORT int eyeShift(int parallax, Eye eye);
+}
+
+class DepthTreePrivate;
+
+/*!
+ * \class Union::DepthTree
+ * \inmodule core
+ * \ingroup core-classes
+ *
+ * \brief The elements of one surface and their depths, fitted into the limits.
+ *
+ * Each element stands on what it lies on: its depth is relative to its parent's.
+ * When a stack of elements would go beyond a limit, every depth on that side of
+ * the surface is scaled down until the farthest element sits at the limit, the
+ * way Stereo KWin fits popups opened from each other. That keeps every element
+ * where it is relative to its neighbours: nearer than what it lies on when it
+ * rises, behind it when it sinks.
+ *
+ * Keys are the outputs' own objects; an element whose parent is not in the tree
+ * lies on the surface itself.
+ */
+class UNION_EXPORT DepthTree
+{
+public:
+    using Key = const void *;
+
+    DepthTree();
+    ~DepthTree();
+
+    /*!
+     * Adds \a key, or updates it, lying on \a parent with \a depth relative to
+     * it. The depth is limited to [-1, 1].
+     */
+    void setElement(Key key, Key parent, qreal depth);
+    /*!
+     * Removes \a key. Elements lying on it then lie on the surface.
+     */
+    void removeElement(Key key);
+    /*!
+     * Returns whether \a key is in the tree.
+     */
+    bool contains(Key key) const;
+
+    /*!
+     * Sets whether \a key touches an edge of its surface that lies on the edge of
+     * the output. Such an element never comes nearer than the screen, as Stereo
+     * KWin keeps a popped window at the output's edge at the screen.
+     */
+    void setAtOutputEdge(Key key, bool atEdge);
+    /*!
+     * Sets whether \a key and everything on it lie flat on what \a key lies on,
+     * for example the content of a window under a modal overlay.
+     */
+    void setFlat(Key key, bool flat);
+
+    /*!
+     * Returns the depth of \a key on its surface, from -1.0 to 1.0. Keys that are
+     * not in the tree are at the surface, 0.0.
+     */
+    qreal depth(Key key) const;
+
+    /*!
+     * Returns the keys whose depth changed since the last call, removed keys
+     * that had a depth included.
+     */
+    QList<Key> takeChanges();
+
+private:
+    const std::unique_ptr<DepthTreePrivate> d;
+};
+
+/*!
+ * \class Union::DepthMotion
+ * \inmodule core
+ * \ingroup core-classes
+ *
+ * \brief A depth that follows its target in a short eased motion.
+ *
+ * Towards the viewer the motion is quick, so that nothing is drawn behind what it
+ * is over for more than an instant, and away from the viewer it is gentle. Both
+ * ease out, follow the animation speed and are instant when animations are off,
+ * as Stereo KWin moves windows between levels.
+ */
+class UNION_EXPORT DepthMotion
+{
+public:
+    /*!
+     * Moves towards \a depth from where the motion is at \a time, with durations
+     * multiplied by \a speedFactor (zero is instant). The first target is taken
+     * at once.
+     */
+    void setTarget(qreal depth, std::chrono::nanoseconds time, qreal speedFactor);
+    /*!
+     * Returns the depth at \a time.
+     */
+    qreal depth(std::chrono::nanoseconds time) const;
+    /*!
+     * Returns the depth the motion goes to.
+     */
+    qreal target() const;
+    /*!
+     * Returns whether the motion is still moving at \a time.
+     */
+    bool isMoving(std::chrono::nanoseconds time) const;
+
+    /*!
+     * How long a motion towards the viewer and away from it lasts at the default
+     * animation speed.
+     */
+    static constexpr std::chrono::milliseconds RiseDuration{80};
+    static constexpr std::chrono::milliseconds SinkDuration{150};
+
+private:
+    qreal m_from = 0.0;
+    qreal m_to = 0.0;
+    std::chrono::nanoseconds m_start = std::chrono::nanoseconds::zero();
+    std::chrono::nanoseconds m_duration = std::chrono::nanoseconds::zero();
+    bool m_started = false;
+};
+
+}
