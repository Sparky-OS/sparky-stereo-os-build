+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "Depth.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <QEasingCurve>
+#include <QHash>
+
+#include "properties/StylePropertyGroup.h"
+
+using namespace Union;
+using namespace Union::Properties;
+
+// Stereo KWin's limits are given for a view this wide (src/scene/stereodepth.cpp).
+static constexpr qreal s_referenceWidth = 1920.0;
+
+// A stack deeper than this is a loop.
+static constexpr int s_maximumNesting = 64;
+
+bool Depth::Limits::isEnabled() const
+{
+    return sunk > 0.0 || popped > 0.0;
+}
+
+std::optional<qreal> Depth::shadowDepth(const ShadowPropertyGroup *shadow)
+{
+    if (!shadow) {
+        return std::nullopt;
+    }
+
+    const auto color = shadow->color().value_or(Color{}).toQColor();
+    if (!color.isValid() || color.alpha() == 0) {
+        return std::nullopt;
+    }
+
+    // A shadow with no offset, blur or spread lies under the box and draws nothing.
+    const auto offset = shadow->offset() ? shadow->offset()->toVector2D() : QVector2D{};
+    if (offset.isNull() && shadow->blur().value_or(0.0) <= 0.0 && shadow->size().value_or(0.0) <= 0.0) {
+        return std::nullopt;
+    }
+
+    return shadow->inset().value_or(false) ? InsetShadow : OuterShadow;
+}
+
+qreal Depth::elementDepth(const StylePropertyGroup *properties)
+{
+    if (!properties) {
+        return Screen;
+    }
+
+    if (properties->display() && properties->display()->depth()) {
+        return std::clamp(properties->display()->depth().value(), Sunk, Popped);
+    }
+
+    return shadowDepth(properties->shadow()).value_or(Screen);
+}
+
+int Depth::parallax(qreal depth, const Limits &limits, int viewWidth)
+{
+    const qreal limit = depth > 0.0 ? limits.popped : limits.sunk;
+    return std::lround(depth * limit * viewWidth / s_referenceWidth);
+}
+
+int Depth::eyeShift(int parallax, Eye eye)
+{
+    switch (eye) {
+    case Eye::Left:
+        return parallax - parallax / 2;
+    case Eye::Right:
+        return -(parallax / 2);
+    case Eye::None:
+        break;
+    }
+    return 0;
+}
+
+struct DepthNode {
+    DepthTree::Key parent = nullptr;
+    qreal relative = 0.0;
+    bool atOutputEdge = false;
+    bool flat = false;
+
+    // Computed.
+    qreal unfitted = 0.0;
+    bool flatBranch = false;
+    bool computed = false;
+};
+
+class Union::DepthTreePrivate
+{
+public:
+    void compute(DepthTree::Key key, DepthNode &node, int nesting)
+    {
+        if (node.computed) {
+            return;
+        }
+
+        qreal base = 0.0;
+        bool flatBranch = false;
+        auto parent = nodes.find(node.parent);
+        if (parent != nodes.end() && nesting < s_maximumNesting && node.parent != key) {
+            compute(node.parent, parent.value(), nesting + 1);
+            base = parent->unfitted;
+            flatBranch = parent->flatBranch;
+        }
+
+        node.flatBranch = flatBranch || node.flat;
+        node.unfitted = node.flatBranch ? base : base + node.relative;
+        if (node.atOutputEdge) {
+            node.unfitted = std::min(node.unfitted, 0.0);
+        }
+        node.computed = true;
+    }
+
+    void update()
+    {
+        if (!dirty) {
+            return;
+        }
+        dirty = false;
+
+        for (auto &node : nodes) {
+            node.computed = false;
+        }
+
+        qreal nearest = 0.0;
+        qreal farthest = 0.0;
+        for (auto itr = nodes.begin(); itr != nodes.end(); ++itr) {
+            compute(itr.key(), itr.value(), 0);
+            nearest = std::max(nearest, itr->unfitted);
+            farthest = std::min(farthest, itr->unfitted);
+        }
+
+        // Each side of the surface is fitted on its own, so the farthest element sits at the limit.
+        const qreal poppedScale = nearest > Depth::Popped ? Depth::Popped / nearest : 1.0;
+        const qreal sunkScale = farthest < Depth::Sunk ? Depth::Sunk / farthest : 1.0;
+
+        fitted.clear();
+        for (auto itr = nodes.cbegin(); itr != nodes.cend(); ++itr) {
+            const qreal value = itr->unfitted;
+            fitted.insert(itr.key(), std::clamp(value * (value > 0.0 ? poppedScale : sunkScale), Depth::Sunk, Depth::Popped));
+        }
+    }
+
+    QHash<DepthTree::Key, DepthNode> nodes;
+    QHash<DepthTree::Key, qreal> fitted;
+    QHash<DepthTree::Key, qreal> reported;
+    bool dirty = false;
+};
+
+DepthTree::DepthTree()
+    : d(std::make_unique<DepthTreePrivate>())
+{
+}
+
+DepthTree::~DepthTree() = default;
+
+void DepthTree::setElement(Key key, Key parent, qreal depth)
+{
+    depth = std::clamp(depth, Depth::Sunk, Depth::Popped);
+
+    auto &node = d->nodes[key];
+    if (node.parent == parent && node.relative == depth && d->fitted.contains(key)) {
+        return;
+    }
+
+    node.parent = parent;
+    node.relative = depth;
+    d->dirty = true;
+}
+
+void DepthTree::removeElement(Key key)
+{
+    if (d->nodes.remove(key)) {
+        d->fitted.remove(key);
+        d->dirty = true;
+    }
+}
+
+bool DepthTree::contains(Key key) const
+{
+    return d->nodes.contains(key);
+}
+
+void DepthTree::setAtOutputEdge(Key key, bool atEdge)
+{
+    auto itr = d->nodes.find(key);
+    if (itr == d->nodes.end() || itr->atOutputEdge == atEdge) {
+        return;
+    }
+
+    itr->atOutputEdge = atEdge;
+    d->dirty = true;
+}
+
+void DepthTree::setFlat(Key key, bool flat)
+{
+    auto itr = d->nodes.find(key);
+    if (itr == d->nodes.end() || itr->flat == flat) {
+        return;
+    }
+
+    itr->flat = flat;
+    d->dirty = true;
+}
+
+qreal DepthTree::depth(Key key) const
+{
+    d->update();
+    return d->fitted.value(key, Depth::Screen);
+}
+
+QList<DepthTree::Key> DepthTree::takeChanges()
+{
+    d->update();
+
+    QList<Key> changes;
+    for (auto itr = d->fitted.cbegin(); itr != d->fitted.cend(); ++itr) {
+        if (!qFuzzyCompare(1.0 + itr.value(), 1.0 + d->reported.value(itr.key(), Depth::Screen))) {
+            changes.append(itr.key());
+        }
+    }
+
+    // Removed elements that were reported with a depth are reported once more, at the screen.
+    for (auto itr = d->reported.cbegin(); itr != d->reported.cend(); ++itr) {
+        if (!d->fitted.contains(itr.key()) && !qFuzzyIsNull(itr.value())) {
+            changes.append(itr.key());
+        }
+    }
+
+    d->reported = d->fitted;
+    return changes;
+}
+
+void DepthMotion::setTarget(qreal depth, std::chrono::nanoseconds time, qreal speedFactor)
+{
+    if (!m_started) {
+        m_from = m_to = depth;
+        m_started = true;
+        return;
+    }
+    if (depth == m_to) {
+        return;
+    }
+
+    m_from = this->depth(time);
+    m_to = depth;
+    m_start = time;
+
+    const auto duration = m_to > m_from ? RiseDuration : SinkDuration;
+    m_duration = std::chrono::duration_cast<std::chrono::nanoseconds>(duration * std::max(speedFactor, 0.0));
+}
+
+qreal DepthMotion::depth(std::chrono::nanoseconds time) const
+{
+    if (m_duration <= std::chrono::nanoseconds::zero() || time >= m_start + m_duration) {
+        return m_to;
+    }
+    if (time <= m_start) {
+        return m_from;
+    }
+
+    const qreal progress = qreal((time - m_start).count()) / m_duration.count();
+    return m_from + (m_to - m_from) * QEasingCurve(QEasingCurve::OutCubic).valueForProgress(progress);
+}
+
+qreal DepthMotion::target() const
+{
+    return m_to;
+}
+
+bool DepthMotion::isMoving(std::chrono::nanoseconds time) const
+{
+    return m_duration > std::chrono::nanoseconds::zero() && time < m_start + m_duration;
+}
