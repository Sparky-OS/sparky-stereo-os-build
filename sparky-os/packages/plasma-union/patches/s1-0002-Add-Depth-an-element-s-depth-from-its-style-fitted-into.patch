+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include <QtTest>
+
+#include <Depth.h>
+#include <properties/StylePropertyGroup.h>
+
+using namespace Union;
+using namespace Union::Properties;
+using namespace std::chrono_literals;
+
+class TestDepth : public QObject
+{
+    Q_OBJECT
+
+    static std::unique_ptr<ShadowPropertyGroup> shadow(qreal x, qreal y, qreal blur, qreal size, qreal alpha, bool inset)
+    {
+        auto result = std::make_unique<ShadowPropertyGroup>();
+        auto offset = std::make_unique<OffsetPropertyGroup>();
+        offset->setHorizontal(x);
+        offset->setVertical(y);
+        result->setOffset(std::move(offset));
+        result->setBlur(blur);
+        result->setSize(size);
+        result->setColor(Color::rgba(0, 0, 0, int(alpha * 255)));
+        result->setInset(inset);
+        return result;
+    }
+
+private Q_SLOTS:
+    void testShadowDepth_data()
+    {
+        QTest::addColumn<qreal>("x");
+        QTest::addColumn<qreal>("y");
+        QTest::addColumn<qreal>("blur");
+        QTest::addColumn<qreal>("size");
+        QTest::addColumn<qreal>("alpha");
+        QTest::addColumn<bool>("inset");
+        QTest::addColumn<bool>("hasDepth");
+        QTest::addColumn<qreal>("expected");
+
+        // CSS Backgrounds 3 §6.1: an outer shadow is cast "as if [the box] were lifted above the
+        // canvas", one step: half of the popped limit.
+        QTest::addRow("Breeze button") << 0.0 << 1.0 << 0.0 << 0.0 << 0.1 << false << true << 0.5;
+        QTest::addRow("Breeze menu") << 0.0 << 2.0 << 20.0 << 0.0 << 0.2 << false << true << 0.5;
+        QTest::addRow("blur only") << 0.0 << 0.0 << 4.0 << 0.0 << 0.2 << false << true << 0.5;
+        QTest::addRow("spread only") << 0.0 << 0.0 << 0.0 << 2.0 << 0.2 << false << true << 0.5;
+        // An inset shadow is cast "as if the box were cut out of the canvas": sunk.
+        QTest::addRow("inset") << 0.0 << 1.0 << 2.0 << 0.0 << 0.2 << true << true << -1.0;
+        // A shadow that draws nothing gives no depth.
+        QTest::addRow("transparent") << 0.0 << 1.0 << 2.0 << 0.0 << 0.0 << false << false << 0.0;
+        QTest::addRow("hidden under the box") << 0.0 << 0.0 << 0.0 << 0.0 << 0.5 << false << false << 0.0;
+    }
+
+    void testShadowDepth()
+    {
+        QFETCH(qreal, x);
+        QFETCH(qreal, y);
+        QFETCH(qreal, blur);
+        QFETCH(qreal, size);
+        QFETCH(qreal, alpha);
+        QFETCH(bool, inset);
+        QFETCH(bool, hasDepth);
+        QFETCH(qreal, expected);
+
+        auto group = shadow(x, y, blur, size, alpha, inset);
+        auto depth = Depth::shadowDepth(group.get());
+        QCOMPARE(depth.has_value(), hasDepth);
+        if (hasDepth) {
+            QCOMPARE(depth.value(), expected);
+        }
+
+        QVERIFY(!Depth::shadowDepth(nullptr).has_value());
+        QVERIFY(!Depth::shadowDepth(ShadowPropertyGroup::empty().get()).has_value());
+    }
+
+    void testElementDepth()
+    {
+        // Nothing at all: the element lies on what it is drawn on.
+        QCOMPARE(Depth::elementDepth(nullptr), 0.0);
+        StylePropertyGroup properties;
+        QCOMPARE(Depth::elementDepth(&properties), 0.0);
+
+        // The default from the shadow.
+        properties.setShadow(shadow(0, 1, 0, 0, 0.1, false));
+        QCOMPARE(Depth::elementDepth(&properties), 0.5);
+        properties.setShadow(shadow(0, 1, 2, 0, 0.1, true));
+        QCOMPARE(Depth::elementDepth(&properties), -1.0);
+        properties.setShadow(ShadowPropertyGroup::empty());
+        QCOMPARE(Depth::elementDepth(&properties), 0.0);
+
+        // A declared depth always wins, whatever the shadow says.
+        auto display = std::make_unique<DisplayPropertyGroup>();
+        display->setDepth(-0.25);
+        properties.setDisplay(std::move(display));
+        properties.setShadow(shadow(0, 1, 0, 0, 0.1, false));
+        QCOMPARE(Depth::elementDepth(&properties), -0.25);
+        properties.setShadow(nullptr);
+        QCOMPARE(Depth::elementDepth(&properties), -0.25);
+
+        // A declared screen is a declaration too.
+        properties.display()->setDepth(0.0);
+        properties.setShadow(shadow(0, 1, 0, 0, 0.1, false));
+        QCOMPARE(Depth::elementDepth(&properties), 0.0);
+
+        // A display group without a depth does not hide the shadow.
+        properties.display()->setDepth(std::nullopt);
+        properties.display()->setOpacity(0.5);
+        QCOMPARE(Depth::elementDepth(&properties), 0.5);
+    }
+
+    void testNesting()
+    {
+        int window, card, button, field, menu, submenu, item;
+        DepthTree tree;
+
+        // A raised card on the window, a raised button on the card: each stands on what it lies on.
+        tree.setElement(&card, &window, 0.5);
+        tree.setElement(&button, &card, 0.5);
+        QCOMPARE(tree.depth(&card), 0.5);
+        QCOMPARE(tree.depth(&button), 1.0);
+
+        // A sunk field on the card is a well in the card.
+        tree.setElement(&field, &card, -1.0);
+        QCOMPARE(tree.depth(&field), -0.5);
+
+        // Unknown keys and elements lying on the surface itself are at the surface.
+        QCOMPARE(tree.depth(&window), 0.0);
+        QVERIFY(!tree.contains(&window));
+        QVERIFY(tree.contains(&card));
+    }
+
+    void testFitting()
+    {
+        int window, menu, submenu, subsubmenu, button;
+        DepthTree tree;
+
+        // One popped menu sits at the popped limit, as Stereo KWin places a single popup.
+        tree.setElement(&menu, &window, Depth::Popped);
+        QCOMPARE(tree.depth(&menu), 1.0);
+
+        // A popped sub-menu over it: the stack is fitted into the limit, the topmost at the limit,
+        // as Stereo KWin fits a sub-menu over its menu (menu +2, sub-menu +4 at a limit of 4).
+        tree.setElement(&submenu, &menu, Depth::Popped);
+        QCOMPARE(tree.depth(&menu), 0.5);
+        QCOMPARE(tree.depth(&submenu), 1.0);
+
+        tree.setElement(&subsubmenu, &submenu, Depth::Popped);
+        QCOMPARE(tree.depth(&menu), 1.0 / 3.0);
+        QCOMPARE(tree.depth(&submenu), 2.0 / 3.0);
+        QCOMPARE(tree.depth(&subsubmenu), 1.0);
+
+        // Closing them gives the menu its place back.
+        tree.removeElement(&subsubmenu);
+        tree.removeElement(&submenu);
+        QCOMPARE(tree.depth(&menu), 1.0);
+
+        // The sunk side is fitted on its own.
+        tree.setElement(&button, &window, Depth::Sunk);
+        tree.setElement(&submenu, &button, Depth::Sunk);
+        QCOMPARE(tree.depth(&button), -0.5);
+        QCOMPARE(tree.depth(&submenu), -1.0);
+        QCOMPARE(tree.depth(&menu), 1.0);
+    }
+
+    void testFittingKeepsOrder()
+    {
+        int window, popup, raised, flat, sunk;
+        DepthTree tree;
+
+        tree.setElement(&popup, &window, Depth::Popped);
+        tree.setElement(&raised, &popup, Depth::OuterShadow);
+        tree.setElement(&flat, &popup, 0.0);
+        tree.setElement(&sunk, &popup, Depth::Sunk);
+
+        // Nothing goes beyond the limits, and every element keeps its place relative to its
+        // neighbours: nearer than what it lies on when it rises, behind it when it sinks.
+        QCOMPARE(tree.depth(&raised), 1.0);
+        QCOMPARE(tree.depth(&popup), 1.0 / 1.5);
+        QCOMPARE(tree.depth(&flat), tree.depth(&popup));
+        QVERIFY(tree.depth(&sunk) < tree.depth(&popup));
+        QVERIFY(tree.depth(&sunk) >= -1.0);
+        QCOMPARE(tree.depth(&sunk), 0.0);
+    }
+
+    void testRelativeDepthsAreClamped()
+    {
+        int window, element;
+        DepthTree tree;
+        tree.setElement(&element, &window, 3.0);
+        QCOMPARE(tree.depth(&element), 1.0);
+        tree.setElement(&element, &window, -3.0);
+        QCOMPARE(tree.depth(&element), -1.0);
+    }
+
+    void testParentChanges()
+    {
+        int window, card, button;
+        DepthTree tree;
+        tree.setElement(&card, &window, 0.5);
+        tree.setElement(&button, &window, 0.5);
+        QCOMPARE(tree.depth(&button), 0.5);
+
+        tree.setElement(&button, &card, 0.5);
+        QCOMPARE(tree.depth(&button), 1.0);
+
+        // An element whose parent goes away lies on the surface.
+        tree.removeElement(&card);
+        QCOMPARE(tree.depth(&button), 0.5);
+
+        // A loop does not hang, and leaves every depth inside the limits.
+        tree.setElement(&card, &button, 0.5);
+        tree.setElement(&button, &card, 0.5);
+        QVERIFY(std::abs(tree.depth(&card)) <= 1.0);
+        QVERIFY(std::abs(tree.depth(&button)) <= 1.0);
+    }
+
+    void testChanges()
+    {
+        int window, menu, submenu, other;
+        DepthTree tree;
+
+        tree.setElement(&menu, &window, Depth::Popped);
+        tree.setElement(&other, &window, 0.0);
+        auto changes = tree.takeChanges();
+        QCOMPARE(changes.size(), 1);
+        QVERIFY(changes.contains(&menu));
+        QVERIFY(tree.takeChanges().isEmpty());
+
+        // Opening a sub-menu moves the menu too.
+        tree.setElement(&submenu, &menu, Depth::Popped);
+        changes = tree.takeChanges();
+        QCOMPARE(changes.size(), 2);
+        QVERIFY(changes.contains(&menu));
+        QVERIFY(changes.contains(&submenu));
+
+        // Setting the same value again changes nothing.
+        tree.setElement(&submenu, &menu, Depth::Popped);
+        QVERIFY(tree.takeChanges().isEmpty());
+
+        // A removed element that had a depth is reported once.
+        tree.removeElement(&submenu);
+        changes = tree.takeChanges();
+        QVERIFY(changes.contains(&menu));
+        QVERIFY(changes.contains(&submenu));
+        QVERIFY(!tree.contains(&submenu));
+    }
+
+    void testOutputEdge()
+    {
+        int window, panel, button, inner;
+        DepthTree tree;
+
+        // A popped part flush with the output's edge stays at the screen; what lies on it may rise.
+        tree.setElement(&panel, &window, Depth::Popped);
+        tree.setElement(&button, &panel, Depth::OuterShadow);
+        tree.setAtOutputEdge(&panel, true);
+        QCOMPARE(tree.depth(&panel), 0.0);
+        QCOMPARE(tree.depth(&button), 0.5);
+
+        // It may still sink.
+        tree.setElement(&panel, &window, Depth::Sunk);
+        QCOMPARE(tree.depth(&panel), -1.0);
+
+        tree.setElement(&panel, &window, Depth::Popped);
+        tree.setAtOutputEdge(&panel, false);
+        tree.setElement(&inner, &button, 0.0);
+        QCOMPARE(tree.depth(&panel), 1.0 / 1.5);
+        QCOMPARE(tree.depth(&button), 1.0);
+        QCOMPARE(tree.depth(&inner), 1.0);
+    }
+
+    void testFlat()
+    {
+        int window, content, button, popup, item;
+        DepthTree tree;
+
+        // Under a modal overlay the window's content lies flat, and what the overlay holds keeps its place.
+        tree.setElement(&content, &window, 0.0);
+        tree.setElement(&button, &content, Depth::OuterShadow);
+        tree.setElement(&popup, &window, Depth::Popped);
+        tree.setElement(&item, &popup, Depth::OuterShadow);
+        // The popup's stack reaches 1.5 steps, so the whole surface is fitted into the limit.
+        QCOMPARE(tree.depth(&button), 0.5 / 1.5);
+
+        tree.setFlat(&content, true);
+        QCOMPARE(tree.depth(&button), 0.0);
+        QCOMPARE(tree.depth(&content), 0.0);
+        QCOMPARE(tree.depth(&popup), 1.0 / 1.5);
+        QCOMPARE(tree.depth(&item), 1.0);
+
+        tree.setFlat(&content, false);
+        QCOMPARE(tree.depth(&button), 0.5 / 1.5);
+    }
+
+    void testParallax_data()
+    {
+        QTest::addColumn<qreal>("depth");
+        QTest::addColumn<qreal>("sunkLimit");
+        QTest::addColumn<qreal>("poppedLimit");
+        QTest::addColumn<int>("viewWidth");
+        QTest::addColumn<int>("parallax");
+        QTest::addColumn<int>("left");
+        QTest::addColumn<int>("right");
+
+        // Stereo KWin's defaults: SunkLimit 10 and PoppedLimit 4, in pixels of a view 1920 wide
+        // (kwin.kcfg [StereoDepth]); its parallax rounds to whole pixels and its eye shift gives
+        // the left eye the larger half, to the right for nearer (StereoDepth::eyeShift).
+        QTest::addRow("raised") << 0.5 << 10.0 << 4.0 << 1920 << 2 << 1 << -1;
+        QTest::addRow("popped") << 1.0 << 10.0 << 4.0 << 1920 << 4 << 2 << -2;
+        QTest::addRow("sunk") << -1.0 << 10.0 << 4.0 << 1920 << -10 << -5 << 5;
+        QTest::addRow("screen") << 0.0 << 10.0 << 4.0 << 1920 << 0 << 0 << 0;
+        QTest::addRow("3840 wide") << 0.5 << 10.0 << 4.0 << 3840 << 4 << 2 << -2;
+        QTest::addRow("odd") << 0.75 << 10.0 << 4.0 << 1920 << 3 << 2 << -1;
+        QTest::addRow("odd sunk") << -0.3 << 10.0 << 4.0 << 1920 << -3 << -2 << 1;
+        QTest::addRow("1280 wide") << -1.0 << 10.0 << 4.0 << 1280 << -7 << -4 << 3;
+        QTest::addRow("limits off") << 1.0 << 0.0 << 0.0 << 1920 << 0 << 0 << 0;
+    }
+
+    void testParallax()
+    {
+        QFETCH(qreal, depth);
+        QFETCH(qreal, sunkLimit);
+        QFETCH(qreal, poppedLimit);
+        QFETCH(int, viewWidth);
+        QFETCH(int, parallax);
+        QFETCH(int, left);
+        QFETCH(int, right);
+
+        const Depth::Limits limits{.sunk = sunkLimit, .popped = poppedLimit};
+        QCOMPARE(Depth::parallax(depth, limits, viewWidth), parallax);
+        QCOMPARE(Depth::eyeShift(parallax, Depth::Eye::Left), left);
+        QCOMPARE(Depth::eyeShift(parallax, Depth::Eye::Right), right);
+        QCOMPARE(Depth::eyeShift(parallax, Depth::Eye::None), 0);
+        QCOMPARE(Depth::eyeShift(parallax, Depth::Eye::Left) - Depth::eyeShift(parallax, Depth::Eye::Right), parallax);
+    }
+
+    void testLimitsEnabled()
+    {
+        QVERIFY(!Depth::Limits{}.isEnabled());
+        QVERIFY((Depth::Limits{.sunk = 10.0, .popped = 0.0}).isEnabled());
+        QVERIFY((Depth::Limits{.sunk = 0.0, .popped = 4.0}).isEnabled());
+    }
+
+    void testMotion()
+    {
+        // Stereo KWin's motion: towards the viewer about 80 ms, away about 150 ms, eased out, at the
+        // animation speed, instant when animations are off (StereoDepth::Motion).
+        DepthMotion motion;
+        motion.setTarget(0.5, 0ms, 1.0);
+        QCOMPARE(motion.depth(0ms), 0.5);
+        QVERIFY(!motion.isMoving(0ms));
+
+        motion.setTarget(1.0, 1000ms, 1.0);
+        QVERIFY(motion.isMoving(1000ms));
+        QCOMPARE(motion.depth(1000ms), 0.5);
+        QVERIFY(motion.depth(1040ms) > 0.75);
+        QVERIFY(motion.depth(1040ms) < 1.0);
+        QCOMPARE(motion.depth(1080ms), 1.0);
+        QVERIFY(!motion.isMoving(1080ms));
+
+        motion.setTarget(0.0, 2000ms, 1.0);
+        QVERIFY(motion.isMoving(2100ms));
+        QCOMPARE(motion.depth(2150ms), 0.0);
+
+        // Twice the animation duration.
+        motion.setTarget(1.0, 3000ms, 2.0);
+        QVERIFY(motion.isMoving(3150ms));
+        QCOMPARE(motion.depth(3160ms), 1.0);
+
+        // Animations off.
+        motion.setTarget(-1.0, 4000ms, 0.0);
+        QVERIFY(!motion.isMoving(4000ms));
+        QCOMPARE(motion.depth(4000ms), -1.0);
+
+        // Retargeting midway starts from where it is.
+        motion.setTarget(0.0, 5000ms, 1.0);
+        const auto midway = motion.depth(5075ms);
+        motion.setTarget(1.0, 5075ms, 1.0);
+        QCOMPARE(motion.depth(5075ms), midway);
+    }
+};
+
+QTEST_GUILESS_MAIN(TestDepth)
+
