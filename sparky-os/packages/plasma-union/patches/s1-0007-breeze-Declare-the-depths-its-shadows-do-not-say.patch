+    void testBreezeDepths()
+    {
+        QFETCH(QString, type);
+        QFETCH(QStringList, hints);
+        QFETCH(int, states);
+        QFETCH(qreal, expected);
+
+        static Style::Ptr breeze;
+        if (!breeze) {
+            breeze = Style::create(fs::path(QFINDTESTDATA("../../src/input/css/styles/breeze").toStdString()), std::make_unique<CssLoader>());
+            QVERIFY(breeze->load());
+            m_styles.append(breeze);
+        }
+
+        auto window = Element::create();
+        window->setType(u"ApplicationWindow"_s);
+        auto element = Element::create();
+        element->setType(type);
+        element->setHints(hints);
+        element->setStates(Element::States(states));
+
+        ElementQuery query(breeze);
+        query.setElements({window, element});
+        QVERIFY(query.execute());
+        QCOMPARE(Depth::elementDepth(query.properties()), expected);
+    }
