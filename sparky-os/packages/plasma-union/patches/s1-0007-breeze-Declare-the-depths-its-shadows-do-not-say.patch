diff --git a/src/input/css/styles/breeze/contents/css/depth.css b/src/input/css/styles/breeze/contents/css/depth.css
new file mode 100644
index 00000000..6314e4a7
--- /dev/null
+++ b/src/input/css/styles/breeze/contents/css/depth.css
@@ -0,0 +1,70 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+ */
+
+/*
+ * Where elements stand in depth on a stereo output. A 2D output shows them as
+ * they are.
+ *
+ * Without a declaration, an element with an outer shadow is raised one step
+ * (half of the popped limit), one with an inset shadow is sunk, and any other
+ * lies on what it is drawn on. Buttons and cards are raised by their shadow;
+ * a pressed, flat or disabled button has none and lies flat. The rules below
+ * give the places a shadow does not say. Hovering moves nothing, except a flat
+ * tool button, which rises as Qt raises it under the pointer; the current item
+ * of a menu or a list stays where it is.
+ *
+ * This file is imported last: at equal weight the later rule wins, so pressed,
+ * checked and disabled come after hovered.
+ */
+
+/* Qt raises a tool button that is not flat (QStyle::State_Raised). */
+toolbutton.raised {
+    depth: 50%;
+}
+
+/* A flat tool button rises under the pointer. */
+toolbutton:hovered {
+    depth: 50%;
+}
+
+/* Pressed is flat. */
+toolbutton:pressed {
+    depth: screen;
+}
+
+/* What is toggled or selected is sunk: checked buttons, the current tab and selected rows. */
+button:checked,
+toolbutton:checked,
+roundbutton:checked,
+delaybutton:checked,
+tabbutton:checked,
+tabbutton:highlighted,
+itemviewitem:highlighted,
+itemdelegate:checked,
+tableviewdelegate.selected,
+treeviewdelegate.selected {
+    depth: sunk;
+}
+
+/* What is disabled lies at the screen. */
+button:disabled,
+toolbutton:disabled,
+roundbutton:disabled,
+delaybutton:disabled,
+tabbutton:disabled {
+    depth: screen;
+}
+
+/*
+ * Menus, popups, tooltips and dialogs drawn inside a window are popped, as
+ * Stereo KWin places those that are surfaces of their own; one opened from
+ * another stands on it, and the stack is fitted into the popped limit.
+ */
+menu,
+popup,
+tooltip,
+dialog {
+    depth: popped;
+}
