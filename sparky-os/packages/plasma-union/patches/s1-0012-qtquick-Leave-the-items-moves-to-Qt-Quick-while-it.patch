+    void testEngineMovesItems()
+    {
+        // While the engine draws the window as a pair (the edition's Qt Quick), it moves each item
+        // by the parallax the item carries: Union no longer moves it, and only keeps the shadow
+        // where it falls, against the move the engine makes.
+        QTRY_COMPARE(depthOf(u"raised"_s), 1.0 / 1.5);
+        const auto flat = grab(Depth::Eye::None);
+        const auto rect = deviceRect(u"raised"_s);
+        const qreal parallax = Depth::exactParallax(Depth::referenceDepth(element(1.0 / 1.5), limits()), viewWidth());
+        QCOMPARE(item(u"raised"_s)->property(Depth::ParallaxProperty).toReal(), parallax);
+
+        m_window->setProperty(Depth::PairProperty, true);
+        const auto left = grab(Depth::Eye::Left);
+        const auto right = grab(Depth::Eye::Right);
+        m_window->setProperty(Depth::PairProperty, false);
+
+        QCOMPARE(shiftOf(flat, left, rect.adjusted(30, 10, -30, -10), 40), 0);
+        QCOMPARE(shiftOf(flat, right, rect.adjusted(30, 10, -30, -10), 40), 0);
+
+        if (flat.pixelColor(rect.left() + 4, rect.top() + 4) == QColor(Qt::white)) {
+            QSKIP("Union's rectangles are not drawn on this platform (the offscreen platform draws only text)");
+        }
+        // The hard shadow below the button, as wide as the button, moves against the engine's move:
+        // in the left eye it reaches out past the button's left edge, in the right eye past its right.
+        const int leftShift = qRound(expectedShift(element(1.0 / 1.5), Depth::Eye::Left));
+        const int rightShift = qRound(expectedShift(element(1.0 / 1.5), Depth::Eye::Right));
+        QVERIFY(leftShift > 2 && rightShift < -2);
+        const int row = rect.bottom() + 4;
+        QCOMPARE(flat.pixelColor(rect.center().x(), row), QColor(Qt::black));
+        QVERIFY(flat.pixelColor(rect.left() - leftShift / 2, row) != QColor(Qt::black));
+        QCOMPARE(left.pixelColor(rect.left() - leftShift / 2, row), QColor(Qt::black));
+        QVERIFY(left.pixelColor(rect.right() - leftShift / 2, row) != QColor(Qt::black));
+        QVERIFY(flat.pixelColor(rect.right() - rightShift / 2, row) != QColor(Qt::black));
+        QCOMPARE(right.pixelColor(rect.right() - rightShift / 2, row), QColor(Qt::black));
+        QVERIFY(right.pixelColor(rect.left() - rightShift / 2, row) != QColor(Qt::black));
+
+        // Drawn once per eye by Union itself again, the element moves.
+        const auto leftAgain = grab(Depth::Eye::Left);
+        QCOMPARE(shiftOf(flat, leftAgain, rect.adjusted(30, 10, -30, -10), 40), qRound(expectedShift(element(1.0 / 1.5), Depth::Eye::Left)));
+    }
+
