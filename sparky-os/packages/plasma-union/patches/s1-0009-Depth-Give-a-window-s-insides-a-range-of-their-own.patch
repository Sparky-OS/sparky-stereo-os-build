+        }
+        const QPointF center = item->mapToItem(content, QPointF(item->width() / 2, item->height() / 2));
+        int index = -1;
+        QMetaObject::invokeMethod(view, "indexAt", Q_RETURN_ARG(int, index), Q_ARG(qreal, center.x()), Q_ARG(qreal, center.y()));
