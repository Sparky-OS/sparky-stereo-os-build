 using namespace std::chrono_literals;
 
+// An element placed by its shadow alone.
+static Depth::Placement shadowed(qreal strength)
+{
+    return Depth::Placement{.shadow = strength};
+}
+
+// A desktop element: a menu, popup, tooltip or dialog drawn inside the window.
+static Depth::Placement desktop(std::optional<qreal> declared = std::nullopt)
+{
+    return Depth::Placement{.range = Depth::Range::Desktop, .declared = declared};
+}
+
+// A member of a group with one current item.
+static Depth::Placement member(const void *group, int distance)
+{
+    return Depth::Placement{.group = group, .groupDistance = distance};
+}
