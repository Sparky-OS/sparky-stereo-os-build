+    int nesting = 0;
+    for (auto ancestor = item->parentItem(); ancestor && nesting < 4; ancestor = ancestor->parentItem(), ++nesting) {
+        if (ancestor->inherits("QQuickTabBar")) {
+            const int current = ancestor->property("currentIndex").toInt();
+            const int count = ancestor->property("count").toInt();
+            for (int index = 0; current >= 0 && index < count; ++index) {
+                QQuickItem *tab = nullptr;
+                QMetaObject::invokeMethod(ancestor, "itemAt", Q_RETURN_ARG(QQuickItem *, tab), Q_ARG(int, index));
+                if (tab == item) {
+                    return {ancestor, std::abs(index - current)};
+                }
+            }
+            return {};
+        }
+        if (ancestor->inherits("QQuickPageIndicator")) {
+            const int current = ancestor->property("currentIndex").toInt();
+            const QVariant index = item->property("index");
+            if (current < 0 || !index.isValid()) {
+                return {};
+            }
+            return {ancestor, std::abs(index.toInt() - current)};
+        }
+    }
+
+    // A delegate of a list or a grid with a current item.
+    auto content = item->parentItem();
+    auto view = content ? content->parentItem() : nullptr;
+    if (view && view->inherits("QQuickItemView") && view->property("contentItem").value<QQuickItem *>() == content && !followsPointer(view)) {
+        const int current = view->property("currentIndex").toInt();
+        if (current < 0) {
