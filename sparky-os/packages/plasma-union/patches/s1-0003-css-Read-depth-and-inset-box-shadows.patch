+    Style::Ptr loadStyle(const QString &css)
+    {
+        auto directory = std::make_shared<QTemporaryDir>();
+        const auto path = fs::path(directory->path().toStdString());
+        fs::create_directories(path / "contents" / "css");
+        std::ofstream(path / "contents" / "css" / "style.css") << css.toStdString();
+
+        auto style = Style::create(path, std::make_unique<CssLoader>());
+        style->load();
+
+        m_directories.append(directory);
+        m_styles.append(style);
+        return style;
+    }
+
+    StylePropertyGroup *query(const Style::Ptr &style, const QString &type)
+    {
+        auto element = Element::create();
+        element->setType(type);
+
+        auto elementQuery = new ElementQuery(style);
+        elementQuery->setElements({element});
+        elementQuery->execute();
+        m_queries.push_back(std::unique_ptr<ElementQuery>(elementQuery));
+        return elementQuery->properties();
+    }
+
+    std::vector<std::unique_ptr<ElementQuery>> m_queries;
