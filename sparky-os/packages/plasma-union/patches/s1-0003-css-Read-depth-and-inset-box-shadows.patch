+        QTest::addRow("50%") << u"50%"_s << true << 0.5 << true;
+        QTest::addRow("-25%") << u"-25%"_s << true << -0.25 << true;
+        QTest::addRow("100%") << u"100%"_s << true << 1.0 << true;
+        QTest::addRow("-100%") << u"-100%"_s << true << -1.0 << true;
+        QTest::addRow("0.5") << u"0.5"_s << true << 0.5 << true;
+        QTest::addRow("-0.75") << u"-0.75"_s << true << -0.75 << true;
+        QTest::addRow("1") << u"1"_s << true << 1.0 << true;
+        QTest::addRow("0") << u"0"_s << true << 0.0 << true;
+        QTest::addRow("-1") << u"-1"_s << true << -1.0 << true;
+
+        // Nothing beyond the limits: CSS Values 4 §5.1, a value outside the allowed range makes the
+        // declaration invalid, so it is ignored.
+        QTest::addRow("150%") << u"150%"_s << false << 0.0 << true;
+        QTest::addRow("-101%") << u"-101%"_s << false << 0.0 << true;
+        QTest::addRow("2") << u"2"_s << false << 0.0 << true;
+        QTest::addRow("-1.5") << u"-1.5"_s << false << 0.0 << true;
+
+        // Not a depth. cxx-rust-cssparser 1.1.0 drops the whole rule when a value does not match the
+        // property's syntax, where CSS 2.1 §4.2 ignores only that declaration.
+        QTest::addRow("length") << u"4px"_s << false << 0.0 << false;
+        QTest::addRow("keyword") << u"deep"_s << false << 0.0 << false;
+    }
+
+    void testDepth()
+    {
+        QFETCH(QString, value);
+        QFETCH(bool, valid);
+        QFETCH(qreal, expected);
+        QFETCH(bool, parsed);
+
+        auto style = loadStyle(u"button { opacity: 0.5; depth: %1; }"_s.arg(value));
+        auto properties = query(style, u"button"_s);
+
+        if (!parsed) {
+            QVERIFY(!properties || !properties->display() || !properties->display()->depth().has_value());
+            return;
+        }
+
+        // The rest of the rule still applies when the depth is ignored.
+        QVERIFY(properties);
+        QVERIFY(properties->display());
+        QCOMPARE(properties->display()->opacity(), 0.5);
+
+        auto depth = properties->display()->depth();
+        QCOMPARE(depth.has_value(), valid);
+        if (valid) {
+            QCOMPARE(depth.value(), expected);
+        }
+    }
+
+    void testDepthIsPerState()
+    {
+        auto style = loadStyle(u"button { depth: 50%; } button:checked { depth: sunk; }"_s);
+
+        auto element = Element::create();
+        element->setType(u"button"_s);
+
+        ElementQuery query(style);
+        query.setElements({element});
+        QVERIFY(query.execute());
+        QVERIFY(query.properties()->display());
+        QCOMPARE(query.properties()->display()->depth(), 0.5);
+
+        element->setStates(Element::State::Checked);
+        QVERIFY(query.execute());
+        QVERIFY(query.properties()->display());
+        QCOMPARE(query.properties()->display()->depth(), -1.0);
+    }
+
+    void testShadowInset_data()
+    {
+        QTest::addColumn<QString>("value");
+        QTest::addColumn<bool>("inset");
+        QTest::addColumn<qreal>("vertical");
+        QTest::addColumn<qreal>("blur");
+
+        // CSS Backgrounds 3 §6.1: inset may come first or last.
+        QTest::addRow("outer") << u"0px 1px 2px 0px rgba(0, 0, 0, 0.1)"_s << false << 1.0 << 2.0;
+        QTest::addRow("inset first") << u"inset 0px 3px 4px 0px rgba(0, 0, 0, 0.1)"_s << true << 3.0 << 4.0;
+        QTest::addRow("inset last") << u"0px 5px 6px 0px rgba(0, 0, 0, 0.1) inset"_s << true << 5.0 << 6.0;
+    }
+
+    void testShadowInset()
+    {
+        QFETCH(QString, value);
+        QFETCH(bool, inset);
+        QFETCH(qreal, vertical);
+        QFETCH(qreal, blur);
+
+        auto style = loadStyle(u"button { box-shadow: %1; }"_s.arg(value));
+        auto properties = query(style, u"button"_s);
+        QVERIFY(properties);
+        QVERIFY(properties->shadow());
+
+        QCOMPARE(properties->shadow()->inset().value_or(false), inset);
+        QVERIFY(properties->shadow()->offset());
+        QCOMPARE(properties->shadow()->offset()->vertical(), vertical);
+        QCOMPARE(properties->shadow()->blur(), blur);
+        QCOMPARE(properties->shadow()->size(), 0.0);
+        QVERIFY(properties->shadow()->color().has_value());
+    }
+
+    void testShadowNoneIsNotInset()
+    {
+        auto style = loadStyle(u"button { box-shadow: inset 0px 1px 2px 0px rgba(0, 0, 0, 0.1); } button:pressed { box-shadow: none; }"_s);
+
+        auto element = Element::create();
+        element->setType(u"button"_s);
+        element->setStates(Element::State::Pressed);
+
+        ElementQuery query(style);
+        query.setElements({element});
+        QVERIFY(query.execute());
+        QVERIFY(query.properties()->shadow());
+        QVERIFY(!query.properties()->shadow()->inset().value_or(false));
+    }
 };
 
 QTEST_MAIN(TestCss)
