+        ,Case{"depth", [&](CssValue &&value) {
+            std::optional<qreal> depth;
+            if (value.type() == cssparser::Value::Type::String) {
+                switchString(value
+                    ,Case{"sunk", [&]{ depth = Depth::Sunk; }}
+                    ,Case{"screen", [&]{ depth = Depth::Screen; }}
+                    ,Case{"popped", [&]{ depth = Depth::Popped; }}
+                );
+            } else if (value.type() == cssparser::Value::Type::Integer) {
+                depth = value.get<int>();
+            } else if (value.type() == cssparser::Value::Type::Dimension) {
+                // The parser hands percentages over as fractions: 50% is 0.5.
+                auto dimension = value.get<cssparser::Dimension>();
+                if (dimension.unit() == cssparser::Dimension::Unit::Number || dimension.unit() == cssparser::Dimension::Unit::Percent) {
+                    depth = dimension.value();
+                }
+            }
+
+            // CSS Values 4 §5.1: a value outside the allowed range makes the declaration invalid,
+            // and it is ignored rather than cut to the limit.
+            if (!depth || depth.value() < Depth::Sunk || depth.value() > Depth::Popped) {
+                qCWarning(UNION_CSS) << "Ignoring depth outside the range from sunk (-100%) to popped (100%) in" << m_stylePath.string();
+                return;
+            }
+
+            display->setDepth(depth);
+        }}
     );
