+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#pragma once
+
+#include <PlatformPlugin.h>
+
+/*
+ * A platform for tests that shows depth in every window, as Stereo KWin does for
+ * an awake window on a stereo output. The limits come from
+ * UNION_TEST_DEPTH_LIMITS ("sunk,popped", Stereo KWin's defaults "10,4" when
+ * unset) and styles from UNION_TEST_STYLE_PATH. It is never chosen on its own:
+ * select it with UNION_FORCE_PLATFORM=depthtest.
+ */
+class DepthTestPlatformPlugin : public Union::PlatformPlugin
+{
+    Q_OBJECT
+    Q_PLUGIN_METADATA(IID "org.kde.union.PlatformPlugin" FILE "depthtest.json")
+
+public:
+    using Union::PlatformPlugin::PlatformPlugin;
+
+    QString defaultStyleName() override;
+    QList<std::filesystem::path> stylePackagePaths() override;
+    qreal animationSpeedMultiplier() override;
+    Union::Depth::Limits depthLimits() override;
+    bool depthEnabled(QWindow *window) override;
+};
