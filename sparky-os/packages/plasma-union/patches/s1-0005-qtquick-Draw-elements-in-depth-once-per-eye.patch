@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#pragma once
+
+#include <QHash>
+#include <QObject>
+#include <QPointer>
+
+#include <Depth.h>
+
+#include "unionquickimpl_export.h"
+
+class QQuickWindow;
+class QWindow;
+
+namespace Union
+{
+namespace Quick
+{
+
+class QuickElement;
+
+/*!
+ * The depth of the elements of one window.
+ *
+ * It holds the window's DepthTree, follows what the platform says the window
+ * may show in depth, and the eye being drawn, which whoever draws the window
+ * once per eye sets as the window's Depth::EyeProperty. While no eye is drawn,
+ * and whenever the window shows no depth, every element is drawn exactly as on
+ * a 2D output.
+ */
+class UNIONQUICKIMPL_EXPORT DepthWindow : public QObject
+{
+    Q_OBJECT
+
+public:
+    /*!
+     * Returns the DepthWindow of \a window, creating it the first time.
+     */
+    static DepthWindow *get(QQuickWindow *window);
+
+    /*!
+     * Whether the window shows depth: the platform allows it and the user's
+     * limits are not both zero.
+     */
+    bool isEnabled() const;
+    Depth::Limits limits() const;
+    Depth::Eye eye() const;
+
+    /*!
+     * Adds or updates \a element, lying on \a parent (null: on the window) with
+     * \a depth relative to it.
+     */
+    void setElement(QuickElement *element, QuickElement *parent, qreal depth, bool atOutputEdge, bool flat);
+    void removeElement(QuickElement *element);
+
+    /*!
+     * The edges of the window that lie on an edge of its output.
+     */
+    Qt::Edges outputEdges() const;
+
+    /*!
+     * The element's depth in the window, fitted into the limits.
+     */
+    qreal depth(const QuickElement *element) const;
+    /*!
+     * The element's parallax in device pixels, as it moves towards its depth.
+     */
+    int parallax(const QuickElement *element) const;
+    /*!
+     * How far the element's picture moves in the eye being drawn, relative to
+     * what it lies on, in logical pixels.
+     */
+    qreal relativeShift(const QuickElement *element) const;
+    /*!
+     * Whether the element is behind what it lies on.
+     */
+    bool isDeeper(const QuickElement *element) const;
+
+    /*!
+     * Adds or removes a modal overlay: while one is shown, the window's content
+     * lies flat under it.
+     */
+    void setModalOverlay(QObject *overlay, bool shown);
+    bool hasModalOverlay() const;
+
+Q_SIGNALS:
+    /*!
+     * Emitted when the window starts or stops showing depth, or a modal overlay
+     * is shown or hidden: every element has to look at its depth again.
+     */
+    void stateChanged();
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    explicit DepthWindow(QQuickWindow *window);
+
+    struct Entry {
+        QPointer<QuickElement> element;
+        const QuickElement *parent = nullptr;
+        DepthMotion motion;
+    };
+
+    void refresh();
+    void scheduleChanges();
+    void applyChanges();
+    void setEye(Depth::Eye eye);
+    void applyEye();
+    int parallaxAt(const QuickElement *element, std::chrono::nanoseconds time) const;
+
+    QQuickWindow *m_window = nullptr;
+    QPointer<QWindow> m_renderWindow;
+    DepthTree m_tree;
+    QHash<const QuickElement *, Entry> m_elements;
+    QList<QObject *> m_modalOverlays;
+    Depth::Eye m_eye = Depth::Eye::None;
+    Depth::Limits m_limits;
+    Qt::Edges m_outputEdges;
+    bool m_platformEnabled = false;
+    bool m_changesScheduled = false;
+    int m_viewWidth = 0;
+    qreal m_devicePixelRatio = 1.0;
+};
+
+}
+}
