new file mode 100644
index 00000000..a3b4ec3e
--- /dev/null
+++ b/src/output/qtquick/plugin/DepthWindow.cpp
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "DepthWindow.h"
+
+#include <QDynamicPropertyChangeEvent>
+#include <QQuickRenderControl>
+#include <QQuickWindow>
+#include <QScreen>
+
+#include <PlatformPlugin.h>
+#include <StyleRegistry.h>
+
+#include "QuickElement.h"
+
+using namespace Union;
+using namespace Union::Quick;
+
+static std::chrono::nanoseconds now()
+{
+    return std::chrono::steady_clock::now().time_since_epoch();
+}
+
+DepthWindow *DepthWindow::get(QQuickWindow *window)
+{
+    if (!window) {
+        return nullptr;
+    }
+
+    if (auto existing = window->findChild<DepthWindow *>(QString{}, Qt::FindDirectChildrenOnly)) {
+        return existing;
+    }
+
+    return new DepthWindow(window);
+}
+
+DepthWindow::DepthWindow(QQuickWindow *window)
+    : QObject(window)
+    , m_window(window)
+{
+    m_window->installEventFilter(this);
+    StyleRegistry::instance()->platform()->installEventFilter(this);
+    connect(m_window, &QWindow::screenChanged, this, &DepthWindow::refresh);
+
+    refresh();
+}
+
+bool DepthWindow::isEnabled() const
+{
+    return m_platformEnabled && m_limits.isEnabled() && m_viewWidth > 0;
+}
+
+Depth::Limits DepthWindow::limits() const
+{
+    return m_limits;
+}
+
+Depth::Eye DepthWindow::eye() const
+{
+    return m_eye;
+}
+
+Qt::Edges DepthWindow::outputEdges() const
+{
+    return m_outputEdges;
+}
+
+void DepthWindow::setElement(QuickElement *element, QuickElement *parent, qreal depth, bool atOutputEdge, bool flat)
+{
+    auto &entry = m_elements[element];
+    entry.element = element;
+    entry.parent = parent;
+
+    m_tree.setElement(element, parent, depth);
+    m_tree.setAtOutputEdge(element, atOutputEdge);
+    m_tree.setFlat(element, flat);
+
+    scheduleChanges();
+}
+
+void DepthWindow::removeElement(QuickElement *element)
+{
+    if (m_elements.remove(element)) {
+        m_tree.removeElement(element);
+        scheduleChanges();
+    }
+    setModalOverlay(element, false);
+}
+
+qreal DepthWindow::depth(const QuickElement *element) const
+{
+    return isEnabled() ? m_tree.depth(element) : Depth::Screen;
+}
+
+int DepthWindow::parallax(const QuickElement *element) const
+{
+    return parallaxAt(element, now());
+}
+
+int DepthWindow::parallaxAt(const QuickElement *element, std::chrono::nanoseconds time) const
+{
+    if (!isEnabled()) {
+        return 0;
+    }
+
+    auto itr = m_elements.constFind(element);
+    if (itr == m_elements.cend()) {
+        return 0;
+    }
+
+    return Depth::parallax(itr->motion.depth(time), m_limits, m_viewWidth);
+}
+
+qreal DepthWindow::relativeShift(const QuickElement *element) const
+{
+    if (!isEnabled() || m_eye == Depth::Eye::None) {
+        return 0.0;
+    }
+
+    auto itr = m_elements.constFind(element);
+    if (itr == m_elements.cend()) {
+        return 0.0;
+    }
+
+    const auto time = now();
+    const int shift = Depth::eyeShift(parallaxAt(element, time), m_eye);
+    const int parentShift = itr->parent ? Depth::eyeShift(parallaxAt(itr->parent, time), m_eye) : 0;
+    return (shift - parentShift) / m_devicePixelRatio;
+}
+
+bool DepthWindow::isDeeper(const QuickElement *element) const
+{
+    auto itr = m_elements.constFind(element);
+    if (!isEnabled() || itr == m_elements.cend()) {
+        return false;
+    }
+
+    const qreal parentDepth = itr->parent ? m_tree.depth(itr->parent) : Depth::Screen;
+    return m_tree.depth(element) < parentDepth;
+}
+
+void DepthWindow::setModalOverlay(QObject *overlay, bool shown)
+{
+    const bool had = hasModalOverlay();
+    if (shown && !m_modalOverlays.contains(overlay)) {
+        m_modalOverlays.append(overlay);
+    } else if (!shown) {
+        m_modalOverlays.removeAll(overlay);
+    }
+
+    if (had != hasModalOverlay()) {
+        Q_EMIT stateChanged();
+    }
+}
+
+bool DepthWindow::hasModalOverlay() const
+{
+    return !m_modalOverlays.isEmpty();
+}
+
+bool DepthWindow::eventFilter(QObject *watched, QEvent *event)
+{
+    if (event->type() == QEvent::DynamicPropertyChange && (watched == m_window || watched == m_renderWindow)) {
+        auto propertyEvent = static_cast<QDynamicPropertyChangeEvent *>(event);
+        if (propertyEvent->propertyName() == Depth::EyeProperty) {
+            setEye(Depth::Eye(watched->property(Depth::EyeProperty).toInt()));
+        }
+    } else if (event->type() == DepthChangedEvent::s_type) {
+        auto depthEvent = static_cast<DepthChangedEvent *>(event);
+        if (!depthEvent->window || depthEvent->window == m_renderWindow || depthEvent->window == m_window) {
+            refresh();
+        }
+    }
+
+    return QObject::eventFilter(watched, event);
+}
+
+void DepthWindow::refresh()
+{
+    // The window that is shown, which for a QQuickWidget is not the QQuickWindow itself.
+    QWindow *renderWindow = QQuickRenderControl::renderWindowFor(m_window);
+    if (!renderWindow) {
+        renderWindow = m_window;
+    }
+    if (renderWindow != m_renderWindow) {
+        if (m_renderWindow && m_renderWindow != m_window) {
+            m_renderWindow->removeEventFilter(this);
+        }
+        m_renderWindow = renderWindow;
+        if (m_renderWindow != m_window) {
+            m_renderWindow->installEventFilter(this);
+        }
+    }
+
+    const bool wasEnabled = isEnabled();
+
+    auto platform = StyleRegistry::instance()->platform();
+    m_platformEnabled = platform->depthEnabled(m_renderWindow);
+    m_limits = platform->depthLimits();
+    m_outputEdges = platform->depthOutputEdges(m_renderWindow);
+
+    // The width of one view of the output, in device pixels: the unit of a parallax.
+    auto screen = m_renderWindow->screen();
+    m_viewWidth = screen ? qRound(screen->geometry().width() * screen->devicePixelRatio()) : 0;
+    m_devicePixelRatio = std::max(m_renderWindow->devicePixelRatio(), 1e-3);
+
+    if (wasEnabled != isEnabled()) {
+        Q_EMIT stateChanged();
+    }
+    scheduleChanges();
+}
+
+void DepthWindow::scheduleChanges()
+{
+    if (m_changesScheduled) {
+        return;
+    }
+
+    m_changesScheduled = true;
+    QMetaObject::invokeMethod(this, &DepthWindow::applyChanges, Qt::QueuedConnection);
+}
+
+void DepthWindow::applyChanges()
+{
+    m_changesScheduled = false;
+
+    if (!isEnabled()) {
+        return;
+    }
+
+    const auto time = now();
+    const auto speed = StyleRegistry::instance()->platform()->animationSpeedMultiplier();
+
+    const auto changes = m_tree.takeChanges();
+    for (auto key : changes) {
+        auto itr = m_elements.find(static_cast<const QuickElement *>(key));
+        if (itr == m_elements.end()) {
+            continue;
+        }
+
+        itr->motion.setTarget(m_tree.depth(key), time, speed);
+        if (itr->element) {
+            itr->element->depthUpdated();
+        }
+    }
+
+    if (m_eye != Depth::Eye::None) {
+        applyEye();
+    }
+}
+
+void DepthWindow::setEye(Depth::Eye eye)
+{
+    if (eye == m_eye) {
+        return;
+    }
+
+    m_eye = eye;
+
+    if (m_changesScheduled) {
+        applyChanges();
+    }
+
+    applyEye();
+}
+
+void DepthWindow::applyEye()
+{
+    bool moving = false;
+    const auto time = now();
+
+    for (const auto &entry : std::as_const(m_elements)) {
+        if (entry.element) {
+            entry.element->updateEyeShift();
+        }
+        moving |= entry.motion.isMoving(time);
+    }
+
+    // While something moves in depth, every frame draws it a little further.
+    if (moving && m_eye != Depth::Eye::None) {
+        m_window->update();
+    }
+}
+
+#include "moc_DepthWindow.cpp"
