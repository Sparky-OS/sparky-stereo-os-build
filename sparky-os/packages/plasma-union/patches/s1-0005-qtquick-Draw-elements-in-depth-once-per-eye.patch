+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include <QtTest>
+
+#include <QPainter>
+#include <QQmlComponent>
+#include <QQmlEngine>
+#include <QQuickItem>
+#include <QQuickWindow>
+
+#include <Depth.h>
+#include <StyleRegistry.h>
+
+using namespace Union;
+using namespace Qt::StringLiterals;
+
+// Limits large enough to measure, in pixels of a view 1920 wide.
+static constexpr qreal SunkLimit = 40.0;
+static constexpr qreal PoppedLimit = 20.0;
+
+static const char *const Scene = R"(
+import QtQuick
+import org.kde.union
+
+ApplicationWindow {
+    width: 640
+    height: 260
+    visible: true
+
+    Row {
+        x: 30
+        y: 30
+        spacing: 40
+        Button { objectName: "raised"; text: "Raised" }
+        Button { objectName: "checked"; text: "Checked"; checkable: true; checked: true }
+        Button { objectName: "flat"; text: "Flat"; flat: true }
+    }
+
+    Frame {
+        objectName: "frame"
+        x: 30
+        y: 130
+        width: 300
+        height: 110
+        Button { objectName: "onFrame"; x: 20; y: 12; text: "On frame" }
+    }
+
+    Popup {
+        objectName: "popup"
+        x: 380
+        y: 120
+        width: 220
+        height: 120
+        closePolicy: Popup.NoAutoClose
+        Button { objectName: "inPopup"; x: 30; y: 20; text: "In popup" }
+    }
+
+    Popup {
+        objectName: "modal"
+        modal: true
+        x: 380
+        y: 10
+        width: 100
+        height: 60
+        closePolicy: Popup.NoAutoClose
+    }
+}
+)";
+
+class TestQuickDepth : public QObject
+{
+    Q_OBJECT
+
+    QQmlEngine m_engine;
+    std::unique_ptr<QQuickWindow> m_window;
+
+    QQuickItem *item(const QString &name) const
+    {
+        return m_window->findChild<QQuickItem *>(name);
+    }
+
+    QObject *object(const QString &name) const
+    {
+        return m_window->findChild<QObject *>(name);
+    }
+
+    qreal depthOf(const QString &name) const
+    {
+        // Union.Element.depth, read through QML as an application would.
+        QQmlComponent component(const_cast<QQmlEngine *>(&m_engine));
+        component.setData(
+            "import QtQuick\nimport org.kde.union.impl as Union\nQtObject { property var target; property real depth: target.Union.Element.depth }",
+            QUrl{});
+        std::unique_ptr<QObject> reader(component.createWithInitialProperties({{u"target"_s, QVariant::fromValue(object(name))}}));
+        if (!reader) {
+            qWarning() << component.errors();
+            return qQNaN();
+        }
+        return reader->property("depth").toReal();
+    }
+
+    QImage grab(Depth::Eye eye)
+    {
+        m_window->setProperty(Depth::EyeProperty, int(eye));
+        auto image = m_window->grabWindow().convertToFormat(QImage::Format_RGB32);
+        m_window->setProperty(Depth::EyeProperty, int(Depth::Eye::None));
+        return image;
+    }
+
+    QRect deviceRect(const QString &name) const
+    {
+        auto target = item(name);
+        const auto rect = target->mapRectToScene(target->boundingRect());
+        const auto dpr = m_window->effectiveDevicePixelRatio();
+        return QRectF(rect.topLeft() * dpr, rect.size() * dpr).toAlignedRect();
+    }
+
+    // The horizontal shift that makes the picture of `area` in `reference` appear in
+    // `image`, or INT_MIN when no shift within `range` matches it exactly.
+    static int shiftOf(const QImage &reference, const QImage &image, const QRect &area, int range)
+    {
+        for (int distance = 0; distance <= range; ++distance) {
+            for (int dx : {distance, -distance}) {
+                bool same = true;
+                for (int y = area.top(); same && y <= area.bottom(); ++y) {
+                    for (int x = area.left(); x <= area.right(); ++x) {
+                        if (reference.pixel(x, y) != image.pixel(x + dx, y)) {
+                            same = false;
+                            break;
+                        }
+                    }
+                }
+                if (same) {
+                    return dx;
+                }
+            }
+        }
+        return std::numeric_limits<int>::min();
+    }
+
+    static int expectedShift(qreal depth, Depth::Eye eye, int viewWidth)
+    {
+        return Depth::eyeShift(Depth::parallax(depth, Depth::Limits{.sunk = SunkLimit, .popped = PoppedLimit}, viewWidth), eye);
+    }
+
+    int viewWidth() const
+    {
+        return qRound(m_window->screen()->geometry().width() * m_window->screen()->devicePixelRatio());
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        qputenv("UNION_FORCE_PLATFORM", "depthtest");
+        qputenv("UNION_TEST_STYLE_PATH", QFINDTESTDATA("../../DepthTestData").toUtf8());
+        qputenv("UNION_TEST_DEPTH_LIMITS", QByteArray(QByteArray::number(SunkLimit) + "," + QByteArray::number(PoppedLimit)));
+
+        StyleRegistry::instance()->load();
+
+        QQmlComponent component(&m_engine);
+        component.setData(Scene, QUrl{});
+        if (component.isError()) {
+            qCritical() << component.errors();
+            QFAIL("The scene did not load");
+        }
+        m_window.reset(qobject_cast<QQuickWindow *>(component.create()));
+        QVERIFY(m_window);
+        QVERIFY(QTest::qWaitForWindowExposed(m_window.get()));
+
+        QVERIFY(StyleRegistry::instance()->platform()->depthEnabled(m_window.get()));
+        QCOMPARE(StyleRegistry::instance()->platform()->metaObject()->className(), "DepthTestPlatformPlugin");
+    }
+
+    void testDepths()
+    {
+        // From the style: a shadow raises one step, a declared sunk sinks to the limit, a flat
+        // button lies on the window, the frame declares 50% and the button on it stands on it.
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.5);
+        QCOMPARE(depthOf(u"checked"_s), -1.0);
+        QCOMPARE(depthOf(u"flat"_s), 0.0);
+        QCOMPARE(depthOf(u"frame"_s), 0.5);
+        QCOMPARE(depthOf(u"onFrame"_s), 1.0);
+
+        // The parallax a two-pass renderer can read from the items.
+        QCOMPARE(item(u"raised"_s)->property(Depth::ParallaxProperty).toInt(), Depth::parallax(0.5, {SunkLimit, PoppedLimit}, viewWidth()));
+        QCOMPARE(item(u"checked"_s)->property(Depth::ParallaxProperty).toInt(), Depth::parallax(-1.0, {SunkLimit, PoppedLimit}, viewWidth()));
+    }
+
+    void testFlatPictureIsUnchanged()
+    {
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.5);
+
+        // Without an eye being drawn, the window is drawn as it is without depth; drawing the
+        // eyes leaves nothing behind.
+        const auto before = grab(Depth::Eye::None);
+        grab(Depth::Eye::Left);
+        grab(Depth::Eye::Right);
+        const auto after = grab(Depth::Eye::None);
+        QCOMPARE(after, before);
+    }
+
+    void testEyes_data()
+    {
+        QTest::addColumn<QString>("name");
+        QTest::addColumn<qreal>("depth");
+        QTest::addColumn<int>("margin");
+
+        QTest::addRow("raised") << u"raised"_s << 0.5 << 30;
+        QTest::addRow("sunk") << u"checked"_s << -1.0 << 30;
+        QTest::addRow("flat") << u"flat"_s << 0.0 << 30;
+        QTest::addRow("on a raised frame") << u"onFrame"_s << 1.0 << 30;
+    }
+
+    void testEyes()
+    {
+        QFETCH(QString, name);
+        QFETCH(qreal, depth);
+        QFETCH(int, margin);
+
+        QTRY_COMPARE(depthOf(name), depth);
+
+        const auto flat = grab(Depth::Eye::None);
+        const auto left = grab(Depth::Eye::Left);
+        const auto right = grab(Depth::Eye::Right);
+
+        // UNION_TEST_SAVE_IMAGES=directory keeps the pictures to look at.
+        if (const auto directory = qEnvironmentVariable("UNION_TEST_SAVE_IMAGES"); !directory.isEmpty()) {
+            flat.save(directory + u"/flat.png"_s);
+            QImage pair(left.width() * 2, left.height(), QImage::Format_RGB32);
+            QPainter painter(&pair);
+            painter.drawImage(0, 0, left);
+            painter.drawImage(left.width(), 0, right);
+            painter.end();
+            pair.save(directory + u"/full-sbs.png"_s);
+        }
+
+        // The label, inside the element: the element moves as a whole, its text with it.
+        const auto label = deviceRect(name).adjusted(margin, 10, -margin, -10);
+        const int leftShift = shiftOf(flat, left, label, 40);
+        const int rightShift = shiftOf(flat, right, label, 40);
+
+        QCOMPARE(leftShift, expectedShift(depth, Depth::Eye::Left, viewWidth()));
+        QCOMPARE(rightShift, expectedShift(depth, Depth::Eye::Right, viewWidth()));
+        QCOMPARE(leftShift - rightShift, Depth::parallax(depth, {SunkLimit, PoppedLimit}, viewWidth()));
+    }
+
+    void testSunkIsSeenThroughItsOpening()
+    {
+        QTRY_COMPARE(depthOf(u"checked"_s), -1.0);
+
+        const auto flat = grab(Depth::Eye::None);
+        const auto rect = deviceRect(u"checked"_s);
+
+        // Behind what it lies on, the element is cut to its own rectangle: nothing of it is
+        // drawn beside it in either eye, where the window covers it.
+        for (auto eye : {Depth::Eye::Left, Depth::Eye::Right}) {
+            const auto image = grab(eye);
+            const int shift = std::abs(expectedShift(-1.0, eye, viewWidth()));
+            QVERIFY(shift > 4);
+
+            // It did move inside its opening.
+            QCOMPARE(shiftOf(flat, image, rect.adjusted(30, 10, -30, -10), 40), expectedShift(-1.0, eye, viewWidth()));
+            for (int y = rect.top(); y <= rect.bottom(); ++y) {
+                for (int x = rect.left() - shift; x < rect.left(); ++x) {
+                    QCOMPARE(image.pixel(x, y), flat.pixel(x, y));
+                }
+                for (int x = rect.right() + 1; x <= rect.right() + shift; ++x) {
+                    QCOMPARE(image.pixel(x, y), flat.pixel(x, y));
+                }
+            }
+        }
+    }
+
+    void testShadowStaysWhereItFalls()
+    {
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.5);
+
+        const auto flat = grab(Depth::Eye::None);
+        const auto left = grab(Depth::Eye::Left);
+        const auto rect = deviceRect(u"raised"_s);
+
+        // The hard shadow below the raised button, without its ends: it lies on the window, so
+        // it stays where it is, while the button above it moves.
+        if (flat.pixelColor(rect.left() + 4, rect.top() + 4) == QColor(Qt::white)) {
+            QSKIP("Union's rectangles are not drawn on this platform (the offscreen platform draws only text)");
+        }
+
+        const auto shadow = QRect(rect.left() + 12, rect.bottom() + 2, rect.width() - 24, 8);
+        QCOMPARE(flat.pixelColor(shadow.center()), QColor(Qt::black));
+        QCOMPARE(shiftOf(flat, left, shadow, 20), 0);
+
+        // While the button itself moved.
+        QVERIFY(expectedShift(0.5, Depth::Eye::Left, viewWidth()) != 0);
+        QCOMPARE(shiftOf(flat, left, rect.adjusted(30, 10, -30, -10), 40), expectedShift(0.5, Depth::Eye::Left, viewWidth()));
+        // So beside it, under its edge, its shadow shows.
+        const int shift = expectedShift(0.5, Depth::Eye::Left, viewWidth());
+        QCOMPARE(left.pixelColor(rect.left() + shift / 2, rect.bottom() - 2), QColor(Qt::black));
+        QVERIFY(flat.pixelColor(rect.left() + shift / 2, rect.bottom() - 2) != QColor(Qt::black));
+    }
+
+    void testPopupFitsTheStack()
+    {
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.5);
+
+        // A popped popup with a raised button in it is a stack of 1.5 steps: the window's
+        // popped side is fitted so the button in the popup sits at the limit.
+        auto popup = object(u"popup"_s);
+        QVERIFY(popup);
+        popup->setProperty("visible", true);
+
+        QTRY_COMPARE(depthOf(u"inPopup"_s), 1.0);
+        QCOMPARE(depthOf(u"popup"_s), 1.0 / 1.5);
+        QCOMPARE(depthOf(u"raised"_s), 0.5 / 1.5);
+        QCOMPARE(depthOf(u"onFrame"_s), 1.0 / 1.5);
+        // The sunk side keeps its own limit.
+        QCOMPARE(depthOf(u"checked"_s), -1.0);
+
+        popup->setProperty("visible", false);
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.5);
+        QCOMPARE(depthOf(u"onFrame"_s), 1.0);
+    }
+
+    void testModalOverlayFlattensTheContent()
+    {
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.5);
+
+        auto modal = object(u"modal"_s);
+        QVERIFY(modal);
+        modal->setProperty("visible", true);
+
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.0);
+        QCOMPARE(depthOf(u"checked"_s), 0.0);
+        QCOMPARE(depthOf(u"onFrame"_s), 0.0);
+        QCOMPARE(depthOf(u"modal"_s), 1.0);
+
+        modal->setProperty("visible", false);
+        QTRY_COMPARE(depthOf(u"raised"_s), 0.5);
+        QCOMPARE(depthOf(u"checked"_s), -1.0);
+    }
+};
+
+QTEST_MAIN(TestQuickDepth)
+
+#include "TestQuickDepth.moc"
