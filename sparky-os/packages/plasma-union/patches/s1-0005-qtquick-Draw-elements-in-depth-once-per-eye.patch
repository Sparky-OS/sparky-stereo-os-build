+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "DepthTestPlatformPlugin.h"
+
+using namespace Qt::StringLiterals;
+
+QString DepthTestPlatformPlugin::defaultStyleName()
+{
+    return u"depthtest"_s;
+}
+
+QList<std::filesystem::path> DepthTestPlatformPlugin::stylePackagePaths()
+{
+    return {std::filesystem::path(qEnvironmentVariable("UNION_TEST_STYLE_PATH").toStdString())};
+}
+
+qreal DepthTestPlatformPlugin::animationSpeedMultiplier()
+{
+    // Depth changes are measured where they end up.
+    return 0.0;
+}
+
+Union::Depth::Limits DepthTestPlatformPlugin::depthLimits()
+{
+    const auto values = qEnvironmentVariable("UNION_TEST_DEPTH_LIMITS", u"10,4"_s).split(u',');
+    return Union::Depth::Limits{.sunk = values.value(0).toDouble(), .popped = values.value(1).toDouble()};
+}
+
+bool DepthTestPlatformPlugin::depthEnabled([[maybe_unused]] QWindow *window)
+{
+    return qEnvironmentVariableIntValue("UNION_TEST_DEPTH_DISABLED") == 0;
+}
+
+#include "moc_DepthTestPlatformPlugin.cpp"
