+// Moves an item sideways for the eye being drawn. It is only created once an
+// element has to move, so a window that is never drawn per eye keeps its items
+// exactly as they are.
+class EyeShiftTransform : public QQuickTransform
+{
+public:
+    using QQuickTransform::QQuickTransform;
+
+    void applyTo(QMatrix4x4 *matrix) const override
+    {
+        if (m_shift != 0.0) {
+            matrix->translate(m_shift, 0.0);
+        }
+    }
+
+    void setShift(qreal shift)
+    {
+        if (shift == m_shift) {
+            return;
+        }
+
+        m_shift = shift;
+        update();
+    }
+
+private:
+    qreal m_shift = 0.0;
+};
+}
