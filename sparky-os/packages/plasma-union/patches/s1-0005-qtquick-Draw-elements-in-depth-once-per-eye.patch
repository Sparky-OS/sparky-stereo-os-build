+qreal QuickElement::depth() const
+{
+    return m_depthWindow ? m_depthWindow->depth(this) : Depth::Screen;
+}
+
+qreal QuickElement::shadowEyeShift() const
+{
+    return m_shadowEyeShift;
+}
+
+QQuickWindow *QuickElement::elementWindow() const
+{
+    if (auto window = qobject_cast<QQuickWindow *>(parent())) {
+        return window;
+    }
+
+    const auto items = shiftedItems();
+    return items.isEmpty() ? nullptr : items.first()->window();
+}
+
+QList<QQuickItem *> QuickElement::shiftedItems() const
+{
+    if (auto item = qobject_cast<QQuickItem *>(parent())) {
+        return {item};
+    }
+
+    // A popup is not an item: its background and content are.
+    QList<QQuickItem *> items;
+    if (isPopup()) {
+        for (const auto name : {"background", "contentItem"}) {
+            if (auto item = parent()->property(name).value<QQuickItem *>()) {
+                items.append(item);
+            }
+        }
+    }
+    return items;
+}
+
+bool QuickElement::isPopup() const
+{
+    return parent() && parent()->inherits("QQuickPopup");
+}
+
+bool QuickElement::isWindowRoot() const
+{
+    return qobject_cast<QQuickWindow *>(parent());
+}
+
+QuickElement *QuickElement::depthParent() const
+{
+    const auto window = elementWindow();
+    auto ancestor = parentElement();
+
+    if (isPopup()) {
+        // A popup lies over the whole window, or on the popup it was opened from.
+        while (ancestor && ancestor->elementWindow() == window) {
+            if (ancestor->isPopup() || ancestor->isWindowRoot()) {
+                return ancestor;
+            }
+            ancestor = ancestor->parentElement();
+        }
+        return nullptr;
+    }
+
+    return ancestor && ancestor->elementWindow() == window ? ancestor : nullptr;
+}
+
+void QuickElement::updateDepth()
+{
+    if (!m_completed) {
+        return;
+    }
+
+    auto window = elementWindow();
+    auto depthWindow = window ? DepthWindow::get(window) : nullptr;
+    if (depthWindow != m_depthWindow) {
+        // Removing an element can change the window's state, which calls this again.
+        const QPointer<DepthWindow> previous = m_depthWindow;
+        m_depthWindow = depthWindow;
+        if (previous) {
+            disconnect(previous, nullptr, this, nullptr);
+            previous->removeElement(this);
+        }
+
+        updateEyeShift();
+
+        if (m_depthWindow) {
+            connect(m_depthWindow, &DepthWindow::stateChanged, this, &QuickElement::updateDepth);
+        }
+    }
+
+    const auto items = shiftedItems();
+    auto item = items.value(0);
+    if (item != m_watchedItem) {
+        if (m_watchedItem) {
+            disconnect(m_watchedItem, nullptr, this, nullptr);
+        }
+        m_watchedItem = item;
+        if (m_watchedItem) {
+            connect(m_watchedItem, &QQuickItem::windowChanged, this, &QuickElement::updateDepth);
+            connect(m_watchedItem, &QQuickItem::visibleChanged, this, &QuickElement::updateDepth);
+        }
+    }
+
+    if (!m_depthWindow) {
+        return;
+    }
+
+    // What is not shown takes no place: a closed menu does not push the others down.
+    const bool visible = isWindowRoot() || (item && item->isVisible());
+
+    if (m_element->type() == u"Overlay"_s) {
+        m_depthWindow->setModalOverlay(this, visible && m_element->hints().contains(u"modal"_s));
+    }
+
+    if (!visible) {
+        m_depthWindow->removeElement(this);
+        updateEyeShift();
+        depthUpdated();
+        return;
+    }
+
+    auto parent = depthParent();
+
+    // The top element of a surface lies at the surface: where the surface itself
+    // sits is the compositor's.
+    const bool surfaceTop = isWindowRoot() || (!parent && parentElement());
+
+    qreal relativeDepth = Depth::Screen;
+    if (!surfaceTop) {
+        relativeDepth = Depth::elementDepth(m_query && m_query->hasMatches() ? m_query->properties() : nullptr);
+    }
+
+    bool atOutputEdge = false;
+    const auto edges = m_depthWindow->outputEdges();
+    if (edges && item && window) {
+        const auto rect = item->mapRectToScene(item->boundingRect());
+        atOutputEdge = (edges.testFlag(Qt::LeftEdge) && rect.left() <= 0.5) || (edges.testFlag(Qt::TopEdge) && rect.top() <= 0.5)
+            || (edges.testFlag(Qt::RightEdge) && rect.right() >= window->width() - 0.5)
+            || (edges.testFlag(Qt::BottomEdge) && rect.bottom() >= window->height() - 0.5);
+    }
+
+    // Under a modal overlay the window's content lies flat; the popups over it keep their places.
+    const bool flat = m_depthWindow->hasModalOverlay() && !isPopup() && !isWindowRoot() && (!parent || parent->isWindowRoot());
+
+    m_depthWindow->setElement(this, parent, relativeDepth, atOutputEdge, flat);
+
+    if (!m_depthWindow->isEnabled()) {
+        updateEyeShift();
+        depthUpdated();
+    }
+}
+
+void QuickElement::depthUpdated()
+{
+    const bool enabled = m_depthWindow && m_depthWindow->isEnabled();
+
+    // The parallax, for a renderer that draws the window once per eye itself.
+    const auto items = shiftedItems();
+    for (auto item : items) {
+        if (enabled) {
+            item->setProperty(Depth::ParallaxProperty, m_depthWindow->parallax(this));
+        } else if (item->property(Depth::ParallaxProperty).isValid()) {
+            item->setProperty(Depth::ParallaxProperty, QVariant{});
+        }
+    }
+
+    Q_EMIT depthChanged();
+}
+
+void QuickElement::updateEyeShift()
+{
+    const qreal shift = m_depthWindow ? m_depthWindow->relativeShift(this) : 0.0;
+    const auto items = shiftedItems();
+    const bool deeper = shift != 0.0 && items.size() == 1 && m_depthWindow->isDeeper(this);
+
+    QList<QQuickItem *> shifted;
+    if (deeper) {
+        // Behind what it lies on, the element is seen through its own opening: it
+        // is cut to its own rectangle, as the frame of a window cuts the view
+        // through it, so nothing is drawn behind what it covers.
+        auto item = items.first();
+        if (m_clippedItem != item) {
+            restoreClip();
+            m_clippedItem = item;
+            m_clipWasSet = item->clip();
+        }
+        item->setClip(true);
+
+        shifted = item->childItems();
+    } else {
+        restoreClip();
+        shifted = items;
+    }
+
+    for (auto item : std::as_const(shifted)) {
+        setEyeShift(item, shift);
+    }
+    for (auto itr = m_eyeShifts.cbegin(); itr != m_eyeShifts.cend(); ++itr) {
+        if (itr.value() && !shifted.contains(itr.key())) {
+            itr.value()->setShift(0.0);
+        }
+    }
+
+    const qreal shadowShift = deeper ? 0.0 : shift;
+    if (shadowShift != m_shadowEyeShift) {
+        m_shadowEyeShift = shadowShift;
+        Q_EMIT eyeShiftChanged();
+    }
+}
+
+void QuickElement::setEyeShift(QQuickItem *item, qreal shift)
+{
+    auto itr = m_eyeShifts.find(item);
+    if (itr == m_eyeShifts.end() || !itr.value()) {
+        if (shift == 0.0) {
+            return;
+        }
+
+        auto transform = new EyeShiftTransform(this);
+        transform->appendToItem(item);
+        itr = m_eyeShifts.insert(item, transform);
+        connect(item, &QObject::destroyed, this, [this, item]() {
+            m_eyeShifts.remove(item);
+        });
+    }
+
+    itr.value()->setShift(shift);
+}
+
+void QuickElement::restoreClip()
+{
+    if (m_clippedItem) {
+        m_clippedItem->setClip(m_clipWasSet);
+    }
+    m_clippedItem = nullptr;
+}
+
 void Quick::QuickElement::updateStyleFromParent()
