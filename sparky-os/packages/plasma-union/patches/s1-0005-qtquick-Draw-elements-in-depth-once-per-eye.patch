+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+ */
+
+applicationwindow, page, pane {
+    background-color: #ffffff;
+}
+
+button {
+    width: 120px;
+    height: 48px;
+    padding: 4px;
+    text-alignment: content center center 0;
+    color: #000000;
+    background-color: #ffd040;
+    /* A hard shadow, so it can be found: the element rises one step. */
+    box-shadow: 0px 12px 0px 0px rgba(0, 0, 0, 1.0);
+}
+
+button:pressed {
+    box-shadow: none;
+}
+
+button:checked {
+    background-color: #40c0ff;
+    box-shadow: none;
+    depth: sunk;
+}
+
+button.flat {
+    background-color: #a0e070;
+    box-shadow: none;
+}
+
+frame {
+    background-color: #e0e0e0;
+    depth: 50%;
+}
+
+popup {
+    background-color: #f0a0f0;
+    padding: 8px;
+    depth: popped;
+}
