[Unit]
Description=Sparky Stereo OS: a problem of the time servers was kept
Documentation=file:///usr/share/doc/sparky-stereo-time/README.md
# people's sessions only: the login screen's accounts are system users
ConditionUser=!@system

[Path]
PathChanged=/var/lib/sparky-stereo-time/problems
Unit=sparky-stereo-time-problems.service

[Install]
WantedBy=graphical-session.target
