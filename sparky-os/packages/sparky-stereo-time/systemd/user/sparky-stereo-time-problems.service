[Unit]
Description=Sparky Stereo OS: show the kept problems of the time servers
Documentation=file:///usr/share/doc/sparky-stereo-time/README.md
# people's sessions only: the login screen's accounts are system users
ConditionUser=!@system
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sparky-stereo-time --notify

[Install]
WantedBy=graphical-session.target
