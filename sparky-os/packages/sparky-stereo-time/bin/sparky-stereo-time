#!/bin/bash
#
# Created by Paweł "pavroo" Pijanowski and Daniel Ramos (Capitain Jack) 2026/10/02
# Copyright 2026 under the GNU GPL3 License
# Sets chrony's time sources from the timezone: the country's official service (with NTS where
# it offers it), or its country pool where the country has none. The zone comes from /etc/localtime,
# the country from zone.tab, then zone1970.tab (as sparky-ntp-server does), then tzdata.zi links.
# Nothing fails silently (Daniel, 2026-11-01): a catalogue or timezone that cannot be read, sources
# that cannot be written, a chrony that does not take them and servers that do not answer are said,
# kept by sparky-stereo-problems (lib/problems.py) and shown in the session; the
# sources in use are then left as they were, never replaced by another choice.
# Last update 2026/11/02

TSV=${SPARKY_TIME_TSV:-/usr/share/sparky-stereo-time/ntp-countries.tsv}
ZONEINFO=${SPARKY_TIME_ZONEINFO:-/usr/share/zoneinfo}
LOCALTIME=${SPARKY_TIME_LOCALTIME:-/etc/localtime}
TIMEZONE_FILE=${SPARKY_TIME_TIMEZONE_FILE:-/etc/timezone}
OUT=${SPARKY_TIME_OUT:-/etc/chrony/sources.d/sparky-stereo.sources}
# With two or more NTS servers prefer authenticated sources (chrony.conf(5)).
AUTHCONF=${SPARKY_TIME_AUTHCONF:-}
if [ -z "$AUTHCONF" ]; then
	if [ -n "${SPARKY_TIME_OUT:-}" ]; then AUTHCONF=$(dirname "$SPARKY_TIME_OUT")/sparky-stereo-auth.conf
	else AUTHCONF=/etc/chrony/conf.d/sparky-stereo-auth.conf; fi
fi
POOLS=${SPARKY_TIME_POOLS:-/usr/share/sparky-stereo-time/ntp-pools.txt}
LANGDIR=${SPARKY_TIME_LANGDIR:-/usr/share/sparky/sparky-stereo-time}
PROBLEMS=${SPARKY_TIME_PROBLEMS:-/usr/lib/sparky-stereo-time/problems.py}
export SPARKY_TIME_LANGDIR=$LANGDIR
CHRONYC=${SPARKY_TIME_CHRONYC:-chronyc}
IP=${SPARKY_TIME_IP:-ip}
SYSTEMCTL=${SPARKY_TIME_SYSTEMCTL:-systemctl}
SYSTEMD_DIR=${SPARKY_TIME_SYSTEMD_DIR:-/run/systemd/system}
# a check waits this long after chrony's start or a change of the sources: iburst and the NTS key
# exchange need a few seconds, the reachability register a few polls
SETTLE_MIN=3
ZONE=
PRINT=0
RELOAD=1
ACTION=set

# strings: the whole LANG=xx_YY, then xx, then English
LANGCODE=${LANG%%.*}
case "$LANGCODE" in ""|C|POSIX)
	LANGCODE=$(sed -n 's/^LANG=//p' /etc/default/locale 2>/dev/null | tr -d '"' | cut -d. -f1) ;;
esac
for c in "$LANGCODE" "${LANGCODE%%_*}" en; do
	[ -f "$LANGDIR/$c" ] && { . "$LANGDIR/$c"; break; }
done
if [ -z "${LOCAL1:-}" ]; then
	echo "sparky-stereo-time: its messages are missing ($LANGDIR/en): sudo apt-get install --reinstall sparky-stereo-time" >&2
	exit 3
fi

usage() {
	printf '%s\n' "$LOCAL1"
	printf '  --zone ZONE   %s\n' "$LOCAL2"
	printf '  --print       %s\n' "$LOCAL3"
	printf '  --no-reload   %s\n' "$LOCAL4"
	printf '  --check       %s\n' "$LOCAL38"
	printf '  --status      %s\n' "$LOCAL39"
	printf '  --repair      %s\n' "$LOCAL40"
	printf '  --dismiss STEP %s\n' "$LOCAL41"
	exit "${1:-0}"
}

problems() { python3 "$PROBLEMS" "$@"; }

while [ $# -gt 0 ]; do
	case "$1" in
		--zone) [ -n "${2:-}" ] || usage 2; ZONE=$2; shift ;;
		--print) PRINT=1; RELOAD=0 ;;
		--no-reload) RELOAD=0 ;;
		--check) ACTION=check ;;
		--status) exec python3 "$PROBLEMS" status ;;
		--repair) ACTION=repair ;;
		--dismiss) [ -n "${2:-}" ] || usage 2; ACTION=dismiss; STEP=$2; shift ;;
		--notify) exec python3 "$PROBLEMS" notify ;;
		-h|--help) usage 0 ;;
		*) usage 2 ;;
	esac
	shift
done

# dismiss is the engine's Hide, the person's own (ORDER 350): no administrator
[ "$ACTION" = dismiss ] && exec python3 "$PROBLEMS" dismiss "$STEP"
# a root check, unless nothing is written to the system
if [ "$PRINT" = 0 ] && [ -z "${SPARKY_TIME_OUT:-}" ] && [ "$(id -u)" -ne 0 ]; then
	printf '%s\n' "$LOCAL5" >&2
	exit 1
fi
case $ACTION in
	repair) exec python3 "$PROBLEMS" repair ;;
esac

# a problem: said and kept (only said with --print, which writes nothing), then the exit status;
# the sources in use are left as they are
fail() { # exit-status step key args...
	local code=$1 step=$2
	shift 2
	if [ "$PRINT" = 1 ]; then problems say "$@"
	else problems record "$step" "$@" --repair "${SPARKY_TIME_SELF:-/usr/bin/sparky-stereo-time}"; fi
	exit "$code"
}

zone_name() {
	local t=$LOCALTIME i
	if [ -L "$t" ]; then
		# follow the links by hand: the zone file itself may be missing (tzdata-legacy)
		for i in 1 2 3 4 5 6 7 8; do
			case "$t" in */zoneinfo/*) break ;; esac
			[ -L "$t" ] || break
			t=$(readlink "$t")
		done
		case "$t" in */zoneinfo/*)
			t=${t##*/zoneinfo/}
			t=${t#posix/}
			echo "${t#right/}"
			return ;;
		esac
	fi
	if [ -s "$TIMEZONE_FILE" ]; then
		head -n1 "$TIMEZONE_FILE" | tr -d ' \t\r'
		return
	fi
}

# country code of a zone: zone.tab, then zone1970.tab (only when one country owns the entry),
# then the zone's canonical name when it is a backward link (Asia/Calcutta)
codes_for() {
	local z=$1 c f
	for f in zone.tab zone1970.tab; do
		[ -f "$ZONEINFO/$f" ] || continue
		c=$(awk -F'\t' -v z="$z" '!/^#/ && $3 == z { print $1; exit }' "$ZONEINFO/$f")
		# a zone1970 entry shared by several countries does not say which one the zone is in
		[ "$f" = zone1970.tab ] && case "$c" in *,*) c= ;; esac
		[ -n "$c" ] && { echo "$c"; return; }
	done
	return 1
}

country_for() {
	local z=$1 c t
	c=$(codes_for "$z") && { echo "$c"; return; }
	if [ -f "$ZONEINFO/tzdata.zi" ]; then
		t=$(awk -v z="$z" '$1 == "L" && $3 == z { print $2; exit }' "$ZONEINFO/tzdata.zi")
		[ -n "$t" ] && codes_for "$t"
	fi
}

# what chrony is doing: active, failed, inactive, or none when systemd does not run (a chroot, a container)
chrony_state() {
	[ -d "$SYSTEMD_DIR" ] || { echo none; return; }
	case $($SYSTEMCTL is-active chrony.service 2>/dev/null) in
		active|activating|reloading|refreshing) echo active ;;
		failed) echo failed ;;
		*) echo inactive ;;
	esac
}

# --check: do the time servers this tool chose answer? A server that never answered in chrony's
# reachability register is not reached; when none of them is, the clock follows something else or
# nothing, and that is said and kept, never left to chrony's quiet choice
check() {
	local hosts h rows rc reach reached= unreached= follows active now mtime
	if [ ! -r "$OUT" ]; then problems say LOCAL47 "$OUT"; exit 4; fi
	hosts=$(awk '$1 == "server" || $1 == "pool" { print $2 }' "$OUT" | tr '\n' ' ')
	hosts=${hosts% }
	if [ -z "$($IP -4 route show default 2>/dev/null)$($IP -6 route show default 2>/dev/null)" ]; then
		problems say LOCAL21; exit 0
	fi
	case $(chrony_state) in
		failed) problems record chrony LOCAL15 "$OUT" --repair "$SYSTEMCTL" restart chrony.service; exit 4 ;;
		inactive) problems say LOCAL33; exit 4 ;;
	esac
	now=$(date +%s)
	mtime=$(stat -c %Y "$OUT")
	active=$($SYSTEMCTL show -p ActiveEnterTimestamp --value chrony.service 2>/dev/null)
	active=$(date -d "$active" +%s 2>/dev/null || echo 0)
	if [ $((now - mtime)) -lt $((SETTLE_MIN * 60)) ] || [ $((now - active)) -lt $((SETTLE_MIN * 60)) ]; then
		problems say LOCAL34 "$SETTLE_MIN"; exit 0
	fi
	rows=$($CHRONYC -N -c sources 2>&1)
	rc=$?
	if [ "$rc" -ne 0 ]; then
		problems record chrony LOCAL48 "$CHRONYC -N -c sources" "$rc" "$(printf '%s' "$rows" | head -n1)" \
			--repair "${SPARKY_TIME_SELF:-/usr/bin/sparky-stereo-time}" --check
		exit 4
	fi
	for h in $hosts; do
		# CSV: mode, state, name (as configured, -N), stratum, poll, reach (octal), ...
		reach=$(printf '%s\n' "$rows" | awk -F, -v h="$h" '$3 == h && $6 != "0" { print $6; exit }')
		if [ -n "$reach" ]; then reached+="${reached:+, }$h"; else unreached+="${unreached:+, }$h"; fi
	done
	follows=$(printf '%s\n' "$rows" | awk -F, '$2 == "*" { print $3; exit }')
	if [ -z "$reached" ]; then
		if [ -n "$follows" ]; then
			problems record reach LOCAL17 "$(zone_label)" "$unreached" "@LOCAL19:$follows" \
				--repair "${SPARKY_TIME_SELF:-/usr/bin/sparky-stereo-time}" --check
		else
			problems record reach LOCAL17 "$(zone_label)" "$unreached" @LOCAL18 \
				--repair "${SPARKY_TIME_SELF:-/usr/bin/sparky-stereo-time}" --check
		fi
		exit 5
	fi
	problems clear reach chrony
	printf "$LOCAL20"'\n' "$reached"
	if [ -n "$follows" ]; then printf "$LOCAL49"'\n' "$follows"; else printf '%s\n' "$LOCAL18"; fi
	exit 0
}

zone_label() {
	local z=${ZONE:-$(zone_name)} c
	c=$(country_for "$z" 2>/dev/null | head -n1)
	if [ -n "$c" ]; then echo "$c ($z)"; else echo "$z"; fi
}

[ "$ACTION" = check ] && check

[ -n "$ZONE" ] || ZONE=$(zone_name)
if [ -z "$ZONE" ]; then
	fail 3 zone LOCAL11 "$LOCALTIME" "$ZONEINFO" "$TIMEZONE_FILE"
fi
# the catalogue of the countries' servers: read, or said; never taken as "no service" when it fails
if [ ! -e "$TSV" ]; then
	fail 3 catalogue LOCAL10 "$TSV" "$(LC_ALL=C cat "$TSV" 2>&1 >/dev/null | sed 's/^cat: .*: //')"
fi
CATALOGUE=$(LC_ALL=C grep -v -e '^#' -e '^[[:space:]]*$' "$TSV" 2>&1)
case $? in
	0) ;;
	1) fail 3 catalogue LOCAL10 "$TSV" "@LOCAL36" ;;
	*) fail 3 catalogue LOCAL10 "$TSV" "$(printf '%s' "$CATALOGUE" | head -n1 | sed 's/^grep: .*: //')" ;;
esac
# the timezone tables that name the country: one of them is needed
if [ ! -r "$ZONEINFO/zone.tab" ] && [ ! -r "$ZONEINFO/zone1970.tab" ]; then
	why=$(LC_ALL=C cat "$ZONEINFO/zone1970.tab" 2>&1 >/dev/null | sed 's/^cat: .*: //')
	fail 3 zone LOCAL12 "$ZONEINFO" "${why:-unreadable}" "$ZONE"
fi
CC=$(country_for "$ZONE")
[ -n "$CC" ] || fail 3 zone LOCAL53 "$ZONE"
ROW=$(printf '%s\n' "$CATALOGUE" | awk -F'\t' -v c="$CC" '$1 == c { print; exit }')

LINES=
COUNT=0
NTSCOUNT=0
PLAINCOUNT=0
USED=
if [ -n "$ROW" ]; then
	servers=$(echo "$ROW" | cut -f2)
	nts=$(echo "$ROW" | cut -f3)
	for h in $servers; do
		[ "$h" = - ] && continue
		case " $nts " in
			*" $h "*) LINES+="server $h iburst nts"$'\n'; NTSCOUNT=$((NTSCOUNT + 1)); USED+="${USED:+, }$h (NTS)" ;;
			*) LINES+="server $h iburst"$'\n'; PLAINCOUNT=$((PLAINCOUNT + 1)); USED+="${USED:+, }$h" ;;
		esac
		COUNT=$((COUNT + 1))
	done
fi
if [ "$COUNT" -eq 0 ]; then
	[ -r "$POOLS" ] || fail 3 catalogue LOCAL10 "$POOLS" "unreadable"
	grep -qx "${CC,,}" "$POOLS" || fail 3 zone LOCAL54 "$CC"
	LINES+="pool ${CC,,}.pool.ntp.org iburst"$'\n'
	USED="${CC,,}.pool.ntp.org"
	WHAT=$(printf "$LOCAL7" "$ZONE" "$USED")
else
	WHAT=$(printf "$LOCAL6" "$CC" "$ZONE")
fi

AUTH=
[ "$NTSCOUNT" -ge 2 ] && AUTH="# Sparky Stereo OS: written by sparky-stereo-time, do not edit
authselectmode prefer
"
CONTENT="# Sparky Stereo OS: written by sparky-stereo-time from the timezone, do not edit
${LINES}"
if [ "$PRINT" = 1 ]; then
	printf '%s' "$CONTENT"
	[ -n "$AUTH" ] && echo "# conf.d: authselectmode prefer"
	exit 0
fi

# writes FILE with CONTENT through FILE.new; on failure WHY says why and nothing is left half written
put() {
	why=$( { mkdir -p "$(dirname "$1")" && printf '%s' "$2" >"$1.new" && mv "$1.new" "$1"; } 2>&1 ) && return 0
	rm -f "$1.new" 2>/dev/null
	why=${why:-exit status 1}
	return 1
}

# Debian owns chrony.conf through ucf. Pass it a changed vendor template; never edit
# the person's configuration directly. Tests with an alternate sources path opt in explicitly.
CONFCHANGED=0
if [ -z "${SPARKY_TIME_OUT:-}" ] || [ -n "${SPARKY_TIME_CHRONY_CONF:-}" ]; then
	CONFIGURE=${SPARKY_TIME_CONFIGURE:-/usr/lib/sparky-stereo-time/chrony-config}
	why=$("$CONFIGURE" apply 2>&1); rc=$?
	case $rc in
		0) ;;
		10) CONFCHANGED=1 ;;
		20) fail 4 configuration LOCAL55 "${SPARKY_TIME_CHRONY_CONF:-/etc/chrony/chrony.conf}" ;;
		*) fail 4 configuration LOCAL56 "$why" ;;
	esac
	problems clear configuration
fi

# conf.d is read only at chrony's start: a changed authselectmode needs a restart
if [ -n "$AUTH" ]; then
	if [ "$(cat "$AUTHCONF" 2>/dev/null)" != "${AUTH%$'\n'}" ]; then
		put "$AUTHCONF" "$AUTH" || fail 4 write LOCAL13 "$AUTHCONF" "$why"
		CONFCHANGED=1
	fi
elif [ -e "$AUTHCONF" ]; then
	why=$(rm -f "$AUTHCONF" 2>&1) || fail 4 write LOCAL13 "$AUTHCONF" "$why"
	CONFCHANGED=1
fi

if [ ! -f "$OUT" ] || [ "$(cat "$OUT")" != "${CONTENT%$'\n'}" ]; then
	put "$OUT" "$CONTENT" || fail 4 write LOCAL13 "$OUT" "$why"
	printf '%s\n' "$WHAT"
else
	printf '%s\n' "$LOCAL9"
fi
printf "$LOCAL35"'\n' "$USED"
problems clear catalogue zone write

# also when nothing changed: an earlier reload may have failed while chrony was starting
if [ "$RELOAD" = 1 ]; then
	case $(chrony_state) in
	active)
		if [ "$CONFCHANGED" = 1 ]; then
			problems run apply LOCAL14 "$OUT" --repair "${SPARKY_TIME_SELF:-/usr/bin/sparky-stereo-time}" -- \
				$SYSTEMCTL try-restart chrony.service >/dev/null || exit 4
		else
			problems run apply LOCAL14 "$OUT" --repair "${SPARKY_TIME_SELF:-/usr/bin/sparky-stereo-time}" -- \
				$CHRONYC reload sources >/dev/null || exit 4
		fi
		problems clear chrony
		;;
	failed)
		problems record chrony LOCAL15 "$OUT" --repair "$SYSTEMCTL" restart chrony.service
		exit 4
		;;
	inactive)
		# not running (stopped, or not started yet): it reads the sources when it starts
		printf '%s\n' "$LOCAL8"
		problems clear apply chrony
		;;
	none)
		# no systemd: a chrony started by hand is told; none running reads the sources when it starts
		if out=$($CHRONYC reload sources 2>&1); then
			[ "$CONFCHANGED" = 1 ] && printf "$LOCAL37"'\n' "$AUTHCONF"
			problems clear apply
		else
			case $out in
				*"Cannot talk to daemon"*) printf '%s\n' "$LOCAL8"; problems clear apply ;;
				*) problems run apply LOCAL14 "$OUT" --repair "${SPARKY_TIME_SELF:-/usr/bin/sparky-stereo-time}" -- \
					$CHRONYC reload sources >/dev/null || exit 4 ;;
			esac
		fi
		;;
	esac
fi
exit 0
