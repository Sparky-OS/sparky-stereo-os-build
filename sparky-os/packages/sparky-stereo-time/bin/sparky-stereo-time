#!/bin/bash
#
# Created by Paweł "pavroo" Pijanowski and Daniel Ramos (Capitain Jack) 2026/10/02
# Copyright 2026 under the GNU GPL3 License
# Sets chrony's time sources from the timezone: the country's official service (with NTS where
# it offers it), or Debian's pool where the country has none. The zone comes from /etc/localtime,
# the country from zone.tab, then zone1970.tab (as sparky-ntp-server does), then tzdata.zi links.
# Last update 2026/10/02

TSV=${SPARKY_TIME_TSV:-/usr/share/sparky-stereo-time/ntp-countries.tsv}
ZONEINFO=${SPARKY_TIME_ZONEINFO:-/usr/share/zoneinfo}
LOCALTIME=${SPARKY_TIME_LOCALTIME:-/etc/localtime}
TIMEZONE_FILE=${SPARKY_TIME_TIMEZONE_FILE:-/etc/timezone}
OUT=${SPARKY_TIME_OUT:-/etc/chrony/sources.d/sparky-stereo.sources}
# chrony.conf is edited only for the real system, or where a test points SPARKY_TIME_CONF
CONF=${SPARKY_TIME_CONF:-}
[ -n "$CONF" ] || [ -n "${SPARKY_TIME_OUT:-}" ] || CONF=/etc/chrony/chrony.conf
DEBIAN_POOL='pool 2.debian.pool.ntp.org iburst'
MARK='#sparky-stereo: '
FALLBACK='pool debian.pool.ntp.org iburst'
LANGDIR=/usr/share/sparky/sparky-stereo-time
[ -d "$LANGDIR" ] || LANGDIR=$(dirname "$0")/../lang
ZONE=
PRINT=0
RELOAD=1

# strings: the whole LANG=xx_YY, then xx, then English
LANGCODE=${LANG%%.*}
case "$LANGCODE" in ""|C|POSIX)
	LANGCODE=$(sed -n 's/^LANG=//p' /etc/default/locale 2>/dev/null | tr -d '"' | cut -d. -f1) ;;
esac
for c in "$LANGCODE" "${LANGCODE%%_*}" en; do
	[ -f "$LANGDIR/$c" ] && { . "$LANGDIR/$c"; break; }
done

usage() {
	printf '%s\n' "$LOCAL1"
	printf '  --zone ZONE   %s\n' "$LOCAL2"
	printf '  --print       %s\n' "$LOCAL3"
	printf '  --no-reload   %s\n' "$LOCAL4"
	exit "${1:-0}"
}

while [ $# -gt 0 ]; do
	case "$1" in
		--zone) [ -n "${2:-}" ] || usage 2; ZONE=$2; shift ;;
		--print) PRINT=1; RELOAD=0 ;;
		--no-reload) RELOAD=0 ;;
		-h|--help) usage 0 ;;
		*) usage 2 ;;
	esac
	shift
done

# a root check, unless nothing is written to the system
if [ "$PRINT" = 0 ] && [ -z "${SPARKY_TIME_OUT:-}" ] && [ "$(id -u)" -ne 0 ]; then
	printf '%s\n' "$LOCAL5" >&2
	exit 1
fi

zone_name() {
	local t=$LOCALTIME i
	if [ -L "$t" ]; then
		# follow the links by hand: the zone file itself may be missing (tzdata-legacy)
		for i in 1 2 3 4 5 6 7 8; do
			case "$t" in */zoneinfo/*) break ;; esac
			[ -L "$t" ] || break
			t=$(readlink "$t")
		done
		case "$t" in */zoneinfo/*)
			t=${t##*/zoneinfo/}
			t=${t#posix/}
			echo "${t#right/}"
			return ;;
		esac
	fi
	if [ -s "$TIMEZONE_FILE" ]; then
		head -n1 "$TIMEZONE_FILE" | tr -d ' \t\r'
		return
	fi
}

# country code of a zone: zone.tab, then zone1970.tab (only when one country owns the entry),
# then the zone's canonical name when it is a backward link (Asia/Calcutta)
codes_for() {
	local z=$1 c f
	for f in zone.tab zone1970.tab; do
		[ -f "$ZONEINFO/$f" ] || continue
		c=$(awk -F'\t' -v z="$z" '!/^#/ && $3 == z { print $1; exit }' "$ZONEINFO/$f")
		# a zone1970 entry shared by several countries does not say which one the zone is in
		[ "$f" = zone1970.tab ] && case "$c" in *,*) c= ;; esac
		[ -n "$c" ] && { echo "$c"; return; }
	done
	return 1
}

country_for() {
	local z=$1 c t
	c=$(codes_for "$z") && { echo "$c"; return; }
	if [ -f "$ZONEINFO/tzdata.zi" ]; then
		t=$(awk -v z="$z" '$1 == "L" && $3 == z { print $2; exit }' "$ZONEINFO/tzdata.zi")
		[ -n "$t" ] && codes_for "$t"
	fi
}

[ -n "$ZONE" ] || ZONE=$(zone_name)
CC=
ROW=
if [ -n "$ZONE" ]; then
	for c in $(country_for "$ZONE"); do
		r=$(awk -F'\t' -v c="$c" '!/^#/ && $1 == c { print; exit }' "$TSV" 2>/dev/null)
		[ -n "$r" ] && { CC=$c; ROW=$r; break; }
	done
fi

LINES=
COUNT=0
if [ -n "$ROW" ]; then
	servers=$(echo "$ROW" | cut -f2)
	nts=$(echo "$ROW" | cut -f3)
	for h in $servers; do
		[ "$h" = - ] && continue
		case " $nts " in
			*" $h "*) LINES+="server $h iburst nts"$'\n' ;;
			*) LINES+="server $h iburst"$'\n' ;;
		esac
		COUNT=$((COUNT + 1))
	done
fi
# fewer than three national sources: Debian's pool completes them; none: the pool alone
if [ "$COUNT" -eq 0 ]; then
	LINES+="$FALLBACK"$'\n'
	WHAT=$(printf "$LOCAL7" "${ZONE:-?}")
elif [ "$COUNT" -lt 3 ]; then
	LINES+="$FALLBACK maxsources 2"$'\n'
	WHAT=$(printf "$LOCAL6" "$CC" "$ZONE")
else
	WHAT=$(printf "$LOCAL6" "$CC" "$ZONE")
fi

CONTENT="# Sparky Stereo OS: written by sparky-stereo-time from the timezone, do not edit
${LINES}"
if [ "$PRINT" = 1 ]; then
	printf '%s' "$CONTENT"
	exit 0
fi

# Debian's own pool line would run next to ours: comment it out, marked so postrm restores it
CONFCHANGED=0
if [ -n "$CONF" ] && [ -f "$CONF" ] && grep -q -x -F "$DEBIAN_POOL" "$CONF"; then
	sed -i "s|^$DEBIAN_POOL\$|$MARK$DEBIAN_POOL|" "$CONF"
	CONFCHANGED=1
fi

mkdir -p "$(dirname "$OUT")"
if [ ! -f "$OUT" ] || [ "$(cat "$OUT")" != "${CONTENT%$'\n'}" ]; then
	printf '%s' "$CONTENT" >"$OUT.new" && mv "$OUT.new" "$OUT"
	printf '%s\n' "$WHAT"
else
	printf '%s\n' "$LOCAL9"
fi
# also when nothing changed: an earlier reload may have failed while chrony was starting
if [ "$RELOAD" = 1 ]; then
	if [ "$CONFCHANGED" = 1 ] && [ -d /run/systemd/system ]; then
		# chrony.conf is read only at start
		systemctl try-restart chrony.service >/dev/null 2>&1 || printf '%s\n' "$LOCAL8"
	elif command -v chronyc >/dev/null 2>&1; then
		chronyc reload sources >/dev/null 2>&1 || printf '%s\n' "$LOCAL8"
	fi
fi
exit 0
