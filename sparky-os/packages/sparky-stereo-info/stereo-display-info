#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
#
# What each connected display says about stereo 3D and deep colour, read from its EDID
# with edid-decode. The HDMI 3D formats a display always has once it announces 3D are
# the ones the kernel adds for it (drivers/gpu/drm/drm_edid.c, stereo_mandatory_modes).
# When a desktop session is reachable it also says what each display is doing now, read
# with kscreen-doctor -o (read-only). Nothing here changes a mode or a setting.
# A probe that is missing, times out or fails is said in the stack block ("could not be read" or
# "could not be checked", with the tool and why), never left out or reported as "not announced"
# (ORDER 346f-3, U41; Daniel, 2026-11-01: "either it works or not and the user must know").

set -eu

# The person-readable text is in the edition's nine languages (ORDER 346f-3b; memory required-languages): the same lang/ files
# as every shell tool of the edition (LOCAL1="..."), found by LANGUAGE (KInfoCenter's rule for the tools it runs), then
# LC_ALL, LC_MESSAGES and LANG: the whole code, then the bare language (a list that starts with English, en_US:pt_BR, is English),
# then English. English is always read first, so a
# string a language lacks is shown in English. In a string, %1 to %4 are replaced by the values, so a language puts them in
# its own order. What a program reads is never translated: the --keys fields, the "@@ kind name" lines of --sections, and
# the English words the script itself tests (structure and format names) stay as they are inside and are translated only
# where they are printed.
LANGDIR=${SPARKY_STEREO_INFO_LANGDIR:-/usr/share/sparky/sparky-stereo-info}
DRM=${SPARKY_STEREO_INFO_DRM:-/sys/class/drm}
set -a
. "$LANGDIR/en"
chosen=
for code in $(printf '%s' "${LANGUAGE:-}" | tr ':' ' ') "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"; do
    code=${code%%.*}
    code=${code%%@*}
    case $code in
        zh_HK | zh_MO) code=zh_TW ;;
        zh_SG | zh) code=zh_CN ;;
    esac
    for file in "$code" "${code%%_*}"; do
        [ -n "$file" ] && [ -f "$LANGDIR/$file" ] && chosen=$file && break
    done
    [ -z "$chosen" ] || break
done
[ -z "$chosen" ] || [ "$chosen" = en ] || . "$LANGDIR/$chosen"
set +a

# What every awk program below uses: L(n) is LOCALn, fill() puts values in a string's %1 to %4 (never as a format, so a value
# with a % or a & stays as it is), F(n, ...) is both, and sname() / pname() translate the English names the programs keep
# inside (HDMI 3D structures, colour profiles) where they are printed.
AWKLIB='
function L(n) { return ENVIRON["LOCAL" n] }
function fill(t, a1, a2, a3, a4,   out, c) {
    out = ""
    while (match(t, /%[1-4]/) > 0) {
        c = substr(t, RSTART + 1, 1)
        out = out substr(t, 1, RSTART - 1) (c == 1 ? a1 : c == 2 ? a2 : c == 3 ? a3 : a4)
        t = substr(t, RSTART + RLENGTH)
    }
    return out t
}
function F(n, a1, a2, a3, a4) { return fill(L(n), a1, a2, a3, a4) }
function sname(s) {
    if (s == "frame packing") return L(16)
    if (s == "side by side (half)") return L(14)
    if (s == "side by side (full)") return L(13)
    if (s == "top and bottom") return L(15)
    if (s == "field alternative") return L(18)
    if (s == "line alternative") return L(19)
    if (s == "a stereo format made by the system") return L(17)
    return s
}
function pname(s) {
    if (s == "built-in (from the EDID)") return L(20)
    if (s == "none") return L(21)
    return s
}
'

# T N [VALUE...]: the string LOCALN with %1 to %4 replaced by the values
T() {
    eval "_template=\$LOCAL$1"
    shift
    _t=$_template _1=${1:-} _2=${2:-} _3=${3:-} _4=${4:-} awk "$AWKLIB"'BEGIN { printf "%s", fill(ENVIRON["_t"], ENVIRON["_1"], ENVIRON["_2"], ENVIRON["_3"], ENVIRON["_4"]) }'
}

# stereo-display-info --keys prints one line per display for the KInfoCenter page, separated
# by tabs: connector, look-up tag, EDID MD5, manufacturer name, colour profile.
keys=
[ "${1:-}" = --keys ] && keys=yes

# stereo-display-info --sections prints the same text with a line "@@ <kind> <name>" before each
# block (stack, card, display), so the page can put each display's buttons beside it.
sections=
[ "${1:-}" = --sections ] && sections=yes
mark() {
    [ -z "$sections" ] || echo "@@ $1 $2"
    return 0
}

if ! command -v edid-decode > /dev/null 2>&1; then
    T 1
    echo
    exit 0
fi

pnp_ids=${SPARKY_STEREO_INFO_PNP_IDS:-/usr/share/hwdata/pnp.ids}

# probe SECONDS COMMAND...: runs a read-only probe; its output is in $probe_out, its status in $probe_rc and the
# first line of its error text in $probe_err
probe() {
    probe_secs=$1
    shift
    probe_errfile=$(mktemp)
    probe_out=$(timeout "$probe_secs" "$@" 2> "$probe_errfile") && probe_rc=0 || probe_rc=$?
    probe_err=$(head -n 1 "$probe_errfile" | cut -c 1-200)
    rm -f "$probe_errfile"
}

# why_failed TOOL SECONDS: the cause of the probe that just failed, in words
why_failed() {
    case $probe_rc in
        124) T 2 "$1" "$2"; echo ;;
        126 | 127) if [ -n "$probe_err" ]; then T 4 "$1" "$probe_err"; else T 3 "$1"; fi; echo ;;
        *) if [ -n "$probe_err" ]; then T 6 "$1" "$probe_rc" "$probe_err"; else T 5 "$1" "$probe_rc"; fi; echo ;;
    esac
}

# notes: what could not be read, one line each, shown in the stack block
notes=
note() {
    notes="${notes:+$notes
}  $1"
}

# What the desktop session says, when there is one (not over SSH or on a console).
state=
json=
if [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    if ! command -v kscreen-doctor > /dev/null 2>&1; then
        note "$(T 7 "$(T 8 kscreen-doctor)")"
    else
        probe 10 kscreen-doctor -o
        if [ "$probe_rc" = 0 ]; then
            state=$(printf '%s\n' "$probe_out" | sed 's/\x1b\[[0-9;]*m//g')
            # The stereo and HDR switches of each output, from the same session (kscreen-doctor -j, read-only).
            if [ -n "$state" ]; then
                probe 10 kscreen-doctor -j
                if [ "$probe_rc" = 0 ]; then
                    json=$probe_out
                else
                    note "$(T 9 "$(why_failed "kscreen-doctor -j" 10)")"
                fi
            fi
        else
            note "$(T 7 "$(why_failed "kscreen-doctor -o" 10)")"
        fi
    fi
fi

# The value of key $2 of output $1 in that JSON, empty when the key is not there.
json_value() {
    [ -n "$json" ] || return 0
    printf '%s\n' "$json" | awk -v want="$1" -v key="$2" '
        /^        \{$/ { values = ""; delete found; inside = 1; next }
        inside && /^            "[A-Za-z]+": [^\[{]*$/ {
            k = $1; gsub(/[":]/, "", k)
            v = $0; sub(/^[^:]*: /, "", v); sub(/,$/, "", v); gsub(/"/, "", v)
            found[k] = v
        }
        /^        \}/ {
            if (found["name"] == want && (key in found)) { print found[key]; exit }
            inside = 0
        }'
}

# What output $1 is doing now, from the kscreen-doctor text in $state.
live() {
    [ -n "$state" ] || return 0
    printf '%s\n' "$state" | awk -v want="$1" -v only="${2:-}" "$AWKLIB"'
        /^Output: / { current = $3; next }
        current != want { next }
        { found = 1 }
        $1 == "disabled" { off = 1 }
        /^\tModes:/ {
            for (i = 1; i <= NF; i++)
                if ($i ~ /[0-9]x[0-9]+@[0-9.]+\*/) {
                    mode = $i
                    sub(/^[0-9]*:/, "", mode)
                    hz = mode
                    sub(/^.*@/, "", hz)
                    sub(/[*!(].*$/, "", hz)
                    size = mode
                    sub(/@.*$/, "", size)
                    format = "none"
                    if (mode ~ /\(3D-SBS-full\)/) format = "side by side (full)"
                    else if (mode ~ /\(3D-SBS\)/) format = "side by side (half)"
                    else if (mode ~ /\(3D-TaB\)/) format = "top and bottom"
                    else if (mode ~ /\(3D-FP\)/) format = "frame packing"
                    else if (mode ~ /\(virtual-3D/) format = "a stereo format made by the system"
                }
        }
        /^\tICC profile: / { icc = $0; sub(/^[^:]*: /, "", icc) }
        /^\tColor profile source: / { source = $0; sub(/^[^:]*: /, "", source) }
        /^\tColor resolution: / { colour = $0; sub(/^[^:]*: /, "", colour) }
        END {
            if (!found) exit
            if (source == "EDID")
                profile = "built-in (from the EDID)"
            else if (source == "sRGB")
                profile = "sRGB"
            else if (source == "ICC" && icc != "" && icc != "none") {
                profile = icc
                sub(/^.*\//, "", profile)
            } else if (source == "ICC")
                profile = "none"
            if (only == "profile") {
                printf "%s", profile
                exit
            }
            if (only == "width") {
                sub(/x.*$/, "", size)
                printf "%s", size
                exit
            }
            if (only == "format") {
                printf "%s", format
                exit
            }
            print "  " L(22)
            if (off)
                print "    " L(23)
            else if (mode != "")
                print "    " F(24, size, sprintf("%.2f", hz), format == "none" ? L(25) : sname(format))
            if (colour ~ /unknown/ || colour == "")
                print "    " L(26)
            else {
                range = colour
                sub(/^.*range: \[/, "", range)
                sub(/\].*$/, "", range)
                split(range, bounds, "; ")
                sub(/, range:.*$/, "", colour)
                if (colour ~ /^automatic \(/)
                    colour = L(28)
                else if (colour ~ /^[0-9]+ bits per color$/) {
                    bits = colour
                    sub(/ .*$/, "", bits)
                    colour = F(29, bits)
                }
                print "    " F(27, colour, bounds[1], bounds[2])
            }
            if (profile != "")
                print "    " F(30, pname(profile))
        }'
}

# The OpenGL renderer of the EGL device made by the card's maker, and the Vulkan device
# with the card'"'"'s PCI IDs. Nothing here switches a GPU; both tools list every device.
egl=
vulkan=
if [ -z "$keys" ]; then
    if ! command -v eglinfo > /dev/null 2>&1; then
        note "$(T 10 "$(T 8 eglinfo)")"
    else
        probe 30 eglinfo -B
        [ "$probe_rc" = 0 ] || note "$(T 11 "$(why_failed eglinfo 30)")"
        egl=$(printf '%s\n' "$probe_out" | sed -n '/^Device platform:/,$p')
    fi
    if ! command -v vulkaninfo > /dev/null 2>&1; then
        note "$(T 12 "$(T 8 vulkaninfo)")"
    else
        probe 30 vulkaninfo --summary
        if [ "$probe_rc" = 0 ]; then
            vulkan=$probe_out
        else
            note "$(T 12 "$(why_failed vulkaninfo 30)")"
        fi
    fi
fi

card_opengl() {
    # $1 is the PCI vendor ID; two cards of one maker are not told apart, so none is named
    case "$1" in
        0x1002) maker=AMD ;;
        0x10de) maker=NVIDIA ;;
        0x8086) maker=Intel ;;
        *) return 0 ;;
    esac
    [ -n "$egl" ] || return 0
    printf '%s\n' "$egl" | awk -v maker="$maker" -v cards="$2" '
        /^OpenGL core profile vendor:/ { vendor = ($0 ~ maker) }
        /^OpenGL core profile renderer:/ && vendor { sub(/^[^:]*: /, ""); renderer = $0 }
        /^OpenGL core profile version:/ && vendor {
            sub(/^[^:]*: /, "")
            matches++
            if (matches == 1) found = renderer ", " $0
        }
        END { if (matches >= 1 && cards == 1) print found }'
}

card_vulkan() {
    [ -n "$vulkan" ] || return 0
    printf '%s\n' "$vulkan" | awk -v vendor="$1" -v device="$2" '
        /^GPU[0-9]+:/ { id = ""; dev = ""; name = ""; drv = ""; info = "" }
        /vendorID/ { id = $NF }
        /deviceID/ { dev = $NF }
        /deviceName/ { sub(/^[^=]*= /, ""); name = $0 }
        /driverName/ { drv = $NF }
        /driverInfo/ {
            sub(/^[^=]*= /, "")
            if (tolower(id) == tolower(vendor) && tolower(dev) == tolower(device)) {
                print drv " (" $0 "), " name
                exit
            }
        }'
}

onoff() {
    if [ "$1" = true ]; then T 35; else T 36; fi
}
yesno() {
    if [ "$1" = true ]; then T 37; else T 25; fi
}
# join: the translated list separator
join() {
    printf '%s%s' "$1" "$(T 40)"
}

# The stereo and HDR switches of output $1, one line each, when the session reports them.
extra() {
    [ -n "$json" ] || return 0
    line=
    value=$(json_value "$1" anaglyph)
    [ -z "$value" ] || line="$(T 32 "$(onoff "$value")")"
    value=$(json_value "$1" otherStereoFormats)
    [ -z "$value" ] || line="${line:+$(join "$line")}$(T 33 "$(onoff "$value")")"
    value=$(json_value "$1" stereoEyeSwap)
    [ -z "$value" ] || line="${line:+$(join "$line")}$(T 34 "$(yesno "$value")")"
    [ -z "$line" ] || echo "    $(T 31 "$line")"
    line=
    value=$(json_value "$1" hdr)
    [ -z "$value" ] || line="$(T 38 "$(onoff "$value")")"
    value=$(json_value "$1" wcg)
    [ -z "$value" ] || line="${line:+$(join "$line")}$(T 39 "$(onoff "$value")")"
    [ -z "$line" ] || echo "    $line"
}

# The stereo stack, the first thing a bug report needs.
stack() {
    edition=$( . /usr/share/sparky-stereo-info/edition 2> /dev/null && echo "$EDITION_PRETTY") || edition=
    [ -n "$edition" ] || edition=$( . /usr/lib/os-release 2> /dev/null && echo "$PRETTY_NAME") || edition=
    [ -z "$edition" ] || echo "$edition"
    echo "  $(T 41 "$(uname -r)")"
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wayland-info > /dev/null 2>&1; then
        probe 10 wayland-info
        if [ "$probe_rc" != 0 ]; then
            echo "  $(T 42 "$(why_failed wayland-info 10)")"
        else
            version=$(printf '%s\n' "$probe_out" | sed -n "s/.*interface: 'kde_stereo_content_manager_v1', *version: *\([0-9]*\).*/\1/p" | head -n 1)
            if [ -n "$version" ]; then
                echo "  $(T 43 "$version")"
            else
                echo "  $(T 44)"
            fi
        fi
    elif [ -n "${DISPLAY:-}" ] && command -v xprop > /dev/null 2>&1; then
        probe 10 xprop -root _KDE_NET_WM_STEREO_CONTENT_SUPPORTED
        if [ "$probe_rc" != 0 ]; then
            echo "  $(T 42 "$(why_failed xprop 10)")"
        else
            version=$(printf '%s\n' "$probe_out" | sed -n 's/.*= *\([0-9]*\).*/\1/p')
            if [ -n "$version" ]; then
                echo "  $(T 45 "$version")"
            else
                echo "  $(T 44)"
            fi
        fi
    elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
        echo "  $(T 42 "$(T 8 wayland-info)")"
    elif [ -n "${DISPLAY:-}" ]; then
        echo "  $(T 42 "$(T 8 xprop)")"
    fi
    if command -v dpkg-query > /dev/null 2>&1; then
        packages=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package} ${Version}\n' kwin-wayland mesa-libgallium libgl1-mesa-dri mesa-vulkan-layer-stereo libstereo-declare1 libkf6screen8 libkscreen-bin kscreen libnvidia-egl-wayland1 2> /dev/null | sed -n 's/^[a-z]i  *//p' | awk '!listed[$1]++') || packages=
        if [ -n "$packages" ]; then
            echo "  $(T 46)"
            printf '%s\n' "$packages" | sed 's/^/    /'
        fi
    fi
    [ -z "$notes" ] || printf '%s\n' "$notes"
    echo
}
[ -n "$keys" ] || { mark stack -; stack; }

seen=
for card in "$DRM"/card[0-9]*; do
    case "${card##*/}" in *-*) continue ;; esac
    cardname=$(basename "$card")
    # the card'"'"'s own driver, not its connectors'"'"'
    driver=$(basename "$(readlink -f "$card/device/driver")")
    set -- "$card"-*
    [ -e "$1" ] || continue
    if [ -z "$keys" ]; then
        pci=$(basename "$(readlink -f "$card/device")")
        vendor_id=$(cat "$card/device/vendor" 2> /dev/null || true)
        device_id=$(cat "$card/device/device" 2> /dev/null || true)
        gpu=
        if command -v lspci > /dev/null 2>&1; then
            gpu=$(lspci -s "$pci" 2> /dev/null | sed 's/^[^ ]* [^:]*: //; s/ (rev [0-9a-f]*)$//')
        fi
        [ -n "$gpu" ] || gpu=$(T 51 "$vendor_id" "$device_id")
        mark card "$cardname"
        T 47 "$cardname" "$gpu"; echo
        echo "  $(T 48 "$driver")"
        cards_of_maker=$(for other in "$DRM"/card[0-9]*; do case "${other##*/}" in *-*) continue ;; esac; [ "$(cat "$other/device/vendor" 2> /dev/null)" = "$vendor_id" ] && echo x; done | wc -l)
        opengl=$(card_opengl "$vendor_id" "$cards_of_maker")
        [ -z "$opengl" ] || echo "  $(T 49 "$opengl")"
        vk=$(card_vulkan "$vendor_id" "$device_id")
        [ -z "$vk" ] || echo "  $(T 50 "$vk")"
    fi
    shown=
    for connector in "$@"; do
    [ -e "$connector/edid" ] || continue
    [ "$(cat "$connector/status" 2> /dev/null)" = connected ] || continue
    shown=yes

    name=$(basename "$connector")
    name=${name#card*-}
    seen="$seen $name "

    md5=$(md5sum "$connector/edid" | cut -d' ' -f1)
    interlaced=no
    grep -q 'i$' "$connector/modes" 2> /dev/null && interlaced=yes
    vendor=$(edid-decode "$connector/edid" 2> /dev/null | sed -n 's/^ *Manufacturer: \([A-Z]*\).*/\1/p' | head -n 1)
    vendor_name=
    if [ -n "$vendor" ] && [ -r "$pnp_ids" ]; then
        vendor_name=$(awk -F'\t' -v id="$vendor" '$1 == id { print $2; exit }' "$pnp_ids")
    fi

    if [ -n "$keys" ]; then
        model=$(edid-decode "$connector/edid" 2> /dev/null | sed -n 's/^ *Model: \([0-9]*\).*/\1/p' | head -n 1)
        [ -n "$vendor" ] && [ -n "$model" ] || continue
        printf '%s\t%s%04X\t%s\t%s\t%s\n' "$name" "$vendor" "$model" "$md5" "$vendor_name" "$(live "$name" profile)"
        continue
    fi

    mark display "$name"
    edid-decode "$connector/edid" 2> /dev/null | awk -v connector="$name" -v driver="$driver" -v md5="$md5" \
        -v interlaced="$interlaced" -v vendor_name="$vendor_name" \
        -v now_width="$(live "$name" width)" -v now_format="$(live "$name" format)" "$AWKLIB"'
        function mode(   hz) {
            # "VIC  31:  1920x1080   50.000000 Hz ..." gives "1920x1080 50 Hz"
            hz = $4 + 0
            return $3 " " (hz == int(hz) ? hz : sprintf("%.2f", hz)) " Hz"
        }
        function add(list, item) {
            return list == "" ? item : list ", " item
        }
        function hidden(   m) {
            # interlaced formats are kept apart when the driver lists no interlaced mode
            return interlaced == "no" && $3 ~ /i$/
        }
        function add_interlaced(structure, item) {
            if (!(structure in interlaced_list))
                interlaced_order[++interlaced_count] = structure
            if (index(", " interlaced_list[structure] ", ", ", " item ", ") == 0)
                interlaced_list[structure] = add(interlaced_list[structure], item)
        }
        function structure_name(text) {
            # "Side-by-side (half, horizontal)" gives "side by side (half)"
            text = tolower(text)
            gsub(/-/, " ", text)
            sub(/ \(half, horizontal\)/, " (half)", text)
            return text
        }
        /Display Product Name:/ {
            product = $0
            sub(/^.*Display Product Name: /, "", product)
            gsub(/\047/, "", product)
        }
        /^ *Manufacturer: / { maker = $2 }
        /^ *Model: / { model = $2 + 0 }
        /^ *Made in: / { made = $0; sub(/^ *Made in: /, "", made) }
        /Bits per primary color channel:/ { panel_bits = $NF }
        /Vendor-Specific Data Block \(HDMI\), OUI 00-0C-03/ { hdmi = 1; block = "hdmi"; next }
        /Vendor-Specific Data Block \(HDMI Forum\)/ { block = "forum"; next }
        /^  [A-Z].*Data Block/ { block = "" }
        /HDR Static Metadata Data Block/ { block = "hdr"; hdr_block = 1; next }
        /Colorimetry Data Block/ { block = "colorimetry"; next }
        block == "hdr" && /Traditional gamma - SDR/ { eotf = add(eotf, "SDR") }
        block == "hdr" && /Traditional gamma - HDR/ { eotf = add(eotf, "HDR gamma") }
        block == "hdr" && /SMPTE ST2084/ { eotf = add(eotf, "PQ (SMPTE ST 2084)") }
        block == "hdr" && /Hybrid Log-Gamma/ { eotf = add(eotf, "HLG") }
        block == "colorimetry" && /BT2020/ { bt2020 = 1 }
        /Maximum image size:/ { if (match($0, /[0-9]+ cm x [0-9]+ cm/)) { split(substr($0, RSTART, RLENGTH), cm, " "); cm_w = cm[1]; cm_h = cm[4] } }
        /DTD 1:/ && !dtd_seen {
            dtd_seen = 1
            split($3, dtd_size, "x")
            dtd_width = dtd_size[1]
            if (match($0, /\([0-9]+ mm x [0-9]+ mm\)/)) {
                dims = substr($0, RSTART + 1, RLENGTH - 2)
                split(dims, mm, " ")
                mm_w = mm[1]; mm_h = mm[4]
            }
        }
        block == "hdmi" && /DC_30bit/ { dc30 = 1 }
        block == "hdmi" && /DC_36bit/ { dc36 = 1 }
        block == "hdmi" && /DC_48bit/ { dc48 = 1 }
        block == "hdmi" && /DC_Y444/ { y444 = 1 }
        block == "hdmi" && /Maximum TMDS clock:/ { if (match($0, /[0-9]+ MHz/)) tmds = substr($0, RSTART, RLENGTH) }
        block == "forum" && /Maximum TMDS Character Rate:/ { if (match($0, /[0-9]+ MHz/)) tmds = substr($0, RSTART, RLENGTH) }
        block == "forum" && /Deep Color 4:2:0/ { sub(/^ */, ""); forum = add(forum, $0) }
        block == "hdmi" && /3D present/ { stereo = 1 }
        block == "hdmi" && /^ *3D: / { sub(/^ *3D: /, ""); structures = add(structures, structure_name($0)); named[++named_count] = structure_name($0) }
        block == "hdmi" && /3D VIC indices that support these capabilities:/ { list = "all"; next }
        block == "hdmi" && /3D VIC indices with specific capabilities:/ { list = "specific"; next }
        block == "hdmi" && list == "all" && /^ *VIC +[0-9]+:/ {
            if (hidden())
                for (i = 1; i <= named_count; i++)
                    add_interlaced(named[i], mode())
            else
                all = add(all, mode())
            next
        }
        block == "hdmi" && list == "specific" && /^ *VIC +[0-9]+:/ {
            structure = $0
            sub(/^.*Hz[^(]*\(/, "", structure)
            sub(/\)$/, "", structure)
            structure = structure_name(structure)
            if (hidden()) {
                add_interlaced(structure, mode())
                next
            }
            if (!(structure in specific))
                order[++structures_listed] = structure
            specific[structure] = add(specific[structure], mode())
            next
        }
        list != "" && !/^ *VIC/ { list = "" }
        END {
            print F(55, connector, product == "" ? L(54) : product)
            if (maker != "") {
                print "  " F(56, maker (vendor_name == "" ? "" : " (" vendor_name ")"))
                print "  " F(57, sprintf("%d", model), sprintf("0x%04X", model))
                if (made ~ /^week [0-9]+ of [0-9]+$/) {
                    split(made, week, " ")
                    made = F(82, week[2], week[4])
                }
                if (made != "")
                    print "  " F(58, made)
                print "  " F(59, sprintf("%s%04X", maker, model), md5)
            }
            if (hdmi && connector !~ /^HDMI/)
                print "  " F(connector ~ /^DP/ ? 60 : 61, connector)
            if (stereo) {
                print "  " L(62)
                print "    " L(63)
                print "      " F(64, sname("frame packing"), "1920x1080 24 Hz, 1280x720 50 Hz, 1280x720 60 Hz")
                if (interlaced == "no") {
                    add_interlaced("side by side (half)", "1920x1080i 50 Hz")
                    add_interlaced("side by side (half)", "1920x1080i 60 Hz")
                } else
                    print "      " F(64, sname("side by side (half)"), "1920x1080i 50 Hz, 1920x1080i 60 Hz")
                print "      " F(64, sname("top and bottom"), "1920x1080 24 Hz, 1280x720 50 Hz, 1280x720 60 Hz")
                if (structures != "" && all != "") {
                    n = split(structures, parts, ", ")
                    names = ""
                    for (i = 1; i <= n; i++)
                        names = (i > 1 ? names L(40) : "") sname(parts[i])
                    print "    " F(65, names)
                    print "      " all
                }
                for (i = 1; i <= structures_listed; i++) {
                    print "    " F(65, sname(order[i]))
                    print "      " specific[order[i]]
                }
                if (interlaced_count > 0) {
                    for (i = 1; i <= interlaced_count; i++)
                        line = (i > 1 ? line "; " : "") sname(interlaced_order[i]) " " interlaced_list[interlaced_order[i]]
                    print "    " F(66, driver, line)
                }
            } else {
                print "  " L(67)
                print "    " L(68)
            }
            if (dc30) depth = add(depth, "10")
            if (dc36) depth = add(depth, "12")
            if (dc48) depth = add(depth, "16")
            if (depth != "")
                print "  " F(y444 ? 70 : 69, depth)
            else if (hdmi)
                print "  " L(71)
            else if (panel_bits != "")
                print "  " F(72, panel_bits)
            if (forum != "")
                print "  " forum
            if (tmds != "")
                print "  " F(73, tmds)
            if (hdr_block)
                print "  " F(bt2020 ? 75 : 74, eotf)
            else
                print "  " L(76)
            if (mm_w == 0 && cm_w > 0) { mm_w = cm_w * 10; mm_h = cm_h * 10 }
            if (mm_w > 0 && mm_h > 0) {
                diagonal = sqrt(mm_w * mm_w + mm_h * mm_h) / 25.4
                print "  " F(77, sprintf("%d", mm_w), sprintf("%d", mm_h), sprintf("%.1f", diagonal))
                width = now_width != "" ? now_width : dtd_width
                if (width > 0) {
                    pixels = 65 * width / mm_w
                    print "  " F(78, sprintf("%.0f", pixels), sprintf("%d", width), now_width != "" ? "" : L(79), now_format ~ /^side by side/ ? F(80, sprintf("%.0f", pixels / 2)) : "")
                }
            } else
                print "  " L(81)
        }' | sed 's/^\(.\)/  \1/'
    { live "$name"; extra "$name"; } | sed 's/^\(.\)/  \1/'
    echo
    done
    [ -n "$keys" ] || [ -n "$shown" ] || printf '  %s\n\n' "$(T 52)"
done

# Outputs the session has that are not a connected connector here (a virtual output).
if [ -n "$state" ] && [ -z "$keys" ]; then
    for name in $(printf '%s\n' "$state" | sed -n 's/^Output: [0-9]* \([^ ]*\) .*/\1/p'); do
        case "$seen" in
            *" $name "*) continue ;;
        esac
        mark display "$name"
        T 53 "$name"; echo
        { live "$name"; extra "$name"; } | sed 's/^\(.\)/  \1/'
        echo
    done
fi
