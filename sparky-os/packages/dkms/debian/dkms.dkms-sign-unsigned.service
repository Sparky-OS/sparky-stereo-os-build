# Sparky Stereo OS, ORDER 374: an image built in a chroot carries its DKMS modules unsigned and no key (dkms signs
# nothing there, try_sign_modules, dkms-project/dkms #574 and #575), so every machine installed from it makes its own
# key. The installed system signs those modules once, in the background of its first boot, and marks itself done; a
# module that cannot be signed is kept by sparky-stereo-problems with its repair. A live session and a container have
# no modules of their own to sign.
# ORDER 666: where no module needs a signature (Secure Boot off or absent, a BIOS start) the step says so and builds
# nothing, and leaves no mark, so it signs at the first start after Secure Boot is turned on. It starts after the
# hardware layer has settled NVIDIA's driver on a machine without the card (sparky-stereo-hardware-nvidia-card.service,
# ordering only), so a module that is about to leave is not built again to be signed.
# 3.4.4-1+sparky6: no default dependencies. A target waits for every unit it wants that has them, and this unit waits
# for the NVIDIA step, so with +sparky5 the first start reached multi-user.target only when that step had ended
# (measured in a guest under a real systemd). What the default dependencies gave is written out below.
[Unit]
Description=Sign the DKMS modules built without a signature, once, at the first boot
Documentation=man:dkms(8)
DefaultDependencies=no
After=basic.target sparky-stereo-hardware-nvidia-card.service
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=!/var/lib/dkms/dkms-sign-unsigned.first-boot
ConditionKernelCommandLine=!boot=live
ConditionVirtualization=!container

[Service]
# the boot and the login do not wait for it
Type=exec
ExecStart=/usr/lib/dkms/dkms-sign-unsigned first-boot

[Install]
WantedBy=multi-user.target
