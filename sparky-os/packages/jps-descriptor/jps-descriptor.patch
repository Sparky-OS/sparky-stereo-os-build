diff --git a/src/imageformats/stereo.cpp b/src/imageformats/stereo.cpp
index c5526a9..6215d2f 100644
--- a/src/imageformats/stereo.cpp
+++ b/src/imageformats/stereo.cpp
@@ -8,6 +8,11 @@
 #include "depthmark_p.h"
 
 #include <QBuffer>
+#include <QCoreApplication>
+#include <QDebug>
+#include <QPainter>
+#include <QTranslator>
+#include <QLocale>
 #include <QImage>
 #include <QImageIOPlugin>
 #include <QImageReader>
@@ -164,6 +169,85 @@ QString jpsStereoLayout(const QByteArray &data)
     return layout + ((descriptor & 0x40000) ? QStringLiteral("LeftFirst") : QStringLiteral("RightFirst"));
 }
 
+
+// VRex, General Purpose Stereoscopic Data Descriptor (1997), pp.3-6:
+// https://web.archive.org/web/20111030182549id_/http://www.vrex.com/developer/sterdesc.pdf
+// QImage text preserves all descriptor fields; half-size flags never resample reader pixels.
+const QStringList jpsFieldKeys = {QStringLiteral("Stereo3DJpsHalfHeight"), QStringLiteral("Stereo3DJpsHalfWidth"),
+    QStringLiteral("Stereo3DJpsSeparation"), QStringLiteral("Stereo3DJpsDisplay"), QStringLiteral("Stereo3DJpsComment")};
+
+QHash<QString, QString> jpsFields(const QByteArray &data)
+{
+    QHash<QString, QString> fields;
+    if (data.size() < 8)
+        return fields;
+    const int length = qFromBigEndian<quint16>(data.constData());
+    if (length < 4 || length + 4 > data.size())
+        return fields;
+    const int comments = qFromBigEndian<quint16>(data.constData() + 2 + length);
+    if (length + 4 + comments != data.size())
+        return fields;
+    const quint32 value = qFromBigEndian<quint32>(data.constData() + 2);
+    fields.insert(jpsFieldKeys[0], QString::number((value >> 16) & 1));
+    fields.insert(jpsFieldKeys[1], QString::number((value >> 17) & 1));
+    fields.insert(jpsFieldKeys[2], QString::number(value >> 24));
+    fields.insert(jpsFieldKeys[3], QString::number((value & 255) == 0 ? (value >> 8) & 255 : 0));
+    fields.insert(jpsFieldKeys[4], QString::fromLatin1(data.constData() + length + 4, comments));
+    return fields;
+}
+
+QByteArray jpsDescriptor(const QImage &image)
+{
+    const QString mark = image.text(QString::fromLatin1(stereo3DLayoutKey));
+    int layout = 0;
+    bool left = mark.endsWith(QLatin1String("LeftFirst")) || mark == QLatin1String("anaglyphRedLeft");
+    if (mark.isEmpty() || mark == QLatin1String("sideBySideLeftFirst") || mark == QLatin1String("sideBySideRightFirst"))
+        layout = 2;
+    else if (mark == QLatin1String("rowInterleavedLeftFirst") || mark == QLatin1String("rowInterleavedRightFirst"))
+        layout = 1;
+    else if (mark == QLatin1String("topBottomLeftFirst") || mark == QLatin1String("topBottomRightFirst"))
+        layout = 3;
+    else if (mark == QLatin1String("anaglyphRedLeft") || mark == QLatin1String("anaglyphRedRight"))
+        layout = 4;
+    else if (mark != QLatin1String("mono"))
+        return {};
+    int values[4] = {};
+    const int maximum[4] = {1, 1, 255, layout == 0 ? 2 : 0};
+    for (int i = 0; i < 4; ++i) {
+        const QString text = image.text(jpsFieldKeys[i]);
+        if (text.isEmpty())
+            continue;
+        bool ok = false;
+        values[i] = text.toInt(&ok);
+        if (!ok || values[i] < 0 || values[i] > maximum[i])
+            return {};
+    }
+    const int separation = values[2];
+    if ((layout != 2 && layout != 3 && separation != 0)
