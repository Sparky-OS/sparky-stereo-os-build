--- /dev/null
+++ b/autotests/jpswritertest.cpp
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+#include <QBuffer>
+#include <QImageReader>
+#include <QImageWriter>
+#include <QTest>
+#include <QLocale>
+#include <QtEndian>
+
+class JpsWriterTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void layouts_data()
+    {
+        QTest::addColumn<QString>("mark");
+        QTest::addColumn<int>("descriptor");
+        QTest::newRow("legacy") << QString() << 0x201;
+        QTest::newRow("mono") << QStringLiteral("mono") << 0;
+        for (int layout = 1; layout <= 4; ++layout) {
+            for (int left = 0; left <= 1; ++left) {
+                const QString mark = layout == 4 ? (left ? QStringLiteral("anaglyphRedLeft") : QStringLiteral("anaglyphRedRight"))
+                    : QStringList{QStringLiteral("rowInterleaved"), QStringLiteral("sideBySide"), QStringLiteral("topBottom")}.at(layout - 1)
+                        + (left ? QStringLiteral("LeftFirst") : QStringLiteral("RightFirst"));
+                QTest::addRow("layout-%d-left-%d", layout, left) << mark << (1 | layout << 8 | left << 18);
+            }
+        }
+    }
+    void layouts()
+    {
+        QFETCH(QString, mark);
+        QFETCH(int, descriptor);
+        for (int flags = 0; flags < 4; ++flags) {
+            for (int separation : {0, 2, 255}) {
+                const int layout = (descriptor >> 8) & 255;
+                if (separation && layout != 2 && layout != 3)
+                    continue;
+                for (int display = 0; display < ((descriptor & 255) ? 1 : 3); ++display) {
+                    QImage source(128 + (layout == 2 ? separation : 0), 64 + (layout == 3 ? separation : 0), QImage::Format_RGB32);
+                    source.fill(Qt::red);
+                    source.setText(QStringLiteral("Stereo3DLayout"), mark);
+                    source.setText(QStringLiteral("Stereo3DJpsHalfHeight"), QString::number(flags & 1));
+                    source.setText(QStringLiteral("Stereo3DJpsHalfWidth"), QString::number(flags >> 1));
+                    source.setText(QStringLiteral("Stereo3DJpsSeparation"), QString::number(separation));
+                    source.setText(QStringLiteral("Stereo3DJpsDisplay"), QString::number(display));
+                    source.setText(QStringLiteral("Stereo3DJpsComment"), QStringLiteral("test"));
+                    QByteArray data;
+                    QBuffer output(&data);
+                    QVERIFY(output.open(QIODevice::WriteOnly));
+                    QImageWriter writer(&output, "jps");
+                    QVERIFY(writer.write(source));
+                    int found = 0;
+                    qsizetype at = 2;
+                    QVERIFY(data.startsWith(QByteArray::fromHex("ffd8")));
+                    while (at + 4 <= data.size()) {
+                        QCOMPARE(quint8(data[at]), quint8(255));
+                        const int marker = quint8(data[at + 1]);
+                        const int length = qFromBigEndian<quint16>(data.constData() + at + 2);
+                        QVERIFY(length >= 2 && at + 2 + length <= data.size());
+                        if (marker == 0xda)
+                            break;
+                        if (marker == 0xe3 && data.mid(at + 4, 8) == "_JPSJPS_") {
+                            ++found;
+                            QCOMPARE(length, 22);
+                            QCOMPARE(qFromBigEndian<quint16>(data.constData() + at + 12), quint16(4));
+                            QCOMPARE(qFromBigEndian<quint32>(data.constData() + at + 14), quint32(descriptor | flags << 16 | separation << 24 | display << 8));
+                            QCOMPARE(qFromBigEndian<quint16>(data.constData() + at + 18), quint16(4));
+                            QCOMPARE(data.mid(at + 20, 4), QByteArray("test"));
+                        }
+                        at += 2 + length;
+                    }
+                    QCOMPARE(found, 1);
+                    QBuffer input(&data);
+                    QVERIFY(input.open(QIODevice::ReadOnly));
+                    QImageReader reader(&input, "jps");
+                    const QImage decoded = reader.read();
+                    QVERIFY(!decoded.isNull());
+                    QCOMPARE(decoded.size(), source.size());
+                    QCOMPARE(decoded.text(QStringLiteral("Stereo3DLayout")), mark.isEmpty() ? QStringLiteral("sideBySideRightFirst") : mark);
+                    QCOMPARE(decoded.text(QStringLiteral("Stereo3DJpsHalfHeight")), QString::number(flags & 1));
+                    QCOMPARE(decoded.text(QStringLiteral("Stereo3DJpsHalfWidth")), QString::number(flags >> 1));
+                    QCOMPARE(decoded.text(QStringLiteral("Stereo3DJpsSeparation")), QString::number(separation));
+                    QCOMPARE(decoded.text(QStringLiteral("Stereo3DJpsDisplay")), QString::number(display));
+                    QCOMPARE(decoded.text(QStringLiteral("Stereo3DJpsComment")), QStringLiteral("test"));
+                }
+            }
+        }
+    }
+    void refusalTranslations_data()
+    {
+        QTest::addColumn<QString>("locale");
+        QTest::addColumn<QString>("message");
+        QTest::newRow("de") << QStringLiteral("de") << QString::fromUtf8("JPS kann nicht gespeichert werden: Die Anordnung oder die Deskriptorfelder werden nicht unterstützt oder sind ungültig.");
+        QTest::newRow("en") << QStringLiteral("en") << QString::fromUtf8("Cannot save JPS: the layout or descriptor fields are unsupported or invalid.");
+        QTest::newRow("es") << QStringLiteral("es") << QString::fromUtf8("No se puede guardar JPS: la disposición o los campos del descriptor no son compatibles o no son válidos.");
+        QTest::newRow("fr") << QStringLiteral("fr") << QString::fromUtf8("Impossible d’enregistrer le JPS : la disposition ou les champs du descripteur ne sont pas pris en charge ou sont invalides.");
+        QTest::newRow("ja") << QStringLiteral("ja") << QString::fromUtf8("JPS を保存できません。配置または記述子のフィールドが未対応か無効です。");
+        QTest::newRow("ko") << QStringLiteral("ko") << QString::fromUtf8("JPS를 저장할 수 없습니다. 배치 또는 설명자 필드가 지원되지 않거나 유효하지 않습니다.");
+        QTest::newRow("pl") << QStringLiteral("pl") << QString::fromUtf8("Nie można zapisać JPS: układ lub pola deskryptora są nieobsługiwane albo nieprawidłowe.");
+        QTest::newRow("pt_BR") << QStringLiteral("pt_BR") << QString::fromUtf8("Não foi possível salvar JPS: a disposição ou os campos do descritor não são compatíveis ou são inválidos.");
+        QTest::newRow("zh_CN") << QStringLiteral("zh_CN") << QString::fromUtf8("无法保存 JPS：布局或描述符字段不受支持或无效。");
+        QTest::newRow("zh_TW") << QStringLiteral("zh_TW") << QString::fromUtf8("無法儲存 JPS：配置或描述符欄位不受支援或無效。");
+    }
+    void refusalTranslations()
+    {
+        QFETCH(QString, locale);
+        QFETCH(QString, message);
+        const QLocale previous;
+        QLocale::setDefault(QLocale(locale));
+        QImage image(128, 64, QImage::Format_RGB32);
+        image.fill(Qt::red);
+        image.setText(QStringLiteral("Stereo3DLayout"), QStringLiteral("unsupported"));
+        QByteArray data;
+        QBuffer buffer(&data);
+        QVERIFY(buffer.open(QIODevice::WriteOnly));
+        QImageWriter writer(&buffer, "jps");
+        QTest::ignoreMessage(QtWarningMsg, qPrintable(message));
+        const bool written = writer.write(image);
+        QLocale::setDefault(previous);
+        QVERIFY(!written);
+        QVERIFY(data.isEmpty());
+    }
+    void refusal_data()
+    {
+        QTest::addColumn<QString>("key");
+        QTest::addColumn<QString>("value");
+        for (const QString &mark : {QStringLiteral("columnInterleavedLeftFirst"), QStringLiteral("checkerboardLeftFirst"),
+                 QStringLiteral("sideBySideQuincunxLeftFirst"), QStringLiteral("depthSideBySidePictureFirst"), QStringLiteral("depthSeparate"),
+                 QStringLiteral("multiViewLeftFirst"), QStringLiteral("anaglyphGreenLeft"), QStringLiteral("anaglyphAmberLeft"), QStringLiteral("unknown")})
+            QTest::addRow("%s", qPrintable(mark)) << QStringLiteral("Stereo3DLayout") << mark;
+        QTest::newRow("bad-half-width") << QStringLiteral("Stereo3DJpsHalfWidth") << QStringLiteral("2");
+        QTest::newRow("bad-half-height") << QStringLiteral("Stereo3DJpsHalfHeight") << QStringLiteral("-1");
+        QTest::newRow("bad-gap") << QStringLiteral("Stereo3DJpsSeparation") << QStringLiteral("256");
+        QTest::newRow("odd-gap") << QStringLiteral("Stereo3DJpsSeparation") << QStringLiteral("1");
+        QTest::newRow("bad-display") << QStringLiteral("Stereo3DJpsDisplay") << QStringLiteral("3");
+        QTest::newRow("not-a-number") << QStringLiteral("Stereo3DJpsHalfWidth") << QStringLiteral("true");
+        QTest::newRow("non-ascii-comment") << QStringLiteral("Stereo3DJpsComment") << QString::fromUtf8("\xc3\xa9");
+        QTest::newRow("oversized-comment") << QStringLiteral("Stereo3DJpsComment") << QString(65518, QLatin1Char('a'));
+    }
+    void refusal()
+    {
+        QFETCH(QString, key);
+        QFETCH(QString, value);
+        QImage source(128, 64, QImage::Format_RGB32);
+        source.fill(Qt::red);
+        source.setText(key, value);
+        QByteArray data("untouched");
+        QBuffer output(&data);
+        QVERIFY(output.open(QIODevice::ReadWrite));
+        QImageWriter writer(&output, "jps");
+        QVERIFY(!writer.write(source));
+        QCOMPARE(data, QByteArray("untouched"));
+    }
+};
+QTEST_GUILESS_MAIN(JpsWriterTest)
+#include "jpswritertest.moc"
