--- a/debian/config
+++ b/debian/config
@@ -11,0 +12,12 @@
+
+# EULA presentation adapted from Michael Vogt's Ubuntu preinst (3.3ubuntu1).
+# No image or installer supplies an answer. Noninteractive keeps the false default.
+db_get msttcorefonts/accepted-mscorefonts-eula
+if [ "$RET" != true ]; then
+    db_fset msttcorefonts/present-mscorefonts-eula seen false
+    db_fset msttcorefonts/accepted-mscorefonts-eula seen false
+    db_input critical msttcorefonts/present-mscorefonts-eula || true
+    db_go || true
+    db_input critical msttcorefonts/accepted-mscorefonts-eula || true
+    db_go || true
+fi
--- a/debian/postinst.in
+++ b/debian/postinst.in
@@ -4,0 +5,10 @@
+
+# Ubuntu's default-false EULA gate, before any local-copy or network access.
+db_get msttcorefonts/accepted-mscorefonts-eula
+if [ "$RET" != true ]; then
+    db_input critical msttcorefonts/error-mscorefonts-eula || true
+    db_go || true
+    db_metaget msttcorefonts/error-mscorefonts-eula description
+    printf '%s\n%s\n' "$RET" 'dpkg-reconfigure ttf-mscorefonts-installer' >&2
+    exit 0
+fi
