+/*  A depth layer is a layer group that holds its layers at one depth the
+ *  artist sets, in pixels of separation with three decimals: positive
+ *  behind the screen, negative in front of it, never clamped.  Layers in
+ *  no depth layer are at the screen, so a 2D document is unchanged, and a
+ *  depth layer inside another is at its own value, never the sum.  Each
+ *  eye sees the layer moved by half the value (gimpeyeprojectable.c).
+ *
+ *  The value is kept as the group's persistent parasite "gimp-depth-layer"
+ *  (the text of stereo_depth_format()), so an XCF file keeps it and a GIMP
+ *  without depth layers opens a plain layer group and loses nothing.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include <stereo-depth.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "core-types.h"
+
+#include "gimp.h"
+#include "gimpcontainer.h"
+#include "gimpdepthlayer.h"
+#include "gimpimage.h"
+#include "gimpimage-undo.h"
+#include "gimpitemstack.h"
+#include "gimpitemundo.h"
+
+#include "gimp-intl.h"
+
+
+enum
+{
+  DEPTH_CHANGED,
+  LAST_SIGNAL
+};
+
+enum
+{
+  PROP_0,
+  PROP_DEPTH
+};
+
+
+struct _GimpDepthLayer
+{
+  GimpGroupLayer  parent_instance;
+
+  gdouble         depth;
+};
+
+
+static void       gimp_depth_layer_set_property (GObject      *object,
+                                                 guint         property_id,
+                                                 const GValue *value,
+                                                 GParamSpec   *pspec);
+static void       gimp_depth_layer_get_property (GObject      *object,
+                                                 guint         property_id,
+                                                 GValue       *value,
+                                                 GParamSpec   *pspec);
+
+static GimpItem * gimp_depth_layer_duplicate    (GimpItem     *item,
+                                                 GType         new_type);
+
+static void       gimp_depth_layer_store        (GimpDepthLayer *layer);
+
+
+G_DEFINE_TYPE (GimpDepthLayer, gimp_depth_layer, GIMP_TYPE_GROUP_LAYER)
+
+#define parent_class gimp_depth_layer_parent_class
+
+static guint depth_layer_signals[LAST_SIGNAL] = { 0 };
+
+
+/*  the undo of a depth: the value before the change  */
+
+#define GIMP_TYPE_DEPTH_LAYER_UNDO  (gimp_depth_layer_undo_get_type ())
+#define GIMP_DEPTH_LAYER_UNDO(obj)  (G_TYPE_CHECK_INSTANCE_CAST ((obj), GIMP_TYPE_DEPTH_LAYER_UNDO, GimpDepthLayerUndo))
+
+typedef struct _GimpDepthLayerUndo      GimpDepthLayerUndo;
+typedef struct _GimpDepthLayerUndoClass GimpDepthLayerUndoClass;
+
+struct _GimpDepthLayerUndo
+{
+  GimpItemUndo  parent_instance;
+
+  gdouble       depth;
+};
+
+struct _GimpDepthLayerUndoClass
+{
+  GimpItemUndoClass  parent_class;
+};
+
+static GType gimp_depth_layer_undo_get_type (void) G_GNUC_CONST;
+
+G_DEFINE_TYPE (GimpDepthLayerUndo, gimp_depth_layer_undo, GIMP_TYPE_ITEM_UNDO)
+
+static void
+gimp_depth_layer_undo_constructed (GObject *object)
+{
+  GimpDepthLayerUndo *undo = GIMP_DEPTH_LAYER_UNDO (object);
+
+  G_OBJECT_CLASS (gimp_depth_layer_undo_parent_class)->constructed (object);
+
+  undo->depth =
+    gimp_depth_layer_get_depth (GIMP_DEPTH_LAYER (GIMP_ITEM_UNDO (object)->item));
+}
+
+static void
+gimp_depth_layer_undo_pop (GimpUndo            *undo,
+                           GimpUndoMode         undo_mode,
+                           GimpUndoAccumulator *accum)
+{
+  GimpDepthLayerUndo *depth_undo = GIMP_DEPTH_LAYER_UNDO (undo);
+  GimpDepthLayer     *layer;
+  gdouble             depth;
+
+  GIMP_UNDO_CLASS (gimp_depth_layer_undo_parent_class)->pop (undo, undo_mode,
+                                                              accum);
+
+  layer = GIMP_DEPTH_LAYER (GIMP_ITEM_UNDO (undo)->item);
+
+  depth = gimp_depth_layer_get_depth (layer);
+  gimp_depth_layer_set_depth (layer, depth_undo->depth, FALSE);
+  depth_undo->depth = depth;
+}
+
+static void
+gimp_depth_layer_undo_class_init (GimpDepthLayerUndoClass *klass)
+{
+  GObjectClass  *object_class = G_OBJECT_CLASS (klass);
+  GimpUndoClass *undo_class   = GIMP_UNDO_CLASS (klass);
+
+  object_class->constructed = gimp_depth_layer_undo_constructed;
+
+  undo_class->pop           = gimp_depth_layer_undo_pop;
+}
+
+static void
+gimp_depth_layer_undo_init (GimpDepthLayerUndo *undo)
+{
+}
+
+
+/*  the layer  */
+
+static void
+gimp_depth_layer_class_init (GimpDepthLayerClass *klass)
+{
+  GObjectClass      *object_class   = G_OBJECT_CLASS (klass);
+  GimpViewableClass *viewable_class = GIMP_VIEWABLE_CLASS (klass);
+  GimpItemClass     *item_class     = GIMP_ITEM_CLASS (klass);
+
+  depth_layer_signals[DEPTH_CHANGED] =
+    g_signal_new ("depth-changed",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_FIRST,
+                  0,
+                  NULL, NULL, NULL,
+                  G_TYPE_NONE, 0);
+
+  object_class->set_property    = gimp_depth_layer_set_property;
+  object_class->get_property    = gimp_depth_layer_get_property;
+
+  viewable_class->default_name  = _("Depth Layer");
+
+  item_class->duplicate         = gimp_depth_layer_duplicate;
+
+  item_class->rename_desc       = C_("undo-type", "Rename Depth Layer");
+  item_class->translate_desc    = C_("undo-type", "Move Depth Layer");
+
+  g_object_class_install_property (object_class, PROP_DEPTH,
+                                   g_param_spec_double ("depth", NULL, NULL,
+                                                        -G_MAXDOUBLE,
+                                                        G_MAXDOUBLE,
+                                                        0.0,
+                                                        GIMP_PARAM_READWRITE));
+}
+
+static void
+gimp_depth_layer_init (GimpDepthLayer *layer)
+{
+  layer->depth = 0.0;
+}
+
+static void
+gimp_depth_layer_set_property (GObject      *object,
+                               guint         property_id,
+                               const GValue *value,
+                               GParamSpec   *pspec)
+{
+  GimpDepthLayer *layer = GIMP_DEPTH_LAYER (object);
+
+  switch (property_id)
+    {
+    case PROP_DEPTH:
+      gimp_depth_layer_set_depth (layer, g_value_get_double (value), FALSE);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_depth_layer_get_property (GObject    *object,
+                               guint       property_id,
+                               GValue     *value,
+                               GParamSpec *pspec)
+{
+  GimpDepthLayer *layer = GIMP_DEPTH_LAYER (object);
+
+  switch (property_id)
+    {
+    case PROP_DEPTH:
+      g_value_set_double (value, layer->depth);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static GimpItem *
+gimp_depth_layer_duplicate (GimpItem *item,
+                            GType     new_type)
+{
+  GimpItem *new_item;
+
+  new_item = GIMP_ITEM_CLASS (parent_class)->duplicate (item, new_type);
+
+  if (GIMP_IS_DEPTH_LAYER (new_item))
+    {
+      GIMP_DEPTH_LAYER (new_item)->depth = GIMP_DEPTH_LAYER (item)->depth;
+    }
+  else if (new_item)
+    {
+      /*  a plain group made from a depth layer is at the screen  */
+      gimp_item_parasite_detach (new_item, GIMP_DEPTH_LAYER_PARASITE, FALSE);
+    }
+
+  return new_item;
+}
+
+/*  the value as the group's persistent parasite, never with an undo of its
+ *  own: the depth's own undo restores the value, and the parasite with it
+ */
+static void
+gimp_depth_layer_store (GimpDepthLayer *layer)
+{
+  GimpParasite *parasite;
+  gchar         text[STEREO_DEPTH_TEXT_SIZE];
+
+  if (stereo_depth_format (layer->depth, text, sizeof (text)) < 0)
+    return;
+
+  parasite = gimp_parasite_new (GIMP_DEPTH_LAYER_PARASITE,
+                                GIMP_PARASITE_PERSISTENT,
+                                strlen (text), text);
+  gimp_item_parasite_attach (GIMP_ITEM (layer), parasite, FALSE);
+  gimp_parasite_free (parasite);
+}
+
+
+/*  public functions  */
+
+GimpLayer *
+gimp_depth_layer_new (GimpImage *image)
+{
+  GimpDepthLayer *layer;
+  const Babl     *format;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  format = gimp_image_get_layer_format (image, TRUE);
+
+  layer = GIMP_DEPTH_LAYER (gimp_drawable_new (GIMP_TYPE_DEPTH_LAYER,
+                                               image, NULL,
+                                               0, 0, 1, 1,
+                                               format));
+
+  gimp_layer_set_mode (GIMP_LAYER (layer),
+                       gimp_image_get_default_new_layer_mode (image),
+                       FALSE);
+
+  gimp_depth_layer_store (layer);
+
+  return GIMP_LAYER (layer);
+}
+
+gdouble
+gimp_depth_layer_get_depth (GimpDepthLayer *layer)
+{
+  g_return_val_if_fail (GIMP_IS_DEPTH_LAYER (layer), 0.0);
+
+  return layer->depth;
+}
+
+/*  Sets the depth, rounded to three decimals and never clamped; the
+ *  image's eyes follow through the layer's update.
+ */
+void
+gimp_depth_layer_set_depth (GimpDepthLayer *layer,
+                            gdouble         depth,
+                            gboolean        push_undo)
+{
+  GimpItem *item;
+
+  g_return_if_fail (GIMP_IS_DEPTH_LAYER (layer));
+
+  if (! isfinite (depth))
+    return;
+
+  depth = stereo_depth_round (depth);
+
+  if (depth == layer->depth)
+    {
+      /*  the parasite may still be missing on a new layer  */
+      if (! gimp_item_parasite_find (GIMP_ITEM (layer), GIMP_DEPTH_LAYER_PARASITE))
+        gimp_depth_layer_store (layer);
+      return;
+    }
+
+  item = GIMP_ITEM (layer);
+
+  if (push_undo && gimp_item_is_attached (item))
+    {
+      GimpImage *image = gimp_item_get_image (item);
+
+      gimp_image_undo_push (image, GIMP_TYPE_DEPTH_LAYER_UNDO,
+                            GIMP_UNDO_PARASITE_ATTACH,
+                            C_("undo-type", "Set Depth"),
+                            GIMP_DIRTY_ITEM_META,
+                            "item", item,
+                            NULL);
+    }
+
+  layer->depth = depth;
+
+  gimp_depth_layer_store (layer);
+
+  g_object_notify (G_OBJECT (layer), "depth");
+  g_signal_emit (layer, depth_layer_signals[DEPTH_CHANGED], 0);
+
+  if (gimp_item_is_attached (item))
+    gimp_drawable_update_all (GIMP_DRAWABLE (layer));
+}
+
+/*  The depth layer an item is at: itself or its nearest enclosing depth
+ *  layer, or NULL for an item at the screen.
+ */
+GimpDepthLayer *
+gimp_item_get_depth_layer (GimpItem *item)
+{
+  g_return_val_if_fail (item == NULL || GIMP_IS_ITEM (item), NULL);
+
+  for (; item; item = gimp_item_get_parent (item))
+    {
+      if (GIMP_IS_DEPTH_LAYER (item))
+        return GIMP_DEPTH_LAYER (item);
+    }
+
+  return NULL;
+}
+
+static gboolean
+gimp_depth_layers_in (GimpContainer *container)
+{
+  GList *list;
+
+  for (list = gimp_item_stack_get_item_iter (GIMP_ITEM_STACK (container));
+       list;
+       list = g_list_next (list))
+    {
+      GimpContainer *children;
+
+      if (GIMP_IS_DEPTH_LAYER (list->data))
+        return TRUE;
+
+      children = gimp_viewable_get_children (list->data);
+
+      if (children && gimp_depth_layers_in (children))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+gboolean
+gimp_image_has_depth_layers (GimpImage *image)
+{
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), FALSE);
+
+  return gimp_depth_layers_in (gimp_image_get_layers (image));
+}
+
+/*  Whether a group holds a depth layer anywhere below it.  */
+gboolean
+gimp_item_has_depth_layers_below (GimpItem *item)
+{
+  GimpContainer *children;
+
+  g_return_val_if_fail (GIMP_IS_ITEM (item), FALSE);
+
+  children = gimp_viewable_get_children (GIMP_VIEWABLE (item));
+
+  return children && gimp_depth_layers_in (children);
+}
+
+/*  Called by the XCF loader after a layer's properties are read: a layer
+ *  group carrying the depth parasite becomes a depth layer.  A parasite
+ *  that does not read as a value is told and the group is kept as it is.
+ */
+gboolean
+gimp_depth_layer_xcf_load_hack (GimpLayer **layer)
+{
+  const GimpParasite *parasite;
+  GimpImage          *image;
+  GimpLayer          *group;
+  GimpDepthLayer     *depth_layer;
+  const gchar        *data;
+  guint32             size;
+  gchar              *text;
+  gdouble             depth;
+
+  g_return_val_if_fail (layer != NULL, FALSE);
+  g_return_val_if_fail (GIMP_IS_LAYER (*layer), FALSE);
+
+  if (! GIMP_IS_GROUP_LAYER (*layer) || GIMP_IS_DEPTH_LAYER (*layer))
+    return FALSE;
+
+  parasite = gimp_item_parasite_find (GIMP_ITEM (*layer),
+                                      GIMP_DEPTH_LAYER_PARASITE);
+  if (! parasite)
+    return FALSE;
+
+  group = *layer;
+  image = gimp_item_get_image (GIMP_ITEM (group));
+
+  data = gimp_parasite_get_data (parasite, &size);
+  text = g_strndup (data, size);
+
+  if (stereo_depth_parse (text, &depth) < 0)
+    {
+      gimp_message (image->gimp, NULL, GIMP_MESSAGE_WARNING,
+                    _("The depth of the layer group '%s' cannot be read "
+                      "('%s'): it is opened as a plain layer group, at the "
+                      "screen."),
+                    gimp_object_get_name (group), text);
+      g_free (text);
+      return FALSE;
+    }
+
+  g_free (text);
+
+  depth_layer = GIMP_DEPTH_LAYER (gimp_depth_layer_new (image));
+
+  /*  the group's name, ID, tattoo, parasites, offsets, size, visibility
+   *  and locks
+   */
+  gimp_item_replace_item (GIMP_ITEM (depth_layer), GIMP_ITEM (group));
+
+  gimp_layer_set_opacity         (GIMP_LAYER (depth_layer),
+                                  gimp_layer_get_opacity (group), FALSE);
+  gimp_layer_set_mode            (GIMP_LAYER (depth_layer),
+                                  gimp_layer_get_mode (group), FALSE);
+  gimp_layer_set_blend_space     (GIMP_LAYER (depth_layer),
+                                  gimp_layer_get_blend_space (group), FALSE);
+  gimp_layer_set_composite_space (GIMP_LAYER (depth_layer),
+                                  gimp_layer_get_composite_space (group), FALSE);
+  gimp_layer_set_composite_mode  (GIMP_LAYER (depth_layer),
+                                  gimp_layer_get_composite_mode (group), FALSE);
+  gimp_layer_set_lock_alpha      (GIMP_LAYER (depth_layer),
+                                  gimp_layer_get_lock_alpha (group), FALSE);
+
+  depth_layer->depth = stereo_depth_round (depth);
+
+  g_object_ref_sink (group);
+  g_object_unref (group);
+
+  *layer = GIMP_LAYER (depth_layer);
+
+  return TRUE;
+}
