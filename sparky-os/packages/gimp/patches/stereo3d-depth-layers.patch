index 0000000..6009055
--- /dev/null
+++ b/app/core/gimpeyeprojectable.c
@@ -0,0 +1,715 @@
+/* GIMP - The GNU Image Manipulation Program
+ * Copyright (C) 1995 Spencer Kimball and Peter Mattis
+ *
+ * gimpeyeprojectable.c
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  One eye's picture of an image with depth layers.
+ *
+ *  The image's own graph composites each layer over the layers below it.
+ *  An eye's graph does the same with a copy of each layer's mode node,
+ *  fed by the eye's own picture of what lies below, while the layer's own
+ *  content and its mask come from the image's graph as they are: so every
+ *  layer mode, opacity, mask and effect is GIMP's own.  The content and
+ *  mask of a layer at a depth are moved by the eye's half of the depth
+ *  (gimp:depth-shift).  A group whose layers are all at one depth is moved
+ *  as one picture, its projection; a group that holds layers at another
+ *  depth, and every pass-through group, is composited again from its
+ *  layers.  Layers in no depth layer stay where they are, and a depth
+ *  layer inside another is at its own value, never the sum.
+ *
+ *  An image with the top-level layers "Left eye" and "Right eye" (the
+ *  stereo pictures plug-in's eye layers) shows each eye only its own.
+ *
+ *  The eye's graph is made again whenever what it depends on changes;
+ *  every change of the image's picture reaches the eye widened by the
+ *  largest move, the reach of the resampling window included.
+ */
+
+#include "config.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+
+#include <stereo-depth.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "core-types.h"
+
+#include "gimpcontainer.h"
+#include "gimpdepthlayer.h"
+#include "gimpdrawable-filters.h"
+#include "gimpeyeprojectable.h"
+#include "gimpimage.h"
+#include "gimpimage-private.h"
+#include "gimpitemstack.h"
+#include "gimpitemtree.h"
+#include "gimplayer.h"
+#include "gimpprojectable.h"
+
+#include "gimp-intl.h"
+
+
+#define LEFT_EYE_LAYER  "Left eye"
+#define RIGHT_EYE_LAYER "Right eye"
+
+/*  how far the resampling window reaches beyond a moved picture  */
+#define WINDOW_REACH    4
+
+
+struct _GimpEyeProjectable
+{
+  GimpViewable parent_instance;
+
+  GimpImage *image;
+  GimpEye    eye;
+
+  GeglNode  *graph;
+  GeglNode  *body;
+  gchar     *signature;
+  gint       margin;
+  gchar     *problem;
+};
+
+typedef struct
+{
+  GimpEyeProjectable *self;
+  GeglNode           *body;       /*  NULL: only describe  */
+  GString            *signature;
+  gdouble             widest;
+  gboolean            eye_layers;
+  gchar              *problem;
+} Walk;
+
+
+static void          gimp_eye_projectable_iface_init (GimpProjectableInterface *iface);
+
+static void          gimp_eye_projectable_finalize   (GObject            *object);
+
+static GimpImage   * gimp_eye_projectable_get_image  (GimpProjectable    *projectable);
+static const Babl  * gimp_eye_projectable_get_format (GimpProjectable    *projectable);
+static void          gimp_eye_projectable_get_offset (GimpProjectable    *projectable,
+                                                      gint               *x,
+                                                      gint               *y);
+static GeglRectangle gimp_eye_projectable_get_bounding_box
+                                                     (GimpProjectable    *projectable);
+static GeglNode    * gimp_eye_projectable_get_graph  (GimpProjectable    *projectable);
+
+static void          gimp_eye_projectable_walk       (GimpEyeProjectable *self,
+                                                      Walk               *walk);
+static gboolean      gimp_eye_projectable_check      (GimpEyeProjectable *self);
+
+static void          gimp_eye_projectable_image_invalidate
+                                                     (GimpProjectable    *image,
+                                                      gint                x,
+                                                      gint                y,
+                                                      gint                width,
+                                                      gint                height,
+                                                      GimpEyeProjectable *self);
+static void          gimp_eye_projectable_image_flush
+                                                     (GimpProjectable    *image,
+                                                      gboolean            invalidate_preview,
+                                                      GimpEyeProjectable *self);
+static void          gimp_eye_projectable_image_structure_changed
+                                                     (GimpProjectable    *image,
+                                                      GimpEyeProjectable *self);
+static void          gimp_eye_projectable_image_bounds_changed
+                                                     (GimpProjectable    *image,
+                                                      gint                old_x,
+                                                      gint                old_y,
+                                                      GimpEyeProjectable *self);
+
+
+G_DEFINE_TYPE_WITH_CODE (GimpEyeProjectable, gimp_eye_projectable, GIMP_TYPE_VIEWABLE,
+                         G_IMPLEMENT_INTERFACE (GIMP_TYPE_PROJECTABLE,
+                                                gimp_eye_projectable_iface_init))
+
+#define parent_class gimp_eye_projectable_parent_class
+
+
+static void
+gimp_eye_projectable_class_init (GimpEyeProjectableClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = gimp_eye_projectable_finalize;
+}
+
+static void
+gimp_eye_projectable_iface_init (GimpProjectableInterface *iface)
+{
+  iface->get_image        = gimp_eye_projectable_get_image;
+  iface->get_format       = gimp_eye_projectable_get_format;
+  iface->get_offset       = gimp_eye_projectable_get_offset;
+  iface->get_bounding_box = gimp_eye_projectable_get_bounding_box;
+  iface->get_graph        = gimp_eye_projectable_get_graph;
+}
+
+static void
+gimp_eye_projectable_init (GimpEyeProjectable *self)
+{
+}
+
+static void
+gimp_eye_projectable_finalize (GObject *object)
+{
+  GimpEyeProjectable *self = GIMP_EYE_PROJECTABLE (object);
+
+  if (self->image)
+    {
+      g_signal_handlers_disconnect_by_data (self->image, self);
+      g_object_remove_weak_pointer (G_OBJECT (self->image),
+                                    (gpointer *) &self->image);
+    }
+
+  g_clear_object (&self->graph);
+  g_free (self->signature);
+  g_free (self->problem);
+
+  G_OBJECT_CLASS (parent_class)->finalize (object);
+}
+
+static GimpImage *
+gimp_eye_projectable_get_image (GimpProjectable *projectable)
+{
+  return GIMP_EYE_PROJECTABLE (projectable)->image;
+}
+
+static const Babl *
+gimp_eye_projectable_get_format (GimpProjectable *projectable)
+{
+  GimpEyeProjectable *self = GIMP_EYE_PROJECTABLE (projectable);
+
+  return gimp_projectable_get_format (GIMP_PROJECTABLE (self->image));
+}
+
+static void
+gimp_eye_projectable_get_offset (GimpProjectable *projectable,
+                                 gint            *x,
+                                 gint            *y)
+{
+  *x = 0;
+  *y = 0;
+}
+
+static GeglRectangle
+gimp_eye_projectable_get_bounding_box (GimpProjectable *projectable)
+{
+  GimpEyeProjectable *self = GIMP_EYE_PROJECTABLE (projectable);
+
+  return gimp_projectable_get_bounding_box (GIMP_PROJECTABLE (self->image));
+}
+
+static GeglNode *
+gimp_eye_projectable_get_graph (GimpProjectable *projectable)
+{
+  GimpEyeProjectable *self = GIMP_EYE_PROJECTABLE (projectable);
+
+  if (! self->graph)
+    {
+      self->graph = gegl_node_new ();
+
+      gimp_eye_projectable_check (self);
+    }
+
+  return self->graph;
+}
+
+
+/*  the eye's graph  */
+
+static const gchar *
+gimp_eye_projectable_pad (gchar *name)
+{
+  const gchar *pad = g_intern_string (name ? name : "output");
+
+  g_free (name);
+
+  return pad;
+}
+
+/*  the producer of one of a node's inputs, moved by shift  */
+static GeglNode *
+gimp_eye_projectable_moved (Walk         *walk,
+                            GeglNode     *node,
+                            const gchar  *input,
+                            gdouble       shift,
+                            const gchar **pad)
+{
+  GeglNode *producer;
+  GeglNode *moved;
+  gchar    *name = NULL;
+
+  producer = gegl_node_get_producer (node, input, &name);
+  *pad     = gimp_eye_projectable_pad (name);
+
+  if (walk->signature)
+    g_string_append_printf (walk->signature, "%s<%p:%s ", input,
+                            (gpointer) producer, *pad);
+
+  if (! producer || shift == 0.0 || ! walk->body)
+    return producer;
+
+  moved = gegl_node_new_child (walk->body,
+                               "operation", "gimp:depth-shift",
+                               "shift",     shift,
+                               NULL);
+  gegl_node_connect (producer, *pad, moved, "input");
+  *pad = "output";
+
+  return moved;
+}
+
+/*  a copy of a node with its properties, over the eye's picture below  */
+static GeglNode *
+gimp_eye_projectable_copy (Walk        *walk,
+                           GeglNode    *original,
+                           GeglNode    *below,
+                           const gchar *below_pad)
+{
+  const gchar  *operation = gegl_node_get_operation (original);
+  GParamSpec  **specs;
+  guint         n_specs;
+  guint         i;
+  GeglNode     *node = NULL;
+
+  if (! operation)
+    return below;
+
+  if (walk->signature)
+    g_string_append_printf (walk->signature, "[%s", operation);
+
+  if (walk->body)
+    node = gegl_node_new_child (walk->body, "operation", operation, NULL);
+
+  specs = gegl_operation_list_properties (operation, &n_specs);
+
+  for (i = 0; i < n_specs; i++)
+    {
+      GValue value = G_VALUE_INIT;
+
+      if ((specs[i]->flags & G_PARAM_READWRITE) != G_PARAM_READWRITE ||
+          (specs[i]->flags & G_PARAM_CONSTRUCT_ONLY))
+        continue;
+
+      g_value_init (&value, G_PARAM_SPEC_VALUE_TYPE (specs[i]));
+      gegl_node_get_property (original, specs[i]->name, &value);
+
+      if (walk->signature)
+        {
+          gchar *contents = g_strdup_value_contents (&value);
+
+          g_string_append_printf (walk->signature, " %s=%s",
+                                  specs[i]->name, contents);
+          g_free (contents);
+        }
+
+      if (node)
+        gegl_node_set_property (node, specs[i]->name, &value);
+
+      g_value_unset (&value);
+    }
+
+  g_free (specs);
+
+  if (walk->signature)
+    g_string_append (walk->signature, "] ");
+
+  if (node && below)
+    gegl_node_connect (below, below_pad, node, "input");
+
+  return node;
+}
+
+static GeglNode *
+gimp_eye_projectable_stack (Walk          *walk,
+                            GimpContainer *stack,
+                            GeglNode      *below,
+                            gdouble        shift,
+                            gboolean       top_level)
+{
+  GimpEye  eye = walk->self->eye;
+  GList   *list;
+
+  /*  the stack's list is top first: composite from the bottom  */
+  for (list = g_list_last (gimp_item_stack_get_item_iter (GIMP_ITEM_STACK (stack)));
+       list;
+       list = g_list_previous (list))
+    {
+      GimpLayer     *layer    = list->data;
+      GimpContainer *children = gimp_viewable_get_children (GIMP_VIEWABLE (layer));
+      GeglNode      *mode;
+      GeglNode      *node;
+      GeglNode      *aux;
+      GeglNode      *aux2;
+      const gchar   *aux_pad;
+      const gchar   *aux2_pad;
+      gdouble        layer_shift = shift;
+      gboolean       pass_through;
+
+      g_string_append_printf (walk->signature, "{%p ", (gpointer) layer);
+
+      if (! gimp_filter_get_active (GIMP_FILTER (layer)))
+        {
+          g_string_append (walk->signature, "hidden} ");
+          continue;
+        }
+
+      if (top_level && walk->eye_layers)
+        {
+          const gchar *name = gimp_object_get_name (layer);
+
+          if ((eye == GIMP_EYE_LEFT  && ! g_strcmp0 (name, RIGHT_EYE_LAYER)) ||
+              (eye == GIMP_EYE_RIGHT && ! g_strcmp0 (name, LEFT_EYE_LAYER)))
+            {
+              g_string_append (walk->signature, "other-eye} ");
+              continue;
+            }
+        }
+
+      if (GIMP_IS_DEPTH_LAYER (layer))
+        {
+          gdouble depth = gimp_depth_layer_get_depth (GIMP_DEPTH_LAYER (layer));
+
+          layer_shift = stereo_depth_eye_shift (depth,
+                                                eye == GIMP_EYE_LEFT ?
+                                                STEREO_DEPTH_EYE_LEFT :
+                                                STEREO_DEPTH_EYE_RIGHT);
+        }
+
+      walk->widest = MAX (walk->widest, fabs (layer_shift));
+
+      g_string_append_printf (walk->signature, "shift=%.6f ", layer_shift);
+
+      mode = gimp_drawable_get_mode_node (GIMP_DRAWABLE (layer));
+
+      if (! mode)
+        {
+          g_string_append (walk->signature, "no-node} ");
+          continue;
+        }
+
+      pass_through = (children &&
+                      gimp_layer_get_mode (layer) == GIMP_LAYER_MODE_PASS_THROUGH);
+
+      if (children &&
+          (pass_through ||
+           gimp_item_has_depth_layers_below (GIMP_ITEM (layer))))
+        {
+          GeglNode *content;
+
+          g_string_append_printf (walk->signature, "group%s(",
+                                  pass_through ? "-pass-through" : "");
+
+          /*  the group's layers again, over the eye's picture below for a
+           *  pass-through group, over nothing for an isolated one
+           */
+          content = gimp_eye_projectable_stack (walk, children,
+                                                pass_through ? below : NULL,
+                                                layer_shift, FALSE);
+
+          g_string_append (walk->signature, ") ");
+
+          if (gimp_container_get_n_children (gimp_drawable_get_filters (GIMP_DRAWABLE (layer))) > 0 &&
+              ! walk->problem)
+            {
+              walk->problem =
+                g_strdup_printf (_("The effects of the layer group '%s' are "
+                                   "not shown in 3D: it holds layers at "
+                                   "another depth."),
+                                 gimp_object_get_name (layer));
+            }
+
+          node = gimp_eye_projectable_copy (walk, mode, below, "output");
+
+          aux2 = gimp_eye_projectable_moved (walk, mode, "aux2", layer_shift,
+                                             &aux2_pad);
+
+          if (node && content)
+            gegl_node_connect (content, "output", node, "aux");
+          if (node && aux2)
+            gegl_node_connect (aux2, aux2_pad, node, "aux2");
+        }
+      else
+        {
+          /*  the layer's own content and mask, as the image's graph has
+           *  them, moved together
+           */
+          node = gimp_eye_projectable_copy (walk, mode, below, "output");
+
+          aux  = gimp_eye_projectable_moved (walk, mode, "aux",  layer_shift,
+                                             &aux_pad);
+          aux2 = gimp_eye_projectable_moved (walk, mode, "aux2", layer_shift,
+                                             &aux2_pad);
+
+          if (node && aux)
+            gegl_node_connect (aux, aux_pad, node, "aux");
+          if (node && aux2)
+            gegl_node_connect (aux2, aux2_pad, node, "aux2");
+        }
+
+      g_string_append (walk->signature, "} ");
+
+      if (node)
+        below = node;
+    }
+
+  return below;
+}
+
+static void
+gimp_eye_projectable_walk (GimpEyeProjectable *self,
+                           Walk               *walk)
+{
+  GimpImagePrivate *private = GIMP_IMAGE_GET_PRIVATE (self->image);
+  GeglNode         *below;
+  GList            *list;
+  gboolean          left  = FALSE;
+  gboolean          right = FALSE;
+
+  for (list = gimp_image_get_layer_iter (self->image); list; list = g_list_next (list))
+    {
+      const gchar *name = gimp_object_get_name (list->data);
+
+      left  = left  || ! g_strcmp0 (name, LEFT_EYE_LAYER);
+      right = right || ! g_strcmp0 (name, RIGHT_EYE_LAYER);
+    }
+
+  walk->eye_layers = left && right;
+
+  g_string_append_printf (walk->signature, "eye=%d eye-layers=%d ",
+                          self->eye, walk->eye_layers);
+
+  below = gimp_eye_projectable_stack (walk,
+                                      gimp_image_get_layers (self->image),
+                                      NULL, 0.0, TRUE);
+
+  /*  the components shown, and the visible channels, as the image has them  */
+  if (private->visible_mask)
+    {
+      GeglNode *node = gimp_eye_projectable_copy (walk, private->visible_mask,
+                                                  below, "output");
+      if (node)
+        below = node;
+    }
+
+  for (list = g_list_last (gimp_item_stack_get_item_iter (GIMP_ITEM_STACK (gimp_image_get_channels (self->image))));
+       list;
+       list = g_list_previous (list))
+    {
+      GimpDrawable *channel = list->data;
+      GeglNode     *mode;
+      GeglNode     *node;
+      GeglNode     *aux;
+      GeglNode     *aux2;
+      const gchar  *aux_pad;
+      const gchar  *aux2_pad;
+
+      if (! gimp_filter_get_active (GIMP_FILTER (channel)))
+        continue;
+
+      mode = gimp_drawable_get_mode_node (channel);
+
+      if (! mode)
+        continue;
+
+      g_string_append_printf (walk->signature, "{channel %p ", (gpointer) channel);
+
+      node = gimp_eye_projectable_copy (walk, mode, below, "output");
+      aux  = gimp_eye_projectable_moved (walk, mode, "aux",  0.0, &aux_pad);
+      aux2 = gimp_eye_projectable_moved (walk, mode, "aux2", 0.0, &aux2_pad);
+
+      if (node && aux)
+        gegl_node_connect (aux, aux_pad, node, "aux");
+      if (node && aux2)
+        gegl_node_connect (aux2, aux2_pad, node, "aux2");
+
+      g_string_append (walk->signature, "} ");
+
+      if (node)
+        below = node;
+    }
+
+  if (walk->body && below)
+    {
+      GeglNode *output = gegl_node_get_output_proxy (walk->body, "output");
+
+      gegl_node_connect (below, "output", output, "input");
+    }
+}
+
+/*  Describes what the eye's graph depends on, and makes the graph again
+ *  when that changed.  Returns TRUE when it was made again.
+ */
+static gboolean
+gimp_eye_projectable_check (GimpEyeProjectable *self)
+{
+  Walk walk = { self, NULL, g_string_new (NULL), 0.0, FALSE, NULL };
+
+  if (! self->image)
+    {
+      g_string_free (walk.signature, TRUE);
+      return FALSE;
+    }
+
+  gimp_eye_projectable_walk (self, &walk);
+
+  g_free (walk.problem);
+
+  if (self->body && ! g_strcmp0 (walk.signature->str, self->signature))
+    {
+      g_string_free (walk.signature, TRUE);
+      return FALSE;
+    }
+
+  g_free (self->signature);
+  self->signature = g_string_free (walk.signature, FALSE);
+
+  if (! self->graph)
+    return TRUE;
+
+  /*  a new body under the same graph: the projection keeps its graph  */
+  if (self->body)
+    gegl_node_remove_child (self->graph, self->body);
+
+  self->body = gegl_node_new ();
+  gegl_node_add_child (self->graph, self->body);
+  g_object_unref (self->body);
+
+  walk.body      = self->body;
+  walk.signature = g_string_new (NULL);
+  walk.widest    = 0.0;
+  walk.problem   = NULL;
+
+  gimp_eye_projectable_walk (self, &walk);
+
+  g_string_free (walk.signature, TRUE);
+
+  g_free (self->problem);
+  self->problem = walk.problem;
+
+  self->margin = (gint) ceil (walk.widest) + (walk.widest > 0.0 ? WINDOW_REACH : 0);
+
+  gegl_node_connect (self->body, "output",
+                     gegl_node_get_output_proxy (self->graph, "output"), "input");
+
+  return TRUE;
+}
+
+
+/*  the image's changes, carried to the eye  */
+
+static void
+gimp_eye_projectable_image_invalidate (GimpProjectable    *image,
+                                       gint                x,
+                                       gint                y,
+                                       gint                width,
+                                       gint                height,
+                                       GimpEyeProjectable *self)
+{
+  if (gimp_eye_projectable_check (self))
+    {
+      gimp_projectable_structure_changed (GIMP_PROJECTABLE (self));
+      return;
+    }
+
+  gimp_projectable_invalidate (GIMP_PROJECTABLE (self),
+                               x - self->margin, y,
+                               width + 2 * self->margin, height);
+}
+
+static void
+gimp_eye_projectable_image_flush (GimpProjectable    *image,
+                                  gboolean            invalidate_preview,
+                                  GimpEyeProjectable *self)
+{
+  gimp_projectable_flush (GIMP_PROJECTABLE (self), invalidate_preview);
+}
+
+static void
+gimp_eye_projectable_image_structure_changed (GimpProjectable    *image,
+                                              GimpEyeProjectable *self)
+{
+  gimp_eye_projectable_check (self);
+  gimp_projectable_structure_changed (GIMP_PROJECTABLE (self));
+}
+
+static void
+gimp_eye_projectable_image_bounds_changed (GimpProjectable    *image,
+                                           gint                old_x,
+                                           gint                old_y,
+                                           GimpEyeProjectable *self)
+{
+  gimp_eye_projectable_check (self);
+  gimp_projectable_bounds_changed (GIMP_PROJECTABLE (self), old_x, old_y);
+}
+
+
+/*  public functions  */
+
+GimpEyeProjectable *
+gimp_eye_projectable_new (GimpImage *image,
+                          GimpEye    eye)
+{
+  GimpEyeProjectable *self;
+
+  g_return_val_if_fail (GIMP_IS_IMAGE (image), NULL);
+
+  self = g_object_new (GIMP_TYPE_EYE_PROJECTABLE, NULL);
+
+  self->image = image;
+  self->eye   = eye;
+
+  g_object_add_weak_pointer (G_OBJECT (image), (gpointer *) &self->image);
+
+  g_signal_connect (image, "invalidate",
+                    G_CALLBACK (gimp_eye_projectable_image_invalidate),
+                    self);
+  g_signal_connect (image, "flush",
+                    G_CALLBACK (gimp_eye_projectable_image_flush),
+                    self);
+  g_signal_connect (image, "structure-changed",
+                    G_CALLBACK (gimp_eye_projectable_image_structure_changed),
+                    self);
+  g_signal_connect (image, "bounds-changed",
+                    G_CALLBACK (gimp_eye_projectable_image_bounds_changed),
+                    self);
+
+  return self;
+}
+
+GimpEye
+gimp_eye_projectable_get_eye (GimpEyeProjectable *projectable)
+{
+  g_return_val_if_fail (GIMP_IS_EYE_PROJECTABLE (projectable), GIMP_EYE_LEFT);
+
+  return projectable->eye;
+}
+
+/*  What the eye cannot show as the image has it, in the person's language,
+ *  or NULL.
+ */
+const gchar *
+gimp_eye_projectable_get_problem (GimpEyeProjectable *projectable)
+{
+  g_return_val_if_fail (GIMP_IS_EYE_PROJECTABLE (projectable), NULL);
+
+  return projectable->problem;
+}
