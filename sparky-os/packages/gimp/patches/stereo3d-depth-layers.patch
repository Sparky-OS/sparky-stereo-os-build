+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  One eye's picture of a depth layer: its content moved by "shift"
+ *  pixels to the right (to the left when negative).  A whole move is a
+ *  copy of the samples in their own format; a fractional move is the
+ *  stereo policy library's own resampling (stereo_depth_shift_rgba(), a
+ *  Lanczos window of three lobes on premultiplied float samples), so the
+ *  canvas and an export of the pair give the same numbers.
+ */
+
+#include "config.h"
+
+#include <math.h>
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gegl.h>
+#include <gegl-plugin.h>
+
+#include <stereo-depth.h>
+
+#include "operations-types.h"
+
+#include "gimpoperationdepthshift.h"
+
+#include "gimp-intl.h"
+
+
+/*  the six taps of the window reach two samples before the place a sample
+ *  is read from and three after it
+ */
+#define TAPS_BEFORE 3
+#define TAPS_AFTER  4
+
+
+enum
+{
+  PROP_0,
+  PROP_SHIFT
+};
+
+
+static void          gimp_operation_depth_shift_set_property  (GObject             *object,
+                                                               guint                property_id,
+                                                               const GValue        *value,
+                                                               GParamSpec          *pspec);
+static void          gimp_operation_depth_shift_get_property  (GObject             *object,
+                                                               guint                property_id,
+                                                               GValue              *value,
+                                                               GParamSpec          *pspec);
+
+static void          gimp_operation_depth_shift_prepare       (GeglOperation       *operation);
+static GeglRectangle gimp_operation_depth_shift_get_bounding_box
+                                                              (GeglOperation       *operation);
+static GeglRectangle gimp_operation_depth_shift_get_required_for_output
+                                                              (GeglOperation       *operation,
+                                                               const gchar         *input_pad,
+                                                               const GeglRectangle *roi);
+static GeglRectangle gimp_operation_depth_shift_get_invalidated_by_change
+                                                              (GeglOperation       *operation,
+                                                               const gchar         *input_pad,
+                                                               const GeglRectangle *input_roi);
+static gboolean      gimp_operation_depth_shift_process       (GeglOperation       *operation,
+                                                               GeglBuffer          *input,
+                                                               GeglBuffer          *output,
+                                                               const GeglRectangle *roi,
+                                                               gint                 level);
+
+
+G_DEFINE_TYPE (GimpOperationDepthShift, gimp_operation_depth_shift,
+               GEGL_TYPE_OPERATION_FILTER)
+
+#define parent_class gimp_operation_depth_shift_parent_class
+
+
+static void
+gimp_operation_depth_shift_class_init (GimpOperationDepthShiftClass *klass)
+{
+  GObjectClass             *object_class    = G_OBJECT_CLASS (klass);
+  GeglOperationClass       *operation_class = GEGL_OPERATION_CLASS (klass);
+  GeglOperationFilterClass *filter_class    = GEGL_OPERATION_FILTER_CLASS (klass);
+
+  object_class->set_property                 = gimp_operation_depth_shift_set_property;
+  object_class->get_property                 = gimp_operation_depth_shift_get_property;
+
+  operation_class->prepare                   = gimp_operation_depth_shift_prepare;
+  operation_class->get_bounding_box          = gimp_operation_depth_shift_get_bounding_box;
+  operation_class->get_required_for_output   = gimp_operation_depth_shift_get_required_for_output;
+  operation_class->get_invalidated_by_change = gimp_operation_depth_shift_get_invalidated_by_change;
+
+  operation_class->threaded                  = TRUE;
+  operation_class->cache_policy              = GEGL_CACHE_POLICY_NEVER;
+
+  filter_class->process                      = gimp_operation_depth_shift_process;
+
+  gegl_operation_class_set_keys (operation_class,
+                                 "name",        "gimp:depth-shift",
+                                 "categories",  "transform",
+                                 "description", "One eye's picture of a depth layer",
+                                 NULL);
+
+  g_object_class_install_property (object_class, PROP_SHIFT,
+                                   g_param_spec_double ("shift",
+                                                        "Shift",
+                                                        "Pixels to the right",
+                                                        -G_MAXDOUBLE,
+                                                        G_MAXDOUBLE,
+                                                        0.0,
+                                                        G_PARAM_READWRITE |
+                                                        G_PARAM_CONSTRUCT));
+}
+
+static void
+gimp_operation_depth_shift_init (GimpOperationDepthShift *self)
+{
+}
+
+static void
+gimp_operation_depth_shift_set_property (GObject      *object,
+                                         guint         property_id,
+                                         const GValue *value,
+                                         GParamSpec   *pspec)
+{
+  GimpOperationDepthShift *self = GIMP_OPERATION_DEPTH_SHIFT (object);
+
+  switch (property_id)
+    {
+    case PROP_SHIFT:
+      self->shift = g_value_get_double (value);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+static void
+gimp_operation_depth_shift_get_property (GObject    *object,
+                                         guint       property_id,
+                                         GValue     *value,
+                                         GParamSpec *pspec)
+{
+  GimpOperationDepthShift *self = GIMP_OPERATION_DEPTH_SHIFT (object);
+
+  switch (property_id)
+    {
+    case PROP_SHIFT:
+      g_value_set_double (value, self->shift);
+      break;
+
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+      break;
+    }
+}
+
+/*  the samples keep their own format, so a whole move is exact  */
+static void
+gimp_operation_depth_shift_prepare (GeglOperation *operation)
+{
+  const Babl *format = gegl_operation_get_source_format (operation, "input");
+
+  if (! format)
+    format = babl_format ("RaGaBaA float");
+
+  gegl_operation_set_format (operation, "input",  format);
+  gegl_operation_set_format (operation, "output", format);
+}
+
+/*  the columns an input span reaches, moved by shift  */
+static void
+gimp_operation_depth_shift_span (gdouble  shift,
+                                 gint     x,
+                                 gint     width,
+                                 gint    *out_x,
+                                 gint    *out_width)
+{
+  if (stereo_depth_shift_is_whole (shift))
+    {
+      *out_x     = x + (gint) llrint (shift);
+      *out_width = width;
+    }
+  else
+    {
+      *out_x     = (gint) floor (x + shift) - TAPS_BEFORE;
+      *out_width = width + TAPS_BEFORE + TAPS_AFTER;
+    }
+}
+
+static GeglRectangle
+gimp_operation_depth_shift_get_bounding_box (GeglOperation *operation)
+{
+  GimpOperationDepthShift *self   = GIMP_OPERATION_DEPTH_SHIFT (operation);
+  GeglRectangle            result = { 0, };
+  GeglRectangle           *in;
+
+  in = gegl_operation_source_get_bounding_box (operation, "input");
+
+  if (! in || gegl_rectangle_is_empty (in))
+    return result;
+
+  if (gegl_rectangle_is_infinite_plane (in))
+    return *in;
+
+  result = *in;
+  gimp_operation_depth_shift_span (self->shift, in->x, in->width,
+                                   &result.x, &result.width);
+
+  return result;
+}
+
+static GeglRectangle
+gimp_operation_depth_shift_get_required_for_output (GeglOperation       *operation,
+                                                    const gchar         *input_pad,
+                                                    const GeglRectangle *roi)
+{
+  GimpOperationDepthShift *self   = GIMP_OPERATION_DEPTH_SHIFT (operation);
+  GeglRectangle            result = *roi;
+
+  gimp_operation_depth_shift_span (-self->shift, roi->x, roi->width,
+                                   &result.x, &result.width);
+
+  return result;
+}
+
+static GeglRectangle
+gimp_operation_depth_shift_get_invalidated_by_change (GeglOperation       *operation,
+                                                      const gchar         *input_pad,
+                                                      const GeglRectangle *input_roi)
+{
+  GimpOperationDepthShift *self   = GIMP_OPERATION_DEPTH_SHIFT (operation);
+  GeglRectangle            result = *input_roi;
+
+  gimp_operation_depth_shift_span (self->shift, input_roi->x, input_roi->width,
+                                   &result.x, &result.width);
+
+  return result;
+}
+
+static gboolean
+gimp_operation_depth_shift_process (GeglOperation       *operation,
+                                    GeglBuffer          *input,
+                                    GeglBuffer          *output,
+                                    const GeglRectangle *roi,
+                                    gint                 level)
+{
+  GimpOperationDepthShift *self = GIMP_OPERATION_DEPTH_SHIFT (operation);
+  gdouble                  shift;
+  const Babl              *format;
+  GeglRectangle            frame;
+  gint                     margin;
+  gfloat                  *samples;
+
+  /*  a picture at a lower level of detail is smaller by its level  */
+  shift = self->shift / (gdouble) (1 << level);
+
+  if (stereo_depth_shift_is_whole (shift))
+    {
+      GeglRectangle source = *roi;
+
+      source.x -= (gint) llrint (shift);
+
+      gegl_buffer_copy (input, &source, GEGL_ABYSS_NONE, output, roi);
+
+      return TRUE;
+    }
+
+  format = babl_format_with_space ("RaGaBaA float",
+                                   gegl_buffer_get_format (input));
+
+  margin = (gint) ceil (fabs (shift)) + TAPS_AFTER;
+
+  frame.x      = roi->x - margin;
+  frame.y      = roi->y;
+  frame.width  = roi->width + 2 * margin;
+  frame.height = roi->height;
+
+  samples = g_try_new (gfloat, (gsize) frame.width * frame.height * 4);
+
+  if (! samples)
+    return FALSE;
+
+  gegl_buffer_get (input, &frame, 1.0, format, samples,
+                   GEGL_AUTO_ROWSTRIDE, GEGL_ABYSS_NONE);
+
+  if (stereo_depth_shift_rgba (samples, frame.width, frame.height,
+                               frame.width * 4 * sizeof (gfloat),
+                               sizeof (gfloat), TRUE, shift, samples) < 0)
+    {
+      g_free (samples);
+      return FALSE;
+    }
+
+  gegl_buffer_set (output, roi, 0, format, samples + margin * 4,
+                   frame.width * 4 * sizeof (gfloat));
+
+  g_free (samples);
+
+  return TRUE;
+}
