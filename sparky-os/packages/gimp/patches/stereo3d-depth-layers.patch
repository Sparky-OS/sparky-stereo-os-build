+/*  A depth layer takes the place of the topmost selected layer and holds
+ *  the selected layers, in their order; with nothing selected, an empty
+ *  depth layer goes on top.  It starts at the screen (0.000).
+ */
+void
+layers_new_depth_layer_cmd_callback (GimpAction *action,
+                                     GVariant   *value,
+                                     gpointer    data)
+{
+  GimpImage *image;
+  GimpLayer *depth_layer;
+  GimpLayer *parent   = NULL;
+  gint       position = 0;
+  GList     *selected;
+  GList     *ordered  = NULL;
+  GList     *all;
+  GList     *iter;
+  gint       index    = 0;
+  return_if_no_image (image, data);
+
+  selected = gimp_image_get_selected_layers (image);
+
+  /*  the selected layers top first, leaving out those whose group is
+   *  selected too
+   */
+  all = gimp_image_get_layer_list (image);
+
+  for (iter = all; iter; iter = iter->next)
+    {
+      GimpItem *item = iter->data;
+      GimpItem *ancestor;
+      gboolean  inside = FALSE;
+
+      if (! g_list_find (selected, item))
+        continue;
+
+      for (ancestor = gimp_item_get_parent (item);
+           ancestor;
+           ancestor = gimp_item_get_parent (ancestor))
+        if (g_list_find (selected, ancestor))
+          inside = TRUE;
+
+      if (! inside)
+        ordered = g_list_append (ordered, item);
+    }
+
+  g_list_free (all);
+
+  if (ordered)
+    {
+      parent   = GIMP_LAYER (gimp_item_get_parent (ordered->data));
+      position = gimp_item_get_index (ordered->data);
+    }
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               _("New Depth Layer"));
+
+  depth_layer = gimp_depth_layer_new (image);
+
+  gimp_image_add_layer (image, depth_layer, parent, position, TRUE);
+
+  for (iter = ordered; iter; iter = iter->next)
+    gimp_image_reorder_item (image, iter->data, GIMP_ITEM (depth_layer),
+                             index++, TRUE, NULL);
+
+  gimp_image_set_selected_layers (image, g_list_prepend (NULL, depth_layer));
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+
+  g_list_free (ordered);
+}
+
+/*  A pop or sink key pressed starts the gesture over the canvas; from the
+ *  menu (or with no image window) the depth moves by one pixel.
+ */
+static void
+layers_depth_key (gpointer data,
+                  gint     direction)
+{
+  GimpImage      *image;
+  GimpDisplay    *display;
+  GdkEvent       *event;
+  GimpDepthLayer *layer;
+  GList          *layers;
+  return_if_no_image (image, data);
+
+  display = action_data_get_display (data);
+  event   = gtk_get_current_event ();
+
+  if (display && event && event->type == GDK_KEY_PRESS)
+    {
+      gimp_display_shell_depth_key_press (gimp_display_get_shell (display),
+                                          direction, event->key.keyval);
+      gdk_event_free (event);
+      return;
+    }
+
+  if (event)
+    gdk_event_free (event);
+
+  layers = gimp_image_get_selected_layers (image);
+  layer  = layers ? gimp_item_get_depth_layer (layers->data) : NULL;
+
+  if (! layer)
+    return;
+
+  gimp_depth_layer_set_depth (layer,
+                              gimp_depth_layer_get_depth (layer) + direction,
+                              TRUE);
+  gimp_image_flush (image);
+}
+
+void
+layers_depth_pop_cmd_callback (GimpAction *action,
+                               GVariant   *value,
+                               gpointer    data)
+{
+  layers_depth_key (data, -1);
+}
+
+void
+layers_depth_sink_cmd_callback (GimpAction *action,
+                                GVariant   *value,
+                                gpointer    data)
+{
+  layers_depth_key (data, 1);
+}
