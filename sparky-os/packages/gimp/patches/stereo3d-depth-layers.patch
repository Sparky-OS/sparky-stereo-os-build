+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/*  The pop and sink keys of depth layers (queue row 148): while one of
+ *  the two is held over the canvas, the pointer's movement, with the
+ *  tool's drag or without it, moves the depth layer of the selected layer
+ *  forward (pop) or back (sink), and the tool does not see that movement.
+ *  The keys are the actions "layers-depth-pop" and "layers-depth-sink"
+ *  (8 and 7 by default, rebindable); a key press starts the gesture and
+ *  its release ends it, with one undo step for the whole gesture.
+ */
+
+#include "config.h"
+
+#include <math.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpbase/gimpbase.h"
+
+#include "display-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpdepthlayer.h"
+#include "core/gimpimage.h"
+
+#include "gimpdisplay.h"
+#include "gimpdisplayshell.h"
+#include "gimpdisplayshell-depth.h"
+
+#include "gimp-intl.h"
+
+
+static gboolean gimp_display_shell_depth_key_window_event (GtkWidget        *window,
+                                                           GdkEvent         *event,
+                                                           GimpDisplayShell *shell);
+
+
+static GimpDepthLayer *
+gimp_display_shell_depth_layer (GimpDisplayShell *shell)
+{
+  GimpImage *image = gimp_display_get_image (shell->display);
+  GList     *layers;
+
+  if (! image)
+    return NULL;
+
+  layers = gimp_image_get_selected_layers (image);
+
+  return layers ? gimp_item_get_depth_layer (layers->data) : NULL;
+}
+
+/*  Starts the gesture of a key held over the canvas (direction -1 pops,
+ *  1 sinks).  Returns FALSE, after telling the person why, when the
+ *  selected layer is in no depth layer.
+ */
+gboolean
+gimp_display_shell_depth_key_press (GimpDisplayShell *shell,
+                                    gint              direction,
+                                    guint             keyval)
+{
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), FALSE);
+
+  keyval = gdk_keyval_to_lower (keyval);
+
+  /*  the key's own repeats  */
+  if (shell->depth_key_direction == direction &&
+      shell->depth_key_keyval    == keyval)
+    return TRUE;
+
+  if (! gimp_display_shell_depth_layer (shell))
+    {
+      gimp_message_literal (shell->display->gimp, G_OBJECT (shell),
+                            GIMP_MESSAGE_WARNING,
+                            _("To pop or sink a depth layer, select it or "
+                              "a layer in it."));
+      return FALSE;
+    }
+
+  shell->depth_key_direction   = direction;
+  shell->depth_key_keyval      = keyval;
+  shell->depth_key_have_last   = FALSE;
+  shell->depth_key_undo_pushed = FALSE;
+
+  /*  the movement counts from where the pointer is when the key goes down  */
+  if (gtk_widget_get_realized (shell->canvas))
+    {
+      GdkDisplay *display = gtk_widget_get_display (shell->canvas);
+      GdkDevice  *pointer = gdk_seat_get_pointer (gdk_display_get_default_seat (display));
+      gdouble     x, y;
+
+      if (gdk_window_get_device_position_double (gtk_widget_get_window (shell->canvas),
+                                                 pointer, &x, &y, NULL))
+        {
+          shell->depth_key_have_last = TRUE;
+          shell->depth_key_last_x    = x;
+          shell->depth_key_last_y    = y;
+        }
+    }
+
+  /*  the key's release may reach another widget of the window than the
+   *  canvas: the window itself is watched until the gesture ends
+   */
+  g_signal_connect (gtk_widget_get_toplevel (GTK_WIDGET (shell)),
+                    "key-release-event",
+                    G_CALLBACK (gimp_display_shell_depth_key_window_event),
+                    shell);
+  g_signal_connect (gtk_widget_get_toplevel (GTK_WIDGET (shell)),
+                    "focus-out-event",
+                    G_CALLBACK (gimp_display_shell_depth_key_window_event),
+                    shell);
+
+  return TRUE;
+}
+
+static gboolean
+gimp_display_shell_depth_key_window_event (GtkWidget        *window,
+                                           GdkEvent         *event,
+                                           GimpDisplayShell *shell)
+{
+  if (event->type == GDK_FOCUS_CHANGE ||
+      (event->type == GDK_KEY_RELEASE &&
+       gdk_keyval_to_lower (event->key.keyval) == shell->depth_key_keyval))
+    gimp_display_shell_depth_key_end (shell);
+
+  return FALSE;
+}
+
+void
+gimp_display_shell_depth_key_end (GimpDisplayShell *shell)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  g_signal_handlers_disconnect_by_func (gtk_widget_get_toplevel (GTK_WIDGET (shell)),
+                                        gimp_display_shell_depth_key_window_event,
+                                        shell);
+
+  shell->depth_key_direction   = 0;
+  shell->depth_key_keyval      = 0;
+  shell->depth_key_have_last   = FALSE;
+  shell->depth_key_undo_pushed = FALSE;
+}
+
+/*  Called first by the canvas's event handler.  Returns TRUE for an event
+ *  the gesture took (the key's release, the pointer's movement).
+ */
+gboolean
+gimp_display_shell_depth_key_event (GimpDisplayShell *shell,
+                                    const GdkEvent   *event)
+{
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), FALSE);
+
+  if (! shell->depth_key_direction)
+    return FALSE;
+
+  switch (event->type)
+    {
+    case GDK_KEY_RELEASE:
+      if (gdk_keyval_to_lower (event->key.keyval) == shell->depth_key_keyval)
+        {
+          gimp_display_shell_depth_key_end (shell);
+          return TRUE;
+        }
+      break;
+
+    case GDK_FOCUS_CHANGE:
+      if (! event->focus_change.in)
+        gimp_display_shell_depth_key_end (shell);
+      break;
+
+    case GDK_MOTION_NOTIFY:
+      {
+        GimpDepthLayer *layer = gimp_display_shell_depth_layer (shell);
+        gdouble         x     = event->motion.x;
+        gdouble         y     = event->motion.y;
+        gdouble         travel;
+
+        if (! layer)
+          {
+            gimp_display_shell_depth_key_end (shell);
+            return FALSE;
+          }
+
+        if (shell->depth_key_have_last)
+          {
+            travel = hypot (x - shell->depth_key_last_x,
+                            y - shell->depth_key_last_y);
+
+            if (travel > 0.0)
+              {
+                gdouble depth = gimp_depth_layer_get_depth (layer);
+
+                depth += shell->depth_key_direction * travel *
+                         GIMP_DISPLAY_SHELL_DEPTH_PER_PIXEL;
+
+                gimp_depth_layer_set_depth (layer, depth,
+                                            ! shell->depth_key_undo_pushed);
+                shell->depth_key_undo_pushed = TRUE;
+
+                gimp_image_flush (gimp_display_get_image (shell->display));
+              }
+          }
+
+        shell->depth_key_have_last = TRUE;
+        shell->depth_key_last_x    = x;
+        shell->depth_key_last_y    = y;
+
+        return TRUE;
+      }
+
+    default:
+      break;
+    }
+
+  return FALSE;
+}
