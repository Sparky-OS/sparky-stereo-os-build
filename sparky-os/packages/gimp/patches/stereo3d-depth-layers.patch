+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+
+# You should have received a copy of the GNU General Public License
+# along with this program.  If not, see <https://www.gnu.org/licenses/>.
+
+# Depth layers (queue row 148 of Sparky Stereo OS): the procedures are the
+# core's only; plug-ins reach them by name through the PDB.
+
+sub depth_layer_new {
+    $blurb = 'Create a new depth layer.';
+
+    $help = <<'HELP';
+This procedure creates a new depth layer: a layer group that holds its
+layers at one depth, in pixels of separation with three decimals, positive
+behind the screen and negative in front of it, never clamped. Each eye sees
+the layer moved by half the depth.
+
+
+The new depth layer still needs to be added to the image, as this is not
+automatic. Add the new layer with the [method@Image.insert_layer] method.
+HELP
+
+    &contrib_pdb_misc('Daniel Ramos', '', '2026', '3.2');
+
+    @inargs = (
+	{ name => 'image', type => 'image',
+	  desc => 'The image to which to add the depth layer' },
+	{ name => 'name', type => 'string', none_ok => 1,
+	  desc => "The depth layer name" },
+	{ name => 'depth', type => 'double',
+	  desc => 'The depth in pixels of separation' }
+    );
+
+    @outargs = (
+	{ name => 'depth_layer', type => 'group_layer',
+	  desc => 'The newly created depth layer' }
+    );
+
+    %invoke = (
+	code => <<'CODE'
+{
+  depth_layer = GIMP_GROUP_LAYER (gimp_depth_layer_new (image));
+
+  if (! depth_layer)
+    {
+      success = FALSE;
+    }
+  else
+    {
+      if (name != NULL && strlen (name) > 0)
+        gimp_item_rename (GIMP_ITEM (depth_layer), name, error);
+
+      gimp_depth_layer_set_depth (GIMP_DEPTH_LAYER (depth_layer), depth, FALSE);
+    }
+}
+CODE
+    );
+}
+
+sub depth_layer_get_depth {
+    $blurb = 'Get the depth of a depth layer.';
+
+    $help = <<'HELP';
+This procedure returns the depth of a depth layer, in pixels of separation
+with three decimals: positive behind the screen, negative in front of it.
+It fails for a layer group that is not a depth layer.
+HELP
+
+    &contrib_pdb_misc('Daniel Ramos', '', '2026', '3.2');
+
+    @inargs = (
+	{ name => 'depth_layer', type => 'group_layer',
+	  desc => 'The depth layer' }
+    );
+
+    @outargs = (
+	{ name => 'depth', type => 'double',
+	  desc => 'The depth in pixels of separation' }
+    );
+
+    %invoke = (
+	code => <<'CODE'
+{
+  if (GIMP_IS_DEPTH_LAYER (depth_layer))
+    {
+      depth = gimp_depth_layer_get_depth (GIMP_DEPTH_LAYER (depth_layer));
+    }
+  else
+    {
+      g_set_error (error, GIMP_PDB_ERROR, GIMP_PDB_ERROR_INVALID_ARGUMENT,
+                   _("Layer group '%s' (%d) is not a depth layer"),
+                   gimp_object_get_name (depth_layer),
+                   gimp_item_get_id (GIMP_ITEM (depth_layer)));
+      success = FALSE;
+    }
+}
+CODE
+    );
+}
+
+sub depth_layer_set_depth {
+    $blurb = 'Set the depth of a depth layer.';
+
+    $help = <<'HELP';
+This procedure sets the depth of a depth layer, in pixels of separation
+rounded to three decimals: positive behind the screen, negative in front of
+it, never clamped. It fails for a layer group that is not a depth layer.
+HELP
+
+    &contrib_pdb_misc('Daniel Ramos', '', '2026', '3.2');
+
+    @inargs = (
+	{ name => 'depth_layer', type => 'group_layer',
+	  desc => 'The depth layer' },
+	{ name => 'depth', type => 'double',
+	  desc => 'The depth in pixels of separation' }
+    );
+
+    %invoke = (
+	code => <<'CODE'
+{
+  if (GIMP_IS_DEPTH_LAYER (depth_layer))
+    {
+      gimp_depth_layer_set_depth (GIMP_DEPTH_LAYER (depth_layer), depth, TRUE);
+    }
+  else
+    {
+      g_set_error (error, GIMP_PDB_ERROR, GIMP_PDB_ERROR_INVALID_ARGUMENT,
+                   _("Layer group '%s' (%d) is not a depth layer"),
+                   gimp_object_get_name (depth_layer),
+                   gimp_item_get_id (GIMP_ITEM (depth_layer)));
+      success = FALSE;
+    }
+}
+CODE
+    );
+}
+
+sub depth_layer_new_from_eye {
+    $blurb = "Create a new layer from one eye's picture of an image with depth layers.";
+
+    $help = <<'HELP';
+This procedure creates a new layer from what one eye sees of the image (0 the
+left eye, 1 the right eye): every depth layer moved by its half of the depth,
+as the canvas shows it. With the top-level layers "Left eye" and "Right eye",
+each eye sees only its own. The new layer still needs to be added to the
+destination image.
+HELP
+
+    &contrib_pdb_misc('Daniel Ramos', '', '2026', '3.2');
+
+    @inargs = (
+	{ name => 'image', type => 'image',
+	  desc => 'The source image' },
+	{ name => 'dest_image', type => 'image',
+	  desc => 'The destination image to which to add the layer' },
+	{ name => 'eye', type => '0 <= int32 <= 1',
+	  desc => 'The eye: 0 left, 1 right' },
+	{ name => 'name', type => 'string', none_ok => 1,
+	  desc => 'The layer name' }
+    );
+
+    @outargs = (
+	{ name => 'layer', type => 'layer',
+	  desc => 'The newly created layer' }
+    );
+
+    %invoke = (
+	code => <<'CODE'
+{
+  GimpEyeProjectable *projectable;
+  GimpProjection     *projection;
+  GimpColorProfile   *profile;
+
+  /*  the eye's picture the canvas shows, rendered whole  */
+  projectable = gimp_eye_projectable_new (image,
+                                          eye ? GIMP_EYE_RIGHT : GIMP_EYE_LEFT);
+  projection  = gimp_projection_new (GIMP_PROJECTABLE (projectable));
+
+  gimp_pickable_flush (GIMP_PICKABLE (projection));
+
+  profile = gimp_color_managed_get_color_profile (GIMP_COLOR_MANAGED (image));
+
+  layer = gimp_layer_new_from_gegl_buffer (gimp_pickable_get_buffer (GIMP_PICKABLE (projection)),
+                                           dest_image,
+                                           gimp_image_get_layer_format (dest_image,
+                                                                        TRUE),
+                                           name,
+                                           GIMP_OPACITY_OPAQUE,
+                                           gimp_image_get_default_new_layer_mode (dest_image),
+                                           profile);
+
+  g_object_unref (projection);
+  g_object_unref (projectable);
+
+  if (! layer)
+    success = FALSE;
+}
+CODE
+    );
+}
+
+
+@headers = qw(<cairo.h>
+              "libgimpbase/gimpbase.h"
+              "libgimpcolor/gimpcolor.h"
+              "core/gimp.h"
+              "core/gimpdepthlayer.h"
+              "core/gimpeyeprojectable.h"
+              "core/gimpimage.h"
+              "core/gimplayer-new.h"
+              "core/gimppickable.h"
+              "core/gimpprojectable.h"
+              "core/gimpprojection.h"
+              "gimppdberror.h"
+              "gimp-intl.h");
+
+@procs = qw(depth_layer_new
+            depth_layer_get_depth
+            depth_layer_set_depth
+            depth_layer_new_from_eye);
+
+%exports = (app => [@procs], lib => []);
+
+$desc = 'Depth Layer';
+$doc_title = 'gimpdepthlayer';
+$doc_short_desc = 'Operations on a depth layer.';
+$doc_long_desc = 'Operations on a depth layer.';
+
+1;
