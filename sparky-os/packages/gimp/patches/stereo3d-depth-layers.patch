+/*  Each eye's picture of an image with depth layers: a projection of its
+ *  own, whose updates redraw the canvas as the image's own do.
+ */
+static void
+gimp_display_shell_stereo_make_eyes (GimpDisplayShellStereo *stereo,
+                                     GimpImage              *image)
+{
+  gint e;
+
+  if (stereo->eyes[0] &&
+      gimp_projectable_get_image (GIMP_PROJECTABLE (stereo->eyes[0])) == image)
+    return;
+
+  gimp_display_shell_stereo_clear_eyes (stereo);
+
+  for (e = 0; e < 2; e++)
+    {
+      stereo->eyes[e] = gimp_eye_projectable_new (image,
+                                                  e ? GIMP_EYE_RIGHT :
+                                                      GIMP_EYE_LEFT);
+      stereo->eye_projection[e] =
+        gimp_projection_new (GIMP_PROJECTABLE (stereo->eyes[e]));
+
+      g_signal_connect (stereo->eye_projection[e], "update",
+                        G_CALLBACK (gimp_display_shell_stereo_eye_update),
+                        stereo);
+    }
+}
+
+static void
+gimp_display_shell_stereo_clear_eyes (GimpDisplayShellStereo *stereo)
+{
+  gint e;
+
+  for (e = 0; e < 2; e++)
+    {
+      if (stereo->eye_projection[e])
+        g_signal_handlers_disconnect_by_data (stereo->eye_projection[e], stereo);
+
+      g_clear_object (&stereo->eye_projection[e]);
+      g_clear_object (&stereo->eyes[e]);
+    }
+}
+
+static void
+gimp_display_shell_stereo_eye_update (GimpProjection         *projection,
+                                      gboolean                now,
+                                      gint                    x,
+                                      gint                    y,
+                                      gint                    width,
+                                      gint                    height,
+                                      GimpDisplayShellStereo *stereo)
+{
+  gimp_display_update_area (stereo->shell->display, now, x, y, width, height);
+
+  gimp_display_shell_stereo_want_note (stereo);
+}
+
+static void
+gimp_display_shell_stereo_want_note (GimpDisplayShellStereo *stereo)
+{
+  if (! stereo->note_idle_id)
+    stereo->note_idle_id = g_idle_add (gimp_display_shell_stereo_note, stereo);
+}
+
+/*  What the canvas shows otherwise than the image has it is told once,
+ *  in the person's language, and in English in the log.
+ */
+static gboolean
+gimp_display_shell_stereo_note (gpointer data)
+{
+  GimpDisplayShellStereo *stereo = data;
+  const gchar            *note   = NULL;
+  const gchar            *log    = NULL;
+
+  stereo->note_idle_id = 0;
+
+  if (stereo->model.kind == STEREO_PACKED && stereo->model.depth)
+    {
+      note = _("This picture is in a stereo editing mode, which shows its "
+               "two views: its depth layers are shown at the screen.");
+      log  = "a packed picture in an editing mode: its depth layers are shown at the screen";
+    }
+  else if (stereo->model.kind == STEREO_DEPTH_LAYERS && stereo->eyes[0])
+    {
+      note = gimp_eye_projectable_get_problem (stereo->eyes[0]);
+      log  = note;
+    }
+
+  if (! g_strcmp0 (stereo->noted, note))
+    return G_SOURCE_REMOVE;
+
+  g_free (stereo->noted);
+  stereo->noted = g_strdup (note);
+
+  if (note)
+    {
+      g_printerr ("GIMP: depth layers: %s\n", log);
+
+      gimp_message_literal (stereo->shell->display->gimp,
+                            G_OBJECT (stereo->shell), GIMP_MESSAGE_WARNING,
+                            note);
+    }
+
+  return G_SOURCE_REMOVE;
+}
+
