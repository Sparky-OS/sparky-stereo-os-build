+static void
+gimp_layer_tree_view_set_depth_layer (GimpLayerTreeView *view,
+                                      GimpDepthLayer    *layer)
+{
+  if (view->priv->depth_layer != layer)
+    {
+      if (view->priv->depth_layer)
+        {
+          g_signal_handlers_disconnect_by_func (view->priv->depth_layer,
+                                                gimp_layer_tree_view_depth_layer_changed,
+                                                view);
+          g_object_remove_weak_pointer (G_OBJECT (view->priv->depth_layer),
+                                        (gpointer *) &view->priv->depth_layer);
+        }
+
+      view->priv->depth_layer = layer;
+
+      if (layer)
+        {
+          g_object_add_weak_pointer (G_OBJECT (layer),
+                                     (gpointer *) &view->priv->depth_layer);
+          g_signal_connect (layer, "depth-changed",
+                            G_CALLBACK (gimp_layer_tree_view_depth_layer_changed),
+                            view);
+        }
+    }
+
+  if (view->priv->depth_adjustment)
+    gimp_layer_tree_view_depth_layer_changed (layer, view);
+}
+
+static void
+gimp_layer_tree_view_depth_changed (GtkAdjustment     *adjustment,
+                                    GimpLayerTreeView *view)
+{
+  GimpDepthLayer *layer = view->priv->depth_layer;
+
+  if (! layer || ! gimp_item_is_attached (GIMP_ITEM (layer)))
+    return;
+
+  gimp_depth_layer_set_depth (layer, gtk_adjustment_get_value (adjustment),
+                              TRUE);
+  gimp_image_flush (gimp_item_get_image (GIMP_ITEM (layer)));
 }
 
