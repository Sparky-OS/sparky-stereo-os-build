+/*  The eye's float render cache over its picture, premultiplied, in the
+ *  canvas's own values: cairo would clamp a value above 1.0
+ */
+static void
+gimp_display_shell_stereo_composite (GimpDisplayShellStereo      *stereo,
+                                     gint                         e,
+                                     const cairo_rectangle_int_t *r)
+{
+  cairo_surface_t *cache   = stereo->render_cache[e];
+  cairo_surface_t *picture = stereo->picture[e];
+  gint             cstride, pstride;
+  guchar          *cdata, *pdata;
+  gint             x, y;
+
+  if (! cache ||
+      cairo_image_surface_get_format (cache) != CAIRO_FORMAT_RGBA128F ||
+      cairo_image_surface_get_width  (cache) < r->x + r->width ||
+      cairo_image_surface_get_height (cache) < r->y + r->height)
+    return;
+
+  cairo_surface_flush (cache);
+  cstride = cairo_image_surface_get_stride (cache);
+  pstride = cairo_image_surface_get_stride (picture);
+  cdata   = cairo_image_surface_get_data (cache);
+  pdata   = cairo_image_surface_get_data (picture);
+
+  for (y = r->y; y < r->y + r->height; y++)
+    {
+      const gfloat *c = (const gfloat *) (cdata + (gsize) y * cstride) + 4 * r->x;
+      gfloat       *p = (gfloat *) (pdata + (gsize) y * pstride) + 4 * r->x;
+
+      for (x = 0; x < r->width; x++, c += 4, p += 4)
+        {
+          gfloat rest = 1.0f - c[3];
+
+          p[0] = c[0] + rest * p[0];
+          p[1] = c[1] + rest * p[1];
+          p[2] = c[2] + rest * p[2];
+          p[3] = c[3] + rest * p[3];
+        }
+    }
+}
