+
+gboolean     gimp_display_shell_deep_wanted       (GimpDisplayShell           *shell,
+                                                   GimpImage                  *image);
+gboolean     gimp_display_shell_deep_describe     (GimpDisplayShell           *shell,
+                                                   GimpImage                  *image,
+                                                   gboolean                    stereo,
+                                                   gint                        step,
+                                                   GimpDisplayShellDeep       *deep);
+void         gimp_display_shell_deep_clear        (GimpDisplayShellDeep       *deep);
+gboolean     gimp_display_shell_deep_equal        (const GimpDisplayShellDeep *a,
+                                                   const GimpDisplayShellDeep *b);
+gboolean     gimp_display_shell_deep_is_window    (const GimpDisplayShellDeep *deep);
+gboolean     gimp_display_shell_deep_is_linear    (const GimpDisplayShellDeep *deep);
+const Babl * gimp_display_shell_deep_get_format   (const GimpDisplayShellDeep *deep,
+                                                   gboolean                    premultiplied);
+gchar      * gimp_display_shell_deep_get_label    (const GimpDisplayShellDeep *deep);
+
+GimpColorTransform *
+             gimp_display_shell_deep_transform_new (GimpDisplayShell          *shell,
+                                                   const GimpDisplayShellDeep *deep,
+                                                   GimpColorProfile           *src_profile,
+                                                   const Babl                 *src_format);
+
+
+#endif  /*  __GIMP_DISPLAY_SHELL_DEEP_H__  */
