+/*  The canvas's depth and colour state, as the compositor is told them.
+ *
+ *  GTK 3 draws a window in 8 bit sRGB.  An image deeper than 8 bits, or in
+ *  a wide gamut or HDR colour space, reaches the compositor in its own
+ *  depth only through the canvas's GtkGLArea, whose picture goes on a
+ *  surface of its own with its format and colour state described: a
+ *  stereo image's two views, or a 2D image's one picture.
+ *
+ *  The colour state is ITU-T H.273 code points: the ones the image's
+ *  profile carries (its cicp tag, ICC.1:2022 9.2.17), sRGB (1/13) and
+ *  linear sRGB (1/8) for GIMP's own profiles, and otherwise linear
+ *  Rec. 2020 (9/8), to which GIMP's display transform converts the image,
+ *  after soft-proofing and the display filters, instead of to the
+ *  monitor's profile.  The compositor converts it to each screen; GIMP
+ *  never tone-maps for a screen.
+ *
+ *  The depth follows the image's precision: 8 bits, 16 bit integer, half
+ *  float, and float for 32 bit integer, float and double.  Where a depth
+ *  or a description cannot reach the compositor, the canvas takes the next
+ *  step and says so: a float picture in 16 bit integer, then a stereo
+ *  image in 8 bit sRGB, and a 2D image in the canvas's own 8 bit window.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <lcms2.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#include "libgimpcolor/gimpcolor.h"
+#include "libgimpconfig/gimpconfig.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "display-types.h"
+
+#include "config/gimpdisplayconfig.h"
+
+#include "gegl/gimp-babl.h"
+
+#include "core/gimpimage.h"
+
+#include "gimpdisplay.h"
+#include "gimpdisplayshell.h"
+#include "gimpdisplayshell-deep.h"
+#include "gimpdisplayshell-profile.h"
+
+
+/*  ITU-T H.273 code points  */
+#define CP_BT709     1
+#define CP_BT2020    9
+#define TC_LINEAR    8
+#define TC_SRGB     13
+
+
+/*  linear Rec. 2020 (ITU-R BT.2020-2 table 3, white D65): the canvas's
+ *  values for an image whose profile carries no code points
+ */
+static GimpColorProfile *
+gimp_display_shell_deep_rec2020_linear (void)
+{
+  static GimpColorProfile *profile = NULL;
+
+  if (! profile)
+    {
+      cmsCIExyY        white     = { 0.3127, 0.3290, 1.0 };
+      cmsCIExyYTRIPLE  primaries = { { 0.708, 0.292, 1.0 },
+                                     { 0.170, 0.797, 1.0 },
+                                     { 0.131, 0.046, 1.0 } };
+      cmsToneCurve    *linear    = cmsBuildGamma (NULL, 1.0);
+      cmsToneCurve    *curves[3] = { linear, linear, linear };
+      cmsHPROFILE      lcms;
+      cmsMLU          *mlu;
+
+      lcms = cmsCreateRGBProfile (&white, &primaries, curves);
+      cmsFreeToneCurve (linear);
+
+      mlu = cmsMLUalloc (NULL, 1);
+      cmsMLUsetASCII (mlu, "en", "US", "Rec. 2020 linear (the canvas)");
+      cmsWriteTag (lcms, cmsSigProfileDescriptionTag, mlu);
+      cmsMLUfree (mlu);
+
+      profile = gimp_color_profile_new_from_lcms_profile (lcms, NULL);
+      cmsCloseProfile (lcms);
+    }
+
+  return profile;
+}
+
+/*  whether @profile is GIMP's own profile of that transfer, or one babl
+ *  takes for the same space
+ */
+static gboolean
+gimp_display_shell_deep_is_builtin (GimpColorProfile *profile,
+                                    GimpTRCType       trc)
+{
+  GimpColorProfile *builtin;
+  const Babl       *space;
+
+  builtin = gimp_babl_get_builtin_color_profile (gimp_color_profile_is_gray (profile) ?
+                                                 GIMP_GRAY : GIMP_RGB, trc);
+
+  if (gimp_color_profile_is_equal (profile, builtin))
+    return TRUE;
+
+  space = gimp_color_profile_get_space (profile,
+                                        GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC,
+                                        NULL);
+
+  return space && space == gimp_color_profile_get_space (builtin,
+                                                         GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC,
+                                                         NULL);
+}
+
+/*  the code points of an ICC cicp tag (ICC.1:2022 9.2.17) of RGB values in
+ *  the full range, the only ones a canvas can be described with
+ */
+static gboolean
+gimp_display_shell_deep_get_cicp (GimpColorProfile *profile,
+                                  guint            *primaries,
+                                  guint            *transfer)
+{
+  cmsVideoSignalType *cicp;
+
+  cicp = cmsReadTag (gimp_color_profile_get_lcms_profile (profile), cmsSigcicpTag);
+
+  if (cicp && cicp->MatrixCoefficients == 0 && cicp->VideoFullRangeFlag == 1)
+    {
+      *primaries = cicp->ColourPrimaries;
+      *transfer  = cicp->TransferCharacteristics;
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+/*  whether @profile's gamut reaches outside sRGB's: its primaries in
+ *  linear sRGB (lcms's floating point transforms of matrix-shaper profiles
+ *  are unbounded)
+ */
+static gboolean
+gimp_display_shell_deep_is_wide (GimpColorProfile *profile)
+{
+  static GimpColorProfile *last    = NULL;
+  static gboolean          last_wide;
+  GimpColorProfile        *srgb_linear;
+  cmsHTRANSFORM            transform;
+  gfloat                   in[9] = { 1, 0, 0,  0, 1, 0,  0, 0, 1 };
+  gfloat                   out[9];
+  gboolean                 wide = FALSE;
+  gint                     i;
+
+  if (! gimp_color_profile_is_rgb (profile))
+    return FALSE;
+
+  if (last && gimp_color_profile_is_equal (profile, last))
+    return last_wide;
+
+  srgb_linear = gimp_babl_get_builtin_color_profile (GIMP_RGB, GIMP_TRC_LINEAR);
+
+  transform = cmsCreateTransform (gimp_color_profile_get_lcms_profile (profile), TYPE_RGB_FLT,
+                                  gimp_color_profile_get_lcms_profile (srgb_linear), TYPE_RGB_FLT,
+                                  INTENT_RELATIVE_COLORIMETRIC,
+                                  cmsFLAGS_NOOPTIMIZE | cmsFLAGS_NOCACHE);
+  if (transform)
+    {
+      cmsDoTransform (transform, in, out, 3);
+      cmsDeleteTransform (transform);
+
+      for (i = 0; i < 9; i++)
+        if (out[i] < -0.002 || out[i] > 1.002)
+          wide = TRUE;
+    }
+
+  g_set_object (&last, profile);
+  last_wide = wide;
+
+  return wide;
+}
+
+static GimpColorProfile *
+gimp_display_shell_deep_get_profile (GimpDisplayShell *shell)
+{
+  GimpColorConfig *config = gimp_display_shell_get_color_config (shell);
+
+  /*  with colour management off the canvas shows values converted to sRGB
+   *  as the 2D canvas does
+   */
+  if (gimp_color_config_get_mode (config) == GIMP_COLOR_MANAGEMENT_OFF)
+    return NULL;
+
+  return gimp_color_managed_get_color_profile (GIMP_COLOR_MANAGED (shell));
+}
+
+/*  Whether a 2D image's canvas goes through the area in a depth or colour
+ *  state of its own: an image deeper than 8 bits, or one whose profile
+ *  carries code points (HDR) or reaches outside sRGB's gamut
+ */
+gboolean
+gimp_display_shell_deep_wanted (GimpDisplayShell *shell,
+                                GimpImage        *image)
+{
+  GimpColorProfile *profile;
+  guint             primaries, transfer;
+
+  /*  Preferences: "Show deep images in their own depth and colors" off:
+   *  GIMP's own 8 bit canvas, converted to the monitor profile
+   */
+  if (! shell->display->config->deep_canvas)
+    return FALSE;
+
+  if (gimp_image_get_component_type (image) != GIMP_COMPONENT_TYPE_U8)
+    return TRUE;
+
+  profile = gimp_display_shell_deep_get_profile (shell);
+
+  if (! profile)
+    return FALSE;
+
+  if (gimp_display_shell_deep_get_cicp (profile, &primaries, &transfer))
+    return TRUE;
+
+  return (! gimp_display_shell_deep_is_builtin (profile, GIMP_TRC_NON_LINEAR) &&
+          ! gimp_display_shell_deep_is_builtin (profile, GIMP_TRC_LINEAR) &&
+          gimp_display_shell_deep_is_wide (profile));
+}
+
+/*  The canvas's depth and colour state at @step: 0 is the image's own, each
+ *  later step the next one down (a float picture in 16 bit integer, then a
+ *  stereo image's 8 bit sRGB).  FALSE past the last step: a 2D image is then
+ *  drawn into the window by the canvas itself.
+ */
+gboolean
+gimp_display_shell_deep_describe (GimpDisplayShell     *shell,
+                                  GimpImage            *image,
+                                  gboolean              stereo,
+                                  gint                  step,
+                                  GimpDisplayShellDeep *deep)
+{
+  GimpDisplayShellDeep  steps[3];
+  GimpColorProfile     *profile;
+  guint                 primaries = CP_BT709;
+  guint                 transfer  = TC_SRGB;
+  GimpColorProfile     *state;
+  gboolean              converted = FALSE;
+  gboolean              linear;
+  GimpDisplayShellDeepFormat format;
+  gboolean              own;
+  gint                  n = 0;
+
+  memset (deep, 0, sizeof (GimpDisplayShellDeep));
+
+  profile = gimp_display_shell_deep_get_profile (shell);
+
+  if (! profile)
+    {
+      state = gimp_babl_get_builtin_color_profile (GIMP_RGB, GIMP_TRC_NON_LINEAR);
+    }
+  else if (gimp_display_shell_deep_get_cicp (profile, &primaries, &transfer))
+    {
+      state = profile;
+    }
+  else if (gimp_display_shell_deep_is_builtin (profile, GIMP_TRC_NON_LINEAR))
+    {
+      state = gimp_babl_get_builtin_color_profile (GIMP_RGB, GIMP_TRC_NON_LINEAR);
+    }
+  else if (gimp_display_shell_deep_is_builtin (profile, GIMP_TRC_LINEAR))
+    {
+      transfer = TC_LINEAR;
+      state    = gimp_babl_get_builtin_color_profile (GIMP_RGB, GIMP_TRC_LINEAR);
+    }
+  else
+    {
+      primaries = CP_BT2020;
+      transfer  = TC_LINEAR;
+      state     = gimp_display_shell_deep_rec2020_linear ();
+      converted = TRUE;
+    }
+
+  linear = (transfer == TC_LINEAR);
+
+  switch (gimp_image_get_component_type (image))
+    {
+    case GIMP_COMPONENT_TYPE_U8:
+      /*  8 bits in a linear state would band in the shadows  */
+      format = linear ? GIMP_DISPLAY_SHELL_DEEP_HALF : GIMP_DISPLAY_SHELL_DEEP_U8;
+      break;
+    case GIMP_COMPONENT_TYPE_U16:
+      format = GIMP_DISPLAY_SHELL_DEEP_U16;
+      break;
+    case GIMP_COMPONENT_TYPE_HALF:
+      format = GIMP_DISPLAY_SHELL_DEEP_HALF;
+      break;
+    default:
+      format = GIMP_DISPLAY_SHELL_DEEP_FLOAT;
+      break;
+    }
+
+  /*  Preferences: "Show deep images in their own depth and colors" off:
+   *  only a stereo image's 8 bit sRGB step, milestone 1's canvas
+   */
+  own = shell->display->config->deep_canvas;
+
+  if (own)
+    {
+      steps[n].format    = format;
+      steps[n].primaries = primaries;
+      steps[n].transfer  = transfer;
+      steps[n].profile   = state;
+      steps[n].converted = converted;
+      n++;
+
+      if (format == GIMP_DISPLAY_SHELL_DEEP_HALF ||
+          format == GIMP_DISPLAY_SHELL_DEEP_FLOAT)
+        {
+          steps[n]        = steps[0];
+          steps[n].format = GIMP_DISPLAY_SHELL_DEEP_U16;
+          n++;
+        }
+    }
+
+  if (stereo &&
+      (! own ||
+       ! (format == GIMP_DISPLAY_SHELL_DEEP_U8 &&
+          primaries == CP_BT709 && transfer == TC_SRGB)))
+    {
+      steps[n].format    = GIMP_DISPLAY_SHELL_DEEP_U8;
+      steps[n].primaries = CP_BT709;
+      steps[n].transfer  = TC_SRGB;
+      steps[n].profile   = gimp_babl_get_builtin_color_profile (GIMP_RGB, GIMP_TRC_NON_LINEAR);
+      steps[n].converted = (profile != NULL &&
+                            ! gimp_display_shell_deep_is_builtin (profile, GIMP_TRC_NON_LINEAR));
+      n++;
+    }
+
+  if (step < 0 || step >= n)
+    return FALSE;
+
+  *deep = steps[step];
+  g_object_ref (deep->profile);
+
+  return TRUE;
+}
+
+void
+gimp_display_shell_deep_clear (GimpDisplayShellDeep *deep)
+{
+  g_clear_object (&deep->profile);
+  memset (deep, 0, sizeof (GimpDisplayShellDeep));
+}
+
+gboolean
+gimp_display_shell_deep_equal (const GimpDisplayShellDeep *a,
+                               const GimpDisplayShellDeep *b)
+{
+  if (! a->profile || ! b->profile)
+    return a->profile == b->profile;
+
+  return (a->format    == b->format    &&
+          a->primaries == b->primaries &&
+          a->transfer  == b->transfer  &&
+          a->converted == b->converted &&
+          gimp_color_profile_is_equal (a->profile, b->profile));
+}
+
+/*  whether the canvas in this state is the 8 bit sRGB picture of the
+ *  canvas's own window
+ */
+gboolean
+gimp_display_shell_deep_is_window (const GimpDisplayShellDeep *deep)
+{
+  return (deep->format    == GIMP_DISPLAY_SHELL_DEEP_U8 &&
+          deep->primaries == CP_BT709 &&
+          deep->transfer  == TC_SRGB);
+}
+
+gboolean
+gimp_display_shell_deep_is_linear (const GimpDisplayShellDeep *deep)
+{
+  return deep->transfer == TC_LINEAR;
+}
+
+/*  the float format of the canvas's values: the state's own encoding; the
+ *  profile gives its colour space (gimp_color_transform_process_buffer())
+ */
+const Babl *
+gimp_display_shell_deep_get_format (const GimpDisplayShellDeep *deep,
+                                    gboolean                    premultiplied)
+{
+  if (gimp_display_shell_deep_is_linear (deep))
+    return babl_format (premultiplied ? "RaGaBaA float" : "RGBA float");
+
+  return babl_format (premultiplied ? "R'aG'aB'aA float" : "R'G'B'A float");
+}
+
+gchar *
+gimp_display_shell_deep_get_label (const GimpDisplayShellDeep *deep)
+{
+  static const gchar *formats[] = { "8 bit", "16 bit integer", "half float", "float" };
+
+  return g_strdup_printf ("%s, ITU-T H.273 colour primaries %u and transfer "
+                          "characteristics %u%s",
+                          formats[deep->format], deep->primaries, deep->transfer,
+                          deep->converted ? ", converted by GIMP" : "");
+}
+
+/*  The display transform to the canvas's state, as
+ *  gimp_widget_get_color_transform() makes the one to the monitor's
+ *  profile: the display's rendering intent and black point compensation,
+ *  or soft-proofing with the simulation profile; NULL with colour
+ *  management off.
+ */
+GimpColorTransform *
+gimp_display_shell_deep_transform_new (GimpDisplayShell           *shell,
+                                       const GimpDisplayShellDeep *deep,
+                                       GimpColorProfile           *src_profile,
+                                       const Babl                 *src_format)
+{
+  GimpColorConfig         *config = gimp_display_shell_get_color_config (shell);
+  GimpImage               *image  = gimp_display_get_image (shell->display);
+  const Babl              *dest_format;
+  GimpColorProfile        *proof_profile = NULL;
+  GimpColorTransformFlags  flags = 0;
+  GimpColorTransform      *transform;
+
+  g_return_val_if_fail (deep->profile != NULL, NULL);
+
+  dest_format = gimp_display_shell_deep_get_format (deep, FALSE);
+
+  switch (gimp_color_config_get_mode (config))
+    {
+    case GIMP_COLOR_MANAGEMENT_OFF:
+      return NULL;
+
+    case GIMP_COLOR_MANAGEMENT_SOFTPROOF:
+      if (image)
+        proof_profile = gimp_color_managed_get_simulation_profile (GIMP_COLOR_MANAGED (image));
+      if (proof_profile)
+        g_object_ref (proof_profile);
+      else
+        proof_profile = gimp_color_config_get_simulation_color_profile (config, NULL);
+      break;
+
+    case GIMP_COLOR_MANAGEMENT_DISPLAY:
+      break;
+    }
+
+  if (proof_profile)
+    {
+      if (image && gimp_color_managed_get_simulation_bpc (GIMP_COLOR_MANAGED (image)))
+        flags |= GIMP_COLOR_TRANSFORM_FLAGS_BLACK_POINT_COMPENSATION;
+      if (! gimp_color_config_get_simulation_optimize (config))
+        flags |= GIMP_COLOR_TRANSFORM_FLAGS_NOOPTIMIZE;
+
+      if (gimp_color_config_get_simulation_gamut_check (config))
+        {
+          GeglColor       *color;
+          cmsUInt16Number  alarm[cmsMAXCHANNELS] = { 0, };
+
+          flags |= GIMP_COLOR_TRANSFORM_FLAGS_GAMUT_CHECK;
+
+          /*  as for the monitor: Little-CMS takes the alarm colour in the
+           *  output's encoding, given here as sRGB
+           */
+          color = gimp_color_config_get_out_of_gamut_color (config);
+          gegl_color_get_pixel (color, babl_format ("R'G'B' u16"), alarm);
+          cmsSetAlarmCodes (alarm);
+          g_object_unref (color);
+        }
+
+      transform = gimp_color_transform_new_proofing (src_profile, src_format,
+                                                     deep->profile, dest_format,
+                                                     proof_profile,
+                                                     image ? gimp_color_managed_get_simulation_intent (GIMP_COLOR_MANAGED (image)) :
+                                                             GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC,
+                                                     gimp_color_config_get_display_intent (config),
+                                                     flags);
+      g_object_unref (proof_profile);
+    }
+  else
+    {
+      if (gimp_color_config_get_display_bpc (config))
+        flags |= GIMP_COLOR_TRANSFORM_FLAGS_BLACK_POINT_COMPENSATION;
+      if (! gimp_color_config_get_display_optimize (config))
+        flags |= GIMP_COLOR_TRANSFORM_FLAGS_NOOPTIMIZE;
+
+      transform = gimp_color_transform_new (src_profile, src_format,
+                                            deep->profile, dest_format,
+                                            gimp_color_config_get_display_intent (config),
+                                            flags);
+    }
+
+  return transform;
+}
