+      if (stereo->chrome_transform)
+        gimp_color_transform_process_buffer (stereo->chrome_transform,
+                                             mid, NULL, dest, NULL);
+      else
+        gegl_buffer_copy (mid, NULL, GEGL_ABYSS_NONE, dest, NULL);
+    }
+
+  gegl_buffer_get (dest, GEGL_RECTANGLE (0, 0, r->width, r->height), 1.0,
+                   gimp_display_shell_deep_get_format (&stereo->deep, TRUE),
+                   cairo_image_surface_get_data (picture) +
+                   (gsize) r->y * pstride + (gsize) r->x * 16,
+                   pstride, GEGL_ABYSS_NONE);
+
+  g_object_unref (dest);
+  g_object_unref (mid);
+  g_object_unref (src);
+}
