+    {
+    case GIMP_DISPLAY_SHELL_DEEP_U16:   return GDK_MEMORY_R16G16B16A16_PREMULTIPLIED;
+    case GIMP_DISPLAY_SHELL_DEEP_HALF:  return GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED;
+    case GIMP_DISPLAY_SHELL_DEEP_FLOAT: return GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED;
+    default:                            return GDK_MEMORY_R8G8B8A8_PREMULTIPLIED;
+    }
