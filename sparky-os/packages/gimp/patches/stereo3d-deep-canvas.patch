+/*  What lies around the image, drawn in 8 bit sRGB, into one eye's float
+ *  picture in the canvas's state: through the display transform from sRGB
+ *  (relative colorimetric), and for a PQ canvas with its white at the
+ *  reference white of 203 cd/m2 (Report ITU-R BT.2408-8, 2.1), as the
+ *  compositor shows sRGB content beside PQ content
+ */
+static void
+gimp_display_shell_stereo_convert_chrome (GimpDisplayShellStereo      *stereo,
+                                          gint                         e,
+                                          const cairo_rectangle_int_t *r)
+{
+  cairo_surface_t *chrome  = stereo->chrome[e];
+  cairo_surface_t *picture = stereo->picture[e];
+  gint             cstride = cairo_image_surface_get_stride (chrome);
+  gint             pstride = cairo_image_surface_get_stride (picture);
