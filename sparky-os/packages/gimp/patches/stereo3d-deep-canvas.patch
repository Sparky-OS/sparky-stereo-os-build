+static GdkColorState *
+gimp_display_shell_stereo_color_state (const GimpDisplayShellDeep *deep,
+                                       GError                    **error)
+{
+  GdkCicpParams *cicp;
+  GdkColorState *state;
+
+  if (deep->primaries == 1 && deep->transfer == 13)
+    return gdk_color_state_ref (gdk_color_state_get_srgb ());
+  if (deep->primaries == 1 && deep->transfer == 8)
+    return gdk_color_state_ref (gdk_color_state_get_srgb_linear ());
+  if (deep->primaries == 9 && deep->transfer == 16)
+    return gdk_color_state_ref (gdk_color_state_get_rec2100_pq ());
+  if (deep->primaries == 9 && deep->transfer == 8)
+    return gdk_color_state_ref (gdk_color_state_get_rec2100_linear ());
+
+  /*  any other code points of the image's cicp tag: RGB, full range  */
+  cicp = gdk_cicp_params_new ();
+  gdk_cicp_params_set_color_primaries (cicp, deep->primaries);
+  gdk_cicp_params_set_transfer_function (cicp, deep->transfer);
+  gdk_cicp_params_set_matrix_coefficients (cicp, 0);
+  gdk_cicp_params_set_range (cicp, GDK_CICP_RANGE_FULL);
+  state = gdk_cicp_params_build_color_state (cicp, error);
+  g_object_unref (cicp);
+
+  return state;
+}
