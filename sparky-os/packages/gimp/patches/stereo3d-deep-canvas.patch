+/*  One eye's float picture of the canvas: what lies around the image drawn
+ *  in 8 bit sRGB and converted, the image's chunks rendered into the eye's
+ *  float cache and composited over it
+ */
+static void
+gimp_display_shell_stereo_paint_deep (GimpDisplayShellStereo *stereo,
+                                      gint                    e)
+{
+  GimpDisplayShell     *shell  = stereo->shell;
+  gint                  scale  = shell->render_scale;
+  gint                  width  = shell->disp_width  * scale;
+  gint                  height = shell->disp_height * scale;
+  cairo_rectangle_int_t whole  = { 0, 0, width, height };
+  GimpDisplayShellEye   eye    = e ? GIMP_DISPLAY_SHELL_EYE_RIGHT :
+                                     GIMP_DISPLAY_SHELL_EYE_LEFT;
+  cairo_t              *cr;
+  gint                  n, i;
+
+  if (! stereo->chrome[e] ||
+      cairo_image_surface_get_width  (stereo->chrome[e]) != width ||
+      cairo_image_surface_get_height (stereo->chrome[e]) != height)
+    {
+      g_clear_pointer (&stereo->chrome[e], cairo_surface_destroy);
+      stereo->chrome[e] = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                                      width, height);
+    }
+
+  n = cairo_region_num_rectangles (stereo->dirty[e]);
+
+  /*  around the image, as the 2D canvas draws it  */
+  cr = cairo_create (stereo->chrome[e]);
