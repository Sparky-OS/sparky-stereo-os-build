+/*  GdkMemoryFormat and GdkColorState of GTK 3 +stereo3d1 (GTK 4's names)  */
+static GdkMemoryFormat
+gimp_display_shell_stereo_memory_format (const GimpDisplayShellDeep *deep)
+{
