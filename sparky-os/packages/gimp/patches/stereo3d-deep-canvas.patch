+/*  Rec. ITU-R BT.2100-3 table 4: the PQ inverse EOTF of a luminance  */
+static gfloat
+gimp_display_shell_stereo_pq (gdouble nits)
+{
+  const gdouble m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128;
+  const gdouble c1 = 3424.0 / 4096, c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
+  gdouble       y  = MAX (nits, 0.0) / 10000.0;
+  gdouble       p  = pow (y, m1);
+
+  return pow ((c1 + c2 * p) / (1 + c3 * p), m2);
+}
