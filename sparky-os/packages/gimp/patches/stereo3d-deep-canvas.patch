+  GeglBuffer      *mid;
+  GeglBuffer      *dest;
+  gdouble          m[3][3];
+
+  src = gegl_buffer_linear_new_from_data (cairo_image_surface_get_data (chrome) +
+                                          (gsize) r->y * cstride + (gsize) r->x * 4,
+                                          babl_format ("cairo-ARGB32"),
+                                          GEGL_RECTANGLE (0, 0, r->width, r->height),
+                                          cstride, NULL, NULL);
+  dest = gegl_buffer_linear_new (GEGL_RECTANGLE (0, 0, r->width, r->height),
+                                 gimp_display_shell_deep_get_format (&stereo->deep, FALSE));
+
+  if (stereo->deep.transfer == 16 &&
+      gimp_display_shell_stereo_primaries_matrix (stereo->deep.primaries, m))
+    {
+      GeglBufferIterator *iter;
+
+      mid = gegl_buffer_linear_new (GEGL_RECTANGLE (0, 0, r->width, r->height),
+                                    babl_format ("RGBA float"));
+      gegl_buffer_copy (src, NULL, GEGL_ABYSS_NONE, mid, NULL);
+
+      iter = gegl_buffer_iterator_new (mid, NULL, 0, babl_format ("RGBA float"),
+                                       GEGL_ACCESS_READ, GEGL_ABYSS_NONE, 2);
+      gegl_buffer_iterator_add (iter, dest, NULL, 0, babl_format ("R'G'B'A float"),
+                                GEGL_ACCESS_WRITE, GEGL_ABYSS_NONE);
+
+      while (gegl_buffer_iterator_next (iter))
+        {
+          const gfloat *in  = iter->items[0].data;
+          gfloat       *out = iter->items[1].data;
+          gint          i, j;
+
+          for (i = 0; i < iter->length; i++, in += 4, out += 4)
+            {
+              for (j = 0; j < 3; j++)
+                out[j] = gimp_display_shell_stereo_pq (203.0 * (m[j][0] * in[0] +
+                                                               m[j][1] * in[1] +
+                                                               m[j][2] * in[2]));
+              out[3] = in[3];
+            }
+        }
+    }
+  else
+    {
+      if (! stereo->chrome_transform_known)
+        {
+          GimpColorProfile *srgb;
+
+          srgb = gimp_babl_get_builtin_color_profile (GIMP_RGB, GIMP_TRC_NON_LINEAR);
+
+          if (! gimp_color_profile_is_equal (srgb, stereo->deep.profile))
+            stereo->chrome_transform =
+              gimp_color_transform_new (srgb, babl_format ("R'G'B'A float"),
+                                        stereo->deep.profile,
+                                        gimp_display_shell_deep_get_format (&stereo->deep, FALSE),
+                                        GIMP_COLOR_RENDERING_INTENT_RELATIVE_COLORIMETRIC, 0);
+          stereo->chrome_transform_known = TRUE;
+        }
+
+      mid = gegl_buffer_linear_new (GEGL_RECTANGLE (0, 0, r->width, r->height),
+                                    babl_format ("R'G'B'A float"));
+      gegl_buffer_copy (src, NULL, GEGL_ABYSS_NONE, mid, NULL);
