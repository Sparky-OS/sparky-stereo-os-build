 }
+
+/*  The deep render path: as the 2D one, with the display filters, but the
+ *  display transform goes to the canvas's colour state instead of the
+ *  monitor's profile, in floats, and the result is premultiplied into a
+ *  float chunk and copied into the eye's float cache.  Cairo clamps floats
+ *  above 1.0, which an HDR value in a linear state is, so the chunk is
+ *  copied sample by sample wherever it lands on whole pixels unrotated; a
+ *  rotated or unevenly scaled view goes through cairo and is clipped at
+ *  1.0 (said once in the debug log).
+ */
+static void
+gimp_display_shell_render_deep (GimpDisplayShell                *shell,
+                                cairo_surface_t                **cache,
+                                const GimpDisplayShellEyeSource *source,
+                                gint                             x,
+                                gint                             y,
+                                gint                             width,
+                                gint                             height,
+                                gint                             tx,
+                                gint                             ty,
+                                gint                             twidth,
+                                gint                             theight,
+                                gdouble                          scale,
+                                gint                             flags)
+{
+  const GimpDisplayShellDeep *deep  = gimp_display_shell_stereo_get_deep (shell);
+  GimpImage                  *image = gimp_display_get_image (shell->display);
+  GeglBuffer                 *picture;
+  GeglBuffer                 *dest;
+  GimpColorTransform         *transform;
+  cairo_surface_t            *chunk;
+  gint                        rs = shell->render_scale;
+  gint                        dx, dy;
+  gboolean                    copied = FALSE;
+
+  dest = gimp_display_shell_stereo_get_deep_dest (shell);
+
+  if (gimp_display_shell_has_filter (shell))
+    {
+      /*  as the 2D path: the projection in the display filters' format,
+       *  through the filter transform where there is one, then the filters
+       */
+      if (! shell->filter_buffer)
+        {
+          gint fw = shell->render_buf_width;
+          gint fh = shell->render_buf_height;
+
+          shell->filter_data =
+            gegl_malloc (fw * fh *
+                         babl_format_get_bytes_per_pixel (shell->filter_format));
+
+          shell->filter_stride =
+            fw * babl_format_get_bytes_per_pixel (shell->filter_format);
+
+          shell->filter_buffer =
+            gegl_buffer_linear_new_from_data (shell->filter_data,
+                                              shell->filter_format,
+                                              GEGL_RECTANGLE (0, 0, fw, fh),
+                                              GEGL_AUTO_ROWSTRIDE,
+                                              (GDestroyNotify) gegl_free,
+                                              shell->filter_data);
+        }
+
+      if (shell->filter_transform && shell->profile_buffer)
+        {
+          gegl_buffer_get (source->buffer,
+                           GEGL_RECTANGLE (x, y, width, height), scale,
+                           gimp_projectable_get_format (GIMP_PROJECTABLE (image)),
+                           shell->profile_data, shell->profile_stride,
+                           flags);
+
+          gimp_color_transform_process_buffer (shell->filter_transform,
+                                               shell->profile_buffer,
+                                               GEGL_RECTANGLE (0, 0, width, height),
+                                               shell->filter_buffer,
+                                               GEGL_RECTANGLE (0, 0, width, height));
+        }
+      else
+        {
+          gegl_buffer_get (source->buffer,
+                           GEGL_RECTANGLE (x, y, width, height), scale,
+                           shell->filter_format,
+                           shell->filter_data, shell->filter_stride,
+                           flags);
+        }
+
+      {
+        GeglBuffer *shifted = g_object_new (GEGL_TYPE_BUFFER,
+                                            "source",  shell->filter_buffer,
+                                            "shift-x", -x,
+                                            "shift-y", -y,
+                                            NULL);
+
+        gimp_color_display_stack_convert_buffer (shell->filter_stack, shifted,
+                                                 GEGL_RECTANGLE (x, y, width, height));
+        g_object_unref (shifted);
+      }
+
+      picture   = shell->filter_buffer;
+      transform = gimp_display_shell_stereo_get_deep_transform (shell,
+                                                                shell->filter_profile,
+                                                                shell->filter_format);
+    }
+  else
+    {
+      const Babl *format = gimp_projectable_get_format (GIMP_PROJECTABLE (image));
+      gint        rowstride;
+      gpointer    data;
+
+      picture = gimp_display_shell_stereo_get_deep_source (shell, format);
+
+      /*  the scratch is the render buffer's size, the chunk is smaller: its
+       *  rows go at the scratch's own stride
+       */
+      data = gegl_buffer_linear_open (picture, NULL, &rowstride, format);
+      gegl_buffer_get (source->buffer,
+                       GEGL_RECTANGLE (x, y, width, height), scale,
+                       format, data, rowstride, flags);
+      gegl_buffer_linear_close (picture, data);
+
+      transform = gimp_display_shell_stereo_get_deep_transform (shell,
+                                                                gimp_color_managed_get_color_profile (GIMP_COLOR_MANAGED (shell)),
+                                                                format);
+    }
+
+  /*  the canvas's values: through the display transform, or (colour
+   *  management off) babl's own conversion to the state's format, sRGB as
+   *  the 2D canvas's
+   */
+  if (transform)
+    gimp_color_transform_process_buffer (transform,
+                                         picture, GEGL_RECTANGLE (0, 0, width, height),
+                                         dest, GEGL_RECTANGLE (0, 0, width, height));
+  else
+    gegl_buffer_copy (picture, GEGL_RECTANGLE (0, 0, width, height), GEGL_ABYSS_NONE,
+                      dest, GEGL_RECTANGLE (0, 0, width, height));
+
+  chunk = gimp_display_shell_stereo_get_deep_surface (shell);
+  cairo_surface_flush (chunk);
+  gegl_buffer_get (dest, GEGL_RECTANGLE (0, 0, width, height), 1.0,
+                   gimp_display_shell_deep_get_format (deep, TRUE),
+                   cairo_image_surface_get_data (chunk),
+                   cairo_image_surface_get_stride (chunk),
+                   GEGL_ABYSS_NONE);
+  cairo_surface_mark_dirty (chunk);
+
+  if (! *cache)
+    *cache = cairo_image_surface_create (CAIRO_FORMAT_RGBA128F,
+                                         shell->disp_width  * rs,
+                                         shell->disp_height * rs);
+
+  /*  unrotated with square pixels, the chunk's sample (u, v) lands on the
+   *  device pixel (x + u - offset_x * render_scale, y + v - ...): the scale
+   *  the chunk was rendered at is the render scale times the view's
+   */
+  dx = x - shell->offset_x * rs;
+  dy = y - shell->offset_y * rs;
+
+  if (! shell->rotate_transform && shell->scale_x == shell->scale_y)
+    {
+      cairo_rectangle_int_t area  = { dx, dy, width, height };
+      cairo_rectangle_int_t chunkr = { tx, ty, twidth, theight };
+      cairo_rectangle_int_t whole = { 0, 0,
+                                      cairo_image_surface_get_width  (*cache),
+                                      cairo_image_surface_get_height (*cache) };
+      gboolean              whole_clip = TRUE;
+
+      if (source->clipped)
+        {
+          gdouble cx0 = source->clip.x * scale - shell->offset_x * rs;
+          gdouble cy0 = source->clip.y * scale - shell->offset_y * rs;
+          gdouble cx1 = (source->clip.x + source->clip.width)  * scale - shell->offset_x * rs;
+          gdouble cy1 = (source->clip.y + source->clip.height) * scale - shell->offset_y * rs;
+
+          if (cx0 == floor (cx0) && cy0 == floor (cy0) &&
+              cx1 == floor (cx1) && cy1 == floor (cy1))
+            {
+              cairo_rectangle_int_t clip = { cx0, cy0, cx1 - cx0, cy1 - cy0 };
+
+              gdk_rectangle_intersect (&area, &clip, &area);
+            }
+          else
+            {
+              whole_clip = FALSE;
+            }
+        }
+
+      if (whole_clip &&
+          gdk_rectangle_intersect (&area, &chunkr, &area) &&
+          gdk_rectangle_intersect (&area, &whole, &area))
+        {
+          gint    cstride = cairo_image_surface_get_stride (*cache);
+          gint    sstride = cairo_image_surface_get_stride (chunk);
+          guchar *cdata;
+          guchar *sdata   = cairo_image_surface_get_data (chunk);
+          gint    row;
+
+          cairo_surface_flush (*cache);
+          cdata = cairo_image_surface_get_data (*cache);
+
+          for (row = area.y; row < area.y + area.height; row++)
+            memcpy (cdata + (gsize) row * cstride + (gsize) area.x * 16,
+                    sdata + (gsize) (row - dy) * sstride + (gsize) (area.x - dx) * 16,
+                    (gsize) area.width * 16);
+
+          cairo_surface_mark_dirty (*cache);
+        }
+
+      copied = whole_clip;
+    }
+
+  if (! copied)
+    {
+      static gboolean told = FALSE;
+      cairo_t        *my_cr = cairo_create (*cache);
+
+      if (! told)
+        {
+          g_debug ("gimp_display_shell_render_deep: a rotated or unevenly "
+                   "scaled view of a deep canvas goes through cairo, which "
+                   "clips the values above 1.0");
+          told = TRUE;
+        }
+
+      cairo_rectangle (my_cr, tx, ty, twidth, theight);
+      cairo_clip (my_cr);
+      cairo_scale (my_cr, rs, rs);
+      if (shell->rotate_transform)
+        cairo_transform (my_cr, shell->rotate_transform);
+      cairo_translate (my_cr, -shell->offset_x, -shell->offset_y);
+      cairo_scale (my_cr, shell->scale_x / scale, shell->scale_y / scale);
+
+      if (source->clipped)
+        {
+          cairo_rectangle (my_cr,
+                           source->clip.x * scale,     source->clip.y * scale,
+                           source->clip.width * scale, source->clip.height * scale);
+          cairo_clip (my_cr);
+        }
+
+      cairo_set_operator (my_cr, CAIRO_OPERATOR_SOURCE);
+      cairo_set_source_surface (my_cr, chunk, x, y);
+      cairo_paint (my_cr);
+      cairo_destroy (my_cr);
+    }
+
+  /*  the mask's tint, in the canvas's state: an overlay of the view, drawn
+   *  by cairo
+   */
+  if (shell->mask)
+    {
+      cairo_t         *my_cr;
+      cairo_surface_t *mask;
+      gint             stride;
+      guchar          *data;
+      gdouble          rgba[4];
+      const Babl      *space;
+
+      mask   = cairo_image_surface_create (CAIRO_FORMAT_A8, width, height);
