+/*  H.273 colour primaries (ITU-T H.273 table 2) the surroundings of a PQ
+ *  canvas are drawn in: BT.709, BT.2020 and SMPTE EG 432-1, white D65
+ */
+static gboolean
+gimp_display_shell_stereo_primaries_matrix (guint    primaries,
+                                            gdouble  m[3][3])
+{
+  static const gdouble xy[][6] = {
+    [1]  = { 0.640, 0.330, 0.300, 0.600, 0.150, 0.060 },
+    [9]  = { 0.708, 0.292, 0.170, 0.797, 0.131, 0.046 },
+    [12] = { 0.680, 0.320, 0.265, 0.690, 0.150, 0.060 },
+  };
+  const gdouble  wx = 0.3127, wy = 0.3290;
+  gdouble        to_xyz[2][3][3];
+  gint           k;
+
+  if (primaries != 1 && primaries != 9 && primaries != 12)
+    return FALSE;
+
+  /*  each set's RGB to XYZ (SMPTE RP 177): the primaries' XYZ scaled so
+   *  that RGB (1, 1, 1) is the white
+   */
+  for (k = 0; k < 2; k++)
+    {
+      const gdouble *c = xy[k == 0 ? 1 : primaries];
+      gdouble        p[3][3], inv[3][3], w[3], sc[3], det;
+      gint           i, j;
+
+      for (i = 0; i < 3; i++)
+        {
+          p[0][i] = c[2 * i] / c[2 * i + 1];
+          p[1][i] = 1.0;
+          p[2][i] = (1.0 - c[2 * i] - c[2 * i + 1]) / c[2 * i + 1];
+        }
+
+      w[0] = wx / wy; w[1] = 1.0; w[2] = (1.0 - wx - wy) / wy;
+
+      det = p[0][0] * (p[1][1] * p[2][2] - p[1][2] * p[2][1]) -
+            p[0][1] * (p[1][0] * p[2][2] - p[1][2] * p[2][0]) +
+            p[0][2] * (p[1][0] * p[2][1] - p[1][1] * p[2][0]);
+
+      inv[0][0] =  (p[1][1] * p[2][2] - p[1][2] * p[2][1]) / det;
+      inv[0][1] = -(p[0][1] * p[2][2] - p[0][2] * p[2][1]) / det;
+      inv[0][2] =  (p[0][1] * p[1][2] - p[0][2] * p[1][1]) / det;
+      inv[1][0] = -(p[1][0] * p[2][2] - p[1][2] * p[2][0]) / det;
+      inv[1][1] =  (p[0][0] * p[2][2] - p[0][2] * p[2][0]) / det;
+      inv[1][2] = -(p[0][0] * p[1][2] - p[0][2] * p[1][0]) / det;
+      inv[2][0] =  (p[1][0] * p[2][1] - p[1][1] * p[2][0]) / det;
+      inv[2][1] = -(p[0][0] * p[2][1] - p[0][1] * p[2][0]) / det;
+      inv[2][2] =  (p[0][0] * p[1][1] - p[0][1] * p[1][0]) / det;
+
+      for (i = 0; i < 3; i++)
+        sc[i] = inv[i][0] * w[0] + inv[i][1] * w[1] + inv[i][2] * w[2];
+
+      for (i = 0; i < 3; i++)
+        for (j = 0; j < 3; j++)
+          to_xyz[k][i][j] = p[i][j] * sc[j];
+    }
+
+  /*  BT.709 to XYZ, then XYZ to the canvas's primaries  */
+  {
+    gdouble (*a)[3] = to_xyz[1];
+    gdouble  inv[3][3], det;
+    gint     i, j, l;
+
+    det = a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1]) -
+          a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0]) +
+          a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0]);
+
+    inv[0][0] =  (a[1][1] * a[2][2] - a[1][2] * a[2][1]) / det;
+    inv[0][1] = -(a[0][1] * a[2][2] - a[0][2] * a[2][1]) / det;
+    inv[0][2] =  (a[0][1] * a[1][2] - a[0][2] * a[1][1]) / det;
+    inv[1][0] = -(a[1][0] * a[2][2] - a[1][2] * a[2][0]) / det;
+    inv[1][1] =  (a[0][0] * a[2][2] - a[0][2] * a[2][0]) / det;
+    inv[1][2] = -(a[0][0] * a[1][2] - a[0][2] * a[1][0]) / det;
+    inv[2][0] =  (a[1][0] * a[2][1] - a[1][1] * a[2][0]) / det;
+    inv[2][1] = -(a[0][0] * a[2][1] - a[0][1] * a[2][0]) / det;
+    inv[2][2] =  (a[0][0] * a[1][1] - a[0][1] * a[1][0]) / det;
+
+    for (i = 0; i < 3; i++)
+      for (j = 0; j < 3; j++)
+        {
+          m[i][j] = 0.0;
+          for (l = 0; l < 3; l++)
+            m[i][j] += inv[i][l] * to_xyz[0][l][j];
+        }
+  }
+
+  return TRUE;
+}
