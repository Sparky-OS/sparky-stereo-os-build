+  for (i = 0; i < n; i++)
+    {
+      cairo_rectangle_int_t rect;
+
+      cairo_region_get_rectangle (stereo->dirty[e], i, &rect);
+      cairo_rectangle (cr, rect.x, rect.y, rect.width, rect.height);
+    }
+  cairo_clip (cr);
+  gimp_display_shell_stereo_paint_backdrop (shell, cr);
+  gimp_display_shell_draw_picture_parts (shell, cr, eye,
+                                         GIMP_DISPLAY_SHELL_PICTURE_AROUND);
+  cairo_destroy (cr);
+  cairo_surface_flush (stereo->chrome[e]);
+
+  /*  the image's chunks into the eye's float cache: nothing is painted on
+   *  this context
+   */
+  cr = cairo_create (stereo->picture[e]);
+  cairo_scale (cr, scale, scale);
+  for (i = 0; i < n; i++)
+    {
+      cairo_rectangle_int_t rect;
+
+      cairo_region_get_rectangle (stereo->dirty[e], i, &rect);
+      cairo_rectangle (cr, rect.x, rect.y, rect.width, rect.height);
+    }
+  cairo_clip (cr);
+  gimp_display_shell_draw_picture_parts (shell, cr, eye,
+                                         GIMP_DISPLAY_SHELL_PICTURE_IMAGE);
+  cairo_destroy (cr);
+
+  cairo_surface_flush (stereo->picture[e]);
+
+  for (i = 0; i < n; i++)
+    {
+      cairo_rectangle_int_t rect;
+
+      cairo_region_get_rectangle (stereo->dirty[e], i, &rect);
+      rect.x      *= scale;
+      rect.y      *= scale;
+      rect.width  *= scale;
+      rect.height *= scale;
+
+      if (! gdk_rectangle_intersect (&rect, &whole, &rect))
+        continue;
+
+      gimp_display_shell_stereo_convert_chrome (stereo, e, &rect);
+      gimp_display_shell_stereo_composite (stereo, e, &rect);
+    }
+
+  cairo_surface_mark_dirty (stereo->picture[e]);
+}
