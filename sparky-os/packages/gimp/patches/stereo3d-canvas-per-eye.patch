+/**
+ * gimp_canvas_set_underlay:
+ * @canvas:   a #GimpCanvas widget
+ * @underlay: (nullable): a widget, or %NULL
+ *
+ * Sets a widget that covers the canvas's whole window below its
+ * overlays.  The canvas does not draw it: whoever draws the canvas
+ * draws it with gtk_container_propagate_draw() where it belongs, under
+ * the canvas items (the display shell's stereo area).
+ **/
+void
+gimp_canvas_set_underlay (GimpCanvas *canvas,
+                          GtkWidget  *underlay)
+{
+  g_return_if_fail (GIMP_IS_CANVAS (canvas));
+  g_return_if_fail (underlay == NULL || GTK_IS_WIDGET (underlay));
+
+  if (canvas->underlay == underlay)
+    return;
+
+  if (canvas->underlay)
+    gtk_container_remove (GTK_CONTAINER (canvas), canvas->underlay);
+
+  if (underlay)
+    {
+      canvas->underlay = underlay;
+      gtk_widget_set_parent (underlay, GTK_WIDGET (canvas));
+    }
+
+  gtk_widget_queue_resize (GTK_WIDGET (canvas));
+}
