+void
+view_stereo_cmd_callback (GimpAction *action,
+                          GVariant   *value,
+                          gpointer    data)
+{
+  GimpDisplay      *display;
+  GimpDisplayShell *shell;
+  gboolean          active;
+  return_if_no_display (display, data);
+
+  shell = gimp_display_get_shell (display);
+
+  active = g_variant_get_boolean (value);
+
+  if (active != gimp_display_shell_stereo_get_enabled (shell))
+    {
+      GimpImageWindow *window = gimp_display_shell_get_window (shell);
+
+      gimp_display_shell_stereo_set_enabled (shell, active);
+
+      if (window)
+        SET_ACTIVE (menus_get_image_manager_singleton (display->gimp),
+                    "view-stereo", active);
+
+      if (IS_ACTIVE_DISPLAY (display))
+        SET_ACTIVE (shell->popup_manager, "view-stereo", active);
+    }
+}
