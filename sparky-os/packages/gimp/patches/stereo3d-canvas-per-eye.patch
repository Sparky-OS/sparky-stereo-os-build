+static void
+gimp_canvas_size_allocate (GtkWidget     *widget,
+                           GtkAllocation *allocation)
+{
+  GimpCanvas *canvas = GIMP_CANVAS (widget);
+
+  GTK_WIDGET_CLASS (parent_class)->size_allocate (widget, allocation);
+
+  if (canvas->underlay && gtk_widget_get_visible (canvas->underlay))
+    {
+      GtkAllocation  child = { 0, 0, allocation->width, allocation->height };
+      GtkRequisition requisition;
+
+      /*  the underlay covers the canvas's whole window  */
+      gtk_widget_get_preferred_size (canvas->underlay, &requisition, NULL);
+      gtk_widget_size_allocate (canvas->underlay, &child);
+    }
+}
