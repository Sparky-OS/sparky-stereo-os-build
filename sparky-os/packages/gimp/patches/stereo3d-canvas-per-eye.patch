+static void
+gimp_canvas_remove (GtkContainer *container,
+                    GtkWidget    *widget)
+{
+  GimpCanvas *canvas = GIMP_CANVAS (container);
+
+  if (widget == canvas->underlay)
+    {
+      gboolean was_visible = gtk_widget_get_visible (widget);
+
+      gtk_widget_unparent (widget);
+      canvas->underlay = NULL;
+
+      if (was_visible)
+        gtk_widget_queue_draw (GTK_WIDGET (container));
+
+      return;
+    }
+
+  GTK_CONTAINER_CLASS (parent_class)->remove (container, widget);
+}
+
+static void
+gimp_canvas_forall (GtkContainer *container,
+                    gboolean      include_internals,
+                    GtkCallback   callback,
+                    gpointer      callback_data)
+{
+  GimpCanvas *canvas   = GIMP_CANVAS (container);
+  GtkWidget  *underlay = canvas->underlay;
+
+  if (underlay)
+    (* callback) (underlay, callback_data);
+
+  GTK_CONTAINER_CLASS (parent_class)->forall (container, include_internals,
+                                              callback, callback_data);
+}
