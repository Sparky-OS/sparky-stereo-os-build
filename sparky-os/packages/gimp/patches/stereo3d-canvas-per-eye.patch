+      g_clear_error (&error);
+    }
+}
+
+
+/*  private functions  */
+
+static gboolean
+gimp_display_shell_stereo_same_model (const StereoModel *a,
+                                      const StereoModel *b)
+{
+  return (a->kind       == b->kind       &&
+          a->layers[0]  == b->layers[0]  &&
+          a->layers[1]  == b->layers[1]  &&
+          a->top_bottom == b->top_bottom &&
+          a->left_first == b->left_first);
+}
+
+static gchar *
+gimp_display_shell_stereo_parasite_text (GimpImage   *image,
+                                         const gchar *name)
+{
+  const GimpParasite *parasite = gimp_image_parasite_find (image, name);
+  const gchar        *data;
+  guint32             size;
+  gchar              *text;
+
+  if (! parasite)
+    return NULL;
+
+  data = gimp_parasite_get_data (parasite, &size);
+  text = g_strndup (data, size);
+
+  return text;
+}
+
+static void
+gimp_display_shell_stereo_read_model (GimpDisplayShellStereo *stereo,
+                                      StereoModel            *model)
+{
+  GimpImage *image;
+  gchar     *mode;
+  gchar     *layout;
+  GList     *list;
+
+  memset (model, 0, sizeof (StereoModel));
+
+  image = gimp_display_get_image (stereo->shell->display);
+
+  if (! stereo->enabled || ! image || gimp_image_get_converting (image))
+    return;
+
+  /*  the layer names are the plug-in's identifiers, the same in every
+   *  language
+   */
+  for (list = gimp_image_get_layer_iter (image); list; list = g_list_next (list))
+    {
+      const gchar *name = gimp_object_get_name (list->data);
+
+      if (! model->layers[0] && ! g_strcmp0 (name, LEFT_EYE_LAYER))
+        model->layers[0] = list->data;
+      else if (! model->layers[1] && ! g_strcmp0 (name, RIGHT_EYE_LAYER))
+        model->layers[1] = list->data;
+    }
+
+  if (model->layers[0] && model->layers[1])
+    {
+      model->kind = STEREO_EYE_LAYERS;
+      return;
+    }
+
+  model->layers[0] = model->layers[1] = NULL;
+
+  mode = gimp_display_shell_stereo_parasite_text (image, MODE_PARASITE);
+
+  if (mode && (! g_strcmp0 (mode, "each-eye") || ! g_strcmp0 (mode, "both-eyes")))
+    {
+      layout = gimp_display_shell_stereo_parasite_text (image, LAYOUT_PARASITE);
+
+      /*  the plug-in's own reading of a picture without a layout: side by
+       *  side, left view first
+       */
+      if (! layout || ! g_strcmp0 (layout, "sideBySideLeftFirst"))
+        {
+          model->kind       = STEREO_PACKED;
+          model->left_first = TRUE;
+        }
+      else if (! g_strcmp0 (layout, "sideBySideRightFirst"))
+        {
+          model->kind = STEREO_PACKED;
+        }
+      else if (! g_strcmp0 (layout, "topBottomLeftFirst"))
+        {
+          model->kind       = STEREO_PACKED;
+          model->top_bottom = TRUE;
+          model->left_first = TRUE;
+        }
+      else if (! g_strcmp0 (layout, "topBottomRightFirst"))
+        {
+          model->kind       = STEREO_PACKED;
+          model->top_bottom = TRUE;
+        }
+
+      g_free (layout);
+    }
+
+  g_free (mode);
+}
+
+static gboolean
+gimp_display_shell_stereo_apply (gpointer data)
+{
+  GimpDisplayShellStereo *stereo = data;
+  GimpDisplayShell       *shell  = stereo->shell;
+  StereoModel             wanted;
+  gint                    i;
+
+  stereo->apply_idle_id = 0;
+
+  gimp_display_shell_stereo_read_model (stereo, &wanted);
+
+  if (gimp_display_shell_stereo_same_model (&wanted, &stereo->model))
+    return G_SOURCE_REMOVE;
+
+  stereo->model = wanted;
+
+  for (i = 0; i < 2; i++)
+    {
+      g_clear_pointer (&stereo->render_cache_valid[i], cairo_region_destroy);
+      g_clear_pointer (&stereo->picture[i], cairo_surface_destroy);
+    }
+
+#ifdef HAVE_GTK_GL_AREA_STEREO
+  /*  a new image kind, or "Enable 3D" turned on again, tries again  */
+  stereo->failed = FALSE;
+
+  if (wanted.kind != STEREO_NONE && ! stereo->probed)
+    {
+      stereo->probed  = TRUE;
+      stereo->refused = gimp_display_shell_stereo_probe (GTK_WIDGET (shell));
+    }
+
+  if (wanted.kind != STEREO_NONE && stereo->refused)
+    {
+      if (! stereo->tell_idle_id)
+        stereo->tell_idle_id = g_idle_add (gimp_display_shell_stereo_tell,
+                                           stereo);
+    }
+  else if (wanted.kind != STEREO_NONE)
+    {
+      if (! stereo->area)
+        gimp_display_shell_stereo_make_area (stereo);
+
+      gtk_gl_area_set_stereo (GTK_GL_AREA (stereo->area), TRUE);
+      gtk_widget_show (stereo->area);
+    }
+  else if (stereo->area)
+    {
+      gtk_widget_hide (stereo->area);
+      gtk_gl_area_set_stereo (GTK_GL_AREA (stereo->area), FALSE);
+    }
+#endif
+
+  gtk_widget_queue_draw (shell->canvas);
+
+  return G_SOURCE_REMOVE;
+}
+
+#ifdef HAVE_GTK_GL_AREA_STEREO
+
+static void
+gimp_display_shell_stereo_make_area (GimpDisplayShellStereo *stereo)
+{
+  stereo->area = g_object_ref_sink (gtk_gl_area_new ());
+
+  gtk_gl_area_set_has_alpha (GTK_GL_AREA (stereo->area), FALSE);
+
+  g_signal_connect (stereo->area, "render",
+                    G_CALLBACK (gimp_display_shell_stereo_render),
+                    stereo);
+  g_signal_connect (stereo->area, "unrealize",
+                    G_CALLBACK (gimp_display_shell_stereo_unrealize),
+                    stereo);
+  g_signal_connect (stereo->area, "notify::stereo-error",
+                    G_CALLBACK (gimp_display_shell_stereo_error),
+                    stereo);
+
+  gimp_canvas_set_underlay (GIMP_CANVAS (stereo->shell->canvas), stereo->area);
+}
+
+/*  What lies under the canvas in its window: the canvas's window has no
+ *  background of its own, so in 2D its padding shows the backgrounds that
+ *  the widgets around it painted (the window's, the dock's).  They are
+ *  painted here in the same order, each at its place relative to the
+ *  canvas.
+ */
+static void
+gimp_display_shell_stereo_paint_backdrop (GimpDisplayShell *shell,
+                                          cairo_t          *cr)
+{
+  GList     *ancestors = NULL;
+  GList     *list;
+  GtkWidget *widget;
+
+  for (widget = shell->canvas; widget; widget = gtk_widget_get_parent (widget))
+    ancestors = g_list_prepend (ancestors, widget);
+
+  for (list = ancestors; list; list = g_list_next (list))
+    {
+      GtkAllocation allocation;
+      gint          x, y;
+
+      widget = list->data;
+
+      if (! gtk_widget_translate_coordinates (widget, shell->canvas,
+                                              0, 0, &x, &y))
+        continue;
+
+      gtk_widget_get_allocation (widget, &allocation);
+
+      gtk_render_background (gtk_widget_get_style_context (widget), cr,
+                             x, y, allocation.width, allocation.height);
+    }
+
+  g_list_free (ancestors);
+}
+
+/*  One eye's picture of the canvas, as the canvas would draw it itself
+ *  (its background, the padding, the checkerboard and the image), in
+ *  device pixels; only what changed since the last frame is drawn again.
+ *  Returns the part drawn, in device pixels.
+ */
+static cairo_rectangle_int_t
+gimp_display_shell_stereo_paint (GimpDisplayShellStereo *stereo,
+                                 gint                    e)
+{
+  GimpDisplayShell      *shell  = stereo->shell;
+  gint                   scale  = shell->render_scale;
+  gint                   width  = shell->disp_width  * scale;
+  gint                   height = shell->disp_height * scale;
+  cairo_rectangle_int_t  extents = { 0, 0, 0, 0 };
+  cairo_rectangle_int_t  whole   = { 0, 0, width, height };
+  cairo_t               *cr;
+  gint                   n, i;
+
+  if (! stereo->picture[e] ||
+      cairo_image_surface_get_width  (stereo->picture[e]) != width ||
+      cairo_image_surface_get_height (stereo->picture[e]) != height)
+    {
+      cairo_rectangle_int_t all = { 0, 0, shell->disp_width, shell->disp_height };
+
+      g_clear_pointer (&stereo->picture[e], cairo_surface_destroy);
+      stereo->picture[e] = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+                                                       width, height);
+
+      if (! stereo->dirty[e])
+        stereo->dirty[e] = cairo_region_create ();
+      cairo_region_union_rectangle (stereo->dirty[e], &all);
+    }
+
+  if (! stereo->dirty[e] || cairo_region_is_empty (stereo->dirty[e]))
+    return extents;
+
+  cr = cairo_create (stereo->picture[e]);
+  cairo_scale (cr, scale, scale);
+
+  n = cairo_region_num_rectangles (stereo->dirty[e]);
+  for (i = 0; i < n; i++)
+    {
+      cairo_rectangle_int_t rect;
+
+      cairo_region_get_rectangle (stereo->dirty[e], i, &rect);
+      cairo_rectangle (cr, rect.x, rect.y, rect.width, rect.height);
+    }
+  cairo_clip (cr);
+
+  gimp_display_shell_stereo_paint_backdrop (shell, cr);
+
+  gimp_display_shell_draw_picture (shell, cr,
+                                   e ? GIMP_DISPLAY_SHELL_EYE_RIGHT :
+                                       GIMP_DISPLAY_SHELL_EYE_LEFT);
+
+  cairo_destroy (cr);
+  cairo_surface_flush (stereo->picture[e]);
+
+  cairo_region_get_extents (stereo->dirty[e], &extents);
+  cairo_region_destroy (stereo->dirty[e]);
+  stereo->dirty[e] = NULL;
+
+  extents.x      *= scale;
+  extents.y      *= scale;
+  extents.width  *= scale;
+  extents.height *= scale;
+
+  gdk_rectangle_intersect (&extents, &whole, &extents);
+
+  return extents;
+}
+
+/*  The area's render signal, once for each eye: the eye's picture goes up
+ *  into a texture, then into the area's framebuffer, turned over (cairo's
+ *  first row is the top of the picture, OpenGL's the bottom).
+ */
+static gboolean
+gimp_display_shell_stereo_render (GtkGLArea              *area,
+                                  GdkGLContext           *context,
+                                  GimpDisplayShellStereo *stereo)
+{
+  cairo_rectangle_int_t  changed;
+  cairo_surface_t       *picture;
+  GLint                  draw_framebuffer;
+  GLint                  viewport[4];
+  GLboolean              scissor;
+  gboolean               es = gdk_gl_context_get_use_es (context);
+  gint                   e;
+  gint                   width;
+  gint                   height;
+  gint                   stride;
+  guchar                *data;
+
+  e = (gtk_gl_area_get_current_eye (area) == GTK_GL_AREA_EYE_RIGHT);
+
+  if (! stereo->renderer_known)
+    {
+      const gchar *renderer = (const gchar *) glGetString (GL_RENDERER);
+
+      stereo->on_processor = renderer && (strstr (renderer, "llvmpipe") ||
+                                          strstr (renderer, "softpipe"));
+      stereo->renderer_known = TRUE;
+    }
+
+  if (stereo->model.kind == STEREO_NONE)
+    {
+      glClearColor (0.0, 0.0, 0.0, 1.0);
+      glClear (GL_COLOR_BUFFER_BIT);
+      return TRUE;
+    }
+
+  changed = gimp_display_shell_stereo_paint (stereo, e);
+  picture = stereo->picture[e];
+  width   = cairo_image_surface_get_width  (picture);
+  height  = cairo_image_surface_get_height (picture);
+  stride  = cairo_image_surface_get_stride (picture);
+  data    = cairo_image_surface_get_data   (picture);
+
+  glGetIntegerv (GL_DRAW_FRAMEBUFFER_BINDING, &draw_framebuffer);
+  glGetIntegerv (GL_VIEWPORT, viewport);
+
+  if (! stereo->framebuffer)
+    glGenFramebuffers (1, &stereo->framebuffer);
+
+  if (! stereo->texture[e])
+    {
+      glGenTextures (1, &stereo->texture[e]);
+      glBindTexture (GL_TEXTURE_2D, stereo->texture[e]);
+      glTexParameteri (GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri (GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    }
+  else
+    {
+      glBindTexture (GL_TEXTURE_2D, stereo->texture[e]);
+    }
+
+  if (stereo->texture_width[e]  != width ||
+      stereo->texture_height[e] != height)
+    {
+      glTexImage2D (GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0,
+                    GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+
+      stereo->texture_width[e]  = width;
+      stereo->texture_height[e] = height;
+
+      changed.x      = 0;
+      changed.y      = 0;
+      changed.width  = width;
+      changed.height = height;
+    }
+
+  if (changed.width > 0 && changed.height > 0)
+    {
+      const guchar *first = data + changed.y * stride + changed.x * 4;
+
+      if (es)
+        {
+          /*  OpenGL ES takes no BGRA: cairo's samples are turned to RGBA  */
+          guchar *rgba = g_malloc ((gsize) changed.width * changed.height * 4);
+          gint    x, y;
+
+          for (y = 0; y < changed.height; y++)
+            {
+              const guint32 *src = (const guint32 *) (first + y * stride);
+              guchar        *dest = rgba + (gsize) y * changed.width * 4;
+
+              for (x = 0; x < changed.width; x++)
+                {
+                  dest[4 * x + 0] = (src[x] >> 16) & 0xff;
+                  dest[4 * x + 1] = (src[x] >>  8) & 0xff;
+                  dest[4 * x + 2] =  src[x]        & 0xff;
+                  dest[4 * x + 3] = 0xff;
+                }
+            }
+
+          glPixelStorei (GL_UNPACK_ALIGNMENT, 4);
+          glTexSubImage2D (GL_TEXTURE_2D, 0, changed.x, changed.y,
+                           changed.width, changed.height,
+                           GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+          g_free (rgba);
+        }
+      else
+        {
+          /*  cairo's ARGB32 is B, G, R, A in memory on little endian
+           *  machines and A, R, G, B on big endian ones: one 32 bit word
+           */
+          glPixelStorei (GL_UNPACK_ALIGNMENT, 4);
+          glPixelStorei (GL_UNPACK_ROW_LENGTH, stride / 4);
+          glTexSubImage2D (GL_TEXTURE_2D, 0, changed.x, changed.y,
+                           changed.width, changed.height,
+                           GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, first);
+          glPixelStorei (GL_UNPACK_ROW_LENGTH, 0);
+        }
+    }
+
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, stereo->framebuffer);
+  glFramebufferTexture2D (GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          GL_TEXTURE_2D, stereo->texture[e], 0);
+  glBindFramebuffer (GL_DRAW_FRAMEBUFFER, draw_framebuffer);
+
+  /*  a blit obeys the scissor test  */
+  scissor = glIsEnabled (GL_SCISSOR_TEST);
+  glDisable (GL_SCISSOR_TEST);
+
+  if (width != viewport[2] || height != viewport[3])
+    g_debug ("gimp_display_shell_stereo_render: the view is %dx%d, "
+             "the canvas's picture %dx%d",
+             viewport[2], viewport[3], width, height);
+
+  glBlitFramebuffer (0, 0, width, height,
+                     0, viewport[3], viewport[2], 0,
+                     GL_COLOR_BUFFER_BIT, GL_NEAREST);
+
+  if (scissor)
+    glEnable (GL_SCISSOR_TEST);
+
+  glBindFramebuffer (GL_FRAMEBUFFER, draw_framebuffer);
+  glBindTexture (GL_TEXTURE_2D, 0);
+
+  return TRUE;
+}
+
+static void
+gimp_display_shell_stereo_unrealize (GtkWidget              *area,
+                                     GimpDisplayShellStereo *stereo)
+{
+  gtk_gl_area_make_current (GTK_GL_AREA (area));
+
+  if (! gtk_gl_area_get_error (GTK_GL_AREA (area)))
+    {
+      if (stereo->texture[0] || stereo->texture[1])
+        glDeleteTextures (2, stereo->texture);
+
+      if (stereo->framebuffer)
+        glDeleteFramebuffers (1, &stereo->framebuffer);
+    }
+
+  stereo->texture[0] = stereo->texture[1] = 0;
+  stereo->texture_width[0] = stereo->texture_width[1] = 0;
+  stereo->texture_height[0] = stereo->texture_height[1] = 0;
+  stereo->framebuffer = 0;
+  stereo->renderer_known = FALSE;
+
+  g_clear_pointer (&stereo->picture[0], cairo_surface_destroy);
+  g_clear_pointer (&stereo->picture[1], cairo_surface_destroy);
+}
+
+static void
+gimp_display_shell_stereo_error (GtkGLArea              *area,
+                                 GParamSpec             *pspec,
+                                 GimpDisplayShellStereo *stereo)
+{
+  /*  the area tells while it draws: the person is told afterwards  */
+  if (! stereo->tell_idle_id)
+    stereo->tell_idle_id = g_idle_add (gimp_display_shell_stereo_tell, stereo);
+}
+
+static gboolean
+gimp_display_shell_stereo_tell (gpointer data)
+{
+  GimpDisplayShellStereo *stereo = data;
+  GtkGLArea              *area   = NULL;
+  const gchar            *reason;
+
+  stereo->tell_idle_id = 0;
+
+  if (stereo->refused)
+    {
+      reason = stereo->refused;
+    }
+  else
+    {
+      const GError *error;
+
+      area  = GTK_GL_AREA (stereo->area);
+      error = gtk_gl_area_get_stereo_error (area);
+
+      if (! error)
+        {
+          g_clear_pointer (&stereo->told, g_free);
+          return G_SOURCE_REMOVE;
+        }
+
+      reason = error->message;
+
+      /*  GTK draws the area's left view with OpenGL, and GTK 3 then keeps
+       *  that rectangle free of what the canvas draws after it: the canvas
+       *  draws the left eye itself instead, with its guides and outlines
+       */
+      stereo->failed = TRUE;
+      gtk_widget_hide (stereo->area);
+      gtk_widget_queue_draw (stereo->shell->canvas);
+    }
+
+  if (! g_strcmp0 (stereo->told, reason))
+    return G_SOURCE_REMOVE;
+
+  g_free (stereo->told);
+  stereo->told = g_strdup (reason);
+
+  if (area && ! stereo->renderer_known && gtk_widget_get_realized (stereo->area))
+    {
+      const gchar *renderer;
+
+      gtk_gl_area_make_current (area);
+
+      renderer = (const gchar *) glGetString (GL_RENDERER);
+
+      stereo->on_processor = renderer && (strstr (renderer, "llvmpipe") ||
+                                          strstr (renderer, "softpipe"));
+      stereo->renderer_known = TRUE;
+    }
+
+  /*  the reason, in English, is in the log  */
+  g_printerr ("GIMP: the canvas is not shown per eye: %s\n", reason);
+
+  if (stereo->on_processor)
+    gimp_message_literal (stereo->shell->display->gimp,
+                          G_OBJECT (stereo->shell), GIMP_MESSAGE_WARNING,
+                          _("This window is drawn by the processor, not by a "
+                            "graphics card, and a picture for each eye needs "
+                            "a graphics card: the left eye is shown."));
+  else
+    gimp_message_literal (stereo->shell->display->gimp,
+                          G_OBJECT (stereo->shell), GIMP_MESSAGE_WARNING,
+                          _("The canvas cannot be shown in 3D here, so the "
+                            "left eye is shown; the reason is in the log."));
+
+  return G_SOURCE_REMOVE;
+}
+
+/*  On X11, the renderer as a window of its own reads it: in GTK 3 a window
+ *  that is given an OpenGL context is drawn with OpenGL from then on, and
+ *  with Mesa's zink under Xwayland such a window shows nothing but black
+ *  (Debian's GTK 3 too).  Returns why the canvas's window must not be given
+ *  an area, or NULL.
+ */
+static gchar *
+gimp_display_shell_stereo_probe (GtkWidget *widget)
+{
+  gchar *refused = NULL;
+
+#ifdef GDK_WINDOWING_X11
+  GdkDisplay    *display = gtk_widget_get_display (widget);
+  GdkWindowAttr  attributes = { 0, };
+  GdkWindow     *window;
+  GdkGLContext  *context;
+  GError        *error = NULL;
+
+  if (! GDK_IS_X11_DISPLAY (display))
+    return NULL;
+
+  attributes.window_type       = GDK_WINDOW_TOPLEVEL;
+  attributes.wclass            = GDK_INPUT_OUTPUT;
+  attributes.width             = 1;
+  attributes.height            = 1;
+  attributes.override_redirect = TRUE;
+
+  window = gdk_window_new (gdk_screen_get_root_window (gtk_widget_get_screen (widget)),
+                           &attributes, GDK_WA_NOREDIR);
+
+  context = gdk_window_create_gl_context (window, &error);
+
+  if (context && gdk_gl_context_realize (context, &error))
+    {
+      const gchar *renderer;
+
+      gdk_gl_context_make_current (context);
+
+      renderer = (const gchar *) glGetString (GL_RENDERER);
+
+      if (renderer && strstr (renderer, "zink"))
+        refused = g_strdup_printf ("GTK 3 draws an X11 window that holds an "
+                                   "OpenGL area black with Mesa's zink (%s)",
+                                   renderer);
+
+      gdk_gl_context_clear_current ();
+    }
+
+  g_clear_error (&error);
+  g_clear_object (&context);
+  gdk_window_destroy (window);
+#endif
+
+  return refused;
+}
+
+#endif /* HAVE_GTK_GL_AREA_STEREO */
