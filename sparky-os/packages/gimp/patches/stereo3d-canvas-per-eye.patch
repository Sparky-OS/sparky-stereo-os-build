+ */
+
+/*  The canvas of a stereo image, one picture for each eye.
+ *
+ *  A stereo image is one of two kinds: an image with the top-level
+ *  layers "Left eye" and "Right eye" (how the stereo pictures plug-in
+ *  opens MPO, JPS and PNS files), or a picture that holds both views
+ *  side by side or top and bottom and that the person put into one of
+ *  the plug-in's editing modes (the image's "stereo-pictures/edit-mode"
+ *  parasite; its "stereo-pictures/layout" parasite says the packing).
+ *
+ *  While "Enable 3D" is on, such an image's canvas is drawn twice, once
+ *  for each eye, each from that eye's own content and at the canvas's
+ *  own size, and the two pictures go to the compositor through a
+ *  stereo GtkGLArea below the canvas: the area hands them over side by
+ *  side, left first, declared once, and keeps a hole in the window so
+ *  that the guides, the selection and the tools' outlines, which the
+ *  canvas keeps drawing, lie over the picture at the screen in both
+ *  eyes.  The compositor does the one resize.  A packed picture is shown
+ *  with each eye's view in both halves (the left eye sees the left view
+ *  in the left half and in the right half), so the canvas keeps the
+ *  image's size and coordinates and every tool works where it is used.
+ *
+ *  When the canvas cannot be shown per eye, the canvas draws the left
+ *  eye itself, with the guides and outlines over it, and the person is
+ *  told why; "Enable 3D" turned off and on again tries once more.  On
+ *  X11 the renderer is read first, on a window of its own: with Mesa's
+ *  zink, GTK 3 draws an X11 window that holds an OpenGL area black, so
+ *  the canvas's window is never given one there.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include <gegl.h>
+#include <gtk/gtk.h>
+
+#ifdef HAVE_GTK_GL_AREA_STEREO
+#include <epoxy/gl.h>
+#endif
+
+#ifdef GDK_WINDOWING_X11
+#include <gdk/gdkx.h>
+#endif
+
+#include "libgimpbase/gimpbase.h"
+#include "libgimpmath/gimpmath.h"
+#include "libgimpwidgets/gimpwidgets.h"
+
+#include "display-types.h"
+
+#include "core/gimp.h"
+#include "core/gimpdrawable.h"
+#include "core/gimpimage.h"
+#include "core/gimpitem.h"
+#include "core/gimplayer.h"
+#include "core/gimppickable.h"
+
+#include "gimpcanvas.h"
+#include "gimpdisplay.h"
+#include "gimpdisplayshell.h"
+#include "gimpdisplayshell-draw.h"
+#include "gimpdisplayshell-stereo.h"
+
+#include "gimp-intl.h"
+
+
+#define LEFT_EYE_LAYER   "Left eye"
+#define RIGHT_EYE_LAYER  "Right eye"
+#define MODE_PARASITE    "stereo-pictures/edit-mode"
+#define LAYOUT_PARASITE  "stereo-pictures/layout"
+
+
+typedef enum
+{
+  STEREO_NONE,
+  STEREO_EYE_LAYERS,
+  STEREO_PACKED
+} StereoKind;
+
+typedef struct
+{
+  StereoKind  kind;
+  GimpLayer  *layers[2];      /*  STEREO_EYE_LAYERS: left, right        */
+  gboolean    top_bottom;     /*  STEREO_PACKED: the views' packing     */
+  gboolean    left_first;
+} StereoModel;
+
+struct _GimpDisplayShellStereo
+{
+  GimpDisplayShell *shell;
+
+  gboolean          enabled;
+  StereoModel       model;
+
+  GtkWidget        *area;
+
+  /*  each eye's render cache, as the shell's own, and its picture of the
+   *  whole canvas in device pixels
+   */
+  cairo_surface_t  *render_cache[2];
+  cairo_region_t   *render_cache_valid[2];
+  cairo_surface_t  *picture[2];
+  cairo_region_t   *dirty[2];
+
+  guint             texture[2];
+  gint              texture_width[2];
+  gint              texture_height[2];
+  guint             framebuffer;
+
+  gboolean          renderer_known;
+  gboolean          on_processor;
+
+  /*  the area said it cannot show the pair: the canvas draws the left eye  */
+  gboolean          failed;
+  /*  why the canvas's window is not given an area at all (X11 and zink)  */
+  gboolean          probed;
+  gchar            *refused;
+
+  guint             apply_idle_id;
+  guint             tell_idle_id;
+  gchar            *told;
+};
+
+
+/*  local function prototypes  */
+
+static gboolean gimp_display_shell_stereo_same_model (const StereoModel      *a,
+                                                      const StereoModel      *b);
+
+static void     gimp_display_shell_stereo_read_model (GimpDisplayShellStereo *stereo,
+                                                      StereoModel            *model);
+static gboolean gimp_display_shell_stereo_apply      (gpointer                data);
+
+#ifdef HAVE_GTK_GL_AREA_STEREO
+static void     gimp_display_shell_stereo_make_area  (GimpDisplayShellStereo *stereo);
+static gboolean gimp_display_shell_stereo_render     (GtkGLArea              *area,
+                                                      GdkGLContext           *context,
+                                                      GimpDisplayShellStereo *stereo);
+static void     gimp_display_shell_stereo_unrealize  (GtkWidget              *area,
+                                                      GimpDisplayShellStereo *stereo);
+static void     gimp_display_shell_stereo_error      (GtkGLArea              *area,
+                                                      GParamSpec             *pspec,
+                                                      GimpDisplayShellStereo *stereo);
+static gboolean gimp_display_shell_stereo_tell       (gpointer                data);
+static gchar  * gimp_display_shell_stereo_probe      (GtkWidget              *widget);
+#endif
+
+
+/*  public functions  */
+
+GimpDisplayShellStereo *
+gimp_display_shell_stereo_new (GimpDisplayShell *shell)
+{
+  GimpDisplayShellStereo *stereo;
+
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), NULL);
+
+  stereo = g_new0 (GimpDisplayShellStereo, 1);
+
+  stereo->shell   = shell;
+  stereo->enabled = TRUE;
+
+  return stereo;
+}
+
+void
+gimp_display_shell_stereo_free (GimpDisplayShellStereo *stereo)
+{
+  gint i;
+
+  if (! stereo)
+    return;
+
+  g_clear_handle_id (&stereo->apply_idle_id, g_source_remove);
+  g_clear_handle_id (&stereo->tell_idle_id, g_source_remove);
+
+  if (stereo->area)
+    {
+      g_signal_handlers_disconnect_by_data (stereo->area, stereo);
+      g_clear_object (&stereo->area);
+    }
+
+  for (i = 0; i < 2; i++)
+    {
+      g_clear_pointer (&stereo->render_cache[i], cairo_surface_destroy);
+      g_clear_pointer (&stereo->render_cache_valid[i], cairo_region_destroy);
+      g_clear_pointer (&stereo->picture[i], cairo_surface_destroy);
+      g_clear_pointer (&stereo->dirty[i], cairo_region_destroy);
+    }
+
+  g_free (stereo->told);
+  g_free (stereo->refused);
+  g_free (stereo);
+}
+
+void
+gimp_display_shell_stereo_set_enabled (GimpDisplayShell *shell,
+                                       gboolean          enabled)
+{
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  enabled = enabled ? TRUE : FALSE;
+
+  if (shell->stereo && shell->stereo->enabled != enabled)
+    {
+      shell->stereo->enabled = enabled;
+
+      gtk_widget_queue_draw (shell->canvas);
+    }
+}
+
+gboolean
+gimp_display_shell_stereo_get_enabled (GimpDisplayShell *shell)
+{
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), FALSE);
+
+  return shell->stereo ? shell->stereo->enabled : FALSE;
+}
+
+/*  Called by the canvas's draw handler before it draws the image.  Returns
+ *  TRUE when the canvas's picture is the stereo area's (the area drew its
+ *  hole, or its left view after a failure), FALSE when the canvas draws
+ *  the image itself.
+ */
+gboolean
+gimp_display_shell_stereo_draw (GimpDisplayShell *shell,
+                                cairo_t          *cr)
+{
+  GimpDisplayShellStereo *stereo;
+  StereoModel             wanted;
+
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), FALSE);
+  g_return_val_if_fail (cr != NULL, FALSE);
+
+  stereo = shell->stereo;
+
+  if (! stereo)
+    return FALSE;
+
+  gimp_display_shell_stereo_read_model (stereo, &wanted);
+
+  /*  a change of the image's kind is applied outside of drawing; until
+   *  then the canvas draws the image as usual
+   */
+  if (! gimp_display_shell_stereo_same_model (&wanted, &stereo->model))
+    {
+      if (! stereo->apply_idle_id)
+        stereo->apply_idle_id = g_idle_add (gimp_display_shell_stereo_apply,
+                                            stereo);
+      return FALSE;
+    }
+
+  if (stereo->model.kind == STEREO_NONE)
+    return FALSE;
+
+  /*  the canvas cannot be shown per eye: the left eye, drawn by the canvas
+   *  itself so that the guides and outlines lie over it
+   */
+  if (stereo->refused || stereo->failed)
+    {
+      gimp_display_shell_draw_picture (shell, cr, GIMP_DISPLAY_SHELL_EYE_LEFT);
+      return TRUE;
+    }
+
+  if (! stereo->area || ! gtk_widget_get_visible (stereo->area))
+    return FALSE;
+
+#ifdef HAVE_GTK_GL_AREA_STEREO
+  {
+    cairo_rectangle_list_t *clip = cairo_copy_clip_rectangle_list (cr);
+    gint                    i, j;
+
+    /*  what the canvas draws again is what changed in each eye's picture  */
+    for (i = 0; i < 2; i++)
+      {
+        if (! stereo->dirty[i])
+          stereo->dirty[i] = cairo_region_create ();
+
+        if (clip->status != CAIRO_STATUS_SUCCESS)
+          {
+            cairo_rectangle_int_t all = { 0, 0,
+                                          shell->disp_width,
+                                          shell->disp_height };
+
+            cairo_region_union_rectangle (stereo->dirty[i], &all);
+            continue;
+          }
+
+        for (j = 0; j < clip->num_rectangles; j++)
+          {
+            cairo_rectangle_t     *r = &clip->rectangles[j];
+            cairo_rectangle_int_t  rect;
+
+            rect.x      = floor (r->x);
+            rect.y      = floor (r->y);
+            rect.width  = ceil (r->x + r->width)  - rect.x;
+            rect.height = ceil (r->y + r->height) - rect.y;
+
+            cairo_region_union_rectangle (stereo->dirty[i], &rect);
+          }
+      }
+
+    cairo_rectangle_list_destroy (clip);
+
+    gtk_container_propagate_draw (GTK_CONTAINER (shell->canvas),
+                                  stereo->area, cr);
+  }
+
+  return TRUE;
+#else
+  return FALSE;
+#endif
+}
+
+void
+gimp_display_shell_stereo_invalidate_area (GimpDisplayShell *shell,
+                                           gint              x,
+                                           gint              y,
+                                           gint              width,
+                                           gint              height)
+{
+  GimpDisplayShellStereo *stereo;
+  cairo_rectangle_int_t   rect = { x, y, width, height };
+  gint                    i;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  stereo = shell->stereo;
+
+  if (! stereo)
+    return;
+
+  for (i = 0; i < 2; i++)
+    if (stereo->render_cache_valid[i])
+      cairo_region_subtract_rectangle (stereo->render_cache_valid[i], &rect);
+}
+
+void
+gimp_display_shell_stereo_invalidate_full (GimpDisplayShell *shell)
+{
+  GimpDisplayShellStereo *stereo;
+  gint                    i;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  stereo = shell->stereo;
+
+  if (! stereo)
+    return;
+
+  for (i = 0; i < 2; i++)
+    g_clear_pointer (&stereo->render_cache_valid[i], cairo_region_destroy);
+}
+
+/*  Scrolling moves each eye's render cache and its valid region as
+ *  gimp_display_shell_scroll() moves the shell's own.
+ */
+void
+gimp_display_shell_stereo_scroll (GimpDisplayShell *shell,
+                                  gint              x_offset,
+                                  gint              y_offset)
+{
+  GimpDisplayShellStereo *stereo;
+  gint                    i;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  stereo = shell->stereo;
+
+  if (! stereo)
+    return;
+
+  for (i = 0; i < 2; i++)
+    {
+      if (stereo->render_cache[i])
+        {
+          cairo_surface_t *surface;
+          cairo_t         *cr;
+
+          surface = cairo_surface_create_similar_image (
+            stereo->render_cache[i],
+            CAIRO_FORMAT_ARGB32,
+            cairo_image_surface_get_width  (stereo->render_cache[i]),
+            cairo_image_surface_get_height (stereo->render_cache[i]));
+
+          cr = cairo_create (surface);
+          cairo_set_operator (cr, CAIRO_OPERATOR_SOURCE);
+          cairo_set_source_surface (cr, stereo->render_cache[i], 0, 0);
+          cairo_paint (cr);
+          cairo_destroy (cr);
+
+          cr = cairo_create (stereo->render_cache[i]);
+          cairo_set_operator (cr, CAIRO_OPERATOR_SOURCE);
+          cairo_set_source_surface (cr, surface,
+                                    -x_offset * shell->render_scale,
+                                    -y_offset * shell->render_scale);
+          cairo_paint (cr);
+          cairo_destroy (cr);
+
+          cairo_surface_destroy (surface);
+        }
+
+      if (stereo->render_cache_valid[i])
+        {
+          cairo_rectangle_int_t rect = { 0, 0,
+                                         shell->disp_width,
+                                         shell->disp_height };
+
+          cairo_region_translate (stereo->render_cache_valid[i],
+                                  -x_offset, -y_offset);
+          cairo_region_intersect_rectangle (stereo->render_cache_valid[i],
+                                            &rect);
+        }
+    }
+}
+
+/*  The render cache of one eye, the size of the shell's own: recreated,
+ *  and so made invalid, when the canvas or its scale changed.
+ */
+cairo_surface_t **
+gimp_display_shell_stereo_get_render_cache (GimpDisplayShell    *shell,
+                                            GimpDisplayShellEye  eye)
+{
+  GimpDisplayShellStereo *stereo;
+  gint                    i;
+
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), NULL);
+  g_return_val_if_fail (eye != GIMP_DISPLAY_SHELL_EYE_NONE, NULL);
+
+  stereo = shell->stereo;
+  i      = (eye == GIMP_DISPLAY_SHELL_EYE_RIGHT);
+
+  if (stereo->render_cache[i] &&
+      (cairo_image_surface_get_width  (stereo->render_cache[i]) !=
+       shell->disp_width  * shell->render_scale ||
+       cairo_image_surface_get_height (stereo->render_cache[i]) !=
+       shell->disp_height * shell->render_scale))
+    {
+      g_clear_pointer (&stereo->render_cache[i], cairo_surface_destroy);
+      g_clear_pointer (&stereo->render_cache_valid[i], cairo_region_destroy);
+    }
+
+  return &stereo->render_cache[i];
+}
+
+cairo_region_t **
+gimp_display_shell_stereo_get_render_cache_valid (GimpDisplayShell    *shell,
+                                                  GimpDisplayShellEye  eye)
+{
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), NULL);
+  g_return_val_if_fail (eye != GIMP_DISPLAY_SHELL_EYE_NONE, NULL);
+
+  return &shell->stereo->render_cache_valid[eye == GIMP_DISPLAY_SHELL_EYE_RIGHT];
+}
+
+/*  The sources of one eye's picture, in image coordinates: the eye's layer,
+ *  or the eye's view of a packed picture put into both halves (two
+ *  sources, each clipped to its half).  Returns their number; free them
+ *  with gimp_display_shell_stereo_free_sources().
+ */
+gint
+gimp_display_shell_stereo_get_sources (GimpDisplayShell          *shell,
+                                       GimpDisplayShellEye        eye,
+                                       GimpDisplayShellEyeSource  sources[2])
+{
+  GimpDisplayShellStereo *stereo;
+  GimpImage              *image;
+  GeglAbyssPolicy         abyss_policy;
+  gint                    e;
+
+  g_return_val_if_fail (GIMP_IS_DISPLAY_SHELL (shell), 0);
+  g_return_val_if_fail (eye != GIMP_DISPLAY_SHELL_EYE_NONE, 0);
+
+  stereo = shell->stereo;
+  image  = gimp_display_get_image (shell->display);
+  e      = (eye == GIMP_DISPLAY_SHELL_EYE_RIGHT);
+
+  abyss_policy = shell->show_all ? GEGL_ABYSS_NONE : GEGL_ABYSS_CLAMP;
+
+  memset (sources, 0, 2 * sizeof (GimpDisplayShellEyeSource));
+
+  if (! image)
+    return 0;
+
+  if (stereo->model.kind == STEREO_EYE_LAYERS)
+    {
+      GimpItem *item = GIMP_ITEM (stereo->model.layers[e]);
+      gint      offset_x;
+      gint      offset_y;
+
+      gimp_item_get_offset (item, &offset_x, &offset_y);
+
+      /*  the layer's own buffer, moved to the layer's place in the image  */
+      sources[0].buffer =
+        g_object_new (GEGL_TYPE_BUFFER,
+                      "source",  gimp_drawable_get_buffer (GIMP_DRAWABLE (item)),
+                      "shift-x", -offset_x,
+                      "shift-y", -offset_y,
+                      NULL);
+
+      /*  clamping is the projection's way at the image's edges; a layer
+       *  smaller than the image ends where it ends
+       */
+      if (offset_x != 0 || offset_y != 0 ||
+          gimp_item_get_width  (item) != gimp_image_get_width  (image) ||
+          gimp_item_get_height (item) != gimp_image_get_height (image))
+        sources[0].abyss_policy = GEGL_ABYSS_NONE;
+      else
+        sources[0].abyss_policy = abyss_policy;
+
+      return 1;
+    }
+  else if (stereo->model.kind == STEREO_PACKED)
+    {
+      GeglBuffer *buffer;
+      gint        width  = gimp_image_get_width  (image);
+      gint        height = gimp_image_get_height (image);
+      gint        half;
+      gint        view;
+      gint        h;
+
+      buffer = gimp_pickable_get_buffer (gimp_display_shell_get_pickable (shell));
+
+      half = stereo->model.top_bottom ? height / 2 : width / 2;
+
+      /*  the eye's view is the first half or the second  */
+      view = (e == 0) == stereo->model.left_first ? 0 : 1;
+
+      for (h = 0; h < 2; h++)
+        {
+          gint shift = (view - h) * half;
+
+          sources[h].buffer =
+            g_object_new (GEGL_TYPE_BUFFER,
+                          "source",  buffer,
+                          "shift-x", stereo->model.top_bottom ? 0 : shift,
+                          "shift-y", stereo->model.top_bottom ? shift : 0,
+                          NULL);
+          sources[h].abyss_policy = abyss_policy;
+          sources[h].clipped      = TRUE;
+
+          if (stereo->model.top_bottom)
+            {
+              sources[h].clip.x      = 0;
+              sources[h].clip.y      = h * half;
+              sources[h].clip.width  = width;
+              sources[h].clip.height = h ? height - half : half;
+            }
+          else
+            {
+              sources[h].clip.x      = h * half;
+              sources[h].clip.y      = 0;
+              sources[h].clip.width  = h ? width - half : half;
+              sources[h].clip.height = height;
+            }
+        }
+
+      return 2;
+    }
+
+  return 0;
+}
+
+void
+gimp_display_shell_stereo_free_sources (GimpDisplayShellEyeSource *sources,
+                                        gint                       n_sources)
+{
+  gint i;
+
+  for (i = 0; i < n_sources; i++)
+    g_clear_object (&sources[i].buffer);
+}
+
+void
+gimp_display_shell_stereo_open_display_settings (GimpDisplayShell *shell)
+{
+  const gchar *argv[] = { "kcmshell6", "kcm_kscreen", NULL };
+  GError      *error  = NULL;
+
+  g_return_if_fail (GIMP_IS_DISPLAY_SHELL (shell));
+
+  if (! g_spawn_async (NULL, (gchar **) argv, NULL, G_SPAWN_SEARCH_PATH,
