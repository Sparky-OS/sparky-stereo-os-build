+
+#: app/actions/layers-actions.c
+msgctxt "layers-action"
+msgid "_Sink the Depth Layer"
+msgstr "_Zagłęb warstwę głębi"
+
+#: app/actions/layers-actions.c
+msgctxt "layers-action"
+msgid "Hold the key and move the pointer over the canvas to send the depth layer back; from the menu, one pixel"
+msgstr "Przytrzymaj klawisz i przesuwaj wskaźnik nad płótnem, aby oddalić warstwę głębi; z menu o jeden piksel"
+
+#: app/widgets/gimplayertreeview.c
+msgid "Depth"
+msgstr "Głębia"
+
+#: app/widgets/gimplayertreeview.c
+msgid "The depth of the depth layer, in pixels of separation: positive behind the screen, negative in front of it"
+msgstr "Głębia warstwy głębi w pikselach separacji: dodatnia za ekranem, ujemna przed nim"
+
+#: app/actions/layers-commands.c
