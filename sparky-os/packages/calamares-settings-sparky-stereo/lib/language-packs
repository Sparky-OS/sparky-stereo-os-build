. "$(dirname "$0")/installer-common"
# Runs from the live system on the installed system (Calamares, shellprocess@languagepacks, after the packages step and
# the bootloader): the packages of the language chosen for the new system (spelling, hyphenation, thesaurus, LibreOffice
# and Firefox interfaces, manual pages, Tesseract files, the input method engine) are added with the Locale tool,
# `sparky-stereo-locales --add system`, which installs what none of the language has on the system and removes nothing
# (ORDER 252c, study item J8). The image already carries the nine required languages' packs, so on the usual image this
# finds nothing to add; an image without them (the developer image carries English and German only) gets the chosen
# language's here, over the network the installer has.
# A language that cannot be added must not stop an operating system from being installed, and must not be forgotten:
# it is said here (the installer's log), and kept for the new system by the edition's one engine (sparky-stereo-problems)
# with a repair, so the first login shows it. ROOT is the installed system's root (Calamares' ${ROOT}).
ROOT=${ROOT:-}
[ -n "$ROOT" ] && [ -d "$ROOT" ] || fail langpacks "ROOT=$ROOT"
lang=$(sed -n 's/^[[:space:]]*LANG=//p' "$ROOT/etc/default/locale" 2>/dev/null | tr -d '"'"'" | tail -n1)
case $lang in ""|C|C.*|POSIX|en|en_*) exit 0 ;; esac

keep() {
	# $1: what could not be done, in English for the engine (it has no catalog of ours in the new system), $2: the detail
	printf 'sparky-stereo-locales: %s\n%s\n' "$1" "$2" >&2
	command -v sparky-stereo-problems >/dev/null 2>&1 || fail langpacks "sparky-stereo-problems is not on the installer image, so this could not be kept for the new system: $1 $2"
	SPARKY_STEREO_ROOT=$ROOT sparky-stereo-problems keep --machine \
		--repair '["/usr/bin/sparky-stereo-locales","--add","system"]' \
		sparky-stereo-locales add-system "The packages of the language $lang could not be added when the system was installed: $1 Run sparky-stereo-locales --add system when the network is up. $2" \
		|| fail langpacks "the engine could not keep: $1"
	exit 0
}

[ -x "$ROOT/usr/bin/sparky-stereo-locales" ] || keep "the Locale tool is not in the new system." "$ROOT/usr/bin/sparky-stereo-locales"
if out=$(chroot "$ROOT" env DEBIAN_FRONTEND=noninteractive LANG="$lang" apt-get update 2>&1); then :; else
	status=$?
	keep "apt-get update ended with status $status (is the network up?)." "$(printf '%s\n' "$out" | tail -n 5)"
fi
if out=$(chroot "$ROOT" env DEBIAN_FRONTEND=noninteractive LANG="$lang" /usr/bin/sparky-stereo-locales --add system 2>&1); then
	printf '%s\n' "$out"
	SPARKY_STEREO_ROOT=$ROOT sparky-stereo-problems clear --machine sparky-stereo-locales add-system 2>/dev/null || :
else
	status=$?
	keep "sparky-stereo-locales --add system ended with status $status." "$(printf '%s\n' "$out" | tail -n 5)"
fi
exit 0
