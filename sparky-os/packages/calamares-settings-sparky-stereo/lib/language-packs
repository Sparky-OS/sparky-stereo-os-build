. "$(dirname "$0")/installer-common"
ROOT=${ROOT:-}
[ -n "$ROOT" ] && [ -d "$ROOT" ] || fail langpacks "ROOT=$ROOT"
if out=$(chroot "$ROOT" env INSTALLER_LANG="${INSTALLER_LANG:-en}" /usr/lib/sparky-stereo-language-tasks/languages installer 2>&1); then
    printf '%s\n' "$out"
else
    fail langpacks "$out"
fi
