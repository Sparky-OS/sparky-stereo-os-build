. "$(dirname "$0")/installer-common"
# Runs during installation (Calamares, shellprocess@efifallback) in the live system, with ESP set to the
# installed system's EFI partition (${ROOT}/boot/efi), after the bootloader step, which no longer writes
# the EFI fallback path itself (installEFIFallback: false). It runs outside the installed system because
# the installer's packages step has removed Calamares and this package from it by then.
# The fallback path, EFI/BOOT/BOOTX64.EFI on the EFI system partition, is what the firmware starts
# when it has no boot entry of its own (entries lost after a firmware reset, a disk in another machine).
#  - Windows on the machine (its boot manager on the partition, or os-prober finds it): the fallback
#    path stays as it is; it is Windows' own.
#  - Another system found by os-prober, and a fallback loader already there: it stays as it is.
#  - Otherwise: the fallback path gets the same signed chain as the system's own folder: shim as
#    BOOTX64.EFI (signed by Microsoft's UEFI CA), GRUB (signed by Debian), MokManager and GRUB's
#    small configuration beside it; never GRUB alone, which the firmware refuses under Secure Boot.
# TARGET is the installed system's root device: os-prober run from the live system lists it too, and it
# is not "another system".
# ESP, OS_PROBER, EFI_FIRMWARE, TARGET and ROOT can be set (the installer sets ESP and ROOT).
ESP=${ESP:-/boot/efi}
OS_PROBER=${OS_PROBER:-os-prober}
EFI_FIRMWARE=${EFI_FIRMWARE:-/sys/firmware/efi}
[ -d "$EFI_FIRMWARE" ] || exit 0
# A directory left on the root filesystem is not a mounted ESP.
if fs=$(findmnt -n -o FSTYPE --mountpoint "$ESP"); then :; else
	status=$?
	fail esp "$ESP: findmnt (exit $status)"
fi
[ "$fs" = vfat ] && [ -d "$ESP/EFI" ] || fail esp "$ESP (FSTYPE=$fs)"
# FAT names are case insensitive. Keep find's status, including read failures.
efi_dir() { find "$1" -mindepth 1 -maxdepth 1 -type d -iname "$2" -print -quit; }
efi_file() {
	[ -n "$1" ] || return 0
	find "$1" -mindepth 1 -maxdepth 1 -type f -iname "$2" -print -quit
}
SRC=$(efi_dir "$ESP/EFI" sparky) || fail loader "$ESP/EFI"
[ -n "$SRC" ] || fail loader "$ESP/EFI/sparky"
for f in shimx64.efi grubx64.efi mmx64.efi grub.cfg; do
	file=$(efi_file "$SRC" "$f") || fail loader "$SRC/$f"
	[ -n "$file" ] && [ -r "$file" ] && [ -s "$file" ] || fail loader "$SRC/$f"
done
TARGET=${TARGET:-}
if [ -z "$TARGET" ] && [ -n "${ROOT:-}" ]; then
	if TARGET=$(findmnt -n -o SOURCE --mountpoint "$ROOT"); then :; else
		status=$?
		fail probe "$ROOT: findmnt (exit $status)"
	fi
	[ -n "$TARGET" ] || fail probe "$ROOT: findmnt returned no device"
fi
if systems=$("$OS_PROBER"); then :; else
	status=$?
	fail probe "$OS_PROBER (exit $status)"
fi
# Compare device names literally, including a possible @/EFI/... suffix.
OTHERS=$(printf '%s\n' "$systems" | awk -F '[:@]' -v target="$TARGET" 'NF && $1 != target') || fail probe os-prober
microsoft=$(efi_dir "$ESP/EFI" Microsoft) || fail loader "$ESP/EFI"
windows=
if [ -n "$microsoft" ]; then
	boot=$(efi_dir "$microsoft" Boot) || fail loader "$microsoft"
	windows=$(efi_file "$boot" bootmgfw.efi) || fail loader "$boot"
fi
case "$OTHERS" in *:[Ww][Ii][Nn][Dd][Oo][Ww][Ss]:*) windows=detected;; esac
if [ -n "$windows" ]; then
	exit 0
fi
DST=$(efi_dir "$ESP/EFI" boot) || fail loader "$ESP/EFI"
old=$(efi_file "$DST" bootx64.efi) || fail loader "$DST"
if [ -n "$OTHERS" ] && [ -n "$old" ]; then
	exit 0
fi
[ -n "$DST" ] || DST=$ESP/EFI/BOOT
checked mkdir -p "$DST"
# Prepare and verify the complete chain before replacing any existing file.
STAGE=$(mktemp -d "$DST/.sparky-efi.XXXXXX") || fail write "$DST"
trap 'status=$?; rm -rf "$STAGE" || { printf "%s\n%s\n" "$WRITE" "$STAGE" >&2; exit 1; }; exit "$status"' EXIT
for f in shimx64.efi grubx64.efi mmx64.efi grub.cfg; do
	src=$(efi_file "$SRC" "$f") || fail loader "$SRC/$f"
	name=$f
	[ "$f" != shimx64.efi ] || name=BOOTX64.EFI
	checked cp "$src" "$STAGE/$name"
	checked cmp "$src" "$STAGE/$name"
done
for f in grubx64.efi mmx64.efi grub.cfg BOOTX64.EFI; do
	old=$(efi_file "$DST" "$f") || fail loader "$DST/$f"
	# Reuse an existing spelling: FAT resolves it to the same file.
	checked mv -f "$STAGE/$f" "${old:-$DST/$f}"
done
checked sync -f "$DST"
exit 0
