. "$(dirname "$0")/installer-common"
# Runs from the live system on the installed system during installation (Calamares,
# shellprocess@grublanguage, after the bootloader step): GRUB's menu in the installed system's
# language. The installer's steps run grub-mkconfig with the live session's environment, where the
# session's own language variables (LANGUAGE, LC_MESSAGES, LC_ALL) can name another language than the
# one chosen for the system; this writes the menu again in the language of /etc/default/locale.
# The translations of the menu entries themselves come from sparky-stereo-grub-l10n.
# ROOT is the installed system's root (Calamares' ${ROOT}).
ROOT=${ROOT:-}
[ -n "$ROOT" ] && [ -d "$ROOT" ] || fail locale "ROOT=$ROOT"
[ -x "$ROOT/usr/sbin/update-grub" ] && [ -e "$ROOT/boot/grub/grub.cfg" ] || fail locale "$ROOT/usr/sbin/update-grub; $ROOT/boot/grub/grub.cfg"
lang=$(sed -n 's/^[[:space:]]*LANG=//p' "$ROOT/etc/default/locale") || fail locale "$ROOT/etc/default/locale"
lang=$(printf '%s\n' "$lang" | tr -d '\"'"'" | tail -n1) || fail locale "$ROOT/etc/default/locale"
[ -n "$lang" ] || fail locale "$ROOT/etc/default/locale: LANG"
checked chroot "$ROOT" env -u LANGUAGE -u LC_ALL -u LC_MESSAGES LANG="$lang" /usr/sbin/update-grub
