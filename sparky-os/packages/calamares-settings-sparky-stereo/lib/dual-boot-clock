# Runs in the installed system during installation (Calamares, shellprocess@dualbootclock).
# When os-prober finds Windows, the hardware clock is kept in local time, as Windows keeps it.
# ADJTIME and OS_PROBER can be set for tests.
ADJTIME=${ADJTIME:-/etc/adjtime}
OS_PROBER=${OS_PROBER:-os-prober}
$OS_PROBER 2>/dev/null | grep -qi ':windows:' || exit 0
printf '0.0 0 0.0\n0\nLOCAL\n' > "$ADJTIME"
[ "$ADJTIME" = /etc/adjtime ] && hwclock --systohc --localtime
exit 0
