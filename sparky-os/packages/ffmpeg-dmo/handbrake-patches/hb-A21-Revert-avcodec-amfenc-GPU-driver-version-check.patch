Description: [PATCH 21/22] Revert "avcodec/amfenc: GPU driver version check"
Author: Damiano Galassi
Origin: other, https://github.com/HandBrake/HandBrake/blob/1.11.2/contrib/ffmpeg/A21-Revert-avcodec-amfenc-GPU-driver-version-check.patch
Bug: https://github.com/HandBrake/HandBrake/commit/e34161a4c03ea448e033c9f2e50ba8131e182dca
Forwarded: not-needed
Comment: Backported to the edition FFmpeg 9.0.2; preserve public enum values.

--- a/libavcodec/amfenc.c
+++ b/libavcodec/amfenc.c
@@ -120,10 +120,6 @@
     else
         pix_fmt = avctx->pix_fmt;
 
-    if (pix_fmt == AV_PIX_FMT_P010) {
-        AMF_RETURN_IF_FALSE(ctx, amf_device_ctx->version >= AMF_MAKE_FULL_VERSION(1, 4, 32, 0), AVERROR_UNKNOWN, "10-bit encoder is not supported by AMD GPU drivers versions lower than 23.30.\n");
-    }
-
     ctx->format = av_av_to_amf_format(pix_fmt);
     AMF_RETURN_IF_FALSE(ctx, ctx->format != AMF_SURFACE_UNKNOWN, AVERROR(EINVAL),
                         "Format %s is not supported\n", av_get_pix_fmt_name(pix_fmt));
