Description: [PATCH 05/22] avformat/mov: add support audio fallback track ref
Author: John Stebbins
Origin: other, https://github.com/HandBrake/HandBrake/blob/1.11.2/contrib/ffmpeg/A05-avformat-mov-add-support-audio-fallback-track-ref.patch
Bug: https://github.com/HandBrake/HandBrake/commit/d9869798a86094e5eaa8b6454bae1093f67e1058
Forwarded: not-needed
Comment: Backported to the edition FFmpeg 9.0.2; preserve public enum values.

--- a/libavformat/isom.h
+++ b/libavformat/isom.h
@@ -287,6 +287,9 @@
         MOVEncryptionIndex *encryption_index;
     } cenc;
 
+    int has_fallback;   // Audio fallback track
+    int fallback;
+
     struct IAMFDemuxContext *iamf;
     int iamf_stream_offset;
 } MOVStreamContext;
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -10098,6 +10098,22 @@
     av_free(atoms);
 
     return ret;
+}
+
+static int mov_read_fall(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    AVStream *st;
+    MOVStreamContext *sc;
+
+    if (c->fc->nb_streams < 1)
+        return 0;
+    st = c->fc->streams[c->fc->nb_streams-1];
+    sc = st->priv_data;
+
+    sc->fallback = avio_rb32(pb);
+    sc->has_fallback = 1;
+
+    return 0;
 }
 
 static const MOVParseTableEntry mov_default_parse_table[] = {
@@ -10203,6 +10219,7 @@
 { MKTAG('v','p','c','C'), mov_read_vpcc },
 { MKTAG('m','d','c','v'), mov_read_mdcv },
 { MKTAG('c','l','l','i'), mov_read_clli },
+{ MKTAG('f','a','l','l'), mov_read_fall },
 { MKTAG('d','v','c','C'), mov_read_dvcc_dvvc },
 { MKTAG('d','v','v','C'), mov_read_dvcc_dvvc },
 { MKTAG('d','v','w','C'), mov_read_dvcc_dvvc },
@@ -11815,6 +11832,23 @@
             err = ff_replaygain_export(st, s->metadata);
             if (err < 0)
                 return err;
+            if (sc->has_fallback) {
+                for (j = 0; j < s->nb_streams; j++) {
+                    if (s->streams[j]->id == sc->fallback) {
+                        AVPacketSideData *sd;
+                        int *fallback;
+                        sd = av_packet_side_data_new(&st->codecpar->coded_side_data,
+                                    &st->codecpar->nb_coded_side_data,
+                                    AV_PKT_DATA_FALLBACK_TRACK,
+                                    sizeof(int), 0);
+                        if (!sd)
+                            return AVERROR(ENOMEM);
+                        fallback = (int*)sd->data;
+                        *fallback = j;
+                        break;
+                    }
+                }
+            }
             break;
         case AVMEDIA_TYPE_VIDEO:
             if (sc->display_matrix) {
