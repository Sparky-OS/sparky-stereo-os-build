# New people start with Daniel's BleachBit preset through /etc/skel (ORDER 415b); every account tool copies it, and an
# existing person's bleachbit.ini is never written.
sparky-stereo-housekeeping: package-contains-file-in-etc-skel [etc/skel/.config/]
sparky-stereo-housekeeping: package-contains-file-in-etc-skel [etc/skel/.config/bleachbit/]
sparky-stereo-housekeeping: package-contains-file-in-etc-skel [etc/skel/.config/bleachbit/bleachbit.ini]
