# The tests need a running Plasma session, so the package build leaves them out.
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF

# upstream's user unit has no [Install] section (its WantedBy was dropped to break a dependency cycle);
# sparky-stereo-vram-boost decides at every boot whether the session starts it
override_dh_installsystemduser:
	dh_installsystemduser --no-enable
