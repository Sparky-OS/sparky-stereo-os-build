<?xml version="1.0" encoding="UTF-8"?>
<!--
  Types of 3D model, point cloud and splat files that shared-mime-info does not have yet (checked against its master on
  2026-11-17: PLY, splat, SPZ, PTS, FBX, COLLADA, OFF and Draco have no type; glTF, OBJ, STL, 3MF, IGES have one).
  STEP and BREP are in shared-mime-info's master but not in the release Debian testing ships, so their definitions are
  carried as they are there (STEP: Bastien Nocera, merge request 208; BREP: shared-mime-info's data/freedesktop.org.xml.in).
  The names carry no vendor's name; the names F3D uses in its own thumbnailer and desktop files are aliases, so F3D's
  files keep matching. COLLADA's own registered name is model/vnd.collada+xml (IANA).
  SPDX-License-Identifier: GPL-2.0-or-later
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="model/x-ply">
    <comment>PLY polygon model or point cloud</comment>
    <comment xml:lang="pl">Model wielokątowy PLY lub chmura punktów PLY</comment>
    <comment xml:lang="pt_BR">Modelo poligonal ou nuvem de pontos PLY</comment>
    <comment xml:lang="fr">Modèle polygonal PLY ou nuage de points PLY</comment>
    <comment xml:lang="de">PLY-Polygonmodell oder Punktwolke</comment>
    <comment xml:lang="es">Modelo poligonal o nube de puntos PLY</comment>
    <comment xml:lang="ja">PLY ポリゴンモデルまたは点群</comment>
    <comment xml:lang="ko">PLY 다각형 모델 또는 점군</comment>
    <comment xml:lang="zh_CN">PLY 多边形模型或点云</comment>
    <comment xml:lang="zh_TW">PLY 多邊形模型或點雲</comment>
    <acronym>PLY</acronym>
    <expanded-acronym>Polygon File Format</expanded-acronym>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.ply"/>
    <magic priority="60">
      <match type="string" value="ply\n" offset="0"/>
      <match type="string" value="ply\r\n" offset="0"/>
    </magic>
    <glob pattern="*.ply"/>
  </mime-type>

  <mime-type type="model/x-gaussian-splat">
    <comment>Gaussian splat scene</comment>
    <comment xml:lang="pl">Scena ze splatami Gaussa</comment>
    <comment xml:lang="pt_BR">Cena de splats gaussianos</comment>
    <comment xml:lang="fr">Scène de splats gaussiens</comment>
    <comment xml:lang="de">Szene mit Gauß-Splats</comment>
    <comment xml:lang="es">Escena de splats gaussianos</comment>
    <comment xml:lang="ja">ガウススプラットシーン</comment>
    <comment xml:lang="ko">가우시안 스플랫 장면</comment>
    <comment xml:lang="zh_CN">高斯泼溅场景</comment>
    <comment xml:lang="zh_TW">高斯潑濺場景</comment>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.splat"/>
    <glob pattern="*.splat"/>
  </mime-type>

  <mime-type type="model/x-spz">
    <comment>Compressed Gaussian splat scene (SPZ)</comment>
    <comment xml:lang="pl">Skompresowana scena ze splatami Gaussa (SPZ)</comment>
    <comment xml:lang="pt_BR">Cena compactada de splats gaussianos (SPZ)</comment>
    <comment xml:lang="fr">Scène compressée de splats gaussiens (SPZ)</comment>
    <comment xml:lang="de">Komprimierte Szene mit Gauß-Splats (SPZ)</comment>
    <comment xml:lang="es">Escena comprimida de splats gaussianos (SPZ)</comment>
    <comment xml:lang="ja">圧縮ガウススプラットシーン (SPZ)</comment>
    <comment xml:lang="ko">압축된 가우시안 스플랫 장면 (SPZ)</comment>
    <comment xml:lang="zh_CN">压缩高斯泼溅场景（SPZ）</comment>
    <comment xml:lang="zh_TW">壓縮高斯潑濺場景（SPZ）</comment>
    <acronym>SPZ</acronym>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.spz"/>
    <glob pattern="*.spz"/>
  </mime-type>

  <mime-type type="model/x-pts">
    <comment>PTS point cloud</comment>
    <comment xml:lang="pl">Chmura punktów PTS</comment>
    <comment xml:lang="pt_BR">Nuvem de pontos PTS</comment>
    <comment xml:lang="fr">Nuage de points PTS</comment>
    <comment xml:lang="de">PTS-Punktwolke</comment>
    <comment xml:lang="es">Nube de puntos PTS</comment>
    <comment xml:lang="ja">PTS 点群</comment>
    <comment xml:lang="ko">PTS 점군</comment>
    <comment xml:lang="zh_CN">PTS 点云</comment>
    <comment xml:lang="zh_TW">PTS 點雲</comment>
    <acronym>PTS</acronym>
    <sub-class-of type="text/plain"/>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.pts"/>
    <glob pattern="*.pts"/>
  </mime-type>

  <mime-type type="model/x-fbx">
    <comment>FBX 3D scene</comment>
    <comment xml:lang="pl">Scena 3D FBX</comment>
    <comment xml:lang="pt_BR">Cena 3D FBX</comment>
    <comment xml:lang="fr">Scène 3D FBX</comment>
    <comment xml:lang="de">FBX-3D-Szene</comment>
    <comment xml:lang="es">Escena 3D FBX</comment>
    <comment xml:lang="ja">FBX 3D シーン</comment>
    <comment xml:lang="ko">FBX 3D 장면</comment>
    <comment xml:lang="zh_CN">FBX 三维场景</comment>
    <comment xml:lang="zh_TW">FBX 3D 場景</comment>
    <acronym>FBX</acronym>
    <expanded-acronym>Filmbox</expanded-acronym>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.fbx"/>
    <magic priority="60">
      <match type="string" value="Kaydara FBX Binary" offset="0"/>
    </magic>
    <glob pattern="*.fbx"/>
  </mime-type>

  <mime-type type="model/vnd.collada+xml">
    <comment>COLLADA 3D scene</comment>
    <comment xml:lang="pl">Scena 3D COLLADA</comment>
    <comment xml:lang="pt_BR">Cena 3D COLLADA</comment>
    <comment xml:lang="fr">Scène 3D COLLADA</comment>
    <comment xml:lang="de">COLLADA-3D-Szene</comment>
    <comment xml:lang="es">Escena 3D COLLADA</comment>
    <comment xml:lang="ja">COLLADA 3D シーン</comment>
    <comment xml:lang="ko">COLLADA 3D 장면</comment>
    <comment xml:lang="zh_CN">COLLADA 三维场景</comment>
    <comment xml:lang="zh_TW">COLLADA 3D 場景</comment>
    <acronym>COLLADA</acronym>
    <sub-class-of type="application/xml"/>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.dae"/>
    <glob pattern="*.dae"/>
  </mime-type>

  <mime-type type="model/x-off">
    <comment>OFF 3D model</comment>
    <comment xml:lang="pl">Model 3D OFF</comment>
    <comment xml:lang="pt_BR">Modelo 3D OFF</comment>
    <comment xml:lang="fr">Modèle 3D OFF</comment>
    <comment xml:lang="de">OFF-3D-Modell</comment>
    <comment xml:lang="es">Modelo 3D OFF</comment>
    <comment xml:lang="ja">OFF 3D モデル</comment>
    <comment xml:lang="ko">OFF 3D 모델</comment>
    <comment xml:lang="zh_CN">OFF 三维模型</comment>
    <comment xml:lang="zh_TW">OFF 3D 模型</comment>
    <acronym>OFF</acronym>
    <expanded-acronym>Object File Format</expanded-acronym>
    <sub-class-of type="text/plain"/>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.off"/>
    <glob pattern="*.off"/>
  </mime-type>

  <mime-type type="model/x-draco">
    <comment>Draco compressed mesh</comment>
    <comment xml:lang="pl">Skompresowana siatka Draco</comment>
    <comment xml:lang="pt_BR">Malha compactada com Draco</comment>
    <comment xml:lang="fr">Maillage compressé avec Draco</comment>
    <comment xml:lang="de">Mit Draco komprimiertes Netz</comment>
    <comment xml:lang="es">Malla comprimida con Draco</comment>
    <comment xml:lang="ja">Draco 圧縮メッシュ</comment>
    <comment xml:lang="ko">Draco 압축 메시</comment>
    <comment xml:lang="zh_CN">Draco 压缩网格</comment>
    <comment xml:lang="zh_TW">Draco 壓縮網格</comment>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.drc"/>
    <magic>
      <match type="string" value="DRACO" offset="0"/>
    </magic>
    <glob pattern="*.drc"/>
  </mime-type>

  <mime-type type="model/step">
    <comment>STEP 3D model</comment>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.step"/>
    <glob pattern="*.step"/>
    <glob pattern="*.stp"/>
    <magic>
      <match type="string" value="ISO-10303-21;" offset="0"/>
    </magic>
  </mime-type>

  <mime-type type="model/x-brep">
    <comment>BREP 3D model</comment>
    <acronym>BREP</acronym>
    <expanded-acronym>Boundary REPresentation</expanded-acronym>
    <sub-class-of type="text/plain"/>
    <generic-icon name="image-x-generic"/>
    <alias type="application/vnd.brep"/>
    <glob pattern="*.brep"/>
    <magic>
      <match type="string" value="DBRep_DrawableShape" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
