msgid "%1 could not be started. Is PipeWire installed?"
msgstr "%1 n’a pas pu démarrer. PipeWire est-il installé ?"

msgid "%1 did not answer. PipeWire may not be running in this session."
msgstr "%1 n’a pas répondu. PipeWire n’est peut-être pas lancé dans cette session."

msgid "%1 does not accept this value. The camera keeps its earlier setting."
msgstr "%1 n’accepte pas cette valeur. La caméra garde son réglage précédent."

msgid "%1 does not allow this change now. Another setting of the camera may have to change first."
msgstr "%1 n’autorise pas ce changement pour le moment. Il faut peut-être d’abord modifier un autre réglage de la caméra."

msgid "%1 failed: %2"
msgstr "%1 a échoué : %2"

msgid "%1 has no control called %2."
msgstr "%1 n’a pas de réglage nommé %2."

msgid "%1 is not a V4L2 camera, so its controls are not available here."
msgstr "%1 n’est pas une caméra V4L2 : ses réglages ne sont pas disponibles ici."

msgid "%1 is not connected any more. Plug it in again."
msgstr "%1 n’est plus connectée. Rebranchez-la."

msgid "%1 is not one of the packings. See: sparky-stereo-camera packing %2 list"
msgstr "%1 ne fait pas partie des agencements. Voir : sparky-stereo-camera packing %2 list"

msgid "%1 refused the change (%2)."
msgstr "%1 a refusé le changement (%2)."

msgid "%1 × %2"
msgstr "%1 × %2"

msgid "%1 × %2 to %3 × %4"
msgstr "%1 × %2 à %3 × %4"

msgid "%1: the camera no longer lists the control %2."
msgstr "%1 : la caméra n’indique plus le réglage %2."

msgid "%1: the saved size and format were not applied. "
msgstr "%1 : la taille et le format enregistrés n’ont pas été appliqués. "

msgid "%1: the saved value of %2 was not applied. "
msgstr "%1 : la valeur enregistrée de %2 n’a pas été appliquée. "

msgctxt "V4L2_PIX_FMT_Y16"
msgid "16-bit Greyscale"
msgstr "Niveaux de gris 16 bits"

msgid "3D Input Format:"
msgstr "Format d’entrée 3D :"

msgctxt "V4L2_CID_POWER_LINE_FREQUENCY_50HZ"
msgid "50 Hz"
msgstr "50 Hz"

