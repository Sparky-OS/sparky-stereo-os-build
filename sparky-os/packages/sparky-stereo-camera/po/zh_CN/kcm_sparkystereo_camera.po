msgid "%1 could not be started. Is PipeWire installed?"
msgstr "无法启动 %1。是否已安装 PipeWire？"

msgid "%1 did not answer. PipeWire may not be running in this session."
msgstr "%1 没有响应。此会话中的 PipeWire 可能没有运行。"

msgid "%1 does not accept this value. The camera keeps its earlier setting."
msgstr "%1 不接受此值，摄像头保持原有设置。"

msgid "%1 does not allow this change now. Another setting of the camera may have to change first."
msgstr "%1 目前不允许此更改，可能需要先更改摄像头的另一项设置。"

msgid "%1 failed: %2"
msgstr "%1 失败：%2"

msgid "%1 has no control called %2."
msgstr "%1 没有名为 %2 的调节项。"

msgid "%1 is not a V4L2 camera, so its controls are not available here."
msgstr "%1 不是 V4L2 摄像头，因此这里无法使用它的调节项。"

msgid "%1 is not connected any more. Plug it in again."
msgstr "%1 已断开连接，请重新插入。"

msgid "%1 is not one of the packings. See: sparky-stereo-camera packing %2 list"
msgstr "%1 不是可用的排列方式。请参阅：sparky-stereo-camera packing %2 list"

msgid "%1 lists no picture format. It may be starting up or going away: try again, or plug it in again."
msgstr "%1 没有提供任何画面格式。它可能正在启动或正在断开：请重试，或重新插入。"

msgid "%1 refused the change (%2)."
msgstr "%1 拒绝了此更改（%2）。"

msgid "%1 × %2"
msgstr "%1 × %2"

msgid "%1 × %2 to %3 × %4"
msgstr "%1 × %2 至 %3 × %4"

msgid "%1: the camera no longer lists the control %2."
msgstr "%1：摄像头不再提供调节项 %2。"

msgid "%1: the saved size and format were not applied. "
msgstr "%1：未能应用已保存的尺寸和格式。"

msgid "%1: the saved value of %2 was not applied. "
msgstr "%1：未能应用 %2 的已保存值。"

msgctxt "V4L2_PIX_FMT_Y16"
msgid "16-bit Greyscale"
msgstr "16 位灰度"

msgid "3D Input Format:"
msgstr "3D 输入格式："

msgctxt "V4L2_CID_POWER_LINE_FREQUENCY_50HZ"
msgid "50 Hz"
msgstr "50 Hz"

msgctxt "V4L2_CID_POWER_LINE_FREQUENCY_60HZ"
msgid "60 Hz"
msgstr "60 Hz"

msgctxt "V4L2_PIX_FMT_GREY"
msgid "8-bit Greyscale"
msgstr "8 位灰度"

msgid "A camera with two lenses sends both pictures in one. Say how it packs them, and the preview shows the pair in 3D. A camera with one lens stays \"Not 3D\"."
msgstr "双镜头摄像头会把两路画面合成一幅发送。指明合成方式后，预览会以 3D 显示这一对画面。单镜头摄像头保持“非 3D”。"

msgid "A camera you have not set starts at its largest picture and, at that size, its highest frame rate."
msgstr "未设置过的摄像头以最大的画面启动，并在该尺寸下使用最高的每秒帧数。"

msgid "Amber/blue"
msgstr "琥珀/蓝"

msgid "Another program is using %1, so it cannot change this now. Close that program and try again."
msgstr "另一个程序正在使用 %1，因此现在无法更改。请关闭该程序后重试。"

msgid "Another program is using this control now, so it cannot be changed here."
msgstr "另一个程序正在使用此调节项，因此无法在这里更改。"

