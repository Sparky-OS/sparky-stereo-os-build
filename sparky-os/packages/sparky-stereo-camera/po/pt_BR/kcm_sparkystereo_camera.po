msgid "%1 could not be started. Is PipeWire installed?"
msgstr "Não foi possível iniciar %1. O PipeWire está instalado?"

msgid "%1 did not answer. PipeWire may not be running in this session."
msgstr "%1 não respondeu. O PipeWire pode não estar em execução nesta sessão."

msgid "%1 does not accept this value. The camera keeps its earlier setting."
msgstr "%1 não aceita este valor. A câmera mantém a configuração anterior."

msgid "%1 does not allow this change now. Another setting of the camera may have to change first."
msgstr "%1 não permite esta alteração agora. Talvez seja preciso mudar antes outra configuração da câmera."

msgid "%1 failed: %2"
msgstr "%1 falhou: %2"

msgid "%1 has no control called %2."
msgstr "%1 não tem um controle chamado %2."

msgid "%1 is not a V4L2 camera, so its controls are not available here."
msgstr "%1 não é uma câmera V4L2, então seus controles não estão disponíveis aqui."

msgid "%1 is not connected any more. Plug it in again."
msgstr "%1 não está mais conectada. Conecte-a novamente."

msgid "%1 is not one of the packings. See: sparky-stereo-camera packing %2 list"
msgstr "%1 não é uma das disposições. Veja: sparky-stereo-camera packing %2 list"

msgid "%1 refused the change (%2)."
msgstr "%1 recusou a alteração (%2)."

msgid "%1 × %2"
msgstr "%1 × %2"

msgid "%1 × %2 to %3 × %4"
msgstr "%1 × %2 a %3 × %4"

msgid "%1: the camera no longer lists the control %2."
msgstr "%1: a câmera não lista mais o controle %2."

msgid "%1: the saved size and format were not applied. "
msgstr "%1: o tamanho e o formato salvos não foram aplicados. "

msgid "%1: the saved value of %2 was not applied. "
msgstr "%1: o valor salvo de %2 não foi aplicado. "

msgctxt "V4L2_PIX_FMT_Y16"
msgid "16-bit Greyscale"
msgstr "Escala de cinza de 16 bits"

msgid "3D Input Format:"
msgstr "Formato de entrada 3D:"

msgctxt "V4L2_CID_POWER_LINE_FREQUENCY_50HZ"
msgid "50 Hz"
msgstr "50 Hz"

msgctxt "V4L2_CID_POWER_LINE_FREQUENCY_60HZ"
