msgid "%1 could not be started. Is PipeWire installed?"
msgstr "%1 konnte nicht gestartet werden. Ist PipeWire installiert?"

msgid "%1 did not answer. PipeWire may not be running in this session."
msgstr "%1 hat nicht geantwortet. PipeWire läuft in dieser Sitzung möglicherweise nicht."

msgid "%1 does not accept this value. The camera keeps its earlier setting."
msgstr "%1 akzeptiert diesen Wert nicht. Die Kamera behält ihre bisherige Einstellung."

msgid "%1 does not allow this change now. Another setting of the camera may have to change first."
msgstr "%1 erlaubt diese Änderung jetzt nicht. Möglicherweise muss zuerst eine andere Einstellung der Kamera geändert werden."

msgid "%1 failed: %2"
msgstr "%1 ist fehlgeschlagen: %2"

msgid "%1 has no control called %2."
msgstr "%1 hat keinen Regler namens %2."

msgid "%1 is not a V4L2 camera, so its controls are not available here."
msgstr "%1 ist keine V4L2-Kamera, daher sind ihre Regler hier nicht verfügbar."

msgid "%1 is not connected any more. Plug it in again."
msgstr "%1 ist nicht mehr verbunden. Schließen Sie sie erneut an."

msgid "%1 is not one of the packings. See: sparky-stereo-camera packing %2 list"
msgstr "%1 gehört nicht zu den Anordnungen. Siehe: sparky-stereo-camera packing %2 list"

msgid "%1 lists no picture format. It may be starting up or going away: try again, or plug it in again."
msgstr "%1 nennt kein Bildformat. Die Kamera startet vielleicht gerade oder wird getrennt: Versuchen Sie es erneut oder schließen Sie sie erneut an."

msgid "%1 refused the change (%2)."
msgstr "%1 hat die Änderung abgelehnt (%2)."

msgid "%1 × %2"
msgstr "%1 × %2"

msgid "%1 × %2 to %3 × %4"
msgstr "%1 × %2 bis %3 × %4"

msgid "%1: the camera no longer lists the control %2."
msgstr "%1: Die Kamera führt den Regler %2 nicht mehr auf."

msgid "%1: the saved size and format were not applied. "
msgstr "%1: Die gespeicherte Größe und das Format wurden nicht angewendet. "

msgid "%1: the saved value of %2 was not applied. "
msgstr "%1: Der gespeicherte Wert von %2 wurde nicht angewendet. "

msgctxt "V4L2_PIX_FMT_Y16"
msgid "16-bit Greyscale"
msgstr "16-Bit-Graustufen"

