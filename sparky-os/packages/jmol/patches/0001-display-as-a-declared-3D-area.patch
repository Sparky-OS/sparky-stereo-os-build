+  // Sparky Stereo OS: the display as a declared 3D area (Stereo3D)
+
+  protected Stereo3D stereo3D;
+  private Boolean enable3D;
+  private boolean enable3DByHand;
+
+  /** Enable 3D, the person's one switch; on by default (PreferencesDialog's "enable3D"). */
+  public boolean isEnable3D() {
+    if (enable3D == null) {
+      PreferencesDialog p = jmolPanel.preferencesDialog;
+      enable3D = Boolean.valueOf(p == null
+          || Boolean.parseBoolean(p.currentProperties.getProperty("enable3D", "true")));
+    }
+    return enable3D.booleanValue();
+  }
+
+  /** The preset with 3D: stereo 5 (the left eye's picture on the left), no perspective depth (no vertical difference). */
+  protected void set3D(boolean on, boolean byHand) {
+    enable3D = Boolean.valueOf(on);
+    enable3DByHand |= byHand;
+    PreferencesDialog p = jmolPanel.preferencesDialog;
+    if (byHand && p != null) {
+      p.currentProperties.put("enable3D", String.valueOf(on));
+      p.save();
+    }
+    if (on) {
+      vwr.evalStringQuiet("stereo 5; set perspectiveDepth false");
+    } else {
+      String perspective = (p == null ? "true"
+          : p.currentProperties.getProperty("perspectiveDepth", "true"));
+      vwr.evalStringQuiet("stereo off; set perspectiveDepth " + perspective);
+    }
+    repaint();
+  }
+
+  private boolean preset3D;
+
+  /** Make or remove the 3D area: there is one while Enable 3D is on and Jmol draws its two pictures side by side. */
+  protected void update3D() {
+    if (!haveDisplay || !isShowing())
+      return;
+    if (!preset3D) {
+      preset3D = true;
+      if (isEnable3D()) {
+        set3D(true, false);
+        return;
+      }
+    }
+    boolean want = isEnable3D() && vwr.tm.isStereoDoubleFull();
+    if (want && stereo3D == null) {
+      try {
+        stereo3D = new Stereo3D(frame, this);
+      } catch (Stereo3D.Unavailable e) {
+        if ("not-x11".equals(e.kind))
+          Stereo3D.tell(this, "not-x11", Stereo3D.tr("flatNotX11"), e.getMessage());
+        else if (!"support".equals(e.kind) || e.support > 0 || enable3DByHand)
+          Stereo3D.tell(this, "no-area", Stereo3D.tr("flatNoArea"), e.getMessage());
+        else
+          System.err.println("Jmol 3D: " + e.getMessage());
+        set3D(false, false);
+      }
+    } else if (!want && stereo3D != null) {
+      stereo3D.close();
+      stereo3D = null;
+    }
+  }
+
+  /** Both pictures into the declared window, left eye first; the left eye's picture also in the panel itself. */
+  protected void paint3D(Graphics g) {
+    int w = dimSize.width, h = dimSize.height;
+    stereo3D.place(this);
+    BufferedImage pair = stereo3D.image(w, h);
+    Graphics pg = pair.getGraphics();
+    vwr.renderScreenImage(pg, 2 * w, h);
+    pg.dispose();
+    boolean rightFirst = vwr.tm.getStereoDegrees() < 0;
+    stereo3D.show(pair, rightFirst);
+    int left = rightFirst ? w : 0;
+    g.drawImage(pair, 0, 0, w, h, left, 0, left + w, h, null);
+  }
+
+  @Override
+  public void removeNotify() {
+    if (stereo3D != null) {
+      stereo3D.close();
+      stereo3D = null;
+    }
+    super.removeNotify();
+  }
