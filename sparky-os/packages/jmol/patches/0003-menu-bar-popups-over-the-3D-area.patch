+  /** Every menu bar inside container: its popup menus shown in windows of their own. */
+  private static void menuBarsIn(Container container) {
+    for (Component child : container.getComponents())
+      if (child instanceof JMenuBar)
+        ownWindows((JMenuBar) child);
+      else if (child instanceof Container)
+        menuBarsIn((Container) child);
+  }
+
+  /** Every popup menu under element (a menu bar, a menu, a popup) shown in a window of its own. */
+  private static void ownWindows(MenuElement element) {
+    if (element instanceof JPopupMenu)
+      ((JPopupMenu) element).setLightWeightPopupEnabled(false);
+    for (MenuElement child : element.getSubElements())
+      ownWindows(child);
+  }
