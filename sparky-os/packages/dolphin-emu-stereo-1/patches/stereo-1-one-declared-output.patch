+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+
+class QTimer;
+class QWidget;
+typedef struct _XDisplay Display;
+
+// The one 3D output: the render window holds both eyes side by side, declared as full side by side to a desktop
+// that takes it (Stereo KWin). With OpenGL the window is declared here; with Vulkan the swapchain has two image
+// layers and the graphics driver (Mesa) packs and declares them. When the desktop or the renderer cannot show
+// the pair, nothing is declared and the person is told.
+class StereoDeclare final : public QObject
+{
+  Q_OBJECT
+public:
+  explicit StereoDeclare(QWidget* render_widget);
+  ~StereoDeclare() override;
+
+private:
+  void Update();
+  void Remove();
+  void Tell(const QString& text);
+
+  QWidget* m_widget;
+  QTimer* m_timer;
+  Display* m_display = nullptr;
+  unsigned long m_window = 0;
+  unsigned long m_parent = 0;
+  unsigned int m_support = 0;
+  bool m_declared = false;
+  bool m_probed = false;
+  bool m_told = false;
+  unsigned int m_pushed_width = 0;
+  unsigned int m_pushed_height = 0;
+  int m_repushes = 0;
+};
