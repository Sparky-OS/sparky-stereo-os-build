diff --git a/Source/Core/DolphinQt/StereoDeclare.cpp b/Source/Core/DolphinQt/StereoDeclare.cpp
new file mode 100644
index 0000000..ab05eb5
--- /dev/null
+++ b/Source/Core/DolphinQt/StereoDeclare.cpp
@@ -0,0 +1,182 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "DolphinQt/StereoDeclare.h"
+
+#include <string>
+
+#include <QGuiApplication>
+#include <QMessageBox>
+#include <QTimer>
+#include <QWidget>
+
+#include <X11/Xlib.h>
+#include <stereo-declare.h>
+
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Config/MainSettings.h"
+#include "DolphinQt/Host.h"
+#include "VideoCommon/Present.h"
+#include "VideoCommon/StereoOutput.h"
+#include "VideoCommon/VideoConfig.h"
+
+StereoDeclare::StereoDeclare(QWidget* render_widget) : QObject(render_widget), m_widget(render_widget)
+{
+  m_timer = new QTimer(this);
+  connect(m_timer, &QTimer::timeout, this, &StereoDeclare::Update);
+  m_timer->start(50);
+}
+
+StereoDeclare::~StereoDeclare()
+{
+  Remove();
+  if (m_display)
+    XCloseDisplay(m_display);
+}
+
+void StereoDeclare::Remove()
+{
+  if (m_declared && m_display)
+  {
+    if (m_parent != 0)
+      stereo_remove_x11_child(m_display, m_parent, m_window);
+    else
+      stereo_remove_x11(m_display, m_window);
+    XFlush(m_display);
+  }
+  m_declared = false;
+  StereoOutput::SetSurfaceSize(0, 0);
+  m_pushed_width = 0;
+  m_pushed_height = 0;
+  m_repushes = 0;
+}
+
+void StereoDeclare::Tell(const QString& text)
+{
+  if (m_told)
+    return;
+  m_told = true;
+  auto* box = new QMessageBox(QMessageBox::Warning, tr("3D"), text, QMessageBox::Ok, m_widget->window());
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->open();
+}
+
+void StereoDeclare::Update()
+{
+  if (QGuiApplication::platformName() != QStringLiteral("xcb") || !m_widget->testAttribute(Qt::WA_WState_Created))
+    return;
+
+  const bool wanted = Config::Get(Config::GFX_STEREO_MODE) != StereoMode::Off;
+  if (!wanted)
+  {
+    Remove();
+    m_told = false;
+    return;
+  }
+
+  if (!m_display)
+  {
+    m_display = XOpenDisplay(nullptr);
+    if (!m_display)
+    {
+      StereoOutput::SetHost(StereoOutput::Host::NotOffered);
+      return;
+    }
+  }
+
+  if (!m_probed)
+  {
+    // Stereo KWin makes a declared top-level window two views wide from support version 3, and shows a declared
+    // child at the size of one view from version 8
+    m_probed = true;
+    m_support = stereo_supported_x11(m_display);
+    const unsigned int needed = m_widget->isWindow() ? 3 : 8;
+    if (m_support < needed)
+      StereoOutput::SetHost(StereoOutput::Host::NotOffered);
+  }
+  if (StereoOutput::GetHost() == StereoOutput::Host::NotOffered)
+  {
+    // 3D is on by default: a desktop that cannot take the pair shows 2D and says nothing, unless the person turned
+    // 3D on themselves
+    Remove();
+    if (Config::GetAsString(Config::GFX_STEREO_MODE.GetLocation()).has_value())
+      Tell(tr("3D needs a desktop that takes both eyes as a pair (Stereo KWin); showing 2D."));
+    return;
+  }
+
+  // The renderer cannot give two views: declare nothing, and say so
+  const std::string renderer = StereoOutput::GetRendererRefusal();
+  if (!renderer.empty())
+  {
+    Remove();
+    Tell(tr("3D is not available with this renderer (%1): it needs geometry shaders. Showing 2D.")
+             .arg(QString::fromStdString(renderer)));
+    return;
+  }
+  if (StereoOutput::GetSwapChainRefusal())
+  {
+    Remove();
+    Tell(tr("3D is not available: the Vulkan driver gives this window one view (its surface takes one image "
+            "layer). Showing 2D."));
+    return;
+  }
+
+  const unsigned long window = static_cast<unsigned long>(m_widget->winId());
+
+  // Vulkan: the swapchain has two image layers, and the graphics driver packs them into one picture and declares
+  // it, so the window is never declared or made wider here
+  if (Config::Get(Config::MAIN_GFX_BACKEND) == "Vulkan")
+  {
+    if (m_declared)
+      Remove();
+    m_window = window;
+    StereoOutput::SetHost(StereoOutput::Host::Declared);
+    return;
+  }
+
+  if (m_declared && window != m_window)
+    Remove();
+  if (!m_declared)
+  {
+    m_window = window;
+    m_parent = m_widget->isWindow() ? 0 : static_cast<unsigned long>(m_widget->window()->winId());
+    const int r = m_parent != 0 ? stereo_declare_x11_child(m_display, m_parent, m_window, STEREO_SBS_FULL,
+                                                           STEREO_CLASS_GAME, STEREO_GAME_3D,
+                                                           static_cast<unsigned>(m_widget->width()),
+                                                           static_cast<unsigned>(m_widget->height())) :
+                                  stereo_declare_x11(m_display, m_window, STEREO_SBS_FULL,
+                                                     STEREO_CLASS_GAME, STEREO_GAME_3D);
+    if (r != 0)
+    {
+      StereoOutput::SetHost(StereoOutput::Host::NotOffered);
+      return;
+    }
+    m_declared = true;
+    XFlush(m_display);
+    StereoOutput::SetHost(StereoOutput::Host::Declared);
+  }
+
+  // Stereo KWin makes a declared X11 window two views wide and then tells the program its own size, one view,
+  // in a second event that Qt takes as the window's size. The picture is as wide as the X window the server
+  // holds, so that is the size the video backend gets.
+  Window root;
+  int x;
+  int y;
+  unsigned int width;
+  unsigned int height;
+  unsigned int border;
+  unsigned int depth;
+  if (XGetGeometry(m_display, m_window, &root, &x, &y, &width, &height, &border, &depth) != 0 &&
+      (width != m_pushed_width || height != m_pushed_height ||
+       (m_repushes < 40 && g_presenter &&
+        (g_presenter->GetBackbufferWidth() != static_cast<int>(width) ||
+         g_presenter->GetBackbufferHeight() != static_cast<int>(height)))))
+  {
+    if (width == m_pushed_width && height == m_pushed_height)
+      m_repushes++;
+    StereoOutput::SetSurfaceSize(static_cast<int>(width), static_cast<int>(height));
+    m_pushed_width = width;
+    m_pushed_height = height;
+    Host::GetInstance()->ResizeSurface(static_cast<int>(width), static_cast<int>(height));
+  }
+}
