diff --git a/Source/Core/VideoCommon/StereoOutput.cpp b/Source/Core/VideoCommon/StereoOutput.cpp
new file mode 100644
index 0000000..8ff2442
--- /dev/null
+++ b/Source/Core/VideoCommon/StereoOutput.cpp
@@ -0,0 +1,70 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoCommon/StereoOutput.h"
+
+#include <atomic>
+#include <mutex>
+
+namespace StereoOutput
+{
+namespace
+{
+std::atomic<int> s_host{static_cast<int>(Host::Unknown)};
+std::atomic<int> s_surface_width{0};
+std::atomic<int> s_surface_height{0};
+std::mutex s_refusal_mutex;
+std::string s_renderer_refusal;
+std::atomic<bool> s_swapchain_refusal{false};
+}  // namespace
+
+void SetHost(Host host)
+{
+  s_host.store(static_cast<int>(host));
+}
+
+Host GetHost()
+{
+  return static_cast<Host>(s_host.load());
+}
+
+void SetSurfaceSize(int width, int height)
+{
+  s_surface_width.store(width);
+  s_surface_height.store(height);
+}
+
+bool GetSurfaceSize(int* width, int* height)
+{
+  *width = s_surface_width.load();
+  *height = s_surface_height.load();
+  return *width > 0 && *height > 0;
+}
+
+void SetRendererRefusal(const std::string& renderer)
+{
+  std::lock_guard lock(s_refusal_mutex);
+  s_renderer_refusal = renderer;
+}
+
+std::string GetRendererRefusal()
+{
+  std::lock_guard lock(s_refusal_mutex);
+  return s_renderer_refusal;
+}
+
+void SetSwapChainRefusal(bool refused)
+{
+  s_swapchain_refusal.store(refused);
+}
+
+bool GetSwapChainRefusal()
+{
+  return s_swapchain_refusal.load();
+}
+
+bool BackendRefuses()
+{
+  return !GetRendererRefusal().empty() || GetSwapChainRefusal();
+}
+}  // namespace StereoOutput
