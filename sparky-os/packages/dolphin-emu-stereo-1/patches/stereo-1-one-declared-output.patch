@@ -0,0 +1,37 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+// The one 3D output of this build: both eyes as separate complete pictures, side by side, left eye first, declared
+// to a desktop that takes such a pair (Stereo KWin). The separation and the convergence stay Dolphin's own settings
+// (Depth and Convergence); this only says whether the desktop and the renderer can show the pair, and why not.
+#include <string>
+
+namespace StereoOutput
+{
+enum class Host : int
+{
+  Unknown,     // the host has not said yet
+  NotOffered,  // the desktop cannot take a pair
+  Declared,    // the pair is declared (by the host program, or by the graphics driver)
+};
+
+// Called by the host program (any thread).
+void SetHost(Host host);
+Host GetHost();
+
+// The size of the window the host declared, as the X server holds it (two views wide); false when none is declared.
+void SetSurfaceSize(int width, int height);
+bool GetSurfaceSize(int* width, int* height);
+
+// The renderer that cannot draw two views (it has no geometry shaders), empty when it can; set by the video
+// configuration.
+void SetRendererRefusal(const std::string& renderer);
+std::string GetRendererRefusal();
+// The swapchain cannot hold two views (its surface takes one image layer); set by the video backend.
+void SetSwapChainRefusal(bool refused);
+bool GetSwapChainRefusal();
+// Either: the host then declares nothing and tells the person.
+bool BackendRefuses();
+}  // namespace StereoOutput
