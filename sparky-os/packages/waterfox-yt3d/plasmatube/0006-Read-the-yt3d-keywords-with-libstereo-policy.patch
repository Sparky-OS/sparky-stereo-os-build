 CMakeLists.txt                       |  4 ++
 src/CMakeLists.txt                   |  2 +-
 src/autotests/stereokeywordstest.cpp |  8 +++-
 src/utils/stereokeywords.cpp         | 72 ++++++++++------------------
 src/utils/stereokeywords.h           | 12 ++---
 5 files changed, 42 insertions(+), 56 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9fae69d..a98fdaa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -74,6 +74,10 @@ if(HAVE_MPVQT_VIDEO_LAYER)
     find_package(Qt6 ${QT_MIN_VERSION} REQUIRED NO_MODULE COMPONENTS ShaderTools)
 endif()
 
+# the edition's one reader of the yt3d keywords
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(STEREO_POLICY REQUIRED IMPORTED_TARGET stereo-policy>=1.13.0)
+
 find_package(Qt6Keychain)
 set_package_properties(Qt6Keychain PROPERTIES
         TYPE REQUIRED
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 62c483e..d276bc5 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -42,7 +42,7 @@ target_sources(plasmatube_static PRIVATE
         utils/stereokeywords.cpp
         utils/stereokeywords.h
 )
-target_link_libraries(plasmatube_static PRIVATE Qt::Core Qt::Qml)
+target_link_libraries(plasmatube_static PRIVATE Qt::Core Qt::Qml PkgConfig::STEREO_POLICY)
 
 add_executable(plasmatube)
