diff --git a/src/autotests/stereokeywordstest.cpp b/src/autotests/stereokeywordstest.cpp
index 6686cc8..379e6aa 100644
--- a/src/autotests/stereokeywordstest.cpp
+++ b/src/autotests/stereokeywordstest.cpp
@@ -23,10 +23,14 @@ private Q_SLOTS:
         QTest::newRow("rl") << QStringList{u"yt3d:enable=RL"_s} << u"sbs2r"_s;
         QTest::newRow("lonr") << QStringList{u"yt3d:enable=LonR"_s} << u"ab2l"_s;
         QTest::newRow("ronl") << QStringList{u"yt3d:enable=RonL"_s} << u"ab2r"_s;
-        QTest::newRow("true") << QStringList{u"yt3d:enable=true"_s} << u"sbs2l"_s;
+        QTest::newRow("true") << QStringList{u"yt3d:enable=true"_s} << u"sbs2r"_s;
         QTest::newRow("false") << QStringList{u"yt3d:enable=false"_s} << QString();
         QTest::newRow("case and space") << QStringList{u" YT3D:Enable=lr "_s} << u"sbs2l"_s;
-        QTest::newRow("swap") << QStringList{u"yt3d:enable=true"_s, u"yt3d:swap=true"_s} << u"sbs2r"_s;
+        QTest::newRow("swap") << QStringList{u"yt3d:enable=true"_s, u"yt3d:swap=true"_s} << u"sbs2l"_s;
+        QTest::newRow("swap of left first") << QStringList{u"yt3d:enable=LR"_s, u"yt3d:swap=true"_s} << u"sbs2r"_s;
+        QTest::newRow("3D Maestro") << QStringList{u"guitar"_s, u"yt3d:enable=true"_s, u"yt3d:aspect=16:9"_s, u"yt3d:swap=true"_s} << u"sbs2l"_s;
+        QTest::newRow("Kate in 3D! rectangles alone, one malformed") << QStringList{u"yt3d:right=0.5_0_1_1"_s, u"yt3d:left=0_0._0.5_1"_s} << u"sbs2l"_s;
+        QTest::newRow("Kate in 3D!") << QStringList{u"yt3d:enable=true"_s, u"yt3d:aspect=4:3"_s, u"yt3d:right=0.5_0_1_1"_s, u"yt3d:left=0_0._0.5_1"_s} << u"sbs2l"_s;
         QTest::newRow("swap first") << QStringList{u"yt3d:swap=true"_s, u"yt3d:enable=LonR"_s} << u"ab2r"_s;
         QTest::newRow("swap alone") << QStringList{u"yt3d:swap=true"_s} << QString();
         QTest::newRow("rectangles side by side") << QStringList{u"yt3d:left=0_0_0.5_1"_s, u"yt3d:right=0.5_0_1_1"_s} << u"sbs2l"_s;
diff --git a/src/utils/stereokeywords.cpp b/src/utils/stereokeywords.cpp
index 16345cc..7c6dbfa 100644
--- a/src/utils/stereokeywords.cpp
+++ b/src/utils/stereokeywords.cpp
@@ -3,60 +3,40 @@
 
 #include "stereokeywords.h"
 
+#include <stereo-policy.h>
+
+#include <QByteArray>
+#include <QList>
+
 using namespace Qt::StringLiterals;
 
 QString StereoKeywords::stereoInput(const QStringList &keywords)
 {
-    QString packing;
-    QString leftRect;
-    QString rightRect;
-    bool swap = false;
-
+    // The tags are read by libstereo-policy, the one reader of the edition's programs (the browser uses it too).
+    QList<QByteArray> utf8;
+    QList<const char *> tags;
+    utf8.reserve(keywords.size());
     for (const QString &keyword : keywords) {
-        const QString tag = keyword.trimmed().toLower();
-        if (tag.startsWith(u"yt3d:enable="_s)) {
-            const QString value = tag.mid(u"yt3d:enable="_s.size());
-            if (value == u"lr"_s || value == u"true"_s) {
-                packing = u"sbs2l"_s;
-            } else if (value == u"rl"_s) {
-                packing = u"sbs2r"_s;
-            } else if (value == u"lonr"_s) {
-                packing = u"ab2l"_s;
-            } else if (value == u"ronl"_s) {
-                packing = u"ab2r"_s;
-            }
-        } else if (tag == u"yt3d:swap=true"_s || tag == u"yt3d:swap"_s) {
-            swap = true;
-        } else if (tag.startsWith(u"yt3d:left="_s)) {
-            leftRect = tag.mid(u"yt3d:left="_s.size());
-        } else if (tag.startsWith(u"yt3d:right="_s)) {
-            rightRect = tag.mid(u"yt3d:right="_s.size());
-        }
+        utf8.append(keyword.toUtf8());
     }
-
-    // the first form, for sources that are not side by side parallel: where each eye is, as left, top, right and bottom
-    // fractions of the frame
-    if (packing.isEmpty()) {
-        const QString sideBySide = u"0_0_0.5_1"_s;
-        const QString sideBySideRight = u"0.5_0_1_1"_s;
-        const QString overUnder = u"0_0_1_0.5"_s;
-        const QString overUnderBottom = u"0_0.5_1_1"_s;
-
-        if (leftRect == sideBySide && rightRect == sideBySideRight) {
-            packing = u"sbs2l"_s;
-        } else if (leftRect == sideBySideRight && rightRect == sideBySide) {
-            packing = u"sbs2r"_s;
-        } else if (leftRect == overUnder && rightRect == overUnderBottom) {
-            packing = u"ab2l"_s;
-        } else if (leftRect == overUnderBottom && rightRect == overUnder) {
-            packing = u"ab2r"_s;
-        }
+    for (const QByteArray &tag : std::as_const(utf8)) {
+        tags.append(tag.constData());
     }
 
-    if (packing.isEmpty() || !swap) {
-        return packing;
+    int layout = STEREO_POLICY_LAYOUT_NONE;
+    int order = STEREO_POLICY_LEFT_FIRST;
+    if (stereo_policy_site_mark(tags.constData(), tags.size(), &layout, &order, nullptr, nullptr) != 1) {
+        return {};
     }
 
-    // the eyes are the other way round
-    return packing.endsWith(u'l') ? packing.chopped(1) + u'r' : packing.chopped(1) + u'l';
+    // mpv's names of the half size packings; mpv tells half from full size views by the shape of the frame
+    const bool rightFirst = order == STEREO_POLICY_RIGHT_FIRST;
+    switch (layout) {
+    case STEREO_POLICY_LAYOUT_SIDE_BY_SIDE:
+        return rightFirst ? u"sbs2r"_s : u"sbs2l"_s;
+    case STEREO_POLICY_LAYOUT_TOP_AND_BOTTOM:
+        return rightFirst ? u"ab2r"_s : u"ab2l"_s;
+    default: // the site says the video is not 3D
+        return {};
+    }
 }
diff --git a/src/utils/stereokeywords.h b/src/utils/stereokeywords.h
index 6fb8688..e1e81a0 100644
--- a/src/utils/stereokeywords.h
+++ b/src/utils/stereokeywords.h
@@ -13,13 +13,11 @@ namespace StereoKeywords
  * The 3D packing that a video's keywords declare, as the name mpv gives it (the values of its stereo-in
  * parameter), or an empty string when they declare none.
  *
- * YouTube took these tags for 3D uploads: yt3d:enable=LR (left eye on the left, right eye on the right),
- * RL, LonR (left eye on top) and RonL, and in the first form yt3d:enable=true (the same as LR) with
- * yt3d:swap=true to exchange the eyes, and in the first form yt3d:left and yt3d:right, the rectangle of each eye, which
- * are taken for the usual halves (left=0_0_0.5_1 right=0.5_0_1_1, and left=0_0_1_0.5 right=0_0.5_1_1 for top and bottom). Invidious and Piped hand the video's keywords on as they are.
- * The names are those of the half size packings; mpv tells half from full size views by what the stream says and the
- * shape of the frame. A video that has neither a mark nor such keywords is left to mpv, which takes it for side by side
- * by its shape (three times as wide as high) through the players' shared rule.
+ * YouTube took these tags for 3D uploads (yt3d:enable=LR, RL, LonR, RonL, true, false, yt3d:swap, yt3d:aspect and the
+ * rectangles yt3d:left and yt3d:right); Invidious and Piped hand the video's keywords on as they are. The tags are read by
+ * libstereo-policy's site mark reader, which the edition's browser uses too (docs/yt3d.md in stereo-layer lists every form):
+ * the first form, yt3d:enable=true, is right eye first and yt3d:swap=true makes it left eye first.
+ * The names are those of the half size packings; mpv tells half from full size views by the shape of the frame.
  */
 QString stereoInput(const QStringList &keywords);
 
