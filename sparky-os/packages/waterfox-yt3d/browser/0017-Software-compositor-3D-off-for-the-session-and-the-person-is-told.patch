+    // Sparky Stereo OS: a software compositor cannot hand a page's two views
+    // to the desktop; 3D is then off for the session and the person is told.
+    try {
+      ChromeUtils.importESModule(
+        "resource:///actors/StereoNoticeParent.sys.mjs"
+      ).StereoSoftwareCompositor.check(window);
+    } catch (e) {
+      console.error(e);
+    }
+
     this._handleURIToLoad();
 
