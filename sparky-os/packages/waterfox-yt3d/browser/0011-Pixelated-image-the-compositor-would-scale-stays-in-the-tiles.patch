Description: An image with image-rendering: pixelated that the compositor would scale stays in the tiles (ORDER 482)
 A canvas, video or image styled image-rendering: pixelated was promoted to a Wayland compositor surface without an
 external image, and WebRender locked it for direct compositing with no GL context (Bug 1959975's path), so it was drawn
 from texture 0: a black canvas, a green video. Wayland also has no request for a sampling filter, so such a surface could
 never be scaled nearest-neighbour. CompositorCapabilities gains supports_sampling_filter (false for the Wayland native
 compositor); a pixelated image that is scaled on its way to the screen is not promoted and WebRender draws it in the tiles
 with GL_NEAREST.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Forwarded: not-needed
Assisted-by: Claude Sonnet 5.5 via Claude Code
---
diff --git a/gfx/webrender_bindings/RenderCompositorNative.cpp b/gfx/webrender_bindings/RenderCompositorNative.cpp
index 84043efb98..a71b42e092 100644
--- a/gfx/webrender_bindings/RenderCompositorNative.cpp
+++ b/gfx/webrender_bindings/RenderCompositorNative.cpp
@@ -134,6 +134,9 @@ void RenderCompositorNative::GetCompositorCapabilities(
 #if defined(MOZ_WAYLAND)
   // NativeLayerWaylandRender shows a tile drawn once per eye as two views.
   aCaps->supports_stereo_tiles = !!mNativeLayerRoot->AsNativeLayerRootWayland();
+  // NativeLayerWayland keeps the sampling filter a surface asks for, but
+  // Wayland has no request for it: the compositor scales with its own filter.
+  aCaps->supports_sampling_filter = !mNativeLayerRoot->AsNativeLayerRootWayland();
 #endif
 }
 
diff --git a/gfx/wr/webrender/src/composite.rs b/gfx/wr/webrender/src/composite.rs
index 79e34d6387..e355d987d2 100644
--- a/gfx/wr/webrender/src/composite.rs
+++ b/gfx/wr/webrender/src/composite.rs
@@ -1191,12 +1191,15 @@ impl CompositeState {
                 tile: None,
             };
 
+            // The image is locked for direct compositing only when it is attached
+            // to the surface as an external image. One WebRender draws into the
+            // surface itself (image-rendering other than auto) needs the texture.
             let cache_item = resolve_image(
                 request,
                 resource_cache,
                 gpu_buffer,
                 deferred_resolves,
-                true,
+                external_surface.external_image_id.is_some(),
             );
 
             if cache_item.texture_id != TextureSource::Invalid {
@@ -1424,6 +1427,9 @@ pub struct CompositorCapabilities {
     /// Whether the compositor shows a tile WebRender draws once per eye
     /// (Compositor::set_tile_stereo) as two views, left eye first.
     pub supports_stereo_tiles: bool,
+    /// Whether the compositor applies the sampling filter (nearest or linear)
+    /// a surface asks for when it scales the surface.
+    pub supports_sampling_filter: bool,
 }
 
 impl Default for CompositorCapabilities {
@@ -1441,6 +1447,7 @@ impl Default for CompositorCapabilities {
             supports_surface_for_backdrop: false,
             supports_external_compositor_surface_negative_scaling: true,
             supports_stereo_tiles: false,
+            supports_sampling_filter: true,
         }
     }
 }
diff --git a/gfx/wr/webrender/src/tile_cache/mod.rs b/gfx/wr/webrender/src/tile_cache/mod.rs
index 94c01b346e..d021cb9b0d 100644
--- a/gfx/wr/webrender/src/tile_cache/mod.rs
+++ b/gfx/wr/webrender/src/tile_cache/mod.rs
@@ -1874,6 +1874,20 @@ impl TileCacheInstance {
         let local_to_raster = ScaleOffset::identity();
         let raster_to_device = normalized_prim_to_device;
 
+        // A native compositor that scales a surface itself cannot always be told
+        // to sample it nearest (Wayland has no such request): a scaled image
+        // that asks for pixelated sampling stays in the tiles, where WebRender
+        // draws it with the filter it asked for.
+        if image_rendering == ImageRendering::Pixelated {
+            if let CompositorKind::Native { capabilities, .. } = composite_state.compositor_kind {
+                if !capabilities.supports_sampling_filter
+                    && ((raster_to_device.scale.x - 1.0).abs() > 0.001
+                        || (raster_to_device.scale.y - 1.0).abs() > 0.001) {
+                    return Err(SamplingFilterUnsupported);
+                }
+            }
+        }
+
         // If this primitive is an external image, and supports being used
         // directly by a native compositor, then lookup the external image id
         // so we can pass that through.
@@ -3361,6 +3375,7 @@ enum SurfacePromotionFailure {
     SliceAtomic,
     SizeTooLarge,
     Translucent,
+    SamplingFilterUnsupported,
 }
 
 impl Display for SurfacePromotionFailure {
@@ -3380,6 +3395,7 @@ impl Display for SurfacePromotionFailure {
                 SurfacePromotionFailure::NotRootTileCache => "is not on a root tile cache",
                 SurfacePromotionFailure::ComplexTransform => "has a complex transform",
                 SurfacePromotionFailure::Translucent => "is drawn with an opacity",
+                SurfacePromotionFailure::SamplingFilterUnsupported => "is scaled with a sampling filter the compositor cannot apply",
                 SurfacePromotionFailure::SliceAtomic => "slice is atomic",
                 SurfacePromotionFailure::SizeTooLarge => "surface is too large for compositor",
             }.to_owned()
