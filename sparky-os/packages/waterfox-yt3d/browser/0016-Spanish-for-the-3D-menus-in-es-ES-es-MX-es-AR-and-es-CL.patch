Description: Spanish for every string of the edition's 3D menus, in the four Spanish locales (ORDER 473u round 3b)
 The 3D Video menu, the 3D Canvas menu, the Display Configuration item (KDE's own Spanish name), the Exit control and its hint,
 and the two notices, in es-ES, es-MX, es-AR and es-CL, which carry the same Spanish text so that every Spanish locale gets it:
 waterfox/browser/locales/LOCALE/browser/browser/browserContext.ftl.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Forwarded: not-needed
Assisted-by: Claude Sonnet 5.5 via Claude Code
---
diff -ruN a/waterfox/browser/locales/es-ES/browser/browser/browserContext.ftl b/waterfox/browser/locales/es-ES/browser/browser/browserContext.ftl
--- a/waterfox/browser/locales/es-ES/browser/browser/browserContext.ftl	2026-11-10 19:39:09.643237130 -0300
+++ b/waterfox/browser/locales/es-ES/browser/browser/browserContext.ftl	2026-11-10 19:39:09.690482856 -0300
@@ -211,6 +211,51 @@
     .label = Repetir
     .accesskey = R
 
+main-context-menu-video-stereo =
+    .label = Vídeo 3D
+    .accesskey = 3
+
+main-context-menu-video-stereo-auto =
+    .label = Automático
+
+main-context-menu-video-stereo-mono =
+    .label = No 3D
+
+main-context-menu-video-stereo-side-by-side =
+    .label = Lado a lado
+
+main-context-menu-video-stereo-side-by-side-right-first =
+    .label = Lado a lado, ojo derecho primero
+
+main-context-menu-video-stereo-top-bottom =
+    .label = Arriba y abajo
+
+main-context-menu-video-stereo-top-bottom-right-first =
+    .label = Arriba y abajo, ojo derecho primero
+
+main-context-menu-video-stereo-swap =
+    .label = Intercambiar ojos
+
+main-context-menu-canvas-stereo =
+    .label = Lienzo 3D
+    .accesskey = 3
+
+main-context-menu-canvas-stereo-off =
+    .label = Desactivado
+
+main-context-menu-canvas-stereo-on =
+    .label = Activado
+
+main-context-menu-stereo-display-settings =
+    .label = Configuración de la pantalla
+
+stereo-canvas-no-limits = La escena 3D de esta página sigue plana: el escritorio no informa al navegador de tus límites de profundidad (falta Stereo KWin).
+stereo-display-settings-failed = No se pudo abrir la configuración de la pantalla de KDE: no se encontró systemsettings o no se inició.
+
+stereo-xr-exit = Salir de 3D
+stereo-xr-hint-flat = Esc sale de 3D. Arrastra con el ratón para mirar; W, A, S, D o las flechas y la rueda te mueven.
+stereo-xr-mode-tv = TV o salida plana
+
 ## The access keys for "Show Controls" and "Hide Controls" are the same
 ## because the two context-menu items are mutually exclusive.
 
