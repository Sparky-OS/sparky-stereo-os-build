+  float nearest = 0, farthest = 0;
+  const bool read =
+      mStereoSceneFB
+          ? ReadSceneRangeFromFB(mStereoSceneFB, mStereoSceneSize,
+                                 mStereoSceneDepthStencil,
+                                 mStereoLastCamera->depthA,
+                                 mStereoLastCamera->depthNumerator, &nearest,
+                                 &farthest)
+          : ReadSceneRange(*mDefaultFB, mStereoLastCamera->depthA,
+                           mStereoLastCamera->depthNumerator, &nearest,
+                           &farthest);
+  if (!read) {
+    MOZ_LOG(gWebGLStereoLog, LogLevel::Debug,
+            ("scene plane: no scene in the depth buffer (%s)",
+             mStereoSceneFB ? "the page's framebuffer" : "the canvas"));
+    if (mStereoReadError) {
+      char reason[96];
+      SprintfLiteral(reason, "reading it failed with GL error 0x%x",
+                     mStereoReadError);
+      SaySceneUnreadable(reason);
+    } else if (++mStereoSceneMisses >= 4) {
+      SaySceneUnreadable(
+          "it holds no scene, only the far plane, in the first frames "
+          "looked at");
+    }
+    return;
+  }
+  mStereoSceneMisses = 0;
+  mSceneNearest = nearest;
+  mSceneFarthest = farthest;
+  float plane = 2.0f * nearest * farthest / (nearest + farthest);
+  bool limited = false;
+  if (mStereoPoppedPx > 0.0f && mStereoSeparation > 0.0f) {
+    // The parallax of a point at distance z is separation * (plane / z - 1)
+    // of the canvas's width. With the separation from the limits that is
+    // share * sunk * (plane / z - 1) in the output's pixels, so the popped
+    // limit allows the plane up to nearest * (1 + popped / (share * sunk)),
+    // whatever the canvas's width; with a fixed separation the view is taken
+    // as 1920 wide.
+    const float reach =
+        mStereoLimitShare > 0.0f && mStereoSunkPx > 0.0f
+            ? nearest * (1.0f + mStereoPoppedPx /
+                                    (mStereoLimitShare * mStereoSunkPx))
+            : nearest *
+                  (1.0f + mStereoPoppedPx / (1920.0f * mStereoSeparation));
+    if (plane > reach) {
+      plane = reach;
+      limited = true;
+    }
+  }
+  const float before = mStereoPlane;
+  if (before <= 0.0f) {
+    mStereoPlane = plane;
+  } else if (std::fabs(plane / before - 1.0f) > 0.15f) {
+    mStereoPlane = before + 0.5f * (plane - before);
+  }
+  MOZ_LOG(gWebGLStereoLog, LogLevel::Info,
+          ("scene plane: nearest %.3f farthest %.3f -> %.3f%s, in use %.3f "
+           "(was %.3f)",
+           nearest, farthest, plane, limited ? " (popped limit)" : "",
+           mStereoPlane, before));
+}
