@@ -0,0 +1,17 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Sparky Stereo OS: a 3D scene (the camera hack) that stays flat because the
+// desktop does not tell the browser the person's depth limits is said to the
+// person in the browser's own notification bar. The browser itself tells the
+// document (the chrome-only event MozStereoCanvasNoLimits, once for the
+// canvas; a page cannot send it); the parent actor shows the bar.
+
+export class StereoNoticeChild extends JSWindowActorChild {
+  handleEvent(event) {
+    if (event.type == "MozStereoCanvasNoLimits") {
+      this.sendAsyncMessage("StereoNotice:NoLimits");
+    }
+  }
+}
diff --git a/browser/actors/StereoNoticeParent.sys.mjs b/browser/actors/StereoNoticeParent.sys.mjs
new file mode 100644
index 0000000000..604a84e7b9
--- /dev/null
+++ b/browser/actors/StereoNoticeParent.sys.mjs
@@ -0,0 +1,28 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+export class StereoNoticeParent extends JSWindowActorParent {
+  receiveMessage(message) {
+    if (message.name != "StereoNotice:NoLimits") {
+      return;
+    }
+    const browser = this.browsingContext.top.embedderElement;
+    const win = browser?.ownerGlobal;
+    if (!win?.gBrowser) {
+      return;
+    }
+    const box = win.gBrowser.getNotificationBox(browser);
+    if (box.getNotificationWithValue("stereo-canvas-no-limits")) {
+      return;
+    }
+    box.appendNotification(
+      "stereo-canvas-no-limits",
+      {
+        label: { "l10n-id": "stereo-canvas-no-limits" },
+        priority: box.PRIORITY_INFO_MEDIUM,
+      },
+      []
+    );
+  }
+}
