+  static void Publish(int32_t aSunk100, int32_t aPopped100,
+                      int32_t aOutputWidth) {
+    if (aSunk100 > 0) {
+      sSunk100 = aSunk100;
+      sPopped100 = aPopped100;
+      sOutputWidth = aOutputWidth;
+    }
+  }
+};
