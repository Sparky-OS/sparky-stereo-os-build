     # 64-bit prefix, and only wine32 can open a 32-bit one
     local winebin=$prefixwinebin
 
-    echo "    [1/2] Creating registry override for $dll_name"
-    echo -n "        "
+    local target="$unix_dlls_path/$dll_name.dll"
+    local backup="$target.old"
+    local temporary
+    temporary=$(mktemp "$target.XXXXXXXX")
+    if ! cp --reflink=auto --preserve=mode -- "$build_path/$dll_name.dll.so" "$temporary"; then
+        rm -f -- "$temporary"
+        return 1
+    fi
+
+    # Keep the original for uninstall, including when it was a symlink.
+    if [[ ! -e "$backup" && ! -L "$backup" ]]; then
+        if ! cp -a -- "$target" "$backup"; then
+            rm -f -- "$temporary"
+            return 1
+        fi
+    fi
+    if ! mv -fT -- "$temporary" "$target"; then
+        rm -f -- "$temporary"
+        return 1
+    fi
+
+    echo "    Installed native override for $dll_name"
     "$winebin" reg add 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v "$dll_name" /d native /f
