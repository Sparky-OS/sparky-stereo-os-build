             continue;
+        }
 
-        nearest = std::min( nearest, value );
-        farthest = std::max( farthest, value );
+        nearest = std::min( nearest, distance );
+        farthest = std::max( farthest, distance );
     }
 
+    m_opaqueDepth.clear();
+    m_translucentMean.clear();
+
     if( nearest > farthest )
         return;
 
-    m_depthNearest = m_camera.GetDistanceFromDepth( nearest );
-    m_depthFarthest = m_camera.GetDistanceFromDepth( farthest );
+    m_depthNearest = nearest;
+    m_depthFarthest = farthest;
     m_depthRangeValid = true;
