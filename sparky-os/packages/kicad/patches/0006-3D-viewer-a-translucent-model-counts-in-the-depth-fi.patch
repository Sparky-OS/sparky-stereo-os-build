     glPixelStorei( GL_PACK_ALIGNMENT, 4 );
     glReadPixels( 0, 0, width, height, GL_DEPTH_COMPONENT, GL_FLOAT, depth.data() );
 
-    float nearest = 1.0f;
-    float farthest = 0.0f;
+    const bool translucent = m_translucentMean.size() == depth.size()
+                             && m_opaqueDepth.size() == depth.size();
+
+    if( m_depthFboBound )
+    {
+        glBindFramebuffer( GL_FRAMEBUFFER, 0 );
+        m_depthFboBound = false;
+    }
+
+    float nearest = std::numeric_limits<float>::max();
+    float farthest = std::numeric_limits<float>::lowest();
 
-    for( float value : depth )
+    for( size_t i = 0; i < depth.size(); ++i )
     {
-        if( value >= 1.0f )
+        float distance;
+
+        // What was drawn after the translucent models (the grid) shows at its own depth; under
+        // translucent models a pixel's distance is the mean of what it shows, each weighted by
+        // its share of the pixel's colour
+        if( translucent && depth[i] == m_opaqueDepth[i] )
+        {
+            if( std::isnan( m_translucentMean[i] ) )
+                continue;
+
+            distance = m_translucentMean[i];
+        }
+        else if( depth[i] < 1.0f )
+        {
+            distance = m_camera.GetDistanceFromDepth( depth[i] );
+        }
+        else
