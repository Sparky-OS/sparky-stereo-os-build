+#ifndef EDA_3D_STEREO_H
+#define EDA_3D_STEREO_H
+
+/**
+ * The person's depth limits for the stereo 3D view, as the desktop gives them.
+ *
+ * Stereo KWin keeps one pair of limits for each screen, set in its 3D Depth settings: how far
+ * behind the screen and how far in front of it anything may appear.  libstereo-declare hands them
+ * to the window of the 3D view in the pixels of its own picture; the view never scales them.
+ */
+namespace EDA_3D_STEREO
+{
+enum class LIMITS
+{
+    DELIVERED,     ///< the limits are in aSunk and aPopped
+    NOT_OFFERED,   ///< the desktop offers no depth limits
+    NOT_DELIVERED, ///< offered, not delivered to this window yet
+    NOT_READABLE   ///< no window to read them from
+};
+
+/// The X11 window of a GL drawable and its display.
+struct WINDOW
+{
+    void*         display = nullptr;
+    unsigned long window = 0;
+};
+
+/// The window the GL context current on this thread draws to: the one the desktop sees declared.
+WINDOW CurrentWindow();
+
+/**
+ * Read the depth limits of \a aWindow in pixels of a picture \a aBufferWidth pixels wide shown
+ * at that width.  The values are left untouched unless the limits are delivered.
+ */
+LIMITS ReadDepthLimits( const WINDOW& aWindow, double aBufferWidth, double& aSunk, double& aPopped );
+}
+
+#endif // EDA_3D_STEREO_H
