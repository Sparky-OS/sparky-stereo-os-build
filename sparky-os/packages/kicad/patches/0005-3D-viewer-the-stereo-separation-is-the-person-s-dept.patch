+#include <GL/glx.h>
+#include <stereo-declare.h>
+
+
+EDA_3D_STEREO::WINDOW EDA_3D_STEREO::CurrentWindow()
+{
+    // GLX makes the X11 window itself current (wxGLCanvas), so the drawable is the window
+    WINDOW result;
+    result.display = glXGetCurrentDisplay();
+    result.window = static_cast<unsigned long>( glXGetCurrentDrawable() );
+    return result;
+}
+
+
+EDA_3D_STEREO::LIMITS EDA_3D_STEREO::ReadDepthLimits( const WINDOW& aWindow, double aBufferWidth,
+                                                      double& aSunk, double& aPopped )
+{
+    if( !aWindow.display || !aWindow.window || aBufferWidth <= 0.0 )
+        return LIMITS::NOT_READABLE;
+
+    stereo_depth_limits limits;
+    const int           result =
+            stereo_depth_x11_get_buffer_limits( static_cast<Display*>( aWindow.display ),
+                                                static_cast<Window>( aWindow.window ), aBufferWidth,
+                                                aBufferWidth, &limits );
+
+    if( result == 0 )
+    {
+        aSunk = limits.sunk;
+        aPopped = limits.popped;
+        return LIMITS::DELIVERED;
+    }
+
+    if( result == -ENODATA )
+        return LIMITS::NOT_DELIVERED;
+
+    if( result == -ENOTSUP )
+        return LIMITS::NOT_OFFERED;
+
+    return LIMITS::NOT_READABLE;
+}
