+void EDA_3D_CANVAS::OnTimerTimeout_StereoLimits( wxTimerEvent& aEvent )
+{
+    if( aEvent.GetId() != m_stereo_limits_timer.GetId() )
+    {
+        aEvent.Skip();
+        return;
+    }
+
+    // The person can change their limits, or move the window to another screen, at any time
+    double                      sunk = m_stereoSunk;
+    double                      popped = m_stereoPopped;
+    const EDA_3D_STEREO::LIMITS limits = EDA_3D_STEREO::ReadDepthLimits( m_stereoWindow,
+                                                                         m_stereoWidth, sunk,
+                                                                         popped );
+
+    // Redraw when they changed, and once more when they have not come after two seconds, so the
+    // person is told
+    const bool waited = limits == EDA_3D_STEREO::LIMITS::NOT_DELIVERED && !m_stereoTold
+                        && GetRunningMicroSecs() - m_stereoSince > 2000000;
+
+    if( limits != m_stereoLimits || sunk != m_stereoSunk || popped != m_stereoPopped || waited )
+        Request_refresh( true );
+}
