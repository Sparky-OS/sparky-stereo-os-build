     m_selectionColorSwatch->SetSupportsOpacity( false );
+
+    m_checkBoxStereo->Bind( wxEVT_CHECKBOX, &PANEL_3D_OPENGL_OPTIONS::onEnable3D, this );
+    m_buttonDisplaySettings->Bind( wxEVT_BUTTON, &PANEL_3D_OPENGL_OPTIONS::onDisplaySettings, this );
+}
+
+
+void PANEL_3D_OPENGL_OPTIONS::onEnable3D( wxCommandEvent& aEvent )
+{
+    // A screen in a 3D mode offers the 3D viewer a stereo visual; on any other screen the view
+    // stays one picture without a word, unless the person turns 3D on themselves
+    if( !m_checkBoxStereo->GetValue() )
+        return;
+
+    wxGLAttributes stereoAttributes;
+    stereoAttributes.PlatformDefaults().RGBA().DoubleBuffer().Depth( 16 ).Stereo().EndList();
+
+    if( !wxGLCanvas::IsDisplaySupported( stereoAttributes ) )
+    {
+        DisplayInfoMessage( this, _( "This screen offers no quad buffer, so the 3D viewer stays 2D. "
+                                     "Stereo KWin offers one only on a screen in a 3D mode." ) );
+    }
+}
+
+
+void PANEL_3D_OPENGL_OPTIONS::onDisplaySettings( wxCommandEvent& aEvent )
+{
+    // Display Settings choose each screen's 3D mode, its output format and its eye order
+    if( wxExecute( wxS( "systemsettings kcm_kscreen" ), wxEXEC_ASYNC ) > 0 )
+        return;
+
+    if( wxExecute( wxS( "kcmshell6 kcm_kscreen" ), wxEXEC_ASYNC ) > 0 )
+        return;
+
+    DisplayErrorMessage( this, _( "Display Settings could not be opened." ) );
 }
 
 
