+void RENDER_3D_OPENGL::captureDepthRange()
+{
+    m_captureDepthRange = false;
+    m_depthRangeValid = false;
+
+    const int width = m_windowSize.x;
+    const int height = m_windowSize.y;
+
+    if( width <= 0 || height <= 0 )
+        return;
+
+    // The background is drawn without the depth test, so every pixel still at the cleared depth
+    // is background; any other pixel shows the scene
+    std::vector<float> depth( static_cast<size_t>( width ) * height );
+
+    glPixelStorei( GL_PACK_ALIGNMENT, 4 );
+    glReadPixels( 0, 0, width, height, GL_DEPTH_COMPONENT, GL_FLOAT, depth.data() );
+
+    float nearest = 1.0f;
+    float farthest = 0.0f;
+
+    for( float value : depth )
+    {
+        if( value >= 1.0f )
+            continue;
+
+        nearest = std::min( nearest, value );
+        farthest = std::max( farthest, value );
+    }
+
+    if( nearest > farthest )
+        return;
+
+    m_depthNearest = m_camera.GetDistanceFromDepth( nearest );
+    m_depthFarthest = m_camera.GetDistanceFromDepth( farthest );
+    m_depthRangeValid = true;
+}
