   static int
   draw(ClientData clientData, Tcl_Interp *interp, int objc, Tcl_Obj *const *objv)
   {
@@ -2035,16 +2146,34 @@ namespace netgen
       {
         // Stereo: one world, two cameras.  The view of each eye is the
         // projection moved sideways by half the eye separation and sheared
-        // back so both views meet at the centre of the scene, which sits
-        // at the distance of the camera (see CalcTransformationMatrices).
-        constexpr double distance = 6.0;
-        constexpr double half_separation = 0.03 * distance;
+        // back so both views meet at the point the camera looks at, which
+        // stands at the screen.  The separation is fitted to the person's
+        // depth limits (Stereo3DFit).
+        const double distance = stereo3d::look_distance;
 
         GLdouble mono[16];
         glMatrixMode(GL_PROJECTION);
         glGetDoublev(GL_PROJECTION_MATRIX, mono);
         VisualScene::mono_projection = mono;
 
+        GLint viewport[4];
+        glGetIntegerv(GL_VIEWPORT, viewport);
+
+        double sunk = 0, popped = 0, separation = 0;
+        stereo3d::state = Stereo3DReadLimits(viewport[2], sunk, popped);
+        stereo3d::sunk = sunk;
+        stereo3d::popped = popped;
+        if (stereo3d::state == Stereo3DLimits::ok)
+          {
+            // measure: the whole view from the camera between the eyes
+            glDrawBuffer(GL_BACK_LEFT);
+            glMatrixMode(GL_MODELVIEW);
+            visual_scene->DrawScene();
+            separation = Stereo3DFit(mono, viewport, sunk, popped);
+            glMatrixMode(GL_PROJECTION);
+          }
+        const double half_separation = 0.5 * separation * distance;
+
         for (int eye = 0; eye < 2; eye++)
           {
             double shift = (eye == 0) ? -half_separation : half_separation;
@@ -2059,6 +2188,7 @@ namespace netgen
             glMatrixMode(GL_PROJECTION);
           }
 
+        glDrawBuffer(GL_BACK);
         glLoadMatrixd(mono);
         glMatrixMode(GL_MODELVIEW);
         VisualScene::mono_projection = nullptr;
@@ -3167,6 +3297,8 @@ void PlayAnimFile(const char* name, int speed, int maxcnt)
 	Tcl_CreateObjCommand(interp, "zap", zap, NULL, NULL);
 	Tcl_CreateObjCommand(interp, "draw", draw, NULL, NULL);
 	Tcl_CreateObjCommand(interp, "reshape", reshape, NULL, NULL);
+	Tcl_CreateObjCommand(interp, "Ng_Stereo3DPoll", Ng_Stereo3DPoll, NULL, NULL);
+	Tcl_CreateObjCommand(interp, "Ng_Stereo3DVisual", Ng_Stereo3DVisual, NULL, NULL);
 	
 	//   Togl_TimerFunc(  idle );
 	Tcl_CreateObjCommand(interp, "Ng_SnapShot", Ng_SnapShot, NULL, NULL);
