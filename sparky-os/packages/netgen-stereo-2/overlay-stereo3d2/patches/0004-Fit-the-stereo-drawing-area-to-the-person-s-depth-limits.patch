diff --git a/ng/stereo3d.cpp b/ng/stereo3d.cpp
new file mode 100644
index 0000000..20b19bc
--- /dev/null
+++ b/ng/stereo3d.cpp
@@ -0,0 +1,47 @@
+// Sparky Stereo OS: the person's depth limits for the drawing area and the stereo visual, read through Xlib, GLX and
+// libstereo-declare.  Kept in a file of its own: Xlib's headers define names (Status, Bool, None) that clash with
+// Netgen's own.
+
+#include <cerrno>
+#include <GL/glx.h>
+#include <stereo-declare.h>
+
+#include "stereo3d.hpp"
+
+namespace netgen
+{
+  Stereo3DLimits Stereo3DReadLimits (double width, double & sunk, double & popped)
+  {
+    Display * display = glXGetCurrentDisplay ();
+    GLXDrawable drawable = glXGetCurrentDrawable ();
+    if (!display || !drawable || width <= 0)
+      return Stereo3DLimits::unreadable;
+
+    struct stereo_depth_limits limits;
+    int r = stereo_depth_x11_get_buffer_limits (display, drawable, width, width, &limits);
+    if (r == -ENOTSUP)
+      return Stereo3DLimits::not_offered;
+    if (r == -ENODATA)
+      return Stereo3DLimits::not_delivered;
+    if (r != 0)
+      return Stereo3DLimits::unreadable;
+
+    sunk = limits.sunk;
+    popped = limits.popped;
+    return Stereo3DLimits::ok;
+  }
+
+  bool Stereo3DVisualAvailable (void * xdisplay)
+  {
+    Display * display = static_cast<Display *> (xdisplay);
+    if (!display)
+      return false;
+
+    int attributes[] = { GLX_RGBA, GLX_DOUBLEBUFFER, GLX_DEPTH_SIZE, 1, GLX_STEREO, None };
+    XVisualInfo * info = glXChooseVisual (display, DefaultScreen (display), attributes);
+    if (!info)
+      return false;
+    XFree (info);
+    return true;
+  }
+}
diff --git a/ng/stereo3d.hpp b/ng/stereo3d.hpp
new file mode 100644
index 0000000..7f66fc4
--- /dev/null
+++ b/ng/stereo3d.hpp
@@ -0,0 +1,19 @@
+#ifndef NG_STEREO3D_HPP
+#define NG_STEREO3D_HPP
+
+// Sparky Stereo OS: what the drawing area needs from the desktop to be drawn as a stereo pair.
+
+namespace netgen
+{
+  enum class Stereo3DLimits { ok, not_offered, not_delivered, unreadable };
+
+  // The person's depth limits for the drawing area, in the pixels of its own buffer (width pixels wide and shown at
+  // that width), read through libstereo-declare on the GL drawable that is current: Togl's window, which the
+  // edition's Mesa declares as the window's 3D area.
+  Stereo3DLimits Stereo3DReadLimits (double width, double & sunk, double & popped);
+
+  // Whether the X display (an Xlib Display *) offers a double-buffered stereo visual with a depth buffer.
+  bool Stereo3DVisualAvailable (void * xdisplay);
+}
+
+#endif
