index 21ca1b0..3a06110 100644
--- a/ng/ngpkg.cpp
+++ b/ng/ngpkg.cpp
@@ -30,6 +30,7 @@ The interface between the GUI and the netgen library
 #include <togl.h>
 
 #include "fonts.hpp"
+#include "stereo3d.hpp"
 
 extern bool nodisplay;
 
@@ -2023,6 +2024,116 @@ namespace netgen
   }
 
 
+  // Enable 3D (Sparky Stereo OS): the scene from two parallel cameras,
+  // fitted to the person's depth limits.
+  namespace stereo3d
+  {
+    // the camera looks at the centre of the scene from 6 units
+    // (gluLookAt in VisualScene::CalcTransformationMatrices): the plane
+    // where both eyes meet, at the screen
+    constexpr double look_distance = 6.0;
+    Stereo3DLimits state = Stereo3DLimits::not_delivered;
+    double sunk = 0, popped = 0;
+    bool depth_readable = true;
+    const bool trace = getenv("NETGEN_STEREO3D_TRACE") != nullptr;
+  }
+
+  // The separation, as a fraction of the distance looked at, under which
+  // every pixel of the drawing area stays inside the limits: the nearest
+  // pixel at most `popped` pixels in front of the screen, the farthest at
+  // most `sunk` behind it.  The depth is the one of the view just drawn from
+  // the camera between the eyes; the cleared depth is the background.
+  static double Stereo3DFit (const GLdouble * projection, const GLint * viewport,
+                             double sunk, double popped)
+  {
+    const int w = viewport[2], h = viewport[3];
+    if (w <= 0 || h <= 0)
+      return 0;
+
+    std::vector<float> depth(size_t(w) * size_t(h));
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; i++)
+      ;
+    glReadBuffer(GL_BACK_LEFT);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(viewport[0], viewport[1], w, h, GL_DEPTH_COMPONENT, GL_FLOAT, depth.data());
+    stereo3d::depth_readable = glGetError() == GL_NO_ERROR;
+    if (!stereo3d::depth_readable)
+      return 0;
+
+    float dmin = 1, dmax = 0;
+    for (float d : depth)
+      if (d < 1.0f)
+        {
+          dmin = min2(dmin, d);
+          dmax = max2(dmax, d);
+        }
+
+    // window depth to distance from the camera, by the projection drawn with
+    auto distance = [projection] (double d)
+      { return projection[14] / ((2 * d - 1) + projection[10]); };
+    const double C = stereo3d::look_distance;
+    const double k = 0.5 * w * projection[0];
+    double dnear = 0, dfar = 0;
+    double t = HUGE_VAL;
+    if (dmin <= dmax)
+      {
+        dnear = distance(dmin);
+        dfar = distance(dmax);
+        if (dnear < C)
+          t = min2(t, popped / (k * (C / dnear - 1)));
+        if (dfar > C)
+          t = min2(t, sunk / (k * (1 - C / dfar)));
+      }
+    if (t == HUGE_VAL)
+      t = sunk / k;   // nothing off the plane looked at: infinity at the sunk limit
+
+    if (stereo3d::trace)
+      fprintf(stderr, "netgen stereo3d: limits sunk %g popped %g view %dx%d k %.6f C %g "
+              "near %.6f far %.6f separation %.8f predicted near %.4f far %.4f\n",
+              sunk, popped, w, h, k, C, dnear, dfar, t,
+              dmin <= dmax ? k * t * (1 - C / dnear) : 0.0,
+              dmin <= dmax ? k * t * (1 - C / dfar) : 0.0);
+    return t;
+  }
+
+  // Tcl: Ng_Stereo3DPoll -- the drawing area's state of the limits (ok,
+  // notoffered, notdelivered, unreadable, depthunreadable, or mono for a
+  // drawing area without two eyes); asks for a new frame when the limits
+  // changed since the last one was drawn.
+  static int
+  Ng_Stereo3DPoll(ClientData clientData, Tcl_Interp *interp, int objc, Tcl_Obj *const *objv)
+  {
+    if (!togl || Togl_NumEyes(togl) != 2)
+      {
+        Tcl_SetResult(interp, (char*)"mono", TCL_STATIC);
+        return TCL_OK;
+      }
+    Togl_MakeCurrent(togl);
+    GLint viewport[4];
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    double sunk = 0, popped = 0;
+    Stereo3DLimits state = Stereo3DReadLimits(viewport[2], sunk, popped);
+    if (state != stereo3d::state || sunk != stereo3d::sunk || popped != stereo3d::popped)
+      Togl_PostRedisplay(togl);
+    const char * answer =
+      state == Stereo3DLimits::not_offered ? "notoffered" :
+      state == Stereo3DLimits::not_delivered ? "notdelivered" :
+      state == Stereo3DLimits::unreadable ? "unreadable" :
+      !stereo3d::depth_readable ? "depthunreadable" : "ok";
+    Tcl_SetResult(interp, (char*)answer, TCL_STATIC);
+    return TCL_OK;
+  }
+
+  // Tcl: Ng_Stereo3DVisual -- whether this display offers a stereo visual
+  static int
+  Ng_Stereo3DVisual(ClientData clientData, Tcl_Interp *interp, int objc, Tcl_Obj *const *objv)
+  {
+    Tk_Window main = Tk_MainWindow(interp);
+    bool available = main && Stereo3DVisualAvailable(Tk_Display(main));
+    Tcl_SetObjResult(interp, Tcl_NewBooleanObj(available));
+    return TCL_OK;
+  }
