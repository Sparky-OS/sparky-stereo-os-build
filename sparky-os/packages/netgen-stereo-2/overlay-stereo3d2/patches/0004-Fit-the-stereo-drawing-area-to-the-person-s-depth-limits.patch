+
+proc stereo3d_save { } {
+    global optfilename
+    set lines {}
+    if { [file exists $optfilename] } {
+        if { [catch {
+            set datei [open $optfilename r]
+            while { [gets $datei line] >= 0 } {
+                if { [catch { lindex $line 0 } first] || $first != "stereo3d.enable" } {
+                    lappend lines $line
+                }
+            }
+            close $datei
+        }] } {
+            tk_messageBox -icon warning -type ok -title Netgen -message [stereo3d_mc "The 3D choice could not be saved."]
+            return
+        }
+    }
+    lappend lines "stereo3d.enable  [set ::stereo3d.enable]"
+    if { [catch {
+        set datei [open $optfilename w]
+        foreach line $lines { puts $datei $line }
+        close $datei
+    }] } {
+        tk_messageBox -icon warning -type ok -title Netgen -message [stereo3d_mc "The 3D choice could not be saved."]
+    }
+}
+
+proc stereo3d_toggled { } {
+    stereo3d_save
+    if { [set ::stereo3d.enable] == 1 && [set ::stereo3d.drawing] != "native" && ![Ng_Stereo3DVisual] } {
+        tk_messageBox -icon info -type ok -title Netgen -message [stereo3d_mc "This desktop offers no stereo buffers, so the 3D view stays 2D."]
+    }
+}
+
+proc stereo3d_display_settings { } {
+    if { [catch { exec systemsettings kcm_kscreen & }] && [catch { exec kcmshell6 kcm_kscreen & }] } {
+        tk_messageBox -icon warning -type ok -title Netgen -message [stereo3d_mc "Display Settings could not be opened."]
+    }
+}
+
+proc stereo3d_tell { key } {
+    switch -- $key {
+        notoffered { set message [stereo3d_mc "3D depth: this desktop offers no depth limits, so both eyes show the same picture"] }
+        notdelivered { set message [stereo3d_mc "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"] }
+        unreadable { set message [stereo3d_mc "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"] }
+        depthunreadable { set message [stereo3d_mc "3D depth: the depth of this view could not be read, so both eyes show the same picture"] }
+        nostereobuffers { set message [stereo3d_mc "3D: this view got no stereo buffers, so it is shown in 2D"] }
+        default { set message "" }
+    }
+    if { $message == "" } {
+        if { [set ::stereo3d.status] != "" } {
+            set ::stereo3d.status ""
+            catch { pack forget .statbar.stereo3d }
+        }
+        return
+    }
+    if { [lsearch -exact [set ::stereo3d.told] $key] >= 0 } { return }
+    lappend ::stereo3d.told $key
+    puts stderr $message
+    set ::stereo3d.status $message
+    catch {
+        if { ![winfo exists .statbar.stereo3d] } {
+            ttk::label .statbar.stereo3d -textvariable stereo3d.status
+        }
+        pack .statbar.stereo3d -side right -ipady 3p -padx 3p
+    }
+}
+
+proc stereo3d_poll { } {
+    set state [Ng_Stereo3DPoll]
+    if { $state == "mono" } { return }
+    incr ::stereo3d.polls
+    switch -- $state {
+        ok { stereo3d_tell clear }
+        notdelivered { if { [set ::stereo3d.polls] > 8 } { stereo3d_tell notdelivered } }
+        default { stereo3d_tell $state }
+    }
+    after 250 stereo3d_poll
+}
