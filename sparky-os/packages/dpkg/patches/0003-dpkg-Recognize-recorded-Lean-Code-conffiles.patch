diff --git a/src/main/archives.c b/src/main/archives.c
index f94c5ba..137585d 100644
--- a/src/main/archives.c
+++ b/src/main/archives.c
@@ -38,6 +38,10 @@
 #include <stdlib.h>
 #include <stdio.h>
 #include <sha2.h>
+#include <md5.h>
+#ifdef WITH_LIBLZMA
+#include <lzma.h>
+#endif
 #include <obstack.h>
 #define obstack_chunk_alloc m_malloc
 #define obstack_chunk_free free
@@ -472,7 +476,7 @@ leancode_index_load(const char *filename, enum leancode_index_type type)
 		if (strcmp(index->filename, filename) == 0)
