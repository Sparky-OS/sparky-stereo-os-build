   if [ "$md5sum" != "$old_md5sum" ]; then
@@ -222,7 +222,7 @@ prepare_mv_conffile()
   ensure_package_owns_file "$PACKAGE" "$CONFFILE" || return 0
 
   local md5sum old_md5sum
-  md5sum="$(md5sum "$DPKG_ROOT$CONFFILE" | sed -e 's/ .*//')"
