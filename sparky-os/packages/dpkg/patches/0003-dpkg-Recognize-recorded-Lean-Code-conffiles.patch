 		return NULL;
 	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode)) {
@@ -548,6 +552,159 @@ leancode_sha256_is(const char *filename, const char *hash)
 	return strcmp(digest, hash) == 0;
 }
 
+/*
+ * Bind the recorded SHA-256 original to dpkg's own Conffiles MD5.
+ * A record's md5_orig alone cannot establish that binding.
+ */
+static bool
+leancode_original_matches(const char *original, const char *expected)
+{
+#ifdef WITH_LIBLZMA
+	lzma_stream stream = LZMA_STREAM_INIT;
+	lzma_ret rc;
+	MD5_CTX md5;
+	SHA2_CTX sha256;
+	char md5sum[MD5_DIGEST_STRING_LENGTH];
+	char sha256sum[SHA256_DIGEST_STRING_LENGTH];
+	unsigned char input[32768], output[32768];
+	char *dir, *filename;
+	struct stat st;
+	int fd;
+	FILE *file;
+
+	dir = dpkg_fsys_get_path("/var/lib/dpkg-stereo/pristine");
+	filename = str_fmt("%s/%s.xz", dir, original);
+	free(dir);
+	fd = open(filename, O_RDONLY | O_NONBLOCK);
+	free(filename);
+	if (fd < 0)
+		return false;
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode)) {
+		close(fd);
+		return false;
+	}
+	file = fdopen(fd, "r");
+	if (file == NULL) {
+		close(fd);
+		return false;
+	}
+
+	rc = lzma_stream_decoder(&stream, UINT64_MAX, LZMA_CONCATENATED);
+	MD5Init(&md5);
+	SHA256Init(&sha256);
+	while (rc == LZMA_OK) {
+		size_t size;
+
+		if (stream.avail_in == 0 && !feof(file)) {
+			stream.next_in = input;
+			stream.avail_in = fread(input, 1, sizeof(input), file);
+			if (ferror(file))
+				break;
+		}
+		stream.next_out = output;
+		stream.avail_out = sizeof(output);
+		rc = lzma_code(&stream, feof(file) ? LZMA_FINISH : LZMA_RUN);
+		size = sizeof(output) - stream.avail_out;
+		MD5Update(&md5, output, size);
+		SHA256Update(&sha256, output, size);
+	}
+	lzma_end(&stream);
+	fclose(file);
+	if (rc != LZMA_STREAM_END)
+		return false;
+	MD5End(&md5, md5sum);
+	SHA256End(&sha256, sha256sum);
+	return strcmp(md5sum, expected) == 0 && strcmp(sha256sum, original) == 0;
+#else
+	return false;
+#endif
+}
+
+static bool
+leancode_conffile_projection(struct pkginfo *pkg, const char *fn,
+                             const char *name, const char *expected)
+{
+	const struct conffile *conff;
+	const struct leancode_entry *record;
+	struct leancode_index *index;
+	char *dir, *filename;
+	size_t pos;
+
+	if (name[0] != '/' || !leancode_is_hash(expected, MD5HASHLEN))
+		return false;
+	/* Use this owner's entry, never another package's placeholder. */
+	for (conff = pkg->installed.conffiles; conff; conff = conff->next) {
+		if (!(conff->flags & CONFFILE_REMOVE_ON_UPGRADE) &&
+		    strcmp(conff->name, name) == 0)
+			break;
+	}
+	if (conff == NULL || strcmp(conff->hash, expected) != 0)
+		return false;
+
+	dir = dpkg_fsys_get_path(LEANCODE_RECORDS_DIR);
+	filename = str_fmt("%s/%s.tsv", dir,
+	                   pkgbin_name(pkg, &pkg->installed, pnaw_same));
+	free(dir);
+	index = leancode_index_load(filename, LEANCODE_INDEX_RECORDS);
+	free(filename);
+	record = leancode_index_find(index, name + 1);
+	if (record == NULL)
+		return false;
+	/* Ambiguous duplicate rows are not evidence. */
+	pos = record - index->entries;
+	if ((pos > 0 && strcmp(index->entries[pos - 1].name, record->name) == 0) ||
+	    (pos + 1 < index->entries_used &&
+	     strcmp(index->entries[pos + 1].name, record->name) == 0))
+		return false;
+
+	return leancode_sha256_is(fn, record->lean) &&
+	       leancode_original_matches(record->hash, expected);
+}
+
+/* Only installed conffile decisions use this logical digest. */
+void
+md5hash_conffile(struct pkginfo *pkg, char *hashbuf, const char *fn,
+                 const char *name, const char *expected)
+{
+	if (leancode_conffile_projection(pkg, fn, name, expected)) {
+		strcpy(hashbuf, expected);
+		debug(dbg_conff, "leancode conffile '%s' matches its recorded original", name);
+	} else {
+		md5hash(pkg, hashbuf, fn);
+	}
+}
+
+/* Private interface shared with dpkg-maintscript-helper. */
+const char *leancode_conffile_package;
+
+int
+leancode_conffile_hash(const char *const *argv)
+{
+	const char *name = *argv++;
+	const struct conffile *conff;
+	struct pkginfo *pkg;
+	char hash[MD5HASHLEN + 1];
+	char *filename;
+
+	if (name == NULL || *argv)
+		badusage(_("--%s takes exactly one argument"), cipaction->olong);
+
+	modstatdb_open(msdbrw_readonly);
+	pkg = dpkg_options_parse_pkgname(cipaction, leancode_conffile_package);
+	for (conff = pkg->installed.conffiles; conff; conff = conff->next) {
+		if (!(conff->flags & CONFFILE_REMOVE_ON_UPGRADE) &&
+		    strcmp(conff->name, name) == 0)
+			break;
+	}
+	filename = dpkg_fsys_get_path(name);
+	md5hash_conffile(pkg, hash, filename, name, conff ? conff->hash : "");
+	free(filename);
+	printf("%s\n", hash);
+	m_output(stdout, _("<standard output>"));
+	modstatdb_shutdown();
+	return 0;
+}
+
 /*
  * Check whether the shared file on disk is a Lean Code projection of the
  * file the other instances of the package set shipped.
