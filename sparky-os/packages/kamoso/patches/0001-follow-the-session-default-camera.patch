+void DeviceManager::chooseDevice(int row)
+{
+    m_chosenByPerson = true;
+    setPlayingDevice(deviceAt(row));
+}
+
+// The camera the session's default video source names (PipeWire's metadata "default", key default.video.source, which WirePlumber
+// keeps), when it is one of ours
+Device *DeviceManager::sessionDefaultDevice() const
+{
+    QProcess p;
+    p.start(QStringLiteral("pw-metadata"), {QStringLiteral("-n"), QStringLiteral("default"), QStringLiteral("0"), QStringLiteral("default.video.source")});
+    if (!p.waitForStarted(1000) || !p.waitForFinished(2000) || p.exitCode() != 0) {
+        return nullptr;
+    }
+    static const QRegularExpression name(QStringLiteral("\"name\"\\s*:\\s*\"([^\"]+)\""));
+    const auto match = name.match(QString::fromUtf8(p.readAllStandardOutput()));
+    if (!match.hasMatch()) {
+        return nullptr;
+    }
+    for (auto d : m_deviceList) {
+        if (d->nodeName() == match.captured(1)) {
+            return d;
+        }
+    }
+    return nullptr;
+}
+
+Device *DeviceManager::preferredDevice() const
+{
+    Device *d = sessionDefaultDevice();
+    return d ? d : m_deviceList.constFirst();
+}
+
 void DeviceManager::deviceRemoved(GstDevice* device)
 {
     auto st = gst_device_get_properties(device);
