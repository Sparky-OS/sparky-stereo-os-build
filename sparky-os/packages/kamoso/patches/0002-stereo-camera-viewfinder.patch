+    void effectReachesPreviewAndCapture()
+    {
+        QVideoSink sink; StereoPreview preview;
+        preview.setSink(&sink); preview.setMirrored(false);
+        preview.setPacking(QStringLiteral("sideBySideLeftFirst"));
+        preview.setEffect(QStringLiteral("videobalance saturation=0"));
+        QImage pair(160,60,QImage::Format_RGBA8888);pair.fill(Qt::red);
+        for(int y=0;y<60;++y) for(int x=80;x<160;++x) pair.setPixelColor(x,y,Qt::blue);
