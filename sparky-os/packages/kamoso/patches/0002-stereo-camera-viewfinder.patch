+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#include "stereophoto.h"
+#include <QFileInfo>
+#include <QImageWriter>
+#include <QSaveFile>
+#include <KLocalizedString>
+
+QString saveStereoPhoto(const QImage &pair, const QString &path, const QByteArray &format, int quality)
+{
+    if (pair.isNull() || pair.width() % 2 || (format != "mpo" && format != "jps"))
+        return i18n("A complete stereo frame and an MPO or JPS format are needed to save this photo.");
+    if (QFileInfo::exists(path))
+        return i18n("The photo already exists. Choose another name.");
+    QImage image = pair;
+    image.setText(QStringLiteral("Stereo3DLayout"), QStringLiteral("sideBySideLeftFirst"));
+    QSaveFile file(path);
+    if (!file.open(QIODevice::WriteOnly))
+        return file.errorString();
+    QImageWriter writer(&file, format);
+    writer.setQuality(quality);
+    if (!writer.write(image))
+        return writer.errorString();
+    if (!file.commit())
+        return file.errorString();
+    return {};
+}
