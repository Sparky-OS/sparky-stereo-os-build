+#include "stereoeffects.h"
+#include <QtTest>
+#include <QFile>
+#include <QRegularExpression>
+#include <QMutex>
+#include <QCryptographicHash>
+#include <gst/app/gstappsrc.h>
+#include <gst/video/video.h>
+
+class StereoEffectsTest : public QObject
+{
+    Q_OBJECT
+    static QImage pattern()
+    {
+        QImage pair(320, 120, QImage::Format_RGBA8888);
+        for (int y=0;y<pair.height();++y) for(int x=0;x<pair.width();++x)
+            pair.setPixelColor(x,y,QColor((x*3+y*7)%256,(x*13+y*2)%256,(x*5+y*11)%256));
+        return pair;
+    }
+private Q_SLOTS:
+    void initTestCase() { gst_init(nullptr,nullptr); }
+    void matrix_data()
+    {
+        QTest::addColumn<QString>("filter");
+        QFile file(QFINDTESTDATA("../src/qml/Config.qml"));
+        QVERIFY(file.open(QIODevice::ReadOnly));
+        const auto text=QString::fromUtf8(file.readAll());
+        const QRegularExpression re(QStringLiteral("^\\s*ListElement \\{ filters: \"([^\"]+)\" \\}"),QRegularExpression::MultilineOption);
+        auto it=re.globalMatch(text);int count=0;
+        while(it.hasNext()) { const auto filter=it.next().captured(1);QTest::newRow(qPrintable(filter))<<filter;++count; }
+        QCOMPARE(count,31);
+    }
+    void matrix()
+    {
+        QFETCH(QString,filter);
+        StereoEffects effects;
+        effects.setFilter(filter);
+        const auto pair=pattern();
+        QSignalSpy frames(&effects,&StereoEffects::ready), errors(&effects,&StereoEffects::failed);
+        QVERIFY(effects.start(pair.size()));
+        QVERIFY(effects.m_eyes[0].pipeline!=effects.m_eyes[1].pipeline);
+        struct Probe { QMutex mutex; QByteArray pixels; QSize size; } probes[2];
+        for(int i=0;i<2;++i) {
+            auto *pad=gst_element_get_static_pad(effects.m_eyes[i].source,"src");
+            gst_pad_add_probe(pad,GST_PAD_PROBE_TYPE_BUFFER,[](GstPad *pad,GstPadProbeInfo *info,gpointer data) {
+                auto &probe=*static_cast<Probe *>(data);
+                auto *caps=gst_pad_get_current_caps(pad);GstVideoInfo video;
+                gst_video_info_from_caps(&video,caps);gst_caps_unref(caps);
+                GstMapInfo map;auto *buffer=GST_PAD_PROBE_INFO_BUFFER(info);
+                if(gst_buffer_map(buffer,&map,GST_MAP_READ)) {
+                    QMutexLocker locker(&probe.mutex);
+                    probe.pixels=QByteArray(reinterpret_cast<const char *>(map.data),map.size);
+                    probe.size=QSize(video.width,video.height);
+                    gst_buffer_unmap(buffer,&map);
+                }
+                return GST_PAD_PROBE_OK;
+            },&probes[i],nullptr);gst_object_unref(pad);
+        }
+        // Multiple frames exercise persistent filter state, not only preroll.
+        for(int frame=0;frame<3;++frame) {
+            effects.submit(pair);
+            QTRY_VERIFY_WITH_TIMEOUT(!errors.empty() || frames.size()==frame+1,120000);
+            QVERIFY2(errors.empty(),errors.empty()?"":qPrintable(errors[0][0].toString()));
+            QCOMPARE(qvariant_cast<QImage>(frames.back()[0]).size(),pair.size());
+            for(int i=0;i<2;++i) {
+                QMutexLocker locker(&probes[i].mutex);
+                QCOMPARE(probes[i].size,QSize(160,120));
+                auto expected=pair.copy(i*160,0,160,120);
+                QCOMPARE(probes[i].pixels,QByteArray(reinterpret_cast<const char *>(expected.constBits()),expected.sizeInBytes()));
+            }
+        }
+        effects.reset(); // Stop threads before stack-owned probe records go away.
+        qInfo().noquote()<<filter<<"expected=two independent 160x120 inputs; found=exact samples, three complete native pairs";
+    }
+    void independentSpatialControl()
+    {
+        const auto pair=pattern();
+        StereoEffects combined,left,right;
+        for(auto *e:{&combined,&left,&right}) e->setFilter(QStringLiteral("bulge"));
+        QImage doubledLeft=pair,doubledRight=pair;
+        for(int y=0;y<120;++y) {
+            memcpy(doubledLeft.scanLine(y)+160*4,pair.constScanLine(y),160*4);
+            memcpy(doubledRight.scanLine(y),pair.constScanLine(y)+160*4,160*4);
+        }
+        QSignalSpy actual(&combined,&StereoEffects::ready), l(&left,&StereoEffects::ready),r(&right,&StereoEffects::ready);
+        combined.submit(pair);left.submit(doubledLeft);right.submit(doubledRight);
+        QTRY_COMPARE_WITH_TIMEOUT(actual.size(),1,120000);
+        QTRY_COMPARE_WITH_TIMEOUT(l.size(),1,120000);QTRY_COMPARE_WITH_TIMEOUT(r.size(),1,120000);
