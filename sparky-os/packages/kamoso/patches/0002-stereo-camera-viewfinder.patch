+class StereoPhotoTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void formats_data()
+    {
+        QTest::addColumn<QByteArray>("format");
+        QTest::newRow("MPO") << QByteArray("mpo");
+        QTest::newRow("JPS") << QByteArray("jps");
+    }
+    void formats()
+    {
+        QFETCH(QByteArray, format);
+        QTemporaryDir temporary;
+        const QString kept = qEnvironmentVariable("KAMOSO_PHOTO_TEST_OUTPUT");
+        const QString path = (kept.isEmpty() ? temporary.path() : kept) + QStringLiteral("/camera.") + QString::fromLatin1(format);
+        QImage pair(128, 48, QImage::Format_RGB32);
+        for (int y = 0; y < pair.height(); ++y) for (int x = 0; x < pair.width(); ++x) {
+            const bool right = x >= 64;
+            const bool box = (x % 64 >= (right ? 20 : 24)) && x % 64 < (right ? 40 : 44) && y >= 12 && y < 36;
+            pair.setPixelColor(x, y, box ? QColor(Qt::white) : right ? QColor(0, 0, 240) : QColor(240, 0, 0));
+        }
+        const QString error = saveStereoPhoto(pair, path, format, 85);
+        QVERIFY2(error.isEmpty(), qPrintable(error));
+        QFile file(path); QVERIFY(file.open(QIODevice::ReadOnly)); const QByteArray bytes = file.readAll(); file.close();
+        QVERIFY(bytes.contains(format == "mpo" ? QByteArray("MPF\0",4) : QByteArray("_JPSJPS_")));
+        const auto picture = Stereo::Picture::load(path, {}, Stereo::OutputMode::Stereo);
+        QVERIFY(picture.isStereo());
+        QCOMPARE(picture.left.size(), QSize(64,48));
+        QCOMPARE(picture.right.size(), QSize(64,48));
+        QVERIFY(picture.left.pixelColor(3,3).red() > 200);
+        QVERIFY(picture.right.pixelColor(3,3).blue() > 200);
+        // Compare the layer's selected views with the format plugin's decoded
+        // views, not raw source pixels that JPEG is allowed to quantize.
+        QImageReader reader(path, format);
+        const auto decoded = reader.read(); QVERIFY2(!decoded.isNull(), qPrintable(reader.errorString()));
+        if (format == "jps") {
+            QCOMPARE(decoded.text(QStringLiteral("Stereo3DLayout")), QStringLiteral("sideBySideLeftFirst"));
+            QCOMPARE(picture.left.convertToFormat(QImage::Format_RGB32), decoded.copy(0,0,64,48).convertToFormat(QImage::Format_RGB32));
+            QCOMPARE(picture.right.convertToFormat(QImage::Format_RGB32), decoded.copy(64,0,64,48).convertToFormat(QImage::Format_RGB32));
+        } else {
+            QCOMPARE(reader.imageCount(), 2);
+            QCOMPARE(picture.left.convertToFormat(QImage::Format_RGB32), decoded.convertToFormat(QImage::Format_RGB32));
+            QVERIFY(reader.jumpToImage(1));
+            QCOMPARE(picture.right.convertToFormat(QImage::Format_RGB32), reader.read().convertToFormat(QImage::Format_RGB32));
+        }
+        QVERIFY(!saveStereoPhoto(pair, path, format, 85).isEmpty());
+        QVERIFY(file.open(QIODevice::ReadOnly)); QCOMPARE(file.readAll(),bytes);
+    }
+    void failures()
+    {
+        QTemporaryDir temporary;
+        const QString path = temporary.filePath(QStringLiteral("refused.jps"));
+        QVERIFY(!saveStereoPhoto({}, path, "jps", 85).isEmpty());
+        QVERIFY(!saveStereoPhoto(QImage(3,4,QImage::Format_RGB32), path, "jps", 85).isEmpty());
+        QVERIFY(!saveStereoPhoto(QImage(4,4,QImage::Format_RGB32), path, "png", 85).isEmpty());
+        QVERIFY(!QFile::exists(path));
+    }
+};
