+        // This checks the preview/capture wiring, not idealized grayscale math:
+        // videoconvert's YUV round trip can differ by a channel value.
+        StereoEffects reference;
+        reference.setFilter(QStringLiteral("videobalance saturation=0"));
+        QSignalSpy expected(&reference,&StereoEffects::ready);
+        reference.submit(pair);
+        QTRY_COMPARE_WITH_TIMEOUT(expected.size(),1,120000);
