+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#include "stereoeffects.h"
+#include <KLocalizedString>
+#include <gst/app/gstappsrc.h>
+#include <gst/app/gstappsink.h>
+#include <gst/video/video.h>
+#include <cstring>
+
+StereoEffects::StereoEffects(QObject *parent) : QObject(parent)
+{
+    m_timer.setInterval(10);
+    connect(&m_timer, &QTimer::timeout, this, &StereoEffects::poll);
+}
+StereoEffects::~StereoEffects() { reset(); }
+void StereoEffects::reset()
+{
+    m_timer.stop();
+    for (auto &eye : m_eyes) {
+        if (eye.pipeline) gst_element_set_state(eye.pipeline, GST_STATE_NULL);
+        if (eye.source) gst_object_unref(eye.source);
+        if (eye.sink) gst_object_unref(eye.sink);
+        if (eye.bus) gst_object_unref(eye.bus);
+        if (eye.pipeline) gst_object_unref(eye.pipeline);
+        eye = {};
+    }
+    m_pending = false;
+    m_refused = false;
+    m_input = {};
+    m_size = {};
+}
+void StereoEffects::setFilter(const QString &filter)
+{
+    if (filter == m_filter) return;
+    reset();
+    m_filter = filter;
+}
+void StereoEffects::refuse(const QString &reason)
+{
+    const auto input = m_input;
+    reset();
+    m_refused = true;
+    Q_EMIT failed(i18n("The effect %1 could not run separately for each eye: %2. The camera is shown without this effect.", m_filter, reason));
+    if (!input.isNull()) Q_EMIT ready(input);
+}
+bool StereoEffects::start(const QSize &size)
+{
+    m_size = size;
+    for (auto &eye : m_eyes) {
+        const auto description = QStringLiteral("appsrc name=eye is-live=true format=time block=false max-buffers=1 ! videoconvert ! ")
+            + m_filter + QStringLiteral(" ! videoconvert ! video/x-raw,format=RGBA ! appsink name=result sync=false max-buffers=1");
+        GError *error = nullptr;
+        eye.pipeline = gst_parse_launch(description.toUtf8().constData(), &error);
+        if (error || !eye.pipeline) {
+            const auto reason = error ? QString::fromUtf8(error->message) : i18n("The filter could not start");
+            if (error) g_error_free(error);
+            refuse(reason);
+            return false;
+        }
+        eye.source = gst_bin_get_by_name(GST_BIN(eye.pipeline), "eye");
+        eye.sink = gst_bin_get_by_name(GST_BIN(eye.pipeline), "result");
+        eye.bus = gst_element_get_bus(eye.pipeline);
+        auto *caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, "RGBA",
+            "width", G_TYPE_INT, size.width() / 2, "height", G_TYPE_INT, size.height(),
+            "framerate", GST_TYPE_FRACTION, 0, 1, "pixel-aspect-ratio", GST_TYPE_FRACTION, 1, 1,
+            "multiview-mode", G_TYPE_STRING, "mono", nullptr);
+        gst_app_src_set_caps(GST_APP_SRC(eye.source), caps);
+        gst_caps_unref(caps);
+        if (gst_element_set_state(eye.pipeline, GST_STATE_PLAYING) == GST_STATE_CHANGE_FAILURE) {
+            refuse(i18n("The filter could not start"));
+            return false;
+        }
+    }
+    m_clock.start();
+    return true;
+}
+void StereoEffects::submit(const QImage &pair)
+{
+    if (m_filter.isEmpty() || m_refused) { Q_EMIT ready(pair); return; }
+    if (m_size.isValid() && m_size != pair.size()) reset();
+    if (m_pending) return;
+    m_input = pair;
+    if (!m_eyes[0].pipeline && !start(pair.size())) return;
+    m_pending = true;
+    const auto timestamp = GstClockTime(m_clock.nsecsElapsed());
+    for (int index = 0; index < 2; ++index) {
+        auto &eye = m_eyes[index];
+        const auto view = pair.copy(index * pair.width() / 2, 0, pair.width() / 2, pair.height()).convertToFormat(QImage::Format_RGBA8888);
+        auto *buffer = gst_buffer_new_allocate(nullptr, gsize(view.width()) * view.height() * 4, nullptr);
+        for (int y = 0; y < view.height(); ++y)
+            gst_buffer_fill(buffer, gsize(y) * view.width() * 4, view.constScanLine(y), gsize(view.width()) * 4);
+        GST_BUFFER_PTS(buffer) = timestamp;
+        if (gst_app_src_push_buffer(GST_APP_SRC(eye.source), buffer) != GST_FLOW_OK) {
+            refuse(i18n("The filter refused a camera frame"));
+            return;
+        }
+    }
+    m_timer.start();
+}
+void StereoEffects::poll()
+{
+    for (auto &eye : m_eyes) {
+        auto *message = gst_bus_pop_filtered(eye.bus, GstMessageType(GST_MESSAGE_ERROR | GST_MESSAGE_EOS));
+        if (message) {
+            QString reason = i18n("The filter stopped");
+            if (GST_MESSAGE_TYPE(message) == GST_MESSAGE_ERROR) {
+                GError *error = nullptr;
+                gst_message_parse_error(message, &error, nullptr);
+                reason = QString::fromUtf8(error->message);
+                g_error_free(error);
+            }
+            gst_message_unref(message);
+            refuse(reason);
+            return;
+        }
+        if (!eye.result.isNull()) continue;
+        auto *sample = gst_app_sink_try_pull_sample(GST_APP_SINK(eye.sink), 0);
+        if (!sample) continue;
+        GstVideoInfo info;
+        GstVideoFrame frame;
+        const bool valid = gst_video_info_from_caps(&info, gst_sample_get_caps(sample))
+            && GST_VIDEO_INFO_WIDTH(&info) == m_size.width() / 2 && GST_VIDEO_INFO_HEIGHT(&info) == m_size.height()
+            && GST_VIDEO_INFO_FORMAT(&info) == GST_VIDEO_FORMAT_RGBA
+            && gst_video_frame_map(&frame, &info, gst_sample_get_buffer(sample), GST_MAP_READ);
+        if (valid) {
+            eye.result = QImage(static_cast<const uchar *>(GST_VIDEO_FRAME_PLANE_DATA(&frame, 0)),
+                m_size.width() / 2, m_size.height(), GST_VIDEO_FRAME_PLANE_STRIDE(&frame, 0), QImage::Format_RGBA8888).copy();
+            gst_video_frame_unmap(&frame);
+        }
+        gst_sample_unref(sample);
+        if (!valid) { refuse(i18n("The filter changed the eye's sample dimensions")); return; }
+    }
+    if (m_eyes[0].result.isNull() || m_eyes[1].result.isNull()) return;
+    QImage pair(m_size, QImage::Format_RGBA8888);
+    for (int y = 0; y < pair.height(); ++y) {
+        memcpy(pair.scanLine(y), m_eyes[0].result.constScanLine(y), size_t(pair.width()) * 2);
+        memcpy(pair.scanLine(y) + pair.width() * 2, m_eyes[1].result.constScanLine(y), size_t(pair.width()) * 2);
+    }
+    for (auto &eye : m_eyes) eye.result = {};
+    m_pending = false;
+    m_input = {};
+    m_timer.stop();
+    Q_EMIT ready(pair);
+}
