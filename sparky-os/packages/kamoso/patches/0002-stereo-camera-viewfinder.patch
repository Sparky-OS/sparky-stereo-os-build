+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#include "stereopreview.h"
+#include <QtTest>
+#include <QVideoFrame>
+#include <gst/app/gstappsrc.h>
+#include <cstring>
+#include <stereo-layer/picture.h>
+
+class StereoPreviewTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase() { gst_init(nullptr, nullptr); }
+    void temporalOrderAndGaps()
+    {
+        QVideoSink output;
+        StereoPreview preview;
+        preview.setSink(&output);
+        preview.setMirrored(false);
+        QSignalSpy frames(&output, &QVideoSink::videoFrameChanged);
+        QSignalSpy errors(&preview, &StereoPreview::failed);
+        QImage red(4, 3, QImage::Format_RGBA8888), blue(red.size(), red.format());
+        red.fill(Qt::red); blue.fill(Qt::blue);
+        const auto send = [&](const QImage &image, quint64 offset, bool discontinuity = false) {
+            preview.present(image, discontinuity, offset, GST_VIDEO_MULTIVIEW_MODE_NONE, GST_VIDEO_MULTIVIEW_FLAGS_NONE);
+        };
+        preview.setPacking(QStringLiteral("frameSequentialLeftFirst"));
+        send(blue, 1); // Attaching halfway through a pair cannot supply its first eye.
+        QCOMPARE(frames.size(), 0);
+        send(red, 2);
+        send(blue, 3);
+        QCOMPARE(frames.size(), 1);
+        QCOMPARE(output.videoFrame().toImage().pixelColor(0, 0), QColor(Qt::red));
+        QCOMPARE(output.videoFrame().toImage().pixelColor(4, 0), QColor(Qt::blue));
+        send(red, 4);
+        send(blue, 7); // No pair across missing frames.
+        QCOMPARE(frames.size(), 1);
+        send(red, 8);
+        send(blue, 9, true);
+        QCOMPARE(frames.size(), 1);
+        send(red, GST_BUFFER_OFFSET_NONE);
+        QCOMPARE(errors.size(), 1);
+        QCOMPARE(frames.size(), 1);
+        preview.setPacking(QStringLiteral("frameSequentialRightFirst"));
+        send(blue, 10);
+        send(red, 11);
+        QCOMPARE(frames.size(), 2);
+        QCOMPARE(output.videoFrame().toImage().pixelColor(0, 0), QColor(Qt::red));
+        QCOMPARE(output.videoFrame().toImage().pixelColor(4, 0), QColor(Qt::blue));
+    }
+    void policyRows_data()
+    {
+        QTest::addColumn<int>("index");
+        QTest::addColumn<bool>("mirror");
+        QTest::addColumn<bool>("temporalCaps");
+        for (size_t i = 0; i < stereo_policy_input_format_count(); ++i) {
+            const auto *entry = stereo_policy_input_format_at(i);
+            QTest::newRow(entry->id) << int(i) << false << false;
+            QTest::newRow(qPrintable(QString::fromLatin1(entry->id) + QStringLiteral("-mirror"))) << int(i) << true << false;
+            if (entry->layout == STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL)
+                QTest::newRow(qPrintable(QString::fromLatin1(entry->id) + QStringLiteral("-caps"))) << int(i) << false << true;
+        }
+    }
+    void policyRows()
+    {
+        QFETCH(int, index);
+        QFETCH(bool, mirror);
+        QFETCH(bool, temporalCaps);
+        const auto &entry = *stereo_policy_input_format_at(index);
+        const int w = 8, h = 6;
+        QImage left(w, h, QImage::Format_RGBA8888), right(w, h, left.format());
+        for (int y = 0; y < h; ++y) {
+            for (int x = 0; x < w; ++x) {
+                left.setPixelColor(x, y, QColor(220, x * 17, y * 29));
+                right.setPixelColor(x, y, QColor(x * 17, y * 29, 220));
+            }
+        }
+        QImage first = entry.order ? right : left, second = entry.order ? left : right;
+        QImage input;
+        const int layout = entry.layout;
+        const bool rows = layout == STEREO_POLICY_LAYOUT_ROWS;
+        const bool columns = layout == STEREO_POLICY_LAYOUT_COLUMNS;
+        const bool checker = layout == STEREO_POLICY_LAYOUT_CHECKERBOARD;
+        const bool vertical = layout == STEREO_POLICY_LAYOUT_TOP_AND_BOTTOM || rows;
+        if (layout >= STEREO_POLICY_LAYOUT_SIDE_BY_SIDE && layout <= STEREO_POLICY_LAYOUT_SIDE_BY_SIDE_QUINCUNX) {
+            input = QImage(vertical ? QSize(w, 2*h) : QSize(2*w, h), left.format());
+            for (int y = 0; y < input.height(); ++y) {
+                for (int x = 0; x < input.width(); ++x) {
+                    const bool odd = rows ? y % 2 : columns ? x % 2 : checker ? (x+y) % 2 : vertical ? y >= h : x >= w;
+                    const int sx = columns || checker ? x/2 : x%w;
+                    const int sy = rows ? y/2 : y%h;
+                    input.setPixelColor(x, y, (odd ? second : first).pixelColor(sx, sy));
+                }
+            }
+        } else if (stereo_policy_is_depth_layout(layout)) {
+            // A constant depth map avoids assumptions about the DIBR default; the
+            // independent shared depth call below is the conversion authority.
+            QImage depth(w, h, left.format()); depth.fill(QColor(128, 128, 128));
+            first = entry.order ? depth : left;
+            second = entry.order ? left : depth;
+            const bool side = layout == STEREO_POLICY_LAYOUT_DEPTH_SIDE_BY_SIDE;
+            const bool background = layout == STEREO_POLICY_LAYOUT_DEPTH_BACKGROUND;
+            const bool graphics = layout == STEREO_POLICY_LAYOUT_DEPTH_GRAPHICS;
+            input = QImage(side || background ? 2*w : w, side ? h : graphics ? 4*h : 2*h, left.format());
+            input.fill(Qt::black);
+            for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x) {
+                input.setPixelColor(x, y, first.pixelColor(x, y));
+                input.setPixelColor(x + (side || background ? w : 0), y + (side || background ? 0 : h), second.pixelColor(x, y));
+            }
+            const auto expected = Stereo::Picture::fromPackedImage(input, Stereo::Picture::Layout(layout), Stereo::Picture::EyeOrder(entry.order));
+            QVERIFY(expected.isStereo()); left = expected.left; right = expected.right;
+        } else {
+            input = first;
+            if (entry.anaglyph) {
+                const auto expected = Stereo::Picture::fromAnaglyph(input, Stereo::Picture::AnaglyphColorPair(entry.anaglyph));
+                QVERIFY(expected.isStereo()); left = expected.left; right = expected.right;
+            }
+        }
+        QVideoSink output;
+        StereoPreview preview;
+        preview.setSink(&output);
+        preview.setMirrored(mirror);
+        preview.setPacking(temporalCaps ? QStringLiteral("topBottomRightFirst") : QString::fromLatin1(entry.id));
+        QSignalSpy errors(&preview, &StereoPreview::failed);
+        auto *pipeline = gst_pipeline_new(nullptr);
+        auto *source = gst_element_factory_make("appsrc", nullptr);
+        auto *sink = preview.createSink();
+        QVERIFY(source && sink);
+        auto *caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, "RGBA", "width", G_TYPE_INT, input.width(), "height", G_TYPE_INT, input.height(), "framerate", GST_TYPE_FRACTION, 30, 1, nullptr);
+        if (temporalCaps)
+            gst_caps_set_simple(caps, "multiview-mode", G_TYPE_STRING, "frame-by-frame", "views", G_TYPE_INT, 2,
+                "multiview-flags", GST_TYPE_VIDEO_MULTIVIEW_FLAGSET, entry.order ? GST_VIDEO_MULTIVIEW_FLAGS_RIGHT_VIEW_FIRST : GST_VIDEO_MULTIVIEW_FLAGS_NONE,
+                GST_FLAG_SET_MASK_EXACT, nullptr);
+        g_object_set(source, "caps", caps, "format", GST_FORMAT_TIME, nullptr);
+        gst_caps_unref(caps);
+        gst_bin_add_many(GST_BIN(pipeline), source, sink, nullptr);
+        QVERIFY(gst_element_link(source, sink));
+        const auto cleanup = qScopeGuard([pipeline] { gst_element_set_state(pipeline, GST_STATE_NULL); gst_object_unref(pipeline); });
+        QVERIFY(gst_element_set_state(pipeline, GST_STATE_PLAYING) != GST_STATE_CHANGE_FAILURE);
+        const auto push = [source](const QImage &image, quint64 ordinal, bool discontinuity = false) {
+            auto *buffer = gst_buffer_new_allocate(nullptr, image.sizeInBytes(), nullptr);
+            gst_buffer_fill(buffer, 0, image.constBits(), image.sizeInBytes());
+            GST_BUFFER_PTS(buffer) = ordinal * GST_SECOND / 30;
+            GST_BUFFER_DURATION(buffer) = GST_SECOND / 30;
+            GST_BUFFER_OFFSET(buffer) = ordinal;
+            if (discontinuity) GST_BUFFER_FLAG_SET(buffer, GST_BUFFER_FLAG_DISCONT);
+            return gst_app_src_push_buffer(GST_APP_SRC(source), buffer);
+        };
+        QCOMPARE(push(input, 0), GST_FLOW_OK);
+        if (layout == STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL) {
+            QTRY_VERIFY_WITH_TIMEOUT(!preview.m_first.isNull(), 60000);
+            QCOMPARE(push(second, 3), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(preview.m_first.isNull(), 60000);
+            QVERIFY(!output.videoFrame().isValid());
+            QCOMPARE(push(first, 4), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(!preview.m_first.isNull(), 60000);
+            QCOMPARE(push(second, 5, true), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(preview.m_first.isNull(), 60000);
+            QVERIFY(!output.videoFrame().isValid());
+            QCOMPARE(push(first, GST_BUFFER_OFFSET_NONE), GST_FLOW_OK);
+            QTRY_COMPARE_WITH_TIMEOUT(errors.size(), 1, 60000);
+            QVERIFY(errors.first().first().toString().contains(QStringLiteral("order of alternating frames")));
+            QVERIFY(!output.videoFrame().isValid());
+            errors.clear();
+            QCOMPARE(push(first, 6), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(!preview.m_first.isNull(), 60000);
+            QCOMPARE(push(second, 7), GST_FLOW_OK);
