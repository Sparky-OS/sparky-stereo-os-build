+        preview.setPacking(temporalCaps ? QStringLiteral("topBottomRightFirst") : QString::fromLatin1(entry.id));
+        QSignalSpy errors(&preview, &StereoPreview::failed);
+        auto *pipeline = gst_pipeline_new(nullptr);
+        auto *source = gst_element_factory_make("appsrc", nullptr);
+        auto *sink = preview.createSink();
+        QVERIFY(source && sink);
+        auto *caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, "RGBA", "width", G_TYPE_INT, input.width(), "height", G_TYPE_INT, input.height(), "framerate", GST_TYPE_FRACTION, 30, 1, nullptr);
+        if (temporalCaps)
+            gst_caps_set_simple(caps, "multiview-mode", G_TYPE_STRING, "frame-by-frame", "views", G_TYPE_INT, 2,
+                "multiview-flags", GST_TYPE_VIDEO_MULTIVIEW_FLAGSET, entry.order ? GST_VIDEO_MULTIVIEW_FLAGS_RIGHT_VIEW_FIRST : GST_VIDEO_MULTIVIEW_FLAGS_NONE,
+                GST_FLAG_SET_MASK_EXACT, nullptr);
+        g_object_set(source, "caps", caps, "format", GST_FORMAT_TIME, nullptr);
+        gst_caps_unref(caps);
+        gst_bin_add_many(GST_BIN(pipeline), source, sink, nullptr);
+        QVERIFY(gst_element_link(source, sink));
+        const auto cleanup = qScopeGuard([pipeline] { gst_element_set_state(pipeline, GST_STATE_NULL); gst_object_unref(pipeline); });
+        QVERIFY(gst_element_set_state(pipeline, GST_STATE_PLAYING) != GST_STATE_CHANGE_FAILURE);
+        const auto push = [source](const QImage &image, quint64 ordinal, bool discontinuity = false) {
+            auto *buffer = gst_buffer_new_allocate(nullptr, image.sizeInBytes(), nullptr);
+            gst_buffer_fill(buffer, 0, image.constBits(), image.sizeInBytes());
+            GST_BUFFER_PTS(buffer) = ordinal * GST_SECOND / 30;
+            GST_BUFFER_DURATION(buffer) = GST_SECOND / 30;
+            GST_BUFFER_OFFSET(buffer) = ordinal;
+            if (discontinuity) GST_BUFFER_FLAG_SET(buffer, GST_BUFFER_FLAG_DISCONT);
+            return gst_app_src_push_buffer(GST_APP_SRC(source), buffer);
+        };
+        QCOMPARE(push(input, 0), GST_FLOW_OK);
+        if (layout == STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL) {
+            QTRY_VERIFY_WITH_TIMEOUT(!preview.m_first.isNull(), 60000);
+            QCOMPARE(push(second, 3), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(preview.m_first.isNull(), 60000);
+            QVERIFY(!output.videoFrame().isValid());
+            QCOMPARE(push(first, 4), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(!preview.m_first.isNull(), 60000);
+            QCOMPARE(push(second, 5, true), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(preview.m_first.isNull(), 60000);
+            QVERIFY(!output.videoFrame().isValid());
+            QCOMPARE(push(first, GST_BUFFER_OFFSET_NONE), GST_FLOW_OK);
+            QTRY_COMPARE_WITH_TIMEOUT(errors.size(), 1, 60000);
+            QVERIFY(errors.first().first().toString().contains(QStringLiteral("order of alternating frames")));
+            QVERIFY(!output.videoFrame().isValid());
+            errors.clear();
+            QCOMPARE(push(first, 6), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(!preview.m_first.isNull(), 60000);
+            QCOMPARE(push(second, 7), GST_FLOW_OK);
+        }
+        QTRY_VERIFY_WITH_TIMEOUT(output.videoFrame().isValid() || !errors.isEmpty(), 60000);
+        if (layout == STEREO_POLICY_LAYOUT_BLOCK_LACED) {
+            QCOMPARE(errors.size(), 1);
+            QVERIFY(errors.first().first().toString().contains(QStringLiteral("cannot provide")));
+            QVERIFY(!output.videoFrame().isValid());
+            return;
+        }
+        QCOMPARE(errors.size(), 0);
+        const bool stereo = layout != STEREO_POLICY_LAYOUT_NONE || entry.anaglyph;
+        const auto frame = output.videoFrame();
+        if (!stereo) {
+            QCOMPARE(frame.surfaceFormat().stereoMode(), QVideoFrameFormat::StereoMode::None);
+            QCOMPARE(frame.toImage().convertToFormat(input.format()), mirror ? input.mirrored(true, false) : input);
+            return;
+        }
+        QCOMPARE(frame.surfaceFormat().stereoMode(), QVideoFrameFormat::StereoMode::SideBySide);
+        QCOMPARE(frame.size(), QSize(left.width()*2, left.height()));
+        const auto result = frame.toImage().convertToFormat(left.format());
+        QCOMPARE(result.copy(0, 0, left.width(), left.height()), mirror ? left.mirrored(true, false) : left);
+        QCOMPARE(result.copy(left.width(), 0, left.width(), left.height()), mirror ? right.mirrored(true, false) : right);
+    }
