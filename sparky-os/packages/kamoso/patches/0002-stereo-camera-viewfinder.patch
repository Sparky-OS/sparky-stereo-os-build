+        QFETCH(QSize, eyeSize);
+        QFETCH(bool, declared);
+        QImage left(eyeSize, QImage::Format_RGBA8888), right(eyeSize, QImage::Format_RGBA8888);
+        for (int y = 0; y < eyeSize.height(); ++y) {
+            for (int x = 0; x < eyeSize.width(); ++x) {
+                left.setPixelColor(x, y, QColor(255, x * 16, y * 16));
+                right.setPixelColor(x, y, QColor(x * 16, y * 16, 255));
+            }
+        }
+        QImage input(vertical ? QSize(eyeSize.width(), eyeSize.height() * 2) : QSize(eyeSize.width() * 2, eyeSize.height()), QImage::Format_RGBA8888);
+        for (int y = 0; y < input.height(); ++y) {
+            for (int x = 0; x < input.width(); ++x) {
+                const bool second = vertical ? y >= eyeSize.height() : x >= eyeSize.width();
+                input.setPixelColor(x, y, (second != reverse ? right : left).pixelColor(x % eyeSize.width(), y % eyeSize.height()));
+            }
+        }
+        QVideoSink output;
+        StereoPreview preview;
+        preview.setSink(&output);
+        preview.setMirrored(false);
+        preview.setPacking(declared ? (vertical ? QStringLiteral("sideBySideLeftFirst") : QStringLiteral("topBottomRightFirst")) : packing);
+        QVERIFY(declared || preview.hasPacking());
+        auto *pipeline = gst_pipeline_new(nullptr);
+        auto *source = gst_element_factory_make("appsrc", nullptr);
+        auto *sink = preview.createSink();
+        QVERIFY(source && sink);
+        auto *caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, "RGBA", "width", G_TYPE_INT, input.width(), "height", G_TYPE_INT, input.height(), "framerate", GST_TYPE_FRACTION, 30, 1, nullptr);
+        if (declared) {
+            gst_caps_set_simple(caps, "multiview-mode", G_TYPE_STRING, vertical ? "top-bottom" : "side-by-side",
+                                "multiview-flags", GST_TYPE_VIDEO_MULTIVIEW_FLAGSET,
+                                reverse ? GST_VIDEO_MULTIVIEW_FLAGS_RIGHT_VIEW_FIRST : GST_VIDEO_MULTIVIEW_FLAGS_NONE,
+                                GST_FLAG_SET_MASK_EXACT, nullptr);
+        }
+        g_object_set(source, "caps", caps, "format", GST_FORMAT_TIME, nullptr);
+        gst_caps_unref(caps);
+        gst_bin_add_many(GST_BIN(pipeline), source, sink, nullptr);
+        QVERIFY(gst_element_link(source, sink));
+        const auto cleanup = qScopeGuard([pipeline] { gst_element_set_state(pipeline, GST_STATE_NULL); gst_object_unref(pipeline); });
+        QVERIFY(gst_element_set_state(pipeline, GST_STATE_PLAYING) != GST_STATE_CHANGE_FAILURE);
+        auto *buffer = gst_buffer_new_allocate(nullptr, input.sizeInBytes(), nullptr);
+        gst_buffer_fill(buffer, 0, input.constBits(), input.sizeInBytes());
+        GST_BUFFER_PTS(buffer) = 0;
+        GST_BUFFER_DURATION(buffer) = GST_SECOND / 30;
+        GST_BUFFER_OFFSET(buffer) = 0;
+        QCOMPARE(gst_app_src_push_buffer(GST_APP_SRC(source), buffer), GST_FLOW_OK);
+        QTRY_VERIFY_WITH_TIMEOUT(output.videoFrame().isValid(), 60000);
+        const auto frame = output.videoFrame();
+        QCOMPARE(frame.surfaceFormat().stereoMode(), QVideoFrameFormat::StereoMode::SideBySide);
+        QCOMPARE(frame.size(), QSize(eyeSize.width() * 2, eyeSize.height()));
+        const auto result = frame.toImage();
+        QCOMPARE(result.copy(0, 0, eyeSize.width(), eyeSize.height()).convertToFormat(left.format()), left);
+        QCOMPARE(result.copy(eyeSize.width(), 0, eyeSize.width(), eyeSize.height()).convertToFormat(right.format()), right);
+    }
+};
+QTEST_MAIN(StereoPreviewTest)
+#include "stereopreview-test.moc"
