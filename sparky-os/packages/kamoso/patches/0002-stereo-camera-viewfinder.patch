+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#include "stereopreview.h"
+#include <stereo-layer/picture.h>
+#include <stereo-layer/render.h>
+#include <KLocalizedString>
+#include <QSettings>
+#include <QVideoFrame>
+#include <gst/app/gstappsink.h>
+#include <gst/video/video.h>
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <cstring>
+
+StereoPreview::StereoPreview(QObject *parent) : QObject(parent)
+{
+    connect(&m_effects, &StereoEffects::ready, this, [this](const QImage &pair) { deliver(pair, true); });
+    connect(&m_effects, &StereoEffects::failed, this, &StereoPreview::effectMessage);
+}
+void StereoPreview::setEffect(const QString &filter)
+{
+    m_capture = {};
+    m_effects.reset();
+    m_effects.setFilter(filter);
+    Q_EMIT effectMessage(QString());
+}
+void StereoPreview::setSink(QVideoSink *sink) { m_effects.reset(); m_capture = {}; m_sink = sink; }
+void StereoPreview::setMirrored(bool mirrored) { m_mirrored = mirrored; }
+bool StereoPreview::hasPacking() const
+{
+    return m_format.id && m_format.view != STEREO_POLICY_VIEW_MONO
+        && (m_format.layout != STEREO_POLICY_LAYOUT_NONE || m_format.anaglyph != STEREO_POLICY_ANAGLYPH_NONE);
+}
+void StereoPreview::setPacking(const QString &id)
+{
+    ++m_generation;
+    m_effects.reset();
+    m_capture = {};
+    m_unknownPacking = false;
+    m_format = {};
+    m_first = {};
+    for (size_t i = 0; i < stereo_policy_input_format_count(); ++i) {
+        const auto *entry = stereo_policy_input_format_at(i);
+        if (id == QLatin1String(entry->id)) {
+            m_format = *entry;
+            return;
+        }
+    }
+    m_unknownPacking = !id.isEmpty();
+    if (m_unknownPacking)
+        Q_EMIT failed(i18n("The saved camera packing is unavailable. Choose it again in Camera Settings."));
+}
+QString StereoPreview::cameraPacking(GstStructure *properties)
+{
+    if (!properties)
+        return {};
+    const char *path = gst_structure_get_string(properties, "api.v4l2.path");
+    if (!path)
+        path = gst_structure_get_string(properties, "device.path");
+    if (!path) {
+        const char *objectPath = gst_structure_get_string(properties, "object.path");
+        if (objectPath && g_str_has_prefix(objectPath, "v4l2:"))
+            path = objectPath + 5;
+    }
+    if (!path)
+        return {};
+    const int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0)
+        return {};
+    v4l2_capability capability {};
+    const bool found = ioctl(fd, VIDIOC_QUERYCAP, &capability) == 0;
+    close(fd);
+    if (!found)
+        return {};
+    QString key = QString::fromUtf8(reinterpret_cast<const char *>(capability.bus_info))
+        + QLatin1Char('|') + QString::fromUtf8(reinterpret_cast<const char *>(capability.card));
+    key.replace(QLatin1Char('/'), QLatin1Char('_'));
+    key.replace(QLatin1Char('\\'), QLatin1Char('_'));
+    QSettings store(QSettings::IniFormat, QSettings::UserScope, QStringLiteral("sparky-stereo-camera"), QStringLiteral("cameras"));
+    store.beginGroup(key);
+    return store.value(QStringLiteral("packing")).toString();
+}
+GstElement *StereoPreview::createSink()
+{
+    auto *bin = gst_parse_bin_from_description("videoconvert ! video/x-raw,format=RGBA ! appsink name=stereosink max-buffers=1 drop=true sync=false", true, nullptr);
+    if (!bin)
+        return nullptr;
+    auto *sink = gst_bin_get_by_name(GST_BIN(bin), "stereosink");
+    GstAppSinkCallbacks callbacks {};
+    callbacks.new_sample = [](GstAppSink *sink, gpointer data) -> GstFlowReturn {
+        auto *self = static_cast<StereoPreview *>(data);
+        GstSample *sample = gst_app_sink_pull_sample(sink);
+        if (!sample)
+            return GST_FLOW_EOS;
+        // A skipped frame invalidates a temporal pair; never pair across a gap.
+        if (self->m_pending.exchange(true)) {
+            gst_sample_unref(sample);
+            return GST_FLOW_OK;
+        }
+        const auto generation = self->m_generation.load();
+        GstVideoInfo info;
+        GstVideoFrame frame;
+        GstBuffer *buffer = gst_sample_get_buffer(sample);
+        const bool validInfo = gst_video_info_from_caps(&info, gst_sample_get_caps(sample));
+        const bool separated = validInfo && GST_VIDEO_INFO_MULTIVIEW_MODE(&info) == GST_VIDEO_MULTIVIEW_MODE_SEPARATED;
+        if (!validInfo || (separated && GST_VIDEO_INFO_VIEWS(&info) != 2)
+            || !gst_video_frame_map_id(&frame, &info, buffer, separated ? 0 : -1, GST_MAP_READ)) {
+            QMetaObject::invokeMethod(self, [self] {
+                Q_EMIT self->failed(i18n("This camera did not provide two readable views. Check its format in Camera Settings."));
+                self->m_pending = false;
+            }, Qt::QueuedConnection);
+            gst_sample_unref(sample);
+            return GST_FLOW_OK;
+        }
+        QImage image(static_cast<const uchar *>(GST_VIDEO_FRAME_PLANE_DATA(&frame, 0)),
+                     GST_VIDEO_FRAME_WIDTH(&frame), GST_VIDEO_FRAME_HEIGHT(&frame),
+                     GST_VIDEO_FRAME_PLANE_STRIDE(&frame, 0), QImage::Format_RGBA8888);
+        const QImage copy = image.copy();
+        QImage second;
+        if (separated) {
+            GstVideoFrame other;
+            if (gst_video_frame_map_id(&other, &info, buffer, 1, GST_MAP_READ)) {
+                second = QImage(static_cast<const uchar *>(GST_VIDEO_FRAME_PLANE_DATA(&other, 0)),
+                    GST_VIDEO_FRAME_WIDTH(&other), GST_VIDEO_FRAME_HEIGHT(&other),
+                    GST_VIDEO_FRAME_PLANE_STRIDE(&other, 0), QImage::Format_RGBA8888).copy();
+                gst_video_frame_unmap(&other);
+            }
+        }
+        const bool discontinuity = GST_BUFFER_FLAG_IS_SET(buffer, GST_BUFFER_FLAG_DISCONT);
+        const quint64 offset = GST_BUFFER_OFFSET(buffer);
+        const auto mode = GST_VIDEO_INFO_MULTIVIEW_MODE(&info);
+        const auto flags = GST_VIDEO_INFO_MULTIVIEW_FLAGS(&info);
+        gst_video_frame_unmap(&frame);
+        gst_sample_unref(sample);
+        QMetaObject::invokeMethod(self, [self, copy, second, discontinuity, offset, mode, flags, generation] {
+            if (generation == self->m_generation.load())
+                self->present(copy, discontinuity, offset, mode, flags, second);
+            self->m_pending = false;
+        }, Qt::QueuedConnection);
+        return GST_FLOW_OK;
+    };
+    gst_app_sink_set_callbacks(GST_APP_SINK(sink), &callbacks, this, nullptr);
+    gst_object_unref(sink);
+    return bin;
+}
+void StereoPreview::present(const QImage &image, bool discontinuity, quint64 offset, GstVideoMultiviewMode mode, GstVideoMultiviewFlags flags, const QImage &second)
+{
+    if (!m_sink)
+        return;
+    auto input = m_format;
+    int declaredLayout = STEREO_POLICY_LAYOUT_NONE;
+    switch (mode) {
+    case GST_VIDEO_MULTIVIEW_MODE_SIDE_BY_SIDE: declaredLayout = STEREO_POLICY_LAYOUT_SIDE_BY_SIDE; break;
+    case GST_VIDEO_MULTIVIEW_MODE_SIDE_BY_SIDE_QUINCUNX: declaredLayout = STEREO_POLICY_LAYOUT_SIDE_BY_SIDE_QUINCUNX; break;
+    case GST_VIDEO_MULTIVIEW_MODE_TOP_BOTTOM: declaredLayout = STEREO_POLICY_LAYOUT_TOP_AND_BOTTOM; break;
+    case GST_VIDEO_MULTIVIEW_MODE_ROW_INTERLEAVED: declaredLayout = STEREO_POLICY_LAYOUT_ROWS; break;
+    case GST_VIDEO_MULTIVIEW_MODE_COLUMN_INTERLEAVED: declaredLayout = STEREO_POLICY_LAYOUT_COLUMNS; break;
+    case GST_VIDEO_MULTIVIEW_MODE_CHECKERBOARD: declaredLayout = STEREO_POLICY_LAYOUT_CHECKERBOARD; break;
+    case GST_VIDEO_MULTIVIEW_MODE_SEPARATED: declaredLayout = STEREO_POLICY_LAYOUT_MULTI_VIEW; break;
+    case GST_VIDEO_MULTIVIEW_MODE_FRAME_BY_FRAME: declaredLayout = STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL; break;
+    default: break;
+    }
+    if (declaredLayout == STEREO_POLICY_LAYOUT_NONE && m_unknownPacking)
+        return;
+    if (mode == GST_VIDEO_MULTIVIEW_MODE_MULTIVIEW_FRAME_BY_FRAME) {
+        Q_EMIT failed(i18n("This camera stream does not identify a two-view pair. Choose a packing it can provide in Camera Settings."));
+        return;
+    }
+    if (declaredLayout != STEREO_POLICY_LAYOUT_NONE) {
+        input.layout = declaredLayout;
+        input.order = flags & GST_VIDEO_MULTIVIEW_FLAGS_RIGHT_VIEW_FIRST ? STEREO_POLICY_RIGHT_FIRST : STEREO_POLICY_LEFT_FIRST;
+        input.anaglyph = STEREO_POLICY_ANAGLYPH_NONE;
+        input.view = STEREO_POLICY_VIEW_STEREO;
+    }
+    using Picture = Stereo::Picture;
+    Picture picture;
+    const auto order = Picture::EyeOrder(input.order);
+    const bool stereo = input.view != STEREO_POLICY_VIEW_MONO
+        && (input.layout != STEREO_POLICY_LAYOUT_NONE || input.anaglyph != STEREO_POLICY_ANAGLYPH_NONE);
+    if (!stereo) {
+        picture.original = image;
+    } else if (mode == GST_VIDEO_MULTIVIEW_MODE_SEPARATED) {
+        picture = Picture::fromViewsInTurn(image, second, order);
+    } else if (input.layout == STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL) {
+        if (discontinuity)
+            m_first = {};
+        if (offset == GST_BUFFER_OFFSET_NONE) {
+            m_first = {};
+            Q_EMIT failed(i18n("This camera does not identify the order of alternating frames. Choose a packing it can provide in Camera Settings."));
+            return;
+        }
+        if (offset % 2 == 0) {
+            m_first = image;
+            m_firstOffset = offset;
+            return;
+        }
+        if (m_first.isNull() || offset != m_firstOffset + 1) {
+            m_first = {};
+            return;
+        }
+        picture = Picture::fromViewsInTurn(m_first, image, order);
+        m_first = {};
+    } else if (input.anaglyph != STEREO_POLICY_ANAGLYPH_NONE) {
+        picture = Picture::fromAnaglyph(image, Picture::AnaglyphColorPair(input.anaglyph));
+    } else {
+        picture = Picture::fromPackedImage(image, Picture::Layout(input.layout), order);
+    }
+    if (stereo && !picture.isStereo()) {
+        Q_EMIT failed(i18n("This camera frame cannot provide the selected pair. Check its packing in Camera Settings."));
+        return;
+    }
+    // cropEyes selects the stored samples of interleaved pictures; sideBySide
+    // alone would retain Picture's reconstructed intermediate views.
+    if (stereo && (picture.left.width() > 8192 || picture.left.height() > 16384
+        || qint64(picture.left.width()) * picture.left.height() > 64 * 1024 * 1024
+        || (input.layout == STEREO_POLICY_LAYOUT_ROWS && image.height() % 2)
+        || ((input.layout == STEREO_POLICY_LAYOUT_COLUMNS || input.layout == STEREO_POLICY_LAYOUT_CHECKERBOARD) && image.width() % 2))) {
+        Q_EMIT failed(i18n("This camera frame cannot be shown as two native views. Choose another camera resolution or packing."));
+        return;
+    }
+    QImage packed = (stereo ? Stereo::cropEyes(picture, picture.left.size()).packed : picture.original).convertToFormat(QImage::Format_RGBA8888);
+    if (packed.isNull()) {
+        Q_EMIT failed(i18n("This camera frame cannot provide the selected pair. Check its packing in Camera Settings."));
+        return;
+    }
+    if (m_mirrored) {
+        if (stereo) {
+            const int width = packed.width() / 2;
+            packed = Picture::fromViewsInTurn(packed.copy(0, 0, width, packed.height()).mirrored(true, false),
+                packed.copy(width, 0, width, packed.height()).mirrored(true, false), Picture::EyeOrder::LeftFirst).sideBySide();
+        } else {
+            packed = packed.mirrored(true, false);
+        }
+    }
+    packed = packed.convertToFormat(QImage::Format_RGBA8888);
+    if (stereo) m_effects.submit(packed);
+    else deliver(packed, false);
+}
+void StereoPreview::deliver(const QImage &packed, bool stereo)
+{
+    if (!m_sink) return;
+    QVideoFrameFormat format(packed.size(), QVideoFrameFormat::Format_RGBA8888);
+    format.setStereoMode(stereo ? QVideoFrameFormat::StereoMode::SideBySide : QVideoFrameFormat::StereoMode::None);
+    QVideoFrame video(format);
+    if (!video.map(QVideoFrame::WriteOnly))
+        return;
+    for (int y = 0; y < packed.height(); ++y)
+        memcpy(video.bits(0) + y * video.bytesPerLine(0), packed.constScanLine(y), size_t(packed.width()) * 4);
+    video.unmap();
+    m_capture = stereo ? packed : QImage();
+    if (stereo) Q_EMIT pairReady(packed);
+    Q_EMIT stereoFrameChanged(stereo);
+    m_sink->setVideoFrame(video);
+}
