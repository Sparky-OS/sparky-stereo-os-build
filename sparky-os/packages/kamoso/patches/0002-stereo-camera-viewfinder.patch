+void WebcamControl::setStereoSink(QVideoSink *sink)
+{
+    m_stereoSink = sink;
+    m_stereoPreview->setSink(sink);
+    Q_EMIT stereoChanged();
+}
+void WebcamControl::setStereoEnabled(bool enabled)
+{
+    if (enabled == stereoEnabled())
+        return;
+    if (m_stereoRecorder->busy()) { Q_EMIT m_kamoso->error(i18n("Finish saving the recording before changing 3D mode.")); return; }
+    Settings::setStereoEnabled(enabled);
+    Settings::self()->save();
+    stop();
+    m_viewfinder.reset(nullptr);
+    m_currentDevice.clear();
+    if (auto *window = m_surface ? m_surface->window() : nullptr) {
+        window->scheduleRenderJob(new PlayWebcam(this), QQuickWindow::BeforeSynchronizingStage);
+        window->update();
+    }
+    Q_EMIT stereoChanged();
+}
+void WebcamControl::openCameraSettings()
+{
+    QProcess::startDetached(QStringLiteral("systemsettings"), {QStringLiteral("kcm_sparkystereo_camera")});
+}
+void WebcamControl::openDisplaySettings()
+{
+    QProcess::startDetached(QStringLiteral("systemsettings"), {QStringLiteral("kcm_kscreen")});
