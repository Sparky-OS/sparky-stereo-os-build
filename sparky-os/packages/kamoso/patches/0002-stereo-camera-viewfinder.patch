+    void temporalOrderAndGaps()
+    {
+        QVideoSink output;
+        StereoPreview preview;
+        preview.setSink(&output);
+        preview.setMirrored(false);
+        QSignalSpy frames(&output, &QVideoSink::videoFrameChanged);
+        QSignalSpy errors(&preview, &StereoPreview::failed);
+        QImage red(4, 3, QImage::Format_RGBA8888), blue(red.size(), red.format());
+        red.fill(Qt::red); blue.fill(Qt::blue);
+        const auto send = [&](const QImage &image, quint64 offset, bool discontinuity = false) {
+            preview.present(image, discontinuity, offset, GST_VIDEO_MULTIVIEW_MODE_NONE, GST_VIDEO_MULTIVIEW_FLAGS_NONE);
+        };
+        preview.setPacking(QStringLiteral("frameSequentialLeftFirst"));
+        send(blue, 1); // Attaching halfway through a pair cannot supply its first eye.
+        QCOMPARE(frames.size(), 0);
+        send(red, 2);
+        send(blue, 3);
+        QCOMPARE(frames.size(), 1);
+        QCOMPARE(output.videoFrame().toImage().pixelColor(0, 0), QColor(Qt::red));
+        QCOMPARE(output.videoFrame().toImage().pixelColor(4, 0), QColor(Qt::blue));
+        send(red, 4);
+        send(blue, 7); // No pair across missing frames.
+        QCOMPARE(frames.size(), 1);
+        send(red, 8);
+        send(blue, 9, true);
+        QCOMPARE(frames.size(), 1);
+        send(red, GST_BUFFER_OFFSET_NONE);
+        QCOMPARE(errors.size(), 1);
+        QCOMPARE(frames.size(), 1);
+        preview.setPacking(QStringLiteral("frameSequentialRightFirst"));
+        send(blue, 10);
+        send(red, 11);
+        QCOMPARE(frames.size(), 2);
+        QCOMPARE(output.videoFrame().toImage().pixelColor(0, 0), QColor(Qt::red));
+        QCOMPARE(output.videoFrame().toImage().pixelColor(4, 0), QColor(Qt::blue));
+    }
