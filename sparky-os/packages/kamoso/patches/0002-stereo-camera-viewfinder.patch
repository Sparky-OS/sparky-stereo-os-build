+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#include "stereopublisher.h"
+#include <KLocalizedString>
+#include <QCoreApplication>
+#include <gst/app/gstappsrc.h>
+#include <gst/video/video.h>
+#include <cstring>
+
+StereoPublisher::StereoPublisher(QObject *parent) : QObject(parent)
+{
+    m_timer.setInterval(50);
+    connect(&m_timer, &QTimer::timeout, this, &StereoPublisher::poll);
+}
+StereoPublisher::~StereoPublisher() { reset(); }
+void StereoPublisher::reset()
+{
+    m_timer.stop();
+    if (m_pipeline) gst_element_set_state(m_pipeline, GST_STATE_NULL);
+    if (m_source) gst_object_unref(m_source);
+    if (m_bus) gst_object_unref(m_bus);
+    if (m_pipeline) gst_object_unref(m_pipeline);
+    m_pipeline = m_source = nullptr;
+    m_bus = nullptr;
+    m_size = {};
+    m_refused = false;
+}
+void StereoPublisher::refuse(const QString &reason)
+{
+    reset();
+    m_refused = true;
+    Q_EMIT failed(i18n("The 3D camera could not be shared with other programs: %1", reason));
+}
+void StereoPublisher::push(const QImage &pair)
+{
+    if (m_refused || pair.isNull() || pair.width() % 2) return;
+    if (m_pipeline && pair.size() != m_size) reset();
+    if (!m_pipeline) {
+        GError *error = nullptr;
+        m_pipeline = gst_parse_launch("appsrc name=pair is-live=true do-timestamp=true format=time block=false max-buffers=1 leaky-type=downstream ! pipewiresink name=camera mode=provide use-bufferpool=false sync=false", &error);
+        if (error || !m_pipeline) {
+            const QString detail = error ? QString::fromUtf8(error->message) : i18n("The camera publisher is unavailable.");
+            g_clear_error(&error);
+            refuse(detail);
+            return;
+        }
+        auto *sink = gst_bin_get_by_name(GST_BIN(m_pipeline), "camera");
+        const QByteArray name = "kamoso.stereo." + QByteArray::number(QCoreApplication::applicationPid());
+        const QByteArray description = i18n("Kamoso 3D camera").toUtf8();
+        auto *props = gst_structure_new("props", "media.class", G_TYPE_STRING, "Video/Source",
+            "media.role", G_TYPE_STRING, "Camera", "node.name", G_TYPE_STRING, name.constData(),
+            "node.description", G_TYPE_STRING, description.constData(), "node.virtual", G_TYPE_BOOLEAN, TRUE, nullptr);
+        g_object_set(sink, "stream-properties", props, nullptr);
+        gst_structure_free(props);
+        gst_object_unref(sink);
+        m_source = gst_bin_get_by_name(GST_BIN(m_pipeline), "pair");
+        auto *caps = gst_caps_new_simple("video/x-raw", "format", G_TYPE_STRING, "RGBA",
+            "width", G_TYPE_INT, pair.width(), "height", G_TYPE_INT, pair.height(),
+            "framerate", GST_TYPE_FRACTION, 0, 1, "views", G_TYPE_INT, 2,
+            "multiview-mode", G_TYPE_STRING, "side-by-side", "multiview-flags", GST_TYPE_VIDEO_MULTIVIEW_FLAGSET, 0, G_MAXUINT, nullptr);
+        gst_app_src_set_caps(GST_APP_SRC(m_source), caps);
+        gst_caps_unref(caps);
+        m_bus = gst_element_get_bus(m_pipeline);
+        m_size = pair.size();
+        if (gst_element_set_state(m_pipeline, GST_STATE_PLAYING) == GST_STATE_CHANGE_FAILURE) {
+            refuse(i18n("The camera publisher could not start."));
+            return;
+        }
+        m_timer.start();
+    }
+    const QImage rgba = pair.convertToFormat(QImage::Format_RGBA8888);
+    const size_t stride = size_t(rgba.width()) * 4;
+    auto *buffer = gst_buffer_new_allocate(nullptr, stride * rgba.height(), nullptr);
+    if (!buffer) { refuse(i18n("The camera frame could not be copied.")); return; }
+    for (int y = 0; y < rgba.height(); ++y)
+        gst_buffer_fill(buffer, size_t(y) * stride, rgba.constScanLine(y), stride);
+    if (gst_app_src_push_buffer(GST_APP_SRC(m_source), buffer) != GST_FLOW_OK)
+        refuse(i18n("The camera publisher refused a frame."));
+}
+void StereoPublisher::poll()
+{
+    if (!m_bus) return;
+    auto *message = gst_bus_pop_filtered(m_bus, GST_MESSAGE_ERROR);
+    if (!message) return;
+    GError *error = nullptr;
+    gst_message_parse_error(message, &error, nullptr);
+    const QString detail = QString::fromUtf8(error->message);
+    g_clear_error(&error);
+    gst_message_unref(message);
+    refuse(detail);
+}
