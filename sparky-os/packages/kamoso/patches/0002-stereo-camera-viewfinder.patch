+StereoRecorder::StereoRecorder(QObject *parent) : QObject(parent) {
+    m_timer.setInterval(20);
+    connect(&m_timer, &QTimer::timeout, this, &StereoRecorder::poll);
+}
+StereoRecorder::~StereoRecorder() { reset(); }
+void StereoRecorder::reset() {
+    m_timer.stop();
+    if(m_pipeline) gst_element_set_state(m_pipeline,GST_STATE_NULL);
+    if(m_source) gst_object_unref(m_source);
+    if(m_bus) gst_object_unref(m_bus);
+    if(m_pipeline) gst_object_unref(m_pipeline);
+    m_pipeline=nullptr; m_source=nullptr; m_bus=nullptr;
+    m_directory.reset(); m_stopping=false; m_frames=0;
+}
+QString StereoRecorder::start(const QUrl &destination, const QSize &size, const QString &encoder, const QString &container) {
+    qInfo() << "Stereo recording requested" << destination << size << encoder << container;
+    if(busy()) return i18n("The previous recording is still being saved.");
+    if(size.isEmpty() || size.width()%2) return i18n("Wait for a complete stereo frame before recording.");
+    // These hardware plugins have not yet passed the frame-packing SEI gate.
+    if(encoder != QLatin1String("x264enc"))
+        return i18n("%1 cannot yet write the stereo recording mark. Choose x264.",encoder);
+    if(container != QLatin1String("mp4") && container != QLatin1String("mkv"))
+        return i18n("Choose Matroska or MP4 for the recording.");
+    const char *muxName=container==QLatin1String("mp4")?"mp4mux":"matroskamux";
+    auto *mux=gst_element_factory_make(muxName,nullptr);
+    if(!mux) return i18n("The %1 muxer is unavailable.",QString::fromLatin1(muxName));
+    if(container==QLatin1String("mp4")) {
+        gboolean writes=false;
+        if(g_object_class_find_property(G_OBJECT_GET_CLASS(mux),"writes-st3d"))
+            g_object_get(mux,"writes-st3d",&writes,nullptr);
+        if(!writes) {
+            gst_object_unref(mux);
+            return i18n("This MP4 muxer cannot write the stereo mark. Install the edition's updated GStreamer plugins.");
+        }
+    }
+    gst_object_unref(mux);
+    if(destination.isLocalFile()) {
+        const QFileInfo info(destination.toLocalFile());
+        if(info.exists()) return i18n("The recording already exists. Choose another name.");
+        if(!QDir().mkpath(info.absolutePath())) return i18n("The recording folder could not be created.");
+        m_directory=std::make_shared<QTemporaryDir>(info.absolutePath()+QStringLiteral("/.kamoso-XXXXXX"));
+    } else m_directory=std::make_shared<QTemporaryDir>();
+    if(!m_directory->isValid()) { reset(); return i18n("The recording's temporary folder could not be created."); }
+    m_path=m_directory->filePath(QStringLiteral("capture.")+container);
+    m_destination=destination;m_size=size;
+    const QByteArray description=QByteArray("appsrc name=pair is-live=true do-timestamp=true format=time block=false max-buffers=8 ! queue max-size-buffers=8 max-size-bytes=0 max-size-time=0 ! videoconvert ! video/x-raw,format=")+(size.height()%2?"Y444":"I420")+" ! x264enc tune=zerolatency ! h264parse ! "+muxName+" name=mux ! filesink name=file autoaudiosrc name=audio ! audioconvert ! audioresample quality=10 ! avenc_aac ! aacparse ! queue ! mux.";
+    GError *error=nullptr;
+    m_pipeline=gst_parse_launch(description.constData(),&error);
+    if(error || !m_pipeline) {
+        const QString message=error?QString::fromUtf8(error->message):i18n("The recording pipeline could not start.");
+        if(error) g_error_free(error);
+        reset();return message;
+    }
+    auto *file=gst_bin_get_by_name(GST_BIN(m_pipeline),"file");
+    g_object_set(file,"location",m_path.toUtf8().constData(),nullptr);gst_object_unref(file);
+    m_source=gst_bin_get_by_name(GST_BIN(m_pipeline),"pair");
+    GstCaps *caps=gst_caps_new_simple("video/x-raw","format",G_TYPE_STRING,"RGBA","width",G_TYPE_INT,size.width(),"height",G_TYPE_INT,size.height(),"framerate",GST_TYPE_FRACTION,0,1,"multiview-mode",G_TYPE_STRING,"side-by-side","views",G_TYPE_INT,2,nullptr);
+    gst_app_src_set_caps(GST_APP_SRC(m_source),caps);gst_caps_unref(caps);
+    m_bus=gst_element_get_bus(m_pipeline);
+    if(gst_element_set_state(m_pipeline,GST_STATE_PLAYING)==GST_STATE_CHANGE_FAILURE) {
+        reset();return i18n("The recording pipeline could not start.");
+    }
+    m_timer.start();return {};
+}
+void StereoRecorder::push(const QImage &image) {
+    if(!m_pipeline || m_stopping) return;
+    if(image.size()!=m_size) { reset();Q_EMIT failed(i18n("The camera resolution changed during recording. The incomplete recording was not saved."));return; }
+    guint64 queued=0;g_object_get(m_source,"current-level-buffers",&queued,nullptr);
+    if(queued>=8) { reset();Q_EMIT failed(i18n("The encoder could not keep up. The incomplete recording was not saved."));return; }
+    const QImage rgba=image.convertToFormat(QImage::Format_RGBA8888);
+    auto *buffer=gst_buffer_new_allocate(nullptr,gsize(rgba.width())*rgba.height()*4,nullptr);
+    for(int y=0;y<rgba.height();++y) gst_buffer_fill(buffer,gsize(y)*rgba.width()*4,rgba.constScanLine(y),gsize(rgba.width())*4);
+    ++m_frames;
+    const auto flow=gst_app_src_push_buffer(GST_APP_SRC(m_source),buffer);
+    if(flow!=GST_FLOW_OK) { reset();Q_EMIT failed(i18n("The encoder refused a stereo frame. The incomplete recording was not saved.")); }
+}
+void StereoRecorder::stop() {
+    if(!m_pipeline || m_stopping) return;
+    if (!m_frames) { reset(); Q_EMIT failed(i18n("No stereo frames arrived during recording. No file was saved.")); return; }
+    qInfo() << "Finalizing stereo recording" << m_frames << "frames";
+    m_stopping=true;
+    gst_app_src_end_of_stream(GST_APP_SRC(m_source));
+    auto *audio=gst_bin_get_by_name(GST_BIN(m_pipeline),"audio");
+    gst_element_call_async(audio, [](GstElement *element, gpointer) { gst_element_send_event(element,gst_event_new_eos()); }, nullptr, nullptr);
+    gst_object_unref(audio);
+}
+void StereoRecorder::poll() {
+    if(!m_bus) return;
+    auto *message=gst_bus_pop_filtered(m_bus,GstMessageType(GST_MESSAGE_ERROR|GST_MESSAGE_EOS));
+    if(!message) return;
+    if(GST_MESSAGE_TYPE(message)==GST_MESSAGE_ERROR) {
+        GError *error=nullptr;gst_message_parse_error(message,&error,nullptr);
+        const QString text=QString::fromUtf8(error->message);g_error_free(error);gst_message_unref(message);
+        reset();Q_EMIT failed(i18n("The recording could not be saved: %1",text));return;
+    }
+    gst_message_unref(message);
+    const auto directory=m_directory;const auto path=m_path;const auto destination=m_destination;
+    reset();
+    if(destination.isLocalFile()) {
+        if(!QFile::rename(path,destination.toLocalFile())) { directory->setAutoRemove(false); Q_EMIT failed(i18n("The completed recording could not be moved. It is kept at %1.",path)); }
+        else Q_EMIT saved(destination);
+    } else {
+        auto *job=KIO::copy(QUrl::fromLocalFile(path),destination);
+        connect(job,&KJob::result,this,[this,job,directory,destination,path] {
+            if(job->error()) { directory->setAutoRemove(false); Q_EMIT failed(i18n("The recording could not be copied. It is kept at %1: %2",path,job->errorString())); } else Q_EMIT saved(destination);
+        });
+    }
+}
