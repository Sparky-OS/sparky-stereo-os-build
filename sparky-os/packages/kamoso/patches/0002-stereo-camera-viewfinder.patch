+            QTRY_VERIFY_WITH_TIMEOUT(!preview.m_first.isNull(), 60000);
+            QCOMPARE(push(second, 5, true), GST_FLOW_OK);
+            QTRY_VERIFY_WITH_TIMEOUT(preview.m_first.isNull(), 60000);
+            QVERIFY(!output.videoFrame().isValid());
+            QCOMPARE(push(first, GST_BUFFER_OFFSET_NONE), GST_FLOW_OK);
+            QTRY_COMPARE_WITH_TIMEOUT(errors.size(), 1, 60000);
+            QVERIFY(errors.first().first().toString().contains(QStringLiteral("order of alternating frames")));
+            QVERIFY(!output.videoFrame().isValid());
