+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#include "stereorecorder.h"
+#include <QtTest>
+#include <QTemporaryDir>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonObject>
+#include <QJsonDocument>
+class StereoRecorderTest : public QObject {
+    Q_OBJECT
+    static void snapshot(GstElement *pipeline,const QString &path) {
+        QJsonArray rows;GValue item=G_VALUE_INIT;
+        auto *iterator=gst_bin_iterate_recurse(GST_BIN(pipeline));
+        while(gst_iterator_next(iterator,&item)==GST_ITERATOR_OK) {
+            auto *child=GST_ELEMENT(g_value_get_object(&item));
+            auto *factory=gst_element_get_factory(child);
+            if(!factory){g_value_reset(&item);continue;}
+            QJsonObject row{{QStringLiteral("factory"),QString::fromUtf8(gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory)))}};
+            for(const char *prop:{"quality","bitrate","pass","quantizer","tune","speed-preset"}) {
+                auto *spec=g_object_class_find_property(G_OBJECT_GET_CLASS(child),prop);
+                if(!spec || !(spec->flags&G_PARAM_READABLE))continue;
+                GValue value=G_VALUE_INIT;g_value_init(&value,spec->value_type);g_object_get_property(G_OBJECT(child),prop,&value);
+                auto *text=g_strdup_value_contents(&value);row[QString::fromLatin1(prop)]=QString::fromUtf8(text);g_free(text);g_value_unset(&value);
+            }
+            for(const char *name:{"sink","src"}) {
+                auto *pad=gst_element_get_static_pad(child,name);if(!pad)continue;
+                auto *caps=gst_pad_get_current_caps(pad);
+                if(caps){auto *text=gst_caps_to_string(caps);row[QString::fromLatin1(name)]=QString::fromUtf8(text);g_free(text);gst_caps_unref(caps);}
+                gst_object_unref(pad);
+            }
+            rows.append(row);g_value_reset(&item);
+        }
+        g_value_unset(&item);gst_iterator_free(iterator);
+        QFile file(path);if(file.open(QIODevice::WriteOnly))file.write(QJsonDocument(rows).toJson());
+    }
+private Q_SLOTS:
+    void initTestCase() { gst_init(nullptr,nullptr); }
+    void unmarkedEncoders() {
+        StereoRecorder recorder;
+        QTemporaryDir dir;
+        for(const auto &encoder:{"vah264enc","nvh264enc","vah265enc","nvh265enc"}) {
+            auto path=dir.filePath(QStringLiteral("refused.mkv"));
+            QVERIFY(recorder.start(QUrl::fromLocalFile(path),QSize(128,48),QString::fromLatin1(encoder),QStringLiteral("mkv")).contains(QString::fromLatin1(encoder)));
+            QVERIFY(!recorder.busy());QVERIFY(!QFileInfo::exists(path));
+        }
+    }
+    void overload() {
+        QTemporaryDir dir;
+        StereoRecorder recorder;
+        QImage image(128,48,QImage::Format_RGBA8888);
+        for(int y=0;y<48;++y) for(int x=0;x<128;++x) image.setPixelColor(x,y,x<64?Qt::red:Qt::blue);
+        // Block the source pad so the real appsrc queue cannot drain. This
+        // brings out overload deterministically without adding machine load.
+        for (int recording=0;recording<2;++recording) {
+            const auto path=dir.filePath(QStringLiteral("overload-%1.mkv").arg(recording));
+            QSignalSpy saved(&recorder,&StereoRecorder::saved),failed(&recorder,&StereoRecorder::failed);
+            QSignalSpy warning(&recorder,SIGNAL(warning(QString)));
+            const auto error=recorder.start(QUrl::fromLocalFile(path),image.size(),QStringLiteral("x264enc"),QStringLiteral("mkv"));
+            QVERIFY2(error.isEmpty(),qPrintable(error));
+            auto *pad=gst_element_get_static_pad(recorder.m_source,"src");
+            const auto probe=gst_pad_add_probe(pad,GST_PAD_PROBE_TYPE_BLOCK_DOWNSTREAM,
+                [](GstPad *,GstPadProbeInfo *,gpointer){return GST_PAD_PROBE_OK;},nullptr,nullptr);
+            for(int n=0;n<32;++n)recorder.push(image);
+            gst_pad_remove_probe(pad,probe);gst_object_unref(pad);
+            QVERIFY2(recorder.busy(),"Overload erased the recording instead of dropping a pair");
+            QCOMPARE(failed.count(),0);QCOMPARE(warning.count(),1);
+            for(int n=0;n<30;++n){recorder.push(image);QTest::qWait(33);}
+            recorder.stop();
+            QTRY_VERIFY_WITH_TIMEOUT(!saved.isEmpty() || !failed.isEmpty(),60000);
+            QCOMPARE(failed.count(),0);QCOMPARE(saved.count(),1);QCOMPARE(warning.count(),1);
+            QVERIFY(QFileInfo(path).size()>0);
+        }
+    }
+    void containers_data() {
+        QTest::addColumn<QString>("container");
+        QTest::newRow("Matroska")<<QStringLiteral("mkv");
+        QTest::newRow("MP4")<<QStringLiteral("mp4");
+    }
+    void containers() {
+        QFETCH(QString,container);
+        QTemporaryDir dir;
+        const auto kept=qEnvironmentVariable("KAMOSO_RECORD_TEST_OUTPUT");
+        const auto path=(kept.isEmpty()?dir.path():kept)+QStringLiteral("/recording.")+container;
+        StereoRecorder recorder;
+        QSignalSpy saved(&recorder,&StereoRecorder::saved),failed(&recorder,&StereoRecorder::failed);
+        const auto error=recorder.start(QUrl::fromLocalFile(path),QSize(128,48),QStringLiteral("x264enc"),container);
+        if(container==QLatin1String("mp4") && qEnvironmentVariableIsSet("KAMOSO_EXPECT_OLD_MUX")) {
+            QVERIFY(!error.isEmpty());QVERIFY(!QFileInfo::exists(path));return;
+        }
+        QVERIFY2(error.isEmpty(),qPrintable(error));
+        QImage image(128,48,QImage::Format_RGBA8888);
+        for(int y=0;y<48;++y) for(int x=0;x<128;++x) image.setPixelColor(x,y,x<64?Qt::red:Qt::blue);
+        for(int n=0;n<90 && failed.isEmpty();++n) {recorder.push(image);QTest::qWait(33);}
+        if(!kept.isEmpty())snapshot(recorder.m_pipeline,path+QStringLiteral(".pipeline.json"));
+        recorder.stop();
+        QTRY_VERIFY_WITH_TIMEOUT(!saved.isEmpty() || !failed.isEmpty(),60000);
+        QVERIFY2(failed.isEmpty(),failed.isEmpty()?"":qPrintable(failed.first().first().toString()));
+        QVERIFY(QFileInfo(path).size()>0);QVERIFY(!recorder.busy());
+        QVERIFY(!recorder.start(QUrl::fromLocalFile(path),QSize(128,48),QStringLiteral("x264enc"),container).isEmpty());
+    }
+};
+QTEST_GUILESS_MAIN(StereoRecorderTest)
