+    bool busy() const { return m_pipeline != nullptr; }
+Q_SIGNALS:
+    void failed(const QString &message);
+    void saved(const QUrl &destination);
+private:
+    void poll();
+    void reset();
+    GstElement *m_pipeline = nullptr;
+    GstElement *m_source = nullptr;
+    GstBus *m_bus = nullptr;
+    QTimer m_timer;
+    QSize m_size;
+    bool m_stopping = false;
+    QUrl m_destination;
+    std::shared_ptr<QTemporaryDir> m_directory;
+    QString m_path;
+    quint64 m_frames = 0;
+};
