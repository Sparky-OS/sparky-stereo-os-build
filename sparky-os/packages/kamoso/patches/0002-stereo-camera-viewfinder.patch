+class StereoPublisherTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase() { gst_init(nullptr, nullptr); }
+    void invalidPairIsNotPublished() {
+        StereoPublisher publisher;
+        QSignalSpy failed(&publisher, &StereoPublisher::failed);
+        publisher.push({});
+        publisher.push(QImage(3, 2, QImage::Format_RGBA8888));
+        QCOMPARE(failed.count(), 0);
+    }
+    void unavailablePublisherIsSaidOnceUntilReset() {
+        auto *registry = gst_registry_get();
+        auto *factory = gst_registry_find_feature(registry, "pipewiresink", GST_TYPE_ELEMENT_FACTORY);
+        QVERIFY(factory);
+        gst_registry_remove_feature(registry, factory);
+        StereoPublisher publisher;
+        QSignalSpy failed(&publisher, &StereoPublisher::failed);
+        QImage pair(4, 2, QImage::Format_RGBA8888); pair.fill(Qt::red);
+        publisher.push(pair);
+        const int first = failed.count();
+        publisher.push(pair);
+        const int second = failed.count();
+        publisher.reset();
+        publisher.push(pair);
+        const int third = failed.count();
+        gst_registry_add_feature(registry, factory);
+        gst_object_unref(factory);
+        QCOMPARE(first, 1); QCOMPARE(second, 1); QCOMPARE(third, 2);
+        QVERIFY(failed.at(0).at(0).toString().contains(QStringLiteral("could not be shared")));
+        QVERIFY(failed.at(0).at(0).toString().contains(QStringLiteral("pipewiresink")));
+    }
+};
