+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#pragma once
+#include <QObject>
+#include <QImage>
+#include <QTimer>
+#include <QElapsedTimer>
+#include <gst/gst.h>
+#include <array>
+
+// Each view has its own filter instance and history. The GUI never waits for a
+// streaming thread: one complete pair is in flight, and polling is nonblocking.
+class StereoEffects : public QObject
+{
+    Q_OBJECT
+    friend class StereoEffectsTest;
+public:
+    explicit StereoEffects(QObject *parent = nullptr);
+    ~StereoEffects() override;
+    void setFilter(const QString &filter);
+    void reset();
+    void submit(const QImage &pair);
+Q_SIGNALS:
+    void ready(const QImage &pair);
+    void failed(const QString &message);
+private:
+    bool start(const QSize &size);
+    void poll();
+    void refuse(const QString &reason);
+    struct Eye {
+        GstElement *pipeline = nullptr;
+        GstElement *source = nullptr;
+        GstElement *sink = nullptr;
+        GstBus *bus = nullptr;
+        QImage result;
+    };
+    std::array<Eye, 2> m_eyes;
+    QString m_filter;
+    QImage m_input;
+    QSize m_size;
+    QTimer m_timer;
+    QElapsedTimer m_clock;
+    bool m_pending = false;
+    bool m_refused = false;
+};
