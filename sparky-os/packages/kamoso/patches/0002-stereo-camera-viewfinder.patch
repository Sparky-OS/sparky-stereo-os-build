+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+#pragma once
+#include <QObject>
+#include <QImage>
+#include <QPointer>
+#include <QVideoSink>
+#include <stereo-policy.h>
+#include <gst/gst.h>
+#include <gst/video/video.h>
+#include <atomic>
+
+class StereoPreview : public QObject
+{
+    Q_OBJECT
+    friend class StereoPreviewTest;
+public:
+    explicit StereoPreview(QObject *parent = nullptr);
+    void setSink(QVideoSink *sink);
+    void setPacking(const QString &id);
+    void setMirrored(bool mirrored);
+    GstElement *createSink();
+    bool hasPacking() const;
+    static QString cameraPacking(GstStructure *properties);
+Q_SIGNALS:
+    void failed(const QString &message);
+    void stereoFrameChanged(bool stereo);
+private:
+    void present(const QImage &image, bool discontinuity, quint64 offset, GstVideoMultiviewMode mode, GstVideoMultiviewFlags flags);
+    QPointer<QVideoSink> m_sink;
+    stereo_policy_input_format m_format {};
+    QImage m_first;
+    quint64 m_firstOffset = GST_BUFFER_OFFSET_NONE;
+    bool m_mirrored = true;
+    bool m_unknownPacking = false;
+    std::atomic_uint64_t m_generation = 0;
+    std::atomic_bool m_pending = false;
+};
