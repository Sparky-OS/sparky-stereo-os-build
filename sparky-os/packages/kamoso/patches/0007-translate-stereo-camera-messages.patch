--- /dev/null
+++ b/autotests/catalogues.py
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+"""Check the installed gettext meaning of every edition message in all nine catalogues."""
+import argparse
+from collections import Counter
+import gettext
+import io
+from pathlib import Path
+import re
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('source', type=Path)
+parser.add_argument('--table', type=Path)
+args = parser.parse_args()
+# These untouched upstream strings belong to the original Debian catalogue.
+# Keeping the baseline here lets the test detect new strings in native and quilt builds alike.
+baseline = set(Path(__file__).with_name('upstream-msgids.txt').read_text().splitlines())
+source = args.source / 'src'
+literal = re.compile(r'\b(?:i18n|I18N_NOOP)\s*\(\s*"([^"\\]*(?:\\.[^"\\]*)*)"')
+messages = set()
+for path in source.rglob('*'):
+    if path.suffix in ('.cpp', '.qml', '.h'):
+        messages.update(literal.findall(path.read_text()))
+messages -= baseline
+assert messages
+languages = 'de es fr ja ko pl pt_BR zh_CN zh_TW'.split()
+rows = {key: [key] for key in sorted(messages)}
+errors = []
+for lang in languages:
+    po = args.source / 'po' / lang / 'kamoso.po'
+    compiled = subprocess.check_output(['msgfmt', '--check-format', '-o', '-', po])
+    catalog = gettext.GNUTranslations(io.BytesIO(compiled))._catalog
+    for key, row in rows.items():
+        value = catalog.get(key, '')
+        if not value.strip() or Counter(re.findall(r'%\d+', key)) != Counter(re.findall(r'%\d+', value)):
+            errors.append(f'{lang}: {key}')
+        row.append(value)
+print(f'{len(rows)} messages × {len(languages)} catalogues; {len(errors)} missing or invalid')
+if errors:
+    raise SystemExit('\n'.join(errors))
+if args.table:
+    with args.table.open('w') as table:
+        for row in [['English', *languages], ['---'] * 10, *rows.values()]:
+            print('| ' + ' | '.join(s.replace('|', r'\|') for s in row) + ' |', file=table)
