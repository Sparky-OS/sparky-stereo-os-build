+// The reason an effect preview stopped, as GStreamer gives it: the error's own text, then its detail.
+static QString errorReason(GstMessage* msg)
+{
+    GError *e = nullptr;
+    gchar *debug = nullptr;
+    gst_message_parse_error(msg, &e, &debug);
+    QString reason = e ? QString::fromUtf8(e->message) : QString();
+    if (debug && *debug)
+        reason += QStringLiteral(" (%1)").arg(QString::fromUtf8(debug));
