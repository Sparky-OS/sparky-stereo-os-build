+        view.resize(600, 2400);
+        view.setSource(QUrl::fromLocalFile(QStringLiteral(KAMOSO_CONFIG_QML)));
+        if (view.status() != QQuickView::Ready) {
+            qWarning() << view.errors();
+            return nullptr;
         }
+        view.show();
+        if (!QTest::qWaitForWindowExposed(&view))
+            return nullptr;
+        QQuickItem *grid = view.rootObject();
+        if (!QTest::qWaitFor([grid] { return grid->property("count").toInt() == 31; }))
