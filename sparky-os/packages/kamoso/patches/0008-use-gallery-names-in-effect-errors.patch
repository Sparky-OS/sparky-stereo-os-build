+#include "effectname.h"
+#include <KLocalizedString>
+
+QString cameraEffectName(const QString &filter)
+{
+    static const struct {
+        const char *filter;
+        KLocalizedString name;
+    } effects[] = {
+        {"identity", ki18n("No effect")},
+        {"bulge", ki18n("Bulge")},
+        {"frei0r-filter-cartoon", ki18n("Cartoon")},
+        {"frei0r-filter-twolay0r", ki18n("Twolay0r")},
+        {"dicetv", ki18n("Dice")},
+        {"frei0r-filter-distort0r", ki18n("Distort0r")},
+        {"edgetv", ki18n("Edges")},
+        {"coloreffects preset=heat", ki18n("Heat")},
+        {"videobalance saturation=0 ! agingtv", ki18n("Old film")},
+        {"videobalance saturation=1.5 hue=-0.5", ki18n("Hue −0.5")},
+        {"kaleidoscope", ki18n("Kaleidoscope")},
+        {"videobalance saturation=1.5 hue=+0.5", ki18n("Hue +0.5")},
+        {"mirror", ki18n("Mirror")},
+        {"videobalance saturation=0", ki18n("Grayscale")},
+        {"optv", ki18n("Optical art")},
+        {"pinch", ki18n("Pinch")},
+        {"quarktv", ki18n("Quark")},
+        {"radioactv", ki18n("Radioactive")},
+        {"revtv", ki18n("Waveform")},
+        {"rippletv", ki18n("Ripples")},
+        {"videobalance saturation=2", ki18n("Vivid colors")},
+        {"coloreffects preset=sepia", ki18n("Sepia")},
+        {"shagadelictv", ki18n("Shagadelic")},
+        {"square", ki18n("Square")},
+        {"streaktv", ki18n("Streaks")},
+        {"stretch", ki18n("Stretch")},
+        {"frei0r-filter-delay0r delaytime=1", ki18n("Delay")},
+        {"twirl", ki18n("Twirl")},
+        {"vertigotv", ki18n("Vertigo")},
+        {"warptv", ki18n("Warp")},
+        {"coloreffects preset=xray", ki18n("X-ray")},
+    };
+    for (const auto &effect : effects) {
+        if (filter == QLatin1String(effect.filter))
+            return effect.name.toString();
+    }
+    return filter;
+}
