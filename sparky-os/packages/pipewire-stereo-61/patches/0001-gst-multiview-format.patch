+static void
+add_multiview (struct spa_pod_builder *b, const GstStructure *s)
+{
+  const GValue *value = gst_structure_get_value (s, "multiview-mode");
+  struct spa_pod_frame f;
+  struct spa_pod_choice *choice;
+  const char *name;
+  int i, count = 0, views;
+  if (value) {
+    for (i = 0; (name = get_nth_string (value, i)); i++) {
+      GstVideoMultiviewMode mode = gst_video_multiview_mode_from_caps_string (name);
+      if (mode == GST_VIDEO_MULTIVIEW_MODE_NONE)
+        continue;
+      if (count++ == 0) {
+        spa_pod_builder_prop (b, SPA_FORMAT_VIDEO_multiviewMode, 0);
+        spa_pod_builder_push_choice (b, &f, SPA_CHOICE_Enum, 0);
+      }
+      spa_pod_builder_id (b, mode);
+    }
+    if (count) {
+      choice = spa_pod_builder_pop (b, &f);
+      if (count == 1)
+        choice->body.type = SPA_CHOICE_None;
+    }
+  }
+  value = gst_structure_get_value (s, "multiview-flags");
+  /* An unconstrained flagset is not a fixed format. Preserve negotiated flags. */
+  if (value && GST_VALUE_HOLDS_FLAG_SET (value) &&
+      gst_value_get_flagset_mask (value) == G_MAXUINT) {
+    spa_pod_builder_prop (b, SPA_FORMAT_VIDEO_multiviewFlags, 0);
+    spa_pod_builder_id (b, gst_value_get_flagset_flags (value));
+  }
+  value = gst_structure_get_value (s, "views");
+  if (value) {
+    for (i = 0; get_nth_int (value, i, &views); i++) {
+      if (i == 0) {
+        spa_pod_builder_prop (b, SPA_FORMAT_VIDEO_views, 0);
+        spa_pod_builder_push_choice (b, &f, get_range_type (value), 0);
+      }
+      spa_pod_builder_int (b, views);
+    }
+    if (i > 0) {
+      choice = spa_pod_builder_pop (b, &f);
+      if (i == 1)
+        choice->body.type = SPA_CHOICE_None;
+    }
+  }
+}
