[Unit]
Description=Power profile kept off the settings CoreCtrl and LACT hold
Documentation=file:///usr/share/doc/sparky-stereo-corectrl/README.md
ConditionPathExists=|/usr/libexec/corectrl/corectrl_helper
ConditionPathExists=|/usr/bin/lact
After=dbus.service

[Service]
Type=exec
ExecStart=/usr/libexec/sparky-stereo-corectrl/knob-owner watch
Restart=on-failure
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
