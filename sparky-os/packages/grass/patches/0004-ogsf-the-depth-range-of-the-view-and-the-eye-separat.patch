+/*!
+   \brief Get the distances of the nearest and the farthest pixel of the
+   view
+
+   Reads the depth buffer of the viewport as the last drawing left it:
+   a pixel still at the cleared depth shows no data.
+
+   \param[out] nearest, farthest distances from the camera plane
+
+   \return 1 if a pixel shows data
+   \return 0 otherwise
+ */
+int GS_get_depth_range(double *nearest, double *farthest)
+{
+    GLint viewport[4];
+    GLfloat *depth;
+    float lo = 1.f, hi = 0.f;
+    double n = Gd.nearclip, f = Gd.farclip;
+    long i, count;
+
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    if (viewport[2] <= 0 || viewport[3] <= 0)
+        return 0;
+    count = (long)viewport[2] * viewport[3];
+    depth = (GLfloat *)G_malloc(count * sizeof(GLfloat));
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(viewport[0], viewport[1], viewport[2], viewport[3],
+                 GL_DEPTH_COMPONENT, GL_FLOAT, depth);
+    for (i = 0; i < count; i++) {
+        if (depth[i] >= 1.f)
+            continue;
+        if (depth[i] < lo)
+            lo = depth[i];
+        if (depth[i] > hi)
+            hi = depth[i];
+    }
+    G_free(depth);
+    if (lo > hi)
+        return 0;
+
+    /* the perspective of gsd_set_view(): window depth d is n f / (f - d (f - n)) */
+    *nearest = n * f / (f - lo * (f - n));
+    *farthest = n * f / (f - hi * (f - n));
+
+    return 1;
+}
+
+/*!
+   \brief Get the separation of the eyes that fits the nearest and the
+   farthest pixel inside depth limits (see gsd_get_stereo_separation())
+
+   \param nearest, farthest distances, from GS_get_depth_range()
+   \param sunk, popped limits in pixels of the view
+   \param width the view's width in pixels
+
+   \return separation for GS_set_eye_separation()
+ */
+float GS_get_stereo_separation(double nearest, double farthest, double sunk,
+                               double popped, int width)
+{
+    return (float)gsd_get_stereo_separation(&Gv, &Gd, nearest, farthest, sunk,
+                                            popped, width);
+}
+
 /*!
    \brief Get twist value
 
diff --git a/lib/ogsf/gsd_views.c b/lib/ogsf/gsd_views.c
index 4295d19..0fce2f0 100644
--- a/lib/ogsf/gsd_views.c
+++ b/lib/ogsf/gsd_views.c
@@ -158,6 +158,54 @@ static double gsd_get_focus_dist(geoview *gv)
     return gv->focus_dist > 0. ? gv->focus_dist : 1.;
 }
 
+/*!
+   \brief Get the separation of the eyes that fits a range of distances
+   inside depth limits
+
+   The eyes look the same way and their frustums meet at the focus
+   distance f (gsd_set_view()), so a point at distance z is
+   k t (1 - f / z) pixels to the right in the right eye, t being the
+   separation as a fraction of f and k half the view's width in pixels
+   over the tangent of half the horizontal field of view.
+
+   \param gv view (geoview)
+   \param gd display (geodisplay)
+   \param nearest, farthest distances of the nearest and the farthest pixel
+   \param sunk, popped how far behind and in front of the screen anything
+   may be, in pixels of the view
+   \param width the view's width in pixels
+
+   \return the largest separation under which every distance stays inside
+   the limits (infinity at the sunk limit when nothing is off the focus
+   plane), 0 when nothing can be fitted
+ */
+double gsd_get_stereo_separation(geoview *gv, geodisplay *gd, double nearest,
+                                 double farthest, double sunk, double popped,
+                                 int width)
+{
+    double f, k, t = -1.;
+
+    f = gsd_get_focus_dist(gv);
+    k = .5 * width /
+        (tan((double).05 * (gv->fov) * M_PI / 180.) * GS_get_aspect());
+    if (k <= 0. || nearest <= 0. || nearest > farthest || sunk < 0. ||
+        popped < 0.)
+        return 0.;
+
+    if (farthest > f)
+        t = sunk / (k * (1. - f / farthest));
+    if (nearest < f) {
+        double near_t = popped / (k * (f / nearest - 1.));
+
+        if (t < 0. || near_t < t)
+            t = near_t;
+    }
+    if (t < 0.)
+        t = sunk / k;
+
+    return t;
+}
+
