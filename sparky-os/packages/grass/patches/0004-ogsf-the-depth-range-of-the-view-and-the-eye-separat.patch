 lib/ogsf/gs2.c            | 66 ++++++++++++++++++++++++++++++++++++++-
 lib/ogsf/gsd_views.c      | 50 ++++++++++++++++++++++++++++-
 3 files changed, 118 insertions(+), 2 deletions(-)

