diff --git a/src/gui/QGLView2.cc b/src/gui/QGLView2.cc
index beb2b1e4f..6a2fefaa4 100644
--- a/src/gui/QGLView2.cc
+++ b/src/gui/QGLView2.cc
@@ -24,7 +24,8 @@
  */
 
 /*
- * This file defines two helper functions for saving and restoring OpenGL contexts.
+ * This file defines two helper functions for saving and restoring OpenGL contexts,
+ * and one that tells which format a new context gets.
  * They are in a separate file (rather than in the more obvious QGLView.cc) because
  * <QOpenGLContext> is incompatible with GLEW and produces compilation warning messages.
  * Putting them in a separate file in helper functions allows the main file to need
@@ -33,6 +34,7 @@
  * See also the discussion at QGLView::mouseDoubleClickEvent().
  */
 #include <QOpenGLContext>
+#include <QSurfaceFormat>
 
 QOpenGLContext *getGLContext()
 {
@@ -51,3 +53,16 @@ void setGLContext(QOpenGLContext *ctx)
     ctx->makeCurrent(ctx->surface());
   }
 }
+
+QSurfaceFormat createdContextFormat(const QSurfaceFormat& format)
+{
+  /*
+   * Qt picks the framebuffer configuration when it creates the context, so the
+   * created context's format is what the system gives for the format asked.  No
+   * surface is needed, so no window is shown, and the current context stays current.
+   */
+  QOpenGLContext context;
+  context.setFormat(format);
+  if (!context.create()) return {};
+  return context.format();
+}
diff --git a/src/gui/Stereo3dView.cc b/src/gui/Stereo3dView.cc
index ba26af258..f5c4ee3ab 100644
--- a/src/gui/Stereo3dView.cc
+++ b/src/gui/Stereo3dView.cc
@@ -3,6 +3,8 @@
 #include <QString>
 #include <QtGlobal>
 
+#include "gui/qtgettext.h"
+
 #if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0)
 
 // QGLView.h first: the OpenGL loader must come before the Qt OpenGL headers
@@ -12,6 +14,14 @@
 #include <QOpenGLWidget>
 #include <QSettings>
 #include <QSurfaceFormat>
+#include <optional>
+
+namespace {
+
+// Whether the 3D view gets stereo buffers, once it is known
+std::optional<bool> stereoBuffers;
+
+}  // namespace
 
 Stereo3dView::Stereo3dView(QGLView& view) : view(view), stereo(Settings::Settings::stereo3dView.value())
 {
@@ -27,6 +37,30 @@ void Stereo3dView::requestStereoBuffers(QSurfaceFormat& format)
   }
 }
 
+bool Stereo3dView::isAvailable()
+{
+  if (!stereoBuffers) {
+    // Qt picks the framebuffer configuration when it creates the context, and QOpenGLWidget draws
+    // each eye only when its own context's format is stereo, so a context with the view's format
+    // gives the same answer the view gets.
+    auto format = QGLView::compatibleWidgetFormat();
+    format.setOption(QSurfaceFormat::StereoBuffers);
+    stereoBuffers = createdContextFormat(format).stereo();
+  }
+  return *stereoBuffers;
+}
+
+QString Stereo3dView::unavailableReason()
+{
+  return _("OpenGL on this system has no stereo buffers, which the stereo 3D view needs.");
+}
+
+void Stereo3dView::initialize()
+{
+  // A view that asked for stereo buffers knows from its own format whether it got them
+  if (stereo) stereoBuffers = view.format().stereo();
+}
+
 bool Stereo3dView::drawsEyes() const
 {
   return stereo && view.format().stereo();
@@ -74,6 +108,20 @@ void Stereo3dView::requestStereoBuffers(QSurfaceFormat& /*format*/)
 {
 }
 
+bool Stereo3dView::isAvailable()
+{
+  return false;
+}
+
+QString Stereo3dView::unavailableReason()
+{
+  return _("The stereo 3D view needs OpenSCAD built with Qt 6.5 or later.");
+}
+
+void Stereo3dView::initialize()
+{
+}
+
 void Stereo3dView::beginEye()
 {
 }
