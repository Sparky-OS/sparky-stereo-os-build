diff --git a/src/gui/StereoDepthLimits.cc b/src/gui/StereoDepthLimits.cc
new file mode 100644
index 000000000..cfb678934
--- /dev/null
+++ b/src/gui/StereoDepthLimits.cc
@@ -0,0 +1,55 @@
+#include "gui/StereoDepthLimits.h"
+
+#include <cerrno>
+
+#include <stereo-declare.h>
+
+namespace StereoDepthLimits {
+
+namespace {
+
+Result result(int r, const stereo_depth_limits& limits)
+{
+  Result res;
+  if (r == 0) {
+    res.status = State::Ok;
+    res.sunk = limits.sunk;
+    res.popped = limits.popped;
+  } else if (r == -ENOTSUP) {
+    res.status = State::NotOffered;
+  } else if (r == -ENODATA) {
+    res.status = State::NotDelivered;
+  } else {
+    res.status = State::Unreadable;
+  }
+  return res;
+}
+
+}  // namespace
+
+Result wayland(void *display, void *surface, double bufferWidth, double shownWidth)
+{
+  static void *initialized = nullptr;
+  if (!display || !surface) return {};
+  if (initialized != display) {
+    // The objects the library makes go on the program's default queue, which Qt dispatches; the
+    // first answer can be "not offered" until the compositor's globals have been dispatched.
+    if (stereo_declare_wayland_init(static_cast<wl_display *>(display), nullptr) != 0) return {};
+    initialized = display;
+  }
+  stereo_depth_limits limits{};
+  const int r = stereo_depth_wayland_get_buffer_limits(static_cast<wl_surface *>(surface), bufferWidth,
+                                                       shownWidth, &limits);
+  return result(r, limits);
+}
+
+Result x11(void *display, unsigned long window, double bufferWidth, double shownWidth)
+{
+  if (!display || !window) return {};
+  stereo_depth_limits limits{};
+  const int r = stereo_depth_x11_get_buffer_limits(static_cast<Display *>(display), static_cast<Window>(window),
+                                                   bufferWidth, shownWidth, &limits);
+  return result(r, limits);
+}
+
+}  // namespace StereoDepthLimits
diff --git a/src/gui/StereoDepthLimits.h b/src/gui/StereoDepthLimits.h
new file mode 100644
index 000000000..daf95904e
--- /dev/null
+++ b/src/gui/StereoDepthLimits.h
@@ -0,0 +1,31 @@
+#pragma once
+
+/*
+ * The person's depth limits for the stereo 3D view, read through libstereo-declare.
+ *
+ * A stereo desktop (Sparky Stereo OS's KWin) sets the limits in one place, its 3D depth settings,
+ * and hands them to every window: on Wayland for the top-level window's surface, on X11 as a
+ * property of the declared stereo child window.  The library converts them to the pixels of the
+ * view's buffer.  This file keeps the library's X11 header out of the Qt sources.
+ */
+namespace StereoDepthLimits {
+
+enum class State {
+  Ok,
+  NotOffered,    // this desktop sends no depth limits
+  NotDelivered,  // offered, not received yet
+  Unreadable,    // any other answer of the library
+};
+
+struct Result {
+  State status = State::NotOffered;
+  double sunk = 0.0;    // farthest disparity allowed behind the screen, in buffer pixels
+  double popped = 0.0;  // nearest disparity allowed in front of the screen, in buffer pixels
+};
+
+// display: the program's wl_display; surface: the top-level window's wl_surface
+Result wayland(void *display, void *surface, double bufferWidth, double shownWidth);
+// display: the program's X11 Display; window: the view's declared stereo window
+Result x11(void *display, unsigned long window, double bufferWidth, double shownWidth);
+
+}  // namespace StereoDepthLimits
