   if (format.depthBufferSize() < 24) format.setDepthBufferSize(24);
   if (format.stencilBufferSize() < 8) format.setStencilBufferSize(8);
+  Stereo3dView::requestStereoBuffers(format);
   QSurfaceFormat::setDefaultFormat(format);
 #endif
 }
