diff --git a/src/gui/Stereo3dView.cc b/src/gui/Stereo3dView.cc
new file mode 100644
index 000000000..ba26af258
--- /dev/null
+++ b/src/gui/Stereo3dView.cc
@@ -0,0 +1,93 @@
+#include "gui/Stereo3dView.h"
+
+#include <QString>
+#include <QtGlobal>
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0)
+
+// QGLView.h first: the OpenGL loader must come before the Qt OpenGL headers
+#include "gui/QGLView.h"
+#include "core/Settings.h"
+
+#include <QOpenGLWidget>
+#include <QSettings>
+#include <QSurfaceFormat>
+
+Stereo3dView::Stereo3dView(QGLView& view) : view(view), stereo(Settings::Settings::stereo3dView.value())
+{
+}
+
+void Stereo3dView::requestStereoBuffers(QSurfaceFormat& format)
+{
+  // QOpenGLWidget draws for each eye only if the default format asks for stereo buffers, and that
+  // must be known before the window is created, so the preference is read from the settings here.
+  const QSettings settings("OpenSCAD", "OpenSCAD");
+  if (settings.value(QString::fromStdString(Settings::Settings::stereo3dView.key()), false).toBool()) {
+    format.setOption(QSurfaceFormat::StereoBuffers);
+  }
+}
+
+bool Stereo3dView::drawsEyes() const
+{
+  return stereo && view.format().stereo();
+}
+
+void Stereo3dView::beginEye()
+{
+  // One eye per call: the left buffer first, then the right one
+  if (!drawsEyes()) return;
+  const auto halfSeparation =
+    Settings::Settings::stereo3dEyeSeparation.value() / 100.0 * view.cam.zoomValue() / 2.0;
+  view.stereoEyeOffset =
+    view.currentTargetBuffer() == QOpenGLWidget::RightBuffer ? halfSeparation : -halfSeparation;
+}
+
+void Stereo3dView::endEye()
+{
+  if (!drawsEyes()) return;
+  depthEyeOffset = view.stereoEyeOffset;
+  view.stereoEyeOffset = 0.0;
+  view.setupCamera();
+}
+
+void Stereo3dView::beginDepthRead()
+{
+  // The depth buffer holds the eye drawn last
+  if (!drawsEyes()) return;
+  view.stereoEyeOffset = depthEyeOffset;
+}
+
+void Stereo3dView::endDepthRead()
+{
+  if (!drawsEyes()) return;
+  view.stereoEyeOffset = 0.0;
+  view.setupCamera();
+}
+
+#else  // Qt before 6.5: the stereo 3D view is not available
+
+Stereo3dView::Stereo3dView(QGLView& /*view*/)
+{
+}
+
+void Stereo3dView::requestStereoBuffers(QSurfaceFormat& /*format*/)
+{
+}
+
+void Stereo3dView::beginEye()
+{
+}
+
+void Stereo3dView::endEye()
+{
+}
+
+void Stereo3dView::beginDepthRead()
+{
+}
+
+void Stereo3dView::endDepthRead()
+{
+}
+
+#endif  // QT_VERSION
diff --git a/src/gui/Stereo3dView.h b/src/gui/Stereo3dView.h
new file mode 100644
index 000000000..bb78f1036
--- /dev/null
+++ b/src/gui/Stereo3dView.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <QtGlobal>
+
+class QGLView;
+class QSurfaceFormat;
+
+/*
+ * The stereo 3D view. With the "stereo 3D view" preference on and an OpenGL context with stereo
+ * buffers, QOpenGLWidget calls QGLView::paintGL() once for the left buffer and once for the right
+ * buffer, and this class sets the camera of each eye through GLView::stereoEyeOffset.
+ *
+ * It needs QOpenGLWidget::currentTargetBuffer(), which came with Qt 6.5. With older Qt this class
+ * is a stub: it never asks for stereo buffers and never moves the eye, so the eye offset stays 0
+ * and the 3D view is the normal single view. This class is the only place where the stereo 3D view
+ * depends on the Qt version.
+ */
+class Stereo3dView
+{
+public:
+  explicit Stereo3dView(QGLView& view);
+
+  // Asks for stereo buffers in the default surface format when the preference is on
+  static void requestStereoBuffers(QSurfaceFormat& format);
+
+  // Around GLView::paintGL(): sets the offset of the eye drawn now, then sets up the camera between
+  // the eyes again, which picking uses
+  void beginEye();
+  void endEye();
+  // Around reading the depth buffer: sets the offset of the eye drawn last, whose depth the buffer
+  // holds, then sets up the camera between the eyes again
+  void beginDepthRead();
+  void endDepthRead();
+
+private:
+#if QT_VERSION >= QT_VERSION_CHECK(6, 5, 0)
+  bool drawsEyes() const;
+
+  QGLView& view;
+  bool stereo;                  // the preference, as it was when the view was created
+  double depthEyeOffset = 0.0;  // eye offset of the view the depth buffer holds
+#endif
+};
