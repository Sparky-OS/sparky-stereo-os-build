+// The limits are read again four times a second; they may come a moment
+// after the first frame, so the person is told after two seconds
+static const int stereo_limits_poll_ms = 250;
+static const int stereo_polls_before_telling = 8;
+
+// The default of the figure property stereoeyeseparation, which no longer
+// decides the depth of a stereo figure
+static const double stereo_separation_property_default = 0.05;
+
+// OCTAVE_STEREO3D_TRACE=1 prints each stereo frame's fit on stderr, for a
+// check against a prediction
+static bool
+stereo_trace ()
+{
+  static const bool trace = std::getenv ("OCTAVE_STEREO3D_TRACE") != nullptr;
+  return trace;
+}
+
+// Whether this desktop gives an OpenGL context stereo buffers: a context
+// with the figure's own format gives the answer the figure gets
+static bool
+desktop_offers_stereo ()
+{
+  static int offered = -1;
+
+  if (offered < 0)
+    {
+      QSurfaceFormat format = QSurfaceFormat::defaultFormat ();
+      format.setStereo (true);
+      QOpenGLContext context;
+      context.setFormat (format);
+      offered = (context.create () && context.format ().stereo ()) ? 1 : 0;
+    }
+
+  return offered == 1;
+}
