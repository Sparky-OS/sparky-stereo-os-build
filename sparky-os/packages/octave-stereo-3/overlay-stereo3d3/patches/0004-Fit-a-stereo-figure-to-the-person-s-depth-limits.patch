+////////////////////////////////////////////////////////////////////////
+//
+// Copyright (C) 2026 Daniel Ramos (Capitain Jack)
+//
+// This file is part of Octave.
+//
+// Octave is free software: you can redistribute it and/or modify it
+// under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// Octave is distributed in the hope that it will be useful, but
+// WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with Octave; see the file COPYING.  If not, see
+// <https://www.gnu.org/licenses/>.
+//
+////////////////////////////////////////////////////////////////////////
+
+#if ! defined (octave_StereoDepthLimits_h)
+#define octave_StereoDepthLimits_h 1
+
+#include "octave-config.h"
+
+// The person's depth limits for a stereo figure, read through
+// libstereo-declare.  A stereo desktop (Sparky Stereo OS's KWin) keeps
+// them in one place, its 3D depth settings, and hands them to every
+// window: on Wayland for the top-level window's surface, on X11 as a
+// property of the declared stereo child window.  The library converts
+// them to the pixels of the figure's buffer.  This file keeps the
+// library's X11 header out of the Qt and Octave sources.
+
+OCTAVE_BEGIN_NAMESPACE(octave)
+
+namespace stereo3d_limits
+{
+  enum class state
+  {
+    ok,
+    not_offered,    // this desktop sends no depth limits
+    not_delivered,  // offered, not received yet
+    unreadable      // any other answer of the library
+  };
+
+  struct result
+  {
+    state status = state::not_offered;
+    double sunk = 0.0;    // farthest disparity behind the screen, buffer pixels
+    double popped = 0.0;  // nearest disparity in front of the screen, buffer pixels
+  };
+
+  // display: the program's wl_display; surface: the top-level window's
+  // wl_surface
+  result wayland (void *display, void *surface, double buffer_width,
+                  double shown_width);
+
+  // display: the program's X11 Display; window: the figure's declared
+  // stereo window
+  result x11 (void *display, unsigned long window, double buffer_width,
+              double shown_width);
+}
+
+OCTAVE_END_NAMESPACE(octave)
+
+#endif
