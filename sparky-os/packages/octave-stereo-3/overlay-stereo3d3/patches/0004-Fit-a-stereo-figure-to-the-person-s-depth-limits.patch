+void
+opengl_renderer::stereo_measure_axes (const axes::properties& props)
+{
+#if defined (HAVE_OPENGL)
+
+  // The axes and its children are drawn from the camera between the eyes.
+  // Each axes clears the depth before it draws, so the depth buffer holds
+  // the nearest pixel of this axes wherever it drew, and the cleared depth
+  // everywhere else.
+#if defined (HAVE_FRAMEWORK_OPENGL)
+  GLint vp[4];
+#else
+  int vp[4];
+#endif
+  m_glfcns.glGetIntegerv (GL_VIEWPORT, vp);
+
+  stereo_axes_depth axes_depth;
+  axes_depth.target = -m_stereo_depth;
+  axes_depth.xscale = m_stereo_xscale;
+
+  int w = vp[2];
+  int h = vp[3];
+
+  if (w > 0 && h > 0)
+    {
+      std::vector<GLfloat> depth (static_cast<std::size_t> (w) * h);
+
+      while (m_glfcns.glGetError () != GL_NO_ERROR)
+        { }
+
+      m_glfcns.glPixelStorei (GL_PACK_ALIGNMENT, 1);
+      m_glfcns.glReadPixels (vp[0], vp[1], w, h, GL_DEPTH_COMPONENT,
+                             GL_FLOAT, depth.data ());
+
+      if (m_glfcns.glGetError () != GL_NO_ERROR)
+        {
+          m_stereo_depth_unreadable = true;
+          return;
+        }
+
+      GLfloat dmin = 1.0f;
+      GLfloat dmax = 0.0f;
+      for (const GLfloat d : depth)
+        {
+          if (d >= 1.0f)
+            continue;
+          dmin = std::min (dmin, d);
+          dmax = std::max (dmax, d);
+        }
+
+      if (dmin <= dmax)
+        {
+          // The window depth to the distance in front of the camera, with
+          // the orthographic projection between the planes m_xZ1 and m_xZ2
+          auto distance = [this] (double d)
+          {
+            return ((2.0 * d - 1.0) * (m_xZ2 - m_xZ1) + m_xZ1 + m_xZ2) / 2.0;
+          };
+
+          axes_depth.nearest = distance (dmin);
+          axes_depth.farthest = distance (dmax);
+          axes_depth.seen = true;
+        }
+    }
+
+  m_stereo_measured[props.get___myhandle__ ().value ()] = axes_depth;
+
+#else
+
+  octave_unused_parameter (props);
+
+#endif
+}
