+
+#if defined (HAVE_CONFIG_H)
+#  include "config.h"
+#endif
+
+#include <cerrno>
+
+#include <stereo-declare.h>
+
+#include "StereoDepthLimits.h"
+
+OCTAVE_BEGIN_NAMESPACE(octave)
+
+namespace stereo3d_limits
+{
+  static result
+  to_result (int r, const struct stereo_depth_limits& limits)
+  {
+    result res;
+
+    if (r == 0)
+      {
+        res.status = state::ok;
+        res.sunk = limits.sunk;
+        res.popped = limits.popped;
+      }
+    else if (r == -ENOTSUP)
+      res.status = state::not_offered;
+    else if (r == -ENODATA)
+      res.status = state::not_delivered;
+    else
+      res.status = state::unreadable;
+
+    return res;
+  }
+
+  result
+  wayland (void *display, void *surface, double buffer_width,
+           double shown_width)
+  {
+    static void *initialized = nullptr;
+
+    if (! display || ! surface)
+      return result ();
+
+    if (initialized != display)
+      {
+        // The objects the library makes go on the program's default
+        // queue, which Qt dispatches; the first answer can be "not
+        // offered" until the compositor's globals have been dispatched.
+        if (stereo_declare_wayland_init (static_cast<wl_display *> (display),
+                                         nullptr) != 0)
+          return result ();
+
+        initialized = display;
+      }
+
+    struct stereo_depth_limits limits {};
+    int r = stereo_depth_wayland_get_buffer_limits
+              (static_cast<wl_surface *> (surface), buffer_width,
+               shown_width, &limits);
+
+    return to_result (r, limits);
+  }
+
+  result
+  x11 (void *display, unsigned long window, double buffer_width,
+       double shown_width)
+  {
+    if (! display || ! window)
+      return result ();
+
+    struct stereo_depth_limits limits {};
+    int r = stereo_depth_x11_get_buffer_limits
+              (static_cast<Display *> (display), static_cast<Window> (window),
+               buffer_width, shown_width, &limits);
+
+    return to_result (r, limits);
+  }
+}
+
+OCTAVE_END_NAMESPACE(octave)
