+                                        : "no-stereo-desktop");
+    }
+}
+
+bool
+GLWidget::draws_eyes () const
+{
+  return m_stereo && format ().stereo ();
+}
+
+void
+GLWidget::tell (const std::string& key)
+{
+  if (! m_told.insert (key).second)
+    return;
+
+  Q_EMIT m_parent_canvas.interpreter_event
+    ([key] (octave::interpreter& interp)
+    {
+      // INTERPRETER THREAD
+
+      try
+        {
+          interp.feval ("sparky_stereo_tell", ovl (key));
+        }
+      catch (const execution_exception&)
+        {
+          interp.recover_from_exception ();
+          std::cerr << "3D: " << key << std::endl;
+        }
+    });
+}
+
+void
+GLWidget::poll_limits ()
+{
+  if (! draws_eyes ())
+    return;
+
+  double w = std::round (width () * devicePixelRatioF ());
+  if (w <= 0)
+    return;
+
+  stereo3d_limits::result r;
+  QPlatformNativeInterface *native = QGuiApplication::platformNativeInterface ();
+  QString platform = QGuiApplication::platformName ();
+
+  if (native && platform.startsWith (QLatin1String ("wayland")))
+    {
+      // A stereo desktop gives the limits for the top-level window's
+      // surface, not for the drawing area's own subsurface
+      QWindow *top = window () ? window ()->windowHandle () : nullptr;
+      void *display = native->nativeResourceForIntegration ("wl_display");
+      void *surface = top ? native->nativeResourceForWindow ("surface", top)
+                          : nullptr;
+      r = stereo3d_limits::wayland (display, surface, w, w);
+    }
+  else if (native && platform == QLatin1String ("xcb"))
+    {
+      // The drawing area's own window is the declared stereo child window
+      // that carries the limits
+      void *display = native->nativeResourceForIntegration ("display");
+      r = stereo3d_limits::x11 (display, winId (), w, w);
+    }
+  else
+    r.status = stereo3d_limits::state::unreadable;
+
+  bool changed = (r.status != m_limits.status || r.sunk != m_limits.sunk
+                  || r.popped != m_limits.popped);
+  m_limits = r;
+
+  if (changed && stereo_trace ())
+    std::fprintf (stderr, "octave stereo3d: limits platform=%s status=%d "
+                  "sunk=%g popped=%g width=%g\n",
+                  platform.toStdString ().c_str (),
+                  static_cast<int> (r.status), r.sunk, r.popped, w);
+
+  if (r.status == stereo3d_limits::state::ok)
+    m_polls_without_limits = 0;
+  else if (++m_polls_without_limits == stereo_polls_before_telling)
+    {
+      switch (r.status)
+        {
+        case stereo3d_limits::state::not_offered:
+          tell ("limits-not-offered");
+          break;
+        case stereo3d_limits::state::not_delivered:
+          tell ("limits-not-delivered");
+          break;
+        default:
+          tell ("limits-unreadable");
+          break;
+        }
+    }
+
+  if (changed)
+    update ();
+}
+
+void
+GLWidget::fit_separations ()
+{
+  m_stereo_separations.clear ();
+
+  if (m_renderer.stereo_depth_unreadable ())
+    tell ("depth-unreadable");
+
+  bool limits = (m_limits.status == stereo3d_limits::state::ok);
+
+  for (const auto& [axes, a] : m_renderer.stereo_measured ())
+    {
+      // With the separation t (summed over both eyes, per unit of depth
+      // in the axes' camera coordinates), a point at the distance d stands
+      // t * xscale * (d - target) buffer pixels further right in the
+      // right eye than in the left: the separation is the largest that
+      // keeps the nearest pixel inside the popped limit and the farthest
+      // inside the sunk limit.  Nothing off the plane of the camera
+      // target: no depth to show.
+      double t = 0.0;
+      double front = a.xscale * (a.target - a.nearest);
+      double behind = a.xscale * (a.farthest - a.target);
+
+      if (limits && a.seen && a.xscale > 0)
+        {
+          double best = std::numeric_limits<double>::infinity ();
+          if (front > 0)
+            best = std::min (best, m_limits.popped / front);
+          if (behind > 0)
+            best = std::min (best, m_limits.sunk / behind);
+          if (std::isfinite (best))
+            t = best;
+        }
+
+      m_stereo_separations[axes] = t;
+
+      if (stereo_trace ())
+        std::fprintf (stderr, "octave stereo3d: fit axes=%.17g limits=%d "
+                      "sunk=%g popped=%g seen=%d xscale=%.9g target=%.9g "
+                      "nearest=%.9g farthest=%.9g separation=%.9g "
+                      "disparity nearest=%.4f farthest=%.4f\n",
+                      axes, limits ? 1 : 0, m_limits.sunk, m_limits.popped,
+                      a.seen ? 1 : 0, a.xscale, a.target, a.nearest,
+                      a.farthest, t, -t * front, t * behind);
+    }
 }
 
