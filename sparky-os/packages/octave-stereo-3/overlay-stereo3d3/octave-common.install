usr/share/octave
usr/share/icons

debian/octaverc /etc

# Install the Debian-specific error handler
debian/debian_missing_handler.m /usr/share/octave/site/m/

# Sparky Stereo OS: the 3D example the GUI opens with (called from octaverc)
debian/sparky_stereo_welcome.m /usr/share/octave/site/m/

# Sparky Stereo OS: the 3D figures' sentences in ten languages, telling the
# person once, and the figure's 3D options in its Tools menu
debian/sparky_stereo_text.m /usr/share/octave/site/m/
debian/sparky_stereo_tell.m /usr/share/octave/site/m/
debian/sparky_stereo_menu.m /usr/share/octave/site/m/
