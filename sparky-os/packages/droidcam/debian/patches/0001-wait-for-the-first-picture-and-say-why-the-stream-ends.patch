+/* Receives exactly `bytes` bytes or fails, never a short count: recv() with MSG_WAITALL returns fewer bytes after a signal or after a timeout that
+ * comes in the middle of an item, and a short header or frame taken for a whole one leaves the stream out of step from then on.
+ * Returns `bytes`; 0 when the peer closed before the first byte; -1 otherwise, errno saying why: EAGAIN only when no byte of the item had
+ * arrived (the caller may ask again), ETIMEDOUT or ECONNRESET in the middle of an item, EINTR when the program is stopping.
+ * A receive interrupted while the program still runs (a stop and continue: SIGCONT interrupts a receive that has a timeout, signal(7)) goes on. */
+int RecvExact(const char* buffer, int bytes, SOCKET s) {
+    int got = 0;
+    while (got < bytes) {
+        ssize_t r = recv(s, (char*)buffer + got, bytes - got, 0);
+        if (r > 0) {
+            got += r;
+            continue;
+        }
+        if (r < 0 && errno == EINTR) {
+            if (v_running || a_running)
+                continue;
+            return -1;
+        }
+        if (r == 0) {
+            if (got == 0)
+                return 0;
+            errno = ECONNRESET;
+            return -1;
+        }
+        if (got > 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+            errno = ETIMEDOUT;
+        return -1;
+    }
+    return got;
+}
+
 int RecvNonBlock(char * buffer, int bytes, SOCKET s) {
     int res = recv(s, buffer, bytes, MSG_DONTWAIT);
     return (res < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) ? 0 : res;
