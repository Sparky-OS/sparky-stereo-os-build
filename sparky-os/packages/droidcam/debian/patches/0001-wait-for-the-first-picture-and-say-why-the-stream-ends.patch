+/* The video stream ended on its own: the window does what its Stop button does, so it shows Connect again (the thread that calls this
+ * cannot join itself, so the work is done by the main loop). */
+static gboolean stream_ended_idle(gpointer data) {
+	if (v_running || a_running)
+		the_callback(NULL, (gpointer)(uintptr_t) CB_BUTTON);
+	return FALSE;
+}
+
+void StreamEnded(int code) {
+	gdk_threads_add_idle(stream_ended_idle, NULL);
+}
