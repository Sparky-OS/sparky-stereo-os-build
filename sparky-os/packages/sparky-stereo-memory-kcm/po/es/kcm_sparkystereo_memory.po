#: src/memorykcm.cpp:183
msgctxt "@info"
msgid "Not saved: not authorized to change these settings."
msgstr "No guardado: no hay autorización para cambiar esta configuración."

#: src/memorykcm.cpp:185
msgctxt "@info %1 is the error"
msgid "Not saved: %1"
msgstr "No guardado: %1"

#: src/cushionstatus.cpp:39 src/cushionstatus.cpp:45 src/cushionstatus.cpp:60
msgctxt "@info"
msgid "Could not read %1: %2"
msgstr "No se pudo leer %1: %2"

#: src/cushionstatus.cpp:60
msgctxt "@info"
msgid "Invalid daemon PID."
msgstr "PID del demonio no válido."

#: src/cushionstatus.cpp:72
msgctxt "@info"
msgid "Could not read the protection state from %1: missing or invalid PROTECTION."
msgstr ""
"No se pudo leer el estado de protección de %1: PROTECTION falta o no "
"es válido."

#: src/cushionstatus.cpp:86 src/cushionstatus.cpp:90 src/cushionstatus.cpp:97
#: src/cushionstatus.cpp:104
msgctxt "@info"
msgid "Could not read the kept problems: %1"
msgstr "No se pudieron leer los problemas guardados: %1"

#: src/cushionstatus.cpp:112
msgctxt "@info"
msgid "The problems engine returned a problem without its text."
msgstr "El motor de problemas devolvió un problema sin su texto."

#: src/cushionstatus.cpp:121
msgctxt "@info"
msgid "The status names a problem whose text is unavailable from the problems engine. Refresh to try again."
msgstr ""
"El estado nombra un problema cuyo texto no está disponible en el "
"motor de problemas. Actualice para intentarlo de nuevo."

#: src/cushionstatus.cpp:169
msgctxt "@info"
msgid "The repair did not run: %1"
msgstr "La reparación no se ejecutó: %1"

#: src/cushionstatus.cpp:178
msgctxt "@info"
msgid "The repair failed (exit %1): %2"
msgstr "La reparación falló (salida %1): %2"

