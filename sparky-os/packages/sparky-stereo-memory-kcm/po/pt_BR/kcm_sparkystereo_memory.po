msgstr "Automático significa ligado neste computador: %1."

#: src/ui/main.qml:50
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "Automático significa desligado neste computador: %1."

#: src/ui/main.qml:56
msgctxt "@info"
msgid "In use now."
