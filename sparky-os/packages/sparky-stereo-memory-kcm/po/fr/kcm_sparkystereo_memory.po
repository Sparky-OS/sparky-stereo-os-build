msgid "Cushion Swap File:"
msgstr "Cushion Swap File :"

#: src/ui/main.qml:66
msgctxt "@option:check"
msgid "Switch the swap area on only under memory pressure"
msgstr "Activer la zone d'échange uniquement sous pression mémoire"

#: src/ui/main.qml:71
msgctxt "@label"
msgid "State:"
msgstr "État :"

#: src/ui/main.qml:74
msgctxt "@info cushion state"
msgid "Off, ready"
msgstr "Désactivé, prêt"

#: src/ui/main.qml:75
msgctxt "@info cushion state"
msgid "Deployed"
msgstr "Déployé"

#: src/ui/main.qml:76
msgctxt "@info cushion state"
msgid "Retracting"
msgstr "Retrait en cours"

#: src/ui/main.qml:77
msgctxt "@info cushion state"
msgid "Switched off"
msgstr "Désactivé"

#: src/ui/main.qml:78
msgctxt "@info cushion state"
