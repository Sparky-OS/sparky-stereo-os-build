msgid "Wake-up:"
msgstr "Réveil :"

#: src/ui/main.qml:87
msgctxt "@info"
msgid "Pressure stall information (PSI): the kernel wakes it when memory stalls"
msgstr "Informations sur les blocages mémoire (PSI) : le noyau le réveille lorsque la mémoire est bloquée"

