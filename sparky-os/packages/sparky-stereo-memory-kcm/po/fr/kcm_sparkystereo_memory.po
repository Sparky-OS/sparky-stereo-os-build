#: src/ui/main.qml:26
msgctxt "@label"
msgid "Compressed RAM swap (zram):"
msgstr "Mémoire d'échange RAM compressée (zram) :"

#: src/ui/main.qml:27
msgctxt "@option:radio zram"
msgid "Automatic"
msgstr "Automatique"

#: src/ui/main.qml:33
msgctxt "@option:radio zram"
msgid "On"
msgstr "Activé"

#: src/ui/main.qml:39
msgctxt "@option:radio zram"
msgid "Off"
msgstr "Désactivé"

#: src/ui/main.qml:49
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "Automatique signifie activé pour cet ordinateur : %1."

#: src/ui/main.qml:50
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "Automatique signifie désactivé pour cet ordinateur : %1."

#: src/ui/main.qml:56
msgctxt "@info"
msgid "In use now."
msgstr "Utilisé actuellement."

#: src/ui/main.qml:56
msgctxt "@info"
msgid "Not in use now."
msgstr "Non utilisé actuellement."

#: src/ui/main.qml:57
