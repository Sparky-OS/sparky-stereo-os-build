msgstr "オフ、準備完了"

#: src/ui/main.qml:75
msgctxt "@info cushion state"
msgid "Deployed"
msgstr "展開済み"

#: src/ui/main.qml:76
msgctxt "@info cushion state"
msgid "Retracting"
msgstr "縮小中"

#: src/ui/main.qml:77
msgctxt "@info cushion state"
