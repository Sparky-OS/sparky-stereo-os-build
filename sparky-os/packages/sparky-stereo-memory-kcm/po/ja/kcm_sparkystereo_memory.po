#: src/ui/main.qml:26
msgctxt "@label"
msgid "Compressed RAM swap (zram):"
msgstr "圧縮 RAM スワップ (zram):"

#: src/ui/main.qml:27
msgctxt "@option:radio zram"
msgid "Automatic"
msgstr "自動"

#: src/ui/main.qml:33
msgctxt "@option:radio zram"
msgid "On"
msgstr "オン"

#: src/ui/main.qml:39
msgctxt "@option:radio zram"
msgid "Off"
msgstr "オフ"

#: src/ui/main.qml:49
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "自動とは、このコンピューターではオンになることを意味します: %1。"

#: src/ui/main.qml:50
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "自動とは、このコンピューターではオフになることを意味します: %1。"

#: src/ui/main.qml:56
msgctxt "@info"
msgid "In use now."
msgstr "現在使用中。"

#: src/ui/main.qml:56
msgctxt "@info"
msgid "Not in use now."
msgstr "現在使用していません。"

#: src/ui/main.qml:57
msgctxt "@info"
msgid "A change applies at the next start."
msgstr "変更は次回の起動時に適用されます。"

#: src/ui/main.qml:65
msgctxt "@label"
msgid "Cushion Swap File:"
msgstr "Cushion Swap File:"

#: src/ui/main.qml:66
