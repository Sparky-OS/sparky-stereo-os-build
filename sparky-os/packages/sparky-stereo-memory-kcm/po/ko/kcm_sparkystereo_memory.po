msgstr "알 수 없는 zram 결정; zram-auto 원문: %1"

#: src/memorykcm.cpp:149
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "자동은 이 컴퓨터에서 켬을 의미합니다: %1."

#: src/memorykcm.cpp:151
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "자동은 이 컴퓨터에서 끔을 의미합니다: %1."

#: src/memorykcm.cpp:183
msgctxt "@info"
msgid "Not saved: not authorized to change these settings."
msgstr "저장되지 않음: 이 설정을 변경할 권한이 없습니다."

#: src/memorykcm.cpp:185
msgctxt "@info %1 is the error"
msgid "Not saved: %1"
msgstr "저장되지 않음: %1"

#: src/cushionstatus.cpp:39 src/cushionstatus.cpp:45 src/cushionstatus.cpp:60
msgctxt "@info"
msgid "Could not read %1: %2"
msgstr "%1을(를) 읽지 못했습니다: %2"

#: src/cushionstatus.cpp:60
msgctxt "@info"
msgid "Invalid daemon PID."
msgstr "데몬 PID가 잘못되었습니다."

