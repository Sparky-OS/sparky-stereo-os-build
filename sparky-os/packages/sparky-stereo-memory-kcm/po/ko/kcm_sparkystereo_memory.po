#: src/memorykcm.cpp:51
msgctxt "@info zram reason"
msgid "%1 MiB of RAM; the swap storage type could not be identified"
msgstr "RAM %1 MiB; 스왑 저장장치 유형을 확인하지 못했습니다"

#: src/memorykcm.cpp:54
msgctxt "@info zram reason"
