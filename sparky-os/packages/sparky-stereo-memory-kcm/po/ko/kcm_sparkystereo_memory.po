#: src/memorykcm.cpp:27
msgctxt "@info zram reason"
msgid "Switched on by the zram configuration"
msgstr "zram 설정으로 켜짐"

#: src/memorykcm.cpp:30
msgctxt "@info zram reason"
msgid "Switched off by the zram configuration"
msgstr "zram 설정으로 꺼짐"

#: src/memorykcm.cpp:40
msgctxt "@info zram reason"
msgid "%1 MiB of RAM: within the automatic zram RAM limit"
msgstr "RAM %1 MiB: zram 자동 활성화 RAM 한도 이내"

#: src/memorykcm.cpp:43
msgctxt "@info zram reason"
msgid "The swap area is on eMMC storage"
msgstr "스왑 영역이 eMMC 저장장치에 있습니다"

#: src/memorykcm.cpp:44
msgctxt "@info zram reason"
msgid "The swap area is on an SD card"
msgstr "스왑 영역이 SD 카드에 있습니다"

#: src/memorykcm.cpp:45
msgctxt "@info zram reason"
msgid "The swap area is on a rotating disk"
msgstr "스왑 영역이 회전식 디스크에 있습니다"

#: src/memorykcm.cpp:46
msgctxt "@info zram reason"
msgid "The swap area is on removable storage"
msgstr "스왑 영역이 이동식 저장장치에 있습니다"

#: src/memorykcm.cpp:47
msgctxt "@info zram reason"
msgid "The swap area is on USB storage"
msgstr "스왑 영역이 USB 저장장치에 있습니다"

#: src/memorykcm.cpp:50
msgctxt "@info zram reason"
msgid "%1 MiB of RAM and the swap area on fast storage"
