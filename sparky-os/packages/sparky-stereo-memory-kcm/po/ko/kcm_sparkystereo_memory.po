#: src/ui/main.qml:26
msgctxt "@label"
msgid "Compressed RAM swap (zram):"
msgstr "압축 RAM 스왑 (zram):"

#: src/ui/main.qml:27
msgctxt "@option:radio zram"
msgid "Automatic"
msgstr "자동"

#: src/ui/main.qml:33
msgctxt "@option:radio zram"
msgid "On"
msgstr "켬"

#: src/ui/main.qml:39
msgctxt "@option:radio zram"
msgid "Off"
msgstr "끔"

#: src/ui/main.qml:49
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "자동은 이 컴퓨터에서 켬을 의미합니다: %1."

#: src/ui/main.qml:50
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "자동은 이 컴퓨터에서 끔을 의미합니다: %1."

#: src/ui/main.qml:56
msgctxt "@info"
msgid "In use now."
msgstr "현재 사용 중입니다."

#: src/ui/main.qml:56
msgctxt "@info"
msgid "Not in use now."
msgstr "현재 사용 중이 아닙니다."

#: src/ui/main.qml:57
msgctxt "@info"
msgid "A change applies at the next start."
msgstr "변경 사항은 다음 시작 시 적용됩니다."

#: src/ui/main.qml:65
msgctxt "@label"
msgid "Cushion Swap File:"
msgstr "Cushion Swap File:"

#: src/ui/main.qml:66
msgctxt "@option:check"
msgid "Switch the swap area on only under memory pressure"
msgstr "메모리 압박 시에만 스왑 영역을 켭니다"

#: src/ui/main.qml:71
msgctxt "@label"
msgid "State:"
msgstr "상태:"

#: src/ui/main.qml:74
msgctxt "@info cushion state"
msgid "Off, ready"
msgstr "끔, 준비됨"

#: src/ui/main.qml:75
msgctxt "@info cushion state"
msgid "Deployed"
msgstr "배포됨"

#: src/ui/main.qml:76
msgctxt "@info cushion state"
msgid "Retracting"
msgstr "거둬들이는 중"

#: src/ui/main.qml:77
msgctxt "@info cushion state"
msgid "Switched off"
msgstr "꺼짐"

#: src/ui/main.qml:78
msgctxt "@info cushion state"
msgid "No swap area configured"
msgstr "설정된 스왑 영역 없음"

#: src/ui/main.qml:79
msgctxt "@info cushion state"
msgid "Not running"
msgstr "실행 중이 아님"

#: src/ui/main.qml:84
msgctxt "@label"
msgid "Wake-up:"
msgstr "깨우기:"

#: src/ui/main.qml:87
msgctxt "@info"
msgid "Pressure stall information (PSI): the kernel wakes it when memory stalls"
msgstr "Pressure Stall Information (PSI): 메모리가 지연될 때 커널이 깨웁니다"

#: src/ui/main.qml:88
msgctxt "@info"
msgid "Compatibility mode: no PSI, it checks memory every few seconds"
msgstr "호환 모드: PSI 없음, 몇 초마다 메모리를 확인합니다"

#: src/ui/main.qml:91
msgctxt "@label"
msgid "Swap area:"
msgstr "스왑 영역:"

#: src/memorykcm.cpp:144
msgctxt "@info"
msgid "Not saved: not authorized to change these settings."
msgstr "저장되지 않음: 이 설정을 변경할 권한이 없습니다."

