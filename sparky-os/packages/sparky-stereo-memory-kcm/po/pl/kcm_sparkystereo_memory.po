msgctxt "@info zram reason"
msgid "Unrecognized zram decision; zram-auto says: %1"
msgstr "Nierozpoznana decyzja zram; zram-auto podaje: %1"

#: src/memorykcm.cpp:149
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "Automatycznie oznacza włączenie na tym komputerze: %1."

#: src/memorykcm.cpp:151
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "Automatycznie oznacza wyłączenie na tym komputerze: %1."

#: src/memorykcm.cpp:183
msgctxt "@info"
msgid "Not saved: not authorized to change these settings."
msgstr "Nie zapisano: brak uprawnień do zmiany tych ustawień."

