msgctxt "@info"
msgid "Could not read %1: %2"
msgstr "Nie można odczytać %1: %2"

#: src/cushionstatus.cpp:60
msgctxt "@info"
msgid "Invalid daemon PID."
msgstr "Nieprawidłowy PID usługi."

#: src/cushionstatus.cpp:72
msgctxt "@info"
msgid "Could not read the protection state from %1: missing or invalid PROTECTION."
msgstr "Nie można odczytać stanu ochrony z %1: brak lub nieprawidłowe pole PROTECTION."

#: src/cushionstatus.cpp:86 src/cushionstatus.cpp:90 src/cushionstatus.cpp:97
#: src/cushionstatus.cpp:104
msgctxt "@info"
msgid "Could not read the kept problems: %1"
msgstr "Nie można odczytać zapisanych problemów: %1"

#: src/cushionstatus.cpp:112
msgctxt "@info"
msgid "The problems engine returned a problem without its text."
msgstr "Mechanizm obsługi problemów zwrócił problem bez opisu."

#: src/cushionstatus.cpp:121
msgctxt "@info"
msgid "The status names a problem whose text is unavailable from the problems engine. Refresh to try again."
msgstr "Stan wskazuje problem, którego opisu nie udostępnia mechanizm obsługi problemów. Odśwież, aby spróbować ponownie."

#: src/cushionstatus.cpp:169
msgctxt "@info"
msgid "The repair did not run: %1"
msgstr "Naprawa nie została uruchomiona: %1"

#: src/cushionstatus.cpp:178
msgctxt "@info"
msgid "The repair failed (exit %1): %2"
msgstr "Naprawa nie powiodła się (kod wyjścia %1): %2"

