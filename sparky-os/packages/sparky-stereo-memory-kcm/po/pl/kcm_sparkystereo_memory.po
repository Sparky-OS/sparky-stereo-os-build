#: src/ui/main.qml:26
msgctxt "@label"
msgid "Compressed RAM swap (zram):"
msgstr "Skompresowany obszar wymiany RAM (zram):"

#: src/ui/main.qml:27
msgctxt "@option:radio zram"
msgid "Automatic"
msgstr "Automatycznie"

#: src/ui/main.qml:33
msgctxt "@option:radio zram"
msgid "On"
msgstr "Włączony"

#: src/ui/main.qml:39
msgctxt "@option:radio zram"
msgid "Off"
msgstr "Wyłączony"

#: src/ui/main.qml:49
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "Automatycznie oznacza włączenie na tym komputerze: %1."

#: src/ui/main.qml:50
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "Automatycznie oznacza wyłączenie na tym komputerze: %1."

#: src/ui/main.qml:56
msgctxt "@info"
msgid "In use now."
msgstr "Obecnie w użyciu."

#: src/ui/main.qml:56
msgctxt "@info"
msgid "Not in use now."
msgstr "Obecnie nie jest używany."

#: src/ui/main.qml:57
msgctxt "@info"
msgid "A change applies at the next start."
msgstr "Zmiana zostanie zastosowana przy następnym uruchomieniu."

#: src/ui/main.qml:65
msgctxt "@label"
msgid "Cushion Swap File:"
msgstr "Cushion Swap File:"

#: src/ui/main.qml:66
msgctxt "@option:check"
msgid "Switch the swap area on only under memory pressure"
msgstr "Włącz obszar wymiany tylko przy zapotrzebowaniu na pamięć"

#: src/ui/main.qml:71
msgctxt "@label"
msgid "State:"
msgstr "Stan:"

#: src/ui/main.qml:74
msgctxt "@info cushion state"
msgid "Off, ready"
msgstr "Wyłączony, gotowy"

#: src/ui/main.qml:75
msgctxt "@info cushion state"
msgid "Deployed"
msgstr "Wdrożony"

#: src/ui/main.qml:76
msgctxt "@info cushion state"
msgid "Retracting"
msgstr "Zwijanie"

#: src/ui/main.qml:77
msgctxt "@info cushion state"
msgid "Switched off"
msgstr "Wyłączony"

#: src/ui/main.qml:78
msgctxt "@info cushion state"
msgid "No swap area configured"
msgstr "Nie skonfigurowano obszaru wymiany"

#: src/ui/main.qml:79
msgctxt "@info cushion state"
msgid "Not running"
msgstr "Nie działa"

#: src/ui/main.qml:84
msgctxt "@label"
msgid "Wake-up:"
msgstr "Wybudzanie:"

#: src/ui/main.qml:87
msgctxt "@info"
msgid "Pressure stall information (PSI): the kernel wakes it when memory stalls"
msgstr "Pressure Stall Information (PSI): jądro wybudza go, gdy pamięć się zatrzymuje"

#: src/ui/main.qml:88
msgctxt "@info"
msgid "Compatibility mode: no PSI, it checks memory every few seconds"
msgstr "Tryb zgodności: bez PSI, sprawdza pamięć co kilka sekund"

#: src/ui/main.qml:91
msgctxt "@label"
msgid "Swap area:"
msgstr "Obszar wymiany:"

#: src/memorykcm.cpp:144
msgctxt "@info"
msgid "Not saved: not authorized to change these settings."
msgstr "Nie zapisano: brak uprawnień do zmiany tych ustawień."

#: src/memorykcm.cpp:146
msgctxt "@info %1 is the error"
msgid "Not saved: %1"
msgstr "Nie zapisano: %1"
