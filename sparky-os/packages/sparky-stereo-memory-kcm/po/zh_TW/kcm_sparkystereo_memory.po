#: src/ui/main.qml:26
msgctxt "@label"
msgid "Compressed RAM swap (zram):"
msgstr "壓縮記憶體交換（zram）："

#: src/ui/main.qml:27
msgctxt "@option:radio zram"
msgid "Automatic"
msgstr "自動"

#: src/ui/main.qml:33
msgctxt "@option:radio zram"
msgid "On"
msgstr "開啟"

#: src/ui/main.qml:39
msgctxt "@option:radio zram"
msgid "Off"
msgstr "關閉"

#: src/ui/main.qml:49
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "自動表示此電腦為開啟：%1。"

#: src/ui/main.qml:50
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "自動表示此電腦為關閉：%1。"

#: src/ui/main.qml:56
msgctxt "@info"
msgid "In use now."
msgstr "使用中。"

#: src/ui/main.qml:56
msgctxt "@info"
msgid "Not in use now."
msgstr "目前未使用。"

#: src/ui/main.qml:57
msgctxt "@info"
msgid "A change applies at the next start."
msgstr "變更將於下次啟動時套用。"

#: src/ui/main.qml:65
msgctxt "@label"
msgid "Cushion Swap File:"
msgstr "Cushion Swap File："

#: src/ui/main.qml:66
msgctxt "@option:check"
msgid "Switch the swap area on only under memory pressure"
msgstr "僅在記憶體壓力下開啟交換區域"

#: src/ui/main.qml:71
msgctxt "@label"
msgid "State:"
msgstr "狀態："

#: src/ui/main.qml:74
msgctxt "@info cushion state"
msgid "Off, ready"
msgstr "關閉，待命"

#: src/ui/main.qml:75
msgctxt "@info cushion state"
msgid "Deployed"
msgstr "已部署"

#: src/ui/main.qml:76
msgctxt "@info cushion state"
msgid "Retracting"
msgstr "收回中"

#: src/ui/main.qml:77
msgctxt "@info cushion state"
msgid "Switched off"
msgstr "已關閉"

#: src/ui/main.qml:78
msgctxt "@info cushion state"
msgid "No swap area configured"
msgstr "未設定交換區域"

#: src/ui/main.qml:79
msgctxt "@info cushion state"
msgid "Not running"
msgstr "未執行"

#: src/ui/main.qml:84
msgctxt "@label"
msgid "Wake-up:"
msgstr "喚醒："

#: src/ui/main.qml:87
msgctxt "@info"
msgid "Pressure stall information (PSI): the kernel wakes it when memory stalls"
msgstr "壓力停滯資訊（PSI）：記憶體停滯時核心會將其喚醒"

#: src/ui/main.qml:88
msgctxt "@info"
msgid "Compatibility mode: no PSI, it checks memory every few seconds"
msgstr "相容模式：無 PSI，每隔數秒檢查一次記憶體"

#: src/ui/main.qml:91
msgctxt "@label"
msgid "Swap area:"
msgstr "交換區域："

#: src/memorykcm.cpp:144
msgctxt "@info"
msgid "Not saved: not authorized to change these settings."
msgstr "未儲存：無權變更這些設定。"

#: src/memorykcm.cpp:146
msgctxt "@info %1 is the error"
msgid "Not saved: %1"
msgstr "未儲存：%1"
