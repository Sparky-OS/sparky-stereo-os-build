msgstr "未运行"

#: src/ui/main.qml:84
msgctxt "@label"
msgid "Wake-up:"
msgstr "唤醒："

#: src/ui/main.qml:87
msgctxt "@info"
msgid "Pressure stall information (PSI): the kernel wakes it when memory stalls"
msgstr "压力停滞信息（PSI）：内存停滞时内核将其唤醒"

#: src/ui/main.qml:88
msgctxt "@info"
msgid "Compatibility mode: no PSI, it checks memory every few seconds"
msgstr "兼容模式：无 PSI，每隔几秒检查一次内存"

#: src/ui/main.qml:91
msgctxt "@label"
msgid "Swap area:"
msgstr "交换区域："

