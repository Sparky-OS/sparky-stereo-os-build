#: src/ui/main.qml:26
msgctxt "@label"
msgid "Compressed RAM swap (zram):"
msgstr "压缩内存交换 (zram)："

#: src/ui/main.qml:27
msgctxt "@option:radio zram"
msgid "Automatic"
msgstr "自动"

#: src/ui/main.qml:33
msgctxt "@option:radio zram"
msgid "On"
msgstr "开启"

#: src/ui/main.qml:39
msgctxt "@option:radio zram"
msgid "Off"
msgstr "关闭"

#: src/ui/main.qml:49
msgctxt "@info %1 is the reason"
msgid "Automatic means on for this computer: %1."
msgstr "自动意味着此计算机已开启：%1。"

#: src/ui/main.qml:50
msgctxt "@info %1 is the reason"
msgid "Automatic means off for this computer: %1."
msgstr "自动意味着此计算机已关闭：%1。"

#: src/ui/main.qml:56
msgctxt "@info"
msgid "In use now."
msgstr "正在使用中。"

#: src/ui/main.qml:56
msgctxt "@info"
msgid "Not in use now."
msgstr "当前未使用。"

#: src/ui/main.qml:57
msgctxt "@info"
msgid "A change applies at the next start."
msgstr "更改将在下次启动时生效。"

#: src/ui/main.qml:65
msgctxt "@label"
msgid "Cushion Swap File:"
msgstr "Cushion Swap File："

#: src/ui/main.qml:66
msgctxt "@option:check"
msgid "Switch the swap area on only under memory pressure"
msgstr "仅在内存压力下启用交换区域"

#: src/ui/main.qml:71
msgctxt "@label"
msgid "State:"
msgstr "状态："

#: src/ui/main.qml:74
msgctxt "@info cushion state"
msgid "Off, ready"
msgstr "关闭，已就绪"

#: src/ui/main.qml:75
msgctxt "@info cushion state"
msgid "Deployed"
msgstr "已部署"

#: src/ui/main.qml:76
msgctxt "@info cushion state"
msgid "Retracting"
msgstr "正在收回"

#: src/ui/main.qml:77
msgctxt "@info cushion state"
msgid "Switched off"
msgstr "已关闭"

#: src/ui/main.qml:78
msgctxt "@info cushion state"
