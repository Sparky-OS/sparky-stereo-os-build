#!/usr/bin/python3 -Es
# SPDX-License-Identifier: GPL-3.0-or-later
"""Polkit entry point for the administrator's BleachBit selection."""

import os
import re
import sys

if os.getuid() != 0 or not os.environ.get('PKEXEC_UID', '').isdigit():
    sys.exit(2)
language, *args = sys.argv[1:]
if not re.fullmatch(r'[a-zA-Z0-9_.@:-]{1,128}', language):
    sys.exit(2)
if (len(args) == 4 and args[0] == 'schedule-set' and args[1] in ('manual', 'weekly', 'fortnightly', 'monthly')
        and args[2] in ('review', 'automatic') and args[3].startswith('/')):
    os.execve('/usr/libexec/sparky-storage-cleanup-schedule',
              ['sparky-storage-cleanup-schedule', 'set', *args[1:]],
              {'HOME': '/root', 'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'})
if len(args) == 2 and args[0] == 'set-age' and re.fullmatch(r'[0-9]{1,3}', args[1]) and 1 <= int(args[1]) <= 365:
    os.execve('/usr/libexec/sparky-storage-cleanup-schedule',
              ['sparky-storage-cleanup-schedule', *args],
              {'HOME': '/root', 'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'})
if args[:1] != ['--json']:
    sys.exit(2)
age = []
if len(args) >= 2 and args[-2] == '--temporary-age-days':
    age = args[-2:]
    args = args[:-2]
    if not age[-1].isdecimal() or not 1 <= int(age[-1]) <= 365:
        sys.exit(2)
valid = (args == ['--json', '--list-cleaners']
         or (len(args) == 4 and args[1] == '--set-option'
             and re.fullmatch(r'[a-zA-Z0-9_.-]+', args[2]) and args[3] in ('true', 'false'))
         or (len(args) in (5, 6) and args[1:3] in (['--preview', '--volume'], ['--clean', '--volume'])
             and args[3].startswith('/') and args[4:] in (['--preset'], ['--preset', '--approved-stdin'])))
if not valid:
    sys.exit(2)
os.chdir('/root')
os.execve('/usr/bin/bleachbit', ['bleachbit', *args, *age], {
    'HOME': '/root', 'PATH': '/usr/sbin:/usr/bin:/sbin:/bin',
    'LANG': 'C.UTF-8', 'LC_MESSAGES': language.split(':')[0] + '.UTF-8', 'LANGUAGE': language,
})
