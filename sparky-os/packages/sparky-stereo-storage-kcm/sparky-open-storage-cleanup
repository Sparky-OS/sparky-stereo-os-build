import base64
import os
import sys


if (len(sys.argv) not in (2, 3) or not sys.argv[1].startswith("/")
        or (len(sys.argv) == 3 and sys.argv[2] not in ("preview", "caches"))):
    sys.exit(2)
token = base64.urlsafe_b64encode(os.fsencode(sys.argv[1])).decode("ascii")
if len(sys.argv) == 3:
    token += ":" + sys.argv[2]
os.execv("/usr/bin/kcmshell6", ["kcmshell6", "--args", token, "kcm_sparkystereo_storage_cleanup"])
