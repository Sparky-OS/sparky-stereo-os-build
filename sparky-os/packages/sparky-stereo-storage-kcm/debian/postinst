#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

#DEBHELPER#

if [ "$1" = configure ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke --user --no-dbus daemon-reload || :
    action=start
    if [ -n "${2:-}" ]; then action=restart; fi
    deb-systemd-invoke --user "$action" sparky-storage-cleanup.timer || :
fi
