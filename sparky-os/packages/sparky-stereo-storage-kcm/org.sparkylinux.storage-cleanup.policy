<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Sparky Stereo OS</vendor>
  <action id="org.sparkylinux.storage-cleanup.bleachbit">
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sparky-storage-cleanup-admin</annotate>
    <description>Review and clean storage as administrator</description>
    <message>Authentication is required to use the administrator’s BleachBit selection</message>
    <description xml:lang="pt-BR">Revisar e limpar o armazenamento como administrador</description>
    <message xml:lang="pt-BR">Autentique-se para usar a seleção de administrador no BleachBit</message>
    <description xml:lang="es">Revisar y limpiar el almacenamiento como administrador</description>
    <message xml:lang="es">Se requiere autenticación para usar la selección de administrador de BleachBit</message>
    <description xml:lang="fr">Examiner et nettoyer le stockage en tant qu’administrateur</description>
    <message xml:lang="fr">Authentifiez-vous pour utiliser la sélection BleachBit de l’administrateur</message>
    <description xml:lang="de">Speicherplatz als Administrator prüfen und bereinigen</description>
    <message xml:lang="de">Die BleachBit-Auswahl des Administrators erfordert eine Anmeldung</message>
    <description xml:lang="pl">Przejrzyj i wyczyść pamięć masową jako administrator</description>
    <message xml:lang="pl">Uwierzytelnij się, aby użyć wyboru administratora w BleachBit</message>
    <description xml:lang="ja">管理者としてストレージを確認してクリーンアップ</description>
    <message xml:lang="ja">BleachBit の管理者用選択を使うには認証が必要です</message>
    <description xml:lang="ko">관리자 권한으로 저장 공간 검토 및 정리</description>
    <message xml:lang="ko">BleachBit 관리자 선택 항목을 사용하려면 인증이 필요합니다</message>
    <description xml:lang="zh-CN">以管理员身份检查并清理存储空间</description>
    <message xml:lang="zh-CN">使用 BleachBit 的管理员选择需要身份验证</message>
    <description xml:lang="zh-TW">以管理員身分檢查與清理儲存空間</description>
    <message xml:lang="zh-TW">使用 BleachBit 的管理員選取項目需要驗證</message>
  </action>
</policyconfig>
