+void PipeWireBaseEncodedStream::setConstantFramerate(bool constant)
+{
+    if (d->m_constantFramerate == constant) {
+        return;
+    }
+    d->m_constantFramerate = constant;
+    if (d->m_produce) {
+        // produce runs in another thread
+        QMetaObject::invokeMethod(
+            d->m_produce.get(),
+            [produce = d->m_produce.get(), constant]() {
+                produce->setConstantFramerate(constant);
+            },
+            Qt::QueuedConnection);
+    }
+}
+
+bool PipeWireBaseEncodedStream::constantFramerate() const
+{
+    return d->m_constantFramerate;
+}
