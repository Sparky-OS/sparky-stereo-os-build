+void PipeWireProduce::setConstantFramerate(bool constant)
+{
+    m_constantFramerate = constant;
+    if (m_frameRepeatTimer) {
+        m_frameRepeatTimer->setInterval(frameRepeatInterval());
+    }
+}
+
+int PipeWireProduce::frameRepeatInterval() const
+{
+    // one frame interval when the rate is kept constant; otherwise two, to flush the last frame through the encoder once
+    const double framesPerSecond = static_cast<double>(m_maxFramerate.numerator) / m_maxFramerate.denominator;
+    const double interval = 1000.0 / framesPerSecond;
+    return int(m_constantFramerate ? interval : interval * 2);
+}
