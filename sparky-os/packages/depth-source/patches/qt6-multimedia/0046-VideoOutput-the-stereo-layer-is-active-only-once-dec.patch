@@ -1225,14 +1247,11 @@
     g.gl.bindFramebuffer(0x8D40, 0);
     egl.makeCurrent(t.display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
 
-    place();
-    if (!declared) {
-        const int result = stereo_declare_wayland(surface, STEREO_SBS_FULL, STEREO_CLASS_VIDEO, STEREO_VIDEO_CURRENT);
-        if (result < 0)
-            qCWarning(qLcStereoLayer) << "declaring the stereo content failed:" << strerror(-result);
-        else
-            declared = true;
+    if (!ensureDeclared()) {
+        *why = QStringLiteral("the stereo content is not declared");
+        return false;
     }
+    place();
     slot->busy = true;
     wl_surface_attach(surface, slot->buffer, 0, 0);
     wl_surface_damage_buffer(surface, 0, 0, pixels.width(), pixels.height());
@@ -1348,9 +1367,19 @@
     wl_region *empty = wl_compositor_create_region(p->globals.compositor);
     wl_surface_set_input_region(p->surface, empty);
     wl_region_destroy(empty);
+    // declared now, before the first buffer: the layer exists only as stereo content the compositor took (a refusal is in declarationFailure())
+    p->ensureDeclared();
     return layer;
 }
 
+QString QQuickVideoStereoLayer::declarationFailure() const
+{
+    QMutexLocker lock(&d->mutex);
+    if (!d->declareError)
+        return QString();
+    return QStringLiteral("the compositor's stereo content declaration failed (%1)").arg(QString::fromLocal8Bit(strerror(d->declareError)));
+}
