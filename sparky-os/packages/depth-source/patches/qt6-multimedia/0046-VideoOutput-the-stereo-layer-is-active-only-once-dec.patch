+/*!
+    \qmlproperty string QtMultimedia::VideoOutput::stereoLayerFailure
+    \readonly
+
+    Empty, or why a 3D video that is wanted in the layer is not shown in it: the declaration of the
+    layer's surface as stereo content failed (the error is also logged, category
+    \c qt.multimedia.video.stereolayer). The video is then drawn the ordinary way, one view, and
+    not as 3D; a player can say so to the person. The reason stays until the 3D video ends (the
+    next 3D video makes the declaration again) or the item changes window.
+*/
+QString QQuickVideoOutput::stereoLayerFailure() const
+{
+    QMutexLocker lock(&m_frameMutex);
+    return m_stereoLayerFailure;
+}
