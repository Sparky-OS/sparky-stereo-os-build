@@ -353,6 +359,59 @@ struct GlPlaneResource
     CUgraphicsResource cudaResource = nullptr;
 };
 
+// The planes of a converter that was released on another thread than the one of its OpenGL context. A
+// converter is released by whoever lets go the last reference to the decoder's frames context, and a player
+// that opens another file does that on the GUI thread, while the scene graph's render thread owns the context.
+// Qt aborts a QOpenGLContext made current off its thread, and CUDA refuses to unregister a graphics resource
+// without the context of its texture current (CUDA_ERROR_INVALID_GRAPHICS_CONTEXT): so the planes are given
+// to the share group of the context, which frees them when one of its contexts is next made current (as it
+// does for Qt's own textures), with a reference to the decoder's device so that the CUDA context is still
+// there then. When the share group goes first there is nothing to free, CUDA has dropped the registrations
+// with its context, and the reference is let go.
+class GlPlanesRelease final : public QOpenGLSharedResource
+{
+public:
+    GlPlanesRelease(QOpenGLContext *context, const CudaDriverApi *api, CUcontext cudaContext,
+                    AVBufferUPtr device)
+        : QOpenGLSharedResource(context->shareGroup()),
+          m_api(api),
+          m_cudaContext(cudaContext),
+          m_device(std::move(device))
+    {
+    }
+
+    void add(GlPlaneResource &plane)
+    {
+        m_planes.push_back({ plane.texture, plane.cudaResource });
+        plane.texture = 0;
+        plane.cudaResource = nullptr;
+    }
+
+protected:
+    void invalidateResource() override { m_planes.clear(); }
+
+    void freeResource(QOpenGLContext *context) override
+    {
+        std::optional<CudaContextGuard> guard = m_cudaContext && m_api
+                ? CudaContextGuard::create(*m_api, m_cudaContext)
+                : std::nullopt;
+        QOpenGLFunctions functions(context);
+        for (auto &[texture, cudaResource] : m_planes) {
+            GlPlaneResource plane;
+            plane.texture = texture;
+            plane.cudaResource = cudaResource;
+            plane.release(guard ? m_api : nullptr, functions);
+        }
+        m_planes.clear();
+    }
+
+private:
+    const CudaDriverApi *const m_api;
+    const CUcontext m_cudaContext;
+    const AVBufferUPtr m_device;
+    std::vector<std::pair<GLuint, CUgraphicsResource>> m_planes;
+};
+
 class CUDAGLTextureConverter final : public TextureConverterBackend
 {
 public:
@@ -490,6 +549,7 @@ private:
         releasePlaneResources();
         m_planeResourcesSize = frameSize;
         m_planeResourcesFormat = framesCtx->sw_format;
+        m_device.reset(av_buffer_ref(framesCtx->device_ref));
 
         auto *glContext =
                 static_cast<const QRhiGles2NativeHandles *>(rhi->nativeHandles())->context;
@@ -533,13 +593,31 @@ private:
         if (!rhi)
             return;
 
+        auto *glContext =
+                static_cast<const QRhiGles2NativeHandles *>(rhi->nativeHandles())->context;
+
+        if (glContext->thread() != QThread::currentThread()) {
+            // released on another thread than the one of the context: see GlPlanesRelease
+            const bool planes = ranges::any_of(m_planes, [](const auto &plane) { return bool(plane); });
+            if (!planes) {
+                m_device.reset();
+                return;
+            }
+            auto *release = new GlPlanesRelease(glContext, m_api, m_cudaContext, std::move(m_device));
+            for (auto &plane : m_planes) {
+                if (plane)
+                    release->add(*plane);
+                plane.reset();
+            }
+            release->free();
+            return;
+        }
+
         std::optional<CudaContextGuard> guard = m_cudaContext && m_api
                 ? CudaContextGuard::create(*m_api, m_cudaContext)
                 : std::nullopt;
 
         rhi->makeThreadLocalNativeContextCurrent();
-        auto *glContext =
-                static_cast<const QRhiGles2NativeHandles *>(rhi->nativeHandles())->context;
         QOpenGLFunctions functions(glContext);
 
         for (auto &plane : m_planes) {
@@ -551,6 +629,7 @@ private:
     }
 
     const CudaDriverApi *const m_api;
+    AVBufferUPtr m_device; // the decoder's device, for the planes that are freed later (GlPlanesRelease)
     PerPlaneArray<std::unique_ptr<GlPlaneResource>> m_planes;
     QSize m_planeResourcesSize;
     AVPixelFormat m_planeResourcesFormat = AV_PIX_FMT_NONE;
