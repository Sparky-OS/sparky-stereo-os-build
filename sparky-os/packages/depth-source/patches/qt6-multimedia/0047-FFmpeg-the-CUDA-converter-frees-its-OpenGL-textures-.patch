+
+// The converter of NVDEC frames keeps GL textures registered with CUDA. It is released by whoever lets go the last reference to the frames
+// context of the decoder: when a player opens another file that is the GUI thread, and the OpenGL context belongs to the scene graph's
+// render thread, where Qt aborts a QOpenGLContext made current ("Cannot make QOpenGLContext current in a different thread")
+class tst_QFFmpegCudaTextureConverter : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void releasedOnAnotherThread_data();
+    void releasedOnAnotherThread();
+};
+
+void tst_QFFmpegCudaTextureConverter::releasedOnAnotherThread_data()
+{
+    QTest::addColumn<bool>("onTheContextThread");
+    QTest::newRow("the context's thread") << true;
+    QTest::newRow("another thread") << false;
+}
+
+void tst_QFFmpegCudaTextureConverter::releasedOnAnotherThread()
+{
+    QFETCH(bool, onTheContextThread);
+
+    // CUDA refuses to unregister the resource of a texture without the texture's context current (error 219): the converter says so
+    QTest::failOnWarning(QRegularExpression(u"cuGraphicsUnregisterResource failed"_s));
+
+    QRhiGles2InitParams params;
+    params.fallbackSurface = QRhiGles2InitParams::newFallbackSurface();
+    const auto surfaceGone = qScopeGuard([&] { delete params.fallbackSurface; });
+
+    QSemaphore ready, released, finished;
+    // what holds the frames context of the decoder: the last of these to go lets the converter go
+    QFFmpeg::HWAccelUPtr hw;
+    QFFmpeg::AVFrameUPtr frame;
+    std::vector<GLuint> textures;
+    bool unavailable = false;
+    QString why;
+    std::vector<int> stillThere;
+
+    // This thread is the render thread: it owns the QRhi and its context
+    std::unique_ptr<QThread> renderThread(QThread::create([&] {
+        std::unique_ptr<QRhi> rhi(QRhi::create(QRhi::OpenGLES2, &params));
+        // whatever happens, the frames context (and the converter in it) does not outlive the QRhi the converter points to
+        auto letGo = qScopeGuard([&] {
+            frame.reset();
+            hw.reset();
+        });
+        auto handOver = qScopeGuard([&] { ready.release(); });
+        if (!rhi || !rhi->makeThreadLocalNativeContextCurrent()) {
+            unavailable = true;
+            why = u"no OpenGL context"_s;
+            return;
+        }
+        hw = QFFmpeg::HWAccel::create(AV_HWDEVICE_TYPE_CUDA);
+        if (!hw) {
+            unavailable = true;
+            why = u"no CUDA (NVDEC) device"_s;
+            return;
+        }
+        hw->createFramesContext(AV_PIX_FMT_NV12, QSize(128, 64));
+        frame = QFFmpeg::makeAVFrame();
+        if (!hw->hwFramesContextAsBuffer() || av_hwframe_get_buffer(hw->hwFramesContextAsBuffer(), frame.get(), 0) < 0) {
+            unavailable = true;
+            why = u"no CUDA frame"_s;
+            return;
+        }
+        // the converter of the decoder's frames context for this QRhi, as the decoder's frames have it
+        QFFmpeg::TextureConverter *converter =
+                QFFmpeg::HwFrameContextData::ensure(*frame).textureConverterMapper.tryMap(*rhi, QFFmpeg::TextureConverter(*rhi)).first;
+        if (!converter->init(*frame) || converter->isNull()) {
+            unavailable = true;
+            why = u"no texture converter for the CUDA frame"_s;
+            return;
+        }
+        {
+            auto handles = converter->createTextureHandles(*frame, nullptr);
+            if (!handles) {
+                unavailable = true;
+                why = u"the converter refused the frame"_s;
+                return;
+            }
+            for (int plane = 0; plane < 2; ++plane)
+                textures.push_back(GLuint(handles->textureHandle(*rhi, plane)));
+        }
+        if (onTheContextThread) {
+            // the decoder is closed here, where the context lives
+            frame.reset();
+            hw.reset();
+        } else {
+            // ... on another thread, with no context current there, as a player opening the next file closes it on the GUI thread
+            handOver.dismiss();
+            ready.release();
+            released.acquire();
+        }
+        // the textures are gone, at once or when the context is next made current (the scene graph does it at every frame)
+        QOpenGLContext *context = static_cast<const QRhiGles2NativeHandles *>(rhi->nativeHandles())->context;
+        if (!context->makeCurrent(context->surface())) {
+            unavailable = true;
+            why = u"the context cannot be made current again"_s;
+            finished.release();
+            return;
+        }
+        QOpenGLFunctions f(context);
+        for (GLuint texture : textures)
+            stillThere.push_back(f.glIsTexture(texture) ? 1 : 0);
+        finished.release();
+    }));
+    renderThread->start();
+    ready.acquire();
+    if (unavailable) {
+        renderThread->wait();
+        QSKIP(qPrintable(why));
+    }
+    if (!onTheContextThread) {
+        // the render thread's context is current nowhere here: this made Qt abort before the fix
+        QVERIFY(QThread::currentThread() != renderThread.get());
+        frame.reset();
+        hw.reset();
+        released.release();
+    }
+    finished.acquire();
+    renderThread->wait();
+    QVERIFY2(!unavailable, qPrintable(why));
+    QCOMPARE(int(textures.size()), 2);
+    for (int still : stillThere)
+        QCOMPARE(still, 0);
+}
+
+QTEST_MAIN(tst_QFFmpegCudaTextureConverter)
+#include "tst_qffmpegcudatextureconverter.moc"
