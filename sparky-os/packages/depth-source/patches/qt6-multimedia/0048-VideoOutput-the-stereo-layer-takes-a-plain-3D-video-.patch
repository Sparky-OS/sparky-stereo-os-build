+        { "8 bit", QVideoFrameFormat::Format_NV12, 8 }, { "10 bit", QVideoFrameFormat::Format_P010, 10 },
+        { "12 bit", QVideoFrameFormat::Format_P016, 12 }, { "16 bit", QVideoFrameFormat::Format_P016, 16 }
