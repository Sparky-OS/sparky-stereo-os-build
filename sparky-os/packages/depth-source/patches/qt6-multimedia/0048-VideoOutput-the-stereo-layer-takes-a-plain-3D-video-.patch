+    // ---- the views of a plain packing --------------------------------------------------------------------------------------------------
+    // One RGB texture (RGBA8, or RGBA16 normalised for a deeper source) holds the two views of the packed frame side by side, the first view
+    // of the packing at the left, each view at the size its samples have (beginUnpack makes it, unpackEye draws one view of the frame
+    // imported by importFrame, finishUnpack hands the texture out): the stereo layer draws it into its window surface.
+    bool beginUnpack(const Deep &deep, int eyeWidth, int eyeHeight, QString *why)
+    {
+        dropTrash();
+        if (deep.on && !m_deepOk) {
+            *why = QStringLiteral("this OpenGL ES has no GL_EXT_texture_norm16: the 16 bit planes have no texture format");
+            return false;
+        }
+        m_deep = deep;
+        while (m_f->glGetError() != 0) { }
+        if (deep.on)
+            makeTexture(Target, eyeWidth * 2, eyeHeight, GL_RGBA16_, GL_RGBA_, GL_UNSIGNED_SHORT_);
+        else
+            makeTexture(Target, eyeWidth * 2, eyeHeight, GL_RGBA8_, GL_RGBA_);
+        return true;
+    }
+
+    // One view of the imported frame (m_imp) into the half dstEye of the texture: pack 0 is the rectangle of the frame at origin, 1 the rows
+    // first, first + 2, ..., 2 the columns, 3 the checkers (see unpackShader()); log2w and log2h are the chroma's subsampling
+    bool unpackEye(Source source, bool fullRange, int colorSpace, int log2w, int log2h, int pack, int first, QPoint origin, QSize frame,
+                   int dstEye, int eyeWidth, int eyeHeight)
+    {
+        if (!m_imp.on)
+            return false;
+        m_f->glUseProgram(m_unpack);
+        bindExternal(0, m_imp.y, m_unpack, "u_y");
+        bindExternal(1, m_imp.uv, m_unpack, "u_u");
+        bindExternal(2, m_imp.planar ? m_imp.v : m_imp.uv, m_unpack, "u_v");
+        auto at = [&](const char *name) { return m_f->glGetUniformLocation(m_unpack, name); };
+        m_f->glUniform2i(at("u_origin"), origin.x(), origin.y());
+        m_f->glUniform2i(at("u_dst"), dstEye * eyeWidth, 0);
+        m_f->glUniform2i(at("u_frame"), frame.width(), frame.height());
+        m_f->glUniform1i(at("u_pack"), pack);
+        m_f->glUniform1i(at("u_first"), first);
+        m_f->glUniform1i(at("u_mode"), source == Source::Planar ? 0 : source == Source::SemiUV ? 1 : 2);
+        m_f->glUniform2i(at("u_shift"), log2w, log2h);
+        float kr, kb;
+        kForMatrix(colorSpace, &kr, &kb);
+        m_f->glUniform2f(at("u_k"), kr, kb);
+        m_f->glUniform1i(at("u_full"), fullRange ? 1 : 0);
+        m_f->glUniform1f(at("u_scale"), m_deep.on ? 65535.f : 255.f);
+        m_f->glUniform1f(at("u_div"), m_deep.on ? m_deep.div : 1.f);
+        m_f->glUniform1f(at("u_max"), m_deep.on ? m_deep.max : 255.f);
+        m_f->glUniform1f(at("u_mid"), m_deep.on ? m_deep.mid : 128.f);
+        m_f->glBindFramebuffer(GL_FRAMEBUFFER_, m_fbo);
+        m_f->glFramebufferTexture2D(GL_FRAMEBUFFER_, GL_COLOR_ATTACHMENT0_, GL_TEXTURE_2D_, m_tex[Target].id, 0);
+        m_f->glViewport(dstEye * eyeWidth, 0, eyeWidth, eyeHeight);
+        m_f->glDisable(0x0BE2 /* BLEND */);
+        m_f->glDisable(0x0C11 /* SCISSOR_TEST */);
+        m_f->glBindVertexArray(m_vao);
+        m_f->glDrawArrays(0x0004 /* TRIANGLES */, 0, 3);
+        return true;
+    }
+
+    // The texture leaves the drawer with the views, finished before another context draws it
+    bool finishUnpack(Views *views, QString *why)
+    {
+        m_f->glFinish();
+        *views = {};
+        views->rgb = handOut(Target);
+        views->rgbOwned = true;
+        views->generation = m_generation;
+        fillEgl(views);
+        if (m_f->glGetError() != 0) {
+            *why = QStringLiteral("the views could not be handed to the stereo layer");
+            return false;
+        }
+        return true;
+    }
+
+    // The views' texture read back to system memory (a test, a diagnostic): RGBA8888, or RGBA64 for a deeper source
+    bool readRgb(const Views &v, QImage *image)
+    {
+        bool ok = false;
+        run([&] {
+            if (v.generation != generation() || !m_context || !makeCurrent())
+                return;
+            const bool deep = v.rgb.internal == GL_RGBA16_;
+            QImage result(v.rgb.w, v.rgb.h, deep ? QImage::Format_RGBA64 : QImage::Format_RGBA8888);
+            m_f->glBindFramebuffer(GL_FRAMEBUFFER_, m_fbo);
+            m_f->glFramebufferTexture2D(GL_FRAMEBUFFER_, GL_COLOR_ATTACHMENT0_, GL_TEXTURE_2D_, v.rgb.id, 0);
+            ok = m_f->glCheckFramebufferStatus(GL_FRAMEBUFFER_) == GL_FRAMEBUFFER_COMPLETE_;
+            if (ok) {
+                m_f->glPixelStorei(0x0D05 /* GL_PACK_ALIGNMENT */, 1);
+                m_f->glPixelStorei(GL_PACK_ROW_LENGTH_, int(result.bytesPerLine() / (deep ? 8 : 4)));
+                m_f->glReadPixels(0, 0, v.rgb.w, v.rgb.h, GL_RGBA_, deep ? GL_UNSIGNED_SHORT_ : GL_UNSIGNED_BYTE_, result.bits());
+                m_f->glPixelStorei(GL_PACK_ROW_LENGTH_, 0);
+                ok = m_f->glGetError() == 0;
+            }
+            doneCurrent();
+            if (ok)
+                *image = result;
+        });
+        return ok;
+    }
