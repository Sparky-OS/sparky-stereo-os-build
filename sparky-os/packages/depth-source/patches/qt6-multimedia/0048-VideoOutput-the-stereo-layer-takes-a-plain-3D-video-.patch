+
+// ---- the views of a plain packing --------------------------------------------------------------------------------------------------
+
+#ifdef QT_MM_DEPTH_GPU
+
+struct PlainViews::Private
+{
+    std::weak_ptr<GpuDrawer> drawer;
+    GpuDrawer::Views views;
+    ~Private()
+    {
+        if (const auto owner = drawer.lock())
+            owner->recycle(views);
+    }
+};
+
+struct PlainUnpacker::Private
+{
+    std::shared_ptr<GpuDrawer> gpuOwner = std::make_shared<GpuDrawer>();
+    int frames = 0;
+};
+
+PlainViews::PlainViews() = default;
+PlainViews::~PlainViews() = default;
+PlainViews::PlainViews(PlainViews &&) noexcept = default;
+PlainViews &PlainViews::operator=(PlainViews &&) noexcept = default;
+
+bool PlainViews::layerSource(LayerSource *out) const
+{
+    if (!d)
+        return false;
+    const auto drawer = d->drawer.lock();
+    const GpuDrawer::Views &v = d->views;
+    if (!drawer || v.generation != drawer->generation() || !v.rgb.id || !v.eglDisplay || !v.eglContext)
+        return false;
+    out->eglDisplay = v.eglDisplay;
+    out->eglContext = v.eglContext;
+    out->es = v.es;
+    out->texture = v.rgb.id;
+    out->width = v.rgb.w;
+    out->height = v.rgb.h;
+    out->deep = v.rgb.internal == GL_RGBA16_;
+    return true;
+}
+
+QImage PlainViews::image() const
+{
+    QImage image;
+    if (d)
+        if (const auto drawer = d->drawer.lock())
+            drawer->readRgb(d->views, &image);
+    return image;
+}
+
+PlainUnpacker::PlainUnpacker() : d(std::make_unique<Private>()) { }
+PlainUnpacker::~PlainUnpacker() = default;
+
+int PlainUnpacker::unpackedFrames() const
+{
+    return d->frames;
+}
+
+bool PlainUnpacker::unpack(const QVideoFrame &frame, const QVideoFrame &other, Mode mode, int frameView, PlainViews *out, QString *why)
+{
+    // where each view is: the packing's samples, one pass for each view (H.264 Table D-8, H.265 Table D.8, Matroska StereoMode, RFC 9559)
+    const QSize size = frame.size();
+    int pack = 0, ew = 0, eh = 0;
+    bool sequence = false;
+    switch (mode) {
+    case Mode::SideBySide:
+    case Mode::SideBySideQuincunx:
+        ew = size.width() / 2;
+        eh = size.height();
+        break;
+    case Mode::TopBottom:
+        ew = size.width();
+        eh = size.height() / 2;
+        break;
+    case Mode::RowInterleaved:
+        pack = 1;
+        ew = size.width();
+        eh = size.height() / 2;
+        break;
+    case Mode::ColumnInterleaved:
+        pack = 2;
+        ew = size.width() / 2;
+        eh = size.height();
+        break;
+    case Mode::Checkerboard:
+        pack = 3;
+        ew = size.width() / 2;
+        eh = size.height();
+        break;
+    case Mode::FrameSequence:
+        sequence = true;
+        ew = size.width();
+        eh = size.height();
+        break;
+    default:
+        *why = QStringLiteral("the packing is not one the GPU takes apart");
+        return false;
+    }
+    if (ew <= 0 || eh <= 0 || !frame.isValid() || (sequence && (!other.isValid() || other.size() != size || other.pixelFormat() != frame.pixelFormat()))) {
+        *why = QStringLiteral("the frame has no two views of a size to draw");
+        return false;
+    }
+    Layout l;
+    GpuDrawer::Source source = GpuDrawer::Source::Planar;
+    GpuDrawer::Deep deep;
+    if (!layoutOf(frame.pixelFormat(), &l) || !gpuSourceOf(frame.pixelFormat(), l, &source, &deep) || source == GpuDrawer::Source::Rgba) {
+        *why = QStringLiteral("the pixel format %1 is not one the GPU reads").arg(QVideoFrameFormat::pixelFormatToString(frame.pixelFormat()));
+        return false;
+    }
+    if (!(l.semiPlanar && source == GpuDrawer::Source::SemiUV) && !(!l.semiPlanar && source == GpuDrawer::Source::Planar && l.count == 3)) {
+        *why = QStringLiteral("the frame's planes are neither luma with interleaved chroma nor three planes");
+        return false;
+    }
+    const QVideoFrameFormat surface = frame.surfaceFormat();
+    if (surface.viewport() != QRect(QPoint(0, 0), size) && !surface.viewport().isNull()) {
+        *why = QStringLiteral("the frame is cropped by a viewport");
+        return false;
+    }
+    QHwVideoBuffer *hw = QVideoFramePrivate::hwBuffer(frame);
+    QHwVideoBuffer *hwOther = sequence ? QVideoFramePrivate::hwBuffer(other) : nullptr;
+    if (!hw || (sequence && !hwOther)) {
+        *why = QStringLiteral("the frame is in system memory (decoded by the processor): there are no textures to take apart");
+        return false;
+    }
+    // the matrix of the frame: what it says, else what Qt's own conversion assumes (HD video is BT.709, SD BT.601)
+    QVideoFrameFormat::ColorSpace matrix = surface.colorSpace();
+    if (matrix == QVideoFrameFormat::ColorSpace_Undefined)
+        matrix = eh > 576 ? QVideoFrameFormat::ColorSpace_BT709 : QVideoFrameFormat::ColorSpace_BT601;
+    const int colorSpace = matrix == QVideoFrameFormat::ColorSpace_BT709 ? 1 : matrix == QVideoFrameFormat::ColorSpace_BT2020 ? 2 : 0;
+    const bool fullRange = surface.colorRange() == QVideoFrameFormat::ColorRange_Full;
+    const bool planar = source == GpuDrawer::Source::Planar;
+    GpuDrawer &gpu = *d->gpuOwner;
+    bool made = false;
+    gpu.run([&] { made = gpu.ensure(why, nullptr, false); });
+    if (!made)
+        return false;
+    bool ok = false;
+    GpuDrawer::Views views;
+    gpu.run([&] {
+        if (!gpu.makeCurrent()) {
+            *why = QStringLiteral("the OpenGL context could not be made current");
+            return;
+        }
+        ok = gpu.beginUnpack(deep, ew, eh, why);
+        // each view is drawn from the frame that holds it: both from the one frame, or (a frame sequence) from its own frame; the first
+        // view of the packing at the left, the left eye first for a frame sequence
+        QHwVideoBuffer *held = nullptr;
+        for (int view = 0; ok && view < 2; ++view) {
+            QHwVideoBuffer *from = hw;
+            if (sequence)
+                from = (view == 0) == (frameView == 0) ? hw : hwOther;
+            if (from != held) {
+                if (held)
+                    gpu.releaseImport();
+                bool hardware = false;
+                ok = gpu.importFrame(from, size, l.bytes, false, planar, &hardware, why);
+                // a frame the decoder keeps in system memory (a software decoder's) is no frame of textures: importFrame() says nothing
+                if (!ok && !hardware && why->isEmpty())
+                    *why = QStringLiteral("the frame is in system memory (decoded by the processor): there are no textures to take apart");
+                held = ok ? from : nullptr;
+            }
+            if (!ok)
+                break;
+            QPoint origin;
+            if (pack == 0 && !sequence) {
+                if (mode == Mode::TopBottom)
+                    origin = QPoint(0, view * eh);
+                else
+                    origin = QPoint(view * ew, 0);
+            }
+            ok = gpu.unpackEye(source, fullRange, colorSpace, l.c[1].log2w, l.c[1].log2h, pack, view, origin, size, view, ew, eh);
+        }
+        gpu.releaseImport();
+        if (ok)
+            ok = gpu.finishUnpack(&views, why);
+        gpu.doneCurrent();
+    });
+    if (!ok)
+        return false;
+    ++d->frames;
+    out->d = std::make_shared<PlainViews::Private>();
+    out->d->drawer = d->gpuOwner;
+    out->d->views = views;
+    return true;
+}
+
+#else
+
+struct PlainViews::Private { };
+struct PlainUnpacker::Private { };
+PlainViews::PlainViews() = default;
+PlainViews::~PlainViews() = default;
+PlainViews::PlainViews(PlainViews &&) noexcept = default;
+PlainViews &PlainViews::operator=(PlainViews &&) noexcept = default;
+bool PlainViews::layerSource(LayerSource *) const { return false; }
+QImage PlainViews::image() const { return {}; }
+PlainUnpacker::PlainUnpacker() : d(std::make_unique<Private>()) { }
+PlainUnpacker::~PlainUnpacker() = default;
+int PlainUnpacker::unpackedFrames() const { return 0; }
+bool PlainUnpacker::unpack(const QVideoFrame &, const QVideoFrame &, Mode, int, PlainViews *, QString *why)
+{
+    *why = QStringLiteral("this Qt Multimedia has no OpenGL");
+    return false;
+}
