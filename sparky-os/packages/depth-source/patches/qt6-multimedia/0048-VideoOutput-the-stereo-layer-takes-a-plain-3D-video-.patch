+// A frame the GPU cannot take apart where it is is not taken apart quietly: the reason is told (the caller copies it, and says it)
+void tst_QQuickVideoStereo::plainFramesTheGpuCannotTake()
+{
+    if (!QQuickVideoDepth::canDraw())
+        QSKIP("built without libstereo-dibr");
+    QQuickVideoDepth::PlainUnpacker unpacker;
+    QQuickVideoDepth::PlainViews views;
+    QString why;
+    // decoded by the processor: no textures
+    QVideoFrameFormat f(QSize(64, 32), QVideoFrameFormat::Format_NV12);
+    QVideoFrame memory(f);
+    QVERIFY(!unpacker.unpack(memory, {}, Mode::SideBySide, 0, &views, &why));
+    QVERIFY2(why.contains(u"system memory"_s) || why.contains(u"OpenGL"_s), qPrintable(why));
+    // a software decoder's frame in a QHwVideoBuffer (FFmpeg's buffer is one for every frame): no textures, and the reason is said
+    {
+        class SoftwareBuffer : public FakeHardwareBuffer
+        {
+        public:
+            using FakeHardwareBuffer::FakeHardwareBuffer;
+            void initTextureConverter(QRhi &) override { }
+        };
+        FakeCounts softwareCounts;
+        std::vector<FakeHardwareBuffer::Plane> planes;
+        planes.emplace_back(std::vector<uchar>(64 * 32), 64, 64, 32, 1);
+        planes.emplace_back(std::vector<uchar>(64 * 16), 64, 32, 16, 2);
+        const QVideoFrame software = QVideoFramePrivate::createFrame(std::make_unique<SoftwareBuffer>(f, std::move(planes), false, &softwareCounts), f);
+        why.clear();
+        QVERIFY(!unpacker.unpack(software, {}, Mode::SideBySide, 0, &views, &why));
+        QVERIFY2(why.contains(u"system memory"_s) || why.contains(u"OpenGL"_s), qPrintable(why));
+        QCOMPARE(int(softwareCounts.mapTextures), 0);
+    }
+    // a packing the GPU does not take apart (the anaglyphs hold both views in the colours)
+    why.clear();
+    QVERIFY(!unpacker.unpack(memory, {}, Mode::AnaglyphCyanRed, 0, &views, &why));
+    QVERIFY(!why.isEmpty());
+    // a converter that refuses the frame (a DMA-BUF the drawing GPU cannot import)
+    class Refusing : public FakeHardwareBuffer
+    {
+    public:
+        using FakeHardwareBuffer::FakeHardwareBuffer;
+        QVideoFrameTexturesUPtr mapTextures(QRhi &, QVideoFrameTexturesUPtr &) override { return nullptr; }
+    };
+    FakeCounts counts;
+    std::vector<FakeHardwareBuffer::Plane> planes;
+    planes.emplace_back(std::vector<uchar>(64 * 32), 64, 64, 32, 1);
+    planes.emplace_back(std::vector<uchar>(64 * 16), 64, 32, 16, 2);
+    const QVideoFrame refused = QVideoFramePrivate::createFrame(std::make_unique<Refusing>(f, std::move(planes), false, &counts), f);
+    why.clear();
+    QVERIFY(!unpacker.unpack(refused, {}, Mode::SideBySide, 0, &views, &why));
+    if (!why.contains(u"OpenGL"_s))
+        QVERIFY2(why.contains(u"refused"_s), qPrintable(why));
+    QCOMPARE(unpacker.unpackedFrames(), 0);
+}
+
+// The stereo layer draws the views in a context of its own that shares the drawing context's (EGL, eglCreateContext with the share list): EGL refuses a
+// share list of contexts with different reset notification strategies (Mesa: "share list notification strategy mismatch", EGL_BAD_MATCH), and the
+// layer's context asks for none. A drawing context made for the layer to share must therefore ask for none either.
+void tst_QQuickVideoStereo::plainViewsAreSharedByTheLayersContext()
+{
+    if (!QQuickVideoDepth::canDraw())
+        QSKIP("built without libstereo-dibr");
+    const int w = 64, h = 32;
+    QVideoFrameFormat f(QSize(w, h), QVideoFrameFormat::Format_NV12);
+    FakeCounts counts;
+    std::vector<FakeHardwareBuffer::Plane> planes;
+    planes.emplace_back(std::vector<uchar>(w * h, 90), w, w, h, 1);
+    planes.emplace_back(std::vector<uchar>(w * h / 2, 128), w, w / 2, h / 2, 2);
+    const QVideoFrame frame = QVideoFramePrivate::createFrame(std::make_unique<FakeHardwareBuffer>(f, std::move(planes), false, &counts), f);
+    QQuickVideoDepth::PlainUnpacker unpacker;
+    QQuickVideoDepth::PlainViews views;
+    QString why;
+    if (!unpacker.unpack(frame, {}, Mode::SideBySide, 0, &views, &why))
+        QSKIP(qPrintable(why));
+    QQuickVideoDepth::LayerSource source;
+    if (!views.layerSource(&source) || !source.eglContext)
+        QSKIP("the drawing context is not an EGL context on this platform");
+    QLibrary egl(u"EGL"_s);
+    using BindApi = unsigned (*)(unsigned);
+    using ChooseConfig = unsigned (*)(void *, const int *, void **, int, int *);
+    using CreateContext = void *(*)(void *, void *, void *, const int *);
+    using DestroyContext = unsigned (*)(void *, void *);
+    using GetError = int (*)();
+    auto bindApi = reinterpret_cast<BindApi>(egl.resolve("eglBindAPI"));
+    auto chooseConfig = reinterpret_cast<ChooseConfig>(egl.resolve("eglChooseConfig"));
+    auto createContext = reinterpret_cast<CreateContext>(egl.resolve("eglCreateContext"));
+    auto destroyContext = reinterpret_cast<DestroyContext>(egl.resolve("eglDestroyContext"));
+    auto getError = reinterpret_cast<GetError>(egl.resolve("eglGetError"));
+    if (!bindApi || !chooseConfig || !createContext || !destroyContext || !getError)
+        QSKIP("libEGL could not be loaded");
+    constexpr int surfaceType = 0x3033, pbuffer = 0x0001, window = 0x0004, renderable = 0x3040, openGl = 0x0008, openGles3 = 0x0040, none = 0x3038;
+    const int configAttributes[] = { surfaceType, pbuffer | window, renderable, source.es ? openGles3 : openGl, none };
+    void *config = nullptr;
+    int count = 0;
+    if (!chooseConfig(source.eglDisplay, configAttributes, &config, 1, &count) || !count)
+        QSKIP("EGL has no config of the layer's kind");
+    bindApi(source.es ? 0x30A0 /* OPENGL_ES_API */ : 0x30A2 /* OPENGL_API */);
+    constexpr int major = 0x3098, minor = 0x30FB, profile = 0x30FD, core = 0x0001;
+    const int desktop[] = { major, 3, minor, 3, profile, core, none };
+    const int es[] = { major, 3, none };
+    getError();
+    void *context = createContext(source.eglDisplay, config, source.eglContext, source.es ? es : desktop);
+    const int error = getError();
+    QVERIFY2(context, qPrintable(u"eglCreateContext sharing the drawing context's: EGL error 0x%1"_s.arg(error, 0, 16)));
+    destroyContext(source.eglDisplay, context);
