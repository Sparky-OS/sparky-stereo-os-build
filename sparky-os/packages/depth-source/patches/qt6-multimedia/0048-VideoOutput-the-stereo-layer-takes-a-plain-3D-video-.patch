+
+void tst_QQuickVideoStereo::plainPackingsOnTheGpu()
+{
+    if (!QQuickVideoDepth::canDraw())
+        QSKIP("built without libstereo-dibr");
+    QFETCH(int, mode);
+    QFETCH(int, format);
+    QFETCH(int, bits);
+    const auto stereoMode = Mode(mode);
+    const auto pf = QVideoFrameFormat::PixelFormat(format);
+    const bool deep = bits > 8;
+    const int w = 64, h = 32, bytes = deep ? 2 : 1;
+    const bool sequence = stereoMode == Mode::FrameSequence;
+    // the sample of the luma at x, y of the frame number `salt`: the address of the sample, in the words of the depth (the low bits used)
+    auto word = [&](int x, int y, int salt) -> unsigned {
+        const unsigned address = unsigned(x * 37 + y * 91 + salt * 53 + 11);
+        if (!deep)
+            return address % 251 + 2;
+        const unsigned code = (address * 2654435761u >> 7) & ((1u << bits) - 1);
+        return pf == QVideoFrameFormat::Format_P010 ? code << 6 : code << (16 - bits);
+    };
+    FakeCounts counts;
+    auto makeFrame = [&](int salt) {
+        std::vector<uchar> luma(size_t(w) * h * bytes), chroma(size_t(w) * (h / 2) * bytes);
+        for (int y = 0; y < h; ++y)
+            for (int x = 0; x < w; ++x) {
+                if (deep)
+                    reinterpret_cast<quint16 *>(luma.data())[y * w + x] = quint16(word(x, y, salt));
+                else
+                    luma[size_t(y) * w + x] = uchar(word(x, y, salt));
+            }
+        // neutral chroma: with a full range frame every channel of the picture is the luma sample itself
+        for (size_t i = 0; i < chroma.size() / bytes; ++i) {
+            if (deep)
+                reinterpret_cast<quint16 *>(chroma.data())[i] = 0x8000;
+            else
+                chroma[i] = 0x80;
+        }
+        QVideoFrameFormat f(QSize(w, h), pf);
+        f.setColorSpace(QVideoFrameFormat::ColorSpace_BT709);
+        f.setColorRange(QVideoFrameFormat::ColorRange_Full);
+        std::vector<FakeHardwareBuffer::Plane> planes;
+        planes.emplace_back(luma, w * bytes, w, h, 1);
+        planes.emplace_back(chroma, w * bytes, w / 2, h / 2, 2);
+        return QVideoFramePrivate::createFrame(std::make_unique<FakeHardwareBuffer>(f, std::move(planes), deep, &counts), f);
+    };
+    QQuickVideoDepth::PlainUnpacker unpacker;
+    // where the sample of the view `view` (0 the first of the packing) at i, j is in the frame, by the packing's definition
+    auto source = [&](int view, int i, int j) -> QPoint {
+        switch (stereoMode) {
+        case Mode::SideBySide:
+        case Mode::SideBySideQuincunx: return QPoint(view * (w / 2) + i, j);
+        case Mode::TopBottom: return QPoint(i, view * (h / 2) + j);
+        case Mode::RowInterleaved: return QPoint(i, 2 * j + view);
+        case Mode::ColumnInterleaved: return QPoint(2 * i + view, j);
+        case Mode::Checkerboard: return QPoint(std::min(((j + view) & 1) + 2 * i, w - 1), j);
+        default: return QPoint(i, j);
+        }
+    };
+    const QSize eye = sequence ? QSize(w, h) : stereoMode == Mode::TopBottom || stereoMode == Mode::RowInterleaved ? QSize(w, h / 2) : QSize(w / 2, h);
+    // frame sequence: the frame is the right eye in one run and the left in the other (the texture always holds the left eye first)
+    for (int frameView = 0; frameView < (sequence ? 2 : 1); ++frameView) {
+        const QVideoFrame frame = makeFrame(0), other = sequence ? makeFrame(1) : QVideoFrame();
+        // the former gate: a frame that is not the drawn views of a depth video is no source for the layer
+        QQuickVideoDepth::LayerSource none;
+        QVERIFY(!QQuickVideoDepth::layerSourceOf(frame, &none));
+        QQuickVideoDepth::PlainViews views;
+        QString why;
+        counts.maps = counts.mapTextures = 0;
+        if (!unpacker.unpack(frame, other, stereoMode, frameView, &views, &why)) {
+            if (why.contains(u"OpenGL"_s) || why.contains(u"context"_s))
+                QSKIP(qPrintable(why));
+            QFAIL(qPrintable(why));
+        }
+        // never read back, the planes mapped once for a frame, twice for the two frames of a sequence
+        QCOMPARE(int(counts.maps), 0);
+        QCOMPARE(int(counts.mapTextures), sequence ? 2 : 1);
+        QQuickVideoDepth::LayerSource layer;
+        if (views.layerSource(&layer)) {
+            QCOMPARE(layer.width, 2 * eye.width());
+            QCOMPARE(layer.height, eye.height());
+            QCOMPARE(layer.deep, deep);
+        }
+        const QImage image = views.image();
+        QCOMPARE(image.size(), QSize(2 * eye.width(), eye.height()));
+        int wrong = 0, different = 0;
+        for (int view = 0; view < 2; ++view)
+            for (int j = 0; j < eye.height(); ++j)
+                for (int i = 0; i < eye.width(); ++i) {
+                    const QPoint at = source(view, i, j);
+                    // the frame sequence's left eye is `frame` when frameView is 0, else `other`
+                    const int salt = sequence ? (view == 0) == (frameView == 0) ? 0 : 1 : 0;
+                    const unsigned expected = word(at.x(), at.y(), salt);
+                    const QRgba64 pixel = image.pixelColor(view * eye.width() + i, j).rgba64();
+                    const unsigned got = deep ? pixel.red() : pixel.red8();
+                    const unsigned tolerance = deep ? 1 : 1;
+                    if (got + tolerance < expected || got > expected + tolerance)
+                        ++wrong;
+                    if (view == 1 && image.pixel(i, j) != image.pixel(eye.width() + i, j))
+                        ++different;
+                }
+        QVERIFY2(wrong == 0, qPrintable(u"%1 samples of %2 are not the samples the packing keeps for the view"_s.arg(wrong).arg(2 * eye.width() * eye.height())));
+        // the two views are made of different samples (the control: a pass that drew one view twice fails the check above, and the frames are
+        // made so that every view differs from the other)
+        QVERIFY2(different > eye.width() * eye.height() / 2, qPrintable(u"%1 of the samples differ between the views"_s.arg(different)));
+    }
+    QCOMPARE(unpacker.unpackedFrames(), sequence ? 2 : 1);
+}
