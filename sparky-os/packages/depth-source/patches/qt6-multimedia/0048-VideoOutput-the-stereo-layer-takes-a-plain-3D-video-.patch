+// The conversion of kConvert for one view of a plain packing: the pixel of the view the pass draws (u_dst is where the view starts in the
+// target) is the sample of the frame the packing keeps for it. Nothing is interpolated: a view is the samples of its own rows, columns or
+// checkers, or a rectangle of the frame (u_origin). u_pack: 0 rectangle, 1 every second row, 2 every second column, 3 checkerboard.
+QByteArray unpackShader()
+{
+    static const char head[] = "uniform ivec2 u_origin;";
+    static const char line[] = "ivec2 at = ivec2(gl_FragCoord.xy) + u_origin;";
+    static const char block[] =
+        "uniform ivec2 u_dst;\n"
+        "uniform ivec2 u_frame;\n"
+        "uniform int u_pack;\n"
+        "uniform int u_first;\n";
+    static const char at[] =
+        "ivec2 e = ivec2(gl_FragCoord.xy) - u_dst;\n"
+        "    ivec2 at = u_origin + e;\n"
+        "    if (u_pack == 1)\n"
+        "        at = ivec2(e.x, 2 * e.y + u_first);\n"
+        "    else if (u_pack == 2)\n"
+        "        at = ivec2(2 * e.x + u_first, e.y);\n"
+        "    else if (u_pack == 3)\n"
+        "        at = ivec2(min(((e.y + u_first) & 1) + 2 * e.x, u_frame.x - 1), e.y);";
+    QByteArray text(kConvert);
+    if (!text.contains(head) || !text.contains(line))
+        return {};
+    text.replace(QByteArray(line), QByteArray(at));
+    QByteArray declarations(head);
+    declarations.append('\n').append(block);
+    text.replace(QByteArray(head), declarations);
+    return text;
+}
