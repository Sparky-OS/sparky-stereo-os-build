From 2e49148099772aa2d778d49d698be4d08270c06f Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 5 Nov 2026 00:40:11 -0300
Subject: [PATCH 24/24] FFmpeg backend: say when no format of a stream is a
 hardware format of the device

A stream the routed hardware device cannot take is decoded in software, which the log now says in every case: with no hardware format among the formats offered, with a depth layer, and with fewer bits per sample (the last two already did). The depth layer message is a warning like the other.

Assisted-by: Claude Sonnet 5.5 via Claude Code
---
 src/plugins/multimedia/ffmpeg/qffmpeghwaccel.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/plugins/multimedia/ffmpeg/qffmpeghwaccel.cpp b/src/plugins/multimedia/ffmpeg/qffmpeghwaccel.cpp
index a903b2245..281774f1f 100644
--- a/src/plugins/multimedia/ffmpeg/qffmpeghwaccel.cpp
+++ b/src/plugins/multimedia/ffmpeg/qffmpeghwaccel.cpp
@@ -356,12 +356,15 @@ AVPixelFormat getFormat(AVCodecContext *codecContext, const AVPixelFormat *fmt)
         }
 
         auto format = formatAndScore.value;
+        if (!format)
+            qCWarning(qLHWAccel) << "Not decoding in hardware: none of the formats of the stream "
+                                    "is a hardware format of the device";
         // No hardware decoder outputs the depth auxiliary layer of an H.265 stream: a stream that
         // has one (the decoder says it, depth_available) is decoded in software when its depth
         // pictures are asked for (depth_output). This comes first, so that no hardware frames are
         // set up for nothing
         if (format && decoderOutputsDepthLayer(codecContext)) {
-            qCInfo(qLHWAccel) << "Not decoding in hardware: the stream has a depth layer, which "
+            qCWarning(qLHWAccel) << "Not decoding in hardware: the stream has a depth layer, which "
                                  "only software decoding outputs";
             format = std::nullopt;
         }
