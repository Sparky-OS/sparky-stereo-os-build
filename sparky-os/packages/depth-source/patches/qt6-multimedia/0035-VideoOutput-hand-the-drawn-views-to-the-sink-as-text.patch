+    QTest::newRow("8 bit, YUV 4:4:4") << int(QVideoFrameFormat::Format_YUV444P);
+    QTest::newRow("10 bit, YUV 4:2:0") << int(QVideoFrameFormat::Format_YUV420P10);
+    QTest::newRow("10 bit, P010") << int(QVideoFrameFormat::Format_P010);
