+        put(EGL_GREEN_SIZE, 16);
+        put(EGL_BLUE_SIZE, 16);
+        put(EGL_ALPHA_SIZE, 16);
+        break;
+    case BufferFormat::Xbgr16161616:
+        return false; // no window surface of 16 bit unsigned normalised in EGL
+    }
+    out[n] = EGL_NONE;
+    return true;
