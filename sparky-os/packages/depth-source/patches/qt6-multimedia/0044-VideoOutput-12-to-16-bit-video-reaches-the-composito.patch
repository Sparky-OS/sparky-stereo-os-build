+void feedbackFormatTable(void *data, zwp_linux_dmabuf_feedback_v1 *, int32_t fd, uint32_t size)
+{
+    auto *g = static_cast<Globals *>(data);
+    void *table = mmap(nullptr, size, PROT_READ, MAP_PRIVATE, fd, 0);
