+
+QT_BEGIN_NAMESPACE
+
+namespace QtPipeWire {
+
+class QPipeWireInstance;
+
+// Parses the value of a default metadata key, a JSON object with a "name" member,
+// for example { "name": "v4l2_input.pci-0000_00_14.0-usb-0_1_1.0" }.
+Q_MULTIMEDIA_EXPORT std::optional<QByteArray> parseDefaultSourceName(const char *json);
+
+// What the session says about the default camera, and what that means for a list of V4L2 devices.
+// The session's default is the person's choice in WirePlumber ("default.configured.video.source").
+// Not thread safe: the owner serialises the calls.
+class Q_MULTIMEDIA_EXPORT QDefaultCameraState
+{
+public:
+    struct Choice
+    {
+        enum class Kind : uint8_t {
+            NoChoice, // nobody has chosen a default camera
+            Device, // the chosen camera is a V4L2 device: devicePath
+            NotConnected, // the chosen camera is not (or no longer) a node of the session
+            NoDevicePath, // the chosen camera is a node without a V4L2 device (libcamera, a stream)
+        };
+
+        Kind kind = Kind::NoChoice;
+        QByteArray nodeName;
+        QByteArray devicePath;
+
+        friend bool operator==(const Choice &a, const Choice &b)
+        {
+            return a.kind == b.kind && a.nodeName == b.nodeName && a.devicePath == b.devicePath;
+        }
+        friend bool operator!=(const Choice &a, const Choice &b) { return !(a == b); }
+    };
+
+    void nodeAdded(uint32_t id, std::string_view nodeName, std::string_view mediaClass,
+                   std::string_view v4l2Path);
+    void nodeRemoved(uint32_t id);
+    void setConfiguredName(std::optional<QByteArray> nodeName);
+
+    Choice choice() const;
+
+private:
+    struct Node
+    {
+        std::string name;
+        std::string v4l2Path;
+    };
+
+    std::map<uint32_t, Node> m_nodes; // the camera nodes (Video/Source)
+    std::optional<QByteArray> m_configuredName;
+};
+
+struct QDefaultCameraPick
+{
+    // the index of the default camera in the list the caller gave
+    qsizetype index = 0;
+    // empty when the session's default was found; otherwise why the list's first camera stays the default
+    QString problem;
+};
+
+// Which of the V4L2 devices (their /dev/videoN paths, in the order Qt lists them) is the session's default.
+// sessionKnown is false when there is no PipeWire session to ask. The first device is the default as long as nobody
+// chose another, and when the choice cannot be found among the devices, problem says why.
+Q_MULTIMEDIA_EXPORT QDefaultCameraPick pickDefaultCamera(QSpan<const QByteArray> devicePaths,
+                                                          bool sessionKnown,
+                                                          const QDefaultCameraState::Choice &choice);
+
+// Follows the session's default camera through a connection to PipeWire of its own.
+class Q_MULTIMEDIA_EXPORT QDefaultCameraMonitor : public QObject
+{
+    Q_OBJECT
+public:
+    explicit QDefaultCameraMonitor(QObject *parent = nullptr);
+    ~QDefaultCameraMonitor() override;
+
+    static bool isSupported();
+
+    // false when no PipeWire session answered: the default is then unknown
+    bool isConnected() const;
+    QDefaultCameraState::Choice choice() const;
+
+Q_SIGNALS:
+    // emitted from the PipeWire thread: connect it with a queued or automatic connection
+    void choiceChanged();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace QtPipeWire
+
+QT_END_NAMESPACE
+
+#endif // QPIPEWIRE_DEFAULTCAMERA_P_H
