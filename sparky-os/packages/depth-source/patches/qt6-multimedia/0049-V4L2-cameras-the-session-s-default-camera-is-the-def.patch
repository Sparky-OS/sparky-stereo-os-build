+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR GPL-3.0-only
+
+#include <QtMultimedia/private/qpipewire_defaultcamera_p.h>
+#include <QtTest/QtTest>
+
+using namespace QtPipeWire;
+using Kind = QDefaultCameraState::Choice::Kind;
+
+Q_DECLARE_METATYPE(QtPipeWire::QDefaultCameraState::Choice)
+
+class tst_QPipeWireDefaultCamera : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void parseDefaultSourceName_data();
+    void parseDefaultSourceName();
+    void parseDefaultSourceName_nullPointer();
+
+    void state_noChoiceWithoutConfiguredName();
+    void state_findsTheChosenCamera();
+    void state_followsTheCameraBeingUnplugged();
+    void state_ignoresNodesThatAreNotCameras();
+    void state_saysWhenTheChosenCameraHasNoV4L2Device();
+
+    void pickDefaultCamera_noSession();
+    void pickDefaultCamera_noChoiceKeepsTheFirstCamera();
+    void pickDefaultCamera_findsTheChosenCamera();
+    void pickDefaultCamera_saysWhyTheFirstCameraStays_data();
+    void pickDefaultCamera_saysWhyTheFirstCameraStays();
+
+    void monitor_withoutSession();
+};
+
+void tst_QPipeWireDefaultCamera::parseDefaultSourceName_data()
+{
+    QTest::addColumn<QByteArray>("json");
+    QTest::addColumn<QByteArray>("expected"); // null: not parsed
+
+    QTest::newRow("name") << QByteArray(R"({ "name": "v4l2_input.usb-1" })")
+                          << QByteArray("v4l2_input.usb-1");
+    QTest::newRow("other members first")
+            << QByteArray(R"({ "x": 1, "name": "cam" })") << QByteArray("cam");
+    QTest::newRow("no name") << QByteArray(R"({ "x": 1 })") << QByteArray();
+    QTest::newRow("not an object") << QByteArray(R"("cam")") << QByteArray();
+    QTest::newRow("empty") << QByteArray("") << QByteArray();
+}
+
+void tst_QPipeWireDefaultCamera::parseDefaultSourceName()
+{
+    QFETCH(QByteArray, json);
+    QFETCH(QByteArray, expected);
+
+    const auto name = QtPipeWire::parseDefaultSourceName(json.constData());
+    if (expected.isNull())
+        QVERIFY(!name);
+    else
+        QCOMPARE(name, expected);
+}
+
+void tst_QPipeWireDefaultCamera::parseDefaultSourceName_nullPointer()
+{
+    QVERIFY(!QtPipeWire::parseDefaultSourceName(nullptr));
+}
+
+void tst_QPipeWireDefaultCamera::state_noChoiceWithoutConfiguredName()
+{
+    QDefaultCameraState state;
+    state.nodeAdded(40, "cam-a", "Video/Source", "/dev/video0");
+    QCOMPARE(state.choice().kind, Kind::NoChoice);
+
+    state.setConfiguredName(QByteArray("cam-a"));
+    state.setConfiguredName(std::nullopt);
+    QCOMPARE(state.choice().kind, Kind::NoChoice);
+}
+
+void tst_QPipeWireDefaultCamera::state_findsTheChosenCamera()
+{
+    QDefaultCameraState state;
+    state.nodeAdded(40, "cam-a", "Video/Source", "/dev/video0");
+    state.nodeAdded(41, "cam-b", "Video/Source", "/dev/video2");
+    state.setConfiguredName(QByteArray("cam-b"));
+
+    const auto choice = state.choice();
+    QCOMPARE(choice.kind, Kind::Device);
+    QCOMPARE(choice.nodeName, QByteArray("cam-b"));
+    QCOMPARE(choice.devicePath, QByteArray("/dev/video2"));
+}
+
+void tst_QPipeWireDefaultCamera::state_followsTheCameraBeingUnplugged()
+{
+    QDefaultCameraState state;
+    state.setConfiguredName(QByteArray("cam-b"));
+    // the choice is saved before the camera is seen (the session's start), and the camera may go and come
+    QCOMPARE(state.choice().kind, Kind::NotConnected);
+
+    state.nodeAdded(41, "cam-b", "Video/Source", "/dev/video2");
+    QCOMPARE(state.choice().kind, Kind::Device);
+
+    state.nodeRemoved(41);
+    QCOMPARE(state.choice().kind, Kind::NotConnected);
+
+    state.nodeAdded(52, "cam-b", "Video/Source", "/dev/video4"); // plugged in again, another node
+    QCOMPARE(state.choice().devicePath, QByteArray("/dev/video4"));
+}
+
+void tst_QPipeWireDefaultCamera::state_ignoresNodesThatAreNotCameras()
+{
+    QDefaultCameraState state;
+    state.setConfiguredName(QByteArray("alsa_input.pci"));
+    state.nodeAdded(30, "alsa_input.pci", "Audio/Source", "");
+    QCOMPARE(state.choice().kind, Kind::NotConnected);
+}
+
+void tst_QPipeWireDefaultCamera::state_saysWhenTheChosenCameraHasNoV4L2Device()
+{
+    QDefaultCameraState state;
+    state.nodeAdded(60, "libcamera_input.ov5640", "Video/Source", "");
+    state.setConfiguredName(QByteArray("libcamera_input.ov5640"));
+    QCOMPARE(state.choice().kind, Kind::NoDevicePath);
+}
+
+static QDefaultCameraState::Choice deviceChoice(const QByteArray &path)
+{
+    QDefaultCameraState::Choice choice;
+    choice.kind = Kind::Device;
+    choice.nodeName = "cam";
+    choice.devicePath = path;
+    return choice;
+}
+
+void tst_QPipeWireDefaultCamera::pickDefaultCamera_noSession()
+{
+    const QList<QByteArray> paths{ "/dev/video0", "/dev/video2" };
+    const auto pick = pickDefaultCamera(paths, /*sessionKnown=*/false, {});
+    QCOMPARE(pick.index, 0);
+    QVERIFY(!pick.problem.isEmpty());
+}
+
+void tst_QPipeWireDefaultCamera::pickDefaultCamera_noChoiceKeepsTheFirstCamera()
+{
+    const QList<QByteArray> paths{ "/dev/video0", "/dev/video2" };
+    const auto pick = pickDefaultCamera(paths, true, {});
+    QCOMPARE(pick.index, 0);
+    QVERIFY(pick.problem.isEmpty());
+}
+
+void tst_QPipeWireDefaultCamera::pickDefaultCamera_findsTheChosenCamera()
+{
+    const QList<QByteArray> paths{ "/dev/video0", "/dev/video2", "/dev/video4" };
+    const auto pick = pickDefaultCamera(paths, true, deviceChoice("/dev/video4"));
+    QCOMPARE(pick.index, 2);
+    QVERIFY(pick.problem.isEmpty());
+}
+
+void tst_QPipeWireDefaultCamera::pickDefaultCamera_saysWhyTheFirstCameraStays_data()
+{
+    QTest::addColumn<QDefaultCameraState::Choice>("choice");
+
+    QDefaultCameraState::Choice notConnected;
+    notConnected.kind = Kind::NotConnected;
+    notConnected.nodeName = "cam";
+    QTest::newRow("not connected") << notConnected;
+
+    QDefaultCameraState::Choice noPath;
+    noPath.kind = Kind::NoDevicePath;
+    noPath.nodeName = "cam";
+    QTest::newRow("no V4L2 device") << noPath;
+
+    QTest::newRow("not among the cameras") << deviceChoice("/dev/video9");
+}
+
+void tst_QPipeWireDefaultCamera::pickDefaultCamera_saysWhyTheFirstCameraStays()
+{
+    QFETCH(QDefaultCameraState::Choice, choice);
+
+    const QList<QByteArray> paths{ "/dev/video0", "/dev/video2" };
+    const auto pick = pickDefaultCamera(paths, true, choice);
+    QCOMPARE(pick.index, 0);
+    QVERIFY(pick.problem.contains(QStringLiteral("cam")));
+}
+
+void tst_QPipeWireDefaultCamera::monitor_withoutSession()
+{
+    if (!QDefaultCameraMonitor::isSupported())
+        QSKIP("PipeWire is not available");
+
+    QTemporaryDir emptyRuntimeDir; // no PipeWire socket in it
+    QVERIFY(emptyRuntimeDir.isValid());
+    qputenv("PIPEWIRE_RUNTIME_DIR", emptyRuntimeDir.path().toUtf8());
+    qputenv("XDG_RUNTIME_DIR", emptyRuntimeDir.path().toUtf8());
+    qunsetenv("PIPEWIRE_REMOTE");
+
+    QDefaultCameraMonitor monitor;
+    QVERIFY(!monitor.isConnected());
+    QCOMPARE(monitor.choice().kind, Kind::NoChoice);
+}
+
+QTEST_GUILESS_MAIN(tst_QPipeWireDefaultCamera)
+
+#include "tst_qpipewiredefaultcamera.moc"
