+
+namespace QtPipeWire {
+
+Q_STATIC_LOGGING_CATEGORY(lcDefaultCamera, "qt.multimedia.pipewire.defaultcamera")
+
+using namespace std::string_view_literals;
+
+namespace {
+
+constexpr std::string_view configuredVideoSourceKey = "default.configured.video.source"sv;
+constexpr std::string_view v4l2PathKey = "api.v4l2.path"sv;
+constexpr std::string_view videoSourceClass = "Video/Source"sv;
+constexpr std::string_view v4l2ObjectPathPrefix = "v4l2:"sv;
+
+std::string_view lookup(const spa_dict &dict, const char *key)
+{
+    const char *value = spa_dict_lookup(&dict, key);
+    return value ? std::string_view{ value } : std::string_view{};
+}
+
+} // namespace
+
+std::optional<QByteArray> parseDefaultSourceName(const char *json_str)
+{
+    if (!json_str)
+        return std::nullopt;
+
+#if __has_include(<spa/utils/json.h>)
+    struct spa_json json;
+    spa_json_init(&json, json_str, strlen(json_str));
+
+    struct spa_json it;
+    if (spa_json_enter_object(&json, &it) > 0) {
+        char key[256];
+        while (spa_json_get_string(&it, key, sizeof(key)) > 0) {
+            if (key == "name"sv) {
+                char value[16384];
+                if (spa_json_get_string(&it, value, sizeof(value)) >= 0)
+                    return QByteArray{ value };
+            } else {
+                const char *skipped = nullptr;
+                spa_json_next(&it, &skipped);
+            }
+        }
+    }
+
+    return std::nullopt;
+#else
+    using namespace Qt::Literals;
+
+    QJsonDocument doc = QJsonDocument::fromJson(QByteArray{ json_str });
+    if (doc.isNull())
+        return std::nullopt;
+
+    QJsonValue name = doc[u"name"_s];
+    if (!name.isString())
+        return std::nullopt;
+    return name.toString().toUtf8();
+#endif
+}
+
+// QDefaultCameraState
+
+void QDefaultCameraState::nodeAdded(uint32_t id, std::string_view nodeName,
+                                    std::string_view mediaClass, std::string_view v4l2Path)
+{
+    if (mediaClass != videoSourceClass || nodeName.empty())
+        return;
+    m_nodes[id] = Node{ std::string{ nodeName }, std::string{ v4l2Path } };
+}
+
+void QDefaultCameraState::nodeRemoved(uint32_t id)
+{
+    m_nodes.erase(id);
+}
+
+void QDefaultCameraState::setConfiguredName(std::optional<QByteArray> nodeName)
+{
+    m_configuredName = std::move(nodeName);
+}
+
+QDefaultCameraState::Choice QDefaultCameraState::choice() const
+{
+    Choice result;
+    if (!m_configuredName || m_configuredName->isEmpty())
+        return result;
+
+    result.nodeName = *m_configuredName;
+    result.kind = Choice::Kind::NotConnected;
+
+    const std::string_view wanted{ m_configuredName->constData(),
+                                   size_t(m_configuredName->size()) };
+    for (const auto &[id, node] : m_nodes) {
+        if (node.name != wanted)
+            continue;
+        if (node.v4l2Path.empty()) {
+            result.kind = Choice::Kind::NoDevicePath;
+        } else {
+            result.kind = Choice::Kind::Device;
+            result.devicePath = QByteArray::fromStdString(node.v4l2Path);
+        }
+        break;
+    }
+    return result;
+}
+
+QDefaultCameraPick pickDefaultCamera(QSpan<const QByteArray> devicePaths, bool sessionKnown,
+                                     const QDefaultCameraState::Choice &choice)
+{
+    using Kind = QDefaultCameraState::Choice::Kind;
+
+    // as before the session was asked: the first camera is the default
+    QDefaultCameraPick pick;
+
+    if (!sessionKnown) {
+        pick.problem = QStringLiteral("There is no PipeWire session to ask, so the session's "
+                                      "default camera is not known");
+        return pick;
+    }
+
+    const QString name = QString::fromUtf8(choice.nodeName);
+    switch (choice.kind) {
+    case Kind::NoChoice:
+        return pick;
+    case Kind::NotConnected:
+        pick.problem = QStringLiteral("The camera chosen as the default (%1) is not connected")
+                               .arg(name);
+        return pick;
+    case Kind::NoDevicePath:
+        pick.problem = QStringLiteral("The camera chosen as the default (%1) is not a V4L2 "
+                                      "device, which this backend reads")
+                               .arg(name);
+        return pick;
+    case Kind::Device:
+        break;
+    }
+
+    const auto it = std::find(devicePaths.begin(), devicePaths.end(), choice.devicePath);
+    if (it == devicePaths.end()) {
+        pick.problem = QStringLiteral("The camera chosen as the default (%1, %2) is not among "
+                                      "the cameras that can be used")
+                               .arg(name, QString::fromUtf8(choice.devicePath));
+        return pick;
+    }
+
+    pick.index = it - devicePaths.begin();
+    return pick;
+}
+
+// QDefaultCameraMonitor
+
+struct QDefaultCameraMonitor::Impl
+{
+    explicit Impl(QDefaultCameraMonitor *owner) : owner(owner) { }
+    ~Impl();
+
+    bool start();
+    void stop();
+
+    static void onGlobal(void *data, uint32_t id, uint32_t permissions, const char *type,
+                         uint32_t version, const spa_dict *props);
+    static void onGlobalRemove(void *data, uint32_t id);
+    static void onDone(void *data, uint32_t id, int seq);
+    static int onMetadataProperty(void *data, uint32_t subject, const char *key, const char *type,
+                                  const char *value);
+
+    void bindDefaultMetadata(uint32_t id, uint32_t version);
+    template <typename Closure>
+    void update(Closure &&closure);
+
+    QDefaultCameraMonitor *owner;
+
+    std::shared_ptr<QPipeWireInstance> library;
+    PwThreadLoopHandle loop;
+    PwContextHandle context;
+    PwCoreConnectionHandle core;
+    PwRegistryHandle registry;
+    PwMetadataHandle metadata;
+    spa_hook coreListener{};
+    spa_hook registryListener{};
+    spa_hook metadataListener{};
+    bool loopStarted = false;
+
+    // the first two roundtrips tell the connection when the session has said what it has
+    int pendingSync = -1;
+    int syncPhase = 0;
+    bool initialStateKnown = false;
+
+    mutable QMutex mutex;
+    QDefaultCameraState state;
+    QDefaultCameraState::Choice lastChoice;
+    bool connected = false;
+};
+
+template <typename Closure>
+void QDefaultCameraMonitor::Impl::update(Closure &&closure)
+{
+    bool changed = false;
+    {
+        QMutexLocker locker(&mutex);
+        closure(state);
+        QDefaultCameraState::Choice now = state.choice();
+        changed = now != lastChoice;
+        lastChoice = std::move(now);
+    }
+    if (changed)
+        emit owner->choiceChanged();
+}
+
+void QDefaultCameraMonitor::Impl::onGlobal(void *data, uint32_t id, uint32_t, const char *type,
+                                           uint32_t version, const spa_dict *props)
+{
+    auto *self = static_cast<Impl *>(data);
+    if (!props || !type)
+        return;
+
+    const std::string_view typeName{ type };
+    if (typeName == PW_TYPE_INTERFACE_Node) {
+        const std::string_view mediaClass = lookup(*props, PW_KEY_MEDIA_CLASS);
+        const std::string_view nodeName = lookup(*props, PW_KEY_NODE_NAME);
+        // The registry carries only some of a node's properties. PipeWire's V4L2 source gives its nodes
+        // object.path "v4l2:/dev/videoN", and the full property api.v4l2.path comes with the node's info.
+        std::string_view path = lookup(*props, v4l2PathKey.data());
+        if (path.empty()) {
+            const std::string_view objectPath = lookup(*props, PW_KEY_OBJECT_PATH);
+            if (objectPath.substr(0, v4l2ObjectPathPrefix.size()) == v4l2ObjectPathPrefix)
+                path = objectPath.substr(v4l2ObjectPathPrefix.size());
+        }
+        if (mediaClass == videoSourceClass) {
+            qCDebug(lcDefaultCamera) << "camera node" << id << QByteArray(nodeName.data(), qsizetype(nodeName.size()))
+                                     << QByteArray(path.data(), qsizetype(path.size()));
+            self->update([&](QDefaultCameraState &s) { s.nodeAdded(id, nodeName, mediaClass, path); });
+        }
+    } else if (typeName == PW_TYPE_INTERFACE_Metadata) {
+        if (lookup(*props, PW_KEY_METADATA_NAME) == "default"sv)
+            self->bindDefaultMetadata(id, version);
+    }
+}
+
+void QDefaultCameraMonitor::Impl::onGlobalRemove(void *data, uint32_t id)
+{
+    auto *self = static_cast<Impl *>(data);
+    self->update([&](QDefaultCameraState &s) { s.nodeRemoved(id); });
+}
+
+void QDefaultCameraMonitor::Impl::onDone(void *data, uint32_t id, int seq)
+{
+    auto *self = static_cast<Impl *>(data);
+    if (id != PW_ID_CORE || seq != self->pendingSync)
+        return;
+
+    if (self->syncPhase == 0) {
+        // the globals have arrived and the default metadata is bound: ask once more for its first values
+        self->syncPhase = 1;
+        self->pendingSync = pw_core_sync(self->core.get(), PW_ID_CORE, 0);
+        return;
+    }
+
+    self->initialStateKnown = true;
+    pw_thread_loop_signal(self->loop.get(), false);
+}
+
+int QDefaultCameraMonitor::Impl::onMetadataProperty(void *data, uint32_t subject, const char *key,
+                                                    const char *type, const char *value)
+{
+    auto *self = static_cast<Impl *>(data);
+    if (subject != PW_ID_CORE)
+        return 0;
+
+    // a null key clears every property of the subject
+    if (!key) {
+        self->update([](QDefaultCameraState &s) { s.setConfiguredName(std::nullopt); });
+        return 0;
+    }
+    if (std::string_view{ key } != configuredVideoSourceKey)
+        return 0;
+
+    std::optional<QByteArray> name;
+    if (value) {
+        if (type && std::string_view{ type } == "Spa:String:JSON"sv)
+            name = parseDefaultSourceName(value);
+        if (!name)
+            qCWarning(lcDefaultCamera) << "Cannot read the default camera from the session's"
+                                       << key << "=" << value;
+    }
+    self->update([&](QDefaultCameraState &s) { s.setConfiguredName(std::move(name)); });
+    return 0;
+}
+
+void QDefaultCameraMonitor::Impl::bindDefaultMetadata(uint32_t id, uint32_t version)
+{
+    if (metadata || version < PW_VERSION_METADATA)
+        return;
+
+    static constexpr pw_metadata_events metadataEvents = {
+        .version = PW_VERSION_METADATA_EVENTS,
+        .property = &Impl::onMetadataProperty,
+    };
+
+    metadata = PwMetadataHandle{
+        reinterpret_cast<pw_metadata *>(pw_registry_bind(registry.get(), id,
+                                                         PW_TYPE_INTERFACE_Metadata,
+                                                         PW_VERSION_METADATA, 0)),
+    };
+    if (!metadata) {
+        qCWarning(lcDefaultCamera) << "Cannot bind the session's default metadata";
+        return;
+    }
+    pw_metadata_add_listener(metadata.get(), &metadataListener, &metadataEvents, this);
+}
+
+bool QDefaultCameraMonitor::Impl::start()
+{
+    library = QPipeWireInstance::instance();
+
+    loop = PwThreadLoopHandle{ pw_thread_loop_new("QDefaultCamera", nullptr) };
+    if (!loop)
+        return false;
+
+    context = PwContextHandle{ pw_context_new(pw_thread_loop_get_loop(loop.get()), nullptr, 0) };
+    if (!context)
+        return false;
+
+    core = PwCoreConnectionHandle{ pw_context_connect(context.get(), nullptr, 0) };
+    if (!core) {
+        qCDebug(lcDefaultCamera) << "No PipeWire session:" << make_error_code().message();
+        return false;
+    }
+
+    static constexpr pw_core_events coreEvents = {
+        .version = PW_VERSION_CORE_EVENTS,
+        .done = &Impl::onDone,
+    };
+    pw_core_add_listener(core.get(), &coreListener, &coreEvents, this);
+
+    registry = PwRegistryHandle{
+        pw_core_get_registry(core.get(), PW_VERSION_REGISTRY, 0),
+    };
+    if (!registry)
+        return false;
+
+    static constexpr pw_registry_events registryEvents = {
+        .version = PW_VERSION_REGISTRY_EVENTS,
+        .global = &Impl::onGlobal,
+        .global_remove = &Impl::onGlobalRemove,
+    };
+    pw_registry_add_listener(registry.get(), &registryListener, &registryEvents, this);
+
+    pendingSync = pw_core_sync(core.get(), PW_ID_CORE, 0);
+    if (pw_thread_loop_start(loop.get()) < 0)
+        return false;
+    loopStarted = true;
+
+    // wait for what the session has to say about its cameras, but never for long
+    pw_thread_loop_lock(loop.get());
+    for (int attempt = 0; !initialStateKnown && attempt < 2; ++attempt)
+        pw_thread_loop_timed_wait(loop.get(), 1);
+    const bool known = initialStateKnown;
+    pw_thread_loop_unlock(loop.get());
+
+    if (!known)
+        qCWarning(lcDefaultCamera) << "The PipeWire session did not answer in two seconds";
+    return true;
+}
+
+void QDefaultCameraMonitor::Impl::stop()
+{
+    if (loopStarted)
+        pw_thread_loop_lock(loop.get());
+
+    if (metadata) {
+        spa_hook_remove(&metadataListener);
+        metadata.reset();
+    }
+    if (registry) {
+        spa_hook_remove(&registryListener);
+        registry.reset();
+    }
+    if (core)
+        spa_hook_remove(&coreListener);
+
+    if (loopStarted) {
+        pw_thread_loop_unlock(loop.get());
+        pw_thread_loop_stop(loop.get());
+        loopStarted = false;
+    }
+}
+
+QDefaultCameraMonitor::Impl::~Impl()
+{
+    stop();
+    core.reset();
+    context.reset();
+    loop.reset();
+}
+
+QDefaultCameraMonitor::QDefaultCameraMonitor(QObject *parent)
+    : QObject(parent), m_impl(std::make_unique<Impl>(this))
+{
+    Q_ASSERT(isSupported());
+
+    const bool connected = m_impl->start();
+    QMutexLocker locker(&m_impl->mutex);
+    m_impl->connected = connected;
+    m_impl->lastChoice = m_impl->state.choice();
+}
+
+QDefaultCameraMonitor::~QDefaultCameraMonitor() = default;
+
+bool QDefaultCameraMonitor::isSupported()
+{
+    return QPipeWireInstance::isLoaded() && pw_check_library_version(0, 3, 44);
+}
+
+bool QDefaultCameraMonitor::isConnected() const
+{
+    QMutexLocker locker(&m_impl->mutex);
+    return m_impl->connected;
+}
+
+QDefaultCameraState::Choice QDefaultCameraMonitor::choice() const
+{
+    QMutexLocker locker(&m_impl->mutex);
+    return m_impl->state.choice();
+}
+
+} // namespace QtPipeWire
+
+QT_END_NAMESPACE
+
+#include "moc_qpipewire_defaultcamera_p.cpp"
