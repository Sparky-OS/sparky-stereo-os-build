From d627672b910a227c9560460e0cb832bf0c108b3a Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 5 Nov 2026 22:01:09 -0300
Subject: [PATCH 39/41] FFmpeg: the CUDA converter takes P012 (NVDEC's 12 bit
 frames)

NVDEC decodes HEVC Main 12 and VP9 profile 2 at 12 bits into AV_PIX_FMT_P012 (a 12 bit sample in the high bits of a 16 bit word), which
cudaFrameGeometry() did not list: the converter refused the frame ("does not support sw_format 209") and the frame was read back to system memory.
P012 has the planes of P010 and P016 (two planes, 16 bit samples), so it is the same geometry. The 4:4:4 formats (fully planar) stay refused and say so.

Assisted-by: Claude Sonnet 5.5 via Claude Code
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/plugins/multimedia/ffmpeg/qffmpeghwaccel_cuda.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/plugins/multimedia/ffmpeg/qffmpeghwaccel_cuda.cpp b/src/plugins/multimedia/ffmpeg/qffmpeghwaccel_cuda.cpp
index f2b5b4480..d70669ee5 100644
--- a/src/plugins/multimedia/ffmpeg/qffmpeghwaccel_cuda.cpp
+++ b/src/plugins/multimedia/ffmpeg/qffmpeghwaccel_cuda.cpp
@@ -231,8 +231,8 @@ struct CudaFrameGeometry
     PerPlaneArray<CudaPlaneGeometry> planes{};
 };
 
-// NVDEC only ever decodes into semi-planar (2-plane, chroma-subsampled) formats - never
-// fully-planar ones - so this table only needs to cover that family.
+// NVDEC decodes 4:2:0 into semi-planar formats (2 planes, chroma-subsampled): 8 bit NV12, 10 bit P010, 12 bit P012 (a 12 bit sample in the high
+// bits of a 16 bit word), 16 bit P016. 4:4:4 comes as fully planar formats, which this table does not cover.
 std::optional<CudaFrameGeometry> cudaFrameGeometry(AVPixelFormat swFormat)
 {
     switch (swFormat) {
@@ -246,6 +246,7 @@ std::optional<CudaFrameGeometry> cudaFrameGeometry(AVPixelFormat swFormat)
             } },
         };
     case AV_PIX_FMT_P010:
+    case AV_PIX_FMT_P012:
     case AV_PIX_FMT_P016:
         return CudaFrameGeometry{
             2,
