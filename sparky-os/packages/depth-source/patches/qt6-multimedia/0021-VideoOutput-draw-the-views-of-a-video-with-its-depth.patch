+
+#include "qquickvideodepth_p.h"
+
+#include <QtMultimedia/private/qvideoframeconverter_p.h>
+#include <QtGui/qimage.h>
+
+#ifdef QT_MM_STEREO_DIBR
+#  include <stereo-dibr.h>
+#endif
