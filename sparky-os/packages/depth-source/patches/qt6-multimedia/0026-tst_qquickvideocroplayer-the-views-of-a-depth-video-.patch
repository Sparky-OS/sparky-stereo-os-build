 void tst_QQuickVideoCropLayer::initTestCase()
 {
     QFile maps(QStringLiteral("/proc/self/maps"));
@@ -447,5 +569,62 @@ void tst_QQuickVideoCropLayer::convertingArrivalsAndInvalidation()
     QTest::qWait(200);
