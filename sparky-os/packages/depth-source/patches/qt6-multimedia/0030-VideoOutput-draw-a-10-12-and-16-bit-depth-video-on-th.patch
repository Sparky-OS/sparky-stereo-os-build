+void tst_QQuickVideoStereo::depthImportsHardwareFrames_data()
+{
+    QTest::addColumn<int>("format");
+    QTest::newRow("NV12") << int(QVideoFrameFormat::Format_NV12);
+    QTest::newRow("P010") << int(QVideoFrameFormat::Format_P010);
+}
