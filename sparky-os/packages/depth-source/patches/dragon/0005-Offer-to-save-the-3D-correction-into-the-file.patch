index 0000000..4a23a99
--- /dev/null
+++ b/autotests/stereosavetest.cpp
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "stereosave.h"
+
+#include <QFile>
+#include <QProcess>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <QTest>
+
+#include <stereo-mark.h>
+
+using namespace Qt::StringLiterals;
+
+// Saving the 3D correction into a file: what is written, what is refused and why, what the program may unmark afterwards.
+// The files are made with ffmpeg and read back with the library's reader; the test fails when a tool is missing.
+class StereoSaveTest : public QObject
+{
+    Q_OBJECT
+private:
+    QTemporaryDir m_dir;
+
+    bool run(const QString &program, const QStringList &arguments)
+    {
+        QProcess process;
+        process.start(program, arguments);
+        return process.waitForFinished(60000) && process.exitStatus() == QProcess::NormalExit && process.exitCode() == 0;
+    }
+
+    QString make(const QString &name, const QString &format, const QStringList &extra = {})
+    {
+        const QString path = m_dir.filePath(name);
+        QStringList args{u"-v"_s, u"error"_s, u"-y"_s, u"-f"_s, u"lavfi"_s, u"-i"_s, u"testsrc=size=160x90:rate=10:duration=1"_s};
+        args += extra;
+        args += {u"-f"_s, format, path};
+        if (!run(u"ffmpeg"_s, args)) {
+            QTest::qFail(qPrintable(u"ffmpeg could not make "_s + name), __FILE__, __LINE__);
+        }
+        return path;
+    }
+
+    static QByteArray bytes(const QString &path)
+    {
+        QFile file(path);
+        return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+    }
+
+    static int markOf(const QString &path)
+    {
+        int container = -1;
+        int value = -2;
+        return stereo_mark_read(path.toUtf8().constData(), 1, &container, &value) == STEREO_MARK_WRITTEN ? value : -3;
+    }
+
+    StereoSave::Request request(const QString &path, const QString &mark, bool chosen, bool swap) const
+    {
+        StereoSave::Request r;
+        r.path = path;
+        r.mark = mark;
+        r.packingChosen = chosen;
+        r.swap = swap;
+        r.frameWidth = 1920;
+        r.frameHeight = 1080;
+        return r;
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QVERIFY(m_dir.isValid());
+        QVERIFY2(!QStandardPaths::findExecutable(u"ffmpeg"_s).isEmpty(), "ffmpeg is needed to make the files");
+        QVERIFY2(!QStandardPaths::findExecutable(u"mkvpropedit"_s).isEmpty(), "mkvpropedit is needed to read what is written");
+    }
+
+    // The packing the person chose is written, and the stored choice may be unmarked
+    void matroskaPacking()
+    {
+        const QString path = make(u"a.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        QCOMPARE(markOf(path), -1);
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"topBottom"_s, true, false));
+        QVERIFY2(out.saved, qPrintable(out.message));
+        QCOMPARE(out.status, u"written"_s);
+        QVERIFY(out.clearInput);
+        QVERIFY(!out.clearSwap);
+        QCOMPARE(markOf(path), 3); // top and bottom, left eye first
+    }
+
+    // Only the swap is the correction: the file's packing stays, its eye order turns round
+    void matroskaSwapOnly()
+    {
+        const QString path = make(u"b.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s, u"-metadata:s:v"_s, u"stereo_mode=left_right"_s});
+        QCOMPARE(markOf(path), 1);
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"sideBySide"_s, false, true));
+        QVERIFY2(out.saved, qPrintable(out.message));
+        QVERIFY(!out.clearInput);
+        QVERIFY(out.clearSwap);
+        QCOMPARE(markOf(path), 11); // side by side, right eye first
+        // and back again: the swap of the swapped file is the first order
+        const StereoSave::Outcome back = StereoSave::save(request(path, u"sideBySide"_s, false, true));
+        QVERIFY2(back.saved, qPrintable(back.message));
+        QCOMPARE(markOf(path), 1);
+    }
+
+    // A swap on a video that says nothing: the packing in use, right eye first
+    void matroskaSwapOfUnmarked()
+    {
+        const QString path = make(u"c.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"sideBySide"_s, false, true));
+        QVERIFY2(out.saved, qPrintable(out.message));
+        QCOMPARE(markOf(path), 11);
+    }
+
+    // The same again: the file carries it already, nothing is written, and the choice is no longer needed
+    void unchanged()
+    {
+        const QString path = make(u"d.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        QVERIFY(StereoSave::save(request(path, u"sideBySide"_s, true, false)).saved);
+        const QByteArray before = bytes(path);
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"sideBySide"_s, true, false));
+        QVERIFY(out.saved);
+        QCOMPARE(out.status, u"unchanged"_s);
+        QVERIFY(out.clearInput);
+        QCOMPARE(bytes(path), before);
+    }
+
+    // A depth layout into Matroska: the packing is written (StereoMode 15 to 20); the swap belongs to the drawn views
+    // and stays with the video
+    void matroskaDepth()
+    {
+        const QString path = make(u"e.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"depthSideBySideDepthFirst"_s, true, true));
+        QVERIFY2(out.saved, qPrintable(out.message));
+        QCOMPARE(markOf(path), 16);
+        QVERIFY(out.clearInput);
+        QVERIFY(!out.clearSwap);
+        QVERIFY2(out.message.contains(u"stays with this video"_s), qPrintable(out.message));
+        const QString graphics = make(u"e2.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        QVERIFY(StereoSave::save(request(graphics, u"depthGraphicsTopBottom"_s, true, false)).saved);
+        QCOMPARE(markOf(graphics), 19);
+        const QString background = make(u"e3.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        QVERIFY(StereoSave::save(request(background, u"depthBackgroundQuarters"_s, true, false)).saved);
+        QCOMPARE(markOf(background), 20);
+    }
+
+    // The swap of a layout that has no eye order cannot be written; with no packing to write, nothing is
+    void swapWithoutAnOrder()
+    {
+        const QString path = make(u"f.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        const QByteArray before = bytes(path);
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"anaglyphCyanRed"_s, false, true));
+        QVERIFY(!out.saved);
+        QCOMPARE(out.status, u"swap"_s);
+        QVERIFY(!out.clearInput);
+        QVERIFY(!out.clearSwap);
+        QVERIFY(out.message.contains(u"The file was not changed"_s));
+        QCOMPARE(bytes(path), before);
+    }
+
+    // MP4 has no depth value: refused, the file is as it was, the choice is kept, the reason said
+    void mp4RefusesDepth()
+    {
+        const QString path = make(u"g.mp4"_s, u"mp4"_s, {u"-c:v"_s, u"mpeg4"_s});
+        const QByteArray before = bytes(path);
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"depthSideBySidePictureFirst"_s, true, false));
+        QVERIFY(!out.saved);
+        QCOMPARE(out.status, u"mp4-depth"_s);
+        QVERIFY(!out.clearInput);
+        QVERIFY(!out.clearSwap);
+        QVERIFY2(out.message.contains(u"MP4"_s) && out.message.contains(u"depth map"_s) && out.message.contains(u"not changed"_s), qPrintable(out.message));
+        QCOMPARE(bytes(path), before);
+        // and what st3d can name is written
+        QVERIFY(StereoSave::save(request(path, u"sideBySide"_s, true, true)).saved);
+        QCOMPARE(markOf(path), 4); // side by side, right eye first
+    }
+
+    void webmSubset()
+    {
+        const QString path = make(u"h.webm"_s, u"webm"_s, {u"-c:v"_s, u"libvpx"_s, u"-b:v"_s, u"200k"_s});
+        const QByteArray before = bytes(path);
+        const StereoSave::Outcome refused = StereoSave::save(request(path, u"rowInterleaved"_s, true, false));
+        QVERIFY(!refused.saved);
+        QCOMPARE(refused.status, u"webm-layout"_s);
+        QVERIFY2(refused.message.contains(u"WebM"_s) && refused.message.contains(u"Matroska"_s), qPrintable(refused.message));
+        QCOMPARE(bytes(path), before);
+        QVERIFY(StereoSave::save(request(path, u"topBottom"_s, true, false)).saved);
+        QCOMPARE(markOf(path), 3);
+    }
+
+    // The mark cannot say half or full size: a choice the shape of the video does not give is refused
+    void viewsOfTheShape()
+    {
+        const QString path = make(u"i.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        const QByteArray before = bytes(path);
+        StereoSave::Request wrong = request(path, u"sideBySide"_s, true, false);
+        wrong.frameWidth = 3840; // two full 1920 pictures: the shape says full views
+        wrong.frameHeight = 1080;
+        wrong.views = 0; // the person chose half
+        const StereoSave::Outcome refused = StereoSave::save(wrong);
+        QVERIFY(!refused.saved);
+        QCOMPARE(refused.status, u"views"_s);
+        QCOMPARE(bytes(path), before);
+        StereoSave::Request right = wrong;
+        right.views = 1;
+        QVERIFY2(StereoSave::save(right).saved, "the choice the shape gives is written");
+        QCOMPARE(markOf(path), 1);
+        // a 1920x1080 frame holds two 960x1080 views: the shape says half
+        const QString half = make(u"i2.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        StereoSave::Request h = request(half, u"sideBySide"_s, true, false);
+        h.views = 0;
+        QVERIFY(StereoSave::save(h).saved);
+    }
+
+    // Not a file on this computer
+    void notLocal()
+    {
+        const StereoSave::Outcome out = StereoSave::save(request(QString(), u"sideBySide"_s, true, false));
+        QVERIFY(!out.saved);
+        QVERIFY(out.message.contains(u"not changed"_s));
+    }
+
+    // mkvpropedit is missing: said, with what to install, the file untouched
+    void toolMissing()
+    {
+        const QString path = make(u"j.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
+        const QByteArray before = bytes(path);
+        const QByteArray oldPath = qgetenv("PATH");
+        qputenv("PATH", QByteArray(m_dir.path().toUtf8()));
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"sideBySide"_s, true, false));
+        qputenv("PATH", oldPath);
+        QVERIFY(!out.saved);
+        QCOMPARE(out.status, u"tool-missing"_s);
+        QVERIFY2(out.message.contains(u"mkvtoolnix"_s), qPrintable(out.message));
+        QCOMPARE(bytes(path), before);
+    }
+
+    // A file that is not a video: refused, untouched
+    void notAVideo()
+    {
+        const QString path = m_dir.filePath(u"k.txt"_s);
+        QFile file(path);
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write("text");
+        file.close();
+        const StereoSave::Outcome out = StereoSave::save(request(path, u"sideBySide"_s, true, false));
+        QVERIFY(!out.saved);
+        QCOMPARE(out.status, u"container"_s);
+        QCOMPARE(bytes(path), QByteArray("text"));
+    }
+};
+
+QTEST_GUILESS_MAIN(StereoSaveTest)
+#include "stereosavetest.moc"
