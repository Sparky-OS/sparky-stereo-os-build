+{
+#ifdef DRAGON_STEREO_SAVE
+    return true;
+#else
+    return false;
+#endif
+}
+
+QVariantMap
+Backend::saveStereoToFile(const QUrl &url, int videoTrack, const QString &mark, int views, int frameWidth, int frameHeight, bool packingChosen, bool swap)
+{
+#ifndef DRAGON_STEREO_SAVE
+    Q_UNUSED(url)
+    Q_UNUSED(videoTrack)
+    Q_UNUSED(mark)
+    Q_UNUSED(views)
+    Q_UNUSED(frameWidth)
+    Q_UNUSED(frameHeight)
+    Q_UNUSED(packingChosen)
+    Q_UNUSED(swap)
+    return {{u"saved"_s, false},
+            {u"clearInput"_s, false},
+            {u"clearSwap"_s, false},
+            {u"status"_s, u"not-built"_s},
+            {u"message"_s, i18nc("@info", "This build of Dragon cannot write the 3D correction into a file. The correction stays with this video in Dragon.")}};
+#else
+    StereoSave::Request request;
+    request.path = url.isLocalFile() ? url.toLocalFile() : QString();
+    request.videoTrack = videoTrack;
+    request.mark = mark;
+    request.views = views;
+    request.frameWidth = frameWidth;
+    request.frameHeight = frameHeight;
+    request.packingChosen = packingChosen;
+    request.swap = swap;
+    const StereoSave::Outcome outcome = StereoSave::save(request);
+    return {{u"saved"_s, outcome.saved},
+            {u"clearInput"_s, outcome.clearInput},
+            {u"clearSwap"_s, outcome.clearSwap},
+            {u"status"_s, outcome.status},
+            {u"message"_s, outcome.message}};
+#endif
+}
