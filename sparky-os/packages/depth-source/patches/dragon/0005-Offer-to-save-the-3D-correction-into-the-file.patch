diff --git a/src/stereosave.cpp b/src/stereosave.cpp
new file mode 100644
index 0000000..64fd81f
--- /dev/null
+++ b/src/stereosave.cpp
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "stereosave.h"
+
+#include <KLocalizedString>
+#include <QByteArray>
+#include <QFileInfo>
+#include <QSet>
+
+#include <stereo-mark.h>
+#include <stereo-policy.h>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+// The words of Stereo3DLayout that take an eye order (stereo-policy.h, stereo_policy_read_mark)
+bool takesOrder(const QString &mark)
+{
+    static const QSet<QString> words{u"sideBySide"_s,
+                                     u"sideBySideQuincunx"_s,
+                                     u"topBottom"_s,
+                                     u"checkerboard"_s,
+                                     u"rowInterleaved"_s,
+                                     u"columnInterleaved"_s,
+                                     u"frameSequential"_s,
+                                     u"blockLaced"_s,
+                                     u"multiView"_s};
+    return words.contains(mark);
+}
+
+// The layouts whose eye order a swap of left and right eyes turns round. In a depth layout the order is where the
+// picture is, and the swap is the drawn views'; one picture in colours has no order.
+bool carriesSwap(int layout)
+{
+    switch (layout) {
+    case STEREO_POLICY_LAYOUT_SIDE_BY_SIDE:
+    case STEREO_POLICY_LAYOUT_TOP_AND_BOTTOM:
+    case STEREO_POLICY_LAYOUT_CHECKERBOARD:
+    case STEREO_POLICY_LAYOUT_ROWS:
+    case STEREO_POLICY_LAYOUT_COLUMNS:
+    case STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL:
+    case STEREO_POLICY_LAYOUT_BLOCK_LACED:
+    case STEREO_POLICY_LAYOUT_SIDE_BY_SIDE_QUINCUNX:
+        return true;
+    default:
+        return false;
+    }
+}
+
+int family(int layout)
+{
+    return layout == STEREO_POLICY_LAYOUT_FRAME_SEQUENTIAL ? STEREO_POLICY_LAYOUT_BLOCK_LACED : layout;
+}
+
+QString untouched()
+{
+    return i18nc("@info", "The file was not changed. The correction stays with this video in Dragon.");
+}
+
+QString refusal(const QString &reason)
+{
+    return reason + u' ' + untouched();
+}
+
+QString reasonFor(int status, const stereo_mark_result &result)
+{
+    switch (status) {
+    case STEREO_MARK_NOT_LOCAL:
+        return i18nc("@info", "Only a file on this computer can be changed, and this video is not one.");
+    case STEREO_MARK_CONTAINER:
+        return i18nc("@info", "This file's format has no 3D mark that Dragon writes. Matroska, WebM, MP4 and MOV files can carry the correction.");
+    case STEREO_MARK_NO_TRACK:
+        return i18nc("@info", "The video track that is playing could not be found in the file.");
+    case STEREO_MARK_BROKEN:
+        return i18nc("@info", "The structure of the file could not be read.");
+    case STEREO_MARK_LAYOUT:
+        return i18nc("@info", "This file format has no mark for the chosen input format or eye order.");
+    case STEREO_MARK_WEBM_LAYOUT:
+        return i18nc(
+            "@info",
+            "WebM files can only say mono, side by side or top and bottom, with either eye first. A Matroska (.mkv) file can carry the other layouts.");
+    case STEREO_MARK_MP4_DEPTH:
+        return i18nc("@info", "MP4 files have no mark for a picture packed with its depth map. A Matroska (.mkv) file can carry it.");
+    case STEREO_MARK_STREAM_DECLARES:
+        return i18nc("@info",
+                     "The video stream itself declares its 3D layout (frame packing), and that comes before any mark in the file, so a mark in the file would "
+                     "not change how the video is shown.");
+    case STEREO_MARK_MP4_NO_ROOM:
+        return i18nc("@info",
+                     "The header of the file has no room for the mark without moving the video data. Copy the streams into a new file to make room, for "
+                     "example with: ffmpeg -i in.mp4 -c copy out.mp4");
+    case STEREO_MARK_MP4_ENTRIES:
+        return i18nc("@info", "The video track has more than one sample description, which the mark cannot cover.");
+    case STEREO_MARK_TOOL_MISSING:
+        return i18nc("@info", "Matroska files are changed with mkvpropedit, from the package mkvtoolnix, and it is not installed.");
+    case STEREO_MARK_WRITE_FAILED:
+        return i18nc("@info %1 what the system said", "The file could not be written: %1", QString::fromUtf8(result.details));
+    case STEREO_MARK_READ_BACK:
+        return i18nc("@info", "The file did not show the layout when it was read back after writing. It was put back as it was.");
+    default:
+        return i18nc("@info %1 a word for the problem", "The file could not be changed (%1).", QString::fromLatin1(stereo_mark_status_name(status)));
+    }
+}
+}
+
+StereoSave::Outcome StereoSave::save(const Request &request)
+{
+    Outcome out;
+    const QString fileName = QFileInfo(request.path).fileName();
+    const QByteArray path = request.path.toUtf8();
+
+    // The word, with a left first order to read it; a mark that does not read is a mistake of the caller
+    const QString word = takesOrder(request.mark) ? request.mark + u"LeftFirst"_s : request.mark;
+    int layout = STEREO_POLICY_LAYOUT_NONE;
+    int order = STEREO_POLICY_LEFT_FIRST;
+    int anaglyph = STEREO_POLICY_ANAGLYPH_NONE;
+    if (request.path.isEmpty() || stereo_policy_read_mark(word.toLatin1().constData(), &layout, &order, &anaglyph) != 1) {
+        out.status = u"not-local"_s;
+        out.message = refusal(reasonFor(STEREO_MARK_NOT_LOCAL, stereo_mark_result{}));
+        return out;
+    }
+
+    // The mark in the file says the packing and the eye order, not whether the views are half or full size; Dragon takes
+    // that from the video's shape. A choice of half or full that the shape does not give cannot be written.
+    if (request.views >= 0 && (layout == STEREO_POLICY_LAYOUT_SIDE_BY_SIDE || layout == STEREO_POLICY_LAYOUT_TOP_AND_BOTTOM)) {
+        const int byShape = stereo_policy_video_views(request.frameWidth, request.frameHeight, 1, 1, 0, 0, STEREO_POLICY_UPSAMPLED_UNKNOWN, layout, nullptr);
+        if (byShape != request.views) {
+            out.status = u"views"_s;
+            out.message = refusal(i18nc("@info",
+                                        "A mark in the file says the packing and the eye order, not whether the views are half or full size. Dragon takes "
+                                        "that from the shape of the video, and for this video the shape gives the other one than the one you chose."));
+            return out;
+        }
+    }
+
+    // The eye order of the packing: the file's own, turned round by the swap
+    const bool swapCarried = carriesSwap(layout);
+    if (takesOrder(request.mark)) {
+        int container = 0;
+        int value = -1;
+        if (stereo_mark_read(path.constData(), request.videoTrack, &container, &value) == STEREO_MARK_WRITTEN && value >= 0) {
+            int fileLayout = 0;
+            int fileOrder = 0;
+            if (stereo_mark_value_layout(container, value, &fileLayout, &fileOrder, nullptr) && family(fileLayout) == family(layout)) {
+                order = fileOrder;
+            }
+        }
+        if (request.swap && swapCarried) {
+            order = order == STEREO_POLICY_LEFT_FIRST ? STEREO_POLICY_RIGHT_FIRST : STEREO_POLICY_LEFT_FIRST;
+        }
+    }
+
+    if (!request.packingChosen && request.swap && !swapCarried) {
+        out.status = u"swap"_s;
+        out.message = refusal(i18nc("@info", "The swap of left and right eyes cannot be written for this layout."));
+        return out;
+    }
+
+    stereo_mark_result result;
+    const int status = stereo_mark_save(path.constData(), request.videoTrack, layout, order, anaglyph, &result);
+    out.status = QString::fromLatin1(stereo_mark_status_name(status));
+    if (status != STEREO_MARK_WRITTEN && status != STEREO_MARK_UNCHANGED) {
+        out.message = refusal(reasonFor(status, result));
+        return out;
+    }
+    out.saved = true;
+    out.clearInput = request.packingChosen;
+    out.clearSwap = request.swap && swapCarried;
+    out.message = status == STEREO_MARK_WRITTEN
+        ? i18nc("@info %1 file name", "The 3D correction is saved in the file %1. Dragon no longer keeps it for this video.", fileName)
+        : i18nc("@info %1 file name", "The file %1 already says this. Dragon no longer needs to keep the correction for this video.", fileName);
+    if (request.swap && !swapCarried) {
+        out.message += u' ' + i18nc("@info", "The swap of left and right eyes cannot be written for this layout; it stays with this video in Dragon.");
+    }
+    return out;
+}
