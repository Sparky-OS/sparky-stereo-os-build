new file mode 100644
index 0000000..71abc3e
--- /dev/null
+++ b/src/stereosave.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#pragma once
+
+#include <QString>
+
+// Saving the 3D correction of a video into the file itself, when the person asked for it. The program never writes a
+// file on its own: the correction (the packing the person chose and the swap of the eyes) is kept in the program's own
+// store, next to the resume position, and is offered for saving. The writing is the shared library's
+// (libstereo-av, stereo_mark_save): Matroska and WebM StereoMode, MP4 and MOV st3d.
+namespace StereoSave
+{
+struct Request {
+    QString path;
+    int videoTrack = 1; // the video track playing, counted from 1
+    // The Stereo3DLayout word of the packing in use, without its eye order ("sideBySide", "topBottom", "anaglyphCyanRed",
+    // "depthSideBySidePictureFirst", ...)
+    QString mark;
+    // Whether the person chose the half size (0) or the full size (1) views, or neither (-1)
+    int views = -1;
+    int frameWidth = 0;
+    int frameHeight = 0;
+    // Whether the person chose the packing; else it is what the video says, and only the swap is the correction
+    bool packingChosen = false;
+    bool swap = false;
+};
+
+struct Outcome {
+    bool saved = false; // the file carries the layout now (or carried it already)
+    bool clearInput = false; // the stored packing is no longer needed
+    bool clearSwap = false; // the stored swap is no longer needed
+    QString status; // the library's word for the status, for logs and tests
+    QString message; // for the person: what happened, why, and what to do
+};
+
+Outcome save(const Request &request);
+}
