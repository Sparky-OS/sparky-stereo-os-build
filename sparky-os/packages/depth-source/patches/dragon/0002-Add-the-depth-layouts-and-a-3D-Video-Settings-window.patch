+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+import QtCore
+import QtMultimedia
+
+// How 3D videos are shown, kept between sessions: the stereo properties of the VideoOutput, with
+// its defaults. A video that comes with its depth map (2D plus depth) has its two views drawn by
+// libstereo-dibr, which the depth properties steer.
+Settings {
+    category: "3DVideo"
+
+    // What is shown of a 3D video: each eye its view (3D), one view, or the frame as stored
+    property int view: VideoOutput.StereoBothEyes
+    // A video that says nothing and is at least 3 times as wide as high is full side by side
+    property bool shapeFallback: true
+    // The filter that restores the size of half size and interleaved views
+    property int scaling: VideoOutput.StereoLanczos
+    // The color depth of the surface the views are shown in, on a 3D screen
+    property int surface: VideoOutput.StereoSurfaceBySource
+
+    // The views of a video with a depth map, drawn from it (else its picture alone)
+    property bool depth: true
+    property int depthView: VideoOutput.StereoDepthPictureLeft
+    property int depthWarp: VideoOutput.StereoDepthForward
+    property int depthFill: VideoOutput.StereoDepthFillBackground
+    property int depthRadius: 5
+    property int depthSmooth: VideoOutput.StereoDepthSmoothOff
+    property real depthSigmaH: 10
+    property real depthSigmaV: 30
+    property real depthRange: 58
+    property real depthZero: 0.5
+    property real depthShift: 0
+    property int depthMeaning: VideoOutput.StereoDepthAutomatic
+    property real depthNear: 0
+    property real depthFar: 0
+    property string depthMark
+}
diff --git a/src/qml/StereoSettingsWindow.qml b/src/qml/StereoSettingsWindow.qml
new file mode 100644
index 0000000..7b3fd08
--- /dev/null
+++ b/src/qml/StereoSettingsWindow.qml
@@ -0,0 +1,384 @@
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+import QtMultimedia as Multimedia
+import org.kde.kirigami as Kirigami
+
+import org.kde.dragon
+
+// 3D video settings, in a window of their own so that the video stays in sight while they
+// change: whether 3D videos are shown in 3D, the screen's 3D mode (KDE's display settings), how
+// the views of a 3D video are restored, and every choice of how the two views of a video with a
+// depth map are drawn (libstereo-dibr). Every change applies at once and is kept.
+Kirigami.ApplicationWindow {
+    id: root
+
+    required property StereoSettings settings
+
+    title: i18nc("@title:window", "3D Video Settings")
+    width: Kirigami.Units.gridUnit * 34
+    height: Kirigami.Units.gridUnit * 40
+    minimumWidth: Kirigami.Units.gridUnit * 24
+    minimumHeight: Kirigami.Units.gridUnit * 20
+
+    // A spin box of decimals: value holds the number times 10^decimals
+    component DecimalSpinBox: QQC2.SpinBox {
+        id: decimalSpinBox
+
+        property int decimals: 1
+        readonly property real factor: Math.pow(10, decimals)
+        readonly property real realValue: value / factor
+
+        editable: true
+        stepSize: factor / 10 >= 1 ? factor / 10 : 1
+        validator: DoubleValidator {
+            bottom: Math.min(decimalSpinBox.from, decimalSpinBox.to) / decimalSpinBox.factor
+            top: Math.max(decimalSpinBox.from, decimalSpinBox.to) / decimalSpinBox.factor
+            decimals: decimalSpinBox.decimals
+            notation: DoubleValidator.StandardNotation
+        }
+        textFromValue: function(value, locale) {
+            return Number(value / factor).toLocaleString(locale, "f", decimals)
+        }
+        valueFromText: function(text, locale) {
+            return Math.round(Number.fromLocaleString(locale, text) * factor)
+        }
+    }
+
+    // A combo box of a VideoOutput enumeration: model elements of text (shown) and value
+    component ChoiceComboBox: QQC2.ComboBox {
+        id: choiceComboBox
+
+        property int choice
+
+        signal chosen(int value)
+
+        textRole: "text"
+        valueRole: "value"
+        implicitContentWidthPolicy: QQC2.ComboBox.WidestText
+        // again when the model is in
+        currentIndex: count > 0 ? indexOfValue(choice) : -1
+        onActivated: choiceComboBox.chosen(choiceComboBox.currentValue)
+    }
+
+    // A tool tip that shows while the control is hovered
+    component HoverToolTip: QQC2.ToolTip {
+        visible: parent.hovered && text.length > 0
+        delay: Kirigami.Units.toolTipDelay
+    }
+
+    pageStack.initialPage: Kirigami.ScrollablePage {
+        title: root.title
+        globalToolBarStyle: Kirigami.ApplicationHeaderStyle.None
+
+        Kirigami.FormLayout {
+            Kirigami.Separator {
+                Kirigami.FormData.isSection: true
+                Kirigami.FormData.label: i18nc("@title:group", "3D video")
+            }
+
+            QQC2.CheckBox {
+                text: i18nc("@option:check", "Enable 3D")
+                checked: root.settings.view !== Multimedia.VideoOutput.StereoFlat
+                onToggled: root.settings.view = checked ? Multimedia.VideoOutput.StereoBothEyes
+                                                        : Multimedia.VideoOutput.StereoFlat
+
+                HoverToolTip {
+                    text: i18nc("@info:tooltip", "Shows 3D videos in 3D, whatever their packing, as full side by side "
+                                + "views for the screen's 3D mode. When off, a 3D video is shown as it is stored.")
+                }
+            }
+
+            QQC2.Button {
+                Kirigami.FormData.label: i18nc("@label", "Screen:")
+                text: i18nc("@action:button", "Display Settings…")
+                icon.name: "preferences-desktop-display"
+                enabled: DisplaySettings.available
+                onClicked: DisplaySettings.open()
+
+                HoverToolTip {
+                    text: i18nc("@info:tooltip", "The screen's 3D mode is chosen in KDE's display settings.")
+                }
+            }
+
+            QQC2.CheckBox {
+                text: i18nc("@option:check", "Take a very wide video for two views side by side")
+                checked: root.settings.shapeFallback
+                onToggled: root.settings.shapeFallback = checked
+
+                HoverToolTip {
+                    text: i18nc("@info:tooltip", "A video that does not say it is 3D, and is at least three times as "
+                                + "wide as high, is taken for two full size views next to each other: no film is "
+                                + "that wide.")
+                }
+            }
+
+            ChoiceComboBox {
+                Kirigami.FormData.label: i18nc("@label:listbox", "Resizing of half size views:")
+                choice: root.settings.scaling
+                model: [
+                    { text: i18nc("@item:inlistbox resizing filter", "Bilinear"), value: Multimedia.VideoOutput.StereoBilinear },
+                    { text: i18nc("@item:inlistbox resizing filter", "Bicubic"), value: Multimedia.VideoOutput.StereoBicubic },
+                    { text: i18nc("@item:inlistbox resizing filter", "Lanczos"), value: Multimedia.VideoOutput.StereoLanczos }
+                ]
+                onChosen: (value) => root.settings.scaling = value
+
+                HoverToolTip {
+                    text: i18nc("@info:tooltip", "The filter that restores the full size of views squeezed to half "
+                                + "the frame, or of interleaved views.")
+                }
+            }
+
+            ChoiceComboBox {
+                Kirigami.FormData.label: i18nc("@label:listbox", "Color depth of the 3D views:")
+                choice: root.settings.surface
+                model: [
+                    { text: i18nc("@item:inlistbox color depth", "As the video"), value: Multimedia.VideoOutput.StereoSurfaceBySource },
+                    { text: i18nc("@item:inlistbox color depth", "8 bits"), value: Multimedia.VideoOutput.StereoSurface8Bit },
+                    { text: i18nc("@item:inlistbox color depth", "10 bits"), value: Multimedia.VideoOutput.StereoSurface10Bit },
+                    { text: i18nc("@item:inlistbox color depth", "Half float"), value: Multimedia.VideoOutput.StereoSurfaceHalfFloat }
+                ]
+                onChosen: (value) => root.settings.surface = value
+
+                HoverToolTip {
+                    text: i18nc("@info:tooltip", "The color depth of the surface the two views are shown in on a 3D "
+                                + "screen: as the video (8 bits for 8 bit video, 10 bits for 10 bit video, half float "
+                                + "above), or always the one chosen.")
+                }
+            }
+
+            Kirigami.Separator {
+                Kirigami.FormData.isSection: true
+                Kirigami.FormData.label: i18nc("@title:group", "Videos with a depth map")
+            }
+
+            QQC2.CheckBox {
+                id: depthCheckBox
+
+                text: i18nc("@option:check", "Draw the two views from the depth map")
+                checked: root.settings.depth
+                onToggled: root.settings.depth = checked
+
+                HoverToolTip {
+                    text: i18nc("@info:tooltip", "A video that comes with its depth map (2D plus depth: packed in the "
+                                + "frame, a depth layer of H.265, or a depth stream of its own) is shown in 3D. When off, "
+                                + "its picture is shown alone. The depth layer of an H.265 video is decoded in software.")
+                }
+            }
+
+            ChoiceComboBox {
+                Kirigami.FormData.label: i18nc("@label:listbox", "The picture is:")
+                enabled: depthCheckBox.checked
+                choice: root.settings.depthView
+                model: [
+                    { text: i18nc("@item:inlistbox the picture is", "The left eye's view"), value: Multimedia.VideoOutput.StereoDepthPictureLeft },
+                    { text: i18nc("@item:inlistbox the picture is", "Between the eyes"), value: Multimedia.VideoOutput.StereoDepthPictureCenter }
+                ]
+                onChosen: (value) => root.settings.depthView = value
+            }
+
+            ChoiceComboBox {
+                Kirigami.FormData.label: i18nc("@label:listbox", "Warping:")
+                enabled: depthCheckBox.checked
+                choice: root.settings.depthWarp
+                model: [
+                    { text: i18nc("@item:inlistbox warping", "Forward"), value: Multimedia.VideoOutput.StereoDepthForward },
+                    { text: i18nc("@item:inlistbox warping", "Backward"), value: Multimedia.VideoOutput.StereoDepthBackward },
+                    { text: i18nc("@item:inlistbox warping", "Layered"), value: Multimedia.VideoOutput.StereoDepthLayered }
+                ]
+                onChosen: (value) => root.settings.depthWarp = value
+
+                HoverToolTip {
+                    text: i18nc("@info:tooltip", "Forward moves each pixel of the picture to its place in the view; "
+                                + "backward moves the depth first, then takes each pixel of the view from the picture; "
+                                + "layered draws the edges of near objects as a layer over the rest.")
+                }
+            }
+
+            ChoiceComboBox {
+                Kirigami.FormData.label: i18nc("@label:listbox", "Uncovered areas:")
+                enabled: depthCheckBox.checked
+                choice: root.settings.depthFill
+                model: [
+                    { text: i18nc("@item:inlistbox fill", "Extend the background"), value: Multimedia.VideoOutput.StereoDepthFillBackground },
+                    { text: i18nc("@item:inlistbox fill", "From background pixels"), value: Multimedia.VideoOutput.StereoDepthFillDepth },
+                    { text: i18nc("@item:inlistbox fill", "Inpaint (Telea)"), value: Multimedia.VideoOutput.StereoDepthFillTelea },
