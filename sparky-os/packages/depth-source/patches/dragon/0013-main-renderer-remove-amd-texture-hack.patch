-
-    auto renderer = QString::fromUtf8(reinterpret_cast<const char *>(context.functions()->glGetString(GL_RENDERER)));
-    context.doneCurrent();
-
-    return renderer;
-}
-
-[[nodiscard]] inline bool isAMD()
