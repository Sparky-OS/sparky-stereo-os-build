-namespace Renderer
-{
-
-[[nodiscard]] inline QString openGLRenderer()
-{
-    QOpenGLContext context;
-    QOffscreenSurface surface;
-    surface.create();
-    if (!context.create()) {
-        qWarning() << "Failed create QOpenGLContext";
-        return {};
-    }
-
-    if (!context.makeCurrent(&surface)) {
