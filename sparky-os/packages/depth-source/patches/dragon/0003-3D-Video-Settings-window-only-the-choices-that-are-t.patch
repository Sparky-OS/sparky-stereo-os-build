 src/backend.h                    |   2 +
 src/qml/ControlsBar.qml          |  67 +++---
 src/qml/PlayerPage.qml           |   4 +-
 src/qml/StereoSettings.qml       |   5 +-
 src/qml/StereoSettingsWindow.qml | 340 +++----------------------------
 6 files changed, 101 insertions(+), 339 deletions(-)

diff --git a/src/backend.cpp b/src/backend.cpp
index 8540c00..52b4114 100644
--- a/src/backend.cpp
+++ b/src/backend.cpp
@@ -61,6 +61,26 @@ void Backend::setStereoSwap(const QUrl &url, bool swap)
 {
     if (url.isEmpty()) return;
     KConfigGroup group(KSharedConfig::openConfig(), QStringLiteral("StereoVideo"));
-    group.writeEntry(stereoKey(url), swap);
+    // a choice back at its default is unmarked: the file has no entry
+    if (swap)
+        group.writeEntry(stereoKey(url), true);
+    else
+        group.deleteEntry(stereoKey(url));
+    group.sync();
+}
+
+int Backend::stereoInput(const QUrl &url, int automatic) const
+{
+    return KConfigGroup(KSharedConfig::openConfig(), QStringLiteral("StereoVideo")).readEntry(stereoKey(url) + u".input"_s, automatic);
+}
+
+void Backend::setStereoInput(const QUrl &url, int input, int automatic)
+{
+    if (url.isEmpty()) return;
+    KConfigGroup group(KSharedConfig::openConfig(), QStringLiteral("StereoVideo"));
+    if (input != automatic)
+        group.writeEntry(stereoKey(url) + u".input"_s, input);
+    else
+        group.deleteEntry(stereoKey(url) + u".input"_s);
     group.sync();
 }
