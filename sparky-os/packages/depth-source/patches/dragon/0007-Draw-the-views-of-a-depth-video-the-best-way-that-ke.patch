From ddbd7c8eb1632809f150afc4341a9a6019a5c1fa Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 5 Nov 2026 13:18:16 -0300
Subject: [PATCH] Draw the views of a depth video the best way that keeps its
 frame rate, and show which

The way of drawing is automatic until the person picks a warping or a gap filling (stereoDepthAutomatic of VideoOutput): the
video is drawn on the GPU with the best way that keeps its frame rate, measured once for each GPU and size, and the controls say
what was chosen and why (stereoDepthChoice). The warping and the gap filling are bound to the video only when they are the
person's. The choice told to the controls does not rewrite the per-file store.

Assisted-by: Claude Sonnet 5.5 via Claude Code
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/qml/PlayerPage.qml | 39 +++++++++++++++++++++++++++++++++++----
 1 file changed, 35 insertions(+), 4 deletions(-)

diff --git a/src/qml/PlayerPage.qml b/src/qml/PlayerPage.qml
index 1080bfc..ec4624e 100644
--- a/src/qml/PlayerPage.qml
+++ b/src/qml/PlayerPage.qml
@@ -166,8 +166,9 @@ Please <link url="%1">contact the %2 developers</link> about this issue, or to f
             stereoSurface: stereoSettings.surface
             stereoDepth: stereoSettings.depth
             stereoDepthView: depthSettings.view
-            stereoDepthWarp: depthSettings.warp
-            stereoDepthFill: depthSettings.fill
+            // the way of drawing is chosen for the video (the best that keeps its frame rate on this GPU) until the person picks
+            // a warping or a gap filling: setting those two is picking, so they are bound only then
+            stereoDepthAutomatic: depthSettings.automatic
             stereoDepthRadius: depthSettings.radius
             stereoDepthSmooth: depthSettings.smooth
             stereoDepthSigmaH: depthSettings.sigmaH
@@ -181,6 +182,28 @@ Please <link url="%1">contact the %2 developers</link> about this issue, or to f
             stereoDepthMark: stereoSettings.depthMark
         }
 
+        Binding {
+            target: video
+            property: "stereoDepthWarp"
+            value: depthSettings.warp
+            when: !depthSettings.automatic
+        }
+
+        Binding {
+            target: video
+            property: "stereoDepthFill"
+            value: depthSettings.fill
+            when: !depthSettings.automatic
+        }
+
+        // What the automatic way chose for this video, and why, for the controls to say
+        Connections {
+            target: video
+            function onStereoDepthChoiceChanged() {
+                depthSettings.setChoice(video.stereoDepthChoice)
+            }
+        }
+
         Dragon.StereoSettings {
             id: stereoSettings
         }
@@ -189,7 +212,14 @@ Please <link url="%1">contact the %2 developers</link> about this issue, or to f
         // for the file like the swap (the controls show them only for a video that carries a depth map)
         Stereo.StereoDepthSettings {
             id: depthSettings
-            onChanged: stereoState.setDepthText(player.source, text)
+            property string keptText
+            onChanged: {
+                // what the choice of the way was told to the controls is not a change of the person's choice
+                if (text !== keptText) {
+                    keptText = text
+                    stereoState.setDepthText(player.source, text)
+                }
+            }
         }
 
         Multimedia.AudioOutput {
@@ -234,7 +264,8 @@ Please <link url="%1">contact the %2 developers</link> about this issue, or to f
                 // The choice of the packing, and the swap of the eyes, are for the file they were made for
                 video.stereoInput = stereoState.stereoInput(source, Multimedia.VideoOutput.StereoAutomatic)
                 video.stereoSwapEyes = stereoState.stereoSwap(source)
-                depthSettings.text = stereoState.depthText(source)
+                depthSettings.keptText = stereoState.depthText(source)
+                depthSettings.text = depthSettings.keptText
             }
         }
 
