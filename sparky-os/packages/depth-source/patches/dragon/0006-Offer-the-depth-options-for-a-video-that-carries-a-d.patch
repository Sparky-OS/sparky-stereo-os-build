+        const StereoSave::Outcome out = StereoSave::save(request(path, u"frameSequential"_s, true, false));
+        QVERIFY(!out.saved);
+        QCOMPARE(out.status, u"not-laced"_s);
+        QVERIFY2(out.message.contains(u"laced"_s) && out.message.contains(u"not changed"_s), qPrintable(out.message));
+        QCOMPARE(bytes(path), before);
     }
 
