diff --git a/src/backend.cpp b/src/backend.cpp
index 807e819..3fb60aa 100644
--- a/src/backend.cpp
+++ b/src/backend.cpp
@@ -91,6 +91,24 @@ void Backend::setStereoInput(const QUrl &url, int input, int automatic)
     group.sync();
 }
 
+QString Backend::depthText(const QUrl &url) const
+{
+    return KConfigGroup(KSharedConfig::openConfig(), QStringLiteral("StereoVideo")).readEntry(stereoKey(url) + u".depth"_s, QString());
+}
+
+void Backend::setDepthText(const QUrl &url, const QString &text)
+{
+    if (url.isEmpty())
+        return;
+    KConfigGroup group(KSharedConfig::openConfig(), QStringLiteral("StereoVideo"));
+    // a choice back at its default is unmarked: the file has no entry
+    if (text.isEmpty())
+        group.deleteEntry(stereoKey(url) + u".depth"_s);
+    else
+        group.writeEntry(stereoKey(url) + u".depth"_s, text);
+    group.sync();
+}
+
 bool Backend::isLocalFile(const QUrl &url) const
 {
     return url.isLocalFile();
