+        QCOMPARE(d.display_width, 0);
+        // 640x180: the shape says full, and half cannot be written (a size as large as the frame says nothing): refused, untouched
+        const QString wide = make(u"i3.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s, u"-vf"_s, u"scale=640:180"_s});
