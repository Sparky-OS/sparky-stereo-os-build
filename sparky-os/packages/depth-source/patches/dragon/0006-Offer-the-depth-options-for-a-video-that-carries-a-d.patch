+    // Both eyes laced in one block (StereoMode 13 and 14) is written only when the blocks are: ffmpeg's frames alternate
+    void frameSequentialNeedsLacedBlocks()
+    {
+        const QString path = make(u"j2.mkv"_s, u"matroska"_s, {u"-c:v"_s, u"mpeg4"_s});
