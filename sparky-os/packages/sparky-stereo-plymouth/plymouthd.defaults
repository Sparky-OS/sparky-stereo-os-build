# Sparky Stereo OS: the distribution's defaults for Plymouth (sparky-stereo-plymouth; Plymouth's own file is
# plymouthd.defaults.debian). A theme chosen with plymouth-set-default-theme goes to /etc/plymouth/plymouthd.conf
# and wins over this one.
[Daemon]
Theme=sparky-stereo-lines
ShowDelay=0
DeviceTimeout=8
