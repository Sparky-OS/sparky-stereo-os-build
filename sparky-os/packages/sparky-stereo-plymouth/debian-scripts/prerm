set -e
if [ "$1" = remove ]; then
	for t in sparky-stereo-lines sparky-stereo-lines-height; do
		update-alternatives --remove default.plymouth /usr/share/plymouth/themes/$t/$t.plymouth || true
	done
fi
exit 0
