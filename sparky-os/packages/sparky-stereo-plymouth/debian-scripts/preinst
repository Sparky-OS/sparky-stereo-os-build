# Plymouth's distribution defaults move aside for the edition's (plymouthd.defaults names sparky-stereo-lines)
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
	dpkg-divert --package sparky-stereo-plymouth --add --rename \
		--divert /usr/share/plymouth/plymouthd.defaults.debian /usr/share/plymouth/plymouthd.defaults >/dev/null
fi
exit 0
