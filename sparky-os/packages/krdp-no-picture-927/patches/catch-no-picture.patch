Description: Report a paired Catch’s first-picture timeout on the desktop
Origin: vendor
Last-Update: 2026-11-26

--- a/discovery/PanelDiscovery.cpp
+++ b/discovery/PanelDiscovery.cpp
@@ -3,6 +3,7 @@
 #include "PairingTrust.h"
 #include <PanelDescriptor.h>
 #include <KLocalizedString>
+#include <KNotification>
 #include <QCryptographicHash>
 #include <QDBusInterface>
 #include <QDBusArgument>
@@ -155,8 +156,20 @@
         const auto message = QJsonDocument::fromJson(peer->input.left(end)).object();
         peer->input.remove(0, end + 1);
         if (peer->announced) {
-            if (message.value(QStringLiteral("action")) != QStringLiteral("pong")) socket->abort();
-            else peer->lastReply.restart();
+            const auto action = message.value(QStringLiteral("action")).toString();
+            if (action == QStringLiteral("no-picture") && !peer->lease.isEmpty()) {
+                const auto notice = i18n("No picture arrived from the desktop. Start the Throw again.");
+                qWarning().noquote() << notice;
+                KNotification::event(KNotification::Error, i18n("Throw failed"), notice,
+                                     QStringLiteral("flat-headset"));
+                socket->disconnectFromHost();
+                return;
+            }
+            if (action != QStringLiteral("pong")) {
+                socket->abort();
+                return;
+            }
+            peer->lastReply.restart();
             continue;
         }
         const auto panel = KRdp::PanelDescriptor::fromJson(message.value(QStringLiteral("panel")).toObject());
