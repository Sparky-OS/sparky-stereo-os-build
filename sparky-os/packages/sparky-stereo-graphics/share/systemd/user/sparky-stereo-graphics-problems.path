# A GPU choice of the person's that cannot be used, or a failed step of the Graphics page's package, was kept:
# sparky-stereo-graphics-problems.service shows it.
[Unit]
Description=Graphics page: a GPU choice that cannot be used, or a failed step, was kept
Documentation=file:/usr/share/doc/sparky-stereo-graphics/README.md
ConditionUser=!@system

[Path]
PathChanged=%S/sparky-stereo-graphics/problems
PathChanged=/var/lib/sparky-stereo-graphics/problems
Unit=sparky-stereo-graphics-problems.service

[Install]
WantedBy=graphical-session.target
