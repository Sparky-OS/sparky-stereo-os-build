#!/bin/sh
# postrm script
set -e
f=${DPKG_ROOT:-}/etc/xdg/sparky-stereo-graphicsrc
if [ "$1" = "purge" ] && [ -f "$f" ] && grep -q '^Origin=' "$f"; then
	# the keys sparky-stereo-gpu-record wrote; anything an administrator added stays
	awk '
		/^\[/ { group = $0; held = $0; shown = 0; next }
		group == "[Measured]" || group == "[Record]" { next }
		group == "[Decoding]" && /^CopyBack(\[\$i\])?=/ { next }
		/^[[:space:]]*$/ { next }
		{ if (!shown && held != "") { print held; shown = 1 } print }
	' "$f" >"$f.dpkg-new"
	if [ -s "$f.dpkg-new" ]; then mv "$f.dpkg-new" "$f"; else rm -f "$f" "$f.dpkg-new"; fi
fi
# a problem of a package that is gone cannot be repaired by it (ORDER 350): the edition's one engine lets go of them
if [ "$1" = "remove" ] && command -v sparky-stereo-problems >/dev/null; then
	SPARKY_STEREO_ROOT=${DPKG_ROOT:-} sparky-stereo-problems clear --all sparky-stereo-graphics || :
fi
if [ "$1" = "purge" ]; then
	# the store of 0.2.3, when one is left
	rm -rf "${DPKG_ROOT:-}/var/lib/sparky-stereo-graphics"
fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	if [ -d "${DPKG_ROOT:-}/run/systemd/system" ]; then
		# systemd says its own error; the files are gone already, so the removal completes, as debhelper's own reload does
		systemctl daemon-reload || :
	fi
fi
exit 0
