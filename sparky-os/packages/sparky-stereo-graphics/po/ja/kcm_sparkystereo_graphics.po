msgid "Started in 3D: %1, %2"
msgstr "3D で起動したとき: %1、%2"

#: src/graphicskcm.cpp:428
msgctxt "@info %1 is a GPU name, %2 the reason"
msgid "Now: %1, %2"
msgstr "現在: %1、%2"

