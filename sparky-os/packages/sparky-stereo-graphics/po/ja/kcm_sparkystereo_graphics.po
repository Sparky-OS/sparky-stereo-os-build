msgid "it crashed (signal %1)"
msgstr "クラッシュしました (シグナル %1)"

#: src/problems.cpp:266
msgctxt "@info how a program stopped, %1 is an exit status"
msgid "it exited with status %1"
msgstr "終了ステータス %1 で終了しました"

#: src/problems.cpp:268
msgctxt "@info how a program stopped, %1 is the word systemd gives the result"
msgid "systemd reports %1"
msgstr "systemd の報告: %1"

#: src/problems.cpp:483
msgctxt "@title notification"
msgid "A program stopped on its GPU"
msgstr "プログラムがGPU上で停止しました"

#: src/problems.cpp:499
msgctxt "@info %1 is a program, %2 a GPU name, %3 says how it stopped"
msgid "%1 stopped right after it started on %2: %3."
msgstr "%1 は %2 で起動した直後に停止しました: %3。"

#: src/problems.cpp:502
msgctxt "@info what to do"
msgid "It was not started again on another GPU. If this GPU is the cause, choose another one for it below, or in System Settings, Graphics."
msgstr "別のGPUで再起動はしていません。このGPUが原因なら、下のボタンかシステム設定の「グラフィックス」で、このプログラムに別のGPUを選んでください。"
