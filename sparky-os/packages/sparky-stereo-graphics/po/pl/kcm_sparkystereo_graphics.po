#: src/ui/main.qml:25
msgctxt "@title:group"
msgid "Graphics processors"
msgstr "Procesory graficzne"

#: src/ui/main.qml:31
msgctxt "@info"
msgid "No graphics processor was found."
msgstr "Nie znaleziono procesora graficznego."

#: src/ui/main.qml:33
msgctxt "@info %1 is a number"
msgid "This computer has %1 graphics processor."
msgid_plural "This computer has %1 graphics processors."
msgstr[0] "Ten komputer ma %1 procesor graficzny."
msgstr[1] "Ten komputer ma %1 procesory graficzne."
msgstr[2] "Ten komputer ma %1 procesorów graficznych."

#: src/ui/main.qml:34
msgctxt "@info"
msgid "This computer has one graphics processor. Every program draws on it."
msgstr "Ten komputer ma jeden procesor graficzny. Wszystkie programy rysują na nim."

#: src/ui/main.qml:62
msgctxt "@label"
msgid "Draws the desktop"
msgstr "Rysuje pulpit"

#: src/ui/main.qml:90
msgctxt "@info"
msgid "Your account may not use this GPU. Add it to the render group to send programs here."
msgstr "Twoje konto nie może używać tego procesora graficznego. Dodaj je do grupy render, aby kierować tu programy."

#: src/ui/main.qml:97
msgctxt "@info"
msgid "This chip only shows a picture. It cannot draw 3D or decode video, so it is never offered below."
msgstr "Ten układ tylko wyświetla obraz. Nie rysuje w 3D ani nie dekoduje wideo, więc nigdy nie jest oferowany poniżej."

#: src/ui/main.qml:107
msgctxt "@action:button"
msgid "Display && Monitor…"
msgstr "Ekran i monitor…"

#: src/ui/main.qml:112
msgctxt "@action:button"
msgid "Power Management…"
msgstr "Zarządzanie energią…"

#: src/ui/main.qml:123
msgctxt "@title:group"
msgid "Main desktop GPU"
msgstr "Główny procesor graficzny pulpitu"

#: src/ui/main.qml:128
msgctxt "@label:listbox"
msgid "Draws the desktop:"
msgstr "Rysuje pulpit:"

#: src/ui/main.qml:146
msgctxt "@info"
msgid "The desktop and every window are put together on this GPU. A change applies at the next login."
msgstr "Pulpit i wszystkie okna są składane na tym procesorze graficznym. Zmiana obowiązuje od następnego logowania."

#: src/ui/main.qml:147
msgctxt "@info"
msgid "There is only one GPU to draw the desktop on."
msgstr "Jest tylko jeden procesor graficzny do rysowania pulpitu."

#: src/ui/main.qml:155
msgctxt "@info %1 is a GPU name"
msgid "This session still draws on %1 until you log in again."
msgstr "Ta sesja nadal rysuje na %1 do czasu ponownego zalogowania."

#: src/ui/main.qml:156
msgctxt "@info %1 is a GPU name"
msgid "This session draws on %1."
msgstr "Ta sesja rysuje na %1."

#: src/ui/main.qml:162
msgctxt "@info"
msgid "A KWIN_DRM_DEVICES line in your own folder ~/.config/plasma-workspace/env is used instead of this choice."
msgstr "Wiersz KWIN_DRM_DEVICES w Twoim folderze ~/.config/plasma-workspace/env jest używany zamiast tego wyboru."

#: src/ui/main.qml:173
msgctxt "@title:group"
msgid "Where programs draw"
msgstr "Gdzie programy rysują"

#: src/ui/main.qml:210
msgctxt "@info"
msgid "Players follow their choice from the next time they start. For a game in Steam, set its launch options to: sparky-stereo-gpu-run --category games %command%. For any single program, use the list below."
msgstr "Odtwarzacze stosują wybór od następnego uruchomienia. Dla gry w Steamie ustaw opcje uruchamiania na: sparky-stereo-gpu-run --category games %command%. Dla pojedynczego programu użyj listy poniżej."

#: src/ui/main.qml:221
msgctxt "@title:group"
msgid "Programs"
msgstr "Programy"

#: src/ui/main.qml:228
msgctxt "@info"
msgid "This is the same setting as Run Using Dedicated Graphics in the application menu. The other GPU is the one that does not draw the desktop. A change applies the next time the program starts."
msgstr "To to samo ustawienie co „Uruchom z dedykowaną grafiką” w menu aplikacji. Drugi procesor graficzny to ten, który nie rysuje pulpitu. Zmiana obowiązuje przy następnym uruchomieniu programu."

#: src/ui/main.qml:262
msgctxt "@info %1 is a GPU name"
msgid "Now: %1. The program asks for this itself."
msgstr "Teraz: %1. Program sam o to prosi."

#: src/ui/main.qml:263
msgctxt "@info %1 is a GPU name"
msgid "Now: %1"
msgstr "Teraz: %1"

#: src/ui/main.qml:284
msgctxt "@info %1 is a number"
msgid "%1 more program is not shown. Type part of its name to find it."
msgid_plural "%1 more programs are not shown. Type part of their name to find them."
msgstr[0] "%1 program nie jest pokazany. Wpisz część jego nazwy, aby go znaleźć."
msgstr[1] "%1 programy nie są pokazane. Wpisz część ich nazwy, aby je znaleźć."
msgstr[2] "%1 programów nie jest pokazanych. Wpisz część ich nazwy, aby je znaleźć."

#: src/ui/main.qml:295
msgctxt "@title:group"
msgid "GPU power"
msgstr "Energia procesora graficznego"

#: src/ui/main.qml:302
msgctxt "@info"
msgid "These save power when the power profile asks for it. They work for the graphics chip in this computer, with one GPU or several."
msgstr "Te opcje oszczędzają energię, gdy prosi o to profil zasilania. Działają dla układu graficznego tego komputera, z jednym procesorem graficznym lub kilkoma."

#: src/graphicskcm.cpp:42
msgctxt "@item GPU name, then its PCI address when two GPUs have the same name"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: src/graphicskcm.cpp:52
msgctxt "@label kind of program"
msgid "Players"
msgstr "Odtwarzacze"

#: src/graphicskcm.cpp:54
msgctxt "@label kind of program"
msgid "Games"
msgstr "Gry"

#: src/graphicskcm.cpp:56
msgctxt "@label kind of program"
msgid "Browsers"
msgstr "Przeglądarki"

#: src/graphicskcm.cpp:60
msgctxt "@label kind of program"
msgid "Other programs"
msgstr "Inne programy"

#: src/graphicskcm.cpp:66
msgctxt "@info"
msgid "the chosen GPU is not installed, so the main GPU"
msgstr "wybrany procesor graficzny nie jest zainstalowany, więc główny"

#: src/graphicskcm.cpp:69
msgctxt "@info"
msgid "the only GPU"
msgstr "jedyny procesor graficzny"

#: src/graphicskcm.cpp:72
msgctxt "@info"
msgid "power saver profile"
msgstr "profil oszczędzania energii"

#: src/graphicskcm.cpp:75
msgctxt "@info"
msgid "performance profile"
msgstr "profil wydajności"

#: src/graphicskcm.cpp:78
msgctxt "@info"
msgid "balanced profile"
msgstr "profil zrównoważony"

#: src/graphicskcm.cpp:81
msgctxt "@info"
msgid "the program's own setting"
msgstr "własne ustawienie programu"

#: src/graphicskcm.cpp:83
msgctxt "@info"
msgid "your choice"
msgstr "Twój wybór"

#: src/graphicskcm.cpp:135
msgctxt "@info"
msgid "The graphics settings could not be saved."
msgstr "Nie udało się zapisać ustawień grafiki."

#: src/graphicskcm.cpp:140
msgctxt "@info %1 is a program's menu entry"
msgid "The setting for %1 could not be saved."
msgstr "Nie udało się zapisać ustawienia dla %1."

#: src/graphicskcm.cpp:145
msgctxt "@info"
msgid "The power setting could not be changed. The power profile service may not allow it."
msgstr "Nie udało się zmienić ustawienia zasilania. Usługa profili zasilania może tego nie dopuszczać."

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Integrated"
msgstr "Zintegrowany"

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Discrete"
msgstr "Dedykowany"

#: src/graphicskcm.cpp:191
msgctxt "@label kind of GPU"
msgid "Display adapter only"
msgstr "Tylko adapter obrazu"

#: src/graphicskcm.cpp:197
msgctxt "@info"
msgid "No driver loaded"
msgstr "Brak załadowanego sterownika"

#: src/graphicskcm.cpp:197
msgctxt "@info %1 is a kernel driver name"
msgid "Driver: %1"
msgstr "Sterownik: %1"

#: src/graphicskcm.cpp:198
msgctxt "@info"
msgid "No screen attached"
msgstr "Brak podłączonego ekranu"

#: src/graphicskcm.cpp:198
msgctxt "@info %1 is a list of screens"
msgid "Screens: %1"
msgstr "Ekrany: %1"

#: src/graphicskcm.cpp:203
msgctxt "@info %1 is a list of kinds of program"
msgid "Used now for: %1"
msgstr "Teraz używany dla: %1"

#: src/graphicskcm.cpp:242
msgctxt "@item:inlistbox %1 is a GPU name"
msgid "Automatic (%1)"
msgstr "Automatycznie (%1)"

#: src/graphicskcm.cpp:249 src/graphicskcm.cpp:300
msgctxt "@item:inlistbox %1 is a PCI address"
msgid "Missing GPU (%1)"
msgstr "Brakujący procesor graficzny (%1)"

#: src/graphicskcm.cpp:273
msgctxt "@item:inlistbox"
msgid "Automatic"
msgstr "Automatycznie"

#: src/graphicskcm.cpp:284
msgctxt "@item:inlistbox"
msgid "Integrated GPU"
msgstr "Zintegrowany procesor graficzny"

#: src/graphicskcm.cpp:287
msgctxt "@item:inlistbox"
msgid "Discrete GPU"
msgstr "Dedykowany procesor graficzny"

#: src/graphicskcm.cpp:318
msgctxt "@info %1 is a GPU name, %2 the reason"
msgid "Now: %1, %2"
msgstr "Teraz: %1, %2"

#: src/graphicskcm.cpp:344
msgctxt "@info"
msgid "Power profile: Power Saver. Automatic uses the integrated GPU."
msgstr "Profil zasilania: Oszczędzanie energii. Automatycznie używa zintegrowanego procesora graficznego."

#: src/graphicskcm.cpp:346
msgctxt "@info"
msgid "Power profile: Performance. Automatic uses the discrete GPU."
msgstr "Profil zasilania: Wydajność. Automatycznie używa dedykowanego procesora graficznego."

#: src/graphicskcm.cpp:350
msgctxt "@info"
msgid "Power profile: Balanced. Automatic uses the GPU that draws the desktop."
msgstr "Profil zasilania: Zrównoważony. Automatycznie używa procesora graficznego, który rysuje pulpit."

#: src/graphicskcm.cpp:412
msgctxt "@item:inlistbox"
msgid "Same as its group"
msgstr "Tak jak jego grupa"

#: src/graphicskcm.cpp:413
msgctxt "@item:inlistbox"
msgid "The other GPU"
msgstr "Drugi procesor graficzny"

#: src/graphicskcm.cpp:414
msgctxt "@item:inlistbox"
msgid "The main GPU"
msgstr "Główny procesor graficzny"
