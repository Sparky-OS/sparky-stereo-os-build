msgid "Other programs"
msgstr "Andere Programme"

#: src/graphicskcm.cpp:65
msgctxt "@info"
msgid "the chosen GPU is not installed, so the main GPU"
msgstr "die gewählte GPU ist nicht eingebaut, daher die Haupt-GPU"

#: src/graphicskcm.cpp:68
msgctxt "@info"
msgid "the only GPU"
msgstr "die einzige GPU"

#: src/graphicskcm.cpp:71
