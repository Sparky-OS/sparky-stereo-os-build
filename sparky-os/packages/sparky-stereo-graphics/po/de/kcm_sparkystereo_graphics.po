#: src/ui/main.qml:25
msgctxt "@title:group"
msgid "Graphics processors"
msgstr "Grafikprozessoren"

#: src/ui/main.qml:31
msgctxt "@info"
msgid "No graphics processor was found."
msgstr "Es wurde kein Grafikprozessor gefunden."

#: src/ui/main.qml:33
msgctxt "@info %1 is a number"
msgid "This computer has %1 graphics processor."
msgid_plural "This computer has %1 graphics processors."
msgstr[0] "Dieser Computer hat %1 Grafikprozessor."
msgstr[1] "Dieser Computer hat %1 Grafikprozessoren."

#: src/ui/main.qml:34
msgctxt "@info"
msgid "This computer has one graphics processor. Every program draws on it."
msgstr "Dieser Computer hat einen Grafikprozessor. Alle Programme zeichnen darauf."

#: src/ui/main.qml:62
msgctxt "@label"
msgid "Draws the desktop"
msgstr "Zeichnet den Desktop"

#: src/ui/main.qml:90
msgctxt "@info"
msgid "Your account may not use this GPU. Add it to the render group to send programs here."
msgstr "Ihr Konto darf diese GPU nicht verwenden. Fügen Sie es der Gruppe render hinzu, um Programme hierher zu schicken."

#: src/ui/main.qml:97
msgctxt "@info"
msgid "This chip only shows a picture. It cannot draw 3D or decode video, so it is never offered below."
msgstr "Dieser Chip zeigt nur ein Bild an. Er kann weder 3D zeichnen noch Video dekodieren und wird deshalb unten nie angeboten."

#: src/ui/main.qml:107
msgctxt "@action:button"
msgid "Display && Monitor…"
msgstr "Anzeige und Monitor…"

#: src/ui/main.qml:112
msgctxt "@action:button"
msgid "Power Management…"
msgstr "Energieverwaltung…"

#: src/ui/main.qml:123
msgctxt "@title:group"
msgid "Main desktop GPU"
msgstr "Haupt-GPU des Desktops"

#: src/ui/main.qml:128
msgctxt "@label:listbox"
msgid "Draws the desktop:"
msgstr "Zeichnet den Desktop:"

#: src/ui/main.qml:146
msgctxt "@info"
msgid "The desktop and every window are put together on this GPU. A change applies at the next login."
msgstr "Der Desktop und alle Fenster werden auf dieser GPU zusammengesetzt. Eine Änderung gilt ab der nächsten Anmeldung."

#: src/ui/main.qml:147
msgctxt "@info"
msgid "There is only one GPU to draw the desktop on."
msgstr "Es gibt nur eine GPU, auf der der Desktop gezeichnet werden kann."

#: src/ui/main.qml:155
msgctxt "@info %1 is a GPU name"
msgid "This session still draws on %1 until you log in again."
msgstr "Diese Sitzung zeichnet noch auf %1, bis Sie sich erneut anmelden."

#: src/ui/main.qml:156
msgctxt "@info %1 is a GPU name"
msgid "This session draws on %1."
msgstr "Diese Sitzung zeichnet auf %1."

#: src/ui/main.qml:162
msgctxt "@info"
msgid "A KWIN_DRM_DEVICES line in your own folder ~/.config/plasma-workspace/env is used instead of this choice."
msgstr "Eine Zeile KWIN_DRM_DEVICES in Ihrem Ordner ~/.config/plasma-workspace/env wird statt dieser Auswahl verwendet."

#: src/ui/main.qml:173
msgctxt "@title:group"
msgid "Where programs draw"
msgstr "Wo Programme zeichnen"

#: src/ui/main.qml:210
msgctxt "@info"
msgid "Players follow their choice from the next time they start. For a game in Steam, set its launch options to: sparky-stereo-gpu-run --category games %command%. For any single program, use the list below."
msgstr "Player folgen ihrer Auswahl ab dem nächsten Start. Tragen Sie bei einem Spiel in Steam als Startoptionen ein: sparky-stereo-gpu-run --category games %command%. Für ein einzelnes Programm nutzen Sie die Liste unten."

#: src/ui/main.qml:221
msgctxt "@title:group"
msgid "Programs"
msgstr "Programme"

#: src/ui/main.qml:228
msgctxt "@info"
msgid "This is the same setting as Run Using Dedicated Graphics in the application menu. The other GPU is the one that does not draw the desktop. A change applies the next time the program starts."
msgstr "Das ist dieselbe Einstellung wie „Mit dedizierter GPU ausführen“ im Anwendungsmenü. Die andere GPU ist die, die den Desktop nicht zeichnet. Eine Änderung gilt beim nächsten Start des Programms."

#: src/ui/main.qml:262
msgctxt "@info %1 is a GPU name"
msgid "Now: %1. The program asks for this itself."
msgstr "Jetzt: %1. Das Programm verlangt dies selbst."

#: src/ui/main.qml:263
msgctxt "@info %1 is a GPU name"
msgid "Now: %1"
msgstr "Jetzt: %1"

#: src/ui/main.qml:284
msgctxt "@info %1 is a number"
msgid "%1 more program is not shown. Type part of its name to find it."
msgid_plural "%1 more programs are not shown. Type part of their name to find them."
msgstr[0] "%1 weiteres Programm wird nicht angezeigt. Geben Sie einen Teil seines Namens ein, um es zu finden."
msgstr[1] "%1 weitere Programme werden nicht angezeigt. Geben Sie einen Teil des Namens ein, um sie zu finden."

#: src/ui/main.qml:295
msgctxt "@title:group"
msgid "GPU power"
msgstr "GPU-Energie"

#: src/ui/main.qml:302
msgctxt "@info"
msgid "These save power when the power profile asks for it. They work for the graphics chip in this computer, with one GPU or several."
msgstr "Diese Optionen sparen Strom, wenn das Energieprofil es verlangt. Sie gelten für den Grafikchip dieses Computers, mit einer oder mehreren GPUs."

#: src/graphicskcm.cpp:42
msgctxt "@item GPU name, then its PCI address when two GPUs have the same name"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: src/graphicskcm.cpp:52
msgctxt "@label kind of program"
msgid "Players"
msgstr "Player"

#: src/graphicskcm.cpp:54
msgctxt "@label kind of program"
msgid "Games"
msgstr "Spiele"

#: src/graphicskcm.cpp:56
msgctxt "@label kind of program"
msgid "Browsers"
msgstr "Browser"

#: src/graphicskcm.cpp:60
msgctxt "@label kind of program"
msgid "Other programs"
msgstr "Andere Programme"

#: src/graphicskcm.cpp:66
msgctxt "@info"
msgid "the chosen GPU is not installed, so the main GPU"
msgstr "die gewählte GPU ist nicht eingebaut, daher die Haupt-GPU"

#: src/graphicskcm.cpp:69
msgctxt "@info"
msgid "the only GPU"
msgstr "die einzige GPU"

#: src/graphicskcm.cpp:72
msgctxt "@info"
msgid "power saver profile"
msgstr "Energiesparprofil"

#: src/graphicskcm.cpp:75
msgctxt "@info"
msgid "performance profile"
msgstr "Leistungsprofil"

#: src/graphicskcm.cpp:78
msgctxt "@info"
msgid "balanced profile"
msgstr "ausgewogenes Profil"

#: src/graphicskcm.cpp:81
msgctxt "@info"
msgid "the program's own setting"
msgstr "die eigene Einstellung des Programms"

#: src/graphicskcm.cpp:83
msgctxt "@info"
msgid "your choice"
msgstr "Ihre Auswahl"

#: src/graphicskcm.cpp:135
msgctxt "@info"
msgid "The graphics settings could not be saved."
msgstr "Die Grafikeinstellungen konnten nicht gespeichert werden."

#: src/graphicskcm.cpp:140
msgctxt "@info %1 is a program's menu entry"
msgid "The setting for %1 could not be saved."
msgstr "Die Einstellung für %1 konnte nicht gespeichert werden."

#: src/graphicskcm.cpp:145
msgctxt "@info"
msgid "The power setting could not be changed. The power profile service may not allow it."
msgstr "Die Energieeinstellung konnte nicht geändert werden. Der Energieprofil-Dienst erlaubt es möglicherweise nicht."

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Integrated"
msgstr "Integriert"

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Discrete"
msgstr "Dediziert"

#: src/graphicskcm.cpp:191
msgctxt "@label kind of GPU"
msgid "Display adapter only"
msgstr "Nur Anzeigeadapter"

#: src/graphicskcm.cpp:197
msgctxt "@info"
msgid "No driver loaded"
msgstr "Kein Treiber geladen"

#: src/graphicskcm.cpp:197
msgctxt "@info %1 is a kernel driver name"
msgid "Driver: %1"
msgstr "Treiber: %1"

#: src/graphicskcm.cpp:198
msgctxt "@info"
msgid "No screen attached"
msgstr "Kein Bildschirm angeschlossen"

#: src/graphicskcm.cpp:198
msgctxt "@info %1 is a list of screens"
msgid "Screens: %1"
msgstr "Bildschirme: %1"

#: src/graphicskcm.cpp:203
msgctxt "@info %1 is a list of kinds of program"
msgid "Used now for: %1"
msgstr "Derzeit verwendet für: %1"

#: src/graphicskcm.cpp:242
msgctxt "@item:inlistbox %1 is a GPU name"
msgid "Automatic (%1)"
msgstr "Automatisch (%1)"

#: src/graphicskcm.cpp:249 src/graphicskcm.cpp:300
msgctxt "@item:inlistbox %1 is a PCI address"
msgid "Missing GPU (%1)"
msgstr "Fehlende GPU (%1)"

#: src/graphicskcm.cpp:273
msgctxt "@item:inlistbox"
msgid "Automatic"
msgstr "Automatisch"

#: src/graphicskcm.cpp:284
msgctxt "@item:inlistbox"
msgid "Integrated GPU"
msgstr "Integrierte GPU"

#: src/graphicskcm.cpp:287
msgctxt "@item:inlistbox"
msgid "Discrete GPU"
msgstr "Dedizierte GPU"

#: src/graphicskcm.cpp:318
msgctxt "@info %1 is a GPU name, %2 the reason"
msgid "Now: %1, %2"
msgstr "Jetzt: %1, %2"

#: src/graphicskcm.cpp:344
msgctxt "@info"
msgid "Power profile: Power Saver. Automatic uses the integrated GPU."
msgstr "Energieprofil: Energiesparen. Automatisch nutzt die integrierte GPU."

#: src/graphicskcm.cpp:346
msgctxt "@info"
msgid "Power profile: Performance. Automatic uses the discrete GPU."
msgstr "Energieprofil: Leistung. Automatisch nutzt die dedizierte GPU."

#: src/graphicskcm.cpp:350
msgctxt "@info"
msgid "Power profile: Balanced. Automatic uses the GPU that draws the desktop."
msgstr "Energieprofil: Ausgewogen. Automatisch nutzt die GPU, die den Desktop zeichnet."

#: src/graphicskcm.cpp:412
msgctxt "@item:inlistbox"
msgid "Same as its group"
msgstr "Wie seine Gruppe"

#: src/graphicskcm.cpp:413
msgctxt "@item:inlistbox"
msgid "The other GPU"
msgstr "Die andere GPU"

#: src/graphicskcm.cpp:414
msgctxt "@item:inlistbox"
msgid "The main GPU"
msgstr "Die Haupt-GPU"
