msgid "your choice"
msgstr "Ihre Auswahl"

#: src/graphicskcm.cpp:144
msgctxt "@info"
msgid "The graphics settings could not be saved."
msgstr "Die Grafikeinstellungen konnten nicht gespeichert werden."

#: src/graphicskcm.cpp:149
msgctxt "@info %1 is a program's menu entry"
msgid "The setting for %1 could not be saved."
msgstr "Die Einstellung für %1 konnte nicht gespeichert werden."

#: src/graphicskcm.cpp:154
msgctxt "@info"
msgid ""
"The power setting could not be changed. The power profile service may not "
"allow it."
msgstr "Die Energieeinstellung konnte nicht geändert werden. Der Energieprofil-Dienst erlaubt es möglicherweise nicht."

#: src/graphicskcm.cpp:198
