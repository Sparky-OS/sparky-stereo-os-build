#: src/ui/main.qml:25
msgctxt "@title:group"
msgid "Graphics processors"
msgstr "Processadores gráficos"

#: src/ui/main.qml:31
msgctxt "@info"
msgid "No graphics processor was found."
msgstr "Nenhum processador gráfico foi encontrado."

#: src/ui/main.qml:33
msgctxt "@info %1 is a number"
msgid "This computer has %1 graphics processor."
msgid_plural "This computer has %1 graphics processors."
msgstr[0] "Este computador tem %1 processador gráfico."
msgstr[1] "Este computador tem %1 processadores gráficos."

#: src/ui/main.qml:34
msgctxt "@info"
msgid "This computer has one graphics processor. Every program draws on it."
msgstr "Este computador tem um processador gráfico. Todos os programas desenham nele."

#: src/ui/main.qml:62
msgctxt "@label"
msgid "Draws the desktop"
msgstr "Desenha a área de trabalho"

#: src/ui/main.qml:90
msgctxt "@info"
msgid "This chip only shows a picture. It cannot draw 3D or decode video, so it is never offered below."
msgstr "Este chip só mostra uma imagem. Ele não desenha em 3D nem decodifica vídeo, por isso nunca é oferecido abaixo."

#: src/ui/main.qml:100
msgctxt "@action:button"
msgid "Display && Monitor…"
msgstr "Tela e monitor…"

#: src/ui/main.qml:105
msgctxt "@action:button"
msgid "Power Management…"
msgstr "Gerenciamento de energia…"

#: src/ui/main.qml:116
msgctxt "@title:group"
msgid "Main desktop GPU"
msgstr "GPU principal da área de trabalho"

#: src/ui/main.qml:121
msgctxt "@label:listbox"
msgid "Draws the desktop:"
msgstr "Desenha a área de trabalho:"

#: src/ui/main.qml:139
msgctxt "@info"
msgid "The desktop and every window are put together on this GPU. A change applies at the next login."
msgstr "A área de trabalho e todas as janelas são montadas nesta GPU. A mudança vale a partir do próximo login."

#: src/ui/main.qml:140
msgctxt "@info"
msgid "There is only one GPU to draw the desktop on."
msgstr "Há apenas uma GPU para desenhar a área de trabalho."

#: src/ui/main.qml:148
msgctxt "@info %1 is a GPU name"
msgid "This session still draws on %1 until you log in again."
msgstr "Esta sessão ainda desenha em %1 até você entrar de novo."

#: src/ui/main.qml:149
msgctxt "@info %1 is a GPU name"
msgid "This session draws on %1."
msgstr "Esta sessão desenha em %1."

#: src/ui/main.qml:155
msgctxt "@info"
msgid "A KWIN_DRM_DEVICES line in your own folder ~/.config/plasma-workspace/env is used instead of this choice."
msgstr "Uma linha KWIN_DRM_DEVICES na sua pasta ~/.config/plasma-workspace/env é usada no lugar desta escolha."

#: src/ui/main.qml:166
msgctxt "@title:group"
msgid "Where programs draw"
msgstr "Onde os programas desenham"

#: src/ui/main.qml:203
msgctxt "@info"
msgid "Players follow their choice from the next time they start. For a game in Steam, set its launch options to: sparky-stereo-gpu-run --category games %command%. For any single program, use the list below."
msgstr "Os reprodutores seguem a escolha a partir da próxima vez que iniciarem. Para um jogo na Steam, defina as opções de inicialização dele como: sparky-stereo-gpu-run --category games %command%. Para um programa específico, use a lista abaixo."

#: src/ui/main.qml:214
msgctxt "@title:group"
msgid "Programs"
msgstr "Programas"

#: src/ui/main.qml:221
msgctxt "@info"
msgid "This is the same setting as Run Using Dedicated Graphics in the application menu. The other GPU is the one that does not draw the desktop. A change applies the next time the program starts."
msgstr "É a mesma configuração de \"Executar com a GPU dedicada\" no menu de aplicativos. A outra GPU é a que não desenha a área de trabalho. A mudança vale na próxima vez que o programa iniciar."

#: src/ui/main.qml:255
msgctxt "@info %1 is a GPU name"
msgid "Now: %1. The program asks for this itself."
msgstr "Agora: %1. O programa pede isso por conta própria."

#: src/ui/main.qml:256
msgctxt "@info %1 is a GPU name"
msgid "Now: %1"
msgstr "Agora: %1"

#: src/ui/main.qml:277
msgctxt "@info %1 is a number"
msgid "%1 more program is not shown. Type part of its name to find it."
msgid_plural "%1 more programs are not shown. Type part of their name to find them."
msgstr[0] "Mais %1 programa não é mostrado. Digite parte do nome para achá-lo."
msgstr[1] "Mais %1 programas não são mostrados. Digite parte do nome para achá-los."

#: src/ui/main.qml:288
msgctxt "@title:group"
msgid "GPU power"
msgstr "Energia da GPU"

#: src/ui/main.qml:295
msgctxt "@info"
msgid "These save power when the power profile asks for it. They work for the graphics chip in this computer, with one GPU or several."
msgstr "Estas opções economizam energia quando o perfil de energia pede. Funcionam para o chip gráfico deste computador, com uma GPU ou várias."

#: src/graphicskcm.cpp:42
msgctxt "@item GPU name, then its PCI address when two GPUs have the same name"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: src/graphicskcm.cpp:52
msgctxt "@label kind of program"
msgid "Players"
msgstr "Reprodutores"

#: src/graphicskcm.cpp:54
msgctxt "@label kind of program"
msgid "Games"
msgstr "Jogos"

#: src/graphicskcm.cpp:56
msgctxt "@label kind of program"
msgid "Browsers"
msgstr "Navegadores"

#: src/graphicskcm.cpp:60
msgctxt "@label kind of program"
msgid "Other programs"
msgstr "Outros programas"

#: src/graphicskcm.cpp:66
msgctxt "@info"
msgid "the chosen GPU is not installed, so the main GPU"
msgstr "a GPU escolhida não está instalada, então a GPU principal"

#: src/graphicskcm.cpp:69
msgctxt "@info"
msgid "the only GPU"
msgstr "a única GPU"

#: src/graphicskcm.cpp:72
msgctxt "@info"
msgid "power saver profile"
msgstr "perfil de economia de energia"

#: src/graphicskcm.cpp:75
msgctxt "@info"
msgid "performance profile"
msgstr "perfil de desempenho"

#: src/graphicskcm.cpp:78
msgctxt "@info"
msgid "balanced profile"
msgstr "perfil equilibrado"

#: src/graphicskcm.cpp:81
msgctxt "@info"
msgid "the program's own setting"
msgstr "a configuração do próprio programa"

#: src/graphicskcm.cpp:83
msgctxt "@info"
msgid "your choice"
msgstr "sua escolha"

#: src/graphicskcm.cpp:135
msgctxt "@info"
msgid "The graphics settings could not be saved."
msgstr "Não foi possível salvar as configurações de gráficos."

#: src/graphicskcm.cpp:140
msgctxt "@info %1 is a program's menu entry"
msgid "The setting for %1 could not be saved."
msgstr "Não foi possível salvar a configuração de %1."

#: src/graphicskcm.cpp:145
msgctxt "@info"
msgid "The power setting could not be changed. The power profile service may not allow it."
msgstr "Não foi possível mudar a configuração de energia. O serviço de perfis de energia pode não permitir."

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Integrated"
msgstr "Integrada"

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Discrete"
msgstr "Dedicada"

#: src/graphicskcm.cpp:191
msgctxt "@label kind of GPU"
msgid "Display adapter only"
msgstr "Apenas adaptador de vídeo"

#: src/graphicskcm.cpp:197
msgctxt "@info"
msgid "No driver loaded"
msgstr "Nenhum driver carregado"

#: src/graphicskcm.cpp:197
msgctxt "@info %1 is a kernel driver name"
msgid "Driver: %1"
msgstr "Driver: %1"

#: src/graphicskcm.cpp:198
msgctxt "@info"
msgid "No screen attached"
msgstr "Nenhuma tela conectada"

#: src/graphicskcm.cpp:198
msgctxt "@info %1 is a list of screens"
msgid "Screens: %1"
msgstr "Telas: %1"

#: src/graphicskcm.cpp:202
msgctxt "@info %1 is a list of kinds of program"
msgid "Used now for: %1"
msgstr "Em uso agora para: %1"

#: src/graphicskcm.cpp:241
msgctxt "@item:inlistbox %1 is a GPU name"
msgid "Automatic (%1)"
msgstr "Automático (%1)"

#: src/graphicskcm.cpp:248 src/graphicskcm.cpp:299
msgctxt "@item:inlistbox %1 is a PCI address"
msgid "Missing GPU (%1)"
msgstr "GPU ausente (%1)"

#: src/graphicskcm.cpp:272
msgctxt "@item:inlistbox"
msgid "Automatic"
msgstr "Automático"

#: src/graphicskcm.cpp:283
msgctxt "@item:inlistbox"
msgid "Integrated GPU"
msgstr "GPU integrada"

#: src/graphicskcm.cpp:286
msgctxt "@item:inlistbox"
msgid "Discrete GPU"
msgstr "GPU dedicada"

#: src/graphicskcm.cpp:317
msgctxt "@info %1 is a GPU name, %2 the reason"
msgid "Now: %1, %2"
msgstr "Agora: %1, %2"

#: src/graphicskcm.cpp:343
msgctxt "@info"
msgid "Power profile: Power Saver. Automatic uses the integrated GPU."
msgstr "Perfil de energia: Economia de energia. O automático usa a GPU integrada."

#: src/graphicskcm.cpp:345
msgctxt "@info"
msgid "Power profile: Performance. Automatic uses the discrete GPU."
msgstr "Perfil de energia: Desempenho. O automático usa a GPU dedicada."

#: src/graphicskcm.cpp:349
msgctxt "@info"
msgid "Power profile: Balanced. Automatic uses the GPU that draws the desktop."
msgstr "Perfil de energia: Equilibrado. O automático usa a GPU que desenha a área de trabalho."

#: src/graphicskcm.cpp:411
msgctxt "@item:inlistbox"
msgid "Same as its group"
msgstr "Igual ao do grupo"

#: src/graphicskcm.cpp:412
msgctxt "@item:inlistbox"
msgid "The other GPU"
msgstr "A outra GPU"

#: src/graphicskcm.cpp:413
msgctxt "@item:inlistbox"
msgid "The main GPU"
msgstr "A GPU principal"
