msgid "players"
msgstr "os reprodutores"

#: src/problems.cpp:224
msgctxt "@item kind of program inside a sentence: The GPU you chose for %1"
msgid "games"
msgstr "os jogos"

#: src/problems.cpp:227
msgctxt "@item kind of program inside a sentence: The GPU you chose for %1"
msgid "browsers"
msgstr "os navegadores"

