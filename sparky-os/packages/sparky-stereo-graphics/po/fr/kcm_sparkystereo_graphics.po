msgid "your choice"
msgstr "votre choix"

#: src/graphicskcm.cpp:144
msgctxt "@info"
msgid "The graphics settings could not be saved."
msgstr "Les réglages graphiques n'ont pas pu être enregistrés."

#: src/graphicskcm.cpp:149
msgctxt "@info %1 is a program's menu entry"
msgid "The setting for %1 could not be saved."
msgstr "Le réglage de %1 n'a pas pu être enregistré."

#: src/graphicskcm.cpp:154
msgctxt "@info"
msgid ""
"The power setting could not be changed. The power profile service may not "
"allow it."
msgstr "Le réglage d'énergie n'a pas pu être modifié. Le service des profils d'énergie peut ne pas l'autoriser."

