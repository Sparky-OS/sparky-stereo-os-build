#: src/ui/main.qml:25
msgctxt "@title:group"
msgid "Graphics processors"
msgstr "Processeurs graphiques"

#: src/ui/main.qml:31
msgctxt "@info"
msgid "No graphics processor was found."
msgstr "Aucun processeur graphique n'a été trouvé."

#: src/ui/main.qml:33
msgctxt "@info %1 is a number"
msgid "This computer has %1 graphics processor."
msgid_plural "This computer has %1 graphics processors."
msgstr[0] "Cet ordinateur a %1 processeur graphique."
msgstr[1] "Cet ordinateur a %1 processeurs graphiques."

#: src/ui/main.qml:34
msgctxt "@info"
msgid "This computer has one graphics processor. Every program draws on it."
msgstr "Cet ordinateur a un seul processeur graphique. Tous les programmes dessinent dessus."

#: src/ui/main.qml:63
msgctxt "@label"
msgid "Draws the desktop"
msgstr "Dessine le bureau"

#: src/ui/main.qml:65
msgctxt "@label"
msgid "Draws the desktop after the next login"
msgstr "Dessinera le bureau après la prochaine connexion"

#: src/ui/main.qml:66
msgctxt "@label"
msgid "Draws this session until the next login"
msgstr "Dessine cette session jusqu'à la prochaine connexion"

#: src/ui/main.qml:94
msgctxt "@info"
msgid "Your account may not use this GPU. Add it to the render group to send programs here."
msgstr "Votre compte ne peut pas utiliser ce GPU. Ajoutez-le au groupe render pour y envoyer des programmes."

#: src/ui/main.qml:101
msgctxt "@info"
msgid "This chip only shows a picture. It cannot draw 3D or decode video, so it is never offered below."
msgstr "Cette puce ne fait qu'afficher une image. Elle ne peut ni dessiner en 3D ni décoder la vidéo, elle n'est donc jamais proposée ci-dessous."

#: src/ui/main.qml:111
msgctxt "@action:button"
msgid "Display && Monitor…"
msgstr "Écran et moniteur…"

#: src/ui/main.qml:116
msgctxt "@action:button"
msgid "Power Management…"
msgstr "Gestion de l'énergie…"

#: src/ui/main.qml:127
msgctxt "@title:group"
msgid "Main desktop GPU"
msgstr "GPU principal du bureau"

#: src/ui/main.qml:132
msgctxt "@label:listbox"
msgid "Draws the desktop:"
msgstr "Dessine le bureau :"

#: src/ui/main.qml:150
msgctxt "@info"
msgid "The desktop and every window are put together on this GPU. A change applies at the next login."
msgstr "Le bureau et toutes les fenêtres sont assemblés sur ce GPU. Un changement s'applique à la prochaine ouverture de session."

#: src/ui/main.qml:151
msgctxt "@info"
msgid "There is only one GPU to draw the desktop on."
msgstr "Il n'y a qu'un seul GPU pour dessiner le bureau."

#: src/ui/main.qml:159
msgctxt "@info %1 is a GPU name"
msgid "This session still draws on %1 until you log in again."
msgstr "Cette session dessine encore sur %1 jusqu'à votre prochaine connexion."

#: src/ui/main.qml:160
msgctxt "@info %1 is a GPU name"
msgid "This session draws on %1."
msgstr "Cette session dessine sur %1."

#: src/ui/main.qml:166
msgctxt "@info"
msgid "A KWIN_DRM_DEVICES line in your own folder ~/.config/plasma-workspace/env is used instead of this choice."
msgstr "Une ligne KWIN_DRM_DEVICES dans votre dossier ~/.config/plasma-workspace/env est utilisée à la place de ce choix."

#: src/ui/main.qml:177
msgctxt "@title:group"
msgid "Where programs draw"
msgstr "Où les programmes dessinent"

#: src/ui/main.qml:214
msgctxt "@info"
msgid "Players follow their choice from the next time they start. For a game in Steam, set its launch options to: sparky-stereo-gpu-run --category games %command%. For any single program, use the list below."
msgstr "Les lecteurs suivent leur choix dès leur prochain démarrage. Pour un jeu dans Steam, indiquez comme options de lancement : sparky-stereo-gpu-run --category games %command%. Pour un programme en particulier, utilisez la liste ci-dessous."

#: src/ui/main.qml:225
msgctxt "@title:group"
msgid "Programs"
msgstr "Programmes"

#: src/ui/main.qml:232
msgctxt "@info"
msgid "This is the same setting as Run Using Dedicated Graphics in the application menu. The other GPU is the one that does not draw the desktop. A change applies the next time the program starts."
msgstr "C'est le même réglage que « Exécuter avec le GPU dédié » dans le menu des applications. L'autre GPU est celui qui ne dessine pas le bureau. Un changement s'applique au prochain démarrage du programme."

#: src/ui/main.qml:266
msgctxt "@info %1 is a GPU name"
msgid "Now: %1. The program asks for this itself."
msgstr "Actuellement : %1. Le programme le demande lui-même."

#: src/ui/main.qml:267
msgctxt "@info %1 is a GPU name"
msgid "Now: %1"
msgstr "Actuellement : %1"

#: src/ui/main.qml:288
msgctxt "@info %1 is a number"
msgid "%1 more program is not shown. Type part of its name to find it."
msgid_plural "%1 more programs are not shown. Type part of their name to find them."
msgstr[0] "%1 autre programme n'est pas affiché. Tapez une partie de son nom pour le trouver."
msgstr[1] "%1 autres programmes ne sont pas affichés. Tapez une partie de leur nom pour les trouver."

#: src/ui/main.qml:299
msgctxt "@title:group"
msgid "GPU power"
msgstr "Énergie du GPU"

#: src/ui/main.qml:306
msgctxt "@info"
msgid "These save power when the power profile asks for it. They work for the graphics chip in this computer, with one GPU or several."
msgstr "Ces options économisent de l'énergie quand le profil d'énergie le demande. Elles concernent la puce graphique de cet ordinateur, avec un ou plusieurs GPU."

#: src/graphicskcm.cpp:42
msgctxt "@item GPU name, then its PCI address when two GPUs have the same name"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: src/graphicskcm.cpp:52
msgctxt "@label kind of program"
msgid "Players"
msgstr "Lecteurs"

#: src/graphicskcm.cpp:54
msgctxt "@label kind of program"
msgid "Games"
msgstr "Jeux"

#: src/graphicskcm.cpp:56
msgctxt "@label kind of program"
msgid "Browsers"
msgstr "Navigateurs"

#: src/graphicskcm.cpp:60
msgctxt "@label kind of program"
msgid "Other programs"
msgstr "Autres programmes"

#: src/graphicskcm.cpp:66
msgctxt "@info"
msgid "the chosen GPU is not installed, so the main GPU"
msgstr "le GPU choisi n'est pas installé, donc le GPU principal"

#: src/graphicskcm.cpp:69
msgctxt "@info"
msgid "the only GPU"
msgstr "le seul GPU"

#: src/graphicskcm.cpp:72
msgctxt "@info"
msgid "power saver profile"
msgstr "profil d'économie d'énergie"

#: src/graphicskcm.cpp:75
msgctxt "@info"
msgid "performance profile"
msgstr "profil de performances"

#: src/graphicskcm.cpp:78
msgctxt "@info"
msgid "balanced profile"
msgstr "profil équilibré"

#: src/graphicskcm.cpp:81
msgctxt "@info"
msgid "the program's own setting"
msgstr "le réglage propre au programme"

#: src/graphicskcm.cpp:83
msgctxt "@info"
msgid "your choice"
msgstr "votre choix"

#: src/graphicskcm.cpp:135
msgctxt "@info"
msgid "The graphics settings could not be saved."
msgstr "Les réglages graphiques n'ont pas pu être enregistrés."

#: src/graphicskcm.cpp:140
msgctxt "@info %1 is a program's menu entry"
msgid "The setting for %1 could not be saved."
msgstr "Le réglage de %1 n'a pas pu être enregistré."

#: src/graphicskcm.cpp:145
msgctxt "@info"
msgid "The power setting could not be changed. The power profile service may not allow it."
msgstr "Le réglage d'énergie n'a pas pu être modifié. Le service des profils d'énergie peut ne pas l'autoriser."

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Integrated"
msgstr "Intégré"

#: src/graphicskcm.cpp:189
msgctxt "@label kind of GPU"
msgid "Discrete"
msgstr "Dédié"

#: src/graphicskcm.cpp:191
msgctxt "@label kind of GPU"
msgid "Display adapter only"
msgstr "Adaptateur d'affichage seulement"

#: src/graphicskcm.cpp:197
msgctxt "@info"
msgid "No driver loaded"
msgstr "Aucun pilote chargé"

#: src/graphicskcm.cpp:197
msgctxt "@info %1 is a kernel driver name"
msgid "Driver: %1"
msgstr "Pilote : %1"

#: src/graphicskcm.cpp:198
msgctxt "@info"
msgid "No screen attached"
msgstr "Aucun écran connecté"

#: src/graphicskcm.cpp:198
msgctxt "@info %1 is a list of screens"
msgid "Screens: %1"
msgstr "Écrans : %1"

#: src/graphicskcm.cpp:203
msgctxt "@info %1 is a list of kinds of program"
msgid "Used now for: %1"
msgstr "Utilisé actuellement pour : %1"

#: src/graphicskcm.cpp:242
msgctxt "@item:inlistbox %1 is a GPU name"
msgid "Automatic (%1)"
msgstr "Automatique (%1)"

#: src/graphicskcm.cpp:249 src/graphicskcm.cpp:300
msgctxt "@item:inlistbox %1 is a PCI address"
msgid "Missing GPU (%1)"
msgstr "GPU absent (%1)"

#: src/graphicskcm.cpp:273
msgctxt "@item:inlistbox"
msgid "Automatic"
msgstr "Automatique"

#: src/graphicskcm.cpp:284
msgctxt "@item:inlistbox"
msgid "Integrated GPU"
msgstr "GPU intégré"

#: src/graphicskcm.cpp:287
msgctxt "@item:inlistbox"
msgid "Discrete GPU"
msgstr "GPU dédié"

#: src/graphicskcm.cpp:318
msgctxt "@info %1 is a GPU name, %2 the reason"
msgid "Now: %1, %2"
msgstr "Actuellement : %1, %2"

#: src/graphicskcm.cpp:344
msgctxt "@info"
msgid "Power profile: Power Saver. Automatic uses the integrated GPU."
msgstr "Profil d'énergie : Économie d'énergie. Automatique utilise le GPU intégré."

#: src/graphicskcm.cpp:346
msgctxt "@info"
msgid "Power profile: Performance. Automatic uses the discrete GPU."
msgstr "Profil d'énergie : Performances. Automatique utilise le GPU dédié."

#: src/graphicskcm.cpp:350
msgctxt "@info"
msgid "Power profile: Balanced. Automatic uses the GPU that draws the desktop."
msgstr "Profil d'énergie : Équilibré. Automatique utilise le GPU qui dessine le bureau."

#: src/graphicskcm.cpp:412
msgctxt "@item:inlistbox"
msgid "Same as its group"
msgstr "Comme son groupe"

#: src/graphicskcm.cpp:413
msgctxt "@item:inlistbox"
msgid "The other GPU"
msgstr "L'autre GPU"

#: src/graphicskcm.cpp:414
msgctxt "@item:inlistbox"
msgid "The main GPU"
msgstr "Le GPU principal"
