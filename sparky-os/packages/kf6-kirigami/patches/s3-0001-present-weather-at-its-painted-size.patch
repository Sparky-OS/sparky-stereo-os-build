+QRect Icon::weatherRect(bool *fullyClipped)
 {
     const QRectF rect = mapRectToScene(calculateNodeRect());
+    const QPointF origin = mapToScene(QPointF());
+    const QPointF xAxis = mapToScene(QPointF(1, 0)) - origin;
+    const QPointF yAxis = mapToScene(QPointF(0, 1)) - origin;
+    bool supported = qFuzzyCompare(xAxis.x(), 1.0) && qFuzzyIsNull(xAxis.y()) && qFuzzyCompare(yAxis.y(), 1.0) && qFuzzyIsNull(yAxis.x());
+    *fullyClipped = false;
     for (const QQuickItem *item = this; item; item = item->parentItem()) {
-        if (item->rotation() != 0 || item->scale() != 1 || item->opacity() != 1
-            || (item->clip() && !item->mapRectToScene(item->boundingRect()).contains(rect))) {
+        if (item->opacity() == 0) {
+            *fullyClipped = true;
             return {};
         }
+        if (item->clip()) {
+            const QRectF clip = item->mapRectToScene(item->boundingRect());
+            if (!clip.intersects(rect)) {
+                *fullyClipped = true;
+                return {};
+            }
+            supported &= clip.contains(rect);
+        }
+        supported &= item->opacity() == 1 && item->rotation() == 0 && item->scale() == 1;
+    }
+    if (!supported) {
+        return {};
     }
     return QRect(QPoint(qRound(rect.x()), qRound(rect.y())), QSize(qRound(rect.width()), qRound(rect.height())));
 }
 
+namespace
+{
+QString weatherProblemKey(const QString &kind, const QString &value)
+{
+    return kind + QLatin1Char('-') + QString::fromLatin1(QCryptographicHash::hash(value.toUtf8(), QCryptographicHash::Sha256).toHex());
+}
+
+void weatherProblem(const QString &command, const QString &key, const QStringList &message = {})
+{
+    QStringList arguments{command, QStringLiteral("--person"), QStringLiteral("--quiet"),
+                          QStringLiteral("sparky-stereo-weather-icons"), key};
+    arguments.append(message);
+    QProcess::startDetached(QStringLiteral("/usr/bin/sparky-stereo-problems"), arguments);
+}
+
+QImage weatherView(QImage view, const QSize &pixels, const QColor &tint)
+{
+    if (view.size() != pixels) {
+        view = view.scaled(pixels, Qt::IgnoreAspectRatio, Qt::SmoothTransformation);
+    }
+    if (tint.isValid()) {
+        QPainter painter(&view);
+        painter.setCompositionMode(QPainter::CompositionMode_SourceIn);
+        painter.fillRect(view.rect(), tint);
+    }
+    return view;
+}
+}
