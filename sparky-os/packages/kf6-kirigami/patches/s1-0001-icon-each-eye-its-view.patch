 using namespace Qt::StringLiterals;
 
+// The eye a window is drawn for while the edition's Qt draws it once per eye (its _q_stereo_eye): 1 the left eye,
+// 2 the right eye, else 0
+static int stereoEye(const QWindow *window)
+{
+    const int eye = window ? window->property("_q_stereo_eye").toInt() : 0;
+    return eye == 1 || eye == 2 ? eye : 0;
+}
+
+// While an icon is asked for one eye, the application names the eye (_q_stereo_icon_eye), which KIconEngine reads
+class StereoEyeAsk
+{
+public:
+    explicit StereoEyeAsk(int eye)
+        : m_eye(eye)
+    {
+        if (m_eye) {
+            qApp->setProperty("_q_stereo_icon_eye", m_eye);
+        }
+    }
+    ~StereoEyeAsk()
+    {
+        if (m_eye) {
+            qApp->setProperty("_q_stereo_icon_eye", QVariant());
+        }
+    }
+    StereoEyeAsk(const StereoEyeAsk &) = delete;
+    StereoEyeAsk &operator=(const StereoEyeAsk &) = delete;
+
+private:
+    const int m_eye;
+};
