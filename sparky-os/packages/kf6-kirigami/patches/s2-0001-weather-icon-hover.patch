+struct Icon::Weather {
+    Stereo::ScreenMode screen;
+    Stereo::IconSurface surface;
+    Stereo::Picture still;
+    std::unique_ptr<Stereo::AnimatedPicture> animation;
+    QTimer tick;
+    QElapsedTimer elapsed;
+    QString stillPath;
+    QString loopPath;
+    QString keptFailure;
+    QRect nativeRect;
+    QMetaObject::Connection screenConnection;
+    QMetaObject::Connection activeConnection;
+    QMetaObject::Connection geometryConnection;
+    bool hovered = false;
+};
+
+bool Icon::weatherTheme() const
+{
+    return bool(m_weather);
+}
+
+void Icon::setWeatherTheme(bool enabled)
+{
+    if (enabled == weatherTheme()) {
+        return;
+    }
+    if (enabled) {
+        m_weather = std::make_unique<Weather>();
+        connect(&m_weather->screen, &Stereo::ScreenMode::modeChanged, this, &QQuickItem::polish);
+        m_weather->tick.setInterval(16);
+        connect(&m_weather->tick, &QTimer::timeout, this, &QQuickItem::polish);
+        weatherWindowChanged();
+    } else {
+        stopWeatherLoop();
+        disconnect(m_weather->screenConnection);
+        disconnect(m_weather->activeConnection);
+        disconnect(m_weather->geometryConnection);
+        m_weather.reset();
+        m_weatherNative = false;
+    }
+    setAcceptHoverEvents(enabled);
+    Q_EMIT weatherThemeChanged();
+    polish();
+}
+
+bool Icon::weatherHovered() const
+{
+    return m_weatherHover;
+}
+
+void Icon::setWeatherHovered(bool hovered)
+{
+    if (m_weatherHoverSupplied && hovered == m_weatherHover) {
+        return;
+    }
+    m_weatherHoverSupplied = true;
+    m_weatherHover = hovered;
+    qCDebug(lcWeatherIcon) << "hover" << m_source << hovered;
+    if (m_weather) {
+        if (hovered) {
+            m_weather->hovered = true;
+        } else {
+            stopWeatherLoop();
+        }
+        polish();
+        update();
+    }
+    Q_EMIT weatherHoveredChanged();
+}
+
+void Icon::weatherWindowChanged()
+{
+    if (!m_weather) {
+        return;
+    }
+    disconnect(m_weather->screenConnection);
+    disconnect(m_weather->activeConnection);
+    disconnect(m_weather->geometryConnection);
+    stopWeatherLoop();
+    m_weather->surface.clear();
+    m_weather->screen.setScreen(m_window ? m_window->screen() : nullptr);
+    if (m_window) {
+        m_weather->screenConnection = connect(m_window.data(), &QWindow::screenChanged, this, [this](QScreen *screen) {
+            m_weather->screen.setScreen(screen);
+            polish();
+        });
+        m_weather->activeConnection = connect(m_window.data(), &QWindow::activeChanged, this, [this]() {
+            qCDebug(lcWeatherIcon) << "window focus" << m_source << m_window->isActive();
+            if (!m_window->isActive()) {
+                stopWeatherLoop();
+                polish();
+            }
+        });
+        m_weather->geometryConnection = connect(m_window.data(), &QQuickWindow::afterAnimating, this, [this]() {
+            if (m_weatherNative && weatherRect() != m_weather->nativeRect) {
+                polish();
+            }
+        });
+    }
+    polish();
+}
+
+void Icon::stopWeatherLoop()
+{
+    if (m_weather) {
+        m_weather->hovered = false;
+        m_weather->tick.stop();
+        m_weather->elapsed.invalidate();
+        m_weather->animation.reset();
+    }
+}
+
+void Icon::hoverEnterEvent(QHoverEvent *event)
+{
+    if (m_weather && !m_weatherHoverSupplied) {
+        m_weather->hovered = true;
+        polish();
+    }
+    QQuickItem::hoverEnterEvent(event);
+}
+
+void Icon::hoverLeaveEvent(QHoverEvent *event)
+{
+    if (m_weather && !m_weatherHoverSupplied) {
+        stopWeatherLoop();
+        polish();
+    }
+    QQuickItem::hoverLeaveEvent(event);
+}
+
+QRect Icon::weatherRect()
+{
+    const QRectF rect = mapRectToScene(calculateNodeRect());
+    for (const QQuickItem *item = this; item; item = item->parentItem()) {
+        if (item->rotation() != 0 || item->scale() != 1 || item->opacity() != 1
+            || (item->clip() && !item->mapRectToScene(item->boundingRect()).contains(rect))) {
+            return {};
+        }
+    }
+    return QRect(QPoint(qRound(rect.x()), qRound(rect.y())), QSize(qRound(rect.width()), qRound(rect.height())));
+}
+
+bool Icon::updateWeatherIcon(const QSize &size)
+{
+    if (!m_weather) {
+        return false;
+    }
+    const QString name = m_source.toString();
+    const int itemExtent = std::min(size.width(), size.height());
+    const int extent = m_roundToIconSize && m_units ? m_units->iconSizes()->roundedIconSize(itemExtent) : itemExtent;
+    const QSize paintedSize(extent, extent);
+    const auto paths = KIconLoader::global()->weatherIconPaths(name, paintedSize, m_devicePixelRatio);
+    auto &weather = *m_weather;
+    if (paths.still != weather.stillPath) {
+        weather.animation.reset();
+        weather.elapsed.invalidate();
+        weather.stillPath = paths.still;
+        weather.still = {};
+        const auto [left, right] = KIconLoader::global()->readWeatherIcon(paths.still);
+        if (!left.isNull() && !right.isNull()) {
+            weather.still = Stereo::Picture::fromViewsInTurn(left, right, Stereo::Picture::EyeOrder::LeftFirst);
+        }
+    }
+    m_weatherNative = false;
+    if (!weather.still.isStereo() || !isVisible() || !m_window || !m_window->isVisible()) {
+        weather.surface.clear();
+        weather.tick.stop();
+        return false;
+    }
+
+    Stereo::Picture shown = weather.still;
+    const auto mode = weather.screen.mode();
+    const bool twoEyes = mode == Stereo::OutputMode::Stereo || mode == Stereo::OutputMode::Anaglyph;
+    if (weather.hovered && paths.animateOnHover && twoEyes) {
+        if (!weather.animation || weather.loopPath != paths.loop) {
+            weather.loopPath = paths.loop;
+            weather.animation = std::make_unique<Stereo::AnimatedPicture>(paths.loop);
+            weather.elapsed.start();
+        }
+        const QSize eyeSize = weather.still.left.size();
+        const qint64 elapsed = weather.elapsed.elapsed();
+        const Stereo::Picture frame = weather.animation->pairAt(elapsed, eyeSize);
+        if (frame.isStereo() && weather.animation->reason().isEmpty()) {
+            if (lcWeatherIcon().isDebugEnabled()) {
+                const auto signature = [](const QImage &image) {
+                    return QCryptographicHash::hash(QByteArrayView(reinterpret_cast<const char *>(image.constBits()), image.sizeInBytes()),
+                                                    QCryptographicHash::Sha256).toHex().left(12);
+                };
+                qCDebug(lcWeatherIcon) << name << elapsed << weather.animation->frameAt(elapsed) << signature(frame.left) << signature(frame.right);
+            }
+            shown = frame;
+            weather.tick.start();
+        } else {
+            weather.tick.stop();
+            const QString key = QStringLiteral("loop-") + QString::fromLatin1(
+                QCryptographicHash::hash(paths.loop.toUtf8(), QCryptographicHash::Sha256).toHex());
+            if (weather.keptFailure != key) {
+                const QString failure = weather.animation->reason();
+                QProcess::startDetached(QStringLiteral("/usr/bin/sparky-stereo-problems"),
+                    {QStringLiteral("keep"), QStringLiteral("--person"), QStringLiteral("--quiet"),
+                     QStringLiteral("sparky-stereo-weather-icons"), key, QStringLiteral("LOCAL2"), name, failure});
+                weather.keptFailure = key;
+            }
+        }
+    } else {
+        weather.tick.stop();
+        weather.animation.reset();
+        weather.elapsed.invalidate();
+    }
+    if (m_animation) {
+        m_animation->stop();
+    }
+    m_animValue = 1;
+    m_icon = shown.left;
+    m_oldIcon = {};
+    m_textureChanged = true;
+    setStatus(Ready);
+    updatePaintedGeometry();
+    const QRect rect = weatherRect();
+    if (twoEyes && !rect.isEmpty()) {
+        m_weatherNative = weather.surface.show(m_window.data(), rect, shown);
+        weather.nativeRect = rect;
+    } else {
+        weather.surface.clear();
+    }
+    update();
+    return true;
+}
 
