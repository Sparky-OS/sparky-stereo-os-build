 {
     struct input_absinfo abs_info[ARRAY_SIZE(absolute_usages)];
+    BYTE evbits[(EV_MAX+7)/8];
     BYTE absbits[(ABS_MAX+7)/8];
     BYTE relbits[(REL_MAX+7)/8];
     BYTE ffbits[(FF_MAX+7)/8];
@@ -606,8 +615,30 @@
     if (hat_count && !hid_device_add_hatswitch(iface, hat_count))
         return STATUS_NO_MEMORY;
 
+    /* The kernel's EV_BTN event numbers a joystick's buttons from 1 with no limit at KEY_MAX (80 buttons) */
+    if (ioctl(impl->base.device_fd, EVIOCGBIT(0, sizeof(evbits)), evbits) == -1)
+    {
+        WARN("ioctl(EVIOCGBIT, 0) failed: %d %s\n", errno, strerror(errno));
+        memset(evbits, 0, sizeof(evbits));
+    }
+    if (test_bit(evbits, EV_BTN))
+    {
+        unsigned int ev_btn_count = 0;
+
+        if (ioctl(impl->base.device_fd, EVIOCGBTNCNT, &ev_btn_count) == -1)
+            ERR("the device has EV_BTN but EVIOCGBTNCNT failed (%d %s): its buttons are counted from EV_KEY\n", errno, strerror(errno));
+        else if (!ev_btn_count)
+            ERR("the device has EV_BTN but EVIOCGBTNCNT gave a count of 0: its buttons are counted from EV_KEY\n");
+        else
+        {
+            impl->ev_btn = TRUE;
+            impl->ev_btn_count = ev_btn_count;
+        }
+    }
+
     /* For now lump all buttons just into incremental usages, Ignore Keys */
-    button_count = count_buttons(impl->base.device_fd, impl->button_map);
+    if (impl->ev_btn) button_count = impl->ev_btn_count;
+    else button_count = count_buttons(impl->base.device_fd, impl->button_map);
     if (button_count && !hid_device_add_buttons(iface, HID_USAGE_PAGE_BUTTON, 1, button_count))
         return STATUS_NO_MEMORY;
 
