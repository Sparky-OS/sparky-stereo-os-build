+struct stereo_update
+{
+    HWND hwnd, owner_hwnd;
+    Window window, owner;
+    unsigned int generation, number;
+    RECT native_rect;
+    struct stereo_x11_child_place place;
+    XRectangle *shape;
+    int shape_count;
+    BOOL visible;
+};
+
+/* No user/GDI or win_data calls are made while stereo_mutex is held. The
+ * window owner can therefore park its native descendants while holding
+ * win_data_mutex, before destroying or replacing their X parent. */
+static BOOL prepare_stereo_update(struct stereo_update *update)
+{
+    struct x11drv_win_data *data;
+    UINT dpi = NtUserGetWinMonitorDpi(update->hwnd, MDT_RAW_DPI);
+    RECT rect, client;
+    HDC hdc;
+    HRGN region;
+    RGNDATA *rd = NULL;
+    DWORD bytes;
+    unsigned int i, eye, count = 0;
+    int width = update->native_rect.right / 2, height = update->native_rect.bottom;
+
+    if (!NtUserGetClientRect(update->hwnd, &client, dpi)) return FALSE;
+    update->owner_hwnd = NtUserGetAncestor(update->hwnd, GA_ROOT);
+    update->owner = X11DRV_get_whole_window(update->owner_hwnd);
+    if (!update->owner) return FALSE;
+    rect = client;
+    NtUserMapWindowPoints(update->hwnd, update->owner_hwnd, (POINT *)&rect, 2, dpi);
+    if ((data = get_win_data(update->owner_hwnd)))
+    {
+        OffsetRect(&rect, data->rects.client.left - data->rects.visible.left,
+                   data->rects.client.top - data->rects.visible.top);
+        release_win_data(data);
+    }
+    update->place = (struct stereo_x11_child_place){rect.left, rect.top,
+        rect.right - rect.left, rect.bottom - rect.top, 0};
+    if (!NtUserIsWindowVisible(update->hwnd) || IsRectEmpty(&client)) return TRUE;
+    if (width < 1 || height < 1 || update->native_rect.right > 32767 || height > 32767) return TRUE;
+
+#ifdef HAVE_LIBXSHAPE
+    hdc = NtUserGetDCEx(update->hwnd, 0, DCX_CACHE | DCX_USESTYLE);
+    region = hdc ? get_dc_monitor_region(update->hwnd, hdc) : 0;
+    if (region)
+    {
+        bytes = NtGdiGetRegionData(region, 0, NULL);
+        if (bytes >= offsetof(RGNDATA, Buffer) && (rd = malloc(bytes))
+            && NtGdiGetRegionData(region, bytes, rd)
+            && rd->rdh.nCount <= (bytes - offsetof(RGNDATA, Buffer)) / sizeof(RECT)
+            && rd->rdh.nCount <= (INT_MAX - 1) / 2
+            && (update->shape = calloc(rd->rdh.nCount * 2 + 1, sizeof(*update->shape))))
+        {
+            const RECT *rectangles = (const RECT *)rd->Buffer;
+            for (i = 0; i < rd->rdh.nCount; ++i)
+            {
+                RECT clip;
+                int x1, x2, y1, y2;
+                if (!intersect_rect(&clip, &rectangles[i], &client)) continue;
+                x1 = ((ULONGLONG)(clip.left - client.left) * width + update->place.width / 2) / update->place.width;
+                x2 = ((ULONGLONG)(clip.right - client.left) * width + update->place.width / 2) / update->place.width;
+                y1 = ((ULONGLONG)(clip.top - client.top) * height + update->place.height / 2) / update->place.height;
+                y2 = ((ULONGLONG)(clip.bottom - client.top) * height + update->place.height / 2) / update->place.height;
+                if (x2 <= x1 || y2 <= y1) continue;
+                for (eye = 0; eye < 2; ++eye)
+                    update->shape[count++] = (XRectangle){x1 + eye * width, y1, x2 - x1, y2 - y1};
+            }
+            update->shape_count = count;
+            update->visible = TRUE;
+        }
+        free(rd);
+        NtGdiDeleteObjectApp(region);
+    }
+    if (hdc) NtUserReleaseDC(update->hwnd, hdc);
+#endif
+    return TRUE;
+}
+
+static void apply_stereo_update(struct x11drv_vulkan_surface *surface, const struct stereo_update *update)
+{
+    if (!update->owner)
+    {
+        XUnmapWindow(gdi_display, surface->window);
+        surface->visible = FALSE;
+        surface->present_ready = FALSE;
+        return;
+    }
+    if (surface->stereo_owner != update->owner)
+    {
+        ++surface->generation;
+        surface->present_ready = FALSE;
+        XReparentWindow(gdi_display, surface->window, update->owner, update->place.x, update->place.y);
+        if (p_stereo_move_x11_child(gdi_display, surface->stereo_owner, update->owner, surface->window))
+        {
+            XUnmapWindow(gdi_display, surface->window);
+            surface->visible = FALSE;
+            return;
+        }
+        surface->stereo_owner = update->owner;
+    }
+    else if (surface->stereo_place.x != update->place.x || surface->stereo_place.y != update->place.y)
+        XMoveWindow(gdi_display, surface->window, update->place.x, update->place.y);
+    surface->owner_hwnd = update->owner_hwnd;
+    if (memcmp(&surface->stereo_place, &update->place, sizeof(update->place)))
+    {
+        p_stereo_declare_x11_child_place(gdi_display, surface->window, &update->place);
+        surface->stereo_place = update->place;
+    }
+#ifdef HAVE_LIBXSHAPE
+    XShapeCombineRectangles(gdi_display, surface->window, ShapeInput, 0, 0, NULL, 0, ShapeSet, Unsorted);
+    XShapeCombineRectangles(gdi_display, surface->window, ShapeBounding, 0, 0,
+                           update->shape, update->shape_count, ShapeSet, Unsorted);
+#endif
+    if (surface->visible != update->visible) ++surface->generation;
+    if (!surface->visible || !update->visible) surface->present_ready = FALSE;
+    surface->visible = update->visible;
+    if (surface->visible) XMapWindow(gdi_display, surface->window);
+    else XUnmapWindow(gdi_display, surface->window);
+    XFlush(gdi_display);
+}
+
+static void refresh_stereo_surface(struct x11drv_vulkan_surface *surface, BOOL resize)
+{
+    struct stereo_update update = {0};
+    RECT rect;
+    pthread_mutex_lock(&stereo_mutex);
+    update.hwnd = surface->hwnd;
+    update.window = surface->window;
+    update.generation = surface->generation;
+    update.number = ++surface->next_update;
+    update.native_rect = surface->rect;
+    pthread_mutex_unlock(&stereo_mutex);
+    if (!update.hwnd || !update.window) return;
+    if (resize)
+    {
+        get_client_window_rect(update.hwnd, &rect);
+        if (rect.right > 0 && rect.bottom > 0) update.native_rect = rect;
+    }
+    prepare_stereo_update(&update);
+    pthread_mutex_lock(&stereo_mutex);
+    if (surface->hwnd == update.hwnd && surface->window == update.window
+        && surface->generation == update.generation && surface->applied_update < update.number)
+    {
+        if (resize && !EqualRect(&surface->rect, &update.native_rect))
+        {
+            XResizeWindow(gdi_display, surface->window, min(max(1, update.native_rect.right), 65535),
+                          min(max(1, update.native_rect.bottom), 65535));
+            surface->rect = update.native_rect;
+            p_stereo_declare_x11_one_view_size(gdi_display, surface->window,
+                                              surface->rect.right, surface->rect.bottom);
+        }
+        surface->applied_update = update.number;
+        apply_stereo_update(surface, &update);
+    }
+    pthread_mutex_unlock(&stereo_mutex);
+    free(update.shape);
+}
+
+void sync_vulkan_stereo_surfaces(void)
+{
+    struct x11drv_vulkan_surface *surface, **surfaces;
+    unsigned int count = 0, i = 0;
+    pthread_mutex_lock(&stereo_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &stereo_surfaces, struct x11drv_vulkan_surface, entry) ++count;
+    surfaces = count ? calloc(count, sizeof(*surfaces)) : NULL;
+    if (surfaces)
+        LIST_FOR_EACH_ENTRY(surface, &stereo_surfaces, struct x11drv_vulkan_surface, entry)
+        {
+            InterlockedIncrement(&surface->refs);
+            surfaces[i++] = surface;
+        }
+    pthread_mutex_unlock(&stereo_mutex);
+    for (unsigned int n = 0; n < i; ++n)
+    {
+        refresh_stereo_surface(surfaces[n], FALSE);
+        if (!InterlockedDecrement(&surfaces[n]->refs)) free(surfaces[n]);
+    }
+    free(surfaces);
+}
+
+void park_vulkan_stereo_owner(Window owner, BOOL destroyed)
+{
+    struct x11drv_vulkan_surface *surface;
+    BOOL moved = FALSE;
+    if (!owner) return;
+    pthread_mutex_lock(&stereo_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &stereo_surfaces, struct x11drv_vulkan_surface, entry)
+    {
+        if (surface->stereo_owner != owner) continue;
+        if (!destroyed)
+        {
+            moved = TRUE;
+            XUnmapWindow(gdi_display, surface->window);
+            p_stereo_move_x11_child(gdi_display, owner, None, surface->window);
+            XReparentWindow(gdi_display, surface->window, get_dummy_parent(), 0, 0);
+        }
+        else surface->window = None;
+        surface->stereo_owner = None;
+        surface->present_ready = FALSE;
+        ++surface->generation;
+    }
+    /* The parent can be destroyed on a different X connection next. */
+    if (moved) XSync(gdi_display, False);
+    pthread_mutex_unlock(&stereo_mutex);
+}
+
+void restore_vulkan_stereo_owner(HWND hwnd, Window owner, Display *owner_display)
+{
+    struct x11drv_vulkan_surface *surface;
+    BOOL moved = FALSE;
+    if (!owner) return;
+    pthread_mutex_lock(&stereo_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &stereo_surfaces, struct x11drv_vulkan_surface, entry)
+    {
+        if (!surface->window || !surface->hwnd || surface->owner_hwnd != hwnd || surface->stereo_owner) continue;
+        XSync(owner_display, False);
+        moved = TRUE;
+        XReparentWindow(gdi_display, surface->window, owner, surface->stereo_place.x, surface->stereo_place.y);
+        if (p_stereo_move_x11_child(gdi_display, None, owner, surface->window)) continue;
+        surface->stereo_owner = owner;
+        ++surface->generation;
+        if (surface->visible) XMapWindow(gdi_display, surface->window);
+    }
+    if (moved) XFlush(gdi_display);
+    pthread_mutex_unlock(&stereo_mutex);
+}
+
+/* A mapped child can still be unviewable while its managed ancestor's
+ * MapRequest is pending. Presenting then loses the first image when the WM
+ * maps the owner. Wait only across that transition, without holding Wine's
+ * window/surface locks or taking events from another thread's connection. */
+static int stereo_window_error(Display *display, XErrorEvent *event, void *arg)
+{
+    return event->error_code == BadWindow;
+}
+
+static VkResult X11DRV_vulkan_surface_prepare_present(HWND hwnd, void *private)
+{
+    struct x11drv_vulkan_surface *surface = private;
+    DWORD start = NtGetTickCount();
+    if (!surface->stereo) return VK_SUCCESS;
+    refresh_stereo_surface(surface, FALSE);
+    for (;;)
+    {
+        Window window;
+        unsigned int generation;
+        XWindowAttributes attrs;
+        BOOL queried;
+        int error;
+        pthread_mutex_lock(&stereo_mutex);
+        window = surface->window;
+        generation = surface->generation;
+        if (!window || !surface->hwnd)
+        {
+            pthread_mutex_unlock(&stereo_mutex);
+            return VK_ERROR_SURFACE_LOST_KHR;
+        }
+        if (!surface->visible || surface->present_ready)
+        {
+            pthread_mutex_unlock(&stereo_mutex);
+            return VK_SUCCESS;
+        }
+        pthread_mutex_unlock(&stereo_mutex);
+
+        X11DRV_expect_error(gdi_display, stereo_window_error, NULL);
+        queried = XGetWindowAttributes(gdi_display, window, &attrs);
+        error = X11DRV_check_error();
+        pthread_mutex_lock(&stereo_mutex);
+        if (surface->window == window && surface->generation == generation)
+        {
+            if (queried && !error && attrs.map_state == IsViewable) surface->present_ready = TRUE;
+            if (surface->present_ready)
+            {
+                pthread_mutex_unlock(&stereo_mutex);
+                return VK_SUCCESS;
+            }
+        }
+        pthread_mutex_unlock(&stereo_mutex);
+        if (error || !queried) return VK_ERROR_SURFACE_LOST_KHR;
+        if ((DWORD)(NtGetTickCount() - start) >= 1000)
+        {
+            WARN("Timed out waiting for stereo surface %#lx to become viewable\n", window);
+            return VK_ERROR_OUT_OF_DATE_KHR;
+        }
+        poll(NULL, 0, 1);
+    }
 }
 
