-GLuint KisOpenGLCanvasRenderer::paintCanvasToEyeTexture(int eye)
+GLuint KisOpenGLCanvasRenderer::paintCanvasToEyeTexture(int eye, const std::function<void()> &paintOver)
 {
     // eye -1 (the image as it is, for a layer with one buffer) uses the left eye's picture
     QScopedPointer<QOpenGLFramebufferObject> &fbo = d->eyeFBO[eye == 1 ? 1 : 0];
     if (!fbo || fbo->size() != d->viewportDevicePixelSize) {
         QOpenGLFramebufferObjectFormat format;
         format.setInternalTextureFormat(d->canvasBridge->internalTextureFormat());
+        // what is painted over the picture is painted by QPainter, whose paint engine fills paths
+        // and clips through the stencil buffer, as on the widget's framebuffer
+        format.setAttachment(QOpenGLFramebufferObject::CombinedDepthStencil);
         fbo.reset(new QOpenGLFramebufferObject(d->viewportDevicePixelSize, format));
     }
 
@@ -429,6 +432,13 @@ GLuint KisOpenGLCanvasRenderer::paintCanvasToEyeTexture(int eye)
     d->stereoEye = eye;
     fbo->bind();
     renderCanvasGL(QRect());
+    if (paintOver) {
+        glDisable(GL_SCISSOR_TEST);
+        glClearStencil(0);
+        glClear(GL_STENCIL_BUFFER_BIT);
+        paintOver();
+        fbo->bind();
+    }
     fbo->release();
     d->stereoEye = previousEye;
     QOpenGLFramebufferObject::bindDefault();
