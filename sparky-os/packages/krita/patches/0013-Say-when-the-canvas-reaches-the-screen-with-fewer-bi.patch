+namespace {
+// EGL_EXT_pixel_format_float: whether the surface's colour is half float (about 11 significant bits)
+bool surfaceIsHalfFloat(QOpenGLContext *surfaceContext)
+{
+#if QT_CONFIG(egl)
+    auto *egl = surfaceContext ? surfaceContext->nativeInterface<QNativeInterface::QEGLContext>() : nullptr;
+    if (!egl) {
+        return false;
+    }
+    using GetConfigAttrib = unsigned int (*)(void *, void *, int, int *);
+    auto getConfigAttrib = reinterpret_cast<GetConfigAttrib>(surfaceContext->getProcAddress("eglGetConfigAttrib"));
+    int type = 0;
+    const int colorComponentType = 0x3339; // EGL_COLOR_COMPONENT_TYPE_EXT
+    const int colorComponentTypeFloat = 0x333B; // EGL_COLOR_COMPONENT_TYPE_FLOAT_EXT
+    return getConfigAttrib && getConfigAttrib(egl->display(), egl->config(), colorComponentType, &type) &&
+        type == colorComponentTypeFloat;
+#else
+    Q_UNUSED(surfaceContext);
+    return false;
+#endif
+}
+}
+
+void KisOpenGLCanvas2::checkCanvasDepth(QWindow *surface, QOpenGLContext *surfaceContext)
+{
+    const KoColorSpace *cs = canvas()->image() ? canvas()->image()->colorSpace() : nullptr;
+    if (!surface || !cs || (surface == d->depthCheckedSurface && cs == d->depthCheckedColorSpace)) {
+        return;
+    }
+    d->depthCheckedSurface = surface;
+    d->depthCheckedColorSpace = cs;
+
+    // the document's depth; a display can be given up to 16 bits per channel (deep colour stops there), so a
+    // document is shown at its depth when the surface has its bits or 16
+    const KoID depth = cs->colorDepthId();
+    const bool documentFloat = depth == Float16BitsColorDepthID || depth == Float32BitsColorDepthID;
+    const int documentBits = depth == Integer8BitsColorDepthID ? 8 : depth == Float32BitsColorDepthID ? 32 : 16;
+    const int shownBits = qMin(documentBits, 16);
+
+    const QSurfaceFormat format = surface->format();
+    const int surfaceBits = qMin(format.redBufferSize(), qMin(format.greenBufferSize(), format.blueBufferSize()));
+    const bool halfFloat = surfaceBits == 16 && surfaceIsHalfFloat(surfaceContext);
+    // a shallower surface the person chose in the settings is theirs, and said as theirs
+    const bool chosen = KisOpenGL::userPreferredCanvasSurfaceBitDepth() <= surfaceBits;
+
+    QString note;
+    if (surfaceBits > 0 && surfaceBits < shownBits && chosen) {
+        note = i18n("The canvas reaches the screen with %1 bits per channel, fewer than this document's %2: "
+                    "the canvas surface bit depth is set to %1 bits in Settings > Configure Krita > Color Management.",
+                    surfaceBits, documentBits);
+    } else if (surfaceBits > 0 && surfaceBits < shownBits) {
+        note = i18n("The canvas reaches the screen with %1 bits per channel, fewer than this document's %2: "
+                    "the graphics stack offers no deeper canvas surface here.", surfaceBits, documentBits);
+    } else if (halfFloat && !documentFloat && documentBits == 16) {
+        note = i18n("The canvas reaches the screen in half float, about 11 bits per channel, fewer than this "
+                    "document's 16: the graphics stack offers no 16-bit integer canvas surface here.");
+    }
+
+    infoOpenGL << "canvas surface:" << surfaceBits << "bits per channel" << (halfFloat ? "half float" : "")
+               << "for a document of" << documentBits << "bits" << (documentFloat ? "float" : "");
+    canvas()->setCanvasDepthNote(note);
+}
