+KisOpenGLImageTextures *KisOpenGLCanvasRenderer::eyeTextures(int eye)
+{
+    eye = eye == 1 ? 1 : 0;
+    KisCanvas2 *kisCanvas = canvas();
+    const KisCanvas2::StereoSource source = kisCanvas->stereoSource();
+    if (source == KisCanvas2::StereoSource::None) {
+        return nullptr;
+    }
+
+    // an eye layer is fed as it is; an eye's view of a packed picture is copied into both halves of a
+    // device of the eye's own, so its picture is what a 2D document of that view shows, and the
+    // texture filter never reaches the other eye's view at the seam or at the edges
+    const KisNodeSP layer = kisCanvas->stereoEyeLayer(eye);
+    const QRect view = source == KisCanvas2::StereoSource::EyeLayers ? QRect() : kisCanvas->stereoViewRect(eye);
+    if (source == KisCanvas2::StereoSource::EyeLayers && !layer) {
+        return nullptr;
+    }
+
+    if (!d->eyeTextures[eye] || KisNodeSP(d->eyeTextureLayers[eye]) != layer || d->eyeTextureViews[eye] != view) {
+        // made as the image's own textures are, in the canvas's context
+        KisOpenGLImageTexturesSP textures =
+            KisOpenGLImageTextures::createImageTextures(kisCanvas->image(),
+                                                        d->displayConfig.profile,
+                                                        d->displayConfig.intent,
+                                                        d->displayConfig.conversionFlags);
+        textures->setInternalColorManagementActive(d->internalColorManagement, true);
+        textures->setProofingConfig(kisCanvas->proofingConfiguration());
+        textures->initGL(context()->functions());
+        KisConfig cfg(true);
+        textures->updateConfig(cfg.useOpenGLTextureBuffer(), cfg.numMipmapLevels());
+        if (!d->channelFlags.isEmpty()) {
+            textures->setChannelFlags(d->channelFlags);
+        }
+
+        d->eyeTextures[eye] = textures;
+        d->eyeTextureLayers[eye] = layer;
+        d->eyeTextureViews[eye] = view;
+        d->eyeDevices[eye] = layer ? KisPaintDeviceSP() : KisPaintDeviceSP(new KisPaintDevice(kisCanvas->image()->projection()->colorSpace()));
+        refreshEye(eye, kisCanvas->image()->bounds());
+    }
+
+    return d->eyeTextures[eye].data();
+}
+
+void KisOpenGLCanvasRenderer::refreshEye(int eye, const QRect &rect)
+{
+    KisImageSP image = canvas()->image();
+    const QRect bounds = image->bounds();
+    KisOpenGLImageTexturesSP textures = d->eyeTextures[eye];
+    KisNodeSP layer = d->eyeTextureLayers[eye];
+
+    if (layer) {
+        KisOpenGLUpdateInfoSP info = textures->updateInfoBuilder().buildUpdateInfo(rect, layer->projection(), bounds, 0, true);
+        textures->recalculateCache(info, false);
+        return;
+    }
+
+    const QRect view = d->eyeTextureViews[eye];
+    const QRect changed = rect & view;
+    if (changed.isEmpty() || !d->eyeDevices[eye]) {
+        return;
+    }
+    for (int half = 0; half < 2; half++) {
+        const QPoint place = changed.topLeft() - view.topLeft() + canvas()->stereoViewRect(half).topLeft();
+        KisPainter::copyAreaOptimized(place, image->projection(), d->eyeDevices[eye], changed);
+        KisOpenGLUpdateInfoSP info =
+            textures->updateInfoBuilder().buildUpdateInfo(QRect(place, changed.size()), d->eyeDevices[eye], bounds, 0, true);
+        textures->recalculateCache(info, false);
+    }
+}
+
+void KisOpenGLCanvasRenderer::refreshEyeTextures(const QRect &rect)
+{
+    KisCanvas2 *kisCanvas = canvas();
+    for (int eye = 0; eye < 2; eye++) {
+        if (!d->eyeTextures[eye]) {
+            continue;
+        }
+        const KisNodeSP layer = kisCanvas->stereoEyeLayer(eye);
+        const bool packed = kisCanvas->stereoSource() == KisCanvas2::StereoSource::SideBySide ||
+                            kisCanvas->stereoSource() == KisCanvas2::StereoSource::TopAndBottom;
+        const bool same = layer ? KisNodeSP(d->eyeTextureLayers[eye]) == layer
+                                : packed && !d->eyeTextureLayers[eye] && d->eyeTextureViews[eye] == kisCanvas->stereoViewRect(eye);
+        if (same) {
+            refreshEye(eye, rect);
+        }
+    }
+}
+
+void KisOpenGLCanvasRenderer::dropEyeTextures()
+{
+    // made again, whole, when an eye is painted next
+    for (int eye = 0; eye < 2; eye++) {
+        d->eyeTextures[eye].clear();
+        d->eyeTextureLayers[eye] = nullptr;
+        d->eyeTextureViews[eye] = QRect();
+        d->eyeDevices[eye].clear();
+    }
+}
