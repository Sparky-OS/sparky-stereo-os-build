+QString KisOpenGLCanvas2::stereoLayerFailureText(KisStereoCanvasLayer *layer)
+{
+    switch (layer->failure()) {
+    case KisStereoCanvasLayer::Failure::None:
+    case KisStereoCanvasLayer::Failure::NoWindow:
+        // nothing to say yet: the window is being made
+        return QString();
+    case KisStereoCanvasLayer::Failure::OpenGLES:
+        return i18n("The 3D canvas needs desktop OpenGL, and this canvas runs on OpenGL ES.");
+    case KisStereoCanvasLayer::Failure::Context:
+        return i18n("The 3D canvas could not make its OpenGL context.");
+    case KisStereoCanvasLayer::Failure::OneView: {
+        const GLubyte *renderer = context()->functions()->glGetString(GL_RENDERER);
+        return i18n("The graphics stack gave the 3D canvas one view (%1).",
+                    renderer ? QString::fromLatin1(reinterpret_cast<const char *>(renderer)) : QStringLiteral("?"));
+    }
+    }
+    return QString();
