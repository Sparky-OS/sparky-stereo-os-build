From 8694c96b982cc04febf212c2dac582f0401bd718 Mon Sep 17 00:00:00 2001
From: Dmitry Kazakov <dimula73@gmail.com>
Date: Wed, 15 Apr 2026 14:24:38 +0200
Subject: [PATCH 02/15] Update SIP ABI to 13.8
Origin: upstream, https://invent.kde.org/graphics/krita/-/commit/30182dbfe789c9b44e5762978bf9ebb22c4f72b6
Applied-Upstream: master (before Krita 6.1), https://invent.kde.org/graphics/krita/-/commit/30182dbfe789c9b44e5762978bf9ebb22c4f72b6

This API is used in the updated version of PyQt6 6.11.0

(cherry picked from commit 30182dbfe789c9b44e5762978bf9ebb22c4f72b6)
---
 cmake/modules/SIPMacros.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmake/modules/SIPMacros.cmake b/cmake/modules/SIPMacros.cmake
index 113a3b32..052cf80c 100644
--- a/cmake/modules/SIPMacros.cmake
+++ b/cmake/modules/SIPMacros.cmake
@@ -152,7 +152,7 @@ else()
         endif()
 
         if (QT_MAJOR_VERSION STREQUAL "6")
-            set(abi_version "13.0")
+            set(abi_version "13.8")
             set(sip_disabled_features "[\"Krita_Qt5\"]")
         else()
             set(abi_version "12.8")
