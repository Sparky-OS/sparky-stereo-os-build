@@ -0,0 +1,55 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+#include "FirmwareNotifier.h"
+#include <DiscoverBackendsFactory.h>
+#include <resources/AbstractBackendUpdater.h>
+#include <utility>
+
+FirmwareNotifier::FirmwareNotifier(QObject *parent)
+    : BackendNotifierModule(parent)
+{
+    // Use Discover's existing firmware consumer and error handling, rather than
+    // routing firmware discovery through PackageKit's Debian package backend.
+    const auto backends = DiscoverBackendsFactory().backend(QStringLiteral("fwupd-backend"));
+    for (auto backend : backends) {
+        m_backends.append(backend);
+        // The firmware client connects asynchronously. Its first contentsChanged
+        // announces a connected client; checking earlier leaves an unfinished fetch.
+        connect(backend, &AbstractResourcesBackend::contentsChanged, this, [this, backend] {
+            m_initialized.insert(backend);
+        });
+        connect(backend->backendUpdater(), &AbstractBackendUpdater::needsRebootChanged, this, &BackendNotifierModule::needsRebootChanged);
+        connect(backend, &AbstractResourcesBackend::updatesCountChanged, this, &BackendNotifierModule::foundUpdates);
+    }
+}
+
+bool FirmwareNotifier::hasUpdates()
+{
+    for (const auto &backend : std::as_const(m_backends)) {
+        if (backend && backend->updatesCount() > 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool FirmwareNotifier::needsReboot() const
+{
+    for (const auto &backend : std::as_const(m_backends)) {
+        if (backend && backend->backendUpdater()->needsReboot()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void FirmwareNotifier::recheckSystemUpdateNeeded()
+{
+    for (const auto &backend : std::as_const(m_backends)) {
+        if (backend && m_initialized.contains(backend) && backend->isValid()) {
+            backend->checkForUpdates();
+        }
+    }
+}
