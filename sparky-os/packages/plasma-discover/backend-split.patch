+
+void SourcesModel::setPackageKitEnabled(bool enabled)
+{
+    if (enabled == packageKitEnabled()) {
+        return;
+    }
+    auto config = KSharedConfig::openConfig(QStringLiteral("discoverrc"));
+    config->group(QStringLiteral("Backends")).writeEntry("PackageKitEnabled", enabled, KConfigBase::Notify);
+    config->sync();
+    Q_EMIT packageKitEnabledChanged();
+}
 
