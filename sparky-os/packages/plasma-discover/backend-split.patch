+#pragma once
+
+#include <BackendNotifierModule.h>
+#include <QPointer>
+#include <QVector>
+#include <QSet>
+#include <resources/AbstractResourcesBackend.h>
+
+class FirmwareNotifier : public BackendNotifierModule
+{
+    Q_OBJECT
+    Q_PLUGIN_METADATA(IID DISCOVER_NOTIFIER_IID)
+    Q_INTERFACES(BackendNotifierModule)
+public:
+    explicit FirmwareNotifier(QObject *parent = nullptr);
+    bool hasUpdates() override;
+    bool hasSecurityUpdates() override { return false; }
+    bool needsReboot() const override;
+    void recheckSystemUpdateNeeded() override;
+
+private:
+    QVector<QPointer<AbstractResourcesBackend>> m_backends;
+    QSet<AbstractResourcesBackend *> m_initialized;
+};
