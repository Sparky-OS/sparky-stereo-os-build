-    pool->loadAsync();
+    // loading compiles the catalog's cache when it is newer than the cache, and the XML would stay in our heap
+    auto watcher = new QFutureWatcher<bool>(this);
+    connect(watcher, &QFutureWatcher<bool>::finished, this, [watcher, pool] {
+        watcher->deleteLater();
+        pool->loadAsync();
+    });
+    watcher->setFuture(QtConcurrent::run(&m_threadPool, [appstreamDirPath, locale = pool->locale()] {
+        return AppStreamUtils::compileCache({u"--datapath"_s, appstreamDirPath}, locale);
+    }));
