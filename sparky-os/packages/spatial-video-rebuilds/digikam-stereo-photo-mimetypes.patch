Description: List stereo picture types in digiKam and Showfoto desktop entries
 The edition keeps Gwenview as the default. List MPO, JPS and PNS directly so
 both applications are offered without relying on JPEG or PNG inheritance.
 digiKam accepts local files through its native preview path.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Forwarded: not-needed

--- a/core/showfoto/main/org.kde.showfoto.desktop
+++ b/core/showfoto/main/org.kde.showfoto.desktop
@@ -165,7 +165,7 @@
 Exec=showfoto -qwindowtitle %c %U
 Icon=showfoto
 Type=Application
-MimeType=image/gif;image/x-xpixmap;image/x-xbitmap;image/jpeg;image/png;image/tiff;image/x-bmp;image/x-psd;image/x-portable-bitmap;image/x-portable-pixmap;image/x-portable-graymap;image/x-dcraw;image/heif;image/heic;
+MimeType=image/gif;image/x-xpixmap;image/x-xbitmap;image/jpeg;image/png;image/tiff;image/x-bmp;image/x-psd;image/x-portable-bitmap;image/x-portable-pixmap;image/x-portable-graymap;image/x-dcraw;image/heif;image/heic;image/x-jps;image/x-mpo;image/x-pns;
 Terminal=false
 Categories=Qt;Graphics;Photography;
 X-DocPath=showfoto/index.html
--- a/core/app/main/org.kde.digikam.desktop
+++ b/core/app/main/org.kde.digikam.desktop
@@ -1,7 +1,8 @@
 [Desktop Entry]
 Type=Application
+MimeType=image/x-jps;image/x-mpo;image/x-pns;
 Categories=Qt;Graphics;Photography;
-Exec=digikam -qwindowtitle %c
+Exec=digikam -qwindowtitle %c %F
 Icon=digikam
 X-DocPath=digikam/index.html
 Name=digiKam
