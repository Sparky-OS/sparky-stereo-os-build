+
+#include "filepreview.h"
+
+// Qt includes
+
+#include <QAction>
+#include <QApplication>
+#include <QDir>
+#include <QFileInfo>
+#include <QIcon>
+#include <QKeySequence>
+#include <QMainWindow>
+#include <QMenu>
+#include <QMenuBar>
+#include <QToolBar>
+#include <QUrl>
+
+// KDE includes
+
+#include <klocalizedstring.h>
+
+// Local includes
+
+#include "dimgpreviewitem.h"
+#include "graphicsdimgview.h"
+
+namespace Digikam
+{
+
+int previewFiles(QApplication& app, const QStringList& files)
+{
+    QMainWindow window;
+    GraphicsDImgView::prepareStereoWindow(&window);
+    window.resize(1000, 700);
+    QMenu* const viewMenu = window.menuBar()->addMenu(i18n("&View"));
+    viewMenu->setObjectName(QLatin1String("View"));
+
+    GraphicsDImgView* const view = new GraphicsDImgView(&window);
+    DImgPreviewItem* const item  = new DImgPreviewItem();
+    item->setDisplayingWidget(view);
+    view->setItem(item);
+    window.setCentralWidget(view);
+
+    QToolBar* const toolbar = window.addToolBar(QString());
+    toolbar->setObjectName(QLatin1String("filePreviewToolBar"));
+    QAction* const previous = new QAction(QIcon::fromTheme(QLatin1String("go-previous")),
+                                                 i18nc("@action", "Previous Image"), toolbar);
+    QAction* const next     = new QAction(QIcon::fromTheme(QLatin1String("go-next")),
+                                                 i18nc("@action", "Next Image"), toolbar);
+    toolbar->addAction(previous);
+    toolbar->addAction(next);
+    previous->setShortcut(QKeySequence(Qt::Key_Left));
+    next->setShortcut(QKeySequence(Qt::Key_Right));
+
+    int current = 0;
+    const auto load = [&]()
+    {
+        const QUrl url = QUrl::fromUserInput(files.at(current), QDir::currentPath(), QUrl::AssumeLocalFile);
+        window.setWindowTitle(QFileInfo(url.toLocalFile()).fileName() + QLatin1String(" - digiKam"));
+        previous->setEnabled(current > 0);
+        next->setEnabled(current + 1 < files.size());
+        item->setPath(url.toLocalFile());
+    };
+
+    QObject::connect(previous, &QAction::triggered, &window, [&]()
+    {
+        if (current > 0)
+        {
+            --current;
+            load();
+        }
+    });
+    QObject::connect(next, &QAction::triggered, &window, [&]()
+    {
+        if (current + 1 < files.size())
+        {
+            ++current;
+            load();
+        }
+    });
+    QObject::connect(item, &DImgPreviewItem::loaded, view, &GraphicsDImgView::fitToWindow);
+    QObject::connect(view, &GraphicsDImgView::resized, view, &GraphicsDImgView::fitToWindow);
+
+    window.show();
+    load();
+    return app.exec();
+}
+
+} // namespace Digikam
