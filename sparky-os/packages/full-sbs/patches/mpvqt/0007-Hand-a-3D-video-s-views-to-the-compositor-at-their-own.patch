diff --git a/src/mpvabstractitem.cpp b/src/mpvabstractitem.cpp
index 781e28f..189c0d9 100644
--- a/src/mpvabstractitem.cpp
+++ b/src/mpvabstractitem.cpp
@@ -74,6 +74,20 @@ void MpvAbstractItemPrivate::applyVideoState()
     }
     if (stereo != m_stereoVideo) {
         m_stereoVideo = stereo;
+        // mpv draws a 3D video at the resolution of its views, onto the whole layer, whose rectangle has the video's
+        // shape: mpv keeps no aspect of its own meanwhile, and gets its own back afterwards
+        if (mpv_handle *mpv = m_mpvController->mpv()) {
+            if (stereo) {
+                if (char *keepAspect = mpv_get_property_string(mpv, "keepaspect")) {
+                    m_keepAspect = keepAspect;
+                    mpv_free(keepAspect);
+                }
+                mpv_set_property_string(mpv, "keepaspect", "no");
+            } else if (!m_keepAspect.isEmpty()) {
+                mpv_set_property_string(mpv, "keepaspect", m_keepAspect.constData());
+                m_keepAspect.clear();
+            }
+        }
         Q_EMIT q_ptr->stereoVideoChanged();
     }
     updateVideoRect();
@@ -87,13 +101,18 @@ void MpvVideoState::update(mpv_handle *mpv)
     }
     bool isStereo = false;
     QSizeF videoSize;
+    QSize frameSize;
     QString format;
     QString hwFormat;
     if (node.format == MPV_FORMAT_NODE_MAP) {
         for (int i = 0; i < node.u.list->num; ++i) {
             const QLatin1String key(node.u.list->keys[i]);
             const mpv_node &value = node.u.list->values[i];
-            if (value.format == MPV_FORMAT_INT64 && key == QLatin1String("dw")) {
+            if (value.format == MPV_FORMAT_INT64 && key == QLatin1String("w")) {
+                frameSize.setWidth(value.u.int64);
+            } else if (value.format == MPV_FORMAT_INT64 && key == QLatin1String("h")) {
+                frameSize.setHeight(value.u.int64);
+            } else if (value.format == MPV_FORMAT_INT64 && key == QLatin1String("dw")) {
                 videoSize.setWidth(value.u.int64);
             } else if (value.format == MPV_FORMAT_INT64 && key == QLatin1String("dh")) {
                 videoSize.setHeight(value.u.int64);
@@ -115,6 +134,7 @@ void MpvVideoState::update(mpv_handle *mpv)
     }
     stereo = isStereo && !stereoRefused;
     size = videoSize;
+    frame = frameSize;
     depth = pixelFormatDepth(hwFormat.isEmpty() ? format : hwFormat);
 }
 
