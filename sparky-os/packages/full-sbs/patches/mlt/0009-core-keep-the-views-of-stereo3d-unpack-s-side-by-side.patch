Description: core: keep the views of stereo3d_unpack's side by side at their resolution
 .
 With output=side_by_side the filter stretched a half view back to the
 size of a view (a half top-and-bottom 1920x1080 frame gave 3840x1080),
 and the program showing it resized it again for its window: two
 resizes of each view before the compositor.
 .
 Both views now keep the resolution the frame carries them at, copied
 as they are (that frame gives 3840x540, an interleaved one its rows or
 columns), and the frame's sample aspect ratio says the shape of a view,
 so a stereo surface hands them over for the compositor's one resize.
 A single view (output=left or right) is still restored for programs
 that show it as an ordinary picture.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: https://github.com/Sparky-OS/mlt/commit/8c9ec993cb2a9784e7411cfdb8847ca0e9121e0f
Forwarded: no
Last-Update: 2026-10-22
Assisted-by: Claude Opus 5.5
---
 src/modules/core/filter_stereo3d_unpack.c   | 18 ++++++++++++++----
 src/modules/core/filter_stereo3d_unpack.yml |  6 +++++-
 2 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/src/modules/core/filter_stereo3d_unpack.c b/src/modules/core/filter_stereo3d_unpack.c
index 3d81b9d..8a52f13 100644
--- a/src/modules/core/filter_stereo3d_unpack.c
+++ b/src/modules/core/filter_stereo3d_unpack.c
@@ -270,16 +270,26 @@ static int filter_get_image(mlt_frame frame,
             stored_width = sw / 2;
         if (packing == packing_top_and_bottom || packing == packing_lines)
             stored_height = sh / 2;
+        // Both views side by side go to a stereo surface at the resolution the frame carries them, never scaled: the
+        // compositor resizes them once, so a half view stays half and the frame's sample aspect ratio says its shape.
+        // A single view is shown as an ordinary picture, restored to the size of a view.
+        const int keep = sbs;
+        if (keep) {
+            eye_width = stored_width;
+            eye_height = stored_height;
+            mlt_frame_set_aspect_ratio(frame,
+                                       mlt_frame_get_aspect_ratio(frame) * vw / stored_width * stored_height / vh);
+        }
         uint8_t *stored = mlt_pool_alloc((size_t) stored_width * stored_height * 4);
         for (int slot = 0; slot < 2; slot++) {
             stored_view(*image, sw, sh, packing, slot, stored, stored_width, stored_height);
             // The first view is the left eye's unless the stream says the right eye's comes first
             uint8_t **eye = &eyes[slot ^ (invert ? 1 : 0)];
-            *eye = mlt_pool_alloc((size_t) vw * vh * 4);
-            if (stored_width == vw && stored_height == vh)
-                memcpy(*eye, stored, (size_t) vw * vh * 4);
+            *eye = mlt_pool_alloc((size_t) eye_width * eye_height * 4);
+            if (stored_width == eye_width && stored_height == eye_height)
+                memcpy(*eye, stored, (size_t) eye_width * eye_height * 4);
             else
-                scale_view(stored, stored_width, stored_height, *eye, vw, vh);
+                scale_view(stored, stored_width, stored_height, *eye, eye_width, eye_height);
         }
         mlt_pool_release(stored);
     }
diff --git a/src/modules/core/filter_stereo3d_unpack.yml b/src/modules/core/filter_stereo3d_unpack.yml
index df7c5c1..caef8c5 100644
--- a/src/modules/core/filter_stereo3d_unpack.yml
+++ b/src/modules/core/filter_stereo3d_unpack.yml
@@ -33,7 +33,11 @@ parameters:
   - identifier: output
     title: Output
     type: string
-    description: left, right, or side_by_side (both views, the left eye first)
+    description: >
+      left, right, or side_by_side (both views, the left eye first, each at the
+      resolution the frame carries it, never scaled: a half top-and-bottom
+      1920x1080 frame gives 3840x540, its sample aspect ratio the shape of a view;
+      left and right give one view restored to the size of a view)
     default: side_by_side
     mutable: yes
   - identifier: resource
