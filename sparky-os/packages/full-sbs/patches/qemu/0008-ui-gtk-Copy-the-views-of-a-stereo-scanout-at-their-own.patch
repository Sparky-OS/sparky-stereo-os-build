@@ -235,15 +222,19 @@ void qemu_wayland_stereo_show(QemuWaylandStereo *ws, pixman_image_t *frame,
 {
     QemuWaylandStereoBuffer *buf;
 
+    /* every 3D structure gives both views one size */
+    if (stereo->left.width != stereo->right.width ||
