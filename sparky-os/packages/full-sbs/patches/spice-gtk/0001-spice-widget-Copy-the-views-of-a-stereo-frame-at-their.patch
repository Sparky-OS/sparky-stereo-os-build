-                    y * stride + x * PIXMAN_FORMAT_BPP(format) / 8;
-    pixman_image_t *src;
-    pixman_transform_t transform;
-
-    /* a view of its own, so filtering never reaches into the other one */
-    src = pixman_image_create_bits(format, w, h, (uint32_t *)data, stride);
-    pixman_transform_init_scale(&transform,
-                                pixman_double_to_fixed((double)w / width),
