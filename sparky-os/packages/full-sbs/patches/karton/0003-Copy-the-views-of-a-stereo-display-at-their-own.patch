     return image;
 }
 
+// the address of a sample of a view: its view, column and row
+static QRgb address(int view, int x, int y)
+{
+    return qRgb(x & 0xff, y & 0xff, view << 7 | ((x >> 8) & 0xf) << 3 | ((y >> 8) & 0x7));
+}
+
+// a frame whose views carry the address of each of their samples, the rest black
+static QImage addressedFrame(const QSize &size, const QRect &left, const QRect &right)
+{
+    QImage image(size, QImage::Format_RGB32);
+    image.fill(Qt::black);
+    for (int view = 0; view < 2; ++view) {
+        const QRect &rect = view ? right : left;
+        for (int y = 0; y < rect.height(); ++y) {
+            for (int x = 0; x < rect.width(); ++x) {
+                image.setPixel(rect.x() + x, rect.y() + y, address(view, x, y));
+            }
+        }
+    }
+    return image;
+}
