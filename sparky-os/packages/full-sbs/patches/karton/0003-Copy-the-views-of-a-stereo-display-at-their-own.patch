-void StereoFrameTest::viewsDoNotMix()
+void StereoFrameTest::samplesAreCopied_data()
+{
+    packing_data();
+}
+
+void StereoFrameTest::samplesAreCopied()
 {
-    // scaled up from half, a view still has nothing of the other one at its edge
-    const QRect left(0, 0, 960, 1080);
-    const QRect right(960, 0, 960, 1080);
-    const QImage packed = packStereoFrame(frame(QSize(1920, 1080), left, right), StereoInfo{QSize(1920, 1080), left, right});
-
-    for (int y = 0; y < packed.height(); y += 90) {
-        QCOMPARE(packed.pixelColor(1919, y), leftColor);
-        QCOMPARE(packed.pixelColor(1920, y), rightColor);
+    QFETCH(QSize, frameSize);
+    QFETCH(QRect, left);
+    QFETCH(QRect, right);
+    QFETCH(QSize, viewSize);
+
+    // every sample of the packed image is the sample of its view at its place: nothing rescaled
+    const QImage packed = packStereoFrame(addressedFrame(frameSize, left, right), StereoInfo{viewSize, left, right});
+    QCOMPARE(packed.size(), QSize(left.width() * 2, left.height()));
+    int wrong = 0;
+    for (int y = 0; y < packed.height(); ++y) {
+        const QRgb *line = reinterpret_cast<const QRgb *>(packed.constScanLine(y));
+        for (int x = 0; x < packed.width(); ++x) {
+            const int view = x >= left.width() ? 1 : 0;
+            wrong += (line[x] & 0xffffff) != (address(view, x - view * left.width(), y) & 0xffffff);
+        }
     }
+    QCOMPARE(wrong, 0);
+}
+
+void StereoFrameTest::viewsOfDifferentSizes()
+{
+    const QImage image = frame(QSize(200, 100), QRect(0, 0, 100, 100), QRect(100, 0, 90, 100));
+
+    QVERIFY(packStereoFrame(image, StereoInfo{QSize(100, 100), QRect(0, 0, 100, 100), QRect(100, 0, 90, 100)}).isNull());
 }
 
