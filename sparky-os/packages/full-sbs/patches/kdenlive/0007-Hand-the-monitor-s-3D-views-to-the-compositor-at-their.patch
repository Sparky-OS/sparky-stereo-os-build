-void StereoLayer::showEyes(const QImage &left, const QImage &right)
+// One view at the resolution it has, with the black bars of an area of this size in its own samples: the compositor resizes
+// the whole to the area once, and the view keeps its shape. Null where that would be larger than a compositor's texture.
+static QImage letterboxed(const QImage &view, const QSize &area, double sampleAspect)
+{
+    const QSizeF fitted = QSizeF(view.width() * sampleAspect, view.height()).scaled(QSizeF(area), Qt::KeepAspectRatio);
+    if (view.isNull() || fitted.isEmpty()) {
+        return {};
+    }
+    // the view's samples per pixel of the area, along each axis
+    const qreal kx = view.width() / fitted.width();
+    const qreal ky = view.height() / fitted.height();
+    const int x = qRound((area.width() - fitted.width()) / 2 * kx);
+    const int y = qRound((area.height() - fitted.height()) / 2 * ky);
+    const QSize size(qMax(qRound(area.width() * kx), x + view.width()), qMax(qRound(area.height() * ky), y + view.height()));
+    if (size.width() > 8192 || size.height() > 16384) {
+        return {};
+    }
+    QImage result(size, QImage::Format_RGB32);
+    result.fill(Qt::black);
+    QPainter painter(&result);
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    painter.drawImage(QPoint(x, y), view);
+    return result;
+}
+
+void StereoLayer::showEyes(const QImage &left, const QImage &right, double sampleAspect)
 {
     if (!d->active || !d->area || !d->area->isVisible() || d->area->size().isEmpty() || left.isNull() || right.isNull()) {
         return;
@@ -369,8 +394,16 @@ void StereoLayer::showEyes(const QImage &left, const QImage &right)
     // Nothing is listened to on the queue of the layer but the release of buffers
     wl_display_dispatch_queue_pending(d->display, d->queue);
 
-    const qreal ratio = d->area->devicePixelRatioF();
-    const QSize view(qMax(1, qRound(d->area->width() * ratio)), qMax(1, qRound(d->area->height() * ratio)));
+    // each view as the frame carries it; where that cannot be a texture, scaled to the area's pixels
+    QImage leftView = letterboxed(left, d->area->size(), sampleAspect > 0 ? sampleAspect : 1.0);
+    QImage rightView = letterboxed(right, d->area->size(), sampleAspect > 0 ? sampleAspect : 1.0);
+    if (leftView.isNull() || rightView.isNull() || leftView.size() != rightView.size()) {
+        const qreal ratio = d->area->devicePixelRatioF();
+        const QSize area(qMax(1, qRound(d->area->width() * ratio)), qMax(1, qRound(d->area->height() * ratio)));
+        leftView = fitted(left, area);
+        rightView = fitted(right, area);
+    }
+    const QSize view = leftView.size();
     const QSize pixels(view.width() * 2, view.height());
 
     Buffer *buffer = nullptr;
@@ -396,8 +429,8 @@ void StereoLayer::showEyes(const QImage &left, const QImage &right)
     QImage target(buffer->data, pixels.width(), pixels.height(), pixels.width() * 4, QImage::Format_RGB32);
     QPainter painter(&target);
     painter.setCompositionMode(QPainter::CompositionMode_Source);
-    painter.drawImage(0, 0, fitted(left, view));
-    painter.drawImage(view.width(), 0, fitted(right, view));
+    painter.drawImage(0, 0, leftView);
+    painter.drawImage(view.width(), 0, rightView);
     painter.end();
 
     d->place();
