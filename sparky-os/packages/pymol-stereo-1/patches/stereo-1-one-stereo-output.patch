+
+def _languages():
+    names = []
+    for var in ('LC_ALL', 'LC_MESSAGES', 'LANG'):
+        value = os.environ.get(var, '').split('.')[0].split('@')[0]
+        if value and value not in ('C', 'POSIX'):
+            names.append(value)
+            break
+    out = []
+    for name in names:
+        out.append(name)
+        out.append(name.split('_')[0])
+    return out + ['en']
+
+
+def say(key):
+    table = MESSAGES[key]
+    for lang in _languages():
+        if lang in table:
+            return table[lang]
+    return table['en']
+
+
+def _file():
+    base = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
+    return os.path.join(base, 'pymol', 'enable3d')
+
+
+def _stored():
+    try:
+        with open(_file()) as f:
+            return f.read().strip()
+    except OSError:
+        return ''
+
+
+def enabled():
+    """3D is on unless the person turned it off (the file, the environment)."""
+    if os.environ.get('PYMOL_ENABLE_3D') in ('0', '1'):
+        return os.environ['PYMOL_ENABLE_3D'] == '1'
+    return _stored() != '0'
+
+
+def explicit():
+    """The person turned 3D on themselves (the menu, -S or the environment)."""
+    if os.environ.get('PYMOL_ENABLE_3D') in ('0', '1'):
+        return os.environ['PYMOL_ENABLE_3D'] == '1'
+    return _stored() == '1'
+
+
+def stereo_visual_available():
+    """Whether the X server offers a quad buffer visual (GLX_STEREO): on Stereo KWin only on a screen in a 3D mode."""
+    try:
+        import ctypes
+        import ctypes.util
+        x11 = ctypes.CDLL(ctypes.util.find_library('X11') or 'libX11.so.6')
+        gl = ctypes.CDLL(ctypes.util.find_library('GL') or 'libGL.so.1')
+        x11.XOpenDisplay.restype = ctypes.c_void_p
+        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
+        x11.XDefaultScreen.argtypes = [ctypes.c_void_p]
+        x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
+        gl.glXChooseVisual.restype = ctypes.c_void_p
+        gl.glXChooseVisual.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(ctypes.c_int)]
+        display = x11.XOpenDisplay(None)
+        if not display:
+            return False
+        try:
+            GLX_RGBA, GLX_DOUBLEBUFFER, GLX_STEREO = 4, 5, 6
+            attributes = (ctypes.c_int * 5)(GLX_RGBA, GLX_DOUBLEBUFFER, GLX_STEREO, 0, 0)
+            return bool(gl.glXChooseVisual(display, x11.XDefaultScreen(display), attributes))
+        finally:
+            x11.XCloseDisplay(display)
+    except Exception:
+        return False
+
+
+def toggle(cmd=None):
+    path = _file()
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, 'w') as f:
+        f.write('0' if enabled() else '1')
+
+
+def menu_label():
+    return say('disable' if enabled() else 'enable')
+
+
+def open_display_settings():
+    for argv in (['systemsettings', 'kcm_kscreen'], ['kcmshell6', 'kcm_kscreen']):
+        try:
+            subprocess.Popen(argv)
+            return
+        except OSError:
+            continue
+    print(' ' + say('display'))
