msgid ""
msgstr "Project-Id-Version: kcm-ums 0.2.0\nPO-Revision-Date: 2026-11-11 00:00+0000\nLast-Translator: Sparky Stereo OS translators\nLanguage-Team: Sparky Stereo OS\nLanguage: de\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "A device request is still running. Try again shortly."
msgstr "Eine Geräteanfrage läuft noch. Versuchen Sie es gleich erneut."

msgid "Add Folder…"
msgstr "Ordner hinzufügen…"

msgid "Back 10 s"
msgstr "10 s zurück"

msgid "Brightness:"
msgstr "Helligkeit:"

msgid "Choose a Folder to Share"
msgstr "Ordner zum Freigeben auswählen"

msgid "Choose a shared file with Play on TV or Play on the headset."
msgstr "Wählen Sie eine freigegebene Datei über Auf dem Fernseher abspielen oder Im Headset abspielen aus."

msgid "Choose one local media file."
msgstr "Wählen Sie eine lokale Mediendatei aus."

msgid "Control Devices"
msgstr "Geräte steuern"

msgid "Could not change the media server: %1"
msgstr "Der Medienserver konnte nicht geändert werden: %1"

msgid "Device discovery could not start."
msgstr "Die Gerätesuche konnte nicht gestartet werden."

msgid "Device group: tv or headset"
msgstr "Gerätegruppe: tv oder headset"

msgid "Device:"
msgstr "Gerät:"

msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "Geräte, Transkodierung und weitere Einstellungen finden Sie in der Weboberfläche."

msgid "Forward 10 s"
msgstr "10 s vor"

msgid "Media Devices"
msgstr "Mediengeräte"

msgid "Media Devices could not start."
msgstr "Mediengeräte konnte nicht gestartet werden."

msgid "Media Server Settings"
msgstr "Medienserver-Einstellungen"

msgid "Media controls could not connect to the session bus."
msgstr "Die Mediensteuerung konnte keine Verbindung zum Sitzungsbus herstellen."

msgid "Media server:"
msgstr "Medienserver:"

msgid "No folders are shared."
msgstr "Es werden keine Ordner geteilt."

msgid "No matching device is available. Turn it on, allow it in UMS and refresh."
msgstr "Kein passendes Gerät verfügbar. Schalten Sie es ein, erlauben Sie es in UMS und aktualisieren Sie die Liste."

msgid "One local file already shared by UMS"
msgstr "Eine bereits von UMS freigegebene lokale Datei"

msgid "Open Web Interface"
msgstr "Weboberfläche öffnen"

msgid "Password:"
msgstr "Passwort:"

msgid "Pause"
msgstr "Pause"

msgid "Paused"
msgstr "Pausiert"

msgid "Play"
msgstr "Wiedergabe"

msgid "Play Selected File"
msgstr "Ausgewählte Datei abspielen"

msgid "Play shared media on a network device and control it from Plasma."
msgstr "Freigegebene Medien auf einem Netzwerkgerät abspielen und über Plasma steuern."

msgid "Playing"
msgstr "Wiedergabe läuft"

msgid "Refresh Devices"
msgstr "Geräte aktualisieren"

msgid "Remove"
msgstr "Entfernen"

msgid "Restore Default Folders"
msgstr "Standardordner wiederherstellen"

msgid "Select a device to control it."
msgstr "Wählen Sie ein Gerät zur Steuerung aus."

msgid "Server name:"
msgstr "Servername:"

msgid "Share with the TVs and devices on the network"
msgstr "Mit Fernsehern und Geräten im Netzwerk teilen"

msgid "Shared folders:"
msgstr "Freigegebene Ordner:"

msgid "Sign in to UMS"
msgstr "Bei UMS anmelden"

msgid "Stop"
msgstr "Stopp"

msgid "Stopped"
msgstr "Gestoppt"

msgid "The device address is invalid."
msgstr "Die Geräteadresse ist ungültig."

msgid "The device refused %1: %2"
msgstr "Das Gerät hat %1 abgelehnt: %2"

msgid "The device request failed (HTTP %1). Check that the server and device are available."
msgstr "Die Geräteanfrage ist fehlgeschlagen (HTTP %1). Prüfen Sie, ob Server und Gerät erreichbar sind."

msgid "The device returned invalid XML."
msgstr "Das Gerät hat ungültiges XML gesendet."

msgid "The media server address is invalid."
msgstr "Die Medienserver-Adresse ist ungültig."

msgid "The selected device did not answer discovery. Refresh the list and try again."
msgstr "Das ausgewählte Gerät hat nicht geantwortet. Aktualisieren Sie die Liste und versuchen Sie es erneut."

msgid "The server is off. Nothing is shared."
msgstr "Der Server ist ausgeschaltet. Es wird nichts geteilt."

msgid "The server is on. The folders below are visible to every device on your network."
msgstr "Der Server ist eingeschaltet. Die folgenden Ordner sind für alle Geräte im Netzwerk sichtbar."

msgid "This device does not support %1."
msgstr "Dieses Gerät unterstützt %1 nicht."

msgid "This device is unavailable or blocked in UMS."
msgstr "Dieses Gerät ist nicht verfügbar oder in UMS gesperrt."

msgid "This file is not in a shared folder. Add its folder in Media Server settings and try again."
msgstr "Diese Datei liegt in keinem freigegebenen Ordner. Fügen Sie ihren Ordner in den Medienserver-Einstellungen hinzu und versuchen Sie es erneut."

msgid "UMS cannot uniquely find this file for the selected device. Check its shared folders and media names."
msgstr "UMS kann diese Datei für das ausgewählte Gerät nicht eindeutig finden. Prüfen Sie die freigegebenen Ordner und Mediennamen."

msgid "UMS did not accept the sign-in."
msgstr "UMS hat die Anmeldung abgelehnt."

msgid "UMS requires permission. Sign in and try again."
msgstr "UMS erfordert eine Berechtigung. Melden Sie sich an und versuchen Sie es erneut."

msgid "UMS returned an invalid response."
msgstr "UMS hat eine ungültige Antwort gesendet."

msgid "UMS web interface address"
msgstr "Adresse der UMS-Weboberfläche"

msgid "Username:"
msgstr "Benutzername:"

msgid "Volume must be between 0 and 100 percent."
msgstr "Die Lautstärke muss zwischen 0 und 100 Prozent liegen."

msgid "Volume:"
msgstr "Lautstärke:"
