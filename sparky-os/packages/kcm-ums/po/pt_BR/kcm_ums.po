msgstr "Project-Id-Version: kcm-ums 0.2.0\nPO-Revision-Date: 2026-11-11 00:00+0000\nLast-Translator: Sparky Stereo OS translators\nLanguage-Team: Sparky Stereo OS\nLanguage: pt_BR\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "A device request is still running. Try again shortly."
msgstr "Uma solicitação ao dispositivo ainda está em andamento. Tente novamente em instantes."

msgid "Add Folder…"
msgstr "Adicionar pasta…"

msgid "Back 10 s"
msgstr "Voltar 10 s"

msgid "Brightness:"
msgstr "Brilho:"

msgid "Choose a Folder to Share"
msgstr "Escolher uma pasta para compartilhar"

msgid "Choose a shared file with Play on TV or Play on the headset."
msgstr "Escolha um arquivo compartilhado com Reproduzir na TV ou Reproduzir no headset."

msgid "Choose one local media file."
msgstr "Escolha um arquivo de mídia local."

msgid "Control Devices"
msgstr "Controlar dispositivos"

msgid "Could not change the media server: %1"
msgstr "Não foi possível alterar o servidor de mídia: %1"

msgid "Device discovery could not start."
msgstr "Não foi possível iniciar a descoberta de dispositivos."

msgid "Device group: tv or headset"
msgstr "Grupo de dispositivos: tv ou headset"

msgid "Device:"
msgstr "Dispositivo:"

msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "Dispositivos, transcodificação e todo o resto são configurados na interface web."

msgid "Forward 10 s"
msgstr "Avançar 10 s"

msgid "Media Devices"
msgstr "Dispositivos de mídia"

msgid "Media Devices could not start."
msgstr "Não foi possível iniciar Dispositivos de mídia."

msgid "Media Server Settings"
msgstr "Configurações do servidor de mídia"

msgid "Media controls could not connect to the session bus."
msgstr "Os controles de mídia não conseguiram se conectar ao barramento da sessão."

msgid "Media server:"
msgstr "Servidor de mídia:"

msgid "No folders are shared."
msgstr "Nenhuma pasta é compartilhada."

msgid "No matching device is available. Turn it on, allow it in UMS and refresh."
msgstr "Nenhum dispositivo correspondente está disponível. Ligue-o, permita seu acesso no UMS e atualize a lista."

msgid "One local file already shared by UMS"
msgstr "Um arquivo local já compartilhado pelo UMS"

msgid "Open Web Interface"
msgstr "Abrir a interface web"

msgid "Password:"
msgstr "Senha:"

msgid "Pause"
msgstr "Pausar"

msgid "Paused"
msgstr "Pausado"

msgid "Play"
msgstr "Reproduzir"

msgid "Play Selected File"
msgstr "Reproduzir o arquivo selecionado"

msgid "Play shared media on a network device and control it from Plasma."
msgstr "Reproduza mídia compartilhada em um dispositivo da rede e controle pelo Plasma."

msgid "Playing"
msgstr "Reproduzindo"

msgid "Refresh Devices"
msgstr "Atualizar dispositivos"

msgid "Remove"
msgstr "Remover"

msgid "Restore Default Folders"
msgstr "Restaurar pastas padrão"

msgid "Select a device to control it."
msgstr "Selecione um dispositivo para controlá-lo."

msgid "Server name:"
msgstr "Nome do servidor:"

msgid "Share with the TVs and devices on the network"
msgstr "Compartilhar com as TVs e dispositivos da rede"

msgid "Shared folders:"
msgstr "Pastas compartilhadas:"

msgid "Sign in to UMS"
msgstr "Entrar no UMS"

msgid "Stop"
msgstr "Parar"

msgid "Stopped"
msgstr "Parado"

msgid "The device address is invalid."
msgstr "O endereço do dispositivo é inválido."

msgid "The device refused %1: %2"
msgstr "O dispositivo recusou %1: %2"

msgid "The device request failed (HTTP %1). Check that the server and device are available."
msgstr "A solicitação ao dispositivo falhou (HTTP %1). Verifique se o servidor e o dispositivo estão disponíveis."

msgid "The device returned invalid XML."
msgstr "O dispositivo retornou XML inválido."

msgid "The media server address is invalid."
msgstr "O endereço do servidor de mídia é inválido."

msgid "The selected device did not answer discovery. Refresh the list and try again."
msgstr "O dispositivo selecionado não respondeu à descoberta. Atualize a lista e tente novamente."

msgid "The server is off. Nothing is shared."
msgstr "O servidor está desligado. Nada é compartilhado."

msgid "The server is on. The folders below are visible to every device on your network."
msgstr "O servidor está ligado. As pastas abaixo ficam visíveis para todos os dispositivos da sua rede."

msgid "This device does not support %1."
msgstr "Este dispositivo não oferece suporte a %1."

msgid "This device is unavailable or blocked in UMS."
msgstr "Este dispositivo está indisponível ou bloqueado no UMS."

msgid "This file is not in a shared folder. Add its folder in Media Server settings and try again."
msgstr "Este arquivo não está em uma pasta compartilhada. Adicione a pasta nas configurações do servidor de mídia e tente novamente."

msgid "UMS cannot uniquely find this file for the selected device. Check its shared folders and media names."
msgstr "O UMS não consegue encontrar este arquivo de forma única para o dispositivo selecionado. Verifique as pastas compartilhadas e os nomes."

msgid "UMS did not accept the sign-in."
msgstr "O UMS não aceitou o login."

msgid "UMS requires permission. Sign in and try again."
msgstr "O UMS exige permissão. Entre e tente novamente."

msgid "UMS returned an invalid response."
msgstr "O UMS retornou uma resposta inválida."

msgid "UMS web interface address"
msgstr "Endereço da interface web do UMS"

msgid "Username:"
msgstr "Nome de usuário:"

msgid "Volume must be between 0 and 100 percent."
msgstr "O volume deve estar entre 0 e 100 por cento."

msgid "Volume:"
msgstr "Volume:"
