msgid ""
msgstr "Project-Id-Version: kcm-ums 0.2.0\nPO-Revision-Date: 2026-11-11 00:00+0000\nLast-Translator: Sparky Stereo OS translators\nLanguage-Team: Sparky Stereo OS\nLanguage: es\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "A device request is still running. Try again shortly."
msgstr "Hay una solicitud en curso. Vuelva a intentarlo en unos instantes."

msgid "Add Folder…"
msgstr "Añadir carpeta…"

msgid "Back 10 s"
msgstr "Retroceder 10 s"

msgid "Brightness:"
msgstr "Brillo:"

msgid "Choose a Folder to Share"
msgstr "Elegir una carpeta para compartir"

msgid "Choose a shared file with Play on TV or Play on the headset."
msgstr "Seleccione un archivo compartido con Reproducir en el televisor o Reproducir en el visor."

msgid "Choose one local media file."
msgstr "Seleccione un archivo multimedia local."

msgid "Control Devices"
msgstr "Controlar dispositivos"

msgid "Could not change the media server: %1"
msgstr "No se pudo modificar el servidor multimedia: %1"

msgid "Device discovery could not start."
msgstr "No se pudo iniciar la búsqueda de dispositivos."

msgid "Device group: tv or headset"
msgstr "Grupo de dispositivos: tv o headset"

msgid "Device:"
msgstr "Dispositivo:"

msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "Los dispositivos, la transcodificación y los demás ajustes se configuran en la interfaz web."

msgid "Forward 10 s"
msgstr "Avanzar 10 s"

msgid "Media Devices"
msgstr "Dispositivos multimedia"

msgid "Media Devices could not start."
msgstr "No se pudo iniciar Dispositivos multimedia."

msgid "Media Server Settings"
msgstr "Configuración del servidor multimedia"

msgid "Media controls could not connect to the session bus."
msgstr "Los controles multimedia no pudieron conectarse al bus de sesión."

msgid "Media server:"
msgstr "Servidor multimedia:"

msgid "No folders are shared."
msgstr "No se comparte ninguna carpeta."

msgid "No matching device is available. Turn it on, allow it in UMS and refresh."
msgstr "No hay dispositivos compatibles disponibles. Enciéndalo, permita su acceso en UMS y actualice la lista."

msgid "One local file already shared by UMS"
msgstr "Un archivo local ya compartido por UMS"

msgid "Open Web Interface"
msgstr "Abrir interfaz web"

msgid "Password:"
msgstr "Contraseña:"

msgid "Pause"
msgstr "Pausar"

msgid "Paused"
msgstr "En pausa"

msgid "Play"
msgstr "Reproducir"

msgid "Play Selected File"
msgstr "Reproducir el archivo seleccionado"

msgid "Play shared media on a network device and control it from Plasma."
msgstr "Reproduzca contenido compartido en un dispositivo de red y contrólelo desde Plasma."

msgid "Playing"
msgstr "Reproduciendo"

msgid "Refresh Devices"
msgstr "Actualizar dispositivos"

msgid "Remove"
msgstr "Eliminar"

msgid "Restore Default Folders"
msgstr "Restaurar carpetas predeterminadas"

msgid "Select a device to control it."
msgstr "Seleccione un dispositivo para controlarlo."

msgid "Server name:"
msgstr "Nombre del servidor:"

msgid "Share with the TVs and devices on the network"
msgstr "Compartir con televisores y dispositivos de la red"

msgid "Shared folders:"
msgstr "Carpetas compartidas:"

msgid "Sign in to UMS"
msgstr "Iniciar sesión en UMS"

msgid "Stop"
msgstr "Detener"

msgid "Stopped"
msgstr "Detenido"

msgid "The device address is invalid."
msgstr "La dirección del dispositivo no es válida."

msgid "The device refused %1: %2"
msgstr "El dispositivo rechazó %1: %2"

msgid "The device request failed (HTTP %1). Check that the server and device are available."
msgstr "La solicitud al dispositivo falló (HTTP %1). Compruebe que el servidor y el dispositivo estén disponibles."

msgid "The device returned invalid XML."
msgstr "El dispositivo devolvió XML no válido."

msgid "The media server address is invalid."
msgstr "La dirección del servidor multimedia no es válida."

msgid "The selected device did not answer discovery. Refresh the list and try again."
msgstr "El dispositivo seleccionado no respondió. Actualice la lista y vuelva a intentarlo."

msgid "The server is off. Nothing is shared."
msgstr "El servidor está desactivado. No se comparte nada."

msgid "The server is on. The folders below are visible to every device on your network."
msgstr "El servidor está activado. Las carpetas siguientes son visibles para todos los dispositivos de su red."

msgid "This device does not support %1."
msgstr "Este dispositivo no admite %1."

msgid "This device is unavailable or blocked in UMS."
msgstr "Este dispositivo no está disponible o está bloqueado en UMS."

msgid "This file is not in a shared folder. Add its folder in Media Server settings and try again."
msgstr "Este archivo no está en una carpeta compartida. Añada su carpeta en la configuración del servidor multimedia y vuelva a intentarlo."

msgid "UMS cannot uniquely find this file for the selected device. Check its shared folders and media names."
msgstr "UMS no puede identificar este archivo de forma inequívoca para el dispositivo. Compruebe las carpetas compartidas y los nombres."

msgid "UMS did not accept the sign-in."
msgstr "UMS no aceptó el inicio de sesión."

msgid "UMS requires permission. Sign in and try again."
msgstr "UMS requiere permiso. Inicie sesión y vuelva a intentarlo."

msgid "UMS returned an invalid response."
msgstr "UMS devolvió una respuesta no válida."

msgid "UMS web interface address"
msgstr "Dirección de la interfaz web de UMS"

msgid "Username:"
msgstr "Usuario:"

msgid "Volume must be between 0 and 100 percent."
msgstr "El volumen debe estar entre el 0 y el 100 por ciento."

msgid "Volume:"
msgstr "Volumen:"
