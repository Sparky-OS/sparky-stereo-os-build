msgstr "Project-Id-Version: kcm-ums 0.2.0\nPO-Revision-Date: 2026-11-11 00:00+0000\nLast-Translator: Sparky Stereo OS translators\nLanguage-Team: Sparky Stereo OS\nLanguage: pl\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "A device request is still running. Try again shortly."
msgstr "Żądanie do urządzenia nadal trwa. Spróbuj ponownie za chwilę."

msgid "Add Folder…"
msgstr "Dodaj folder…"

msgid "Back 10 s"
msgstr "Cofnij o 10 s"

msgid "Brightness:"
msgstr "Jasność:"

msgid "Choose a Folder to Share"
msgstr "Wybierz folder do udostępnienia"

msgid "Choose a shared file with Play on TV or Play on the headset."
msgstr "Wybierz udostępniony plik przez Odtwórz na telewizorze lub Odtwórz w goglach."

msgid "Choose one local media file."
msgstr "Wybierz jeden lokalny plik multimedialny."

msgid "Control Devices"
msgstr "Steruj urządzeniami"

msgid "Could not change the media server: %1"
msgstr "Nie udało się zmienić serwera multimediów: %1"

msgid "Device discovery could not start."
msgstr "Nie udało się rozpocząć wykrywania urządzeń."

msgid "Device group: tv or headset"
msgstr "Grupa urządzeń: tv lub headset"

msgid "Device:"
msgstr "Urządzenie:"

msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "Urządzenia, transkodowanie i wszystko inne ustawia się w interfejsie WWW."

msgid "Forward 10 s"
msgstr "Przewiń o 10 s"

msgid "Media Devices"
msgstr "Urządzenia multimedialne"

msgid "Media Devices could not start."
msgstr "Nie udało się uruchomić Urządzeń multimedialnych."

msgid "Media Server Settings"
msgstr "Ustawienia serwera multimediów"

msgid "Media controls could not connect to the session bus."
msgstr "Sterowanie multimediami nie mogło połączyć się z magistralą sesji."

msgid "Media server:"
msgstr "Serwer multimediów:"

msgid "No folders are shared."
msgstr "Żadne foldery nie są udostępniane."

msgid "No matching device is available. Turn it on, allow it in UMS and refresh."
msgstr "Brak pasującego urządzenia. Włącz je, zezwól na nie w UMS i odśwież listę."

msgid "One local file already shared by UMS"
msgstr "Jeden lokalny plik już udostępniany przez UMS"

msgid "Open Web Interface"
msgstr "Otwórz interfejs WWW"

msgid "Password:"
msgstr "Hasło:"

msgid "Pause"
msgstr "Wstrzymaj"

msgid "Paused"
msgstr "Wstrzymano"

msgid "Play"
msgstr "Odtwórz"

msgid "Play Selected File"
msgstr "Odtwórz wybrany plik"

msgid "Play shared media on a network device and control it from Plasma."
msgstr "Odtwarzaj udostępnione multimedia na urządzeniu sieciowym i steruj nimi z Plasmy."

msgid "Playing"
msgstr "Odtwarzanie"

msgid "Refresh Devices"
msgstr "Odśwież urządzenia"

msgid "Remove"
msgstr "Usuń"

msgid "Restore Default Folders"
msgstr "Przywróć domyślne foldery"

msgid "Select a device to control it."
msgstr "Wybierz urządzenie, aby nim sterować."

msgid "Server name:"
msgstr "Nazwa serwera:"

msgid "Share with the TVs and devices on the network"
msgstr "Udostępniaj telewizorom i urządzeniom w sieci"

msgid "Shared folders:"
msgstr "Udostępniane foldery:"

msgid "Sign in to UMS"
msgstr "Zaloguj się do UMS"

msgid "Stop"
msgstr "Zatrzymaj"

msgid "Stopped"
msgstr "Zatrzymano"

msgid "The device address is invalid."
msgstr "Adres urządzenia jest nieprawidłowy."

msgid "The device refused %1: %2"
msgstr "Urządzenie odrzuciło %1: %2"

msgid "The device request failed (HTTP %1). Check that the server and device are available."
msgstr "Żądanie do urządzenia nie powiodło się (HTTP %1). Sprawdź dostępność serwera i urządzenia."

msgid "The device returned invalid XML."
msgstr "Urządzenie zwróciło nieprawidłowy XML."

msgid "The media server address is invalid."
msgstr "Adres serwera multimediów jest nieprawidłowy."

msgid "The selected device did not answer discovery. Refresh the list and try again."
msgstr "Wybrane urządzenie nie odpowiedziało. Odśwież listę i spróbuj ponownie."

msgid "The server is off. Nothing is shared."
msgstr "Serwer jest wyłączony. Nic nie jest udostępniane."

msgid "The server is on. The folders below are visible to every device on your network."
msgstr "Serwer jest włączony. Poniższe foldery są widoczne dla każdego urządzenia w Twojej sieci."

msgid "This device does not support %1."
msgstr "To urządzenie nie obsługuje %1."

msgid "This device is unavailable or blocked in UMS."
msgstr "To urządzenie jest niedostępne lub zablokowane w UMS."

msgid "This file is not in a shared folder. Add its folder in Media Server settings and try again."
msgstr "Plik nie znajduje się w udostępnionym folderze. Dodaj jego folder w ustawieniach serwera multimediów i spróbuj ponownie."

msgid "UMS cannot uniquely find this file for the selected device. Check its shared folders and media names."
msgstr "UMS nie może jednoznacznie odnaleźć pliku dla wybranego urządzenia. Sprawdź udostępnione foldery i nazwy plików."

msgid "UMS did not accept the sign-in."
msgstr "UMS odrzucił logowanie."

msgid "UMS requires permission. Sign in and try again."
msgstr "UMS wymaga uprawnień. Zaloguj się i spróbuj ponownie."

msgid "UMS returned an invalid response."
msgstr "UMS zwrócił nieprawidłową odpowiedź."

msgid "UMS web interface address"
msgstr "Adres interfejsu WWW UMS"

msgid "Username:"
msgstr "Nazwa użytkownika:"

msgid "Volume must be between 0 and 100 percent."
msgstr "Głośność musi wynosić od 0 do 100 procent."

msgid "Volume:"
msgstr "Głośność:"
