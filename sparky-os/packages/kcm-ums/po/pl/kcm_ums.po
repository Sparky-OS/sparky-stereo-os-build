msgid "Could not change the media server: %1"
msgstr "Nie udało się zmienić serwera multimediów: %1"

#: src/ui/main.qml:27
msgid "Media server:"
msgstr "Serwer multimediów:"

#: src/ui/main.qml:28
msgid "Share with the TVs and devices on the network"
msgstr "Udostępniaj telewizorom i urządzeniom w sieci"

#: src/ui/main.qml:37
msgid "The server is on. The folders below are visible to every device on your network."
msgstr "Serwer jest włączony. Poniższe foldery są widoczne dla każdego urządzenia w Twojej sieci."

#: src/ui/main.qml:38
msgid "The server is off. Nothing is shared."
msgstr "Serwer jest wyłączony. Nic nie jest udostępniane."

#: src/ui/main.qml:42
msgid "Server name:"
msgstr "Nazwa serwera:"

#: src/ui/main.qml:54
msgid "Shared folders:"
msgstr "Udostępniane foldery:"

#: src/ui/main.qml:71
msgid "Remove"
msgstr "Usuń"

#: src/ui/main.qml:82
msgid "No folders are shared."
msgstr "Żadne foldery nie są udostępniane."

#: src/ui/main.qml:89
msgid "Add Folder…"
msgstr "Dodaj folder…"

#: src/ui/main.qml:94
msgid "Restore Default Folders"
msgstr "Przywróć domyślne foldery"

#: src/ui/main.qml:106
msgid "Open Web Interface"
msgstr "Otwórz interfejs WWW"

#: src/ui/main.qml:114
msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "Urządzenia, transkodowanie i wszystko inne ustawia się w interfejsie WWW."

#: src/ui/main.qml:120
msgid "Choose a Folder to Share"
msgstr "Wybierz folder do udostępnienia"
