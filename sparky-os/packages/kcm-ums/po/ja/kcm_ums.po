msgid ""
msgstr "Project-Id-Version: kcm-ums 0.2.0\nPO-Revision-Date: 2026-11-11 00:00+0000\nLast-Translator: Sparky Stereo OS translators\nLanguage-Team: Sparky Stereo OS\nLanguage: ja\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "A device request is still running. Try again shortly."
msgstr "機器への要求を処理中です。しばらくしてから再試行してください。"

msgid "Add Folder…"
msgstr "フォルダーを追加…"

msgid "Back 10 s"
msgstr "10秒戻る"

msgid "Brightness:"
msgstr "明るさ："

msgid "Choose a Folder to Share"
msgstr "共有するフォルダーを選択"

msgid "Choose a shared file with Play on TV or Play on the headset."
msgstr "「テレビで再生」か「ヘッドセットで再生」で共有ファイルを選んでください。"

msgid "Choose one local media file."
msgstr "ローカルのメディアファイルを1つ選んでください。"

msgid "Control Devices"
msgstr "機器を操作"

msgid "Could not change the media server: %1"
msgstr "メディアサーバーを変更できませんでした：%1"

msgid "Device discovery could not start."
msgstr "機器の検索を開始できませんでした。"

msgid "Device group: tv or headset"
msgstr "機器グループ：tvまたはheadset"

msgid "Device:"
msgstr "機器："

msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "機器、トランスコード、その他の設定はウェブインターフェースで行います。"

msgid "Forward 10 s"
msgstr "10秒進む"

msgid "Media Devices"
msgstr "メディア機器"

msgid "Media Devices could not start."
msgstr "メディア機器を起動できませんでした。"

msgid "Media Server Settings"
msgstr "メディアサーバーの設定"

msgid "Media controls could not connect to the session bus."
msgstr "メディア操作をセッションバスに接続できませんでした。"

msgid "Media server:"
msgstr "メディアサーバー："

msgid "No folders are shared."
msgstr "共有しているフォルダーはありません。"

msgid "No matching device is available. Turn it on, allow it in UMS and refresh."
msgstr "該当する機器がありません。電源を入れ、UMSで許可してから一覧を更新してください。"

msgid "One local file already shared by UMS"
msgstr "UMSで共有済みのローカルファイル1つ"

msgid "Open Web Interface"
msgstr "ウェブインターフェースを開く"

msgid "Password:"
msgstr "パスワード："

msgid "Pause"
msgstr "一時停止"

msgid "Paused"
msgstr "一時停止中"

msgid "Play"
msgstr "再生"

msgid "Play Selected File"
msgstr "選択したファイルを再生"

msgid "Play shared media on a network device and control it from Plasma."
msgstr "ネットワーク機器で共有メディアを再生し、Plasmaから操作します。"

msgid "Playing"
msgstr "再生中"

msgid "Refresh Devices"
msgstr "機器を更新"

msgid "Remove"
msgstr "削除"

msgid "Restore Default Folders"
msgstr "既定のフォルダーに戻す"

msgid "Select a device to control it."
msgstr "操作する機器を選択してください。"

msgid "Server name:"
msgstr "サーバー名："

msgid "Share with the TVs and devices on the network"
msgstr "ネットワーク上のテレビや機器と共有する"

msgid "Shared folders:"
msgstr "共有フォルダー："

msgid "Sign in to UMS"
msgstr "UMSにログイン"

msgid "Stop"
msgstr "停止"

msgid "Stopped"
msgstr "停止中"

msgid "The device address is invalid."
msgstr "機器のアドレスが無効です。"

msgid "The device refused %1: %2"
msgstr "機器が%1を拒否しました：%2"

msgid "The device request failed (HTTP %1). Check that the server and device are available."
msgstr "機器への要求に失敗しました（HTTP %1）。サーバーと機器を確認してください。"

msgid "The device returned invalid XML."
msgstr "機器から無効なXMLが返されました。"

msgid "The media server address is invalid."
msgstr "メディアサーバーのアドレスが無効です。"

msgid "The selected device did not answer discovery. Refresh the list and try again."
msgstr "選択した機器が検索に応答しませんでした。一覧を更新して再試行してください。"

msgid "The server is off. Nothing is shared."
msgstr "サーバーはオフです。何も共有されていません。"

msgid "The server is on. The folders below are visible to every device on your network."
msgstr "サーバーはオンです。下のフォルダーは、ネットワーク上のすべての機器から見えます。"

msgid "This device does not support %1."
msgstr "この機器は%1に対応していません。"

msgid "This device is unavailable or blocked in UMS."
msgstr "この機器は利用できないか、UMSでブロックされています。"

msgid "This file is not in a shared folder. Add its folder in Media Server settings and try again."
msgstr "このファイルは共有フォルダーにありません。メディアサーバーの設定でフォルダーを追加して再試行してください。"

msgid "UMS cannot uniquely find this file for the selected device. Check its shared folders and media names."
msgstr "選択した機器向けのファイルをUMSで一意に特定できません。共有フォルダーと名前を確認してください。"

msgid "UMS did not accept the sign-in."
msgstr "UMSがログインを拒否しました。"

msgid "UMS requires permission. Sign in and try again."
msgstr "UMSの権限が必要です。ログインして再試行してください。"

msgid "UMS returned an invalid response."
msgstr "UMSから無効な応答が返されました。"

msgid "UMS web interface address"
msgstr "UMSウェブインターフェースのアドレス"

msgid "Username:"
msgstr "ユーザー名："

msgid "Volume must be between 0 and 100 percent."
msgstr "音量は0から100パーセントの範囲で指定してください。"

msgid "Volume:"
msgstr "音量："
