msgid ""
msgstr "Project-Id-Version: kcm-ums 0.2.0\nPO-Revision-Date: 2026-11-11 00:00+0000\nLast-Translator: Sparky Stereo OS translators\nLanguage-Team: Sparky Stereo OS\nLanguage: fr\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "A device request is still running. Try again shortly."
msgstr "Une requête est en cours. Réessayez dans un instant."

msgid "Add Folder…"
msgstr "Ajouter un dossier…"

msgid "Back 10 s"
msgstr "Reculer de 10 s"

msgid "Brightness:"
msgstr "Luminosité :"

msgid "Choose a Folder to Share"
msgstr "Choisir un dossier à partager"

msgid "Choose a shared file with Play on TV or Play on the headset."
msgstr "Choisissez un fichier partagé avec Lire sur le téléviseur ou Lire sur le casque."

msgid "Choose one local media file."
msgstr "Choisissez un fichier multimédia local."

msgid "Control Devices"
msgstr "Contrôler les appareils"

msgid "Could not change the media server: %1"
msgstr "Impossible de modifier le serveur multimédia : %1"

msgid "Device discovery could not start."
msgstr "Impossible de lancer la recherche d’appareils."

msgid "Device group: tv or headset"
msgstr "Groupe d’appareils : tv ou headset"

msgid "Device:"
msgstr "Appareil :"

msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "Les appareils, le transcodage et tout le reste se règlent dans l'interface web."

msgid "Forward 10 s"
msgstr "Avancer de 10 s"

msgid "Media Devices"
msgstr "Appareils multimédias"

msgid "Media Devices could not start."
msgstr "Impossible de démarrer Appareils multimédias."

msgid "Media Server Settings"
msgstr "Configuration du serveur multimédia"

msgid "Media controls could not connect to the session bus."
msgstr "Les commandes multimédias n’ont pas pu se connecter au bus de session."

msgid "Media server:"
msgstr "Serveur multimédia :"

msgid "No folders are shared."
msgstr "Aucun dossier n'est partagé."

msgid "No matching device is available. Turn it on, allow it in UMS and refresh."
msgstr "Aucun appareil correspondant n’est disponible. Allumez-le, autorisez-le dans UMS et actualisez la liste."

msgid "One local file already shared by UMS"
msgstr "Un fichier local déjà partagé par UMS"

msgid "Open Web Interface"
msgstr "Ouvrir l'interface web"

msgid "Password:"
msgstr "Mot de passe :"

msgid "Pause"
msgstr "Mettre en pause"

msgid "Paused"
msgstr "En pause"

msgid "Play"
msgstr "Lire"

msgid "Play Selected File"
msgstr "Lire le fichier sélectionné"

msgid "Play shared media on a network device and control it from Plasma."
msgstr "Lire des médias partagés sur un appareil réseau et les contrôler depuis Plasma."

msgid "Playing"
msgstr "Lecture en cours"

msgid "Refresh Devices"
msgstr "Actualiser les appareils"

msgid "Remove"
msgstr "Supprimer"

msgid "Restore Default Folders"
msgstr "Rétablir les dossiers par défaut"

msgid "Select a device to control it."
msgstr "Sélectionnez un appareil à contrôler."

msgid "Server name:"
msgstr "Nom du serveur :"

msgid "Share with the TVs and devices on the network"
msgstr "Partager avec les téléviseurs et appareils du réseau"

msgid "Shared folders:"
msgstr "Dossiers partagés :"

msgid "Sign in to UMS"
msgstr "Se connecter à UMS"

msgid "Stop"
msgstr "Arrêter"

msgid "Stopped"
msgstr "Arrêté"

msgid "The device address is invalid."
msgstr "L’adresse de l’appareil n’est pas valide."

msgid "The device refused %1: %2"
msgstr "L’appareil a refusé %1 : %2"

msgid "The device request failed (HTTP %1). Check that the server and device are available."
msgstr "La requête a échoué (HTTP %1). Vérifiez que le serveur et l’appareil sont disponibles."

msgid "The device returned invalid XML."
msgstr "L’appareil a renvoyé un XML non valide."

msgid "The media server address is invalid."
msgstr "L’adresse du serveur multimédia n’est pas valide."

msgid "The selected device did not answer discovery. Refresh the list and try again."
msgstr "L’appareil sélectionné n’a pas répondu. Actualisez la liste et réessayez."

msgid "The server is off. Nothing is shared."
msgstr "Le serveur est désactivé. Rien n'est partagé."

msgid "The server is on. The folders below are visible to every device on your network."
msgstr "Le serveur est activé. Les dossiers ci-dessous sont visibles par tous les appareils de votre réseau."

msgid "This device does not support %1."
msgstr "Cet appareil ne prend pas en charge %1."

msgid "This device is unavailable or blocked in UMS."
msgstr "Cet appareil est indisponible ou bloqué dans UMS."

msgid "This file is not in a shared folder. Add its folder in Media Server settings and try again."
msgstr "Ce fichier n’est pas dans un dossier partagé. Ajoutez son dossier dans la configuration du serveur multimédia et réessayez."

msgid "UMS cannot uniquely find this file for the selected device. Check its shared folders and media names."
msgstr "UMS ne peut pas identifier ce fichier sans ambiguïté pour cet appareil. Vérifiez les dossiers partagés et les noms."

msgid "UMS did not accept the sign-in."
msgstr "UMS a refusé la connexion."

msgid "UMS requires permission. Sign in and try again."
msgstr "UMS exige une autorisation. Connectez-vous et réessayez."

msgid "UMS returned an invalid response."
msgstr "UMS a renvoyé une réponse non valide."

msgid "UMS web interface address"
msgstr "Adresse de l’interface web UMS"

msgid "Username:"
msgstr "Nom d’utilisateur :"

msgid "Volume must be between 0 and 100 percent."
msgstr "Le volume doit être compris entre 0 et 100 pour cent."

msgid "Volume:"
msgstr "Volume :"
