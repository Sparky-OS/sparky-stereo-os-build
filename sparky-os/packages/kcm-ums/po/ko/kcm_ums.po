msgid ""
msgstr "Project-Id-Version: kcm-ums 0.2.0\nPO-Revision-Date: 2026-11-11 00:00+0000\nLast-Translator: Sparky Stereo OS translators\nLanguage-Team: Sparky Stereo OS\nLanguage: ko\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "A device request is still running. Try again shortly."
msgstr "기기 요청을 처리 중입니다. 잠시 후 다시 시도하세요."

msgid "Add Folder…"
msgstr "폴더 추가…"

msgid "Back 10 s"
msgstr "10초 뒤로"

msgid "Brightness:"
msgstr "밝기:"

msgid "Choose a Folder to Share"
msgstr "공유할 폴더 선택"

msgid "Choose a shared file with Play on TV or Play on the headset."
msgstr "TV에서 재생 또는 헤드셋에서 재생으로 공유 파일을 선택하세요."

msgid "Choose one local media file."
msgstr "로컬 미디어 파일 하나를 선택하세요."

msgid "Control Devices"
msgstr "기기 제어"

msgid "Could not change the media server: %1"
msgstr "미디어 서버를 변경할 수 없습니다: %1"

msgid "Device discovery could not start."
msgstr "기기 검색을 시작할 수 없습니다."

msgid "Device group: tv or headset"
msgstr "기기 그룹: tv 또는 headset"

msgid "Device:"
msgstr "기기:"

msgid "Devices, transcoding and everything else are set in the web interface."
msgstr "기기, 트랜스코딩 및 그 밖의 모든 설정은 웹 인터페이스에서 합니다."

msgid "Forward 10 s"
msgstr "10초 앞으로"

msgid "Media Devices"
msgstr "미디어 기기"

msgid "Media Devices could not start."
msgstr "미디어 기기를 시작할 수 없습니다."

msgid "Media Server Settings"
msgstr "미디어 서버 설정"

msgid "Media controls could not connect to the session bus."
msgstr "미디어 제어를 세션 버스에 연결할 수 없습니다."

msgid "Media server:"
msgstr "미디어 서버:"

msgid "No folders are shared."
msgstr "공유하는 폴더가 없습니다."

msgid "No matching device is available. Turn it on, allow it in UMS and refresh."
msgstr "일치하는 기기가 없습니다. 기기를 켜고 UMS에서 허용한 뒤 새로 고치세요."

msgid "One local file already shared by UMS"
msgstr "UMS에서 이미 공유한 로컬 파일 하나"

msgid "Open Web Interface"
msgstr "웹 인터페이스 열기"

msgid "Password:"
msgstr "비밀번호:"

msgid "Pause"
msgstr "일시 정지"

msgid "Paused"
msgstr "일시 정지됨"

msgid "Play"
msgstr "재생"

msgid "Play Selected File"
msgstr "선택한 파일 재생"

msgid "Play shared media on a network device and control it from Plasma."
msgstr "네트워크 기기에서 공유 미디어를 재생하고 Plasma에서 제어합니다."

msgid "Playing"
msgstr "재생 중"

msgid "Refresh Devices"
msgstr "기기 새로 고침"

msgid "Remove"
msgstr "제거"

msgid "Restore Default Folders"
msgstr "기본 폴더 복원"

msgid "Select a device to control it."
msgstr "제어할 기기를 선택하세요."

msgid "Server name:"
msgstr "서버 이름:"

msgid "Share with the TVs and devices on the network"
msgstr "네트워크의 TV 및 기기와 공유"

msgid "Shared folders:"
msgstr "공유 폴더:"

msgid "Sign in to UMS"
msgstr "UMS에 로그인"

msgid "Stop"
msgstr "정지"

msgid "Stopped"
msgstr "정지됨"

msgid "The device address is invalid."
msgstr "기기 주소가 잘못되었습니다."

msgid "The device refused %1: %2"
msgstr "기기에서 %1을(를) 거부했습니다: %2"

msgid "The device request failed (HTTP %1). Check that the server and device are available."
msgstr "기기 요청이 실패했습니다(HTTP %1). 서버와 기기를 확인하세요."

msgid "The device returned invalid XML."
msgstr "기기에서 잘못된 XML을 반환했습니다."

msgid "The media server address is invalid."
msgstr "미디어 서버 주소가 잘못되었습니다."

msgid "The selected device did not answer discovery. Refresh the list and try again."
msgstr "선택한 기기가 검색에 응답하지 않았습니다. 목록을 새로 고친 후 다시 시도하세요."

msgid "The server is off. Nothing is shared."
msgstr "서버가 꺼져 있습니다. 공유되는 항목이 없습니다."

msgid "The server is on. The folders below are visible to every device on your network."
msgstr "서버가 켜져 있습니다. 아래 폴더는 네트워크의 모든 기기에 보입니다."

msgid "This device does not support %1."
msgstr "이 기기는 %1을(를) 지원하지 않습니다."

msgid "This device is unavailable or blocked in UMS."
msgstr "기기를 사용할 수 없거나 UMS에서 차단되었습니다."

msgid "This file is not in a shared folder. Add its folder in Media Server settings and try again."
msgstr "이 파일은 공유 폴더에 없습니다. 미디어 서버 설정에서 폴더를 추가한 후 다시 시도하세요."

msgid "UMS cannot uniquely find this file for the selected device. Check its shared folders and media names."
msgstr "선택한 기기에 보낼 파일을 UMS에서 명확히 찾을 수 없습니다. 공유 폴더와 이름을 확인하세요."

msgid "UMS did not accept the sign-in."
msgstr "UMS에서 로그인을 거부했습니다."

msgid "UMS requires permission. Sign in and try again."
msgstr "UMS 권한이 필요합니다. 로그인 후 다시 시도하세요."

msgid "UMS returned an invalid response."
msgstr "UMS에서 잘못된 응답을 반환했습니다."

msgid "UMS web interface address"
msgstr "UMS 웹 인터페이스 주소"

msgid "Username:"
msgstr "사용자 이름:"

msgid "Volume must be between 0 and 100 percent."
msgstr "음량은 0~100퍼센트 사이여야 합니다."

msgid "Volume:"
msgstr "음량:"
