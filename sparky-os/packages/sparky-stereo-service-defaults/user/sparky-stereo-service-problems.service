[Unit]
Description=Sparky Stereo OS: show the services' kept problems
Documentation=file:///usr/share/doc/sparky-stereo-service-defaults/README.md
# people's sessions only: the login screen's accounts are system users
ConditionUser=!@system
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sparky-stereo-service-defaults notify
