+static void
+queue_page_flip (ply_renderer_backend_t *backend,
+                 ply_renderer_head_t    *head)
+{
+        uint32_t next_buffer_id;
+
+        if (!backend->is_active || head->flip_pending ||
+            head->second_buffer_id == 0 || head->shown_buffer_id == 0)
+                return;
+
+        next_buffer_id = head->shown_buffer_id == head->scan_out_buffer_id ?
+                         head->second_buffer_id : head->scan_out_buffer_id;
+
+        if (drmModePageFlip (backend->device_fd, head->controller_id, next_buffer_id,
+                             DRM_MODE_PAGE_FLIP_EVENT, head) < 0) {
+                ply_trace ("Couldn't flip to the other eye on controller %d: %m", head->controller_id);
+                return;
+        }
+
+        head->flip_pending = true;
+        head->shown_buffer_id = next_buffer_id;
+}
+
+static void
+on_page_flip (int          fd,
+              unsigned int sequence,
+              unsigned int tv_sec,
+              unsigned int tv_usec,
+              void        *user_data)
+{
+        ply_renderer_head_t *head = user_data;
+
+        head->flip_pending = false;
+        queue_page_flip (head->backend, head);
+}
+
+static void
+on_device_event (ply_renderer_backend_t *backend,
+                 int                     fd)
+{
+        drmEventContext context = {
+                .version           = 2,
+                .page_flip_handler = on_page_flip,
+        };
+
+        drmHandleEvent (fd, &context);
+}
