+/* A stereo theme draws both eyes side by side, so its head is twice an eye's width;
+ * a 2D output of a stereo boot then shows the left eye */
+static bool
+set_head_stereo_input (ply_renderer_backend_t *backend,
+                       ply_renderer_head_t    *head,
+                       bool                    stereo_input)
+{
+        unsigned long width;
+
+        if (head->backend != backend)
+                return false;
+
+        if (stereo_input && (backend->stereo_outputs_len == 0 ||
+                             head->rotation != PLY_PIXEL_BUFFER_ROTATE_UPRIGHT))
+                return false;
+
+        if (head->stereo_input == stereo_input)
+                return true;
+
+        width = stereo_input ? head->eye_width * 2 : head->eye_width;
+        ply_pixel_buffer_free (head->pixel_buffer);
+        head->pixel_buffer = ply_pixel_buffer_new_with_device_rotation (width, head->eye_height, head->rotation);
+        ply_pixel_buffer_set_device_scale (head->pixel_buffer, head->device_scale);
+        ply_pixel_buffer_fill_with_color (head->pixel_buffer, NULL, 0.0, 0.0, 0.0, 1.0);
+        ply_region_clear (ply_pixel_buffer_get_updated_areas (head->pixel_buffer));
+        head->area.width = width;
+        head->stereo_input = stereo_input;
+
+        ply_trace ("%ldx%ld renderer head: the theme draws %s", head->area.width, head->area.height,
+                   stereo_input ? "both eyes side by side" : "one picture");
+
+        return true;
 }
 
