+static const char *
+stereo_layout_name (ply_stereo_layout_t layout)
+{
+        size_t i;
+
+        for (i = 0; i < PLY_NUMBER_OF_ELEMENTS (stereo_layouts); i++) {
+                if (stereo_layouts[i].layout == layout)
+                        return stereo_layouts[i].name;
+        }
+
+        return "none";
+}
+
+static void
+parse_stereo_outputs (ply_renderer_backend_t *backend)
+{
+        char *value, *entry, *entry_state = NULL;
+
+        value = ply_kernel_command_line_get_key_value ("plymouth.stereo=");
+        if (value == NULL)
+                return;
+
+        for (entry = strtok_r (value, ",", &entry_state); entry != NULL; entry = strtok_r (NULL, ",", &entry_state)) {
+                ply_stereo_output_t output = { 0 };
+                char *field, *field_state = NULL;
+                unsigned int refresh;
+                size_t i;
+
+                field = strtok_r (entry, ":", &field_state);
+                if (field == NULL)
+                        continue;
+                output.connector_name = strdup (field);
+                output.iz3d_linear = true;
+
+                field = strtok_r (NULL, ":", &field_state);
+                for (i = 0; field != NULL && i < PLY_NUMBER_OF_ELEMENTS (stereo_layouts); i++) {
+                        if (strcmp (field, stereo_layouts[i].name) == 0) {
+                                output.layout = stereo_layouts[i].layout;
+                                output.drm_flag = stereo_layouts[i].drm_flag;
+                        }
+                }
+
+                if (output.layout == PLY_STEREO_LAYOUT_NONE) {
+                        ply_trace ("Unknown stereo layout '%s' for %s", field ? field : "", output.connector_name);
+                        free (output.connector_name);
+                        continue;
+                }
+
+                while ((field = strtok_r (NULL, ":", &field_state)) != NULL) {
+                        if (sscanf (field, "mode=%dx%d@%u", &output.mode_width, &output.mode_height, &refresh) == 3) {
+                                output.has_mode = true;
+                                output.mode_refresh = refresh;
+                        } else if (strcmp (field, "preferred") == 0) {
+                                output.mode_preferred = true;
+                        } else if (strcmp (field, "swap") == 0) {
+                                output.swap_eyes = true;
+                        } else if (strcmp (field, "hflip") == 0) {
+                                output.reflection = PLY_STEREO_REFLECTION_HORIZONTAL;
+                        } else if (strcmp (field, "vflip") == 0) {
+                                output.reflection = PLY_STEREO_REFLECTION_VERTICAL;
+                        } else if (sscanf (field, "formula=%d", &output.iz3d_formula) == 1) {
+                                if (output.iz3d_formula < 0 || output.iz3d_formula > 5)
+                                        output.iz3d_formula = 0;
+                        } else if (strcmp (field, "encoded") == 0) {
+                                output.iz3d_linear = false;
+                        } else if (strncmp (field, "card=", 5) == 0) {
+                                free (output.card_name);
+                                output.card_name = strdup (field + 5);
+                        } else {
+                                ply_trace ("Unknown stereo option '%s' for %s", field, output.connector_name);
+                        }
+                }
+
+                ply_trace ("Stereo output %s: %s%s", output.connector_name,
+                           stereo_layout_name (output.layout), output.swap_eyes ? ", eyes swapped" : "");
+
+                backend->stereo_outputs = realloc (backend->stereo_outputs,
+                                                   (backend->stereo_outputs_len + 1) * sizeof(ply_stereo_output_t));
+                backend->stereo_outputs[backend->stereo_outputs_len++] = output;
+        }
+
+        free (value);
+}
+
+static const ply_stereo_output_t *
+find_stereo_output (ply_renderer_backend_t *backend,
+                    drmModeConnector       *connector)
+{
+        const char *type_name, *device;
+        char name[64];
+        int i;
+
+        if (backend->stereo_outputs_len == 0)
+                return NULL;
+
+        type_name = drmModeGetConnectorTypeName (connector->connector_type);
+        if (type_name == NULL)
+                return NULL;
+
+        snprintf (name, sizeof(name), "%s-%u", type_name, connector->connector_type_id);
+        device = strrchr (backend->device_name, '/');
+        device = device != NULL ? device + 1 : backend->device_name;
+
+        for (i = 0; i < backend->stereo_outputs_len; i++) {
+                if (strcmp (backend->stereo_outputs[i].connector_name, name) != 0)
+                        continue;
+                if (backend->stereo_outputs[i].card_name != NULL &&
+                    strcmp (backend->stereo_outputs[i].card_name, device) != 0)
+                        continue;
+                return &backend->stereo_outputs[i];
+        }
+
+        return NULL;
+}
+
+/* The refresh rate of a mode in mHz the way KWin and Weston compute it, so that a mode asked
+ * for by its refresh rate is the one the compositor picks too */
+static uint32_t
+mode_refresh_rate (const drmModeModeInfo *mode)
+{
+        uint64_t refresh;
+
+        if (mode->htotal == 0 || mode->vtotal == 0)
+                return 0;
+
+        refresh = ((uint64_t) mode->clock * 1000000 / mode->htotal + mode->vtotal / 2) / mode->vtotal;
+        if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+                refresh *= 2;
+        if (mode->flags & DRM_MODE_FLAG_DBLSCAN)
+                refresh /= 2;
+        if (mode->vscan > 1)
+                refresh /= mode->vscan;
+
+        return refresh;
+}
+
+/* With mode=, the first mode of the connector's list with that size, refresh rate and 3D
+ * structure, as the compositor finds it; without, a mode of the 3D structure with the size
+ * of the 2D mode and the highest refresh rate. The 2D layouts keep the 2D mode unless one
+ * is asked for. */
+static drmModeModeInfo *
+find_stereo_mode (drmModeConnector          *connector,
+                  drmModeModeInfo           *mode_2d,
+                  const ply_stereo_output_t *stereo)
+{
+        drmModeModeInfo *best = NULL;
+        int i;
+
+        if (!stereo->has_mode && stereo->drm_flag == 0)
+                return mode_2d;
+
+        for (i = 0; i < connector->count_modes; i++) {
+                drmModeModeInfo *mode = &connector->modes[i];
+
+                if ((mode->flags & DRM_MODE_FLAG_3D_MASK) != stereo->drm_flag)
+                        continue;
+
+                if (stereo->has_mode) {
+                        if (mode->hdisplay != stereo->mode_width ||
+                            mode->vdisplay != stereo->mode_height ||
+                            mode_refresh_rate (mode) != stereo->mode_refresh)
+                                continue;
+                        if (stereo->drm_flag != 0 &&
+                            !!(mode->type & DRM_MODE_TYPE_PREFERRED) != stereo->mode_preferred)
+                                continue;
+                        best = mode;
+                        break;
+                }
+
+                if ((mode->flags & DRM_MODE_FLAG_INTERLACE) ||
+                    mode->hdisplay != mode_2d->hdisplay ||
+                    mode->vdisplay != mode_2d->vdisplay)
+                        continue;
+                if (best == NULL || mode_refresh_rate (mode) > mode_refresh_rate (best))
+                        best = mode;
+        }
+
+        if (best != NULL)
+                ply_trace ("Found mode %dx%d at %u mHz for stereo layout %s",
+                           best->hdisplay, best->vdisplay, mode_refresh_rate (best),
+                           stereo_layout_name (stereo->layout));
+        else
+                ply_trace ("No mode for stereo layout %s on %s",
+                           stereo_layout_name (stereo->layout), stereo->connector_name);
+
+        return best;
+}
+
+/* What a head shows: its stereo layout, or on a 2D output of a stereo boot the left eye */
+static ply_stereo_layout_t
+head_stereo_layout (ply_renderer_head_t *head)
+{
+        if (head->stereo_layout != PLY_STEREO_LAYOUT_NONE)
+                return head->stereo_layout;
+
+        if (head->stereo_input)
+                return PLY_STEREO_LAYOUT_LEFT_EYE;
+
+        return PLY_STEREO_LAYOUT_NONE;
+}
+
+static float srgb_to_linear[256];
+static uint8_t linear_to_srgb[4096];
+
+static void
+init_srgb_tables (void)
+{
+        static bool initialized;
+        int i;
+
+        if (initialized)
+                return;
+
+        for (i = 0; i < 256; i++) {
+                float value = i / 255.0f;
+
+                srgb_to_linear[i] = value <= 0.04045f ? value / 12.92f : powf ((value + 0.055f) / 1.055f, 2.4f);
+        }
+
+        for (i = 0; i < 4096; i++) {
+                float value = i / 4095.0f;
+
+                value = value <= 0.0031308f ? 12.92f * value : 1.055f * powf (value, 1.0f / 2.4f) - 0.055f;
+                linear_to_srgb[i] = (uint8_t) lrintf (value * 255.0f);
+        }
+
+        initialized = true;
+}
+
+static inline float
+channel_to_linear (uint32_t pixel,
+                   int      shift,
+                   bool     linear)
+{
+        uint32_t value = (pixel >> shift) & 0xff;
+
+        return linear ? srgb_to_linear[value] : value / 255.0f;
+}
+
+static inline uint32_t
+channel_from_linear (float value,
+                     int   shift,
+                     bool  linear)
+{
+        if (value < 0.0f)
+                value = 0.0f;
+        else if (value > 1.0f)
+                value = 1.0f;
+
+        if (linear)
+                return (uint32_t) linear_to_srgb[(int) lrintf (value * 4095.0f)] << shift;
+
+        return (uint32_t) lrintf (value * 255.0f) << shift;
+}
+
+static inline uint32_t
+average_pixels (uint32_t a,
+                uint32_t b)
+{
+        return (((a ^ b) & 0xfefefefeu) >> 1) + (a & b);
+}
+
+/* Eric Dubois's least-squares matrices for red/cyan glasses, the same KWin's anaglyph
+ * output uses: rows are the output's red, green and blue, columns the eye's */
+static const float dubois_modern[2][3][3] = {
+        { { 0.4154f, 0.4710f, 0.1669f }, { -0.0458f, -0.0484f, -0.0257f }, { -0.0547f, -0.0615f, 0.0128f } },
+        { { -0.0109f, -0.0364f, -0.0060f }, { 0.3756f, 0.7333f, 0.0111f }, { -0.0651f, -0.1287f, 1.2971f } },
+};
+
+static const float dubois_crt[2][3][3] = {
+        { { 0.456f, 0.500f, 0.176f }, { -0.040f, -0.038f, -0.016f }, { -0.015f, -0.021f, -0.005f } },
+        { { -0.043f, -0.088f, -0.002f }, { 0.378f, 0.734f, -0.018f }, { -0.072f, -0.113f, 1.226f } },
+};
+
+/* The theme's picture of one eye at x, y of the eye's area: a stereo theme draws the left
+ * eye in the left half and the right eye in the right half, any other theme one picture
+ * that both eyes get */
+static inline uint32_t
+eye_pixel (ply_renderer_head_t *head,
+           const uint32_t      *shadow,
+           int                  eye,
+           long                 x,
+           long                 y)
+{
+        if (head->stereo != NULL && head->stereo->swap_eyes)
+                eye = !eye;
+
+        if (!head->stereo_input)
+                eye = 0;
+
+        return shadow[y * head->area.width + eye * head->eye_width + x];
+}
+
+static inline void
+put_pixel (char         *map_address,
+           unsigned long row_stride,
+           unsigned long x,
+           unsigned long y,
+           uint32_t      pixel)
+{
+        *(uint32_t *) &map_address[y * row_stride + x * BYTES_PER_PIXEL] = pixel;
+}
+
+static uint32_t
+mix_anaglyph (const float matrix[2][3][3],
+              uint32_t    left,
+              uint32_t    right)
+{
+        float eyes[2][3], out;
+        uint32_t pixel = 0xff000000;
+        int channel, k;
+
+        for (k = 0; k < 3; k++) {
+                eyes[0][k] = channel_to_linear (left, 16 - 8 * k, true);
+                eyes[1][k] = channel_to_linear (right, 16 - 8 * k, true);
+        }
+
+        for (channel = 0; channel < 3; channel++) {
+                out = 0.0f;
+                for (k = 0; k < 3; k++)
+                        out += matrix[0][channel][k] * eyes[0][k] + matrix[1][channel][k] * eyes[1][k];
+                pixel |= channel_from_linear (out, 16 - 8 * channel, true);
+        }
+
+        return pixel;
+}
+
+/* iZ3D's analytic panel formulas, as KWin's iZ3D output and effcol's wiz3D have them:
+ * the back panel shows the picture, the front panel's polarisation sends it to the eyes */
+static uint32_t
+mix_iz3d (ply_renderer_head_t *head,
+          const uint32_t      *shadow,
+          long                 x,
+          long                 y)
+{
+        int formula = head->stereo->iz3d_formula;
+        bool linear = head->stereo->iz3d_linear;
+        bool front_panel = head->stereo_layout == PLY_STEREO_LAYOUT_IZ3D_FRONT;
+        float left[3], right[3], sum[3], back[3], front[3];
+        uint32_t pixel = 0xff000000;
+        int k;
+
+        if (formula >= 4) {
+                bool right_eye = ((formula == 4 ? y : x + y) % 2) != 0;
+                long w = head->eye_width, h = head->eye_height;
+
+                if (front_panel)
+                        return right_eye ? 0xff000000 : 0xffffffff;
+
+                for (k = 0; k < 3; k++)
+                        back[k] = channel_to_linear (eye_pixel (head, shadow, right_eye, x, y), 16 - 8 * k, linear);
+
+                if (formula == 4) {
+                        long other = ((y + (right_eye ? -1 : 1)) % h + h) % h;
+
+                        for (k = 0; k < 3; k++)
+                                back[k] = (back[k] + channel_to_linear (eye_pixel (head, shadow, right_eye, x % w, other), 16 - 8 * k, linear)) * 0.5f;
+                }
+
+                for (k = 0; k < 3; k++)
+                        pixel |= channel_from_linear (back[k], 16 - 8 * k, linear);
+
+                return pixel;
+        }
+
+        for (k = 0; k < 3; k++) {
+                left[k] = channel_to_linear (eye_pixel (head, shadow, 0, x, y), 16 - 8 * k, linear);
+                right[k] = channel_to_linear (eye_pixel (head, shadow, 1, x, y), 16 - 8 * k, linear);
+        }
+
+        if (formula == 2) {
+                float grey_left = 0.2989f * left[0] + 0.5870f * left[1] + 0.1140f * left[2];
+                float grey_right = 0.2989f * right[0] + 0.5870f * right[1] + 0.1140f * right[2];
+
+                for (k = 0; k < 3; k++) {
+                        left[k] = grey_left;
+                        right[k] = grey_right;
+                }
+        }
+
+        for (k = 0; k < 3; k++) {
+                sum[k] = left[k] + right[k];
+                back[k] = sum[k] * 0.5f;
+                front[k] = 0.5f;
+        }
+
+        if (formula == 0) {
+                float threshold = linear ? 0.0000000001f : 0.000001f;
+
+                for (k = 0; k < 3; k++) {
+                        if (sum[k] >= threshold)
+                                front[k] = right[k] / sum[k];
+                }
+        } else {
+                float total = sum[0] + sum[1] + sum[2];
+                float modulation = total >= 0.01f ? (right[0] + right[1] + right[2]) / total : 0.5f;
+
+                for (k = 0; k < 3; k++) {
+                        front[k] = modulation;
+                        if (formula == 3) {
+                                back[k] = sum[k] * (1.0f - modulation);
+                                front[k] = sum[k] * modulation;
+                        }
+                }
+        }
+
+        for (k = 0; k < 3; k++)
+                pixel |= channel_from_linear (front_panel ? front[k] : back[k], 16 - 8 * k, linear);
+
+        return pixel;
+}
+
+/* Draws the eyes at the rectangle x0, y0 to x1, y1 of the eye's area into the scan out buffer,
+ * in the layout of the head: frame packing puts the second eye at line vtotal (the active
+ * space between the eyes stays black), the half layouts average two pixels or two rows, the
+ * spatial patterns and frame-sequential pick an eye per pixel or per refresh */
+static void
+flush_stereo_rectangle (ply_renderer_head_t *head,
+                        const uint32_t      *shadow,
+                        long                 x0,
+                        long                 y0,
+                        long                 x1,
+                        long                 y1,
+                        char                *map_address,
+                        char                *second_map_address)
+{
+        unsigned long stride = head->row_stride;
+        long w = head->eye_width, h = head->eye_height;
+        long x, y;
+        int eye;
+
+        switch (head_stereo_layout (head)) {
+        case PLY_STEREO_LAYOUT_FRAME_PACKING:
+        case PLY_STEREO_LAYOUT_SIDE_BY_SIDE_FULL:
+                for (eye = 0; eye < 2; eye++) {
+                        long dx = head->stereo_layout == PLY_STEREO_LAYOUT_SIDE_BY_SIDE_FULL ? eye * w : 0;
+                        long dy = head->stereo_layout == PLY_STEREO_LAYOUT_FRAME_PACKING ? eye * (long) head->eye_stride_lines : 0;
+
+                        for (y = y0; y < y1; y++)
+                                for (x = x0; x < x1; x++)
+                                        put_pixel (map_address, stride, x + dx, y + dy, eye_pixel (head, shadow, eye, x, y));
+                }
+                break;
+        case PLY_STEREO_LAYOUT_SIDE_BY_SIDE_HALF:
+        case PLY_STEREO_LAYOUT_SIDE_BY_SIDE_HALF_2D:
+                x0 &= ~1L;
+                for (eye = 0; eye < 2; eye++)
+                        for (y = y0; y < y1; y++)
+                                for (x = x0; x + 1 < w && x < x1; x += 2)
+                                        put_pixel (map_address, stride, eye * (w / 2) + x / 2, y,
+                                                   average_pixels (eye_pixel (head, shadow, eye, x, y),
+                                                                   eye_pixel (head, shadow, eye, x + 1, y)));
+                break;
+        case PLY_STEREO_LAYOUT_TOP_AND_BOTTOM:
+        case PLY_STEREO_LAYOUT_TOP_AND_BOTTOM_2D:
+                y0 &= ~1L;
+                for (eye = 0; eye < 2; eye++)
+                        for (y = y0; y + 1 < h && y < y1; y += 2)
+                                for (x = x0; x < x1; x++)
+                                        put_pixel (map_address, stride, x, eye * (h / 2) + y / 2,
+                                                   average_pixels (eye_pixel (head, shadow, eye, x, y),
+                                                                   eye_pixel (head, shadow, eye, x, y + 1)));
+                break;
+        case PLY_STEREO_LAYOUT_ROWS:
+        case PLY_STEREO_LAYOUT_COLUMNS:
+        case PLY_STEREO_LAYOUT_CHECKERBOARD:
+                for (y = y0; y < y1; y++) {
+                        for (x = x0; x < x1; x++) {
+                                if (head->stereo_layout == PLY_STEREO_LAYOUT_ROWS)
+                                        eye = y & 1;
+                                else if (head->stereo_layout == PLY_STEREO_LAYOUT_COLUMNS)
+                                        eye = x & 1;
+                                else
+                                        eye = (x + y) & 1;
+                                put_pixel (map_address, stride, x, y, eye_pixel (head, shadow, eye, x, y));
+                        }
+                }
+                break;
+        case PLY_STEREO_LAYOUT_ANAGLYPH_MODERN:
+        case PLY_STEREO_LAYOUT_ANAGLYPH_CRT:
+                init_srgb_tables ();
+                for (y = y0; y < y1; y++)
+                        for (x = x0; x < x1; x++)
+                                put_pixel (map_address, stride, x, y,
+                                           mix_anaglyph (head->stereo_layout == PLY_STEREO_LAYOUT_ANAGLYPH_MODERN ? dubois_modern : dubois_crt,
+                                                         eye_pixel (head, shadow, 0, x, y),
+                                                         eye_pixel (head, shadow, 1, x, y)));
+                break;
+        case PLY_STEREO_LAYOUT_SEQUENTIAL:
+                for (y = y0; y < y1; y++) {
+                        for (x = x0; x < x1; x++) {
+                                put_pixel (map_address, stride, x, y, eye_pixel (head, shadow, 0, x, y));
+                                if (second_map_address != NULL)
+                                        put_pixel (second_map_address, head->second_row_stride, x, y, eye_pixel (head, shadow, 1, x, y));
+                        }
+                }
+                break;
+        case PLY_STEREO_LAYOUT_LEFT_EYE:
+        case PLY_STEREO_LAYOUT_RIGHT_EYE:
+                eye = head_stereo_layout (head) == PLY_STEREO_LAYOUT_RIGHT_EYE;
+                for (y = y0; y < y1; y++) {
+                        for (x = x0; x < x1; x++) {
+                                long dx = x, dy = y;
+
+                                if (head->stereo != NULL && head->stereo->reflection == PLY_STEREO_REFLECTION_HORIZONTAL)
+                                        dx = w - 1 - x;
+                                else if (head->stereo != NULL && head->stereo->reflection == PLY_STEREO_REFLECTION_VERTICAL)
+                                        dy = h - 1 - y;
+                                put_pixel (map_address, stride, dx, dy, eye_pixel (head, shadow, eye, x, y));
+                        }
+                }
+                break;
+        case PLY_STEREO_LAYOUT_IZ3D_BACK:
+        case PLY_STEREO_LAYOUT_IZ3D_FRONT:
+                init_srgb_tables ();
+                if (head->stereo->iz3d_formula == 4) {
+                        y0 = y0 > 0 ? y0 - 1 : 0;
+                        y1 = y1 < h ? y1 + 1 : h;
+                }
+                for (y = y0; y < y1; y++)
+                        for (x = x0; x < x1; x++)
+                                put_pixel (map_address, stride, x, y, mix_iz3d (head, shadow, x, y));
+                break;
+        case PLY_STEREO_LAYOUT_NONE:
+                break;
+        }
+}
+
+static void
+ply_renderer_head_flush_stereo_area (ply_renderer_head_t *head,
+                                     ply_rectangle_t     *area_to_flush,
+                                     char                *map_address,
+                                     char                *second_map_address)
+{
+        const uint32_t *shadow = ply_pixel_buffer_get_argb32_data (head->pixel_buffer);
+        long x0 = area_to_flush->x, x1 = area_to_flush->x + area_to_flush->width;
+        long y0 = area_to_flush->y, y1 = area_to_flush->y + area_to_flush->height;
+        long w = head->eye_width;
+
+        /* a rectangle of the stereo theme's picture is redrawn at its place in both eyes */
+        if (head->stereo_input && x0 >= w) {
+                x0 -= w;
+                x1 -= w;
+        } else if (head->stereo_input && x1 > w) {
+                x0 = 0;
+                x1 = w;
+        }
+
+        if (x1 > w)
+                x1 = w;
+        if (y1 > (long) head->eye_height)
+                y1 = head->eye_height;
+
+        flush_stereo_rectangle (head, shadow, x0, y0, x1, y1, map_address, second_map_address);
+}
