+        ply_stereo_layout_t         stereo_layout;
 } ply_output_t;
 
 struct _ply_renderer_backend
@@ -159,6 +254,10 @@ struct _ply_renderer_backend
         int32_t                     dither_green;
         int32_t                     dither_blue;
 
+        ply_stereo_output_t        *stereo_outputs;
