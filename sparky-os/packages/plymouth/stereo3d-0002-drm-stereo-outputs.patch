+/* How an output shows the two eyes, asked for per connector with plymouth.stereo=.
+ * The first four are HDMI 3D structures, carried by the mode itself; the others
+ * draw both eyes into an ordinary 2D mode. */
+typedef enum
+{
+        PLY_STEREO_LAYOUT_NONE = 0,
+        PLY_STEREO_LAYOUT_FRAME_PACKING,
+        PLY_STEREO_LAYOUT_SIDE_BY_SIDE_FULL,
+        PLY_STEREO_LAYOUT_SIDE_BY_SIDE_HALF,
+        PLY_STEREO_LAYOUT_TOP_AND_BOTTOM,
+        PLY_STEREO_LAYOUT_SIDE_BY_SIDE_HALF_2D,
+        PLY_STEREO_LAYOUT_TOP_AND_BOTTOM_2D,
+        PLY_STEREO_LAYOUT_ANAGLYPH_MODERN,
+        PLY_STEREO_LAYOUT_ANAGLYPH_CRT,
+        PLY_STEREO_LAYOUT_ROWS,
+        PLY_STEREO_LAYOUT_COLUMNS,
+        PLY_STEREO_LAYOUT_CHECKERBOARD,
+        PLY_STEREO_LAYOUT_SEQUENTIAL,
+        PLY_STEREO_LAYOUT_LEFT_EYE,
+        PLY_STEREO_LAYOUT_RIGHT_EYE,
+        PLY_STEREO_LAYOUT_IZ3D_BACK,
+        PLY_STEREO_LAYOUT_IZ3D_FRONT,
+} ply_stereo_layout_t;
+
+static const struct
+{
+        const char         *name;
+        ply_stereo_layout_t layout;
+        uint32_t            drm_flag;
+} stereo_layouts[] = {
+        { "frame-packing",     PLY_STEREO_LAYOUT_FRAME_PACKING,      DRM_MODE_FLAG_3D_FRAME_PACKING      },
+        { "sbs-full",          PLY_STEREO_LAYOUT_SIDE_BY_SIDE_FULL,  DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL  },
+        { "sbs-half",          PLY_STEREO_LAYOUT_SIDE_BY_SIDE_HALF,  DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF  },
+        { "tab",               PLY_STEREO_LAYOUT_TOP_AND_BOTTOM,     DRM_MODE_FLAG_3D_TOP_AND_BOTTOM     },
+        { "sbs-half-2d",       PLY_STEREO_LAYOUT_SIDE_BY_SIDE_HALF_2D, 0                                 },
+        { "tab-2d",            PLY_STEREO_LAYOUT_TOP_AND_BOTTOM_2D,  0                                   },
+        { "anaglyph-modern",   PLY_STEREO_LAYOUT_ANAGLYPH_MODERN,    0                                   },
+        { "anaglyph-crt",      PLY_STEREO_LAYOUT_ANAGLYPH_CRT,       0                                   },
+        { "rows",              PLY_STEREO_LAYOUT_ROWS,               0                                   },
+        { "columns",           PLY_STEREO_LAYOUT_COLUMNS,            0                                   },
+        { "checkerboard",      PLY_STEREO_LAYOUT_CHECKERBOARD,       0                                   },
+        { "sequential",        PLY_STEREO_LAYOUT_SEQUENTIAL,         0                                   },
+        { "left",              PLY_STEREO_LAYOUT_LEFT_EYE,           0                                   },
+        { "right",             PLY_STEREO_LAYOUT_RIGHT_EYE,          0                                   },
+        { "iz3d-back",         PLY_STEREO_LAYOUT_IZ3D_BACK,          0                                   },
+        { "iz3d-front",        PLY_STEREO_LAYOUT_IZ3D_FRONT,         0                                   },
+};
+
+typedef enum
+{
+        PLY_STEREO_REFLECTION_NONE = 0,
+        PLY_STEREO_REFLECTION_HORIZONTAL,
+        PLY_STEREO_REFLECTION_VERTICAL,
+} ply_stereo_reflection_t;
+
+/* One output of plymouth.stereo=CONNECTOR:LAYOUT[:OPTION...][,CONNECTOR:LAYOUT...] */
+typedef struct
+{
+        char                   *connector_name;
+        char                   *card_name;      /* card=: the device, when two GPUs have a connector of that name */
+        ply_stereo_layout_t     layout;
+        uint32_t                drm_flag;
+        bool                    has_mode;
+        int                     mode_width;
+        int                     mode_height;
+        uint32_t                mode_refresh;   /* mHz */
+        bool                    mode_preferred;
+        bool                    swap_eyes;
+        ply_stereo_reflection_t reflection;
+        int                     iz3d_formula;
+        bool                    iz3d_linear;
+} ply_stereo_output_t;
+
