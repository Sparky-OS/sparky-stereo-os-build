+        ply_fd_watch_t             *device_watch;
+
         uint32_t                    is_active : 1;
         uint32_t                    requires_explicit_flushing : 1;
         uint32_t                    input_source_is_open : 1;
@@ -178,6 +277,562 @@ static bool open_input_source (ply_renderer_backend_t      *backend,
