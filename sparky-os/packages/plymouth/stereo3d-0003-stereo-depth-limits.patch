 bool ply_pixel_display_set_stereo_input (ply_pixel_display_t *display,
                                          bool                 stereo_input);
 bool ply_pixel_display_get_stereo_input (ply_pixel_display_t *display);
+bool ply_pixel_display_get_stereo_depth_limits (ply_pixel_display_t *display,
+                                                double              *popped_px,
