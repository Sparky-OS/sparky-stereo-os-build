diff --git a/src/libply-splash-core/ply-renderer.c b/src/libply-splash-core/ply-renderer.c
index 5952284..8497335 100644
--- a/src/libply-splash-core/ply-renderer.c
+++ b/src/libply-splash-core/ply-renderer.c
@@ -384,6 +384,30 @@ ply_renderer_set_head_stereo_input (ply_renderer_t      *renderer,
                                                                   stereo_input);
 }
 
+/* The depth limits the person set for this output, pixels of an eye 1920 wide (the unit of the
+ * desktop's own limits); false when the display's default stands in for them */
+bool
+ply_renderer_get_head_stereo_depth_limits (ply_renderer_t      *renderer,
+                                           ply_renderer_head_t *head,
+                                           double              *popped_px,
+                                           double              *sunk_px)
+{
+        assert (renderer != NULL);
+        assert (renderer->plugin_interface != NULL);
+        assert (head != NULL);
+
+        if (renderer->plugin_interface->get_head_stereo_depth_limits == NULL) {
+                *popped_px = 4.0;
+                *sunk_px = 10.0;
+                return false;
+        }
+
+        return renderer->plugin_interface->get_head_stereo_depth_limits (renderer->backend,
+                                                                         head,
+                                                                         popped_px,
+                                                                         sunk_px);
+}
+
 void
 ply_renderer_flush_head (ply_renderer_t      *renderer,
                          ply_renderer_head_t *head)
diff --git a/src/libply-splash-core/ply-renderer.h b/src/libply-splash-core/ply-renderer.h
index cf83db9..e9d1c9a 100644
--- a/src/libply-splash-core/ply-renderer.h
+++ b/src/libply-splash-core/ply-renderer.h
@@ -73,6 +73,10 @@ ply_pixel_buffer_t *ply_renderer_get_buffer_for_head (ply_renderer_t      *rende
 bool ply_renderer_set_head_stereo_input (ply_renderer_t      *renderer,
                                          ply_renderer_head_t *head,
                                          bool                 stereo_input);
+bool ply_renderer_get_head_stereo_depth_limits (ply_renderer_t      *renderer,
+                                                ply_renderer_head_t *head,
