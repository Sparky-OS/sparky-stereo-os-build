--- a/src/libply-splash-core/ply-pixel-display.c
+++ b/src/libply-splash-core/ply-pixel-display.c
@@ -142,6 +142,16 @@ ply_pixel_display_get_stereo_input (ply_pixel_display_t *display)
         return display->stereo_input;
 }
 
+/* How far the theme may pop and sink on this display, pixels of an eye 1920 wide: the person's limits
+ * when plymouth.stereo= carries them, the display's default otherwise (false) */
+bool
+ply_pixel_display_get_stereo_depth_limits (ply_pixel_display_t *display,
+                                           double              *popped_px,
+                                           double              *sunk_px)
+{
+        return ply_renderer_get_head_stereo_depth_limits (display->renderer, display->head, popped_px, sunk_px);
+}
+
 static void
 ply_pixel_display_flush (ply_pixel_display_t *display)
 {
