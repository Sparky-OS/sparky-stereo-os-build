 src/libply-splash-core/ply-pixel-display.c    | 10 +++
 src/libply-splash-core/ply-pixel-display.h    |  3 +
 src/libply-splash-core/ply-renderer-plugin.h  |  4 ++
 src/libply-splash-core/ply-renderer.c         | 24 +++++++
 src/libply-splash-core/ply-renderer.h         |  4 ++
 src/plugins/renderers/drm/plugin.c            | 62 +++++++++++++++++
 src/plugins/splash/script/script-lib-sprite.c | 66 +++++++++++++++++++
 7 files changed, 173 insertions(+)

