+++ b/src/libply-splash-core/ply-renderer-plugin.h
@@ -87,6 +87,10 @@ typedef struct
         bool (*set_head_stereo_input)(ply_renderer_backend_t *backend,
                                       ply_renderer_head_t    *head,
                                       bool                    stereo_input);
+        bool (*get_head_stereo_depth_limits)(ply_renderer_backend_t *backend,
+                                             ply_renderer_head_t    *head,
+                                             double                 *popped_px,
+                                             double                 *sunk_px);
 } ply_renderer_plugin_interface_t;
 
