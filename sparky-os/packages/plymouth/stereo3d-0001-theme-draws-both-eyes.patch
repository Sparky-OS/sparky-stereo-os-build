 }
 
+bool
+ply_renderer_set_head_stereo_input (ply_renderer_t      *renderer,
+                                    ply_renderer_head_t *head,
+                                    bool                 stereo_input)
+{
+        assert (renderer != NULL);
+        assert (renderer->plugin_interface != NULL);
+        assert (head != NULL);
+
+        if (renderer->plugin_interface->set_head_stereo_input == NULL)
+                return !stereo_input;
+
+        return renderer->plugin_interface->set_head_stereo_input (renderer->backend,
+                                                                  head,
+                                                                  stereo_input);
+}
+
 void
 ply_renderer_flush_head (ply_renderer_t      *renderer,
                          ply_renderer_head_t *head)
