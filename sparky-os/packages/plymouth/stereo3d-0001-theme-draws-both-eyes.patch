 src/libply-splash-core/ply-pixel-display.c    | 30 ++++++++++++++
 src/libply-splash-core/ply-pixel-display.h    |  3 ++
 src/libply-splash-core/ply-renderer-plugin.h  |  3 ++
 src/libply-splash-core/ply-renderer.c         | 17 ++++++++
 src/libply-splash-core/ply-renderer.h         |  3 ++
