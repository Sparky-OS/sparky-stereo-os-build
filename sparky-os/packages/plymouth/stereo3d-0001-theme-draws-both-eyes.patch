@@ -27,6 +27,7 @@
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <sys/socket.h>
 #include <sys/types.h>
 #include <unistd.h>
@@ -75,6 +76,7 @@ struct _ply_boot_splash
 
         uint32_t                                  is_loaded : 1;
         uint32_t                                  is_shown : 1;
+        uint32_t                                  stereo_input : 1;
         uint32_t                                  should_force_text_mode : 1;
 };
 
@@ -136,6 +138,9 @@ ply_boot_splash_add_pixel_display (ply_boot_splash_t   *splash,
         if (splash->plugin_interface->add_pixel_display == NULL)
                 return;
 
+        if (!ply_pixel_display_set_stereo_input (display, splash->stereo_input))
+                ply_trace ("display takes one picture, the theme draws it once");
+
         width = ply_pixel_display_get_width (display);
         height = ply_pixel_display_get_height (display);
 
@@ -216,6 +221,7 @@ ply_boot_splash_load (ply_boot_splash_t *splash)
         ply_key_file_t *key_file;
         char *module_name;
         char *module_path;
+        char *stereo;
 
         assert (splash != NULL);
 
@@ -230,6 +236,11 @@ ply_boot_splash_load (ply_boot_splash_t *splash)
 
         module_name = ply_key_file_get_value (key_file, "Plymouth Theme", "ModuleName");
 
+        /* Stereo=full-side-by-side: the theme draws both eyes, the left eye in the left half */
+        stereo = ply_key_file_get_value (key_file, "Plymouth Theme", "Stereo");
+        splash->stereo_input = stereo != NULL && strcmp (stereo, "full-side-by-side") == 0;
+        free (stereo);
+
         asprintf (&module_path, "%s%s.so",
                   splash->plugin_dir, module_name);
         free (module_name);
diff --git a/src/libply-splash-core/ply-pixel-display.c b/src/libply-splash-core/ply-pixel-display.c
index 6239803..6e6b8eb 100644
--- a/src/libply-splash-core/ply-pixel-display.c
+++ b/src/libply-splash-core/ply-pixel-display.c
@@ -51,6 +51,7 @@ struct _ply_pixel_display
         unsigned long                    width;
         unsigned long                    height;
         int                              device_scale;
+        bool                             stereo_input;
 
         ply_pixel_display_draw_handler_t draw_handler;
         void                            *draw_handler_user_data;
@@ -112,6 +113,35 @@ ply_pixel_display_get_device_scale (ply_pixel_display_t *display)
         return display->device_scale;
 }
 
+/* A stereo theme draws both eyes side by side, the left eye first, at full size each:
+ * the display is then twice as wide as one eye. Returns false where the output cannot
+ * take it, and the theme draws one picture. */
+bool
+ply_pixel_display_set_stereo_input (ply_pixel_display_t *display,
+                                    bool                 stereo_input)
+{
+        ply_pixel_buffer_t *pixel_buffer;
+        ply_rectangle_t size;
+
+        if (!ply_renderer_set_head_stereo_input (display->renderer, display->head, stereo_input))
+                return false;
+
+        pixel_buffer = ply_renderer_get_buffer_for_head (display->renderer, display->head);
+        ply_pixel_buffer_get_size (pixel_buffer, &size);
+
+        display->width = size.width;
+        display->height = size.height;
+        display->stereo_input = stereo_input;
+
+        return true;
+}
+
+bool
+ply_pixel_display_get_stereo_input (ply_pixel_display_t *display)
+{
+        return display->stereo_input;
+}
+
 static void
 ply_pixel_display_flush (ply_pixel_display_t *display)
 {
