+/* Whether the head is the main screen of a stereo boot, the first one plymouth.stereo= names: the splash's eye is
+ * its size */
+bool
+ply_renderer_get_head_stereo_main (ply_renderer_t      *renderer,
+                                   ply_renderer_head_t *head)
+{
+        assert (renderer != NULL);
+        assert (renderer->plugin_interface != NULL);
