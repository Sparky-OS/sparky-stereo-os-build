 }
 
+/* Fills the part of fill_area that lies outside inner_area with inner_area's own edge: each pixel takes the value of the
+ * nearest pixel of inner_area, so the picture inside continues to the buffer's edges with no frame of another colour.
+ * Nothing inside inner_area changes. */
+void
+ply_pixel_buffer_fill_with_edges_of_area (ply_pixel_buffer_t *buffer,
+                                          ply_rectangle_t    *inner_area,
+                                          ply_rectangle_t    *fill_area)
+{
+        ply_rectangle_t cropped_area, inner;
+        long row, column, x, y;
+
+        assert (buffer != NULL);
+        assert (inner_area != NULL);
+
+        if (fill_area == NULL)
+                fill_area = &buffer->logical_area;
+
+        ply_pixel_buffer_crop_area_to_clip_area (buffer, fill_area, &cropped_area);
+        inner = *inner_area;
+        ply_pixel_buffer_adjust_area_for_device_scale (buffer, &inner);
+        ply_rectangle_intersect (&inner, &buffer->area, &inner);
+        if (inner.width == 0 || inner.height == 0 || cropped_area.width == 0 || cropped_area.height == 0)
+                return;
+
+        for (row = cropped_area.y; row < cropped_area.y + (long) cropped_area.height; row++) {
+                y = CLAMP (row, inner.y, inner.y + (long) inner.height - 1);
+                for (column = cropped_area.x; column < cropped_area.x + (long) cropped_area.width; column++) {
+                        if (row == y && column >= inner.x && column < inner.x + (long) inner.width)
+                                continue;
+                        x = CLAMP (column, inner.x, inner.x + (long) inner.width - 1);
+                        ply_pixel_buffer_set_pixel (buffer, column, row, ply_pixel_buffer_get_pixel (buffer, x, y));
+                }
+        }
+
+        ply_pixel_buffer_add_updated_area (buffer, &cropped_area);
+}
+
 void
 ply_pixel_buffer_fill_with_hex_color_at_opacity (ply_pixel_buffer_t *buffer,
                                                  ply_rectangle_t    *fill_area,
