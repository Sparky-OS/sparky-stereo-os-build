<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Sparky Stereo OS</vendor>
  <vendor_url>https://sparkylinux.org</vendor_url>
  <action id="org.sparky.stereo.phonecamera.run">
    <description>Load or remove the virtual camera for a phone session</description>
    <description xml:lang="pl">Załaduj lub usuń kamerę wirtualną na czas sesji telefonu</description>
    <description xml:lang="pt_BR">Carregar ou remover a câmera virtual para uma sessão do celular</description>
    <description xml:lang="fr">Charger ou retirer la caméra virtuelle pour une session de téléphone</description>
    <description xml:lang="de">Die virtuelle Kamera für eine Handy-Sitzung laden oder entfernen</description>
    <description xml:lang="es">Cargar o quitar la cámara virtual para una sesión del teléfono</description>
    <description xml:lang="ja">スマートフォンのセッションのために仮想カメラを読み込む／取り外す</description>
    <description xml:lang="ko">휴대폰 세션을 위해 가상 카메라 로드 또는 제거</description>
    <description xml:lang="zh_CN">为手机会话加载或移除虚拟摄像头</description>
    <description xml:lang="zh_TW">為手機工作階段載入或移除虛擬攝影機</description>
    <message>Authentication is required to load or remove the virtual camera</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby załadować lub usunąć kamerę wirtualną</message>
    <message xml:lang="pt_BR">É preciso autenticação para carregar ou remover a câmera virtual</message>
    <message xml:lang="fr">Une authentification est requise pour charger ou retirer la caméra virtuelle</message>
    <message xml:lang="de">Zum Laden oder Entfernen der virtuellen Kamera ist eine Authentifizierung nötig</message>
    <message xml:lang="es">Se requiere autenticación para cargar o quitar la cámara virtual</message>
    <message xml:lang="ja">仮想カメラを読み込む／取り外すには認証が必要です</message>
    <message xml:lang="ko">가상 카메라를 로드하거나 제거하려면 인증이 필요합니다</message>
    <message xml:lang="zh_CN">加载或移除虚拟摄像头需要认证</message>
    <message xml:lang="zh_TW">載入或移除虛擬攝影機需要驗證</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/sparky-stereo-phone-camera/sparky-phone-camera-helper</annotate>
  </action>
</policyconfig>
