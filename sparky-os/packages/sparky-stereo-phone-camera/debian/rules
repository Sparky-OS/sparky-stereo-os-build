#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	install -D -m 0755 bin/sparky-phone-camera debian/sparky-stereo-phone-camera/usr/bin/sparky-phone-camera
	install -d debian/sparky-stereo-phone-camera/usr/share/sparky-stereo-phone-camera/lang
	install -m 0644 lang/*.json debian/sparky-stereo-phone-camera/usr/share/sparky-stereo-phone-camera/lang/
	install -D -m 0644 data/sparky-stereo-phone-camera.conf debian/sparky-stereo-phone-camera/etc/modprobe.d/sparky-stereo-phone-camera.conf
	install -D -m 0644 data/modules-load.conf debian/sparky-stereo-phone-camera/usr/lib/modules-load.d/sparky-stereo-phone-camera.conf
	install -D -m 0644 data/sparky-stereo-phone-camera-droidcam.desktop debian/sparky-stereo-phone-camera/usr/share/applications/sparky-stereo-phone-camera-droidcam.desktop
	install -D -m 0644 data/sparky-stereo-phone-camera-scrcpy.desktop debian/sparky-stereo-phone-camera/usr/share/applications/sparky-stereo-phone-camera-scrcpy.desktop
	install -D -m 0644 man/sparky-phone-camera.1 debian/sparky-stereo-phone-camera/usr/share/man/man1/sparky-phone-camera.1

override_dh_auto_build:
	python3 -I -m py_compile bin/sparky-phone-camera
	rm -rf bin/__pycache__

override_dh_python3:
