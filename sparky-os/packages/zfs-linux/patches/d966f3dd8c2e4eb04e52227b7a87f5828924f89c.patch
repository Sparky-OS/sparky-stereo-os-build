From d966f3dd8c2e4eb04e52227b7a87f5828924f89c Mon Sep 17 00:00:00 2001
From: Rob Norris <rob.norris@truenas.com>
Date: Sat, 15 Aug 2026 12:58:45 +1000
Subject: [PATCH] Linux 7.3: bvec_iter.bi_bvec_done is now bi_offset

Sponsored-by: TrueNAS
Reviewed-by: Brian Behlendorf <behlendorf1@llnl.gov>
Reviewed-by: Tony Hutter <hutter2@llnl.gov>
Co-developed-by: TheAlmightyOgreLord <beardedtechwizard@protonmail.com>
Signed-off-by: Rob Norris <rob.norris@truenas.com>
Closes #19082

Description: Linux 7.3: bvec_iter.bi_bvec_done is now bi_offset
 Unchanged upstream logic; refreshed against Debian 2.4.4.
Origin: upstream, https://github.com/openzfs/zfs/commit/d966f3dd8c2e4eb04e52227b7a87f5828924f89c
Author: Rob Norris
Applied-Upstream: commit:d966f3dd8c2e4eb04e52227b7a87f5828924f89c
Last-Update: 2026-11-02

--- a/config/kernel-bio.m4
+++ b/config/kernel-bio.m4
@@ -229,6 +229,30 @@
 	ZFS_LINUX_TEST_RESULT([bio_alloc_4arg],[
 		AC_MSG_RESULT(yes)
 		AC_DEFINE([HAVE_BIO_ALLOC_4ARG], 1, [bio_alloc() takes 4 arguments])
+	],[
+		AC_MSG_RESULT(no)
+	])
+])
+
+dnl #
+dnl # Linux 7.3 API
+dnl #
+dnl # bi_iter.bi_bvec_done renamed to bi_iter.bi_offset
+dnl #
+AC_DEFUN([ZFS_AC_KERNEL_SRC_BVEC_ITER_OFFSET], [
+	ZFS_LINUX_TEST_SRC([bvec_iter_offset], [
+		#include <linux/bio.h>
+	],[
+		struct bvec_iter *bi = NULL;
+		unsigned int __attribute__((unused)) offset = bi->bi_offset;
+	])
+])
+
+AC_DEFUN([ZFS_AC_KERNEL_BVEC_ITER_OFFSET], [
+	AC_MSG_CHECKING([if bvec_iter has bi_offset])
+	ZFS_LINUX_TEST_RESULT([bvec_iter_offset],[
+		AC_MSG_RESULT(yes)
+		AC_DEFINE([HAVE_BVEC_ITER_OFFSET], 1, [bvec_iter has bi_offset])
 	],[
 		AC_MSG_RESULT(no)
 	])
@@ -243,6 +267,7 @@
 	ZFS_AC_KERNEL_SRC_BDEV_SUBMIT_BIO_RETURNS_VOID
 	ZFS_AC_KERNEL_SRC_BIO_SET_DEV_MACRO
 	ZFS_AC_KERNEL_SRC_BIO_ALLOC_4ARG
+	ZFS_AC_KERNEL_SRC_BVEC_ITER_OFFSET
 ])
 
 AC_DEFUN([ZFS_AC_KERNEL_BIO], [
@@ -253,4 +278,5 @@
 	ZFS_AC_KERNEL_BIO_BDEV_DISK
 	ZFS_AC_KERNEL_BDEV_SUBMIT_BIO_RETURNS_VOID
 	ZFS_AC_KERNEL_BIO_ALLOC_4ARG
-])
+	ZFS_AC_KERNEL_BVEC_ITER_OFFSET
+])
--- a/include/os/linux/kernel/linux/blkdev_compat.h
+++ b/include/os/linux/kernel/linux/blkdev_compat.h
@@ -104,7 +104,11 @@
 #define	BIO_BI_SECTOR(bio)	(bio)->bi_iter.bi_sector
 #define	BIO_BI_SIZE(bio)	(bio)->bi_iter.bi_size
 #define	BIO_BI_IDX(bio)		(bio)->bi_iter.bi_idx
+#ifdef HAVE_BVEC_ITER_OFFSET
+#define	BIO_BI_SKIP(bio)	(bio)->bi_iter.bi_offset
+#else
 #define	BIO_BI_SKIP(bio)	(bio)->bi_iter.bi_bvec_done
+#endif
 #define	bio_for_each_segment4(bv, bvp, b, i)	\
 	bio_for_each_segment((bv), (b), (i))
 typedef struct bvec_iter bvec_iterator_t;
