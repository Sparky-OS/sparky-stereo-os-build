Description: Preserve the 2D cover of a declared stereo child
 Restore the saved pair once per new child surface and retain the current
 covered area in both views. Exercise real buffer recycling in the suite.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Forwarded: no, edition stereo child surface path
Last-Update: 2026-11-14

diff --git a/hw/xwayland/xwayland-present.c b/hw/xwayland/xwayland-present.c
index 4123b74..35fbbbe 100644
--- a/hw/xwayland/xwayland-present.c
+++ b/hw/xwayland/xwayland-present.c
@@ -814,6 +814,10 @@ xwl_present_restore_stereo(WindowPtr window)
     struct xwl_present_window *present = xwl_present_window_priv(window);
     ScreenPtr screen = window->drawable.pScreen;
     PixmapPtr snapshot, old;
+    RegionRec covered;
+    BoxPtr rect;
+    GCPtr gc;
+    int i;
 
     if (!present || !present->stereo_snapshot)
         return FALSE;
@@ -826,6 +830,37 @@ xwl_present_restore_stereo(WindowPtr window)
         return FALSE;
     }
     old = screen->GetWindowPixmap(window);
+    /* The saved pair predates redirection. Keep what the children have
+     * drawn into the new window pixmap, in both views of that pair.
+     */
+    RegionNull(&covered);
+    RegionSubtract(&covered, &window->winSize, &window->clipList);
+    if (RegionNotEmpty(&covered)) {
+        gc = GetScratchGC(snapshot->drawable.depth, screen);
+        if (!gc) {
+            RegionUninit(&covered);
+            dixDestroyPixmap(snapshot, 0);
+            return FALSE;
+        }
+        ValidateGC(&snapshot->drawable, gc);
+        rect = RegionRects(&covered);
+        for (i = 0; i < RegionNumRects(&covered); i++, rect++) {
+            int x = rect->x1 - window->drawable.x;
+            int y = rect->y1 - window->drawable.y;
+
+            gc->ops->CopyArea(&old->drawable, &snapshot->drawable, gc,
+                              rect->x1 - old->screen_x,
+                              rect->y1 - old->screen_y,
+                              rect->x2 - rect->x1, rect->y2 - rect->y1, x, y);
+            gc->ops->CopyArea(&old->drawable, &snapshot->drawable, gc,
+                              rect->x1 - old->screen_x,
+                              rect->y1 - old->screen_y,
+                              rect->x2 - rect->x1, rect->y2 - rect->y1,
+                              x + window->drawable.width, y);
+        }
+        FreeScratchGC(gc);
+    }
+    RegionUninit(&covered);
     snapshot->screen_x = old->screen_x;
     snapshot->screen_y = old->screen_y;
     present_set_tree_pixmap(window, old, snapshot);
