+/* A copy to a one-view X window cannot retain the second view. Keep an
+ * owned copy until a compositor creates the child's independent surface.
+ * The Present source may be reused by its client after idle notification.
+ */
+void
+xwl_present_save_stereo(WindowPtr window, PixmapPtr pixmap)
+{
+    ScreenPtr screen = window->drawable.pScreen;
+    struct xwl_present_window *present;
+    PixmapPtr snapshot;
+    GCPtr gc;
+
+    if (!window->parent || window->parent == screen->root || !pixmap ||
+        pixmap->drawable.width != 2 * window->drawable.width ||
+        pixmap->drawable.height != window->drawable.height ||
+        !xwl_present_window_holds_two_eyes(window))
+        return;
+
+    snapshot = screen->CreatePixmap(screen, pixmap->drawable.width,
+                                    pixmap->drawable.height,
+                                    pixmap->drawable.depth, CREATE_PIXMAP_USAGE_BACKING_PIXMAP);
+    if (!snapshot)
+        return;
+    gc = GetScratchGC(pixmap->drawable.depth, screen);
+    if (!gc) {
+        dixDestroyPixmap(snapshot, 0);
+        return;
+    }
+    ValidateGC(&snapshot->drawable, gc);
+    gc->ops->CopyArea(&pixmap->drawable, &snapshot->drawable, gc,
+                      0, 0, pixmap->drawable.width, pixmap->drawable.height, 0, 0);
+    FreeScratchGC(gc);
+
+    present = xwl_present_window_get_priv(window);
+    if (!present) {
+        dixDestroyPixmap(snapshot, 0);
+        return;
+    }
+    if (present->stereo_snapshot)
+        dixDestroyPixmap(present->stereo_snapshot, 0);
+    present->stereo_snapshot = snapshot;
+}
+
+Bool
+xwl_present_restore_stereo(WindowPtr window)
+{
+    struct xwl_present_window *present = xwl_present_window_priv(window);
+    ScreenPtr screen = window->drawable.pScreen;
+    PixmapPtr snapshot, old;
+
+    if (!present || !present->stereo_snapshot)
+        return FALSE;
+    snapshot = present->stereo_snapshot;
+    present->stereo_snapshot = NULL;
+    if (snapshot->drawable.width != 2 * window->drawable.width ||
+        snapshot->drawable.height != window->drawable.height ||
+        !xwl_present_window_holds_two_eyes(window)) {
+        dixDestroyPixmap(snapshot, 0);
+        return FALSE;
+    }
+    old = screen->GetWindowPixmap(window);
+    snapshot->screen_x = old->screen_x;
+    snapshot->screen_y = old->screen_y;
+    present_set_tree_pixmap(window, old, snapshot);
+    dixDestroyPixmap(old, old->drawable.id);
+    return TRUE;
 }
 
