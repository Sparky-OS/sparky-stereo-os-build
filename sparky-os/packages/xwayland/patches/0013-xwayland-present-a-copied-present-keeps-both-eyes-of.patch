diff --git a/test/scripts/xwayland-stereo-pair.sh b/test/scripts/xwayland-stereo-pair.sh
index e7353fe..6d2c900 100755
--- a/test/scripts/xwayland-stereo-pair.sh
+++ b/test/scripts/xwayland-stereo-pair.sh
@@ -92,5 +92,30 @@ for kind in toplevel child; do
         status=1
     fi
 done
+unset CHILD
+
+# A present that cannot be flipped keeps both eyes all the same: the window
+# is clipped by a child window of its own, or the present has an offset. It
+# completes as a flip, and the pixmap the compositor is handed for the window
+# holds both eyes, with the child's own picture, which is 2D, in both.
+if ! COVER=1 PAINT_COVER=1 EXPECT=flip EXPECT_PIXMAP=pair EXPECT_COVER=yellow \
+    FRAMES=6 SETTLE_MS=200 "$client"; then
+    echo "FAIL: a window covered by a child window of its own lost an eye"
+    status=1
+fi
+if ! X_OFF=16 Y_OFF=8 EXPECT=flip EXPECT_PIXMAP=pair FRAMES=6 SETTLE_MS=200 \
+    "$client"; then
+    echo "FAIL: a present with an offset lost an eye"
+    status=1
+fi
+
+# A window that stops declaring two eyes has a pixmap one window wide at
+# once, with no further present: a compositor never has two eyes for a
+# window that declares none
+if ! UNDECLARE=1 EXPECT=flip EXPECT_PIXMAP=one FRAMES=3 SETTLE_MS=200 \
+    "$client"; then
+    echo "FAIL: the window still holds two eyes after its declaration went"
+    status=1
+fi
 
 exit $status
diff --git a/test/stereo-present-pair.c b/test/stereo-present-pair.c
index 614091f..8a0eeb5 100644
--- a/test/stereo-present-pair.c
+++ b/test/stereo-present-pair.c
@@ -9,9 +9,9 @@
  * of each and a white square that moves with every present, at the same
  * place in both eyes.
  *
- * Prints how the server completed each present: as a flip, the pixmap went
- * to the window's surface whole; as a copy, it was copied into the one eye
- * wide window, which keeps the left eye only.
+ * Prints how the server completed each present: as a flip, the pixmap of
+ * both eyes reached the window's surface whole; as a copy, it was copied
+ * into the one eye wide window, which keeps the left eye only.
  *
  * Environment:
  *   NODECLARE=1  no declaration: the control, the server must copy
@@ -20,10 +20,20 @@
  *   WM=1         stand in for the compositor's window manager: redirect the
  *                root's children, which gives a toplevel its surface on a
  *                rootless Xwayland, and the declared child
+ *   COVER=1      a 60x60 plain child window over the declared one, 30 from
+ *                its left and half way down: the server cannot flip a window
+ *                that a child clips, and must still keep both eyes
+ *   PAINT_COVER=1  before the last present that child is painted another
+ *                colour, by the server alone
+ *   X_OFF, Y_OFF the offset of every present, which cannot be flipped either
+ *   UNDECLARE=1  after the last present the declaration is deleted
  *   FRAMES=N     presents (200), PERIOD_MS apart (50); W, H: one eye's size
