                              pBox->y1 + surface_window->borderWidth,
                              pBox->x2 - pBox->x1,
                              pBox->y2 - pBox->y1);
+            /* The damage is one eye wide: a pixmap that holds two eyes
+             * changed at the same place in its right eye too.
+             */
+            if (xwl_window->two_eyes_window != None &&
+                window_pixmap->drawable.width ==
+                2 * surface_window->drawable.width)
+                copy_pixmap_area(window_pixmap,
+                                 xwl_window_buffer->pixmap,
+                                 pBox->x1 + surface_window->drawable.width,
