     uint32_t options;
     uint64_t divisor;
@@ -88,5 +90,7 @@ void xwl_present_stop_flips(WindowPtr window);
 Bool xwl_present_window_holds_two_eyes(WindowPtr window);
 void xwl_present_save_stereo(WindowPtr window, PixmapPtr pixmap);
 Bool xwl_present_restore_stereo(WindowPtr window);
+Bool xwl_present_keep_both_eyes(struct xwl_window *xwl_window);
