diff --git a/hw/xwayland/xwayland-present.c b/hw/xwayland/xwayland-present.c
index cd3c2b0..4123b74 100644
--- a/hw/xwayland/xwayland-present.c
+++ b/hw/xwayland/xwayland-present.c
@@ -833,6 +833,257 @@ xwl_present_restore_stereo(WindowPtr window)
     return TRUE;
 }
 
+
+/* The window whose two eyes the pixmap of 'xwl_window' holds, or NULL. */
+static WindowPtr
+xwl_present_two_eyes_window(struct xwl_window *xwl_window)
+{
+    WindowPtr window;
+
+    if (xwl_window->two_eyes_window == None ||
+        dixLookupWindow(&window, xwl_window->two_eyes_window, serverClient,
+                        DixGetAttrAccess) != Success)
+        return NULL;
+
+    return window;
+}
+
+/* Give the tree 'window' draws into a pixmap 'width' wide: the picture of one
+ * window width, repeated for as many window widths as the new pixmap has.
+ */
+static PixmapPtr
+xwl_present_resize_window_pixmap(WindowPtr window, int width)
+{
+    ScreenPtr screen = window->drawable.pScreen;
+    WindowPtr toplvl_window = xwl_present_toplvl_pixmap_window(window);
+    PixmapPtr old = screen->GetWindowPixmap(window);
+    PixmapPtr pixmap;
+    GCPtr gc;
+    int x;
+
+    pixmap = screen->CreatePixmap(screen, width, old->drawable.height,
+                                  old->drawable.depth,
+                                  CREATE_PIXMAP_USAGE_BACKING_PIXMAP);
+    if (!pixmap)
+        return NULL;
+
+    gc = GetScratchGC(pixmap->drawable.depth, screen);
+    if (!gc || !xwl_pixmap_get_wl_buffer(pixmap)) {
+        if (gc)
+            FreeScratchGC(gc);
+        dixDestroyPixmap(pixmap, 0);
+        return NULL;
+    }
+    ValidateGC(&pixmap->drawable, gc);
+    for (x = 0; x < width; x += window->drawable.width)
+        gc->ops->CopyArea(&old->drawable, &pixmap->drawable, gc, 0, 0,
+                          window->drawable.width, old->drawable.height, x, 0);
+    FreeScratchGC(gc);
+
+#ifdef COMPOSITE
+    pixmap->screen_x = old->screen_x;
+    pixmap->screen_y = old->screen_y;
+#endif
+    present_set_tree_pixmap(toplvl_window, old, pixmap);
+    dixDestroyPixmap(old, old->drawable.id);
+
+    return pixmap;
+}
+
+/*
+ * A pixmap presented to a window that holds two eyes is copied when it cannot
+ * be flipped: a child window clips the window, the pixmap has an offset or
+ * another size than the window, or a compositor cannot take its buffer. A
+ * copy into the window alone keeps the left eye. Keep both: the window's
+ * pixmap becomes twice the window wide, present_execute_copy() copies the
+ * left eye as it copies for any window, and the right eye goes to the same
+ * place in the right half, clipped as the left eye is. What other windows
+ * draw there is shown in both eyes by xwl_present_keep_both_eyes().
+ *
+ * Returns FALSE when the pair cannot be kept: the copy then keeps the left
+ * eye only and the present completes as a copy, which tells the client.
+ */
+static Bool
+xwl_present_copy_both_eyes(present_vblank_ptr vblank)
+{
+    WindowPtr window = vblank->window;
+    ScreenPtr screen = window->drawable.pScreen;
+    struct xwl_window *xwl_window = xwl_window_from_window(window);
+    PixmapPtr source = vblank->pixmap;
+    PixmapPtr pixmap;
+    int width = window->drawable.width;
+    int height = window->drawable.height;
+    int eye = source->drawable.width / 2;
+    RegionPtr left, right;
+    RegionRec clip;
+    BoxRec box;
+    GCPtr gc;
+    int x, y;
+
+    if (!xwl_window || !eye || (source->drawable.width & 1) ||
+        !xwl_present_window_holds_two_eyes(window) ||
+        xwl_window->surface_window->borderWidth ||
+        !RegionEqual(&xwl_window->toplevel->winSize, &window->winSize) ||
+        screen->GetWindowPixmap(xwl_window->surface_window) !=
+        screen->GetWindowPixmap(window))
+        return FALSE;
+
+    pixmap = screen->GetWindowPixmap(window);
+    if (pixmap->drawable.height != height)
+        return FALSE;
+    if (pixmap->drawable.width != 2 * width) {
+        if (pixmap->drawable.width != width)
+            return FALSE;
+        pixmap = xwl_present_resize_window_pixmap(window, 2 * width);
+        if (!pixmap)
+            return FALSE;
+        /* All of the new pixmap is new to the compositor */
+        DamageDamageRegion(&window->drawable, &window->winSize);
+    }
+    xwl_window->two_eyes_window = window->drawable.id;
+    /* What other windows drew since the last copy goes to the right eye */
+    xwl_present_keep_both_eyes(xwl_window);
+
+    /* The part of one eye this present updates, in the source's coordinates */
+    box.x1 = 0;
+    box.y1 = 0;
+    box.x2 = eye;
+    box.y2 = source->drawable.height;
+    left = RegionCreate(&box, 1);
+    if (vblank->update) {
+        RegionIntersect(left, left, vblank->update);
+        RegionDestroy(vblank->update);
+    }
+    vblank->update = left;
+
+    /* The right eye: where the left eye may be drawn, one window further */
+    x = window->drawable.x + vblank->x_off + width;
+    y = window->drawable.y + vblank->y_off;
+#ifdef COMPOSITE
+    x -= pixmap->screen_x;
+    y -= pixmap->screen_y;
+#endif
+    right = RegionDuplicate(left);
+    RegionTranslate(right, x, y);
+    RegionNull(&clip);
+    RegionCopy(&clip, &window->clipList);
+    RegionTranslate(&clip, x - vblank->x_off - window->drawable.x,
+                    y - vblank->y_off - window->drawable.y);
+    RegionIntersect(right, right, &clip);
+    RegionUninit(&clip);
+
+    gc = GetScratchGC(pixmap->drawable.depth, screen);
+    if (!gc) {
+        RegionDestroy(right);
+        return FALSE;
+    }
+    (*gc->funcs->ChangeClip) (gc, CT_REGION, right, 0);
+    ValidateGC(&pixmap->drawable, gc);
+    gc->ops->CopyArea(&source->drawable, &pixmap->drawable, gc, eye, 0, eye,
+                      source->drawable.height, x, y);
+    (*gc->funcs->ChangeClip) (gc, CT_NONE, NULL, 0);
+    FreeScratchGC(gc);
+
+    return TRUE;
+}
+
+/*
+ * Called before the pixmap of 'xwl_window' goes to the compositor. When it
+ * holds the two eyes of a window, what changed outside that window's own
+ * area (a child window over it, the frame around it) was drawn into the left
+ * half only: it is 2D, so the same picture goes to the right eye. Returns
+ * whether the pixmap holds two eyes, so that the caller damages both.
+ */
+Bool
+xwl_present_keep_both_eyes(struct xwl_window *xwl_window)
+{
+    ScreenPtr screen = xwl_window->xwl_screen->screen;
+    WindowPtr surface_window = xwl_window->surface_window;
+    WindowPtr window = xwl_present_two_eyes_window(xwl_window);
+    PixmapPtr pixmap = screen->GetWindowPixmap(surface_window);
+    int width = surface_window->drawable.width;
+    RegionRec flat, left;
+    BoxRec box;
+    BoxPtr rect;
+    GCPtr gc;
+    int i, dx = 0, dy = 0;
+
+    if (!window || pixmap->drawable.width != 2 * width ||
+        surface_window->borderWidth ||
+        screen->GetWindowPixmap(window) != pixmap ||
+        !xwl_present_window_holds_two_eyes(window)) {
+        xwl_window->two_eyes_window = None;
+        return FALSE;
+    }
+
+#ifdef COMPOSITE
+    dx = pixmap->screen_x;
+    dy = pixmap->screen_y;
+#endif
+    RegionNull(&flat);
+    RegionCopy(&flat, xwl_window_get_damage_region(xwl_window));
+    RegionTranslate(&flat, surface_window->drawable.x, surface_window->drawable.y);
+    RegionSubtract(&flat, &flat, &window->clipList);
+    RegionTranslate(&flat, -dx, -dy);
+    box.x1 = 0;
+    box.y1 = 0;
+    box.x2 = width;
+    box.y2 = pixmap->drawable.height;
+    RegionInit(&left, &box, 1);
+    RegionIntersect(&flat, &flat, &left);
+    RegionUninit(&left);
+
+    if (RegionNotEmpty(&flat) &&
+        (gc = GetScratchGC(pixmap->drawable.depth, screen))) {
+        ValidateGC(&pixmap->drawable, gc);
+        rect = RegionRects(&flat);
+        for (i = 0; i < RegionNumRects(&flat); i++, rect++)
+            gc->ops->CopyArea(&pixmap->drawable, &pixmap->drawable, gc,
+                              rect->x1, rect->y1, rect->x2 - rect->x1,
+                              rect->y2 - rect->y1, rect->x1 + width, rect->y1);
+        FreeScratchGC(gc);
+    }
+    RegionUninit(&flat);
+
+    return TRUE;
+}
+
+/*
+ * 'window' shows one view: a present without two eyes is copied to it, or its
+ * declaration changed. A pixmap twice the window wide that no window's two
+ * eyes are in any more becomes one window wide again, with the left eye, so
+ * that the compositor never gets two eyes for a window that declares none.
+ */
+void
+xwl_present_one_view(WindowPtr window)
+{
+    ScreenPtr screen = window->drawable.pScreen;
+    struct xwl_window *xwl_window = xwl_window_from_window(window);
+    WindowPtr surface_window, two_eyes_window;
+    PixmapPtr pixmap;
+
+    if (!xwl_window)
+        return;
+
+    surface_window = xwl_window->surface_window;
+    two_eyes_window = xwl_present_two_eyes_window(xwl_window);
+    pixmap = screen->GetWindowPixmap(surface_window);
+    if (surface_window->borderWidth ||
+        pixmap->drawable.width != 2 * surface_window->drawable.width ||
+        xwl_present_window_holds_two_eyes(surface_window) ||
+        xwl_present_window_holds_two_eyes(window) ||
+        (two_eyes_window && xwl_present_window_holds_two_eyes(two_eyes_window)))
+        return;
+
+    xwl_present_stop_flips(surface_window);
+    if (two_eyes_window)
+        xwl_present_stop_flips(two_eyes_window);
+    xwl_window->two_eyes_window = None;
+    if (xwl_present_resize_window_pixmap(surface_window,
+                                         surface_window->drawable.width))
+        DamageDamageRegion(&surface_window->drawable, &surface_window->winSize);
+}
+
 static Bool
 xwl_present_check_flip(RRCrtcPtr crtc,
                        WindowPtr present_window,
@@ -1273,6 +1524,11 @@ retry:
                 vblank->pixmap->refcnt++;
                 dixDestroyPixmap(old_pixmap, old_pixmap->drawable.id);
 
+                if (xwl_window)
+                    xwl_window->two_eyes_window =
+                        vblank->pixmap->drawable.width == 2 * window->drawable.width ?
+                        window->drawable.id : None;
+
                 /* Report damage, let damage_report ignore it though */
                 xwl_screen->ignore_damage = TRUE;
                 DamageDamageRegion(&vblank->window->drawable, damage);
@@ -1308,6 +1564,11 @@ retry:
         else if (xwl_present_window->flip_active)
             xwl_present_flips_stop(window);
 
+        if (xwl_present_copy_both_eyes(vblank))
+            event->both_eyes = TRUE;
+        else
+            xwl_present_one_view(window);
+
         present_execute_copy(vblank, crtc_msc);
         assert(!vblank->queued);
 
@@ -1323,6 +1584,20 @@ retry:
             return;
     }
 
+    /* Both eyes of the pixmap reached the window's surface, as they do with a
+     * flip. For a window that holds two eyes the completion mode says exactly
+     * that: flip when the pair was kept, copy when only the left eye was.
+     */
+    if (event->both_eyes && vblank->kind == PresentCompleteKindPixmap &&
+        vblank->pixmap && vblank->window &&
+        !(vblank->has_suboptimal &&
+          vblank->reason == PRESENT_FLIP_REASON_BUFFER_FORMAT)) {
+        present_vblank_notify(vblank, vblank->kind, PresentCompleteModeFlip,
+                              ust, crtc_msc);
+        present_vblank_destroy(vblank);
+        return;
+    }
+
     present_execute_post(vblank, ust, crtc_msc);
 }
 
