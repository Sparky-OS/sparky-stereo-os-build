+++ b/hw/xwayland/xwayland-screen.c
@@ -178,6 +178,13 @@ xwl_property_callback(CallbackListPtr *pcbl, void *closure,
 
     if (rec->prop->propertyName == xwl_screen->allow_commits_prop)
         xwl_window_update_property(xwl_window, rec);
+    else if (xwl_screen->present &&
+             (rec->prop->propertyName ==
+              MakeAtom("_KDE_NET_WM_STEREO_CONTENT", 26, FALSE) ||
