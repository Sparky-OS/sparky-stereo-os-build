     } else {
         box = RegionRects(region);
         for (i = 0; i < RegionNumRects(region); i++, box++) {
@@ -2178,6 +2184,12 @@ xwl_window_attach_buffer(struct xwl_window *xwl_window)
                                box->x1 + surface_window->borderWidth,
                                box->y1 + surface_window->borderWidth,
