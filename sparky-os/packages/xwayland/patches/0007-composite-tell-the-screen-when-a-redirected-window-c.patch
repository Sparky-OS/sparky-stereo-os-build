From 42f713513880ce564b6203d15897b3660413f7e4 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Fri, 16 Oct 2026 12:34:56 -0300
Subject: [PATCH] composite: tell the screen when a redirected window changes
 redirect mode

A window whose visual differs from its parent's (an ARGB OpenGL area in
an RGB toolkit window) is redirected automatically by the server. When a
compositor then redirects it manually, Composite changes only the
window's mode and keeps its pixmap, so SetWindowPixmap is not called and
Xwayland, which gives a manually redirected child a surface of its own
from that hook, never did: ParaView's stereo render view, listed by KWin
as a stereo child, stayed an empty area in its window.

Call SetWindowPixmap with the window's own pixmap when a redirected
window changes between automatic and manual redirection, both when a
manual redirection is added and when it is removed while an automatic
one remains, as a pixmap change would.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 composite/compalloc.c  |  1 +
 composite/compint.h    |  3 +++
 composite/compwindow.c | 20 ++++++++++++++++++++
 3 files changed, 24 insertions(+)

diff --git a/composite/compalloc.c b/composite/compalloc.c
index ba31684..3d155e2 100644
--- a/composite/compalloc.c
+++ b/composite/compalloc.c
@@ -303,6 +303,7 @@ compFreeClientWindow(WindowPtr pWin, XID id)
         DamageRegister(&pWin->drawable, cw->damage);
         cw->damageRegistered = TRUE;
         pWin->redirectDraw = RedirectDrawAutomatic;
+        compRedirectModeChanged(pWin);
         DamageDamageRegion(&pWin->drawable, &pWin->borderSize);
     }
 
diff --git a/composite/compint.h b/composite/compint.h
index cb73c38..fe783a7 100644
--- a/composite/compint.h
+++ b/composite/compint.h
@@ -277,6 +277,9 @@ void
 void
  compSetPixmap(WindowPtr pWin, PixmapPtr pPixmap, int bw);
 
+void
+ compRedirectModeChanged(WindowPtr pWin);
+
 Bool
  compCheckRedirect(WindowPtr pWin);
 
diff --git a/composite/compwindow.c b/composite/compwindow.c
index 83ac1ca..bd70f51 100644
--- a/composite/compwindow.c
+++ b/composite/compwindow.c
@@ -153,6 +153,22 @@ compSetPixmap(WindowPtr pWindow, PixmapPtr pPixmap, int bw)
     compCheckTree(pWindow->drawable.pScreen);
 }
 
+/*
+ * A window already redirected changed between automatic and manual
+ * redirection, keeping its pixmap: tell the screen as a pixmap change would,
+ * so a screen that treats manually redirected windows apart (Xwayland gives
+ * one a surface of its own) sees the change. A window of another visual than
+ * its parent's is redirected automatically by the server, so a compositor's
+ * manual redirection of it changes only the mode.
+ */
+void
+compRedirectModeChanged(WindowPtr pWin)
+{
+    ScreenPtr pScreen = pWin->drawable.pScreen;
+
+    (*pScreen->SetWindowPixmap) (pWin, (*pScreen->GetWindowPixmap) (pWin));
+}
+
 Bool
 compCheckRedirect(WindowPtr pWin)
 {
@@ -183,10 +199,14 @@ compCheckRedirect(WindowPtr pWin)
         }
     }
     else if (should) {
+        const unsigned int redirectDraw = pWin->redirectDraw;
+
         if (cw->update == CompositeRedirectAutomatic)
             pWin->redirectDraw = RedirectDrawAutomatic;
         else
             pWin->redirectDraw = RedirectDrawManual;
+        if (pWin->redirectDraw != redirectDraw)
+            compRedirectModeChanged(pWin);
     }
     return TRUE;
 }
