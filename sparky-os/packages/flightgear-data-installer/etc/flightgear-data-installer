# Settings of flightgear-data-installer.
# MIRROR_URL: where to fetch FlightGear's data file from instead of FlightGear's release page on SourceForge.
# Leave it empty for the default. It must start with https:// or file:/// and name the file
# FlightGear-2024.1.5-data.txz; whatever it serves is checked against the SHA-256 recorded in the package.
MIRROR_URL=
# PARALLEL: how many byte ranges of the file are fetched at the same time, from 1 to 16. One connection to FlightGear's
# release page gives about 300 kB/s; eight give about eight times that. A download that was stopped continues with the
# number of ranges it had.
PARALLEL=8
