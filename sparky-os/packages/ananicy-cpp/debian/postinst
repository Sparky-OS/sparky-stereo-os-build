#!/bin/sh
set -e
if [ "$1" = configure ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt 1.2.0+git20260818-1+sparky2~; then
	# the earlier build of this package (1.2.0+git20260818-1+sparky1) installed the unit off and recorded that. deb-systemd-helper keeps a recorded
	# off on upgrade, so its record is dropped once here: the stock snippet below then enables the unit as on a fresh install. A version from
	# sparky2 on never gets here, so a person's own off stays.
	deb-systemd-helper purge ananicy-cpp.service >/dev/null || :
fi
#DEBHELPER#
