+// pixels, positive when nearer than the screen) moves sideways by its share of it for the eye,
+// relative to what it lies on, which is its nearest ancestor with a parallax or else the window,
+// split as Stereo KWin splits a window's parallax; an item deeper than what it lies on is cut to
+// its own rectangle, the opening it is seen through. Nothing changes for any other window.
+//
+// The state is kept beside the window's and the items' own, which keeps their layouts.
+class Q_QUICK_EXPORT QQuickWindowStereo
+{
+public:
+    enum class Eye { None = 0, Left = 1, Right = 2 };
+
+    struct Placement
+    {
+        // How far the item moves, in the coordinates of its parent.
+        QPointF shift;
+        // Whether it is cut to its rectangle, where it is without the move: how far that is, in
+        // its own coordinates.
+        bool cut = false;
+        QPointF opening;
+
+        bool operator==(const Placement &other) const
+        {
+            return shift == other.shift && cut == other.cut && opening == other.opening;
+        }
+    };
+
+    static constexpr char DepthProperty[] = "_q_stereo_depth";
+    static constexpr char EyeProperty[] = "_q_stereo_eye";
+    static constexpr char PairProperty[] = "_q_stereo_pair";
+    static constexpr char ViewsProperty[] = "_q_stereo_views";
+    static constexpr char ParallaxProperty[] = "_q_stereo_parallax";
+
+    // The window's state once it ever showed depth, otherwise nullptr. Any thread.
+    static QQuickWindowStereo *of(const QQuickWindow *window);
+    static void windowDestroyed(QQuickWindow *window);
+
+    // Gui thread.
+    static void windowPropertyChanged(QQuickWindow *window, const QByteArray &name);
+    static void itemPropertyChanged(QQuickItem *item, const QByteArray &name);
+    static void itemEnteredWindow(QQuickItem *item, QQuickWindow *window);
+    static void itemLeftWindow(QQuickItem *item, QQuickWindow *window);
+    // While an eye is set on the window, what it dirties is drawn by the frame setting it and
+    // asks for no frame of its own.
+    static bool isSettingEye(const QQuickWindow *window);
+
+    // Gui thread, before a frame is polished: whether the frame is drawn as a pair.
+    bool beginFrame();
+    // Any thread: whether the last frame begun was drawn as a pair.
+    bool isDrawingPair() const { return m_pair.load(std::memory_order_acquire); }
+    void setEye(Eye eye);
+    Eye eye() const { return m_eye; }
+
+    // While an eye is synchronized: how an item is placed for it.
+    Placement placement(const QQuickItem *item) const;
+    // The placement of the items being synchronized for the window, if any: set around
+    // QQuickWindowPrivate::updateDirtyNodes().
+    static const QQuickWindowStereo *placing();
+    static void setPlacing(const QQuickWindowStereo *stereo);
+
+    // Render thread.
+    static bool hasRightTarget(QRhiSwapChain *swapchain);
+    void setRightPass(bool right) { m_rightPass = right; }
+    QRhiRenderTarget *renderTarget(QRhiSwapChain *swapchain) const;
+    // While a frame is recorded: whether the surface it is drawn on has two views, for the next.
+    void frameRendered(QRhiSwapChain *swapchain);
+
+private:
+    explicit QQuickWindowStereo(QQuickWindow *window);
+
+    struct ItemState
+    {
+        qreal parallax = 0;
+        Placement placement;
+    };
+
+    void depthChanged();
+    void addItem(QQuickItem *item);
+    void addItems(QQuickItem *item);
+    void removeItem(QQuickItem *item);
+    void placeItems();
+    qreal referenceParallax(const QQuickItem *item) const;
+    void dirtyItem(QQuickItem *item, bool clip);
+
+    QQuickWindow *m_window;
+    QHash<const QQuickItem *, ItemState> m_items;
+    Eye m_eye = Eye::None;
+    bool m_depth = false;
+    std::atomic<bool> m_pair = false;
+    bool m_rightPass = false;
+    std::atomic<bool> m_twoViews = false;
+};
+
+QT_END_NAMESPACE
+
+#endif // QQUICKWINDOWSTEREO_P_H
