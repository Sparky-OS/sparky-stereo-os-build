@@ -0,0 +1,315 @@
+// Copyright (C) 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR GPL-3.0-only
+
+#include <QtTest/QtTest>
+#include <QtQml/QQmlComponent>
+#include <QtQml/QQmlEngine>
+#include <QtQuick/QQuickItem>
+#include <QtQuick/QQuickWindow>
+#include <QtQuick/private/qquickitem_p.h>
+#include <QtQuick/qsgnode.h>
+// Built with TST_STEREO_CONTRACT_ONLY, the test holds only what the window's and the items'
+// properties say, and runs against any Qt Quick.
+#ifndef TST_STEREO_CONTRACT_ONLY
+#include <QtQuick/private/qquickwindowstereo_p.h>
+#endif
+
+#include <QtCore/QMutex>
+#include <utility>
+
+#include <memory>
+
+// A window whose elements show depth (_q_stereo_depth) asks the platform for two views
+// (_q_stereo_views) and, once its surface has them, is drawn once per eye (_q_stereo_pair while it
+// is, _q_stereo_eye during each eye), every item that carries a parallax (_q_stereo_parallax,
+// device pixels) moved by its share for the eye relative to what it lies on, and an item deeper
+// than what it lies on cut to its own rectangle.
+static constexpr char DepthProperty[] = "_q_stereo_depth";
+static constexpr char EyeProperty[] = "_q_stereo_eye";
+static constexpr char PairProperty[] = "_q_stereo_pair";
+static constexpr char ViewsProperty[] = "_q_stereo_views";
+static constexpr char ParallaxProperty[] = "_q_stereo_parallax";
+
+class tst_QQuickWindowStereo : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void identityWithoutDepth();
+    void identityWithoutTwoViews();
+    void placesItemsForEachEye();
+    void drawsEachEyeInAPass();
+
+private:
+    struct Scene
+    {
+        std::unique_ptr<QQuickWindow> window;
+        QQuickItem *near = nullptr;
+        QQuickItem *deep = nullptr;
+        QQuickItem *deepChild = nullptr;
+    };
+    Scene makeScene();
+
+    QQmlEngine m_engine;
+};
+
+// A white window 200 by 100: a red square at (20, 20) 40 wide, a blue square at (100, 20) 60 wide
+// holding a green square 20 wide at its top left corner.
+static const char s_scene[] = R"(
+import QtQuick
+Window {
+    width: 200; height: 100
+    flags: Qt.FramelessWindowHint
+    color: "white"
+    Rectangle { objectName: "near"; x: 20; y: 20; width: 40; height: 40; color: "#ff0000" }
+    Rectangle {
+        objectName: "deep"; x: 100; y: 20; width: 60; height: 60; color: "#0000ff"
+        Rectangle { objectName: "deepChild"; width: 20; height: 20; color: "#00ff00" }
+    }
+}
+)";
+
+tst_QQuickWindowStereo::Scene tst_QQuickWindowStereo::makeScene()
+{
+    Scene scene;
+    QQmlComponent component(&m_engine);
+    component.setData(s_scene, QUrl());
+    scene.window.reset(qobject_cast<QQuickWindow *>(component.create()));
+    if (!scene.window) {
+        qWarning() << component.errors();
+        return scene;
+    }
+    scene.near = scene.window->findChild<QQuickItem *>("near");
+    scene.deep = scene.window->findChild<QQuickItem *>("deep");
+    scene.deepChild = scene.window->findChild<QQuickItem *>("deepChild");
+    if (!scene.near || !scene.deep || !scene.deepChild)
+        scene.window.reset();
+    return scene;
+}
+
+// The columns of row y whose color is c, as the first and one past the last.
+static std::pair<int, int> span(const QImage &image, int y, QRgb c)
+{
+    int first = -1;
+    int last = -1;
+    for (int x = 0; x < image.width(); ++x) {
+        if ((image.pixel(x, y) & 0xffffff) == (c & 0xffffff)) {
+            if (first < 0)
+                first = x;
+            last = x + 1;
+        }
+    }
+    return {first, last};
+}
+
+static bool isSoftware()
+{
+    return QQuickWindow::sceneGraphBackend() == QLatin1String("software")
+            || qEnvironmentVariable("QT_QUICK_BACKEND") == QLatin1String("software");
+}
+
+void tst_QQuickWindowStereo::identityWithoutDepth()
+{
+    if (!isSoftware())
+        QSKIP("Compares grabs of the software renderer (QT_QUICK_BACKEND=software)");
+
+    Scene scene = makeScene();
+    QVERIFY(scene.window);
+    scene.window->show();
+    QVERIFY(QTest::qWaitForWindowExposed(scene.window.get()));
+    const QImage flat = scene.window->grabWindow();
+
+    // A parallax without depth shown moves nothing.
+    scene.near->setProperty(ParallaxProperty, 4.0);
+    scene.deep->setProperty(ParallaxProperty, -4.0);
+    QCOMPARE(scene.window->grabWindow(), flat);
+    QVERIFY(!scene.window->property(ViewsProperty).isValid());
+#ifndef TST_STEREO_CONTRACT_ONLY
+    QVERIFY(!QQuickWindowStereo::of(scene.window.get()));
+#endif
+}
+
+void tst_QQuickWindowStereo::identityWithoutTwoViews()
+{
+    if (!isSoftware())
+        QSKIP("Compares grabs of the software renderer (QT_QUICK_BACKEND=software)");
+
+    Scene scene = makeScene();
+    QVERIFY(scene.window);
+    scene.window->show();
+    QVERIFY(QTest::qWaitForWindowExposed(scene.window.get()));
+    const QImage flat = scene.window->grabWindow();
+
+    scene.near->setProperty(ParallaxProperty, 4.0);
+    scene.deep->setProperty(ParallaxProperty, -4.0);
+    scene.window->setProperty(DepthProperty, true);
+
+    // The window asks for two views; a surface without them draws the window once, as in 2D.
+    QCOMPARE(scene.window->property(ViewsProperty).toInt(), 2);
+    for (int frame = 0; frame < 3; ++frame) {
+        scene.window->update();
+        QTest::qWait(20);
+    }
+    QVERIFY(!scene.window->property(PairProperty).toBool());
+    QCOMPARE(scene.window->property(EyeProperty).toInt(), 0);
+    QCOMPARE(scene.window->grabWindow(), flat);
+
+    // Once depth no longer shows, the window asks for one view again.
+    scene.window->setProperty(DepthProperty, false);
+    QVERIFY(!scene.window->property(ViewsProperty).isValid());
+    QCOMPARE(scene.window->grabWindow(), flat);
+}
+
+void tst_QQuickWindowStereo::placesItemsForEachEye()
+{
+#ifdef TST_STEREO_CONTRACT_ONLY
+    QSKIP("Sets the eye through the engine's own interface");
+#else
+    if (!isSoftware())
+        QSKIP("Compares grabs of the software renderer (QT_QUICK_BACKEND=software)");
+
+    Scene scene = makeScene();
+    QVERIFY(scene.window);
+    scene.window->show();
+    QVERIFY(QTest::qWaitForWindowExposed(scene.window.get()));
+    QCOMPARE(scene.window->effectiveDevicePixelRatio(), 1.0);
+    const QImage flat = scene.window->grabWindow();
+
+    scene.near->setProperty(ParallaxProperty, 4.0);
+    scene.deep->setProperty(ParallaxProperty, -4.0);
+    scene.window->setProperty(DepthProperty, true);
+    QQuickWindowStereo *stereo = QQuickWindowStereo::of(scene.window.get());
+    QVERIFY(stereo);
+
+    const QRgb red = qRgb(255, 0, 0);
+    const QRgb blue = qRgb(0, 0, 255);
+    const QRgb green = qRgb(0, 255, 0);
+    using Span = std::pair<int, int>;
+
+    // 4 pixels nearer: the left eye 2 to the right, the right eye 2 to the left.
+    // 4 pixels deeper: the left eye 2 to the left, the right eye 2 to the right, seen through the
+    // opening the blue square leaves at its place, its child moving with it.
+    stereo->setEye(QQuickWindowStereo::Eye::Left);
+    QCOMPARE(scene.window->property(EyeProperty).toInt(), 1);
+    const QImage left = scene.window->grabWindow();
+    QCOMPARE(span(left, 40, red), Span(22, 62));
+    QCOMPARE(span(left, 60, blue), Span(100, 158));
+    QCOMPARE(span(left, 30, green), Span(100, 118));
+    QCOMPARE(span(left, 30, blue), Span(118, 158));
+
+    stereo->setEye(QQuickWindowStereo::Eye::Right);
+    const QImage right = scene.window->grabWindow();
+    QCOMPARE(span(right, 40, red), Span(18, 58));
+    QCOMPARE(span(right, 60, blue), Span(102, 160));
+    QCOMPARE(span(right, 30, green), Span(102, 122));
+    // The opening shows what lies behind the blue square.
+    QCOMPARE(right.pixel(100, 60) & 0xffffff, 0xffffffu);
+    QCOMPARE(right.pixel(101, 60) & 0xffffff, 0xffffffu);
+
+    // The items themselves stay where they are: only what is drawn of them moves.
+    QCOMPARE(scene.near->x(), 20.0);
+    QCOMPARE(scene.deep->x(), 100.0);
+    QCOMPARE(scene.near->mapToScene(QPointF()), QPointF(20, 20));
+
+    // A parallax equal to what an item lies on moves it with that.
+    scene.deepChild->setProperty(ParallaxProperty, -4.0);
+    stereo->setEye(QQuickWindowStereo::Eye::Left);
+    const QImage leftAgain = scene.window->grabWindow();
+    QCOMPARE(span(leftAgain, 30, green), Span(100, 118));
+
+    // No eye: the window as in 2D.
+    stereo->setEye(QQuickWindowStereo::Eye::None);
+    QCOMPARE(scene.window->property(EyeProperty).toInt(), 0);
+    QCOMPARE(scene.window->grabWindow(), flat);
+
+    // An item whose parallax is withdrawn is drawn where it is.
+    scene.near->setProperty(ParallaxProperty, QVariant());
+    stereo->setEye(QQuickWindowStereo::Eye::Left);
+    QCOMPARE(span(scene.window->grabWindow(), 40, red), Span(20, 60));
+    stereo->setEye(QQuickWindowStereo::Eye::None);
+#endif
+}
+
+// Needs a platform that gives a window's surface two views, such as Wayland with Stereo KWin
+// (kde_stereo_content_manager_v1 version 3) and an EGL implementation with
+// EGL_EXT_multiview_window that declares them: QTEST_STEREO_TWO_VIEWS=1 says it is one.
+void tst_QQuickWindowStereo::drawsEachEyeInAPass()
+{
+    if (qEnvironmentVariableIntValue("QTEST_STEREO_TWO_VIEWS") != 1)
+        QSKIP("Needs a platform that gives a surface two views (QTEST_STEREO_TWO_VIEWS=1)");
+    if (isSoftware())
+        QSKIP("The software renderer draws a window once");
+
+    Scene scene = makeScene();
+    QVERIFY(scene.window);
+    scene.near->setProperty(ParallaxProperty, 4.0);
+    scene.deep->setProperty(ParallaxProperty, -4.0);
+
+    // What each pass drew the red square at, and when a frame was presented (-1).
+    QMutex mutex;
+    QList<qreal> passes;
+    QQuickItemPrivate *nearPrivate = QQuickItemPrivate::get(scene.near);
+    connect(scene.window.get(), &QQuickWindow::beforeRendering, scene.window.get(), [&] {
+        QMutexLocker locker(&mutex);
+        passes.append(nearPrivate->itemNode()->matrix()(0, 3));
+    }, Qt::DirectConnection);
+    connect(scene.window.get(), &QQuickWindow::frameSwapped, scene.window.get(), [&] {
+        QMutexLocker locker(&mutex);
+        passes.append(-1);
+    }, Qt::DirectConnection);
+    const auto framesAfter = [&](qsizetype from) {
+        QMutexLocker locker(&mutex);
+        QList<QList<qreal>> frames(1);
+        for (qsizetype i = from; i < passes.size(); ++i) {
+            if (passes.at(i) < 0)
+                frames.append(QList<qreal>());
+            else
+                frames.last().append(passes.at(i));
+        }
+        frames.removeLast(); // not presented yet
+        if (!frames.isEmpty())
+            frames.removeFirst(); // may have begun before
+        return frames;
+    };
+    const auto passCount = [&] {
+        QMutexLocker locker(&mutex);
+        return passes.size();
+    };
+
+    scene.window->show();
+    QVERIFY(QTest::qWaitForWindowExposed(scene.window.get()));
+    scene.window->setProperty(DepthProperty, true);
+    QTRY_VERIFY_WITH_TIMEOUT(scene.window->property(PairProperty).toBool(), 5000);
+
+    // Each frame draws the left eye and then the right eye.
+    qsizetype from = passCount();
+    for (int frame = 0; frame < 4; ++frame) {
+        scene.window->update();
+        QTest::qWait(50);
+    }
+    QTRY_VERIFY_WITH_TIMEOUT(framesAfter(from).size() >= 2, 5000);
+    const auto frames = framesAfter(from);
+    for (const auto &frame : frames)
+        QCOMPARE(frame, QList<qreal>({22, 18}));
+
+    // Between frames no eye is set and the items are where they are.
+    QCOMPARE(scene.window->property(EyeProperty).toInt(), 0);
+    QCOMPARE(scene.near->x(), 20.0);
+
+    // Once depth no longer shows, the window is drawn once again.
+    scene.window->setProperty(DepthProperty, false);
+    QTRY_VERIFY_WITH_TIMEOUT(!scene.window->property(PairProperty).toBool(), 5000);
+    QTest::qWait(200);
+    from = passCount();
+    for (int frame = 0; frame < 4; ++frame) {
+        scene.window->update();
+        QTest::qWait(50);
+    }
+    QTRY_VERIFY_WITH_TIMEOUT(framesAfter(from).size() >= 2, 5000);
+    for (const auto &frame : framesAfter(from))
+        QCOMPARE(frame, QList<qreal>({20}));
+}
+
+QTEST_MAIN(tst_QQuickWindowStereo)
