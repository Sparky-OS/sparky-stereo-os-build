+// Copyright (C) 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qquickwindowstereo_p.h"
+
+#include <QtQuick/private/qquickitem_p.h>
+#include <QtQuick/qquickwindow.h>
+
+#include <QtCore/qmutex.h>
+#include <QtCore/qpointer.h>
+#include <QtGui/rhi/qrhi.h>
+
+#include <cmath>
+#include <utility>
+
+QT_BEGIN_NAMESPACE
+
+namespace {
+
+// The windows that ever showed depth: written from the gui thread, read from render threads too.
+QBasicMutex s_mutex;
+QHash<const QQuickWindow *, QQuickWindowStereo *> *s_windows = nullptr;
+std::atomic<int> s_count = 0;
+
+thread_local const QQuickWindow *t_settingEye = nullptr;
+thread_local const QQuickWindowStereo *t_placing = nullptr;
+
+// As Stereo KWin splits a parallax (StereoDepth::eyeShift()): the right eye by whole pixels and
+// the left eye the rest, the left eye to the right and the right eye to the left for a positive
+// parallax, so a whole parallax keeps both eyes on whole pixels.
+qreal eyeShift(qreal parallax, QQuickWindowStereo::Eye eye)
+{
+    const qreal right = -std::trunc(parallax / 2);
+    switch (eye) {
+    case QQuickWindowStereo::Eye::Left:
+        return parallax + right;
+    case QQuickWindowStereo::Eye::Right:
+        return right == 0 ? 0 : right;
+    case QQuickWindowStereo::Eye::None:
+        break;
+    }
+    return 0;
+}
+
+// A move in the window's coordinates, as a move in the coordinates of whatever a transform maps
+// to the window.
+QPointF mapMove(const QTransform &toWindow, QPointF move)
+{
+    const QTransform fromWindow = toWindow.inverted();
+    return fromWindow.map(move) - fromWindow.map(QPointF());
+}
+
+} // namespace
+
+QQuickWindowStereo::QQuickWindowStereo(QQuickWindow *window)
+    : m_window(window)
+{
+}
+
+QQuickWindowStereo *QQuickWindowStereo::of(const QQuickWindow *window)
+{
+    if (!window || s_count.load(std::memory_order_acquire) == 0)
+        return nullptr;
+    QMutexLocker locker(&s_mutex);
+    return s_windows ? s_windows->value(window) : nullptr;
+}
+
+void QQuickWindowStereo::windowDestroyed(QQuickWindow *window)
+{
+    QQuickWindowStereo *stereo = nullptr;
+    {
+        QMutexLocker locker(&s_mutex);
+        if (s_windows)
+            stereo = s_windows->take(window);
+        if (stereo)
+            s_count.fetch_sub(1, std::memory_order_release);
+    }
+    delete stereo;
+}
+
+void QQuickWindowStereo::windowPropertyChanged(QQuickWindow *window, const QByteArray &name)
+{
+    if (name != DepthProperty)
+        return;
+
+    QQuickWindowStereo *stereo = of(window);
+    if (!stereo) {
+        if (!window->property(DepthProperty).toBool())
+            return;
+        stereo = new QQuickWindowStereo(window);
+        {
+            QMutexLocker locker(&s_mutex);
+            if (!s_windows)
+                s_windows = new QHash<const QQuickWindow *, QQuickWindowStereo *>;
+            s_windows->insert(window, stereo);
+            s_count.fetch_add(1, std::memory_order_release);
+        }
+        if (window->contentItem())
+            stereo->addItems(window->contentItem());
+    }
+    stereo->depthChanged();
+}
+
+void QQuickWindowStereo::depthChanged()
+{
+    m_depth = m_window->property(DepthProperty).toBool();
+    // The platform gives the surface its views at the start of a frame.
+    m_window->setProperty(ViewsProperty, m_depth ? QVariant(2) : QVariant());
+    m_window->update();
+}
+
+void QQuickWindowStereo::itemPropertyChanged(QQuickItem *item, const QByteArray &name)
+{
+    if (name != ParallaxProperty)
+        return;
+    if (QQuickWindowStereo *stereo = of(item->window()))
+        stereo->addItem(item);
+}
+
+void QQuickWindowStereo::itemEnteredWindow(QQuickItem *item, QQuickWindow *window)
+{
+    if (QQuickWindowStereo *stereo = of(window))
+        stereo->addItem(item);
+}
+
+void QQuickWindowStereo::itemLeftWindow(QQuickItem *item, QQuickWindow *window)
+{
+    if (QQuickWindowStereo *stereo = of(window))
+        stereo->m_items.remove(item);
+}
+
+bool QQuickWindowStereo::isSettingEye(const QQuickWindow *window)
+{
+    return t_settingEye && t_settingEye == window;
+}
+
+void QQuickWindowStereo::addItem(QQuickItem *item)
+{
+    const QVariant parallax = item->property(ParallaxProperty);
+    if (!parallax.isValid()) {
+        removeItem(item);
+        return;
+    }
+    // Placed with the next eye.
+    m_items[item].parallax = parallax.toReal();
+}
+
+void QQuickWindowStereo::addItems(QQuickItem *item)
+{
+    addItem(item);
+    const auto children = QQuickItemPrivate::get(item)->childItems;
+    for (QQuickItem *child : children)
+        addItems(child);
+}
+
+void QQuickWindowStereo::removeItem(QQuickItem *item)
+{
+    auto it = m_items.find(item);
+    if (it == m_items.end())
+        return;
+    const Placement placement = it->placement;
+    m_items.erase(it);
+    if (!(placement == Placement{}))
+        dirtyItem(item, placement.cut);
+}
+
+bool QQuickWindowStereo::beginFrame()
+{
+    // A window with client-side decorations is drawn once: its frame is no part of the pair.
+    const bool pair = m_depth && m_twoViews.load(std::memory_order_acquire) && m_window->frameMargins().isNull();
+    if (pair != m_pair.load(std::memory_order_relaxed)) {
+        m_pair.store(pair, std::memory_order_release);
+        m_window->setProperty(PairProperty, pair);
+    }
+    return pair;
+}
+
+void QQuickWindowStereo::setEye(Eye eye)
+{
+    if (eye == m_eye)
+        return;
+
+    const QQuickWindow *settingEye = std::exchange(t_settingEye, m_window);
+    m_eye = eye;
+    // The style draws what the eye shows of its elements; their parallax may move with it.
+    m_window->setProperty(EyeProperty, int(eye));
+    placeItems();
+    t_settingEye = settingEye;
+}
+
+qreal QQuickWindowStereo::referenceParallax(const QQuickItem *item) const
+{
+    for (const QQuickItem *parent = item->parentItem(); parent; parent = parent->parentItem()) {
+        auto it = m_items.constFind(parent);
+        if (it != m_items.cend())
+            return it->parallax;
+    }
+    // The window lies at the screen.
+    return 0;
+}
+
+void QQuickWindowStereo::placeItems()
+{
+    const qreal devicePixelRatio = std::max(m_window->effectiveDevicePixelRatio(), qreal(1e-3));
+    for (auto it = m_items.begin(); it != m_items.end(); ++it) {
+        QQuickItem *item = const_cast<QQuickItem *>(it.key());
+        Placement placement;
+        if (m_eye != Eye::None) {
+            const qreal reference = referenceParallax(item);
+            const qreal move = (eyeShift(it->parallax, m_eye) - eyeShift(reference, m_eye)) / devicePixelRatio;
+            if (move != 0) {
+                const QQuickItemPrivate *itemPrivate = QQuickItemPrivate::get(item);
+                const QTransform parentToWindow = item->parentItem()
+                        ? QQuickItemPrivate::get(item->parentItem())->itemToWindowTransform()
+                        : QTransform();
+                placement.shift = mapMove(parentToWindow, QPointF(move, 0));
+                // Deeper than what it lies on, the item is seen through its own opening, which
+                // stays where the item is in 2D: as the frame of a window cuts the view through it.
+                if (it->parallax < reference) {
+                    placement.cut = true;
+                    placement.opening = mapMove(itemPrivate->itemToWindowTransform(), QPointF(-move, 0));
+                }
+            }
+        }
+        if (placement == it->placement)
+            continue;
+        const bool clip = placement.cut != it->placement.cut || placement.opening != it->placement.opening;
+        it->placement = placement;
+        dirtyItem(item, clip);
+    }
+}
+
+void QQuickWindowStereo::dirtyItem(QQuickItem *item, bool clip)
+{
+    // Only the item's nodes change: its geometry, and so what maps to it, stays as in 2D.
+    QQuickItemPrivate *itemPrivate = QQuickItemPrivate::get(item);
+    if (!itemPrivate->window || !itemPrivate->componentComplete)
+        return;
+    itemPrivate->dirtyAttributes |= QQuickItemPrivate::Transform;
+    if (clip)
+        itemPrivate->dirtyAttributes |= QQuickItemPrivate::Clip;
+    itemPrivate->addToDirtyList();
+}
+
+QQuickWindowStereo::Placement QQuickWindowStereo::placement(const QQuickItem *item) const
+{
+    if (m_eye == Eye::None)
+        return {};
+    auto it = m_items.constFind(item);
+    return it == m_items.cend() ? Placement{} : it->placement;
+}
+
+const QQuickWindowStereo *QQuickWindowStereo::placing()
+{
+    return t_placing;
+}
+
+void QQuickWindowStereo::setPlacing(const QQuickWindowStereo *stereo)
+{
+    t_placing = stereo;
+}
+
+bool QQuickWindowStereo::hasRightTarget(QRhiSwapChain *swapchain)
+{
+    return swapchain
+            && swapchain->currentFrameRenderTarget(QRhiSwapChain::RightBuffer)
+                    != swapchain->currentFrameRenderTarget(QRhiSwapChain::LeftBuffer);
+}
+
+QRhiRenderTarget *QQuickWindowStereo::renderTarget(QRhiSwapChain *swapchain) const
+{
+    return m_rightPass ? swapchain->currentFrameRenderTarget(QRhiSwapChain::RightBuffer)
+                       : swapchain->currentFrameRenderTarget();
+}
+
+void QQuickWindowStereo::frameRendered(QRhiSwapChain *swapchain)
+{
+    const bool twoViews = hasRightTarget(swapchain);
+    if (m_twoViews.exchange(twoViews, std::memory_order_acq_rel) != twoViews) {
+        // The next frame can be drawn as a pair, or no longer.
+        QMetaObject::invokeMethod(m_window, [window = QPointer<QQuickWindow>(m_window)] {
+            if (window)
+                window->update();
+        }, Qt::QueuedConnection);
+    }
+}
+
+QT_END_NAMESPACE
