--- a/src/quick/items/qquickwindowstereo.cpp
+++ b/src/quick/items/qquickwindowstereo.cpp
@@ -104,6 +104,14 @@ void QQuickWindowStereo::windowPropertyChanged(QQuickWindow *window, const QByte
 void QQuickWindowStereo::depthChanged()
 {
     m_depth = m_window->property(DepthProperty).toBool();
+    // The window is drawn as a pair again only once its surface has two views (beginFrame()). The pair
+    // ends before the request changes: a platform reads the window's _q_stereo_pair with it, as the
+    // mark of an engine that composes its pair into one picture (the Wayland EGL window, for Qt
+    // Widgets), which a window that draws into two views is not.
+    if (m_pair.load(std::memory_order_relaxed)) {
+        m_pair.store(false, std::memory_order_release);
+        m_window->setProperty(PairProperty, false);
+    }
     // The platform gives the surface its views at the start of a frame.
     m_window->setProperty(ViewsProperty, m_depth ? QVariant(2) : QVariant());
     m_window->update();
@@ -166,8 +174,10 @@ void QQuickWindowStereo::removeItem(QQuickItem *item)
 
 bool QQuickWindowStereo::beginFrame()
 {
-    // A window with client-side decorations is drawn once: its frame is no part of the pair.
-    const bool pair = m_depth && m_twoViews.load(std::memory_order_acquire) && m_window->frameMargins().isNull();
+    // A frame the client draws around the window (client-side decorations) is no part of the pair: the
+    // platform draws it into both eyes when it says so, and otherwise the window is drawn once.
+    const bool pair = m_depth && m_twoViews.load(std::memory_order_acquire)
+            && (m_window->frameMargins().isNull() || m_window->property(FramedPairProperty).toBool());
     if (pair != m_pair.load(std::memory_order_relaxed)) {
         m_pair.store(pair, std::memory_order_release);
         m_window->setProperty(PairProperty, pair);
