-    component.setData(s_scene, QUrl());
+    component.setData(source ? source : s_scene, QUrl());
     scene.window.reset(qobject_cast<QQuickWindow *>(component.create()));
     if (!scene.window) {
         qWarning() << component.errors();
@@ -373,6 +388,41 @@ void tst_QQuickWindowStereo::drawsThePairAfterAnExpose()
     QCOMPARE(scene.window->property(EyeProperty).toInt(), 0);
 }
 
+// A window inside the frame the client draws around it is drawn as a pair where the platform draws that frame into
+// both eyes (_q_stereo_csd_pair_supported). Its pair ends with any change of its depth, before the request for views
+// changes: the platform reads _q_stereo_pair with that request, as the mark of an engine that composes its pair into
+// one picture.
+void tst_QQuickWindowStereo::drawsAFramedWindowAsAPair()
+{
+    if (qEnvironmentVariableIntValue("QTEST_STEREO_TWO_VIEWS") != 1)
+        QSKIP("Needs a platform that gives a surface two views (QTEST_STEREO_TWO_VIEWS=1)");
+    if (isSoftware())
+        QSKIP("The software renderer draws a window once");
+
+    Scene scene = makeScene(s_framedScene);
+    QVERIFY(scene.window);
+    scene.near->setProperty(ParallaxProperty, 4.0);
+    scene.deep->setProperty(ParallaxProperty, -4.0);
+    scene.window->show();
+    QVERIFY(QTest::qWaitForWindowExposed(scene.window.get()));
+    if (scene.window->frameMargins().isNull())
+        QSKIP("Needs a frame the client draws around the window (a compositor without server-side decorations)");
+    if (!scene.window->property("_q_stereo_csd_pair_supported").toBool())
+        QSKIP("Needs a platform that draws the frame into both eyes");
+
+    scene.window->setProperty(DepthProperty, true);
+    QTRY_VERIFY_WITH_TIMEOUT(scene.window->property(PairProperty).toBool(), 5000);
+
+    // Flat and back in one turn of the event loop.
+    scene.window->setProperty(DepthProperty, false);
+    QVERIFY(!scene.window->property(PairProperty).toBool());
+    scene.window->setProperty(DepthProperty, true);
+    QVERIFY(!scene.window->property(PairProperty).toBool());
+    QTRY_VERIFY_WITH_TIMEOUT(scene.window->property(PairProperty).toBool(), 5000);
+    QTest::qWait(200);
+    QVERIFY(scene.window->isExposed());
+}
+
 QTEST_MAIN(tst_QQuickWindowStereo)
 
