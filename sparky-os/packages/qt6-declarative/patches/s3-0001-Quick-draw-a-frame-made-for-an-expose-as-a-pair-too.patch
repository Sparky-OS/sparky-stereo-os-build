+// A frame drawn for an expose is a pair like any other: a still window is not drawn again, and
+// would keep one picture in both eyes.
+void tst_QQuickWindowStereo::drawsThePairAfterAnExpose()
+{
+    if (qEnvironmentVariableIntValue("QTEST_STEREO_TWO_VIEWS") != 1)
+        QSKIP("Needs a platform that gives a surface two views (QTEST_STEREO_TWO_VIEWS=1)");
+    if (isSoftware())
+        QSKIP("The software renderer draws a window once");
+
+    Scene scene = makeScene();
+    QVERIFY(scene.window);
+    scene.near->setProperty(ParallaxProperty, 4.0);
+
+    // What each pass drew the red square at, and when a frame was presented (-1).
+    QMutex mutex;
+    QList<qreal> passes;
+    QQuickItemPrivate *nearPrivate = QQuickItemPrivate::get(scene.near);
+    connect(scene.window.get(), &QQuickWindow::beforeRendering, scene.window.get(), [&] {
+        QMutexLocker locker(&mutex);
+        passes.append(nearPrivate->itemNode()->matrix()(0, 3));
+    }, Qt::DirectConnection);
+    connect(scene.window.get(), &QQuickWindow::frameSwapped, scene.window.get(), [&] {
+        QMutexLocker locker(&mutex);
+        passes.append(-1);
+    }, Qt::DirectConnection);
+    // The frames presented from a pass on, each as its passes.
+    const auto framesFrom = [&](qsizetype from) {
+        QMutexLocker locker(&mutex);
+        QList<QList<qreal>> frames(1);
+        for (qsizetype i = from; i < passes.size(); ++i) {
+            if (passes.at(i) < 0)
+                frames.append(QList<qreal>());
+            else
+                frames.last().append(passes.at(i));
+        }
+        frames.removeLast(); // not presented
+        return frames;
+    };
+    const auto passCount = [&] {
+        QMutexLocker locker(&mutex);
+        return passes.size();
+    };
+
+    scene.window->show();
+    QVERIFY(QTest::qWaitForWindowExposed(scene.window.get()));
+    scene.window->setProperty(DepthProperty, true);
+    QTRY_VERIFY_WITH_TIMEOUT(scene.window->property(PairProperty).toBool(), 5000);
+    scene.window->update();
+    QTest::qWait(500);
+
+    // The window is still: nothing but the expose asks for a frame, and that frame stays.
+    const qsizetype from = passCount();
+    QWindowSystemInterface::handleExposeEvent(scene.window.get(), QRect(QPoint(), scene.window->size()));
+    QTRY_VERIFY_WITH_TIMEOUT(!framesFrom(from).isEmpty(), 5000);
+    QTest::qWait(500);
+    const auto frames = framesFrom(from);
+    for (const auto &frame : frames)
+        QCOMPARE(frame, QList<qreal>({22, 18}));
+    QCOMPARE(scene.window->property(EyeProperty).toInt(), 0);
+}
+
 QTEST_MAIN(tst_QQuickWindowStereo)
 
