--- /dev/null
+++ b/src/wsi/wsi_wine_stereo.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include "wsi_window.h"
+#include "../util/log/log.h"
+
+namespace dxvk::wsi {
+
+  // A synchronous, versioned Wine WSI request. The native surface owns the
+  // content declaration; this temporary Win32 property is not a declaration.
+  class WineStereoSurface {
+  public:
+    WineStereoSurface(HWND window, bool packed)
+#ifdef _WIN32
+    : m_window(window), m_enabled(packed)
+#endif
+    {
+#ifdef _WIN32
+      if (m_enabled) {
+        swprintf(m_name, 64, L"__wine_vulkan_stereo_v1_%08x", GetCurrentThreadId());
+        m_previous = GetPropW(m_window, m_name);
+        m_requested = SetPropW(m_window, m_name, reinterpret_cast<HANDLE>(0x10003));
+      }
+#endif
+    }
+
+    ~WineStereoSurface() {
+#ifdef _WIN32
+      if (m_requested) {
+        if (m_previous)
+          SetPropW(m_window, m_name, m_previous);
+        else
+          RemovePropW(m_window, m_name);
+      }
+#endif
+    }
+
+    void complete(VkResult result) const {
+#ifdef _WIN32
+      if (m_enabled && result == VK_SUCCESS) {
+        const bool accepted = m_requested
+          && GetPropW(m_window, m_name) == reinterpret_cast<HANDLE>(0x18003);
+        Logger::info(accepted ? "Wine stereo WSI v1: acknowledged"
+                              : "Wine stereo WSI v1: ordinary WSI fallback");
+      }
+#endif
+    }
+
+    WineStereoSurface(const WineStereoSurface&) = delete;
+    WineStereoSurface& operator=(const WineStereoSurface&) = delete;
+
+  private:
+#ifdef _WIN32
+    HWND m_window;
+    bool m_enabled;
+    bool m_requested = false;
+    HANDLE m_previous = nullptr;
+    wchar_t m_name[64] = { };
+#endif
+  };
+
+}
