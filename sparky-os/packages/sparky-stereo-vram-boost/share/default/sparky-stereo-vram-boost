# Protect the program in front only when the person opts in.
# no: off (default). yes: every GPU with a registered dmem region, NVIDIA included.
# amd-dgpu: amdgpu devices with their own VRAM only. The retired auto value means off.
# Change this choice in System Settings, Graphics. It takes effect after a restart.
# Background programs give up video memory first; the program in front gets a higher CPU priority.
SPARKY_STEREO_VRAM_BOOST=no
