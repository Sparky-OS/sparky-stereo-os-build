From dd0c7682dabbeed4d95d4171f65b49fab7e57eb7 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Fri, 30 Oct 2026 04:00:00 -0300
Subject: [PATCH] kcm: State what the sunk effect costs the lock screen's
 wallpaper

On a screen in one of Stereo KWin's 3D modes the lock screen's wallpaper
lies behind the screen, as the desktop's does, and keeps its size, so the
columns only one eye would see are cut at both sides. Under the wallpaper
type the Appearance page now says how many pixels of the wallpaper's
width are lost and how many at each side, for each screen by name when
there are several, and that videos with pop effects are not expected to
be comfortable with widgets or other things over them.

The number is KWin's, read from WallpaperCuts on org.kde.KWin.StereoDepth
and read again when KWin announces a change, so it follows the user's
Background depth and each screen's own width and mode. On a 2D screen,
at a depth of 0 or with a KWin that publishes nothing, nothing is lost
and nothing is said.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 kcm/kcm.cpp           | 41 +++++++++++++++++++++++++++++++++++++++++
 kcm/kcm.h             | 12 ++++++++++++
 kcm/ui/Appearance.qml | 22 ++++++++++++++++++++++
 3 files changed, 75 insertions(+)

diff --git a/kcm/kcm.cpp b/kcm/kcm.cpp
index b2ddee52..4569efff 100644
--- a/kcm/kcm.cpp
+++ b/kcm/kcm.cpp
@@ -17,6 +17,12 @@ SPDX-License-Identifier: GPL-2.0-or-later
 #include <KLocalizedString>
 #include <KPluginFactory>
 
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusMetaType>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDBusVariant>
 #include <QList>
 
 K_PLUGIN_FACTORY_WITH_JSON(ScreenLockerKcmFactory, "kcm_screenlocker.json", registerPlugin<ScreenLockerKcm>(); registerPlugin<KScreenLockerData>();)
@@ -47,6 +53,41 @@ ScreenLockerKcm::ScreenLockerKcm(QObject *parent, const KPluginMetaData &data)
             m_appearanceSettings,
             &AppearanceSettings::loadWallpaperConfig);
     connect(m_appearanceSettings, &AppearanceSettings::currentWallpaperChanged, this, &ScreenLockerKcm::currentWallpaperChanged);
+
+    // what the sunk effect costs the wallpaper on each screen, in KWin's own numbers
+    qDBusRegisterMetaType<QMap<QString, int>>();
+    QDBusConnection::sessionBus().connect(QStringLiteral("org.kde.KWin"),
+                                          QStringLiteral("/org/kde/KWin/StereoDepth"),
+                                          QStringLiteral("org.freedesktop.DBus.Properties"),
+                                          QStringLiteral("PropertiesChanged"),
+                                          this,
+                                          SLOT(updateWallpaperCuts()));
+    updateWallpaperCuts();
+}
+
+void ScreenLockerKcm::updateWallpaperCuts()
+{
+    QDBusMessage message = QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"),
+                                                          QStringLiteral("/org/kde/KWin/StereoDepth"),
+                                                          QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                          QStringLiteral("Get"));
+    message << QStringLiteral("org.kde.KWin.StereoDepth") << QStringLiteral("WallpaperCuts");
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        const QDBusPendingReply<QDBusVariant> reply = *watcher;
+        QVariantList cuts;
+        if (!reply.isError()) {
+            const auto outputs = qdbus_cast<QMap<QString, int>>(reply.value().variant());
+            for (auto it = outputs.cbegin(); it != outputs.cend(); ++it) {
+                cuts.append(QVariantMap{{QStringLiteral("name"), it.key()}, {QStringLiteral("cut"), it.value()}});
+            }
+        }
+        if (cuts != m_wallpaperCuts) {
+            m_wallpaperCuts = cuts;
+            Q_EMIT wallpaperCutsChanged();
+        }
+    });
 }
 
 void ScreenLockerKcm::load()
diff --git a/kcm/kcm.h b/kcm/kcm.h
index 810c03ee..27a7803a 100644
--- a/kcm/kcm.h
+++ b/kcm/kcm.h
@@ -37,6 +37,12 @@ public:
     Q_PROPERTY(ScreenLocker::WallpaperIntegration *wallpaperIntegration READ wallpaperIntegration NOTIFY currentWallpaperChanged)
     Q_PROPERTY(QString currentWallpaper READ currentWallpaper NOTIFY currentWallpaperChanged)
     Q_PROPERTY(bool isDefaultsAppearance READ isDefaultsAppearance NOTIFY isDefaultsAppearanceChanged)
+    /**
+     * How many columns the wallpaper loses at each side to the sunk effect on each screen, as
+     * KWin works it out from the Background depth and the screen's own width and mode: a list of
+     * maps with the screen's "name" and the "cut", 0 on a screen in 2D.
+     */
+    Q_PROPERTY(QVariantList wallpaperCuts MEMBER m_wallpaperCuts NOTIFY wallpaperCutsChanged)
 
     Q_INVOKABLE QList<WallpaperInfo> availableWallpaperPlugins()
     {
@@ -67,11 +73,16 @@ Q_SIGNALS:
 
     void isDefaultsAppearanceChanged();
 
+    void wallpaperCutsChanged();
+
     /**
      * Emitted when the load function is called.
      */
     void loadCalled();
 
+private Q_SLOTS:
+    void updateWallpaperCuts();
+
 private:
     bool isSaveNeeded() const override;
     bool isDefaults() const override;
@@ -83,4 +94,5 @@ private:
     AppearanceSettings *m_appearanceSettings;
     QString m_currentWallpaper;
     bool m_forceUpdateState = false;
+    QVariantList m_wallpaperCuts;
 };
diff --git a/kcm/ui/Appearance.qml b/kcm/ui/Appearance.qml
index f96619d9..c37a75a3 100644
--- a/kcm/ui/Appearance.qml
+++ b/kcm/ui/Appearance.qml
@@ -53,6 +53,28 @@ Kirigami.ScrollablePage {
                     settingName: "wallpaperPluginId"
                 }
             }
+
+            QQC2.Label {
+                // On a screen in a 3D mode the lock screen's wallpaper lies behind the screen, as
+                // the desktop's does, and keeps its size, so the columns only one eye would see are
+                // cut at both sides; KWin says how many for each screen. The screens are named when
+                // there are several.
+                readonly property var lost: kcm.wallpaperCuts.filter(screen => screen.cut > 0)
+                visible: lost.length > 0
+                Layout.fillWidth: true
+                Layout.maximumWidth: Kirigami.Units.gridUnit * 25
+                wrapMode: Text.Wrap
+                text: lost.map(screen => kcm.wallpaperCuts.length > 1
+                               ? i18ncp("@info %1 is a number of pixels, %2 how many of them at each side, %3 a screen's name",
+                                        "%3: %1 pixel of the wallpaper's width will be lost to the sunk effect, %2 at each side.",
+                                        "%3: %1 pixels of the wallpaper's width will be lost to the sunk effect, %2 at each side.",
+                                        2 * screen.cut, screen.cut, screen.name)
+                               : i18ncp("@info %1 is a number of pixels, %2 how many of them at each side",
+                                        "%1 pixel of the wallpaper's width will be lost to the sunk effect, %2 at each side.",
+                                        "%1 pixels of the wallpaper's width will be lost to the sunk effect, %2 at each side.",
+                                        2 * screen.cut, screen.cut)).join("\n")
+                      + "\n" + i18nc("@info", "Videos with pop effects are not expected to be comfortable with widgets or other things over it.")
+            }
         }
 
         WallpaperConfig {
