+
+// The lock screen's wallpaper is a wallpaper: on a stereo screen that shows depth, Stereo KWin draws it behind the
+// screen, as it draws the desktop's, while the clock, the password field and the rest of the interface stay at the
+// screen. It can only do that when the wallpaper is a surface of its own, below the interface's: the wallpaper's
+// window (createViewForScreen()), which the edition's Qt Wayland places below its parent for
+// Qt::WindowStaysOnBottomHint, and says so (_q_wayland_below_parent). The wallpaper goes there while the view is on
+// such a screen (the compositor says the view is awake, kde_stereo_depth_v1) and the user's Background depth (kwinrc
+// [StereoDepth] SunkLimit, 10 by default in KWin) is above zero, and the stereo show is not on; otherwise it stays in
+// the interface's window, drawn exactly as before. The lock screen's fader draws a copy of the wallpaper and goes with
+// it (wallpaperLayer).
+void UnlockApp::updateWallpaperLayer(PlasmaQuick::QuickViewSharedEngine *view)
+{
+    auto *wallpaperWindow = view->property("wallpaperWindow").value<QQuickWindow *>();
+    auto *object = view->property("wallpaperGraphicsObject").value<PlasmaQuick::SharedQmlEngine *>();
+    auto *item = object ? qobject_cast<QQuickItem *>(object->rootObject()) : nullptr;
+    if (!wallpaperWindow || !item) {
+        return;
+    }
+    bool layered = view->property("stereoDepthAwake").toBool() && m_sunkLimit > 0 && !wallpaperWindow->property("wallpaperLayerRefused").toBool();
+#ifdef HAVE_STEREO_SHOW
+    if (auto *stereoBackground = view->property("stereoBackground").value<StereoBackground *>()) {
+        layered = layered && !stereoBackground->active();
+    }
+#endif
+    if (layered == view->property("wallpaperLayered").toBool()) {
+        return;
+    }
+    if (layered) {
+        // only a Qt that places the window below its parent says so; elsewhere it would cover the interface
+        wallpaperWindow->setVisible(true);
+        if (!wallpaperWindow->property("_q_wayland_below_parent").toBool()) {
+            qCWarning(KSCREENLOCKER_GREET) << "This Qt cannot place the wallpaper below the lock screen; it stays in the lock screen's window";
+            wallpaperWindow->setVisible(false);
+            wallpaperWindow->setProperty("wallpaperLayerRefused", true);
+            return;
+        }
+    }
+    view->setProperty("wallpaperLayered", layered);
+    // An item belongs to one window at a time, and the fader's blur samples the wallpaper from the fader's window:
+    // take the wallpaper out of its window, move the fader, then put the wallpaper into the fader's window, so that
+    // nothing refers to it from the other window while it moves.
+    item->setParentItem(nullptr);
+    view->rootContext()->setContextProperty(QStringLiteral("wallpaperLayer"), layered ? wallpaperWindow->contentItem() : nullptr);
+    item->setParentItem(layered ? wallpaperWindow->contentItem() : view->rootObject());
+    QQmlExpression expr(object->engine()->rootContext(), item, QStringLiteral("parent"));
+    QQmlProperty(item, QStringLiteral("anchors.fill")).write(expr.evaluate());
+    view->setColor(layered ? Qt::transparent : Qt::black);
+    wallpaperWindow->setVisible(layered);
+}
+
+#ifdef HAVE_STEREO_DECLARE
+static void stereoDepthChanged(void *data, struct wl_surface *, const struct stereo_depth_state *state)
+{
+    auto *view = static_cast<PlasmaQuick::QuickViewSharedEngine *>(data);
+    view->setProperty("stereoDepthAwake", state->awake != 0);
+    QMetaObject::invokeMethod(qApp, [view] {
+        static_cast<UnlockApp *>(qApp)->updateWallpaperLayer(view);
+    }, Qt::QueuedConnection);
+}
+#endif
+
+// Hears from the compositor whether the view is on a stereo screen that shows depth.
+void UnlockApp::followStereoDepth(PlasmaQuick::QuickViewSharedEngine *view)
+{
+#ifdef HAVE_STEREO_DECLARE
+    auto *application = nativeInterface<QNativeInterface::QWaylandApplication>();
+    // on Wayland a window's id is its wl_surface
+    auto *surface = reinterpret_cast<wl_surface *>(view->winId());
+    if (!application || !surface) {
+        return;
+    }
+    static bool initialized = false;
+    if (!initialized) {
+        initialized = true;
+        // once on this thread; Qt's event loop dispatches the default queue (-EBUSY: another part already started it)
+        stereo_declare_wayland_init(application->display(), nullptr);
+        wl_display_roundtrip(application->display());
+    }
+    if (stereo_depth_wayland_watch(surface, stereoDepthChanged, view) == 0) {
+        connect(view, &QObject::destroyed, this, [surface] {
+            stereo_depth_wayland_unwatch(surface);
+        });
+    }
+#else
+    Q_UNUSED(view)
+#endif
 }
 
 void UnlockApp::initialViewSetup()
 {
+    // the user's Background depth (System Settings, 3D Depth), which KWin reads from kwinrc; 10 is KWin's default.
+    // It cannot change while the screen is locked, and the greeter starts again at each lock.
+    m_sunkLimit = KConfigGroup(KSharedConfig::openConfig(QStringLiteral("kwinrc")), QStringLiteral("StereoDepth")).readEntry("SunkLimit", 10);
+
     qmlRegisterUncreatableType<PamAuthenticator>("org.kde.kscreenlocker",
                                                  1,
                                                  0,
@@ -326,6 +425,25 @@ PlasmaQuick::QuickViewSharedEngine *UnlockApp::createViewForScreen(QScreen *scre
         }
     }
 
+    // the wallpaper's own window, below the interface's (updateWallpaperLayer())
+    if (KWindowSystem::isPlatformWayland()) {
+        auto *wallpaperWindow = new QQuickWindow();
+        wallpaperWindow->setParent(view);
+        wallpaperWindow->setFlags(Qt::FramelessWindowHint | Qt::WindowTransparentForInput | Qt::WindowStaysOnBottomHint);
+        auto wallpaperFormat = wallpaperWindow->format();
+        wallpaperFormat.setAlphaBufferSize(8);
+        wallpaperWindow->setFormat(wallpaperFormat);
+        wallpaperWindow->setColor(Qt::black);
+        wallpaperWindow->setGeometry(QRect(QPoint(0, 0), view->size()));
+        connect(view, &QWindow::widthChanged, wallpaperWindow, [view, wallpaperWindow] {
+            wallpaperWindow->resize(view->size());
+        });
+        connect(view, &QWindow::heightChanged, wallpaperWindow, [view, wallpaperWindow] {
+            wallpaperWindow->resize(view->size());
+        });
+        view->setProperty("wallpaperWindow", QVariant::fromValue(wallpaperWindow));
+    }
+
     if (m_ksldInterface) {
         view->create();
         org_kde_ksld_x11window(m_ksldInterface, view->winId());
@@ -400,11 +518,13 @@ PlasmaQuick::QuickViewSharedEngine *UnlockApp::createViewForScreen(QScreen *scre
     }
     auto *stereoBackground = new StereoBackground(view, session->client());
     view->rootContext()->setContextProperty(QStringLiteral("stereoBackground"), stereoBackground);
+    view->setProperty("stereoBackground", QVariant::fromValue(stereoBackground));
     if (wallpaperObj) {
         auto *item = qobject_cast<QQuickItem *>(wallpaperObj->rootObject());
         if (item) {
-            connect(stereoBackground, &StereoBackground::activeChanged, item, [item, stereoBackground] {
+            connect(stereoBackground, &StereoBackground::activeChanged, item, [this, view, item, stereoBackground] {
                 item->setVisible(!stereoBackground->active());
+                updateWallpaperLayer(view);
             });
         }
     }
@@ -454,6 +574,7 @@ PlasmaQuick::QuickViewSharedEngine *UnlockApp::createViewForScreen(QScreen *scre
     // showFullScreen is implicit on X11 (through geometry and hints) and Wayland (layer-shell)
     view->show();
     view->raise();
+    followStereoDepth(view);
 
     auto onFrameSwapped = [this, view] {
         markViewsAsVisible(view);
