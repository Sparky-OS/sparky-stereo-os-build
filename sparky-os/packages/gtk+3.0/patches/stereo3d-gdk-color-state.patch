+++ b/gdk/gdkcolorstate.h
@@ -0,0 +1,153 @@
+/* GDK - The GIMP Drawing Kit
+ *
+ * gdkcolorstate.h: the depth and the colour state of a picture
+ *
+ * Copyright 2026 Daniel Campos Ramos
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef __GDK_COLOR_STATE_H__
+#define __GDK_COLOR_STATE_H__
+
+#if !defined (__GDK_H_INSIDE__) && !defined (GDK_COMPILATION)
+#error "Only <gdk/gdk.h> can be included directly."
+#endif
+
+#include <gdk/gdkversionmacros.h>
+#include <glib-object.h>
+
+G_BEGIN_DECLS
+
+/**
+ * GdkMemoryFormat:
+ * @GDK_MEMORY_R8G8B8A8_PREMULTIPLIED: 8 bits a channel, red first, alpha premultiplied
+ * @GDK_MEMORY_R16G16B16A16_PREMULTIPLIED: 16 bits a channel, unsigned and normalized, alpha premultiplied
+ * @GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED: half float channels, alpha premultiplied
+ * @GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED: single float channels, alpha premultiplied
+ * @GDK_MEMORY_ABGR2101010_PREMULTIPLIED: 10 bits for each colour and 2 for alpha in one 32 bit word, red in the
+ *   lowest bits, alpha premultiplied
+ *
+ * The layout of a picture's samples in memory: the depth a #GtkGLArea renders at.
+ *
+ * The names and values are GTK 4's, so a program says the same in both. GDK 3 has only the formats a picture is
+ * rendered in: the depths of the deep colour standard (10, 12 and 16 bits a channel) are held by the 10 bit, the 16
+ * bit and the float formats, 12 bits by a 16 bit or a float one.
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+typedef enum {
+  GDK_MEMORY_R8G8B8A8_PREMULTIPLIED = 2,
+  GDK_MEMORY_R16G16B16A16_PREMULTIPLIED = 10,
+  GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED = 13,
+  GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED = 16,
+  GDK_MEMORY_ABGR2101010_PREMULTIPLIED = 68
+} GdkMemoryFormat;
+
+/**
+ * GdkCicpRange:
+ * @GDK_CICP_RANGE_NARROW: the values use the range of 16 to 235 (for Y) and 16 to 240 for U and V
+ * @GDK_CICP_RANGE_FULL: the values use the full range
+ *
+ * Whether the samples of a picture use the full range of their values (ITU-T H.273, VideoFullRangeFlag).
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+typedef enum {
+  GDK_CICP_RANGE_NARROW,
+  GDK_CICP_RANGE_FULL
+} GdkCicpRange;
+
+/**
+ * GdkColorState:
+ *
+ * The colour state of a picture: how its values are meant, as the code points of ITU-T H.273 (colour primaries,
+ * transfer characteristics, matrix coefficients, range).
+ *
+ * A colour state is a description, not a conversion: a program writes its values in that state, and GTK hands the
+ * description on with the picture.
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+typedef struct _GdkColorState GdkColorState;
+
+#define GDK_TYPE_COLOR_STATE (gdk_color_state_get_type ())
+
+GDK_AVAILABLE_IN_ALL
+GType           gdk_color_state_get_type                (void) G_GNUC_CONST;
+GDK_AVAILABLE_IN_ALL
+GdkColorState * gdk_color_state_ref                     (GdkColorState  *self);
+GDK_AVAILABLE_IN_ALL
+void            gdk_color_state_unref                   (GdkColorState  *self);
+GDK_AVAILABLE_IN_ALL
+GdkColorState * gdk_color_state_get_srgb                (void);
+GDK_AVAILABLE_IN_ALL
+GdkColorState * gdk_color_state_get_srgb_linear         (void);
+GDK_AVAILABLE_IN_ALL
+GdkColorState * gdk_color_state_get_rec2100_pq          (void);
+GDK_AVAILABLE_IN_ALL
+GdkColorState * gdk_color_state_get_rec2100_linear      (void);
+GDK_AVAILABLE_IN_ALL
+gboolean        gdk_color_state_equal                   (GdkColorState  *self,
+                                                         GdkColorState  *other);
+
+/**
+ * GdkCicpParams:
+ *
+ * The four code points of ITU-T H.273 that make a #GdkColorState.
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+#define GDK_TYPE_CICP_PARAMS (gdk_cicp_params_get_type ())
+#define GDK_CICP_PARAMS(o) (G_TYPE_CHECK_INSTANCE_CAST ((o), GDK_TYPE_CICP_PARAMS, GdkCicpParams))
+#define GDK_IS_CICP_PARAMS(o) (G_TYPE_CHECK_INSTANCE_TYPE ((o), GDK_TYPE_CICP_PARAMS))
+
+typedef struct _GdkCicpParams GdkCicpParams;
+typedef struct _GdkCicpParamsClass GdkCicpParamsClass;
+
+GDK_AVAILABLE_IN_ALL
+GType           gdk_cicp_params_get_type                (void) G_GNUC_CONST;
+GDK_AVAILABLE_IN_ALL
+GdkCicpParams * gdk_cicp_params_new                     (void);
+GDK_AVAILABLE_IN_ALL
+guint           gdk_cicp_params_get_color_primaries     (GdkCicpParams  *self);
+GDK_AVAILABLE_IN_ALL
+void            gdk_cicp_params_set_color_primaries     (GdkCicpParams  *self,
+                                                         guint           color_primaries);
+GDK_AVAILABLE_IN_ALL
+guint           gdk_cicp_params_get_transfer_function   (GdkCicpParams  *self);
+GDK_AVAILABLE_IN_ALL
+void            gdk_cicp_params_set_transfer_function   (GdkCicpParams  *self,
+                                                         guint           transfer_function);
+GDK_AVAILABLE_IN_ALL
+guint           gdk_cicp_params_get_matrix_coefficients (GdkCicpParams  *self);
+GDK_AVAILABLE_IN_ALL
+void            gdk_cicp_params_set_matrix_coefficients (GdkCicpParams  *self,
+                                                         guint           matrix_coefficients);
+GDK_AVAILABLE_IN_ALL
+GdkCicpRange    gdk_cicp_params_get_range               (GdkCicpParams  *self);
+GDK_AVAILABLE_IN_ALL
+void            gdk_cicp_params_set_range               (GdkCicpParams  *self,
+                                                         GdkCicpRange    range);
+GDK_AVAILABLE_IN_ALL
+GdkColorState * gdk_cicp_params_build_color_state       (GdkCicpParams  *self,
+                                                         GError        **error);
+GDK_AVAILABLE_IN_ALL
+GdkCicpParams * gdk_color_state_create_cicp_params      (GdkColorState  *self);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (GdkCicpParams, g_object_unref)
+
+G_END_DECLS
+
+#endif /* __GDK_COLOR_STATE_H__ */
diff --git a/gdk/meson.build b/gdk/meson.build
index 297c38c..069eb62 100644
--- a/gdk/meson.build
+++ b/gdk/meson.build
@@ -4,6 +4,7 @@ gdk_sources = files(
   'gdk.c',
