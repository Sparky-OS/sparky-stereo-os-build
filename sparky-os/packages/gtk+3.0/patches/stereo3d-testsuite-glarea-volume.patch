+/* Luminances, mastering display and content light levels (+stereo3d2): unset by default, set, read and unset again */
+static void
+test_volume (void)
+{
+  GtkGLArea *area = GTK_GL_AREA (g_object_ref_sink (gtk_gl_area_new ()));
+  const double bt2020[8] = { 0.708, 0.292, 0.170, 0.797, 0.131, 0.046, 0.3127, 0.3290 };
+  double min = 0, max = 0, reference = 0, primaries[8], cll = 0, fall = 0;
+
+  g_assert_false (gtk_gl_area_get_luminances (area, &min, &max, &reference));
+  g_assert_cmpfloat (reference, <, 0);
+  g_assert_false (gtk_gl_area_get_mastering_display (area, primaries, &min, &max));
+  gtk_gl_area_get_content_light_levels (area, &cll, &fall);
+  g_assert_cmpfloat (cll, <, 0);
+  g_assert_cmpfloat (fall, <, 0);
+
+  gtk_gl_area_set_luminances (area, 0.005, 10000, 203);
+  g_assert_true (gtk_gl_area_get_luminances (area, &min, &max, &reference));
+  g_assert_cmpfloat (min, ==, 0.005);
+  g_assert_cmpfloat (max, ==, 10000);
+  g_assert_cmpfloat (reference, ==, 203);
+
+  gtk_gl_area_set_mastering_display (area, bt2020, 0.005, 1000);
+  g_assert_true (gtk_gl_area_get_mastering_display (area, primaries, &min, &max));
+  g_assert_cmpmem (primaries, sizeof primaries, bt2020, sizeof bt2020);
+  g_assert_cmpfloat (max, ==, 1000);
+
+  gtk_gl_area_set_content_light_levels (area, 1000, 400);
+  gtk_gl_area_get_content_light_levels (area, &cll, &fall);
+  g_assert_cmpfloat (cll, ==, 1000);
+  g_assert_cmpfloat (fall, ==, 400);
+
+  gtk_gl_area_set_luminances (area, -1, -1, -1);
+  gtk_gl_area_set_mastering_display (area, NULL, -1, -1);
+  gtk_gl_area_set_content_light_levels (area, -1, -1);
+  g_assert_false (gtk_gl_area_get_luminances (area, NULL, NULL, NULL));
+  g_assert_false (gtk_gl_area_get_mastering_display (area, NULL, NULL, NULL));
+
   g_object_unref (area);
 }
 
@@ -181,6 +226,54 @@ test_stereo_unavailable (void)
   gtk_widget_destroy (window);
 }
 
+/* A plain area deeper than 8 bits needs a surface of its own (+stereo3d2); an X window holds 8 bits and no description,
+ * so on X11 it says why and renders its picture into its window */
+static void
+test_plain_deep_x11 (void)
+{
+  GtkWidget *window;
+  GtkWidget *area;
+  RenderLog log = { { 0, 0, 0 }, FALSE };
+  guint timeout;
+
+#ifdef GDK_WINDOWING_X11
+  if (!GDK_IS_X11_DISPLAY (gdk_display_get_default ()))
+#endif
+    {
+      g_test_skip ("The case is for an X11 display");
+      return;
+    }
+
+  window = gtk_window_new (GTK_WINDOW_TOPLEVEL);
+  area = gtk_gl_area_new ();
+  gtk_widget_set_size_request (area, 64, 48);
+  gtk_container_add (GTK_CONTAINER (window), area);
+  g_signal_connect (area, "render", G_CALLBACK (render_cb), &log);
+  gtk_gl_area_set_format (GTK_GL_AREA (area), GDK_MEMORY_R16G16B16A16_PREMULTIPLIED);
+  gtk_widget_show_all (window);
+
+  timeout = g_timeout_add_seconds (10, time_out, &log);
+  while (!log.timed_out && log.eyes[GTK_GL_AREA_EYE_NONE] == 0 && gtk_gl_area_get_error (GTK_GL_AREA (area)) == NULL)
+    g_main_context_iteration (NULL, TRUE);
+  for (int i = 0; i < 20 && g_main_context_iteration (NULL, FALSE); i++)
+    ;
+
+  if (gtk_gl_area_get_error (GTK_GL_AREA (area)) != NULL)
+    g_test_skip ("No OpenGL on this display");
+  else
+    {
+      g_assert_false (log.timed_out);
+      g_assert_false (gtk_gl_area_get_surface_shown (GTK_GL_AREA (area)));
+      g_assert_nonnull (gtk_gl_area_get_surface_error (GTK_GL_AREA (area)));
+      g_assert_cmpint (log.eyes[GTK_GL_AREA_EYE_NONE], >, 0);
+      g_assert_cmpint (log.eyes[GTK_GL_AREA_EYE_LEFT] + log.eyes[GTK_GL_AREA_EYE_RIGHT], ==, 0);
+    }
+
+  if (!log.timed_out)
+    g_source_remove (timeout);
+  gtk_widget_destroy (window);
+}
+
 int
 main (int argc, char *argv[])
 {
@@ -190,6 +283,8 @@ main (int argc, char *argv[])
   g_test_add_func ("/glarea/setters", test_setters);
   g_test_add_func ("/glarea/cicp", test_cicp);
   g_test_add_func ("/glarea/stereo-unavailable", test_stereo_unavailable);
+  g_test_add_func ("/glarea/volume", test_volume);
+  g_test_add_func ("/glarea/plain-deep-x11", test_plain_deep_x11);
 
   return g_test_run ();
 }
