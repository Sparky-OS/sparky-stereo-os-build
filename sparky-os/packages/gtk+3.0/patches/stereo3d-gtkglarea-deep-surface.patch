+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE, "the compositor offers no wl_shm");
+      return FALSE;
+    }
+
+  for (guint i = 0; i < G_N_ELEMENTS (memory_formats) && found == NULL; i++)
+    {
