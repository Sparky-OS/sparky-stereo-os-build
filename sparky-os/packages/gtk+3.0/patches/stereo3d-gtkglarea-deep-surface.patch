+/**
+ * gtk_gl_area_set_luminances:
+ * @area: a #GtkGLArea
+ * @min_luminance: the minimum luminance of the colour state's range, in
+ *   cd/m², or -1
+ * @max_luminance: the maximum luminance of the range, in cd/m², or -1
+ * @reference_luminance: the luminance of reference white, in cd/m², or -1
+ *
+ * Says the luminances the area's values are given in, which the colour
+ * state's transfer function implies otherwise (wp_color_management_v1's
+ * set_luminances; for ITU-R BT.2100 PQ 0.005, 10000 and 203 cd/m², for sRGB
+ * and linear 0.2, 80 and 80). The maximum and the reference must be above the
+ * minimum. Three values of -1 take the transfer function's own again.
+ *
+ * Since: 3.24.52+stereo3d2
+ */
+void
+gtk_gl_area_set_luminances (GtkGLArea *area,
+                            double     min_luminance,
+                            double     max_luminance,
+                            double     reference_luminance)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  GtkGLAreaVolume before;
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+  g_return_if_fail ((min_luminance < 0 && max_luminance < 0 && reference_luminance < 0) ||
+                    (min_luminance >= 0 && max_luminance > min_luminance && reference_luminance > min_luminance));
+
+  before = priv->volume;
+  if (reference_luminance < 0)
+    priv->volume.min_luminance = priv->volume.max_luminance = priv->volume.reference_luminance = -1;
+  else
+    {
+      priv->volume.min_luminance = min_luminance;
+      priv->volume.max_luminance = max_luminance;
+      priv->volume.reference_luminance = reference_luminance;
+    }
+  gtk_gl_area_volume_changed (area, &before);
+}
