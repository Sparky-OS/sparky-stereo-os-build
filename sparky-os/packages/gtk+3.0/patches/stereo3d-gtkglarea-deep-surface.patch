+/* wl_shm's formats are drm_fourcc.h's codes, except ARGB8888 (0) and XRGB8888 (1) (wayland.xml, wl_shm.format) */
+#define SHM_XRGB8888 1u
+#define SHM_ARGB8888 0u
+
+typedef struct
+{
+  GLenum internal_format;
+  guint32 formats[2];   /* the opaque form first */
+  int bytes;            /* a sample's size */
+  GLenum read_type;
+  gboolean swap_red_blue;
+} MemoryFormat;
+
+/* The wl_shm formats whose samples are OpenGL's RGBA as glReadPixels writes them on a little endian machine (the
+ * fourcc's components from the lowest bits up: R, G, B, then X or A); 8 bit pictures may also go as XRGB8888, the one
+ * 8 bit format every compositor lists (wayland.xml), with red and blue exchanged */
+static const MemoryFormat memory_formats[] = {
+  { GL_RGBA8,    { FOURCC_XB24, FOURCC_AB24 }, 4, GL_UNSIGNED_BYTE, FALSE },
+  { GL_RGBA8,    { SHM_XRGB8888, SHM_ARGB8888 }, 4, GL_UNSIGNED_BYTE, TRUE },
+  { GL_RGB10_A2, { FOURCC_XB30, FOURCC_AB30 }, 4, GL_UNSIGNED_INT_2_10_10_10_REV, FALSE },
+  { GL_RGBA16,   { FOURCC_XB48, FOURCC_AB48 }, 8, GL_UNSIGNED_SHORT, FALSE },
+  { GL_RGBA16F,  { FOURCC_XB4H, FOURCC_AB4H }, 8, GL_HALF_FLOAT, FALSE },
+};
+
+static char *
+shm_format_name (guint32 format)
+{
+  if (format == SHM_XRGB8888)
+    return g_strdup ("XRGB8888");
+  if (format == SHM_ARGB8888)
+    return g_strdup ("ARGB8888");
+  return fourcc_name (format);
+}
