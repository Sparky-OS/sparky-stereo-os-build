+ * @area: a #GtkGLArea
+ * @max_cll: (out) (optional): the maximum content light level, or -1
+ * @max_fall: (out) (optional): the maximum frame-average light level, or -1
+ *
+ * Since: 3.24.52+stereo3d2
+ */
+void
+gtk_gl_area_get_content_light_levels (GtkGLArea *area,
+                                      double    *max_cll,
+                                      double    *max_fall)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+
+  if (max_cll)
+    *max_cll = priv->volume.max_cll;
+  if (max_fall)
+    *max_fall = priv->volume.max_fall;
+}
