+/* One frame of the picture into its wl_shm buffer: the views are read back in the buffer's own depth; the pair's first
+ * row is the top of the picture already, as wl_shm wants it */
+static void
+pair_buffer_read_back (GtkGLAreaStereo *stereo,
+                       PairBuffer      *buffer)
+{
+  gboolean es = gdk_gl_context_get_use_es (stereo->context);
+  gsize n = (gsize) buffer->width * buffer->height;
+
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, buffer->framebuffer);
+  glPixelStorei (GL_PACK_ALIGNMENT, 4);
+
+  if (es && buffer->read_type == GL_HALF_FLOAT)
+    {
+      /* OpenGL ES reads a floating point framebuffer as single floats only (OpenGL ES 3.0, 4.3.1) */
+      float *floats = g_new (float, 4 * n);
+      guint16 *halves = buffer->data;
+
+      glReadPixels (0, 0, buffer->width, buffer->height, GL_RGBA, GL_FLOAT, floats);
+      for (gsize i = 0; i < 4 * n; i++)
+        {
+          union { float f; guint32 u; } v = { floats[i] };
+          guint32 sign = (v.u >> 16) & 0x8000, mantissa = v.u & 0x7fffff;
+          int exponent = (int) ((v.u >> 23) & 0xff) - 127 + 15;
+
+          if (((v.u >> 23) & 0xff) == 0xff)
+            halves[i] = sign | 0x7c00 | (mantissa ? 0x200 : 0);
+          else if (exponent >= 31)
+            halves[i] = sign | 0x7c00;
+          else if (exponent <= 0)
+            {
+              /* a subnormal half, rounded to nearest even */
+              if (exponent < -10)
+                halves[i] = sign;
+              else
+                {
+                  guint32 m = mantissa | 0x800000, shift = 14 - exponent;
+                  guint32 h = m >> shift, rest = m & ((1u << shift) - 1), half = 1u << (shift - 1);
+
+                  if (rest > half || (rest == half && (h & 1)))
+                    h++;
+                  halves[i] = sign | h;
+                }
+            }
+          else
+            {
+              guint32 h = ((guint32) exponent << 10) | (mantissa >> 13), rest = mantissa & 0x1fff;
+
+              if (rest > 0x1000 || (rest == 0x1000 && (h & 1)))
+                h++;
+              halves[i] = sign | h;
+            }
+        }
+      g_free (floats);
+    }
+  else
+    {
+      glReadPixels (0, 0, buffer->width, buffer->height, GL_RGBA, buffer->read_type, buffer->data);
+    }
+
+  if (buffer->swap_red_blue)
+    {
+      guint8 *p = buffer->data;
+
+      for (gsize i = 0; i < n; i++, p += 4)
+        {
+          guint8 r = p[0];
+
+          p[0] = p[2];
+          p[2] = r;
+        }
+    }
+}
