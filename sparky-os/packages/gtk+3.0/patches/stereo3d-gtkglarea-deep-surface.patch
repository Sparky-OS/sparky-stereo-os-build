+gboolean
+gtk_gl_area_get_mastering_display (GtkGLArea *area,
+                                   double    *primaries,
+                                   double    *min_luminance,
+                                   double    *max_luminance)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
