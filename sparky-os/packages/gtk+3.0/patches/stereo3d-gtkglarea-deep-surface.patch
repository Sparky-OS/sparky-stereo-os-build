+ * @max_luminance: (out) (optional): the maximum luminance, or -1
+ * @reference_luminance: (out) (optional): the reference white, or -1
+ *
+ * Returns: whether the area says its luminances
+ *
+ * Since: 3.24.52+stereo3d2
+ */
+gboolean
+gtk_gl_area_get_luminances (GtkGLArea *area,
+                            double    *min_luminance,
+                            double    *max_luminance,
+                            double    *reference_luminance)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), FALSE);
+
+  if (min_luminance)
+    *min_luminance = priv->volume.min_luminance;
+  if (max_luminance)
+    *max_luminance = priv->volume.max_luminance;
+  if (reference_luminance)
+    *reference_luminance = priv->volume.reference_luminance;
+  return priv->volume.reference_luminance >= 0;
+}
