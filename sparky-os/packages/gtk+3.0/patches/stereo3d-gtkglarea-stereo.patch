+/* Where the area lies in its toplevel's window, in the window's coordinates; a picture on a surface of its own is
+ * never cut and never translucent */
+static gboolean
+gtk_gl_area_stereo_place (GtkGLArea     *area,
+                          GdkRectangle  *place,
+                          GError       **error)
+{
+  GtkWidget *widget = GTK_WIDGET (area), *w;
+  GtkAllocation allocation;
+  GdkWindow *window, *toplevel;
+  double x, y;
+
+  for (w = widget; w != NULL; w = gtk_widget_get_parent (w))
+    if (gtk_widget_get_opacity (w) < 1.0)
+      {
+        g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                             "The area or a widget around it is drawn with an opacity below 1, which a picture on a surface of its own cannot have");
+        return FALSE;
+      }
+
+  gtk_widget_get_allocation (widget, &allocation);
+  window = gtk_widget_get_window (widget);
+  toplevel = gdk_window_get_toplevel (window);
+  x = allocation.x;
+  y = allocation.y;
+  while (window != NULL)
+    {
+      if (x < 0 || y < 0 ||
+          x + allocation.width > gdk_window_get_width (window) ||
+          y + allocation.height > gdk_window_get_height (window))
+        {
+          g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                               "The area is partly hidden (scrolled out, or cut by its window or a widget around it), and a stereo picture is never cut");
+          return FALSE;
+        }
+      if (window == toplevel)
+        break;
+      gdk_window_coords_to_parent (window, x, y, &x, &y);
+      window = gdk_window_get_effective_parent (window);
+    }
+
+  place->x = (int) x;
+  place->y = (int) y;
+  place->width = allocation.width;
+  place->height = allocation.height;
+  return TRUE;
+}
+
+static gboolean
+gtk_gl_area_repeat (gpointer data)
+{
+  GtkGLArea *area = data;
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  priv->repeat_id = 0;
+  gtk_gl_area_queue_render (area);
+  return G_SOURCE_REMOVE;
+}
+
+/* One frame of a stereo area: both views rendered, copied side by side and handed to the compositor on the area's own
+ * surface, and a hole in the window over it. FALSE when the area failed (it then draws its left view alone) */
+static gboolean
+gtk_gl_area_draw_stereo (GtkGLArea *area,
+                         cairo_t   *cr)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  GtkWidget *widget = GTK_WIDGET (area);
+  GtkWidget *toplevel;
+  GError *error = NULL;
+  GdkRectangle place;
+  GLenum status;
+  GLboolean scissor;
+  gboolean unused;
+  guint pair;
+  int view_width, view_height, eye;
+
+  if (!gtk_gl_area_stereo_place (area, &place, &error))
+    goto failed;
+
+  if (priv->stereo_output == NULL)
+    {
+      priv->stereo_output = gtk_gl_area_stereo_new (widget, priv->context, &error);
+      if (priv->stereo_output == NULL)
+        goto failed;
+      priv->needs_resize = TRUE;
+    }
+
+  gtk_gl_area_attach_buffers (area);
+  status = glCheckFramebufferStatus (GL_FRAMEBUFFER);
+  if (status != GL_FRAMEBUFFER_COMPLETE)
+    {
+      g_set_error (&error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                   "The OpenGL context cannot render the area's views in its format (framebuffer status 0x%x)", status);
+      goto failed;
+    }
+
+  view_width = priv->buffer_width;
+  view_height = priv->buffer_height;
+  if (priv->needs_resize)
+    {
+      g_signal_emit (area, area_signals[RESIZE], 0, view_width, view_height, NULL);
+      priv->needs_resize = FALSE;
+    }
+
+  pair = gtk_gl_area_stereo_begin (priv->stereo_output, view_width, view_height,
+                                   gtk_gl_area_internal_format (area, TRUE), &error);
+  if (pair == 0)
+    goto failed;
+
+  for (eye = GTK_GL_AREA_EYE_LEFT; eye <= GTK_GL_AREA_EYE_RIGHT; eye++)
+    {
+      /* the area's framebuffer, whatever the handler of the other view left bound */
+      gtk_gl_area_attach_buffers (area);
+      if (priv->has_depth_buffer)
+        glEnable (GL_DEPTH_TEST);
+      else
+        glDisable (GL_DEPTH_TEST);
+      glViewport (0, 0, view_width, view_height);
+
+      priv->current_eye = eye;
+      g_signal_emit (area, area_signals[RENDER], 0, priv->context, &unused);
+      priv->current_eye = GTK_GL_AREA_EYE_NONE;
+
+      gtk_gl_area_make_current (area);
+      /* a blit obeys the scissor test (OpenGL ES 3.2, 16.2.1), which the program may leave on */
+      scissor = glIsEnabled (GL_SCISSOR_TEST);
+      glDisable (GL_SCISSOR_TEST);
+      glBindFramebuffer (GL_READ_FRAMEBUFFER, priv->frame_buffer);
+      glBindFramebuffer (GL_DRAW_FRAMEBUFFER, pair);
+      /* a dma-buf's first row is the top of the picture, OpenGL's the bottom: the copy turns the view over there */
+      if (gtk_gl_area_stereo_top_down (priv->stereo_output))
+        glBlitFramebuffer (0, 0, view_width, view_height,
+                           (eye - 1) * view_width, view_height, eye * view_width, 0,
+                           GL_COLOR_BUFFER_BIT, GL_NEAREST);
+      else
+        glBlitFramebuffer (0, 0, view_width, view_height,
+                           (eye - 1) * view_width, 0, eye * view_width, view_height,
+                           GL_COLOR_BUFFER_BIT, GL_NEAREST);
+      if (scissor)
+        glEnable (GL_SCISSOR_TEST);
+    }
+  priv->needs_render = FALSE;
+
+  if (!gtk_gl_area_stereo_present (priv->stereo_output, &place, gtk_widget_get_scale_factor (widget),
+                                   priv->color_state, &error))
+    goto failed;
+
+  gtk_gl_area_make_current (area);
+  glBindFramebuffer (GL_FRAMEBUFFER, priv->frame_buffer);
+
+  /* the window draws nothing where the picture lies below it, so its widgets drawn over the area stay over it */
+  toplevel = gtk_widget_get_toplevel (widget);
+  if (gtk_gl_area_stereo_below_window (priv->stereo_output))
+    {
+      cairo_rectangle_int_t hole = { place.x, place.y, place.width, place.height };
+
+      cairo_save (cr);
+      cairo_set_operator (cr, CAIRO_OPERATOR_CLEAR);
+      cairo_rectangle (cr, 0, 0, place.width, place.height);
+      cairo_fill (cr);
+      cairo_restore (cr);
+      if (GTK_IS_WINDOW (toplevel))
+        _gtk_window_set_stereo_hole (GTK_WINDOW (toplevel), area, &hole);
+    }
+
+  if (gtk_gl_area_stereo_wants_repeat (priv->stereo_output) && priv->repeat_id == 0)
+    priv->repeat_id = g_timeout_add (20, gtk_gl_area_repeat, area);
+
+  if (priv->stereo_error != NULL)
+    {
+      g_clear_error (&priv->stereo_error);
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_ERROR]);
+    }
+  gtk_gl_area_set_stereo_shown (area, TRUE);
+  return TRUE;
+
+failed:
+  gtk_gl_area_stereo_failed (area, error);
+  return FALSE;
+}
+
 static gboolean
 gtk_gl_area_draw (GtkWidget *widget,
                   cairo_t   *cr)
@@ -696,6 +1121,18 @@ gtk_gl_area_draw (GtkWidget *widget,
 
   gtk_gl_area_make_current (area);
 
+  if (gtk_gl_area_renders_pair (area) && gtk_gl_area_draw_stereo (area, cr))
