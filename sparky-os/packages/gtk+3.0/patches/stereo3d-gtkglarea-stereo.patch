+
+/* A change that may let an area that failed be shown per eye tries again */
+static void
+gtk_gl_area_stereo_changed (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  if (priv->stereo && priv->stereo_failed)
+    {
+      priv->stereo_failed = FALSE;
+      g_clear_error (&priv->stereo_error);
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_ERROR]);
+    }
+  priv->needs_resize = TRUE;
+  gtk_gl_area_queue_render (area);
+}
+
+/**
+ * gtk_gl_area_set_stereo:
+ * @area: a #GtkGLArea
+ * @stereo: whether the area renders one view for each eye
+ *
+ * Asks the area to render one view for each eye and to hand the two to the
+ * compositor as stereo content. See #GtkGLArea:stereo. Setting %TRUE again
+ * after a failure tries again.
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+void
+gtk_gl_area_set_stereo (GtkGLArea *area,
+                        gboolean   stereo)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+
+  stereo = !!stereo;
+  if (priv->stereo == stereo && !(stereo && priv->stereo_failed))
+    return;
+
+  if (!stereo && (priv->stereo_output != NULL || priv->repeat_id != 0))
+    {
+      if (priv->context != NULL)
+        gtk_gl_area_make_current (area);
+      gtk_gl_area_drop_stereo_output (area);
+    }
+  if (!stereo)
+    gtk_gl_area_set_stereo_shown (area, FALSE);
+
+  priv->stereo = stereo;
+  priv->stereo_failed = FALSE;
+  if (priv->stereo_error != NULL)
+    {
+      g_clear_error (&priv->stereo_error);
+      g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO_ERROR]);
+    }
+  priv->needs_resize = TRUE;
+  gtk_gl_area_queue_render (area);
+  g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_STEREO]);
+}
+
+/**
+ * gtk_gl_area_get_stereo:
+ * @area: a #GtkGLArea
+ *
+ * Returns: whether the area asks for stereo
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+gboolean
+gtk_gl_area_get_stereo (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), FALSE);
+
+  return priv->stereo;
+}
+
+/**
+ * gtk_gl_area_get_stereo_shown:
+ * @area: a #GtkGLArea
+ *
+ * Returns: whether the area's views are shown per eye
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+gboolean
+gtk_gl_area_get_stereo_shown (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), FALSE);
+
+  return priv->stereo_shown;
+}
+
+/**
+ * gtk_gl_area_get_stereo_error:
+ * @area: a #GtkGLArea
+ *
+ * Returns: (nullable) (transfer none): why the area cannot be shown per
+ *   eye, or %NULL
+ *
+ * Since: 3.24.52+stereo3d1
+ */
