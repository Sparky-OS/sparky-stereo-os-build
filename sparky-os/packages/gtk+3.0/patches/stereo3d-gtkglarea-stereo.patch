+static void
+dmabuf_modifier (void *data, struct zwp_linux_dmabuf_v1 *dmabuf, uint32_t format, uint32_t hi, uint32_t lo)
+{
+  WaylandGlobals *globals = data;
+  guint64 pair[2] = { format, ((guint64) hi << 32) | lo };
+
+  g_array_append_vals (globals->formats, pair, 2);
+}
