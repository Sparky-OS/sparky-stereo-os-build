+/* The area asked for stereo and cannot be shown per eye: it says why, once, and shows its left view alone until
+ * stereo is asked again (takes @error) */
+static void
+gtk_gl_area_stereo_failed (GtkGLArea *area,
+                           GError    *error)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  if (priv->stereo_error == NULL || g_strcmp0 (priv->stereo_error->message, error->message) != 0)
+    g_message ("GtkGLArea %p cannot show its picture per eye, so it shows its left view alone: %s", area, error->message);
