+/* The globals the stereo areas of one display share, bound on a queue of their own so that GTK can wait for the
+ * compositor's answers (a buffer created, an image description ready) without dispatching GDK's events */
+static WaylandGlobals *
+wayland_globals_get (GdkDisplay  *display,
+                     GError     **error)
+{
+  WaylandGlobals *globals = g_object_get_data (G_OBJECT (display), "gtk-gl-area-stereo-wayland");
+  struct wl_display *wl_display;
+  struct wl_display *wrapper;
+
+  if (globals != NULL)
+    {
+      if (globals->error != NULL)
+        {
+          g_propagate_error (error, g_error_copy (globals->error));
+          return NULL;
+        }
+      return globals;
+    }
+
+  globals = g_new0 (WaylandGlobals, 1);
+  g_object_set_data (G_OBJECT (display), "gtk-gl-area-stereo-wayland", globals);
+  globals->formats = g_array_new (FALSE, FALSE, sizeof (guint64));
+
+  wl_display = gdk_wayland_display_get_wl_display (display);
+  globals->display = wl_display;
+  globals->queue = wl_display_create_queue (wl_display);
+  wrapper = wl_proxy_create_wrapper (wl_display);
+  wl_proxy_set_queue ((struct wl_proxy *) wrapper, globals->queue);
+  globals->registry = wl_display_get_registry (wrapper);
+  wl_proxy_wrapper_destroy (wrapper);
+  wl_registry_add_listener (globals->registry, &registry_listener, globals);
+  wl_display_roundtrip_queue (wl_display, globals->queue);
+  wl_display_roundtrip_queue (wl_display, globals->queue);
+
+  globals->lib = stereo_declare_load (&globals->error);
+  if (globals->lib != NULL)
+    {
+      globals->lib->wayland_init (wl_display, globals->queue);
+      wl_display_roundtrip_queue (wl_display, globals->queue);
+      wl_display_roundtrip_queue (wl_display, globals->queue);
+    }
+
+  if (globals->error != NULL)
+    ;
+  else if (!globals->lib->supported_wayland ())
+    g_set_error_literal (&globals->error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                         "The compositor does not announce stereo content (kde_stereo_content_manager_v1)");
+  else if (globals->compositor == NULL || globals->subcompositor == NULL)
+    g_set_error_literal (&globals->error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                         "The compositor offers no wl_compositor version 4 or no wl_subcompositor");
+  else if (globals->viewporter == NULL)
+    g_set_error_literal (&globals->error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                         "The compositor offers no wp_viewporter, which gives the declared surface its size");
+  else if (globals->dmabuf == NULL)
+    g_set_error_literal (&globals->error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                         "The compositor offers no zwp_linux_dmabuf_v1 version 3, which carries the picture");
+
+  if (globals->error != NULL)
+    {
+      g_propagate_error (error, g_error_copy (globals->error));
+      return NULL;
+    }
+
+  return globals;
+}
+
+static gboolean
+compositor_takes (WaylandGlobals *globals,
+                  guint32         fourcc,
+                  guint64         modifier)
+{
+  guint64 *pairs = (guint64 *) globals->formats->data;
+
+  for (guint i = 0; i + 1 < globals->formats->len; i += 2)
+    if (pairs[i] == fourcc && pairs[i + 1] == modifier)
+      return TRUE;
+
+  return FALSE;
+}
+
+static guint32
+opaque_fourcc (guint32 fourcc)
+{
+  switch (fourcc)
+    {
+    case FOURCC_AB24: return FOURCC_XB24;
+    case FOURCC_AB30: return FOURCC_XB30;
+    case FOURCC_AB48: return FOURCC_XB48;
+    case FOURCC_AB4H: return FOURCC_XB4H;
+    default: return 0;
+    }
+}
