+/* the fourccs of drm_fourcc.h this file needs */
+#define FOURCC(a, b, c, d) ((guint32) (a) | ((guint32) (b) << 8) | ((guint32) (c) << 16) | ((guint32) (d) << 24))
+#define FOURCC_AB24 FOURCC ('A', 'B', '2', '4')
+#define FOURCC_XB24 FOURCC ('X', 'B', '2', '4')
+#define FOURCC_AB30 FOURCC ('A', 'B', '3', '0')
+#define FOURCC_XB30 FOURCC ('X', 'B', '3', '0')
+#define FOURCC_AB48 FOURCC ('A', 'B', '4', '8')
+#define FOURCC_XB48 FOURCC ('X', 'B', '4', '8')
+#define FOURCC_AB4H FOURCC ('A', 'B', '4', 'H')
+#define FOURCC_XB4H FOURCC ('X', 'B', '4', 'H')
+#define MOD_INVALID G_GUINT64_CONSTANT (0x00ffffffffffffff)
+
+static char *
+fourcc_name (guint32 fourcc)
+{
+  return g_strdup_printf ("%c%c%c%c", fourcc & 0xff, (fourcc >> 8) & 0xff, (fourcc >> 16) & 0xff, (fourcc >> 24) & 0xff);
+}
