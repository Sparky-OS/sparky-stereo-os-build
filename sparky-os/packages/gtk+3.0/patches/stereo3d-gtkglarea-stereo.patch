diff --git a/gtk/gtkwindow.c b/gtk/gtkwindow.c
index 7572bf1..13c9c5e 100644
--- a/gtk/gtkwindow.c
+++ b/gtk/gtkwindow.c
@@ -276,6 +276,12 @@ struct _GtkWindowPrivate
   GdkWindow *hardcoded_window;
 
   GtkCssNode *decoration_node;
+
+  /* the rectangles of stereo areas whose pictures lie below the window's surface: holes in its opaque region */
+  GHashTable *stereo_holes;
+  GtkBorder opaque_border;
+  GtkAllocation opaque_allocation;
+  guint opaque_known : 1;
 };
 
 #ifdef GDK_WINDOWING_X11
@@ -5995,6 +6001,7 @@ gtk_window_finalize (GObject *object)
   GtkWindowPrivate *priv = window->priv;
   GtkMnemonicHash *mnemonic_hash;
 
+  g_clear_pointer (&priv->stereo_holes, g_hash_table_unref);
   g_free (priv->title);
   g_free (priv->wmclass_name);
   g_free (priv->wmclass_class);
@@ -7361,17 +7368,80 @@ update_opaque_region (GtkWindow           *window,
       opaque_region = cairo_region_create_rectangle (&rect);
 
       subtract_decoration_corners_from_region (opaque_region, &rect, context, window);
+
+      /* the window is transparent where a stereo area's picture lies below it */
+      if (window->priv->stereo_holes != NULL)
+        {
+          GHashTableIter iter;
+          gpointer hole;
+
+          g_hash_table_iter_init (&iter, window->priv->stereo_holes);
+          while (g_hash_table_iter_next (&iter, NULL, &hole))
+            cairo_region_subtract_rectangle (opaque_region, hole);
+        }
     }
   else
     {
       opaque_region = NULL;
     }
 
+  window->priv->opaque_border = *border;
+  window->priv->opaque_allocation = *allocation;
+  window->priv->opaque_known = TRUE;
+
   gdk_window_set_opaque_region (_gtk_widget_get_window (widget), opaque_region);
 
   cairo_region_destroy (opaque_region);
 }
 
+/*
+ * _gtk_window_set_stereo_hole:
+ * @window: a toplevel #GtkWindow
+ * @owner: the widget the hole is for
+ * @rect: (nullable): the hole, in the coordinates of the window's #GdkWindow, or %NULL to close it
+ *
+ * A stereo #GtkGLArea hands its picture to the compositor on a surface of its own below the window's surface; the
+ * window draws nothing there, and must not say that the place is opaque, or the compositor would not show what lies
+ * below.
+ */
+void
+_gtk_window_set_stereo_hole (GtkWindow                   *window,
+                             gpointer                     owner,
+                             const cairo_rectangle_int_t *rect)
+{
+  GtkWindowPrivate *priv = window->priv;
+  cairo_rectangle_int_t *old = NULL;
+
+  if (priv->stereo_holes != NULL)
+    old = g_hash_table_lookup (priv->stereo_holes, owner);
+
+  if (rect == NULL)
+    {
+      if (old == NULL)
+        return;
+      g_hash_table_remove (priv->stereo_holes, owner);
+    }
+  else
+    {
+      if (old != NULL && memcmp (old, rect, sizeof *rect) == 0)
+        return;
+      cairo_rectangle_int_t *copy = g_new (cairo_rectangle_int_t, 1);
+
+      *copy = *rect;
+      if (priv->stereo_holes == NULL)
+        priv->stereo_holes = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+      g_hash_table_insert (priv->stereo_holes, owner, copy);
+    }
+
+  if (priv->opaque_known)
+    {
+      GtkBorder border = priv->opaque_border;
+      GtkAllocation allocation = priv->opaque_allocation;
+
+      update_opaque_region (window, &border, &allocation);
+    }
+}
