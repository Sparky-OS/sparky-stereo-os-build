+/* The pair as a dma-buf the compositor takes, made once for each buffer of the pool */
+static gboolean
+pair_buffer_export (GtkGLAreaStereo  *stereo,
+                    PairBuffer       *buffer,
+                    GError          **error)
+{
+  WaylandGlobals *globals = stereo->globals;
+  EGLDisplay egl_display = eglGetCurrentDisplay ();
+  EGLContext egl_context = eglGetCurrentContext ();
+  EGLint attribs[] = { EGL_GL_TEXTURE_LEVEL_KHR, 0, EGL_NONE };
+  int fourcc = 0, n_planes = 0;
+  EGLuint64KHR modifier = MOD_INVALID;
+  int fds[4] = { -1, -1, -1, -1 };
+  EGLint strides[4] = { 0 }, offsets[4] = { 0 };
+  struct zwp_linux_buffer_params_v1 *params;
+  ParamsResult result = { NULL, FALSE };
+  guint32 sent;
+  const char *renderer = (const char *) glGetString (GL_RENDERER);
+  int i;
+
+  if (buffer->buffer != NULL)
+    return TRUE;
+
+  if (egl_display == EGL_NO_DISPLAY ||
+      !epoxy_has_egl_extension (egl_display, "EGL_KHR_gl_texture_2D_image") ||
+      !epoxy_has_egl_extension (egl_display, "EGL_MESA_image_dma_buf_export"))
+    {
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                   "The OpenGL context (%s) cannot export its picture as a dma-buf: EGL_MESA_image_dma_buf_export is missing",
+                   renderer ? renderer : "unknown renderer");
+      return FALSE;
+    }
+
+  buffer->image = eglCreateImageKHR (egl_display, egl_context, EGL_GL_TEXTURE_2D_KHR,
+                                     (EGLClientBuffer) (guintptr) buffer->texture, attribs);
+  if (buffer->image == EGL_NO_IMAGE_KHR)
+    {
+      buffer->image = NULL;
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                   "The OpenGL context (%s) cannot export its picture as a dma-buf: eglCreateImageKHR failed (0x%x)",
+                   renderer ? renderer : "unknown renderer", eglGetError ());
+      return FALSE;
+    }
+
+  if (!eglExportDMABUFImageQueryMESA (egl_display, buffer->image, &fourcc, &n_planes, &modifier) ||
+      n_planes < 1 || n_planes > 4 ||
+      !eglExportDMABUFImageMESA (egl_display, buffer->image, fds, strides, offsets))
+    {
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                   "The OpenGL context (%s) cannot export its picture as a dma-buf",
+                   renderer ? renderer : "unknown renderer");
+      for (i = 0; i < 4; i++)
+        if (fds[i] >= 0)
+          close (fds[i]);
+      return FALSE;
+    }
+
+  /* a driver that reports success and writes no descriptor has failed (zink on NVIDIA's own Vulkan driver did) */
+  for (i = 0; i < n_planes; i++)
+    if (fds[i] < 0)
+      {
+        g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                     "The OpenGL context (%s) exported its picture as a dma-buf without a file descriptor for plane %d",
+                     renderer ? renderer : "unknown renderer", i);
+        for (i = 0; i < 4; i++)
+          if (fds[i] >= 0)
+            close (fds[i]);
+        return FALSE;
+      }
+
+  /* the opaque form of the format where the compositor takes it with that modifier, the format itself (its alpha is
+   * one) otherwise */
+  sent = opaque_fourcc (fourcc);
+  if (sent == 0 || !compositor_takes (globals, sent, modifier))
+    sent = fourcc;
+  if (!compositor_takes (globals, sent, modifier))
+    {
+      char *name = fourcc_name (fourcc);
+
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                   "The compositor takes no dma-buf in %s with modifier 0x%" G_GINT64_MODIFIER "x, the area's picture",
+                   name, (guint64) modifier);
+      g_free (name);
+      for (i = 0; i < n_planes; i++)
+        close (fds[i]);
+      return FALSE;
+    }
+
+  params = zwp_linux_dmabuf_v1_create_params (globals->dmabuf);
+  for (i = 0; i < n_planes; i++)
+    {
+      zwp_linux_buffer_params_v1_add (params, fds[i], i, offsets[i], strides[i], modifier >> 32, modifier & 0xffffffff);
+      /* libwayland duplicates the descriptor when it writes the request */
+      close (fds[i]);
+    }
+  zwp_linux_buffer_params_v1_add_listener (params, &params_listener, &result);
+  zwp_linux_buffer_params_v1_create (params, buffer->width, buffer->height, sent, 0);
+  while (result.buffer == NULL && !result.failed)
+    if (wl_display_dispatch_queue (globals->display, globals->queue) < 0)
+      break;
+  zwp_linux_buffer_params_v1_destroy (params);
+
+  if (result.buffer == NULL)
+    {
+      char *name = fourcc_name (sent);
+
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                   "The compositor refused the area's picture as a dma-buf (%s, %dx%d, modifier 0x%" G_GINT64_MODIFIER "x)",
+                   name, buffer->width, buffer->height, (guint64) modifier);
+      g_free (name);
+      return FALSE;
+    }
+
+  buffer->buffer = result.buffer;
+  buffer->fourcc = sent;
+  wl_buffer_add_listener (buffer->buffer, &buffer_listener, buffer);
+
+  {
+    char *name = fourcc_name (sent);
+    g_debug ("GtkGLArea %p: its pair is a dma-buf %s:0x%" G_GINT64_MODIFIER "x, %dx%d", stereo->area, name,
+             (guint64) modifier, buffer->width, buffer->height);
+    g_free (name);
+  }
+
+  return TRUE;
+}
+
+/* ITU-T H.273 code points and the names of wp_color_manager_v1 (color-management-v1.xml); a code point the protocol
+ * has no name for is 0 */
+static guint32
+named_primaries (guint primaries)
+{
+  switch (primaries)
+    {
+    case 1: return WP_COLOR_MANAGER_V1_PRIMARIES_SRGB;           /* BT.709, sRGB */
+    case 4: return WP_COLOR_MANAGER_V1_PRIMARIES_PAL_M;          /* BT.470 System M */
+    case 5: return WP_COLOR_MANAGER_V1_PRIMARIES_PAL;            /* BT.470 System B, G; BT.601 625 lines */
+    case 6: return WP_COLOR_MANAGER_V1_PRIMARIES_NTSC;           /* SMPTE 170M; BT.601 525 lines */
+    case 7: return WP_COLOR_MANAGER_V1_PRIMARIES_NTSC;           /* SMPTE 240M, the same primaries */
+    case 8: return WP_COLOR_MANAGER_V1_PRIMARIES_GENERIC_FILM;   /* Illuminant C */
+    case 9: return WP_COLOR_MANAGER_V1_PRIMARIES_BT2020;         /* BT.2020, BT.2100 */
+    case 10: return WP_COLOR_MANAGER_V1_PRIMARIES_CIE1931_XYZ;   /* SMPTE ST 428-1 */
+    case 11: return WP_COLOR_MANAGER_V1_PRIMARIES_DCI_P3;        /* SMPTE RP 431-2 */
+    case 12: return WP_COLOR_MANAGER_V1_PRIMARIES_DISPLAY_P3;    /* SMPTE EG 432-1 */
+    default: return 0;                                           /* 22, EBU Tech. 3213-E: no name */
+    }
+}
+
+static guint32
+named_tf (WaylandGlobals *globals,
+          guint           transfer)
+{
+  switch (transfer)
+    {
+    /* the protocol's bt1886 is the display transfer characteristic BT.601, BT.709 and BT.2020 assume */
+    case 1: case 6: case 14: case 15: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_BT1886;
+    case 4: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_GAMMA22;   /* BT.470 System M */
+    case 5: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_GAMMA28;   /* BT.470 System B, G */
+    case 7: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST240;
+    case 8: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_LINEAR;
+    case 9: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_LOG_100;
+    case 10: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_LOG_316;
+    case 11: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_XVYCC;
+    case 13:
+      /* sRGB: version 2 of the protocol deprecates the name ("use gamma22 for video, motion picture and computer
+       * graphics"); a compositor that does not list it is told gamma 2.2, as GDK 4 does in the edition */
+      if (globals->cm_tf & (1u << WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_SRGB))
+        return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_SRGB;
+      return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_GAMMA22;
+    case 16: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ;
+    case 17: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST428;
+    case 18: return WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_HLG;
+    default: return 0;                                              /* 12, BT.1361: no name */
+    }
+}
+
+typedef struct
+{
+  gboolean ready;
+  gboolean failed;
+  char *reason;
+} DescriptionResult;
+
+static void
+description_failed (void *data, struct wp_image_description_v1 *description, uint32_t cause, const char *msg)
+{
+  DescriptionResult *result = data;
+
+  result->failed = TRUE;
+  result->reason = g_strdup_printf ("%s (cause %u)", msg, cause);
+}
+
+static void
+description_ready (void *data, struct wp_image_description_v1 *description, uint32_t identity)
+{
+  DescriptionResult *result = data;
+
+  result->ready = TRUE;
+}
+
+static const struct wp_image_description_v1_listener description_listener = {
+  .failed = description_failed,
+  .ready = description_ready,
+};
+
+static gboolean
+wayland_describe (GtkGLAreaStereo  *stereo,
+                  GdkColorState    *state,
+                  GError          **error)
+{
+  WaylandGlobals *globals = stereo->globals;
+  GdkCicpParams *cicp;
+  guint primaries, transfer;
+  guint32 named_p, named_t;
+  struct wp_image_description_creator_params_v1 *creator;
+  struct wp_image_description_v1 *description;
+  DescriptionResult result = { FALSE, FALSE, NULL };
+
+  if (stereo->described != NULL && gdk_color_state_equal (stereo->described, state))
+    return TRUE;
+
+  if (globals->color_manager == NULL)
+    {
+      /* a surface nothing describes is sRGB */
+      if (gdk_color_state_equal (state, gdk_color_state_get_srgb ()))
+        return TRUE;
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                           "The compositor has no colour management (wp_color_manager_v1): the area's colour state cannot be described");
+      return FALSE;
+    }
+
+  cicp = gdk_color_state_create_cicp_params (state);
+  primaries = gdk_cicp_params_get_color_primaries (cicp);
+  transfer = gdk_cicp_params_get_transfer_function (cicp);
+  g_object_unref (cicp);
+  named_p = named_primaries (primaries);
+  named_t = named_tf (globals, transfer);
+
+  if (!globals->cm_parametric || !globals->cm_perceptual)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                           "The compositor's colour management takes no parametric description with the perceptual intent");
+      return FALSE;
+    }
+  if (named_p == 0 || !(globals->cm_primaries & (1u << named_p)))
+    {
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                   "The compositor lists no name for the area's colour primaries (ITU-T H.273 code point %u)", primaries);
+      return FALSE;
+    }
+  if (named_t == 0 || !(globals->cm_tf & (1u << named_t)))
+    {
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                   "The compositor lists no name for the area's transfer characteristics (ITU-T H.273 code point %u)", transfer);
+      return FALSE;
+    }
+
+  if (stereo->color_surface == NULL)
+    stereo->color_surface = wp_color_manager_v1_get_surface (globals->color_manager, stereo->surface);
+
+  creator = wp_color_manager_v1_create_parametric_creator (globals->color_manager);
+  wp_image_description_creator_params_v1_set_tf_named (creator, named_t);
+  wp_image_description_creator_params_v1_set_primaries_named (creator, named_p);
+  description = wp_image_description_creator_params_v1_create (creator);
+  wp_image_description_v1_add_listener (description, &description_listener, &result);
+  while (!result.ready && !result.failed)
+    if (wl_display_dispatch_queue (globals->display, globals->queue) < 0)
+      break;
+
+  if (!result.ready)
+    {
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                   "The compositor refused the area's colour description: %s", result.reason ? result.reason : "no answer");
+      g_free (result.reason);
+      wp_image_description_v1_destroy (description);
+      return FALSE;
+    }
+
+  wp_color_management_surface_v1_set_image_description (stereo->color_surface, description,
+                                                         WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+  g_clear_pointer (&stereo->description, wp_image_description_v1_destroy);
+  stereo->description = description;
+  g_clear_pointer (&stereo->described, gdk_color_state_unref);
+  stereo->described = gdk_color_state_ref (state);
+
+  g_debug ("GtkGLArea %p: its surface is described with named primaries %u and transfer function %u (H.273 %u, %u)",
+           stereo->area, named_p, named_t, primaries, transfer);
+  return TRUE;
+}
+
+static void
+wayland_destroy_surface (GtkGLAreaStereo *stereo)
+{
+  if (stereo->surface == NULL)
+    return;
+
+  if (stereo->declared)
+    stereo->globals->lib->remove_wayland (stereo->surface);
+  stereo->declared = FALSE;
+  g_clear_pointer (&stereo->description, wp_image_description_v1_destroy);
+  g_clear_pointer (&stereo->color_surface, wp_color_management_surface_v1_destroy);
+  g_clear_pointer (&stereo->described, gdk_color_state_unref);
+  g_clear_pointer (&stereo->viewport, wp_viewport_destroy);
+  g_clear_pointer (&stereo->subsurface, wl_subsurface_destroy);
+  g_clear_pointer (&stereo->surface, wl_surface_destroy);
+  stereo->parent = NULL;
+  stereo->attached = FALSE;
+  stereo->x = stereo->y = G_MININT;
+  stereo->dest_width = stereo->dest_height = 0;
+}
+
+static gboolean
+wayland_present (GtkGLAreaStereo     *stereo,
+                 PairBuffer          *buffer,
+                 const GdkRectangle  *place,
+                 GdkColorState       *state,
+                 GError             **error)
+{
+  WaylandGlobals *globals = stereo->globals;
+  GdkWindow *toplevel = gdk_window_get_toplevel (gtk_widget_get_window (stereo->area));
+  struct wl_surface *parent = gdk_wayland_window_get_wl_surface (toplevel);
+
+  if (parent == NULL)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE, "The window has no Wayland surface");
+      return FALSE;
+    }
+
+  if (!pair_buffer_export (stereo, buffer, error))
+    return FALSE;
+
+  /* GTK hides a window by destroying its surface: a new one gets a new subsurface */
+  if (stereo->surface != NULL && stereo->parent != parent)
+    wayland_destroy_surface (stereo);
+
+  if (stereo->surface == NULL)
+    {
+      stereo->surface = wl_compositor_create_surface (globals->compositor);
+      stereo->subsurface = wl_subcompositor_get_subsurface (globals->subcompositor, stereo->surface, parent);
+      /* below the window's own surface, which keeps a transparent hole over it: the window's widgets drawn over the
+       * area stay over it */
+      wl_subsurface_place_below (stereo->subsurface, parent);
+      stereo->viewport = wp_viewporter_get_viewport (globals->viewporter, stereo->surface);
+      stereo->parent = parent;
+      stereo->x = stereo->y = G_MININT;
+    }
+
+  if (!wayland_describe (stereo, state, error))
+    return FALSE;
+
+  if (!stereo->declared)
+    {
+      int result = globals->lib->declare_format (stereo->surface, STEREO_SBS_FULL);
+
+      if (result < 0)
+        {
+          g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "libstereo-declare could not declare the area's surface: %s", g_strerror (-result));
+          return FALSE;
+        }
+      stereo->declared = TRUE;
+    }
+
+  if (place->x != stereo->x || place->y != stereo->y)
+    {
+      wl_subsurface_set_position (stereo->subsurface, place->x, place->y);
+      stereo->x = place->x;
+      stereo->y = place->y;
+    }
+  /* the declared surface is one view wide: its destination is one view, the area's own size */
+  if (place->width != stereo->dest_width || place->height != stereo->dest_height)
+    {
+      wp_viewport_set_destination (stereo->viewport, place->width, place->height);
+      stereo->dest_width = place->width;
+      stereo->dest_height = place->height;
+    }
+
+  wl_surface_attach (stereo->surface, buffer->buffer, 0, 0);
+  wl_surface_damage_buffer (stereo->surface, 0, 0, G_MAXINT32, G_MAXINT32);
+  /* a synchronized subsurface: this takes effect with the window's commit at the end of the paint GDK is doing */
+  wl_surface_commit (stereo->surface);
+  buffer->busy = TRUE;
+  stereo->attached = TRUE;
+
+  return TRUE;
+}
+
+#endif /* GDK_WINDOWING_WAYLAND */
+
+#ifdef GDK_WINDOWING_X11
+
+/* Support version 8 of _KDE_NET_WM_STEREO_CONTENT_SUPPORTED takes the size one view is shown at from a child and its
+ * place below the parent's surface; from version 11 the window manager tells a declared child it has taken it */
+#define NEEDED_SUPPORT 8
+#define ACK_SUPPORT 11
+
+static gboolean
+x11_child_acked (GtkGLAreaStereo *stereo)
+{
+  Atom type = None;
+  int format = 0;
+  unsigned long n = 0, after = 0;
+  unsigned char *data = NULL;
+  int status;
+
+  gdk_x11_display_error_trap_push (stereo->display);
+  status = XGetWindowProperty (stereo->xdisplay, stereo->own,
+                               gdk_x11_get_xatom_by_name_for_display (stereo->display, "_KDE_NET_WM_STEREO_DEPTH_LIMITS"),
+                               0, 16, False, AnyPropertyType, &type, &format, &n, &after, &data);
+  gdk_x11_display_error_trap_pop_ignored (stereo->display);
+  if (data != NULL)
+    XFree (data);
+
+  return status == Success && type != None;
+}
+
+static void
+x11_create_windows (GtkGLAreaStereo *stereo)
+{
+  XSetWindowAttributes attributes = { 0, };
+  XWindowAttributes toplevel;
+
+  XGetWindowAttributes (stereo->xdisplay, stereo->toplevel, &toplevel);
+  stereo->visual = toplevel.visual;
+  stereo->depth = toplevel.depth;
+
+  attributes.event_mask = 0;
+  attributes.colormap = toplevel.colormap;
+  attributes.border_pixel = 0;
+  attributes.background_pixel = 0;
+  attributes.backing_store = NotUseful;
+
+  /* No events are selected, so the pointer and the keys go to the toplevel.
+   * Above the window, the child sits in a frame one view wide that cuts what is drawn before the window manager takes
+   * the child. Below the window there is no frame: a window that is not redirected is part of the toplevel's own
+   * picture, and a frame there would cover the window's widgets over the area (measured: the overlay label hidden) */
+  if (!stereo->below)
+    stereo->frame = XCreateWindow (stereo->xdisplay, stereo->toplevel, 0, 0, 1, 1, 0,
+                                   toplevel.depth, InputOutput, toplevel.visual,
+                                   CWEventMask | CWColormap | CWBorderPixel | CWBackPixel, &attributes);
+  stereo->own = XCreateWindow (stereo->xdisplay, stereo->below ? stereo->toplevel : stereo->frame, 0, 0, 1, 1, 0,
+                               toplevel.depth, InputOutput, toplevel.visual,
+                               CWEventMask | CWColormap | CWBorderPixel | CWBackPixel, &attributes);
+  stereo->gc = XCreateGC (stereo->xdisplay, stereo->own, 0, NULL);
+}
+
+static void
+x11_draw_gl (GtkGLAreaStereo *stereo,
+             PairBuffer      *buffer)
+{
+  Display *dpy = glXGetCurrentDisplay ();
+  GLXContext context = glXGetCurrentContext ();
+  GLXDrawable draw = glXGetCurrentDrawable ();
+  GLXDrawable read = glXGetCurrentReadDrawable ();
+  static gboolean swap_control_checked, has_swap_control;
+
+  glXMakeContextCurrent (dpy, stereo->own, stereo->own, context);
+  if (!swap_control_checked)
+    {
+      swap_control_checked = TRUE;
+      has_swap_control = epoxy_has_glx_extension (dpy, DefaultScreen (dpy), "GLX_EXT_swap_control");
+    }
+  /* the child's swap waits for nothing: the window's own frame keeps the pace */
+  if (has_swap_control)
+    glXSwapIntervalEXT (dpy, stereo->own, 0);
+  /* a context first made current on another drawable can keep GL_NONE as the draw buffer of the window */
+  glDrawBuffer (GL_BACK);
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, buffer->framebuffer);
+  glBindFramebuffer (GL_DRAW_FRAMEBUFFER, 0);
+  glDisable (GL_SCISSOR_TEST);
+  glBlitFramebuffer (0, 0, buffer->width, buffer->height, 0, 0, buffer->width, buffer->height,
+                     GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  glXSwapBuffers (dpy, stereo->own);
+  glXMakeContextCurrent (dpy, draw, read, context);
+}
+
+static void
+x11_draw_readback (GtkGLAreaStereo *stereo,
+                   PairBuffer      *buffer)
+{
+  int w = buffer->width, h = buffer->height;
+  guint8 *rgba = g_malloc ((gsize) 4 * w * h);
+  char *data = malloc ((gsize) 4 * w * h);
+  XImage *image;
+
+  glBindFramebuffer (GL_READ_FRAMEBUFFER, buffer->framebuffer);
+  glPixelStorei (GL_PACK_ALIGNMENT, 4);
+  glReadPixels (0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+
+  /* OpenGL's rows go up, X's down; Xlib wants the samples as the visual lays them out: blue, green, red, alpha */
+  for (int row = 0; row < h; row++)
+    {
+      const guint8 *src = rgba + (gsize) 4 * w * (h - 1 - row);
+      guint8 *dst = (guint8 *) data + (gsize) 4 * w * row;
+
+      for (int i = 0; i < w; i++)
+        {
+          dst[4 * i + 0] = src[4 * i + 2];
+          dst[4 * i + 1] = src[4 * i + 1];
+          dst[4 * i + 2] = src[4 * i + 0];
+          dst[4 * i + 3] = 0xff;
+        }
+    }
+  g_free (rgba);
+
+  image = XCreateImage (stereo->xdisplay, stereo->visual, stereo->depth, ZPixmap, 0, data, w, h, 32, 0);
+  XPutImage (stereo->xdisplay, stereo->own, stereo->gc, image, 0, 0, 0, 0, w, h);
+  XDestroyImage (image);
+}
+
+static gboolean
+x11_present (GtkGLAreaStereo     *stereo,
+             PairBuffer          *buffer,
+             const GdkRectangle  *place,
+             int                  scale,
+             GdkColorState       *state,
+             GError             **error)
+{
+  int view_width = buffer->width / 2, view_height = buffer->height;
+  int x = place->x * scale, y = place->y * scale;
+  int shown_width = place->width * scale, shown_height = place->height * scale;
+  gboolean resized;
+  int result;
+
+  if (!gdk_color_state_equal (state, gdk_color_state_get_srgb ()))
+    {
+      g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                           "An X window has no colour description: an area in a colour state other than sRGB cannot be shown on X11");
+      return FALSE;
+    }
+
+  gdk_x11_display_error_trap_push (stereo->display);
+
+  if (stereo->own == None)
+    x11_create_windows (stereo);
+
+  if (buffer->internal_format != GL_RGBA8 &&
+      !(buffer->internal_format == GL_RGB10_A2 && stereo->visual->bits_per_rgb >= 10))
+    {
+      gdk_x11_display_error_trap_pop_ignored (stereo->display);
+      g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                   "The X window holds %d bits a channel: the area's deeper picture cannot be carried on X11",
+                   stereo->visual->bits_per_rgb);
+      return FALSE;
+    }
+
+  resized = view_width != stereo->view_width || view_height != stereo->view_height ||
+            shown_width != stereo->shown_width || shown_height != stereo->shown_height;
+  if (resized)
+    {
+      XResizeWindow (stereo->xdisplay, stereo->own, 2 * view_width, view_height);
+      if (stereo->frame != None)
+        XResizeWindow (stereo->xdisplay, stereo->frame, shown_width, shown_height);
+    }
+  if (x != stereo->cx || y != stereo->cy)
+    XMoveWindow (stereo->xdisplay, stereo->frame != None ? stereo->frame : stereo->own, x, y);
+
+  if (!stereo->child_declared)
+    {
+      result = stereo->lib->declare_child (stereo->xdisplay, stereo->toplevel, stereo->own,
+                                           STEREO_SBS_FULL, STEREO_CLASS_NONE, 0, shown_width, shown_height);
+      if (result < 0)
+        {
+          XSync (stereo->xdisplay, False);
+          gdk_x11_display_error_trap_pop_ignored (stereo->display);
+          g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "libstereo-declare could not declare the child window: %s", g_strerror (-result));
+          return FALSE;
+        }
+      stereo->child_declared = TRUE;
+    }
+  else if (resized)
+    stereo->lib->one_view (stereo->xdisplay, stereo->own, shown_width, shown_height);
+
+  /* below the window's own surface when the window has an alpha channel, so that the hole GTK keeps there shows it
+   * and the widgets drawn over the area stay over it */
+  if (resized || x != stereo->cx || y != stereo->cy)
+    {
+      StereoChildPlace child_place = { x, y, shown_width, shown_height, stereo->below };
+
+      stereo->lib->place_child (stereo->xdisplay, stereo->own, &child_place);
+    }
+
+  stereo->cx = x;
+  stereo->cy = y;
+  stereo->view_width = view_width;
+  stereo->view_height = view_height;
+  stereo->shown_width = shown_width;
+  stereo->shown_height = shown_height;
+
+  if (!stereo->mapped)
+    {
+      XMapWindow (stereo->xdisplay, stereo->own);
+      if (stereo->frame != None)
+        XMapWindow (stereo->xdisplay, stereo->frame);
+      stereo->mapped = TRUE;
+    }
+
+  if (stereo->readback)
+    x11_draw_readback (stereo, buffer);
+  else
+    {
+      XFlush (stereo->xdisplay);
+      x11_draw_gl (stereo, buffer);
+    }
+
+  XFlush (stereo->xdisplay);
+  gdk_x11_display_error_trap_pop_ignored (stereo->display);
+
+  /* what is drawn before the window manager takes the child is cut to the frame: draw again until it has taken it */
+  if (!stereo->acked)
+    {
+      stereo->tries++;
+      if (stereo->support >= ACK_SUPPORT ? x11_child_acked (stereo) || stereo->tries > 50 : stereo->tries > 10)
+        stereo->acked = TRUE;
+    }
+
+  return TRUE;
+}
+
+#endif /* GDK_WINDOWING_X11 */
+
+GtkGLAreaStereo *
+gtk_gl_area_stereo_new (GtkWidget     *area,
+                        GdkGLContext  *context,
+                        GError       **error)
+{
+  GdkDisplay *display = gtk_widget_get_display (area);
+  GtkGLAreaStereo *stereo;
+
+#ifdef GDK_WINDOWING_WAYLAND
+  if (GDK_IS_WAYLAND_DISPLAY (display))
+    {
+      WaylandGlobals *globals = wayland_globals_get (display, error);
+
+      if (globals == NULL)
+        return NULL;
+
+      stereo = g_new0 (GtkGLAreaStereo, 1);
+      stereo->route = ROUTE_WAYLAND;
+      stereo->globals = globals;
+      stereo->x = stereo->y = G_MININT;
+      goto done;
+    }
+#endif
+
+#ifdef GDK_WINDOWING_X11
+  if (GDK_IS_X11_DISPLAY (display))
+    {
+      StereoDeclare *lib = stereo_declare_load (error);
+      Display *xdisplay;
+      unsigned support;
+      const char *renderer, *readback;
+      GdkWindow *toplevel;
+
+      if (lib == NULL)
+        return NULL;
+
+      xdisplay = gdk_x11_display_get_xdisplay (display);
+      support = lib->supported_x11 (xdisplay);
+      if (support < NEEDED_SUPPORT)
+        {
+          g_set_error (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       support == 0 ? "The window manager does not announce stereo content (_KDE_NET_WM_STEREO_CONTENT_SUPPORTED)"
+                                    : "The window manager announces stereo content version %u, a child that holds both views needs %d",
+                       support, NEEDED_SUPPORT);
+          return NULL;
+        }
+
+      stereo = g_new0 (GtkGLAreaStereo, 1);
+      stereo->route = ROUTE_X11;
+      stereo->lib = lib;
+      stereo->xdisplay = xdisplay;
+      stereo->support = support;
+      toplevel = gdk_window_get_toplevel (gtk_widget_get_window (area));
+      stereo->toplevel = gdk_x11_window_get_xid (toplevel);
+      stereo->below = gdk_visual_get_depth (gdk_window_get_visual (toplevel)) == 32;
+      stereo->cx = stereo->cy = G_MININT;
+
+      /* the way follows the renderer: OpenGL on a graphics card; a software renderer copies through memory either
+       * way, and the readback takes less processor there (measured with GTK 4's same two ways);
+       * GDK_X11_STEREO_READBACK=1 or =0 chooses */
+      gdk_gl_context_make_current (context);
+      renderer = (const char *) glGetString (GL_RENDERER);
+      readback = g_getenv ("GDK_X11_STEREO_READBACK");
+      if (readback != NULL && *readback != '\0')
+        stereo->readback = readback[0] != '0';
+      else
+        stereo->readback = renderer != NULL && (strstr (renderer, "llvmpipe") != NULL || strstr (renderer, "softpipe") != NULL);
+      g_debug ("GtkGLArea %p: an X11 child window, drawn %s (renderer %s), %s the window's own surface",
+               area, stereo->readback ? "through memory" : "with OpenGL", renderer ? renderer : "unknown",
+               stereo->below ? "below" : "above");
+      if (!stereo->below)
+        g_message ("GtkGLArea %p: the window has no alpha channel, so a widget drawn over this X11 stereo area is hidden by it", area);
+      goto done;
+    }
+#endif
+
+  g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "Stereo areas need a Wayland or an X11 display");
+  return NULL;
+
+done:
+  stereo->area = area;
+  stereo->context = g_object_ref (context);
+  stereo->display = display;
+  stereo->current = -1;
+  return stereo;
+}
+
+void
+gtk_gl_area_stereo_free (GtkGLAreaStereo *stereo)
+{
+  if (stereo == NULL)
+    return;
+
+  gdk_gl_context_make_current (stereo->context);
+  for (int i = 0; i < stereo->n_buffers; i++)
+    pair_buffer_clear (stereo, &stereo->buffers[i]);
+
+#ifdef GDK_WINDOWING_WAYLAND
+  if (stereo->route == ROUTE_WAYLAND)
+    {
+      wayland_destroy_surface (stereo);
+      wl_display_flush (stereo->globals->display);
+    }
+#endif
+
+#ifdef GDK_WINDOWING_X11
+  if (stereo->route == ROUTE_X11)
+    {
+      gdk_x11_display_error_trap_push (stereo->display);
+      if (stereo->child_declared)
+        stereo->lib->remove_child (stereo->xdisplay, stereo->toplevel, stereo->own);
+      if (stereo->gc)
+        XFreeGC (stereo->xdisplay, stereo->gc);
+      if (stereo->frame != None)
+        XDestroyWindow (stereo->xdisplay, stereo->frame);
+      else if (stereo->own != None)
+        XDestroyWindow (stereo->xdisplay, stereo->own);
+      XSync (stereo->xdisplay, False);
+      gdk_x11_display_error_trap_pop_ignored (stereo->display);
+    }
+#endif
+
+  g_object_unref (stereo->context);
+  g_free (stereo);
+}
+
+/* Returns the framebuffer the two views are copied into, side by side, left first, or 0 with @error set */
+guint
+gtk_gl_area_stereo_begin (GtkGLAreaStereo  *stereo,
+                          int               view_width,
+                          int               view_height,
+                          GLenum            internal_format,
+                          GError          **error)
+{
+  PairBuffer *buffer = NULL;
+  int i;
+
+#ifdef GDK_WINDOWING_WAYLAND
+  if (stereo->route == ROUTE_WAYLAND)
+    {
+      /* the compositor's releases of the buffers */
+      wl_display_dispatch_queue_pending (stereo->globals->display, stereo->globals->queue);
+      for (i = 0; i < stereo->n_buffers && buffer == NULL; i++)
+        if (!stereo->buffers[i].busy)
+          buffer = &stereo->buffers[i];
+      if (buffer == NULL && stereo->n_buffers < MAX_BUFFERS)
+        buffer = &stereo->buffers[stereo->n_buffers++];
+      if (buffer == NULL)
+        {
+          /* the compositor holds every buffer: take the one shown longest ago */
+          i = (stereo->current + 1) % stereo->n_buffers;
+          buffer = &stereo->buffers[i];
+        }
+    }
+#endif
+
+#ifdef GDK_WINDOWING_X11
+  if (stereo->route == ROUTE_X11)
+    {
+      if (stereo->n_buffers == 0)
+        stereo->n_buffers = 1;
+      buffer = &stereo->buffers[0];
+    }
+#endif
+
+  g_return_val_if_fail (buffer != NULL, 0);
+  stereo->current = buffer - stereo->buffers;
+
+  if (buffer->texture == 0 || buffer->width != 2 * view_width || buffer->height != view_height ||
+      buffer->internal_format != internal_format)
+    {
+      if (!pair_buffer_allocate (stereo, buffer, 2 * view_width, view_height, internal_format, error))
+        return 0;
+    }
+
+  return buffer->framebuffer;
+}
+
+gboolean
+gtk_gl_area_stereo_present (GtkGLAreaStereo     *stereo,
+                            const GdkRectangle  *place,
+                            int                  scale,
+                            GdkColorState       *color_state,
+                            GError             **error)
+{
+  PairBuffer *buffer;
+  gboolean ok = FALSE;
+
+  g_return_val_if_fail (stereo->current >= 0, FALSE);
+  buffer = &stereo->buffers[stereo->current];
+
+  pair_buffer_make_opaque (buffer);
+
+#ifdef GDK_WINDOWING_WAYLAND
+  if (stereo->route == ROUTE_WAYLAND)
+    {
+      /* the views must be in the buffer before the compositor reads it */
+      glFinish ();
+      ok = wayland_present (stereo, buffer, place, color_state, error);
+    }
+#endif
+
+#ifdef GDK_WINDOWING_X11
+  if (stereo->route == ROUTE_X11)
+    ok = x11_present (stereo, buffer, place, scale, color_state, error);
+#endif
+
+  return ok;
+}
+
+void
+gtk_gl_area_stereo_hide (GtkGLAreaStereo *stereo)
+{
+#ifdef GDK_WINDOWING_WAYLAND
+  if (stereo->route == ROUTE_WAYLAND && stereo->surface != NULL && stereo->attached)
+    {
+      wl_surface_attach (stereo->surface, NULL, 0, 0);
+      wl_surface_commit (stereo->surface);
+      stereo->attached = FALSE;
+    }
+#endif
+
+#ifdef GDK_WINDOWING_X11
+  if (stereo->route == ROUTE_X11 && stereo->own != None && stereo->mapped)
+    {
+      gdk_x11_display_error_trap_push (stereo->display);
+      XUnmapWindow (stereo->xdisplay, stereo->frame != None ? stereo->frame : stereo->own);
+      gdk_x11_display_error_trap_pop_ignored (stereo->display);
+      stereo->mapped = FALSE;
+      stereo->acked = FALSE;
+      stereo->tries = 0;
+    }
+#endif
+}
+
+/* Whether the area should draw again soon: on X11, until the window manager has taken the child */
+gboolean
+gtk_gl_area_stereo_wants_repeat (GtkGLAreaStereo *stereo)
+{
+#ifdef GDK_WINDOWING_X11
+  if (stereo->route == ROUTE_X11)
+    return stereo->mapped && !stereo->acked;
+#endif
+  return FALSE;
+}
+
+/* Whether the pair's first row is the top of the picture (a dma-buf the compositor reads) rather than its bottom
+ * (OpenGL's order, which the X11 route draws in) */
+gboolean
+gtk_gl_area_stereo_top_down (GtkGLAreaStereo *stereo)
+{
+  return stereo->route == ROUTE_WAYLAND;
+}
+
+/* Whether the picture lies below the window's own surface, so that the window keeps a transparent hole over it */
+gboolean
+gtk_gl_area_stereo_below_window (GtkGLAreaStereo *stereo)
+{
+#ifdef GDK_WINDOWING_X11
+  if (stereo->route == ROUTE_X11)
+    return stereo->below;
+#endif
+  return TRUE;
+}
