+
+/*
+ * GTK 3 draws a window through one buffer of 8 bit sRGB, with a GtkGLArea's picture copied into it. A stereo area
+ * cannot live there: its two views go to the compositor as one full side by side picture, declared, on a surface of
+ * its own, and the window keeps a transparent hole where the area is, so that the window's own widgets drawn over the
+ * area stay over it.
+ *
+ * Wayland: a wl_subsurface placed below the window's surface, sized with wp_viewporter to one view (the declared
+ * surface is one view wide, kde_stereo_content_v1 version 2, written through libstereo-declare), its buffer a dma-buf
+ * of the pair exported from the area's own OpenGL context (EGL_MESA_image_dma_buf_export), its colour described with
+ * wp_color_management_v1 on its own wl_surface. The subsurface is synchronized: what is committed on it is shown with
+ * the window's next frame, the one GDK is painting.
+ *
+ * X11: a child window of the toplevel that holds the two views side by side, inside a frame window the size of one
+ * view, declared with libstereo-declare's X11 calls and placed below the window's own surface when the window has an
+ * alpha channel. The views are drawn on it with the area's own OpenGL context (GLX), or copied through memory
+ * (glReadPixels, XPutImage) on a software renderer.
+ */
+
+#include "config.h"
+
+#include "gtkglareastereoprivate.h"
+#include "gtkintl.h"
+
+#include <gmodule.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+#ifdef GDK_WINDOWING_WAYLAND
+#include "wayland/gdkwayland.h"
+#include <epoxy/egl.h>
+#include <wayland-client.h>
+#include "viewporter-client-protocol.h"
+#include "linux-dmabuf-v1-client-protocol.h"
+#include "color-management-v1-client-protocol.h"
+#endif
+
+#ifdef GDK_WINDOWING_X11
+#include "x11/gdkx.h"
+#include <epoxy/glx.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <X11/Xatom.h>
+#endif
+
+/* enum stereo_layout and enum stereo_class of libstereo-declare's header */
+#define STEREO_SBS_FULL    3
+#define STEREO_CLASS_NONE  0
+
+/* struct stereo_x11_child_place of libstereo-declare's header */
+typedef struct
+{
+  int x;
+  int y;
+  unsigned width;
+  unsigned height;
+  unsigned below_parent;
+} StereoChildPlace;
+
+struct wl_display;
+struct wl_event_queue;
+struct wl_surface;
+
+/* libstereo-declare is loaded when the first area asks for stereo: libgtk-3-0 depends on it, because stereo areas are
+ * a designed feature, and loading it later keeps every program that never asks free of it */
+typedef struct
+{
+  GModule *module;
+  GError *error;
+  unsigned (* supported_x11)   (void *display);
+  int      (* declare_child)   (void *display, unsigned long parent, unsigned long child, int layout,
+                                int content_class, unsigned subclass, unsigned view_width, unsigned view_height);
+  int      (* one_view)        (void *display, unsigned long window, unsigned width, unsigned height);
+  int      (* place_child)     (void *display, unsigned long window, const StereoChildPlace *place);
+  int      (* remove_child)    (void *display, unsigned long parent, unsigned long child);
+  int      (* wayland_init)    (struct wl_display *display, struct wl_event_queue *queue);
+  unsigned (* supported_wayland) (void);
+  int      (* declare_format)  (struct wl_surface *surface, int layout);
+  int      (* remove_wayland)  (struct wl_surface *surface);
+} StereoDeclare;
+
+static StereoDeclare *
+stereo_declare_load (GError **error)
+{
+  static StereoDeclare lib;
+  static gboolean tried;
+
+  if (!tried)
+    {
+      tried = TRUE;
+      lib.module = g_module_open ("libstereo-declare.so.1", G_MODULE_BIND_LAZY | G_MODULE_BIND_LOCAL);
+      if (lib.module == NULL)
+        g_set_error (&lib.error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                     "libstereo-declare.so.1 cannot be loaded: %s", g_module_error ());
+      else if (!g_module_symbol (lib.module, "stereo_supported_x11", (gpointer *) &lib.supported_x11) ||
+               !g_module_symbol (lib.module, "stereo_declare_x11_child", (gpointer *) &lib.declare_child) ||
+               !g_module_symbol (lib.module, "stereo_declare_x11_one_view_size", (gpointer *) &lib.one_view) ||
+               !g_module_symbol (lib.module, "stereo_declare_x11_child_place", (gpointer *) &lib.place_child) ||
+               !g_module_symbol (lib.module, "stereo_remove_x11_child", (gpointer *) &lib.remove_child) ||
+               !g_module_symbol (lib.module, "stereo_declare_wayland_init", (gpointer *) &lib.wayland_init) ||
+               !g_module_symbol (lib.module, "stereo_supported_wayland", (gpointer *) &lib.supported_wayland) ||
+               !g_module_symbol (lib.module, "stereo_declare_wayland_format", (gpointer *) &lib.declare_format) ||
+               !g_module_symbol (lib.module, "stereo_remove_wayland", (gpointer *) &lib.remove_wayland))
+        {
+          g_set_error (&lib.error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "libstereo-declare.so.1 is older than 1.7.0, which declares X11 children and their place: %s",
+                       g_module_error ());
+          g_clear_pointer (&lib.module, g_module_close);
+        }
+    }
+
+  if (lib.module == NULL)
+    {
+      g_propagate_error (error, g_error_copy (lib.error));
+      return NULL;
+    }
+
+  return &lib;
+}
