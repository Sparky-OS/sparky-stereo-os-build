+/* Whether the area renders a pair: it asks for stereo and has not failed since it asked */
+static gboolean
+gtk_gl_area_renders_pair (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  return priv->stereo && !priv->stereo_failed;
+}
+
+/* The size of what one emission of the render signal draws: a view of a stereo area at its own size when it has one
+ * (gtk_gl_area_set_stereo_view_size()), otherwise the area's size in device pixels */
+static void
+gtk_gl_area_get_buffer_size (GtkGLArea *area,
+                             int       *width,
+                             int       *height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+  GtkWidget *widget = GTK_WIDGET (area);
+  int scale = gtk_widget_get_scale_factor (widget);
+
+  if (gtk_gl_area_renders_pair (area) && priv->stereo_view_width > 0 && priv->stereo_view_height > 0)
+    {
+      *width = priv->stereo_view_width;
+      *height = priv->stereo_view_height;
+    }
+  else
+    {
+      *width = gtk_widget_get_allocated_width (widget) * scale;
+      *height = gtk_widget_get_allocated_height (widget) * scale;
+    }
+}
+
+/* The OpenGL format of the area's framebuffer (@pair FALSE) or of the pair handed to the compositor (@pair TRUE):
+ * single float views go to the compositor in half float, the deepest format a dma-buf has */
+static GLenum
+gtk_gl_area_internal_format (GtkGLArea *area,
+                             gboolean   pair)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  switch (priv->format)
+    {
+    case GDK_MEMORY_ABGR2101010_PREMULTIPLIED:
+      return GL_RGB10_A2;
+    case GDK_MEMORY_R16G16B16A16_PREMULTIPLIED:
+      return GL_RGBA16;
+    case GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED:
+      return GL_RGBA16F;
+    case GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED:
+      return pair ? GL_RGBA16F : GL_RGBA32F;
+    case GDK_MEMORY_R8G8B8A8_PREMULTIPLIED:
+    default:
+      return GL_RGBA8;
+    }
+}
