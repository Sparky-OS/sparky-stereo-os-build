+
+/**
+ * gtk_gl_area_get_stereo_view_size:
+ * @area: a #GtkGLArea
+ * @width: (out) (optional): the width each view is rendered at, or -1
+ * @height: (out) (optional): the height each view is rendered at, or -1
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+void
+gtk_gl_area_get_stereo_view_size (GtkGLArea *area,
+                                  int       *width,
+                                  int       *height)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+
+  if (width)
+    *width = priv->stereo_view_width;
+  if (height)
+    *height = priv->stereo_view_height;
+}
+
+/**
+ * gtk_gl_area_set_format:
+ * @area: a #GtkGLArea
+ * @format: the memory format of the area's framebuffer
+ *
+ * Sets the depth the area renders at. See #GtkGLArea:format.
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+void
+gtk_gl_area_set_format (GtkGLArea       *area,
+                        GdkMemoryFormat  format)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_if_fail (GTK_IS_GL_AREA (area));
+  g_return_if_fail (format == GDK_MEMORY_R8G8B8A8_PREMULTIPLIED ||
+                    format == GDK_MEMORY_ABGR2101010_PREMULTIPLIED ||
+                    format == GDK_MEMORY_R16G16B16A16_PREMULTIPLIED ||
+                    format == GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED ||
+                    format == GDK_MEMORY_R32G32B32A32_FLOAT_PREMULTIPLIED);
