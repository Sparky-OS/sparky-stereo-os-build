+typedef struct _GtkGLAreaStereo GtkGLAreaStereo;
+
+GtkGLAreaStereo * gtk_gl_area_stereo_new           (GtkWidget          *area,
+                                                    GdkGLContext       *context,
+                                                    GError            **error);
+void              gtk_gl_area_stereo_free          (GtkGLAreaStereo    *stereo);
+guint             gtk_gl_area_stereo_begin         (GtkGLAreaStereo    *stereo,
+                                                    int                 view_width,
+                                                    int                 view_height,
+                                                    GLenum              internal_format,
+                                                    GError            **error);
+gboolean          gtk_gl_area_stereo_present       (GtkGLAreaStereo    *stereo,
+                                                    const GdkRectangle *place,
+                                                    int                 scale,
+                                                    GdkColorState      *color_state,
+                                                    GError            **error);
+void              gtk_gl_area_stereo_hide          (GtkGLAreaStereo    *stereo);
+gboolean          gtk_gl_area_stereo_wants_repeat  (GtkGLAreaStereo    *stereo);
+gboolean          gtk_gl_area_stereo_below_window  (GtkGLAreaStereo    *stereo);
+gboolean          gtk_gl_area_stereo_top_down      (GtkGLAreaStereo    *stereo);
