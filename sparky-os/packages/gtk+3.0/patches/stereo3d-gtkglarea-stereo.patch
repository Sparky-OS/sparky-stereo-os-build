+  priv->format = format;
+  priv->told_flat = FALSE;
+  gtk_gl_area_stereo_changed (area);
+  g_object_notify_by_pspec (G_OBJECT (area), obj_props[PROP_FORMAT]);
+}
+
+/**
+ * gtk_gl_area_get_format:
+ * @area: a #GtkGLArea
+ *
+ * Returns: the memory format of the area's framebuffer
+ *
+ * Since: 3.24.52+stereo3d1
+ */
+GdkMemoryFormat
+gtk_gl_area_get_format (GtkGLArea *area)
+{
+  GtkGLAreaPrivate *priv = gtk_gl_area_get_instance_private (area);
+
+  g_return_val_if_fail (GTK_IS_GL_AREA (area), GDK_MEMORY_R8G8B8A8_PREMULTIPLIED);
+
+  return priv->format;
+}
+
+/**
+ * gtk_gl_area_set_color_state:
+ * @area: a #GtkGLArea
+ * @color_state: (nullable): the colour state of the area's values, or %NULL
+ *   for sRGB
+ *
