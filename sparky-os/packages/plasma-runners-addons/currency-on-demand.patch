+class ProxyServer : public QTcpServer
+{
+public:
+    std::function<void(QSslSocket *)> accept;
+
+private:
+    void incomingConnection(qintptr descriptor) override
+    {
+        auto socket = new QSslSocket(this);
+        socket->setSocketDescriptor(descriptor);
+        accept(socket);
+    }
+};
+
+class CurrencyUpdateTest : public KRunner::AbstractRunnerTest
+{
+    Q_OBJECT
+
+private:
+    ProxyServer m_proxy;
+    QList<QSslSocket *> m_requests;
+    QString m_cachePath;
+
+    void reply(QSslSocket *socket, bool success = true)
+    {
+        const QByteArray rates =
+            "<gesmes:Envelope xmlns:gesmes=\"http://www.gesmes.org/xml/2002-08-01\">"
+            "<Cube><Cube time=\"2026-10-08\"><Cube currency=\"USD\" rate=\"2\"/>"
+            "<Cube currency=\"GBP\" rate=\"4\"/></Cube></Cube></gesmes:Envelope>";
+        socket->write(success ? "HTTP/1.1 200 OK\r\n" : "HTTP/1.1 500 Internal Server Error\r\n");
+        socket->write("Content-Type: application/xml\r\nConnection: close\r\nContent-Length: " + QByteArray::number(rates.size()) + "\r\n\r\n" + rates);
+        socket->disconnectFromHost();
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        const auto interfaces = QNetworkInterface::allInterfaces();
+        QVERIFY(std::any_of(interfaces.cbegin(), interfaces.cend(), [](const auto &interface) {
+            return interface.flags().testFlag(QNetworkInterface::IsUp) && !interface.flags().testFlag(QNetworkInterface::IsLoopBack);
+        }));
+        qunsetenv("KFUNITCONVERT_NO_DOWNLOAD");
+        QStandardPaths::setTestModeEnabled(true);
+        m_cachePath = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/libkunitconversion/currency.xml");
+        QFile::remove(m_cachePath);
+
+        // Create an ephemeral certificate in memory; no files or external server are used.
+        QProcess openssl;
+        openssl.start(QStringLiteral("openssl"),
+                      {QStringLiteral("req"),
+                       QStringLiteral("-x509"),
+                       QStringLiteral("-newkey"),
+                       QStringLiteral("rsa:2048"),
+                       QStringLiteral("-nodes"),
+                       QStringLiteral("-days"),
+                       QStringLiteral("1"),
+                       QStringLiteral("-subj"),
+                       QStringLiteral("/CN=www.ecb.europa.eu"),
+                       QStringLiteral("-addext"),
+                       QStringLiteral("subjectAltName=DNS:www.ecb.europa.eu"),
+                       QStringLiteral("-keyout"),
+                       QStringLiteral("/dev/stdout"),
+                       QStringLiteral("-out"),
+                       QStringLiteral("/dev/stdout")});
+        QVERIFY(openssl.waitForFinished(30000));
+        QCOMPARE(openssl.exitCode(), 0);
+        const auto pem = openssl.readAllStandardOutput();
+        const auto certificates = QSslCertificate::fromData(pem);
+        QCOMPARE(certificates.size(), 1);
+        const auto certificate = certificates.constFirst();
+        const QSslKey key(pem, QSsl::Rsa);
+        QVERIFY(!key.isNull());
+        auto ssl = QSslConfiguration::defaultConfiguration();
+        ssl.setCaCertificates(certificates);
+        QSslConfiguration::setDefaultConfiguration(ssl);
+
+        m_proxy.accept = [this, certificate, key](QSslSocket *socket) {
+            socket->setLocalCertificate(certificate);
+            socket->setPrivateKey(key);
+            connect(socket, &QSslSocket::readyRead, this, [this, socket, buffer = QByteArray()]() mutable {
+                buffer += socket->readAll();
+                if (!buffer.contains("\r\n\r\n")) {
+                    return;
+                }
+                if (!socket->isEncrypted()) {
+                    QVERIFY(buffer.startsWith("CONNECT www.ecb.europa.eu:443 "));
+                    buffer.clear();
+                    socket->write("HTTP/1.1 200 Connection Established\r\n\r\n");
+                    socket->startServerEncryption();
+                } else {
+                    QVERIFY(buffer.startsWith("GET /stats/eurofxref/eurofxref-daily.xml "));
+                    m_requests.append(socket);
+                    buffer.clear();
+                }
+            });
+        };
+        QVERIFY(m_proxy.listen(QHostAddress::LocalHost));
+        QNetworkProxy::setApplicationProxy(QNetworkProxy(QNetworkProxy::HttpProxy, QStringLiteral("127.0.0.1"), m_proxy.serverPort()));
+
+        initProperties();
+        launchQuery(QStringLiteral("initialization-probe"));
+        QTest::qWait(500);
+    }
+
+    void noRequestAtStartup()
+    {
+        QCOMPARE(m_requests.size(), 0);
+        QVERIFY(!QFile::exists(m_cachePath));
+    }
+
+    void noRequestForLocalConversions()
+    {
+        const auto matches = launchQuery(QStringLiteral("1 m in cm"));
+        QCOMPARE(matches.size(), 1);
+        QCOMPARE(matches.constFirst().text(), QStringLiteral("100 centimeters (cm)"));
+        launchQuery(QStringLiteral("1/0 USD in GBP"));
+        QTest::qWait(100);
+        QCOMPARE(m_requests.size(), 0);
+        QVERIFY(!QFile::exists(m_cachePath));
+    }
+
+    void firstCurrencyQueryFetchesRates()
+    {
+        const auto before = m_requests.size();
+        launchQuery(QStringLiteral("1 USD in GBP"));
+        QTRY_COMPARE(m_requests.size(), before + 1);
+        QVERIFY(manager->matches().isEmpty());
+        reply(m_requests.constLast());
+        QTRY_COMPARE(manager->matches().size(), 1);
+        QVERIFY(manager->matches().constFirst().text().startsWith(QStringLiteral("2.00 ")));
+        QVERIFY(manager->matches().constFirst().text().endsWith(QStringLiteral(" (GBP)")));
+        QVERIFY(QFile::exists(m_cachePath));
+
+        const auto cached = launchQuery(QStringLiteral("2 USD in GBP"));
+        QCOMPARE(cached.size(), 1);
+        QVERIFY(cached.constFirst().text().startsWith(QStringLiteral("4.00 ")));
+        QVERIFY(cached.constFirst().text().endsWith(QStringLiteral(" (GBP)")));
+        QCOMPARE(m_requests.size(), before + 1);
+
+        QFile cache(m_cachePath);
+        QVERIFY(cache.open(QIODevice::ReadWrite));
+        QVERIFY(cache.setFileTime(QDateTime::currentDateTime().addDays(-2), QFileDevice::FileModificationTime));
+        cache.close();
+        launchQuery(QStringLiteral("2 m in cm"));
+        QTest::qWait(100);
+        QCOMPARE(m_requests.size(), before + 1);
+
+        launchQuery(QStringLiteral("3 USD in GBP"));
+        QTRY_COMPARE(m_requests.size(), before + 2);
+        launchQuery(QStringLiteral("3 m in cm"));
+        reply(m_requests.constLast());
+        QTest::qWait(200);
+        QCOMPARE(manager->matches().size(), 1);
+        QCOMPARE(manager->matches().constFirst().text(), QStringLiteral("300 centimeters (cm)"));
+        QCOMPARE(m_requests.size(), before + 2);
+    }
+
+    void cleanupTestCase()
+    {
+        for (auto socket : std::as_const(m_requests)) {
+            if (socket->state() == QAbstractSocket::ConnectedState) {
+                reply(socket, false);
+            }
+        }
+        QTest::qWait(100);
+        manager.reset();
+        QTest::qWait(100);
+        QFile::remove(m_cachePath);
+        QNetworkProxy::setApplicationProxy(QNetworkProxy(QNetworkProxy::NoProxy));
+    }
+};
+
+QTEST_MAIN(CurrencyUpdateTest)
+
+#include "currencyupdatetest.moc"
