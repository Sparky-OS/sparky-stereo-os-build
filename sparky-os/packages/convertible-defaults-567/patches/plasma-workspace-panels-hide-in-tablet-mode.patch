 void PanelView::setVisibilityMode(PanelView::VisibilityMode mode)
+{
+    // This is the person's own choice. It is kept, and written, also while tablet mode
+    // hides the panel, and it is what the panel goes back to when tablet mode ends.
+    if (m_userVisibilityMode != mode) {
+        m_userVisibilityMode = mode;
+
+        if (config().isValid() && config().parent().isValid()) {
+            // panelVisibility is not resolution dependent, don't write to Defaults
+            config().parent().writeEntry("panelVisibility", (int)mode);
+            m_corona->requestApplicationConfigSync();
+        }
+    }
+
+    applyVisibilityMode(m_hiddenForTabletMode ? AutoHide : mode);
+}
+
+void PanelView::applyVisibilityMode(PanelView::VisibilityMode mode)
 {
     if (m_visibilityMode == mode) {
         return;
@@ -523,12 +541,6 @@ void PanelView::setVisibilityMode(PanelView::VisibilityMode mode)
         connect(containment(), &Plasma::Applet::activated, this, &PanelView::showTemporarily);
     }
 
-    if (config().isValid() && config().parent().isValid()) {
-        // panelVisibility is not resolution dependent, don't write to Defaults
-        config().parent().writeEntry("panelVisibility", (int)mode);
-        m_corona->requestApplicationConfigSync();
-    }
-
     updateExclusiveZone();
 
     Q_EMIT visibilityModeChanged();
@@ -541,6 +553,21 @@ PanelView::VisibilityMode PanelView::visibilityMode() const
     return m_visibilityMode;
 }
 
+PanelView::VisibilityMode PanelView::userVisibilityMode() const
+{
+    return m_userVisibilityMode;
+}
+
+void PanelView::setHiddenForTabletMode(bool hidden)
+{
+    if (m_hiddenForTabletMode == hidden) {
+        return;
+    }
+
+    m_hiddenForTabletMode = hidden;
+    applyVisibilityMode(hidden ? AutoHide : m_userVisibilityMode);
+}
+
 PanelView::OpacityMode PanelView::opacityMode() const
 {
     if (!m_theme.adaptiveTransparencyEnabled()) {
@@ -1128,7 +1155,7 @@ void PanelView::integrateScreen()
         }
     }
 #endif
-    setVisibilityMode(m_visibilityMode);
+    setVisibilityMode(m_userVisibilityMode);
 
     if (containment()) {
         containment()->reactToScreenChange();
