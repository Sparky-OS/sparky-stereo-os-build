[Desktop Entry]
Type=Application
Version=1.5
Name=Stereo Model Viewer
GenericName=3D Model Viewer
Comment=Open a 3D model, look at it and turn it
Exec=stereo-model-viewer %F
Icon=applications-graphics
Terminal=false
StartupNotify=true
Categories=Qt;KDE;Graphics;3DGraphics;Viewer;
MimeType=model/gltf-binary;model/gltf+json;model/obj;model/stl;model/3mf;model/iges;model/vrml;model/x-ply;model/x-gaussian-splat;model/x-spz;model/x-pts;model/x-fbx;model/vnd.collada+xml;model/x-off;model/x-draco;model/step;model/x-brep;image/vnd.dxf;
Keywords=3D;model;mesh;point cloud;CAD;glTF;STL;OBJ;PLY;STEP;splat;stereo;
X-KDE-StartupNotify=true
