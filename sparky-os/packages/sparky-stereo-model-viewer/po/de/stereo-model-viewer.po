msgctxt "@title:window"
msgid "Stereo Model Viewer"
msgstr "Stereo-Modellbetrachter"

msgctxt "@title"
msgid "Open a 3D model, look at it and turn it"
msgstr "Ein 3D-Modell öffnen, ansehen und drehen"

msgctxt "@title:window"
msgid "Open a 3D model"
msgstr "3D-Modell öffnen"

msgctxt "@action:button"
msgid "Open…"
msgstr "Öffnen…"

msgctxt "@action:button"
msgid "Recent files"
msgstr "Zuletzt geöffnet"

msgctxt "@action:inmenu"
msgid "Clear the list"
msgstr "Liste leeren"

msgctxt "@action:button"
msgid "Reset view"
msgstr "Ansicht zurücksetzen"

msgctxt "@action:button"
msgid "Play the animation"
msgstr "Animation abspielen"

msgctxt "@action:button"
msgid "Stop the animation"
msgstr "Animation anhalten"

msgctxt "@action:button"
msgid "Render resolution per eye"
msgstr "Renderauflösung pro Auge"

msgctxt "@item:inmenu"
msgid "Half of the area"
msgstr "Halb so groß wie der Bereich"

msgctxt "@item:inmenu"
msgid "The size of the area"
msgstr "So groß wie der Bereich"

msgctxt "@item:inmenu"
msgid "One and a half times the area"
msgstr "Eineinhalbfach der Bereich"

msgctxt "@item:inmenu"
msgid "Twice the area"
msgstr "Doppelt so groß wie der Bereich"

msgctxt "@info placeholder"
msgid "Open a 3D model or drop a file here"
msgstr "Öffnen Sie ein 3D-Modell oder legen Sie hier eine Datei ab"

msgctxt "@info the file is not a model the viewer knows"
msgid "“%1” is not a 3D model format the viewer can read."
msgstr "„%1“ ist kein 3D-Modellformat, das der Betrachter lesen kann."

msgctxt "@info a model file that cannot be read"
msgid "“%1” cannot be read: it is damaged or not a valid model file."
msgstr "„%1“ kann nicht gelesen werden: Die Datei ist beschädigt oder keine gültige Modelldatei."

msgctxt "@info:shell"
msgid "A model to open"
msgstr "Ein zu öffnendes Modell"

msgctxt "@item:inlistbox file dialog filter"
msgid "3D models (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"
msgstr "3D-Modelle (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"

msgctxt "@item:inlistbox file dialog filter"
msgid "All files (*)"
msgstr "Alle Dateien (*)"

msgctxt "@action:button"
msgid "Enable 3D"
msgstr "3D aktivieren"

msgctxt "@action:button"
msgid "Display Settings"
msgstr "Anzeigeeinstellungen"

msgctxt "@info"
msgid "Display Settings could not be opened: kcmshell6 was not found"
msgstr "Die Anzeigeeinstellungen konnten nicht geöffnet werden: kcmshell6 wurde nicht gefunden"

msgctxt "@info"
msgid "3D could not be enabled: this display offers no stereo window"
msgstr "3D konnte nicht aktiviert werden: dieser Bildschirm bietet kein Stereo-Fenster"

msgctxt "@info"
msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
msgstr "3D-Tiefe: Dieser Desktop bietet keine Tiefengrenzen, deshalb sehen beide Augen dasselbe Bild"

msgctxt "@info"
msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
msgstr "3D-Tiefe: Der Desktop hat die Tiefengrenzen noch nicht geliefert, beide Augen sehen vorerst dasselbe Bild"

msgctxt "@info"
msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
msgstr "3D-Tiefe: Dieses Fenster kann die Tiefengrenzen des Desktops nicht lesen, deshalb sehen beide Augen dasselbe Bild"
