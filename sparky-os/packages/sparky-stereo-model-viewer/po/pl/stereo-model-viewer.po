msgctxt "@title:window"
msgid "Stereo Model Viewer"
msgstr "Przeglądarka modeli stereo"

msgctxt "@title"
msgid "Open a 3D model, look at it and turn it"
msgstr "Otwórz model 3D, obejrzyj go i obracaj"

msgctxt "@title:window"
msgid "Open a 3D model"
msgstr "Otwórz model 3D"

msgctxt "@action:button"
msgid "Open…"
msgstr "Otwórz…"

msgctxt "@action:button"
msgid "Recent files"
msgstr "Ostatnie pliki"

msgctxt "@action:inmenu"
msgid "Clear the list"
msgstr "Wyczyść listę"

msgctxt "@action:button"
msgid "Reset view"
msgstr "Przywróć widok"

msgctxt "@action:button"
msgid "Play the animation"
msgstr "Odtwórz animację"

msgctxt "@action:button"
msgid "Stop the animation"
msgstr "Zatrzymaj animację"

msgctxt "@action:button"
msgid "Render resolution per eye"
msgstr "Rozdzielczość renderowania na oko"

msgctxt "@item:inmenu"
msgid "Half of the area"
msgstr "Połowa obszaru"

msgctxt "@item:inmenu"
msgid "The size of the area"
msgstr "Rozmiar obszaru"

msgctxt "@item:inmenu"
msgid "One and a half times the area"
msgstr "Półtora raza obszaru"

msgctxt "@item:inmenu"
msgid "Twice the area"
msgstr "Dwa razy obszar"

msgctxt "@info placeholder"
msgid "Open a 3D model or drop a file here"
msgstr "Otwórz model 3D lub upuść tu plik"

msgctxt "@info the file is not a model the viewer knows"
msgid "“%1” is not a 3D model format the viewer can read."
msgstr "„%1” nie jest formatem modelu 3D, który przeglądarka potrafi odczytać."

msgctxt "@info a model file that cannot be read, then the reason"
msgid "“%1” cannot be read: %2"
msgstr "Nie można odczytać „%1”: %2"

msgctxt "@info:shell"
msgid "A model to open"
msgstr "Model do otwarcia"

msgctxt "@item:inlistbox file dialog filter"
msgid "3D models (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"
msgstr "Modele 3D (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"

msgctxt "@item:inlistbox file dialog filter"
msgid "All files (*)"
msgstr "Wszystkie pliki (*)"

msgctxt "@action:button"
msgid "Enable 3D"
msgstr "Włącz 3D"

msgctxt "@action:button"
msgid "Display Settings"
msgstr "Ustawienia ekranu"

msgctxt "@info"
msgid "Display Settings could not be opened: kcmshell6 was not found"
msgstr "Nie można otworzyć ustawień ekranu: nie znaleziono kcmshell6"

msgctxt "@info"
msgid "3D could not be enabled: this display offers no stereo window"
msgstr "Nie można włączyć 3D: ten ekran nie udostępnia okna stereo"

msgctxt "@info"
msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
msgstr "Głębia 3D: ten pulpit nie podaje limitów głębi, więc oba oczy widzą ten sam obraz"

msgctxt "@info"
msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
msgstr "Głębia 3D: pulpit nie przekazał jeszcze limitów głębi, na razie oba oczy widzą ten sam obraz"

msgctxt "@info"
msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
msgstr "Głębia 3D: to okno nie może odczytać limitów głębi pulpitu, więc oba oczy widzą ten sam obraz"
