msgctxt "@title:window"
msgid "Stereo Model Viewer"
msgstr "Visor de modelos estéreo"

msgctxt "@title"
msgid "Open a 3D model, look at it and turn it"
msgstr "Abrir un modelo 3D, mirarlo y girarlo"

msgctxt "@title:window"
msgid "Open a 3D model"
msgstr "Abrir un modelo 3D"

msgctxt "@action:button"
msgid "Open…"
msgstr "Abrir…"

msgctxt "@action:button"
msgid "Recent files"
msgstr "Archivos recientes"

msgctxt "@action:inmenu"
msgid "Clear the list"
msgstr "Vaciar la lista"

msgctxt "@action:button"
msgid "Reset view"
msgstr "Restablecer la vista"

msgctxt "@action:button"
msgid "Play the animation"
msgstr "Reproducir la animación"

msgctxt "@action:button"
msgid "Stop the animation"
msgstr "Detener la animación"

msgctxt "@action:button"
msgid "Render resolution per eye"
msgstr "Resolución de renderizado por ojo"

msgctxt "@item:inmenu"
msgid "Half of the area"
msgstr "La mitad del área"

msgctxt "@item:inmenu"
msgid "The size of the area"
msgstr "El tamaño del área"

msgctxt "@item:inmenu"
msgid "One and a half times the area"
msgstr "Una vez y media el área"

msgctxt "@item:inmenu"
msgid "Twice the area"
msgstr "El doble del área"

msgctxt "@info placeholder"
msgid "Open a 3D model or drop a file here"
msgstr "Abra un modelo 3D o suelte un archivo aquí"

msgctxt "@info the file is not a model the viewer knows"
msgid "“%1” is not a 3D model format the viewer can read."
msgstr "«%1» no es un formato de modelo 3D que el visor pueda leer."

msgctxt "@info a model file that cannot be read, then the reason"
msgid "“%1” cannot be read: %2"
msgstr "«%1» no se puede leer: %2"

msgctxt "@info:shell"
msgid "A model to open"
msgstr "Un modelo para abrir"

msgctxt "@item:inlistbox file dialog filter"
msgid "3D models (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"
msgstr "Modelos 3D (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"

msgctxt "@item:inlistbox file dialog filter"
msgid "All files (*)"
msgstr "Todos los archivos (*)"

msgctxt "@action:button"
msgid "Enable 3D"
msgstr "Activar 3D"

msgctxt "@action:button"
msgid "Display Settings"
msgstr "Configuración de pantalla"

msgctxt "@info"
msgid "Display Settings could not be opened: kcmshell6 was not found"
msgstr "No se pudo abrir la configuración de pantalla: no se encontró kcmshell6"

msgctxt "@info"
msgid "3D could not be enabled: this display offers no stereo window"
msgstr "No se pudo activar el 3D: esta pantalla no ofrece una ventana estéreo"

msgctxt "@info"
msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
msgstr "Profundidad 3D: este escritorio no ofrece límites de profundidad, así que los dos ojos ven la misma imagen"

msgctxt "@info"
msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
msgstr "Profundidad 3D: el escritorio aún no ha entregado los límites de profundidad, por ahora los dos ojos ven la misma imagen"

msgctxt "@info"
msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
msgstr "Profundidad 3D: esta ventana no puede leer los límites de profundidad del escritorio, así que los dos ojos ven la misma imagen"
