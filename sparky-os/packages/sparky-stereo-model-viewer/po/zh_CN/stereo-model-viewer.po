msgctxt "@title:window"
msgid "Stereo Model Viewer"
msgstr "立体模型查看器"

msgctxt "@title"
msgid "Open a 3D model, look at it and turn it"
msgstr "打开 3D 模型，查看并旋转它"

msgctxt "@title:window"
msgid "Open a 3D model"
msgstr "打开 3D 模型"

msgctxt "@action:button"
msgid "Open…"
msgstr "打开…"

msgctxt "@action:button"
msgid "Recent files"
msgstr "最近的文件"

msgctxt "@action:inmenu"
msgid "Clear the list"
msgstr "清除列表"

msgctxt "@action:button"
msgid "Reset view"
msgstr "重置视图"

msgctxt "@action:button"
msgid "Play the animation"
msgstr "播放动画"

msgctxt "@action:button"
msgid "Stop the animation"
msgstr "停止动画"

msgctxt "@action:button"
msgid "Render resolution per eye"
msgstr "每只眼睛的渲染分辨率"

msgctxt "@item:inmenu"
msgid "Half of the area"
msgstr "区域的一半"

msgctxt "@item:inmenu"
msgid "The size of the area"
msgstr "与区域相同"

msgctxt "@item:inmenu"
msgid "One and a half times the area"
msgstr "区域的 1.5 倍"

msgctxt "@item:inmenu"
msgid "Twice the area"
msgstr "区域的 2 倍"

msgctxt "@info placeholder"
msgid "Open a 3D model or drop a file here"
msgstr "打开 3D 模型，或将文件拖放到此处"

msgctxt "@info the file is not a model the viewer knows"
msgid "“%1” is not a 3D model format the viewer can read."
msgstr "“%1”不是查看器可以读取的 3D 模型格式。"

msgctxt "@info a model file that cannot be read, then the reason"
msgid "“%1” cannot be read: %2"
msgstr "无法读取“%1”：%2"

msgctxt "@info:shell"
msgid "A model to open"
msgstr "要打开的模型"

msgctxt "@item:inlistbox file dialog filter"
msgid "3D models (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"
msgstr "3D 模型 (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"

msgctxt "@item:inlistbox file dialog filter"
msgid "All files (*)"
msgstr "所有文件 (*)"

msgctxt "@action:button"
msgid "Enable 3D"
msgstr "启用 3D"

msgctxt "@action:button"
msgid "Display Settings"
msgstr "显示设置"

msgctxt "@info"
msgid "Display Settings could not be opened: kcmshell6 was not found"
msgstr "无法打开显示设置：找不到 kcmshell6"

msgctxt "@info"
msgid "3D could not be enabled: this display offers no stereo window"
msgstr "无法启用 3D：此显示器不提供立体窗口"

msgctxt "@info"
msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
msgstr "3D 深度：此桌面未提供深度限制，因此两眼显示相同的画面"

msgctxt "@info"
msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
msgstr "3D 深度：桌面尚未提供深度限制，暂时两眼显示相同的画面"

msgctxt "@info"
msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
msgstr "3D 深度：此窗口无法读取桌面的深度限制，因此两眼显示相同的画面"
