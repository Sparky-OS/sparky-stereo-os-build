msgctxt "@title:window"
msgid "Stereo Model Viewer"
msgstr "Visualizador de modelos estéreo"

msgctxt "@title"
msgid "Open a 3D model, look at it and turn it"
msgstr "Abra um modelo 3D, olhe e gire"

msgctxt "@title:window"
msgid "Open a 3D model"
msgstr "Abrir um modelo 3D"

msgctxt "@action:button"
msgid "Open…"
msgstr "Abrir…"

msgctxt "@action:button"
msgid "Recent files"
msgstr "Arquivos recentes"

msgctxt "@action:inmenu"
msgid "Clear the list"
msgstr "Limpar a lista"

msgctxt "@action:button"
msgid "Reset view"
msgstr "Restaurar a vista"

msgctxt "@action:button"
msgid "Play the animation"
msgstr "Reproduzir a animação"

msgctxt "@action:button"
msgid "Stop the animation"
msgstr "Parar a animação"

msgctxt "@action:button"
msgid "Render resolution per eye"
msgstr "Resolução de renderização por olho"

msgctxt "@item:inmenu"
msgid "Half of the area"
msgstr "Metade da área"

msgctxt "@item:inmenu"
msgid "The size of the area"
msgstr "O tamanho da área"

msgctxt "@item:inmenu"
msgid "One and a half times the area"
msgstr "Uma vez e meia a área"

msgctxt "@item:inmenu"
msgid "Twice the area"
msgstr "Duas vezes a área"

msgctxt "@info placeholder"
msgid "Open a 3D model or drop a file here"
msgstr "Abra um modelo 3D ou solte um arquivo aqui"

msgctxt "@info the file is not a model the viewer knows"
msgid "“%1” is not a 3D model format the viewer can read."
msgstr "“%1” não é um formato de modelo 3D que o visualizador consiga ler."

msgctxt "@info a model file that cannot be read, then the reason"
msgid "“%1” cannot be read: %2"
msgstr "“%1” não pode ser lido: %2"

msgctxt "@info:shell"
msgid "A model to open"
msgstr "Um modelo para abrir"

msgctxt "@item:inlistbox file dialog filter"
msgid "3D models (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"
msgstr "Modelos 3D (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"

msgctxt "@item:inlistbox file dialog filter"
msgid "All files (*)"
msgstr "Todos os arquivos (*)"

msgctxt "@action:button"
msgid "Enable 3D"
msgstr "Ativar 3D"

msgctxt "@action:button"
msgid "Display Settings"
msgstr "Configurações de tela"

msgctxt "@info"
msgid "Display Settings could not be opened: kcmshell6 was not found"
msgstr "Não foi possível abrir as configurações de tela: kcmshell6 não foi encontrado"

msgctxt "@info"
msgid "3D could not be enabled: this display offers no stereo window"
msgstr "Não foi possível ativar o 3D: esta tela não oferece uma janela estéreo"

msgctxt "@info"
msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
msgstr "Profundidade 3D: este desktop não oferece limites de profundidade, então os dois olhos veem a mesma imagem"

msgctxt "@info"
msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
msgstr "Profundidade 3D: o desktop ainda não entregou os limites de profundidade, por enquanto os dois olhos veem a mesma imagem"

msgctxt "@info"
msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
msgstr "Profundidade 3D: esta janela não consegue ler os limites de profundidade do desktop, então os dois olhos veem a mesma imagem"
