msgctxt "@title:window"
msgid "Stereo Model Viewer"
msgstr "Visionneuse de modèles stéréo"

msgctxt "@title"
msgid "Open a 3D model, look at it and turn it"
msgstr "Ouvrir un modèle 3D, le regarder et le tourner"

msgctxt "@title:window"
msgid "Open a 3D model"
msgstr "Ouvrir un modèle 3D"

msgctxt "@action:button"
msgid "Open…"
msgstr "Ouvrir…"

msgctxt "@action:button"
msgid "Recent files"
msgstr "Fichiers récents"

msgctxt "@action:inmenu"
msgid "Clear the list"
msgstr "Vider la liste"

msgctxt "@action:button"
msgid "Reset view"
msgstr "Réinitialiser la vue"

msgctxt "@action:button"
msgid "Play the animation"
msgstr "Lire l’animation"

msgctxt "@action:button"
msgid "Stop the animation"
msgstr "Arrêter l’animation"

msgctxt "@action:button"
msgid "Render resolution per eye"
msgstr "Résolution de rendu par œil"

msgctxt "@item:inmenu"
msgid "Half of the area"
msgstr "La moitié de la zone"

msgctxt "@item:inmenu"
msgid "The size of the area"
msgstr "La taille de la zone"

msgctxt "@item:inmenu"
msgid "One and a half times the area"
msgstr "Une fois et demie la zone"

msgctxt "@item:inmenu"
msgid "Twice the area"
msgstr "Deux fois la zone"

msgctxt "@info placeholder"
msgid "Open a 3D model or drop a file here"
msgstr "Ouvrez un modèle 3D ou déposez un fichier ici"

msgctxt "@info the file is not a model the viewer knows"
msgid "“%1” is not a 3D model format the viewer can read."
msgstr "« %1 » n’est pas un format de modèle 3D que la visionneuse sait lire."

msgctxt "@info a model file that cannot be read"
msgid "“%1” cannot be read: it is damaged or not a valid model file."
msgstr "« %1 » ne peut pas être lu : le fichier est endommagé ou n’est pas un modèle valide."

msgctxt "@info:shell"
msgid "A model to open"
msgstr "Un modèle à ouvrir"

msgctxt "@item:inlistbox file dialog filter"
msgid "3D models (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"
msgstr "Modèles 3D (*.glb *.gltf *.obj *.stl *.ply *.3mf *.fbx *.dae *.off *.step *.stp *.brep *.iges *.igs *.drc *.splat *.spz *.pts *.vtk *.vtp *.vtu *.3ds *.wrl *.xyz *.dxf)"

msgctxt "@item:inlistbox file dialog filter"
msgid "All files (*)"
msgstr "Tous les fichiers (*)"

msgctxt "@action:button"
msgid "Enable 3D"
msgstr "Activer la 3D"

msgctxt "@action:button"
msgid "Display Settings"
msgstr "Paramètres d’affichage"

msgctxt "@info"
msgid "Display Settings could not be opened: kcmshell6 was not found"
msgstr "Impossible d’ouvrir les paramètres d’affichage : kcmshell6 est introuvable"

msgctxt "@info"
msgid "3D could not be enabled: this display offers no stereo window"
msgstr "Impossible d’activer la 3D : cet affichage ne propose pas de fenêtre stéréo"

msgctxt "@info"
msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
msgstr "Profondeur 3D : ce bureau n’offre pas de limites de profondeur, les deux yeux voient donc la même image"

msgctxt "@info"
msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
msgstr "Profondeur 3D : le bureau n’a pas encore transmis les limites de profondeur, les deux yeux voient la même image pour l’instant"

msgctxt "@info"
msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
msgstr "Profondeur 3D : cette fenêtre ne peut pas lire les limites de profondeur du bureau, les deux yeux voient donc la même image"
