index 4423914..7fa2a51 100644
--- a/app/mainwindow.cpp
+++ b/app/mainwindow.cpp
@@ -96,6 +96,7 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
 #include "infocontextmanageritem.h"
 #include "viewmainpage.h"
 #ifdef GWENVIEW_STEREO
+#include <filechoicemenu.h>
 #include <widgetlayer.h>
 #endif
 #ifndef GWENVIEW_SEMANTICINFO_BACKEND_NONE
@@ -464,13 +465,21 @@ struct MainWindow::Private {
             addStereoEyeMode(QStringLiteral("stereo_both_eyes"), i18n("Stereo"), ViewMainPage::StereoEyeMode::Stereo, Qt::ALT | Qt::SHIFT | Qt::Key_D);
         addStereoEyeMode(QStringLiteral("stereo_left_only"), i18n("Left eye only"), ViewMainPage::StereoEyeMode::LeftOnly, Qt::ALT | Qt::SHIFT | Qt::Key_L);
         addStereoEyeMode(QStringLiteral("stereo_right_only"), i18n("Right eye only"), ViewMainPage::StereoEyeMode::RightOnly, Qt::ALT | Qt::SHIFT | Qt::Key_O);
-        addStereoEyeMode(QStringLiteral("stereo_not_3d"), i18n("Not 3D"), ViewMainPage::StereoEyeMode::Not3D, Qt::ALT | Qt::SHIFT | Qt::Key_N);
         stereoBoth->setChecked(true);
+        // The program's own switch for every picture it shows, for the session: the stereo layer's "Enable 3D", in the
+        // same words as every program on the layer, beside the file's own corrections ("Not 3D" for one file is in the
+        // layer's menu). Alt+Shift+N is this switch again, as before the file's entries became the layer's.
+        auto enable3D = new Stereo::Enable3DAction(q);
+        stereo->addAction(enable3D->objectName(), enable3D);
+        actionCollection->setDefaultShortcut(enable3D, Qt::ALT | Qt::SHIFT | Qt::Key_N);
+        connect(enable3D, &QAction::triggered, q, [this](bool enabled) {
+            mViewMainPage->setStereoEnabled(enabled);
+        });
         // For a local file the 3D menu's per-file entries are the stereo layer's menu (stereo_file_choice, made by the
         // view page). The actions above that it replaces in the menu stay for their shortcuts, and act on the same
         // per-file store: a shortcut works on an action its window holds.
         for (const char *name : {"stereo_input_auto", "stereo_input_sbs_left", "stereo_input_sbs_right", "stereo_input_tab_left", "stereo_input_tab_right",
-                 "stereo_swap_eyes", "stereo_anaglyph_to_sbs", "stereo_not_3d"}) {
+                 "stereo_swap_eyes", "stereo_anaglyph_to_sbs"}) {
             q->addAction(actionCollection->action(QLatin1String(name)));
         }
 #endif
