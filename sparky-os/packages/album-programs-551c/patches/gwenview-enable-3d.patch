Description: Gwenview's own Enable 3D for every picture, beside the file's corrections (ORDER 551c)
 The view's switch that shows every picture flat comes back, as the stereo layer's Enable3DAction (the same words in
 every program on the layer), for the session as before +stereo3d10; Alt+Shift+N is that switch again. A file's own Not 3D
 stays in the layer's per-file menu. Needs libstereo-layer-dev (>= 1.19.2).
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Forwarded: not-needed
Last-Update: 2026-11-15
---
diff --git a/app/gwenviewui.rc b/app/gwenviewui.rc
index c5ff250..0e3f00f 100644
--- a/app/gwenviewui.rc
+++ b/app/gwenviewui.rc
@@ -1,6 +1,6 @@
 <?xml version="1.0"?>
 <!DOCTYPE gui SYSTEM "kpartgui.dtd">
-<gui name="gwenview" version="73">
+<gui name="gwenview" version="74">
 
 <MenuBar>
     <Menu name="file" >
@@ -24,6 +24,7 @@
         <Action name="view_toggle_spotlightmode" />
         <Menu name="stereo3d">
             <text>3D</text>
+            <Action name="stereo_enable_3d" />
             <Action name="stereo_file_choice" />
             <Separator />
             <Action name="stereo_both_eyes" />
