 void stereoFileMoved(const QString& from, const QString& to)
 {
 #ifdef HAVE_STEREO_LAYER
@@ -31,9 +83,20 @@ void stereoFileMoved(const QString& from, const QString& to)
 
     if (failed)
     {
-        // The choice is still kept under the old path; the file shows as its own marks say until it is chosen again
+        // The choice is still kept under the old path; the file shows as its own marks say until it is chosen again.
+        // The person is told, whatever thread the move ran in (digiKam's file jobs run in worker threads): the
+        // message is shown from the main thread.
 
         qCWarning(DIGIKAM_WIDGETS_LOG) << "The 3D choice of" << from << "could not follow it to" << to << ":" << error;
+
+        if (qApp)
+        {
+            QMetaObject::invokeMethod(qApp, [error]()
+                {
+                    tellCarryFailure(error);
+                },
+                Qt::QueuedConnection);
+        }
     }
 
 #else
