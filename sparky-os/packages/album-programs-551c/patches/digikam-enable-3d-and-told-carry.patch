 namespace Digikam
 {
 
+#ifdef HAVE_STEREO_LAYER
+
+namespace
+{
+
+/**
+ * The carries that failed and are not shown yet. Touched in the main thread only.
+ */
+QStringList& unshownCarryFailures()
+{
+    static QStringList messages;
+
+    return messages;
+}
+
+/**
+ * In the main thread: one message for every carry that failed since the last one was shown, so a job that moves
+ * many files gives the person one window, not one per file.
+ */
+void tellCarryFailure(const QString& error)
+{
+    QStringList& messages = unshownCarryFailures();
+    messages.append(i18n("%1 Until its 3D choice is made again in the 3D menu, the file is shown as its own marks say.", error));
+
+    if (messages.size() > 1)
+    {
+        return;     // already on its way to the screen
+    }
+
+    QTimer::singleShot(0, qApp, []()
+    {
+        const QStringList shown = unshownCarryFailures();
+        unshownCarryFailures().clear();
+        QMessageBox::warning(qApp->activeWindow(), i18n("3D"), shown.join(QLatin1Char('\n')));
+    });
+}
+
+} // namespace
+
+#endif
