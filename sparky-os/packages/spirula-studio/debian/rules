#!/usr/bin/make -f
export DH_VERBOSE=1
export DEB_BUILD_MAINT_OPTIONS=hardening=+all
include /usr/share/dpkg/buildflags.mk
COMMON=-G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_C_FLAGS=$(CFLAGS) $(CPPFLAGS)" "-DCMAKE_CXX_FLAGS=$(CXXFLAGS) $(CPPFLAGS)" "-DCMAKE_EXE_LINKER_FLAGS=$(LDFLAGS)" "-DCMAKE_SHARED_LINKER_FLAGS=$(LDFLAGS)" -DCMAKE_DISABLE_FIND_PACKAGE_Git=ON -DCMAKE_SKIP_RPATH=ON -DSS_BUILD_GUI=ON -DSS_BUILD_SAM=ON -DSS_BUILD_SFM=ON -DSS_SEPARATE_TOOLS=OFF -DSS_BUILD_BACKEND_TESTS=OFF -DSS_ENABLE_PATENTED=OFF -DSS_FONT_CJK=all -DSS_EDITION_PACKAGE=ON -DSS_STEREO_DEPTH_STUDY_VISIBLE=OFF -DSS_EDITION_DATA_DIR=$(CURDIR)/debian/edition -DSS_SLANGC=$(CURDIR)/slang/bin/slangc -DFETCHCONTENT_SOURCE_DIR_GLFW=$(CURDIR)/glfw -DFETCHCONTENT_SOURCE_DIR_IMGUI=$(CURDIR)/imgui
%:
	dh $@ --buildsystem=cmake --builddirectory=build_vulkan

override_dh_auto_configure:
	python3 debian/generate.py $(CURDIR)
	python3 debian/fetch-slang.py $(CURDIR)/slang
	mkdir -p build_vulkan/fonts build_cuda/fonts
	cp fonts/*.otf build_vulkan/fonts/
	cp fonts/*.otf build_cuda/fonts/
	cmake -S . -B build_vulkan $(COMMON) -DSS_BACKEND=vulkan
	CUDACXX=/opt/cuda/bin/nvcc cmake -S . -B build_cuda $(COMMON) -DSS_BACKEND=cuda -DCUDAToolkit_ROOT=/opt/cuda -DTORCH_CUDA_ARCH_LIST="7.5 8.6" -DCMAKE_CUDA_RUNTIME_LIBRARY=Shared -DSS_CUDA_EMBED_PTX=ON -DSS_CUDA_COMPILER_THREADS=1 "-DCMAKE_CUDA_FLAGS=$(foreach flag,$(filter-out -g,$(CXXFLAGS) $(CPPFLAGS)),-Xcompiler=$(flag))"

override_dh_auto_build:
	cmake --build build_vulkan --target spirula --parallel 4
	cmake --build build_cuda --target spirula --parallel 4

override_dh_auto_test:
	true

override_dh_auto_install:
	install -Dm755 build_vulkan/spirula debian/spirula-studio/usr/lib/spirula-studio/vulkan/spirula
	install -Dm755 build_cuda/spirula debian/spirula-studio-cuda/usr/lib/spirula-studio/cuda/spirula
	install -Dm755 debian/launch.py debian/spirula-studio/usr/bin/spirula-studio
	install -Dm644 debian/spirula-studio.desktop debian/spirula-studio/usr/share/applications/spirula-studio.desktop
	install -Dm644 assets/icon.png debian/spirula-studio/usr/share/icons/hicolor/1024x1024/apps/spirula-studio.png
	mkdir -p debian/spirula-studio/usr/lib/spirula-studio/fonts
	cp fonts/*.otf debian/spirula-studio/usr/lib/spirula-studio/fonts/
	ln -s ../fonts debian/spirula-studio/usr/lib/spirula-studio/vulkan/fonts
	ln -s ../fonts debian/spirula-studio-cuda/usr/lib/spirula-studio/cuda/fonts
	mkdir -p debian/spirula-studio/usr/share/sparky-install-models/profiles debian/spirula-studio/usr/share/sparky-install-models/licences
	cp debian/model-profiles/*.json debian/spirula-studio/usr/share/sparky-install-models/profiles/
	cp debian/licences/*.txt debian/spirula-studio/usr/share/sparky-install-models/licences/
	mkdir -p debian/spirula-studio/usr/share/doc/spirula-studio/licenses
	cp LICENSE debian/spirula-studio/usr/share/doc/spirula-studio/
	cp LICENSES/*.txt assets/fonts/OFL*.txt debian/notices/*.txt debian/spirula-studio/usr/share/doc/spirula-studio/licenses/
	cp glfw/LICENSE.md debian/spirula-studio/usr/share/doc/spirula-studio/licenses/GLFW.txt
	cp imgui/LICENSE.txt debian/spirula-studio/usr/share/doc/spirula-studio/licenses/ImGui.txt

override_dh_auto_clean:
	true
