+std::optional<QImage> ScreenShotManager::takeStereoScreenShotWorkspace(ScreenShotFlags flags, std::optional<pid_t> pidToHide)
+{
+    const auto outputs = workspace()->outputs();
+    if (outputs.isEmpty()) {
+        return std::nullopt;
+    }
+    Rect geometry = outputs.front()->geometry();
+    for (LogicalOutput *output : outputs | std::views::drop(1)) {
+        geometry = geometry.united(output->geometry());
+    }
+    const qreal scale = flags & ScreenShotNativeResolution
+        ? std::ranges::max(outputs, {}, &LogicalOutput::scale)->scale()
+        : 1.0;
+    const QSize eyeSize(qRound(geometry.width() * scale), qRound(geometry.height() * scale));
+    QImage result(QSize(eyeSize.width() * 2, eyeSize.height()), QImage::Format_ARGB32_Premultiplied);
+    result.fill(Qt::transparent);
+    QPainter painter(&result);
+    for (LogicalOutput *output : outputs) {
+        const auto image = takeScreenShot(output, flags, pidToHide);
+        if (!image) {
+            return std::nullopt;
+        }
+        const int sourceWidth = image->width() / (screenShotIsStereo(output) ? 2 : 1);
+        const QRectF leftSource(0, 0, sourceWidth, image->height());
+        const QRectF rightSource(output->hasStereoEyes() ? sourceWidth : 0, 0, sourceWidth, image->height());
+        const Rect section = output->geometry();
+        const QRect target(qRound((section.x() - geometry.x()) * scale), qRound((section.y() - geometry.y()) * scale),
+                           qRound(section.width() * scale), qRound(section.height() * scale));
+        painter.drawImage(target, *image, leftSource);
+        painter.drawImage(target.translated(eyeSize.width(), 0), *image, rightSource);
+    }
+    painter.end();
+    result.setDevicePixelRatio(scale);
+    return result;
+}
