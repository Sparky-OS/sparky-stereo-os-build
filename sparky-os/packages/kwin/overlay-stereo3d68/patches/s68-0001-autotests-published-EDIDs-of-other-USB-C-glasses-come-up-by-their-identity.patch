+    QTest::newRow("XREAL Air 2 Pro, Full SBS") << u"xreal-air-2-pro-full.hex"_s << u"3840x1080@60"_s << QByteArrayLiteral("MRG") << 0x3135 << QSize(3840, 1080) << true << true;
+    // 2D mode: known glasses, their option on, their 2D mode as it is
+    QTest::newRow("VITURE Pro XR, 2D") << u"viture-pro-xr-2d.hex"_s << u"1920x1080@60 1920x1080@120 1920x1080@90"_s << QByteArrayLiteral("CVT") << 0x3132 << QSize(1920, 1080) << false << true;
+    QTest::newRow("XREAL Air 2 Pro, 2D") << u"xreal-air-2-pro-2d.hex"_s << u"1920x1080@60 1920x1080@90 1920x1080@120"_s << QByteArrayLiteral("MRG") << 0x3135 << QSize(1920, 1080) << false << true;
+    // only their 2D EDID is in a public record: known by identity, and in 2D their 2D mode stays
+    QTest::newRow("XREAL Air, 2D") << u"xreal-air-2d.hex"_s << u"1920x1080@90 1920x1080@60 1920x1080@120"_s << QByteArrayLiteral("MRG") << 0x3132 << QSize(1920, 1080) << false << true;
+    QTest::newRow("Nreal Light, 2D") << u"nreal-light-2d.hex"_s << u"1920x1080@60"_s << QByteArrayLiteral("MRG") << 0x3131 << QSize(1920, 1080) << false << true;
+    QTest::newRow("VITURE Beast, 2D") << u"viture-beast-2d.hex"_s << u"1920x1080@60"_s << QByteArrayLiteral("VIT") << 0x0120 << QSize(1920, 1080) << false << true;
+    QTest::newRow("Rokid Air, 2D") << u"rokid-air-2d.hex"_s << u"1920x1080@60"_s << QByteArrayLiteral("LBT") << 0x4752 << QSize(1920, 1080) << false << true;
+    QTest::newRow("Rokid Max, 2D") << u"rokid-max-2d-1200.hex"_s << u"1920x1080@60 1920x1080@120 1920x1200@60 1920x1200@120"_s << QByteArrayLiteral("LBT") << 0x4753 << QSize(1920, 1080) << false << true;
+    QTest::newRow("TCL SmartGlasses 0x03D4, 2D") << u"tcl-smartglasses-03d4-2d.hex"_s << u"1920x1080@60"_s << QByteArrayLiteral("TCL") << 0x03D4 << QSize(1920, 1080) << false << true;
+    QTest::newRow("TCL SmartGlasses 0x03D5, 2D") << u"tcl-smartglasses-03d5-2d.hex"_s << u"1920x1080@120 1920x1080@60"_s << QByteArrayLiteral("TCL") << 0x03D5 << QSize(1920, 1080) << false << true;
+    // controls: a 32:9 monitor of the glasses' size, and an ordinary monitor with XREAL's own PnP ID
+    QTest::newRow("AOC AG493UG7R4, control") << u"control-aoc-ag493ug7r4.hex"_s << u"3840x1080@60 3840x1080@120 1920x1080@60 2560x1440@120 2560x1440@60"_s << QByteArrayLiteral("AOC") << 0x4930 << QSize(3840, 1080) << false << false;
+    QTest::newRow("MRG MGME2430, control") << u"control-mrg-mgme2430.hex"_s << u"1920x1080@60 1920x1080@75 1280x720@60 1360x768@60"_s << QByteArrayLiteral("MRG") << 0x2411 << QSize(1920, 1080) << false << false;
+}
+
+void MockGlassesTest::publishedEdidsComeUpByIdentity()
+{
+    QFETCH(QString, edid);
+    QFETCH(QString, modes);
+    QFETCH(QByteArray, pnpId);
+    QFETCH(int, product);
+    QFETCH(QSize, size);
+    QFETCH(bool, twin);
+    QFETCH(bool, glasses);
+
+    const QByteArray bytes = readHexEdid(edid);
+    QVERIFY(!bytes.isEmpty());
+    Rig rig(bytes, parseModes(modes));
+    QVERIFY(rig.mockGpu);
+    QVERIFY(rig.gpu->updateOutputs());
+    const auto outputs = rig.outputs();
+    QCOMPARE(outputs.size(), 1);
+    QCOMPARE(outputs[0]->edid().eisaId(), pnpId);
+    QCOMPARE(int(outputs[0]->edid().productCode()), product);
+
+    OutputConfigurationStore store;
+    const auto cfg = store.queryConfig(outputs, false, AccelerometerOrientation::Undefined, false);
+    QVERIFY(cfg);
+    const auto changes = cfg->first.constChangeSet(outputs[0]);
+    QVERIFY(changes->currentMode);
+    QCOMPARE(changes->currentMode->size(), size);
+    QCOMPARE(stereoFlags(*changes->currentMode), twin ? Flag::VirtualStereo | Flag::Stereo3DSideBySideFull : OutputModeline::Flags());
+    QCOMPARE(changes->stereoGlasses.value_or(false), glasses);
+    if (twin) {
+        QCOMPARE(outputs[0]->viewSizeForMode(*changes->currentMode), QSize(size.width() / 2, size.height()));
+        QVERIFY(changes->otherStereoFormats.value_or(false));
+    }
+}
+
+void MockGlassesTest::publishedGlassesFollowTheirModes_data()
+{
+    QTest::addColumn<QString>("flat");
+    QTest::addColumn<QString>("flatModes");
+    QTest::addColumn<QString>("full");
+
+    QTest::newRow("VITURE Pro XR") << u"viture-pro-xr-2d.hex"_s << u"1920x1080@60 1920x1080@120 1920x1080@90"_s << u"viture-pro-xr-full.hex"_s;
+    QTest::newRow("XREAL Air 2 Pro") << u"xreal-air-2-pro-2d.hex"_s << u"1920x1080@60 1920x1080@90 1920x1080@120"_s << u"xreal-air-2-pro-full.hex"_s;
+}
+
+void MockGlassesTest::publishedGlassesFollowTheirModes()
+{
+    // the glasses switch from 2D to Full SBS and back with the cable in: the same output takes each EDID
+    QFETCH(QString, flat);
+    QFETCH(QString, flatModes);
+    QFETCH(QString, full);
+
+    Rig rig(readHexEdid(flat), parseModes(flatModes));
+    QVERIFY(rig.mockGpu);
+    QVERIFY(rig.gpu->updateOutputs());
+    const auto outputs = rig.outputs();
+    QCOMPARE(outputs.size(), 1);
+    const auto step = [&outputs](const QSize &size, OutputModeline::Flags flags) {
+        OutputConfigurationStore store;
+        const auto cfg = store.queryConfig(outputs, false, AccelerometerOrientation::Undefined, false);
+        QVERIFY(cfg);
+        const auto changes = cfg->first.constChangeSet(outputs[0]);
+        QVERIFY(changes->currentMode);
+        QCOMPARE(changes->currentMode->size(), size);
+        QCOMPARE(stereoFlags(*changes->currentMode), flags);
+        outputs[0]->applyChanges(cfg->first);
+        store.storeConfig(outputs, false);
+    };
+    step(QSize(1920, 1080), OutputModeline::Flags());
+    if (QTest::currentTestFailed()) {
+        return;
+    }
+
+    rig.announce(readHexEdid(full), s_sideBySideModes);
+    QVERIFY(rig.gpu->updateOutputs());
+    QCOMPARE(rig.outputs(), outputs);
+    step(QSize(3840, 1080), Flag::VirtualStereo | Flag::Stereo3DSideBySideFull);
+    if (QTest::currentTestFailed()) {
+        return;
+    }
+
+    rig.announce(readHexEdid(flat), parseModes(flatModes));
+    QVERIFY(rig.gpu->updateOutputs());
+    QCOMPARE(rig.outputs(), outputs);
+    step(QSize(1920, 1080), OutputModeline::Flags());
+}
+
 QTEST_GUILESS_MAIN(MockGlassesTest)
 #include "mockGlassesTest.moc"
