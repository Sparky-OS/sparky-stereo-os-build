--- a/autotests/drm/mockGlassesTest.cpp
+++ b/autotests/drm/mockGlassesTest.cpp
@@ -8,6 +8,9 @@
 // the same identity in every mode. 2D lists 1920x1080 at 90 (preferred), 60 and 120 Hz; the half side by side
 // mode announces the same bytes as 2D; full side by side one 3840x1080 at 60 Hz; the glasses' own Real 3D
 // (a 2D to 3D conversion inside them) one 1920x1080 at 60 Hz, which is 2D to the computer.
+// Other glasses are tested on their published EDIDs (autotests/integration/data/*.hex, sources in
+// usb-c-glasses-edids.txt): the VITURE Pro XR and the XREAL Air 2 Pro keep their identity in Full SBS, one 3840x1080
+// at 60 Hz; for the others only the 2D EDID is published, so they are known by identity and stay in their 2D mode.
 
 #include "mock_drm.h"
 
@@ -35,6 +38,7 @@
 #include <fcntl.h>
 
 using namespace KWin;
+using namespace Qt::StringLiterals;
 using Flag = OutputModeline::Flag;
 
 static std::unique_ptr<MockGpu> findRenderDevice(int crtcCount)
@@ -70,6 +74,17 @@ static QByteArray readEdid(const QString &name)
     return file.readAll();
 }
 
+// the published EDIDs of other glasses, as rows of hex (edid-decode's form); their sources are listed in
+// autotests/integration/data/usb-c-glasses-edids.txt
+static QByteArray readHexEdid(const QString &name)
+{
+    QFile file(QFINDTESTDATA("../integration/data/" + name));
+    if (!file.open(QIODevice::ReadOnly)) {
+        return QByteArray();
+    }
+    return QByteArray::fromHex(file.readAll());
+}
+
 static void setEdid(MockGpu *gpu, MockConnector *connector, const QByteArray &edid)
 {
     auto blob = std::make_unique<MockPropertyBlob>(gpu, edid.constData(), edid.size());
@@ -207,6 +222,10 @@ private Q_SLOTS:
     void followsTheGlassesAcrossAReconnect();
     void realDStaysFlat();
     void halfAnnouncesNothing();
+    void publishedEdidsComeUpByIdentity_data();
+    void publishedEdidsComeUpByIdentity();
+    void publishedGlassesFollowTheirModes_data();
+    void publishedGlassesFollowTheirModes();
 };
 
 void MockGlassesTest::initTestCase()
@@ -484,5 +503,132 @@ void MockGlassesTest::halfAnnouncesNothing()
     QCOMPARE(stereoFlags(*changes->currentMode), OutputModeline::Flags());
 }
 
+// "1920x1080@60 1920x1080@120": the detailed timings of an EDID in its order, the first one preferred
+static QList<ModeSpec> parseModes(const QString &text)
+{
+    QList<ModeSpec> modes;
+    for (const QString &mode : text.split(QLatin1Char(' '), Qt::SkipEmptyParts)) {
+        const QStringList sizeAndRate = mode.split(QLatin1Char('@'));
+        const QStringList size = sizeAndRate[0].split(QLatin1Char('x'));
+        modes.append({size[0].toInt(), size[1].toInt(), sizeAndRate[1].toFloat()});
+    }
+    return modes;
+}
+
