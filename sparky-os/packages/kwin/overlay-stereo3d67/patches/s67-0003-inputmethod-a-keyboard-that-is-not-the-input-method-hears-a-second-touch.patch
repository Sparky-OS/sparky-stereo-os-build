+void InputMethod::requestShow()
+{
+    Q_EMIT showRequested();
+    show();
+}
+
+void InputMethod::setOnScreenKeyboardShown(qint64 pid, bool shown, const QString &owner)
+{
+    if (shown) {
+        m_onScreenKeyboardPid = pid;
+        m_onScreenKeyboardOwner = owner;
+        m_onScreenKeyboardWatcher->setWatchedServices(owner.isEmpty() ? QStringList() : QStringList{owner});
+        // the window may be mapped after the keyboard said it is shown
+        connect(workspace(), &Workspace::windowAdded, this, &InputMethod::refreshOnScreenKeyboardWindow, Qt::UniqueConnection);
+    } else if (pid == m_onScreenKeyboardPid) {
+        m_onScreenKeyboardPid = 0;
+        m_onScreenKeyboardOwner.clear();
+        m_onScreenKeyboardWatcher->setWatchedServices({});
+        disconnect(workspace(), &Workspace::windowAdded, this, &InputMethod::refreshOnScreenKeyboardWindow);
+    } else {
+        // another program's keyboard saying it is hidden does not hide this one
+        return;
+    }
+    refreshOnScreenKeyboardWindow();
+}
+
+void InputMethod::refreshOnScreenKeyboardWindow()
+{
+    Window *found = nullptr;
+    if (m_onScreenKeyboardPid) {
+        const auto windows = workspace()->windows();
+        for (Window *window : windows) {
+            if (qobject_cast<LayerShellV1Window *>(window) && window->pid() == m_onScreenKeyboardPid && !window->isDeleted() && window->isShown()) {
+                found = window;
+                break;
+            }
+        }
+    }
+    if (found != m_onScreenKeyboardWindow) {
+        if (m_onScreenKeyboardWindow) {
+            disconnect(m_onScreenKeyboardWindow, nullptr, this, nullptr);
+        }
+        m_onScreenKeyboardWindow = found;
+        if (found) {
+            connect(found, &Window::frameGeometryChanged, this, &InputMethod::updateInputPanelState);
+            connect(found, &Window::hiddenChanged, this, &InputMethod::refreshOnScreenKeyboardWindow);
+            connect(found, &Window::closed, this, &InputMethod::refreshOnScreenKeyboardWindow, Qt::QueuedConnection);
+        }
+    }
+    updateInputPanelState();
+}
