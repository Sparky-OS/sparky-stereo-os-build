+void VirtualKeyboardDBus::setOnScreenKeyboardShown(bool shown)
+{
+    if (!calledFromDBus()) {
+        return;
+    }
+    // the keyboard's window is found by the process that says it is shown: no coordinates are taken from the caller
+    const QString caller = message().service();
+    const QDBusReply<uint> pid = connection().interface()->servicePid(caller);
+    if (!pid.isValid() || pid.value() == 0) {
+        sendErrorReply(QDBusError::AccessDenied, QStringLiteral("The process of %1 is not known: its on-screen keyboard cannot be kept clear of").arg(caller));
+        return;
+    }
+    m_inputMethod->setOnScreenKeyboardShown(pid.value(), shown, caller);
+}
+
