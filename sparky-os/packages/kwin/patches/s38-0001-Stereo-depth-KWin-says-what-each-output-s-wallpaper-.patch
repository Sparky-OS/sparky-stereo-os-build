+/**
+ * The columns each output's wallpaper loses to the sunk effect, exported on the D-Bus as
+ * /org/kde/KWin/StereoDepth, so the pages that set a wallpaper can state the cost with KWin's own
+ * numbers rather than a formula of their own.
+ */
+using DBusWallpaperCuts = QMap<QString, int>;
+
+class StereoDepthDBusInterface : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.KWin.StereoDepth")
+
+    /**
+     * For each output, by its name, how many columns are cut from each side of its wallpaper with
+     * the Background depth the user set: none on an output that is not in a 3D mode.
+     */
+    Q_PROPERTY(KWin::DBusWallpaperCuts WallpaperCuts READ wallpaperCuts)
+
+public:
+    explicit StereoDepthDBusInterface(Workspace *parent);
+
+    DBusWallpaperCuts wallpaperCuts() const;
+
+public Q_SLOTS:
+    /**
+     * The same for a Background depth of @a backgroundDepth, in pixels of a screen 1920 wide, that
+     * is not applied yet, such as the one a settings page's slider shows.
+     */
+    KWin::DBusWallpaperCuts WallpaperCutsAt(double backgroundDepth) const;
+
+Q_SIGNALS:
+    /**
+     * An output was added or removed, or its size, scale or mode changed, so WallpaperCutsAt may
+     * answer differently.
+     */
+    void OutputsChanged();
+
+private:
+    void watchOutput(LogicalOutput *output);
+    void outputsChanged();
+    void update();
+
+    DBusWallpaperCuts m_wallpaperCuts;
+};
+
 } // namespace
diff --git a/src/org.kde.KWin.StereoDepth.xml b/src/org.kde.KWin.StereoDepth.xml
new file mode 100644
index 0000000..2680af4
--- /dev/null
+++ b/src/org.kde.KWin.StereoDepth.xml
@@ -0,0 +1,32 @@
+<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<node>
+    <interface name="org.kde.KWin.StereoDepth">
+        <!--
+            For each output, by its name, how many columns are cut from each side of its wallpaper.
+            A wallpaper lies behind the screen at the Background depth and keeps its size, so the
+            columns only one eye would see are cut from both sides, the same columns in both eyes.
+            The number comes from the Background depth the user set and the output's own width; it
+            is 0 on an output that is not in a 3D mode and with no Background depth.
+            org.freedesktop.DBus.Properties.PropertiesChanged announces each change.
+        -->
+        <property name="WallpaperCuts" type="a{si}" access="read">
+            <annotation name="org.qtproject.QtDBus.QtTypeName" value="KWin::DBusWallpaperCuts"/>
+        </property>
+
+        <!--
+            The same for a Background depth of @a backgroundDepth, in pixels of a screen 1920 wide,
+            that is not applied yet, such as the one a settings page's slider shows.
+        -->
+        <method name="WallpaperCutsAt">
+            <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="KWin::DBusWallpaperCuts"/>
+            <arg type="a{si}" direction="out"/>
+            <arg name="backgroundDepth" type="d" direction="in"/>
+        </method>
+
+        <!--
+            An output was added or removed, or its size, scale or mode changed, so WallpaperCutsAt
+            may answer differently.
+        -->
+        <signal name="OutputsChanged"/>
+    </interface>
+</node>
diff --git a/src/scene/stereodepth.cpp b/src/scene/stereodepth.cpp
index aa0d025..1b2a4aa 100644
--- a/src/scene/stereodepth.cpp
+++ b/src/scene/stereodepth.cpp
@@ -365,6 +365,16 @@ int StereoDepth::wallpaperCut(int parallax)
     return (std::abs(parallax) + 1) / 2;
 }
 
+int StereoDepth::wallpaperCut(const LogicalOutput *output, qreal sunkLimit)
+{
+    if (!output->hasStereoEyes() || sunkLimit <= 0) {
+        return 0;
+    }
+    // the width of the output's view in device pixels, as the compositor sizes the view
+    const Rect view = output->geometryF().scaled(output->scale()).rounded();
+    return wallpaperCut(parallax(-sunkLimit, view.width()));
+}
