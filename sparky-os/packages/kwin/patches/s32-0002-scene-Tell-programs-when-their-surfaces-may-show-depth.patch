+void StereoDepthV1::kde_stereo_depth_v1_depth_state(uint32_t awake, uint32_t output_edges)
+{
+    this->awake = awake != 0;
+    outputEdges = output_edges;
+    states++;
+    Q_EMIT stateReceived();
+}
