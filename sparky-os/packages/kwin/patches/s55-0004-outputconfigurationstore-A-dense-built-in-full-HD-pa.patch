From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 14 Nov 2026 21:06:25 -0300
Subject: [PATCH] outputconfigurationstore: A dense built-in full HD panel
 starts at 125 % at least

A built-in panel of full HD or more that is at least as dense as a 14 inch
full HD one (150 dpi, which is full HD at 14.7 inches) never gets a first
scale below 125 %. The formula gives a 14.6 inch full HD notebook 120 %, and
a 14.5 inch tablet without a lid switch 100 %: text a person may not be able
to read, and a person who cannot read the screen cannot reach the setting
that changes it.

Only the first scale of a built-in panel changes. A saved scale is kept, and
monitors and televisions keep the formula's result.

Assisted-by: Claude:claude-fable-5-2
---
 autotests/integration/outputchanges_test.cpp | 55 ++++++++++++++++++++
 src/outputconfigurationstore.cpp             |  8 +++
 2 files changed, 63 insertions(+)

diff --git a/autotests/integration/outputchanges_test.cpp b/autotests/integration/outputchanges_test.cpp
index 15f94c6..bb5a116 100644
--- a/autotests/integration/outputchanges_test.cpp
+++ b/autotests/integration/outputchanges_test.cpp
@@ -1575,6 +1575,61 @@ void OutputChangesTest::testGenerateConfigs_data()
            }
         << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.3 << true;
 
+    // 150.9 dpi: the formula alone gives 120 %
+    QTest::addRow("14.6\" full HD notebook")
+        << DeviceType::Laptop
+        << Test::OutputInfo{
+               .geometry = Rect(0, 0, 1920, 1080),
+               .internal = true,
+               .physicalSizeInMM = QSize(323, 182),
+               .modes = {OutputModeline(QSize(1920, 1080), 60000, OutputModeline::Flag::Preferred)},
+           }
+        << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.25 << true;
+
+    // 152 dpi and no lid switch: the formula alone gives 100 %
+    QTest::addRow("14.5\" full HD tablet")
+        << DeviceType::Handheld
+        << Test::OutputInfo{
+               .geometry = Rect(0, 0, 1920, 1080),
+               .internal = true,
+               .physicalSizeInMM = QSize(321, 181),
+               .modes = {OutputModeline(QSize(1920, 1080), 60000, OutputModeline::Flag::Preferred)},
+           }
+        << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.25 << true;
+
+    // 141 dpi: below the floor's density, as before
+    QTest::addRow("15.6\" full HD notebook")
+        << DeviceType::Laptop
+        << Test::OutputInfo{
+               .geometry = Rect(0, 0, 1920, 1080),
+               .internal = true,
+               .physicalSizeInMM = QSize(344, 193),
+               .modes = {OutputModeline(QSize(1920, 1080), 60000, OutputModeline::Flag::Preferred)},
+           }
+        << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.0 << true;
+
+    // the floor is for built-in panels: a monitor of the same density keeps the formula's result (157 %, held to 135 % by
+    // the 800 logical pixels a monitor keeps)
+    QTest::addRow("14.6\" full HD portable monitor")
+        << DeviceType::Desktop
+        << Test::OutputInfo{
+               .geometry = Rect(0, 0, 1920, 1080),
+               .internal = false,
+               .physicalSizeInMM = QSize(323, 182),
+               .modes = {OutputModeline(QSize(1920, 1080), 60000, OutputModeline::Flag::Preferred)},
+           }
+        << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.35 << true;
+
+    QTest::addRow("24\" full HD monitor")
+        << DeviceType::Desktop
+        << Test::OutputInfo{
+               .geometry = Rect(0, 0, 1920, 1080),
+               .internal = false,
+               .physicalSizeInMM = QSize(531, 299),
+               .modes = {OutputModeline(QSize(1920, 1080), 60000, OutputModeline::Flag::Preferred)},
+           }
+        << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.0 << true;
+
     QTest::addRow("Legion Go S")
         << DeviceType::Handheld
         << Test::OutputInfo{
diff --git a/src/outputconfigurationstore.cpp b/src/outputconfigurationstore.cpp
index ef633d7..e9dd32b 100644
--- a/src/outputconfigurationstore.cpp
+++ b/src/outputconfigurationstore.cpp
@@ -971,6 +971,14 @@ double OutputConfigurationStore::chooseScale(BackendOutput *output, const QSize
         }
     }
 
+    // A built-in panel of full HD or more that is at least as dense as a 14 inch full HD
+    // one (150 dpi is full HD at 14.7 inches) is hard to read at 100 %, and a person who
+    // cannot read the screen cannot reach the setting that changes it: never below 125 %.
+    const bool fullHdOrMore = std::max(modeSize.width(), modeSize.height()) >= 1920 && std::min(modeSize.width(), modeSize.height()) >= 1080;
+    if (output->isInternal() && fullHdOrMore && std::min(dpiX, dpiY) >= 150) {
+        scale = std::max(scale, 1.25);
+    }
+
     return scale;
 }
 
