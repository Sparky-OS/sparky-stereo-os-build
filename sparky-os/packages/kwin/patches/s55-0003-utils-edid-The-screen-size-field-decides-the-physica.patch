+        "920058c11000001e023a8058713830422c06920058c11000001e000000fd0026"
+        "3e40430f010a202020202020000000fc005656593133463030314731300a0010"
+    );
+}
+
 void OutputChangesTest::testGenerateConfigs_data()
 {
     QTest::addColumn<DeviceType>("deviceType");
@@ -1543,6 +1555,26 @@ void OutputChangesTest::testGenerateConfigs_data()
            }
         << OutputModeline(QSize(800, 1280), 90000ul, OutputModeline::Flag::Preferred) << 1.0 << true;
 
+    QTest::addRow("13.3\" full HD convertible, two sizes in the EDID")
+        << DeviceType::Handheld
+        << Test::OutputInfo{
+               .geometry = Rect(0, 0, 1920, 1080),
+               .internal = true,
+               .modes = {OutputModeline(QSize(1920, 1080), 60000, OutputModeline::Flag::Preferred)},
+               .edid = denseNotebookPanelEdid(),
+           }
+        << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.25 << true;
+
+    QTest::addRow("13.3\" full HD notebook with a lid, two sizes in the EDID")
+        << DeviceType::Laptop
+        << Test::OutputInfo{
+               .geometry = Rect(0, 0, 1920, 1080),
+               .internal = true,
+               .modes = {OutputModeline(QSize(1920, 1080), 60000, OutputModeline::Flag::Preferred)},
+               .edid = denseNotebookPanelEdid(),
+           }
+        << OutputModeline(QSize(1920, 1080), 60000ul, OutputModeline::Flag::Preferred) << 1.3 << true;
+
     QTest::addRow("Legion Go S")
         << DeviceType::Handheld
         << Test::OutputInfo{
diff --git a/src/backends/virtual/virtual_output.cpp b/src/backends/virtual/virtual_output.cpp
index d5917d2..ada3d87 100644
--- a/src/backends/virtual/virtual_output.cpp
+++ b/src/backends/virtual/virtual_output.cpp
@@ -29,10 +29,12 @@ VirtualOutput::VirtualOutput(VirtualBackend *parent, bool internal, const QSize
 
     static int identifier = -1;
     m_identifier = ++identifier;
+    // like a connector, an output that is given an EDID and no size has the EDID's size
+    const Edid parsedEdid{edid, edidIdentifierOverride};
     setInformation(Information{
         .name = connectorName.value_or(QStringLiteral("Virtual-%1").arg(identifier)),
-        .physicalSize = physicalSizeInMM,
-        .edid = Edid{edid, edidIdentifierOverride},
+        .physicalSize = physicalSizeInMM.isEmpty() && parsedEdid.isValid() ? parsedEdid.physicalSize() : physicalSizeInMM,
+        .edid = parsedEdid,
