Description: drm: Let go of the eyes held for replicas when the swapchains are replaced
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: https://invent.kde.org/danielcamposramos/kwin/-/commit/af67a70540df032eeb7720c46b678522dd34632a
Forwarded: no
Last-Update: 2026-10-23
Assisted-by: Claude Sonnet 5.5
---
 src/backends/drm/drm_egl_layer_surface.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/backends/drm/drm_egl_layer_surface.cpp b/src/backends/drm/drm_egl_layer_surface.cpp
index f33c07a934..869bd2faf0 100644
--- a/src/backends/drm/drm_egl_layer_surface.cpp
+++ b/src/backends/drm/drm_egl_layer_surface.cpp
@@ -801,6 +801,7 @@ bool EglGbmLayerSurface::checkSurface(const QSize &size, const FormatModifierMap
     }
     if (doesSurfaceFit(m_oldSurface.get(), size, formats, tradeoff, requiredAlphaBits)) {
         m_surface = std::move(m_oldSurface);
+        m_composedEyes.reset();
         return true;
     }
     if (m_gpu != m_eglBackend->gpu() && m_gpu->renderDevice() && m_gpu->renderDevice()->isInReset()) {
@@ -822,6 +823,8 @@ bool EglGbmLayerSurface::checkSurface(const QSize &size, const FormatModifierMap
             }
         }
         m_surface = std::move(newSurface);
+        // the eyes held for replicas belong to the swapchains that were just replaced
+        m_composedEyes.reset();
         return true;
     }
     return false;
