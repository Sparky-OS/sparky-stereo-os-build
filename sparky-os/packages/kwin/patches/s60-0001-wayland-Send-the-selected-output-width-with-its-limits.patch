 {
     if (!m_surface) {
         return;
@@ -179,8 +179,15 @@
         send_depth_state(awake ? 1 : 0, outputEdges);
     }
     const auto limits = std::make_pair(sunk, popped);
-    if (resource()->version() >= KDE_STEREO_DEPTH_V1_DEPTH_LIMITS_SINCE_VERSION && m_sentLimits != limits) {
+    const auto output = std::make_pair(outputWidth, outputId);
+    const bool hasOutputWidth = resource()->version() >= KDE_STEREO_DEPTH_V1_OUTPUT_WIDTH_SINCE_VERSION;
+    if (resource()->version() >= KDE_STEREO_DEPTH_V1_DEPTH_LIMITS_SINCE_VERSION
+        && (m_sentLimits != limits || (hasOutputWidth && m_sentOutput != output))) {
         m_sentLimits = limits;
+        m_sentOutput = output;
+        if (hasOutputWidth) {
