     /**
      * Returns the current release point for the buffer on this surface. The buffer keeps the
--- a/src/wayland/surface.cpp
+++ b/src/wayland/surface.cpp
@@ -1374,12 +1374,12 @@
     return !d->stereoDepths.isEmpty();
 }
 
-void SurfaceInterface::setStereoDepthState(bool awake, Qt::Edges outputEdges, qreal sunk, qreal popped)
-{
-    const SurfaceInterfacePrivate::StereoDepthState state{awake, uint32_t(outputEdges.toInt()), sunk, popped};
+void SurfaceInterface::setStereoDepthState(bool awake, Qt::Edges outputEdges, qreal sunk, qreal popped, uint32_t outputWidth, const QUuid &outputId)
+{
+    const SurfaceInterfacePrivate::StereoDepthState state{awake, uint32_t(outputEdges.toInt()), sunk, popped, outputWidth, outputId};
     d->stereoDepthState = state;
     for (StereoDepthSurfaceV1 *depth : std::as_const(d->stereoDepths)) {
-        depth->sendState(state.awake, state.outputEdges, state.sunk, state.popped);
+        depth->sendState(state.awake, state.outputEdges, state.sunk, state.popped, state.outputWidth, state.outputId);
     }
 }
 
