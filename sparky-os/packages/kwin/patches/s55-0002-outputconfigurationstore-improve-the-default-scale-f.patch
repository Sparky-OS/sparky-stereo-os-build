+++ b/src/outputconfigurationstore.cpp
@@ -922,6 +922,10 @@ double OutputConfigurationStore::chooseScale(BackendOutput *output, const QSize
             // laptop screens: usually closer to the face than desktop monitors
             targetDpi = 125;
             minSize = 800;
