     , kde_net_wm_stereo_content_supported(QByteArrayLiteral("_KDE_NET_WM_STEREO_CONTENT_SUPPORTED"))
+    , kde_net_wm_stereo_depth_limits(QByteArrayLiteral("_KDE_NET_WM_STEREO_DEPTH_LIMITS"))
     , utf8_string(QByteArrayLiteral("UTF8_STRING"))
