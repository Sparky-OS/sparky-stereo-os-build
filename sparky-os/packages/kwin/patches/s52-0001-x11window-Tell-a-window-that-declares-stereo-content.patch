@@ -61,6 +61,7 @@ Atoms::Atoms()
     , kde_net_wm_stereo_content_one_view_commit(QByteArrayLiteral("_KDE_NET_WM_STEREO_CONTENT_ONE_VIEW_COMMIT"))
