 src/atoms.cpp                   |  1 +
 src/atoms.h                     |  1 +
 src/netinfo.cpp                 |  5 ++++-
 src/scene/stereodepthstates.cpp |  7 +++++++
 src/x11window.cpp               | 31 +++++++++++++++++++++++++++++++
