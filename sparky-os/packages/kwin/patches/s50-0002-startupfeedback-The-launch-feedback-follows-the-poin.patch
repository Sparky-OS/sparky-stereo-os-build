     const QPixmap iconPixmap = startup.icon.pixmap(QSize(iconSize, iconSize), output->scale());
     prepareTextures(iconPixmap);
-    m_dirtyRect = m_currentGeometry = feedbackRect();
+    m_currentGeometry = feedbackRect();
