From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sun, 8 Nov 2026 04:36:28 -0300
Subject: [PATCH 5/8] workspace: Start on the screen marked main in Display
 Settings

The first active output was m_outputs[0], the order the backend lists the
outputs in, and the pointer started on the output holding the workspace
centre, so a session started with its prompts and new windows on an output
that was not the person's main screen until the mouse moved. Workspace::
firstOutput() is the screen marked main in Display Settings (priority 1, set
through kde_output_management_v2 set_priority), the front of the output order;
the active output starts there, comes back to it when the active output goes
away, and the pointer starts on its centre (Daniel, 2026-11-08). With no
output marked, the front of the order is used, as before. KWin master and
Plasma/6.7 still use m_outputs[0] there.

Assisted-by: Claude Sonnet 5.5 via Claude Code
---
 src/pointer_input.cpp |  5 +++--
 src/workspace.cpp     | 18 ++++++++++++++----
 src/workspace.h       |  6 ++++++
 3 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/src/pointer_input.cpp b/src/pointer_input.cpp
index ccd2a644e7..a95d5731f0 100644
--- a/src/pointer_input.cpp
+++ b/src/pointer_input.cpp
@@ -150,8 +150,9 @@ void PointerInputRedirection::init()
     std::for_each(clients.begin(), clients.end(), setupMoveResizeConnection);
     connect(workspace(), &Workspace::windowAdded, this, setupMoveResizeConnection);
 
-    // warp the cursor to center of screen containing the workspace center
-    if (const LogicalOutput *output = workspace()->outputAt(workspace()->geometry().center())) {
+    // warp the cursor to the center of the first output in the person's order, the one the active output starts on, so that the
+    // first move of the mouse does not take the focus to another screen
+    if (const LogicalOutput *output = workspace()->firstOutput()) {
         warp(output->geometry().center());
     }
     updateAfterScreenChange();
diff --git a/src/workspace.cpp b/src/workspace.cpp
index 60f9f08f11..875623c549 100644
--- a/src/workspace.cpp
+++ b/src/workspace.cpp
@@ -1504,12 +1504,14 @@ void Workspace::updateOutputs()
         }
     }
 
+    // the screen marked main in Display Settings (the front of the order of priorities) is the first active output, not the
+    // first the backend lists
+    updateOutputOrder();
+
     if (!m_activeOutput) {
-        setActiveOutput(m_outputs[0]);
+        setActiveOutput(firstOutput());
     }
 
-    updateOutputOrder();
-
     const QSet<LogicalOutput *> oldOutputsSet(oldLogicalOutputs.constBegin(), oldLogicalOutputs.constEnd());
     const QSet<LogicalOutput *> outputsSet(m_outputs.constBegin(), m_outputs.constEnd());
 
@@ -2430,7 +2432,7 @@ void Workspace::desktopResized(const QHash<Window *, LogicalOutput *> &oldOutput
     rearrange(oldOutputs);
 
     if (!m_outputs.contains(m_activeOutput)) {
-        setActiveOutput(m_outputs[0]);
+        setActiveOutput(firstOutput());
     }
 
     const auto stack = stackingOrder();
@@ -2741,6 +2743,14 @@ QList<LogicalOutput *> Workspace::outputOrder() const
     return m_outputOrder;
 }
 
+LogicalOutput *Workspace::firstOutput() const
+{
+    if (!m_outputOrder.isEmpty()) {
+        return m_outputOrder.front();
+    }
+    return m_outputs.isEmpty() ? nullptr : m_outputs[0];
+}
+
 LogicalOutput *Workspace::activeOutput() const
 {
     if (m_activeOutput && !isOutputInteractive(m_activeOutput)) {
diff --git a/src/workspace.h b/src/workspace.h
index 28c5bdfedd..b5166b6b6b 100644
--- a/src/workspace.h
+++ b/src/workspace.h
@@ -159,6 +159,12 @@ public:
     LogicalOutput *xineramaIndexToOutput(int index) const;
 
     QList<LogicalOutput *> outputOrder() const;
+    /**
+     * The screen marked main in Display Settings (priority 1, set through kde_output_management_v2 set_priority): the front of the
+     * output order, or the first the backend lists while there is no order yet. The active output starts here, comes back here
+     * when the active output is removed, and the pointer starts on its centre.
+     */
+    LogicalOutput *firstOutput() const;
 
     LogicalOutput *activeOutput() const;
     bool isOutputInteractive(const LogicalOutput *output) const;
