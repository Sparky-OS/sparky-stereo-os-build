+// Since version 7 a surface that follows its depth is told the person's element limit, the step of depth inside a
+// window, as the person set it, before output_width and depth_limits; again when it changes, and 0 lays the elements flat.
+void StereoDepthExchangeTest::testElementLimit()
+{
+    auto window = createWindow(QPointF(100, 100));
+    QVERIFY(window->window);
+    auto depth = follow(window->surface.get());
+    QVERIFY(waitFor(depth.get(), [&depth]() {
+        return depth->limits > 0;
+    }));
+    QCOMPARE(depth->elementLimits, 1);
+    QCOMPARE(depth->elementLimit, 1.0);
+    QCOMPARE(depth->order, QByteArrayLiteral("ewl"));
+
+    // the person sets another element limit: it is sent again, and the group ends with depth_limits
+    options->setStereoElementLimit(3);
+    QVERIFY(waitFor(depth.get(), [&depth]() {
+        return depth->elementLimits > 1;
+    }));
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(depth->elementLimit, 3.0);
+    QCOMPARE(depth->order, QByteArrayLiteral("ewl"));
+    QCOMPARE(depth->sunk, 10.0);
+    QCOMPARE(depth->popped, 4.0);
+
+    // no display factor is applied to it: the sunk and popped limits are unchanged and so is the element limit
+    // whatever the limits of the desktop's own surfaces are
+    options->setStereoSunkLimit(20);
+    QVERIFY(waitFor(depth.get(), [&depth]() {
+        return depth->sunk == 20.0;
+    }));
+    QCOMPARE(depth->elementLimit, 3.0);
+
+    // zero lays the elements flat, and is said
+    options->setStereoElementLimit(0);
+    QVERIFY(waitFor(depth.get(), [&depth]() {
+        return depth->elementLimit == 0.0;
+    }));
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(depth->order, QByteArrayLiteral("ewl"));
+}
+
 void StereoDepthExchangeTest::testResourceVersion_data()
 {
     QTest::addColumn<uint32_t>("version");
diff --git a/autotests/integration/test_helpers.cpp b/autotests/integration/test_helpers.cpp
index 2bcc6a7..6fc5b5a 100644
--- a/autotests/integration/test_helpers.cpp
+++ b/autotests/integration/test_helpers.cpp
@@ -2093,9 +2093,24 @@ void StereoDepthV1::kde_stereo_depth_v1_depth_limits(wl_fixed_t sunk, wl_fixed_t
     this->sunk = wl_fixed_to_double(sunk);
     this->popped = wl_fixed_to_double(popped);
     limits++;
+    order += 'l';
     Q_EMIT limitsReceived();
 }
 
+void StereoDepthV1::kde_stereo_depth_v1_output_width(uint32_t width)
+{
+    Q_UNUSED(width);
+    order += 'w';
+}
+
+void StereoDepthV1::kde_stereo_depth_v1_element_limit(wl_fixed_t limit)
+{
+    elementLimit = wl_fixed_to_double(limit);
+    elementLimits++;
+    // a new group starts
+    order = QByteArrayLiteral("e");
+}
+
 FifoManagerV1::FifoManagerV1(::wl_registry *registry, uint32_t id, int version)
     : QtWayland::wp_fifo_manager_v1(registry, id, version)
 {
