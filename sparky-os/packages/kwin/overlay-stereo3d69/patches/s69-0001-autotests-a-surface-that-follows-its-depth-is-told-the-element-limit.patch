+    // the last element_limit (pixels of a view 1920 wide), and how many arrived
+    double elementLimit = 0;
+    int elementLimits = 0;
+    // the events of the last group, in the order they arrived: 'e' element_limit, 'w' output_width, 'l' depth_limits
+    QByteArray order;
 
 Q_SIGNALS:
     void stateReceived();
@@ -1096,6 +1101,8 @@ Q_SIGNALS:
 protected:
     void kde_stereo_depth_v1_depth_state(uint32_t awake, uint32_t output_edges) override;
     void kde_stereo_depth_v1_depth_limits(wl_fixed_t sunk, wl_fixed_t popped) override;
+    void kde_stereo_depth_v1_output_width(uint32_t width) override;
+    void kde_stereo_depth_v1_element_limit(wl_fixed_t limit) override;
 };
 
 class WlKeyboard;
