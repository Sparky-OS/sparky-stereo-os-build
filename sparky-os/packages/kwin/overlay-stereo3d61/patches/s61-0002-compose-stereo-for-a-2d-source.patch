+std::shared_ptr<StereoEyePair> Compositor::composedEyes(LogicalOutput *output, bool *hdrContent, bool *cursorVisible) const
+{
+    if (!s_stereoReplicaCopy) {
+        return nullptr;
+    }
+    for (const auto &[loop, view] : m_primaryViews) {
+        if (view->logicalOutput() == output && view->backendOutput() == output->backendOutput()) {
+            const auto eyes = view->layer()->composedEyes();
+            const auto generation = m_eyesGeneration.find(loop);
+            if (!eyes || generation == m_eyesGeneration.end() || generation->second != eyes->generation) {
+                return nullptr;
+            }
+            if (hdrContent) {
+                *hdrContent = view->layer()->eyesHdrContent();
+            }
+            if (cursorVisible) {
+                const auto visible = m_eyesCursorVisible.find(loop);
+                *cursorVisible = visible != m_eyesCursorVisible.end() && visible->second;
+            }
+            return eyes;
+        }
+    }
+    return nullptr;
+}
