+bool OutputScreenCastSource::copyStereoEyes(const RenderTarget &target, GLFramebuffer *streamTarget)
+{
+    // A filtered capture must still paint its own view. Never copy a window or cursor
+    // the person asked to leave out of the stream.
+    if (!m_panel || m_panel->replicationSource().isEmpty() || captureViewport() != m_output->geometryF()
+        || backendOutput()->transform() != OutputTransform::Normal
+        || std::ranges::any_of(workspace()->windows(), [this](Window *window) {
+               return window->excludeFromCapture() || (m_pidToHide && window->pid() == *m_pidToHide);
+           })) {
+        return false;
+    }
+    bool hdrContent = false;
+    bool cursorVisible = false;
+    const auto eyes = Compositor::self()->composedEyes(m_output, &hdrContent, &cursorVisible);
+    if (!m_renderCursor && cursorVisible) {
+        return false;
+    }
+    if (!eyes || !eyes->left || !eyes->right || eyes->owner != EglContext::currentContext()
+        || eyes->transform != OutputTransform(OutputTransform::Normal).combine(OutputTransform::FlipY)) {
+        return false;
+    }
+    const auto conversion = ColorConversionTable::forCopy(eyes->blendingColor, target.colorDescription(), hdrContent, nullptr);
+    if (!conversion) {
+        return false;
+    }
+    const Rect place = target.transform().map(m_sceneView->deviceRect(), target.transformedSize()) & Rect(QPoint(), target.size());
+    if (place.isEmpty() || place != target.transform().map(m_sceneView->deviceRect(), target.transformedSize())) {
+        return false;
+    }
+    GLFramebuffer *destination = target.framebuffer();
+    GLFramebuffer::pushFramebuffer(destination);
+    glClearColor(0, 0, 0, 0);
+    glClear(GL_COLOR_BUFFER_BIT);
+    GLFramebuffer::popFramebuffer();
+    for (int eye = 0; eye < 2; ++eye) {
+        const auto &slot = eye == 0 ? eyes->left : eyes->right;
+        GLFramebuffer::pushFramebuffer(destination);
+        QMatrix4x4 matrix;
+        matrix.ortho(QRectF(QPointF(), destination->size()));
+        matrix.translate(place.x(), place.y());
+        ShaderBinder binder(ShaderTrait::MapTexture | ShaderTrait::TransformColorspace);
+        binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, matrix);
+        binder.shader()->setColorspaceUniforms(*conversion);
+        slot->texture()->setFilter(GL_LINEAR);
+        glDisable(GL_BLEND);
+        slot->texture()->render(Rect(QPoint(), eyes->size), Region::infinite(), place.size(), 1);
+        GLFramebuffer::popFramebuffer();
+        GLFramebuffer::pushFramebuffer(destination);
+        streamTarget->blitFromFramebuffer(Rect(QPoint(), destination->size()), Rect(QPoint(eye * destination->size().width(), 0), destination->size()), GL_NEAREST);
+        GLFramebuffer::popFramebuffer();
+    }
+    EGLNativeFence fence(EglContext::currentContext()->displayObject());
+    if (fence.isValid()) {
+        if (eyes->leftHold) {
+            eyes->leftHold->addReleaseFence(fence.fileDescriptor());
+        }
+        if (eyes->rightHold) {
+            eyes->rightHold->addReleaseFence(fence.fileDescriptor());
+        }
+    }
+    qCDebug(KWIN_SCREENCAST, "stereo-replica: %s stream scene passes 0, eye copies 2", qPrintable(m_panel->name()));
+    return true;
+}
