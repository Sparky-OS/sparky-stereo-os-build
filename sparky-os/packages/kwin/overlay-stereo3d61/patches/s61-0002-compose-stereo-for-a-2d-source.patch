diff --git a/src/utils/stereoreplicaproblems.cpp b/src/utils/stereoreplicaproblems.cpp
new file mode 100644
index 0000000..1c457af
--- /dev/null
+++ b/src/utils/stereoreplicaproblems.cpp
@@ -0,0 +1,81 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "stereoreplicaproblems.h"
+
+#include "core/backendoutput.h"
+#include "utils/common.h"
+
+#include <QCryptographicHash>
+#include <QHash>
+#include <QLibrary>
+#include <QProcess>
+
+#ifndef KWIN_SPARKY_STEREO_PROBLEMS_LIBRARY
+#define KWIN_SPARKY_STEREO_PROBLEMS_LIBRARY ""
+#endif
+
+namespace KWin
+{
+
+static void reportProblem(BackendOutput *output, std::optional<StereoReplicaFailure> failure, const QString &prefix, const QString &identity)
+{
+    // Clear a record from an earlier compositor process once too; cache both
+    // transitions so the engine is not called on every successful frame.
+    static QHash<QString, int> reported;
+    if (!output) {
+        return;
+    }
+    const QString key = prefix + QString::fromLatin1(QCryptographicHash::hash(identity.toUtf8(), QCryptographicHash::Sha256).toHex());
+    const int state = failure ? int(*failure) + 1 : 0;
+    const auto existing = reported.constFind(key);
+    if (existing != reported.cend() && *existing == state) {
+        return;
+    }
+    reported.insert(key, state);
+
+    // Keep the engine's private library out of libkwin's ELF dependencies.
+    static QLibrary library(QString::fromUtf8(KWIN_SPARKY_STEREO_PROBLEMS_LIBRARY));
+    library.setLoadHints(QLibrary::PreventUnloadHint);
+    using Keep = int (*)(int, const char *, const char *, const char *, const char *const *, int, const char *);
+    using Clear = int (*)(int, const char *, const char *);
+    const auto keep = library.fileName().isEmpty() ? nullptr : reinterpret_cast<Keep>(library.resolve("ssp_keep"));
+    const auto clear = library.fileName().isEmpty() ? nullptr : reinterpret_cast<Clear>(library.resolve("ssp_clear"));
+    const QByteArray id = key.toUtf8();
+    int result;
+    if (failure && keep) {
+        const QByteArray name = output->name().toUtf8();
+        const char *args[] = {name.constData(), *failure == StereoReplicaFailure::Renderer ? "@LOCAL3" : "@LOCAL4"};
+        result = keep(2, "kwin-wayland", id.constData(), "LOCAL2", args, 2, nullptr);
+    } else if (!failure && clear) {
+        result = clear(2, "kwin-wayland", id.constData());
+    } else {
+        QStringList args;
+        if (failure) {
+            args = {QStringLiteral("keep"), QStringLiteral("--person"), QStringLiteral("--quiet"), QStringLiteral("kwin-wayland"), key,
+                    QStringLiteral("LOCAL2"), output->name(), *failure == StereoReplicaFailure::Renderer ? QStringLiteral("@LOCAL3") : QStringLiteral("@LOCAL4")};
+        } else {
+            args = {QStringLiteral("clear"), QStringLiteral("--person"), QStringLiteral("kwin-wayland"), key};
+        }
+        result = QProcess::execute(QStringLiteral("/usr/bin/sparky-stereo-problems"), args);
+    }
+    if (result != 0) {
+        qCWarning(KWIN_CORE) << "Could not" << (failure ? "tell the person about a failed stereo copy" : "clear a recovered stereo copy problem") << output->name() << result;
+    }
+}
+
+void setStereoReplicaProblem(BackendOutput *output, std::optional<StereoReplicaFailure> failure, bool capture)
+{
+    if (!output) {
+        return;
+    }
+    reportProblem(output, failure, capture ? QStringLiteral("stereo-capture-") : QStringLiteral("stereo-output-"), output->uuid().isEmpty() ? output->name() : output->uuid());
+}
+
+void setStereoReplicaConfigurationProblem(BackendOutput *output, std::optional<StereoReplicaFailure> failure, const QString &identity)
+{
+    reportProblem(output, failure, QStringLiteral("stereo-configuration-"), identity);
+}
+
+}
