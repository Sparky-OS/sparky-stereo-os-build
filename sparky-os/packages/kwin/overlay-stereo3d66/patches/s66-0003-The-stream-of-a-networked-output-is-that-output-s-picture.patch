+Region OutputScreenCastSource::renderNetworkFormat(GLFramebuffer *target, OutputModeline::Flag layout)
+{
+    using Flag = OutputModeline::Flag;
+    updateView();
+    // each eye is the whole desktop at the device's raster, as on a screen in that format; the format
+    // then squeezes the two into the frame (side by side, top and bottom) or mixes them (anaglyph)
+    const QSize eyeSize = backendOutput()->viewSize();
+    const QSize frameSize = target->size();
+    if (frameSize != textureSize() || eyeSize.isEmpty()) {
+        return Region{};
+    }
+    const bool anaglyph = layout == Flag::Stereo3DAnaglyphModern || layout == Flag::Stereo3DAnaglyphCrt;
+    const auto allocate = [&eyeSize](std::unique_ptr<GLTexture> &texture, std::unique_ptr<GLFramebuffer> &framebuffer) {
+        if (!texture || texture->size() != eyeSize) {
+            framebuffer.reset();
+            texture = GLTexture::allocate(GL_RGBA8, eyeSize);
+            if (!texture) {
+                return false;
+            }
+            framebuffer = std::make_unique<GLFramebuffer>(texture.get());
+        }
+        return framebuffer->valid();
+    };
+    if (!allocate(m_eyeTexture, m_eyeFramebuffer) || (anaglyph && !allocate(m_firstEyeTexture, m_firstEyeFramebuffer))) {
+        return Region{};
+    }
+    if (anaglyph && !m_anaglyphShader && !m_anaglyphShaderFailed) {
+        m_anaglyphShader = ShaderManager::instance()->generateShaderFromFile(ShaderTrait::MapTexture, QString(), QStringLiteral(":/opengl/anaglyph.frag"));
+        if (!m_anaglyphShader) {
+            m_anaglyphShaderFailed = true;
+            qCWarning(KWIN_SCREENCAST, "Failed to load the anaglyph shader: the stream of %s cannot show its format", qPrintable(backendOutput()->name()));
+        }
+    }
+    if (anaglyph && !m_anaglyphShader) {
+        return Region{};
+    }
+    const OutputTransform storage = target->colorAttachment()->contentTransform();
+    m_eyeTexture->setContentTransform(backendOutput()->transform().combine(storage));
+    if (m_firstEyeTexture) {
+        m_firstEyeTexture->setContentTransform(backendOutput()->transform().combine(storage));
+    }
+    const Region eyeDamage(Rect(QPoint(), eyeSize));
+    m_layer->setFramebuffer(m_eyeFramebuffer.get(), eyeDamage);
+    if (!m_layer->preparePresentationTest()) {
+        return Region{};
+    }
+    const auto beginInfo = m_layer->beginFrame();
+    if (!beginInfo) {
+        return Region{};
+    }
+    auto renderer = kwinApp()->scene()->renderer();
+    const auto previousEye = renderer->stereoEye();
+    const bool previousCapture = renderer->stereoCapture();
+    const auto restoreRenderer = qScopeGuard([&] {
+        renderer->setStereoEye(previousEye);
+        renderer->setStereoCapture(previousCapture);
+    });
+    renderer->setStereoCapture(true);
+    m_sceneView->prePaint();
+    m_layer->resetRepaints();
+    // where each eye goes in the frame, as the person sees it, then as the frame stores it
+    const int w = frameSize.width();
+    const int h = frameSize.height();
+    const std::array<Rect, 2> places = layout == Flag::Stereo3DSideBySideHalf
+        ? std::array<Rect, 2>{Rect(0, 0, w / 2, h), Rect(w / 2, 0, w - w / 2, h)}
+        : std::array<Rect, 2>{Rect(0, 0, w, h / 2), Rect(0, h / 2, w, h - h / 2)};
+    qCDebug(KWIN_SCREENCAST, "network screen %s: stream in its 3D format, scene passes 2", qPrintable(backendOutput()->name()));
+    for (int eye = 0; eye < 2; ++eye) {
+        // the first place takes the left eye, or the right one when the output swaps its eyes
+        renderer->setStereoEye((eye == 0) != backendOutput()->stereoSwapEyes() ? StereoEye::Left : StereoEye::Right);
+        m_sceneView->paint(beginInfo->renderTarget, m_sceneView->renderOffset(), eyeDamage);
+        GLFramebuffer::pushFramebuffer(m_eyeFramebuffer.get());
+        if (anaglyph) {
+            if (eye == 0) {
+                m_firstEyeFramebuffer->blitFromFramebuffer(Rect(QPoint(), eyeSize), Rect(QPoint(), eyeSize), GL_NEAREST);
+            }
+        } else {
+            target->blitFromFramebuffer(Rect(QPoint(), eyeSize), storage.map(places[eye], frameSize), GL_LINEAR);
+        }
+        GLFramebuffer::popFramebuffer();
+    }
+    if (anaglyph) {
+        // the anaglyph a screen's own layer draws: its red from the first eye, its green and blue from the second
+        GLFramebuffer::pushFramebuffer(target);
+        ShaderBinder binder(m_anaglyphShader.get());
+        GLShader *shader = binder.shader();
+        shader->setColorspaceUniforms(beginInfo->renderTarget.colorDescription(), beginInfo->renderTarget.colorDescription(), RenderingIntent::AbsoluteColorimetricNoAdaptation);
+        shader->setUniform("leftEye", 0);
+        shader->setUniform("rightEye", 1);
+        const bool modern = layout == Flag::Stereo3DAnaglyphModern;
+        shader->setUniform("leftMatrix", duboisAnaglyphMatrix(modern, true));
+        shader->setUniform("rightMatrix", duboisAnaglyphMatrix(modern, false));
+        // as a screen's own layer draws it: storage rows onto storage rows
+        QMatrix4x4 projection;
+        projection.scale(1, -1);
+        projection.ortho(QRectF(QPointF(), frameSize));
+        shader->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, projection);
+        GLVertexBuffer *vbo = GLVertexBuffer::streamingBuffer();
+        vbo->reset();
+        vbo->setAttribLayout(std::span(GLVertexBuffer::GLVertex2DLayout), sizeof(GLVertex2D));
+        if (const auto map = vbo->map<GLVertex2D>(6)) {
+            // the whole frame samples the whole of each eye, texel for texel in storage order
+            const float x1 = w;
+            const float y1 = h;
+            (*map)[0] = GLVertex2D{.position = QVector2D(0, 0), .texcoord = QVector2D(0, 0)};
+            (*map)[1] = GLVertex2D{.position = QVector2D(x1, y1), .texcoord = QVector2D(1, 1)};
+            (*map)[2] = GLVertex2D{.position = QVector2D(0, y1), .texcoord = QVector2D(0, 1)};
+            (*map)[3] = GLVertex2D{.position = QVector2D(0, 0), .texcoord = QVector2D(0, 0)};
+            (*map)[4] = GLVertex2D{.position = QVector2D(x1, 0), .texcoord = QVector2D(1, 0)};
+            (*map)[5] = GLVertex2D{.position = QVector2D(x1, y1), .texcoord = QVector2D(1, 1)};
+            vbo->unmap();
+            vbo->setVertexCount(6);
+            glDisable(GL_BLEND);
+            glActiveTexture(GL_TEXTURE1);
+            m_eyeTexture->bind();
+            glActiveTexture(GL_TEXTURE0);
+            m_firstEyeTexture->bind();
+            vbo->render(GL_TRIANGLES);
+            m_firstEyeTexture->unbind();
+            glActiveTexture(GL_TEXTURE1);
+            m_eyeTexture->unbind();
+            glActiveTexture(GL_TEXTURE0);
+        }
+        GLFramebuffer::popFramebuffer();
+    }
+    m_sceneView->postPaint();
+    if (!m_layer->endFrame(eyeDamage, eyeDamage, nullptr)) {
+        return Region{};
+    }
+    return Rect(QPoint(), frameSize);
+}
+
 std::chrono::nanoseconds OutputScreenCastSource::clock() const
 {
     return backendOutput()->renderLoop()->lastPresentationTimestamp();
@@ -419,11 +576,15 @@ void OutputScreenCastSource::pause()
     m_cursorView.reset();
     m_sceneView.reset();
     m_layer.reset();
-    if (m_eyeFramebuffer) {
+    if (m_eyeFramebuffer || m_firstEyeFramebuffer || m_anaglyphShader) {
         static_cast<EglBackend *>(Compositor::self()->backend())->openglContext()->makeCurrent();
     }
     m_eyeFramebuffer.reset();
     m_eyeTexture.reset();
+    m_firstEyeFramebuffer.reset();
+    m_firstEyeTexture.reset();
+    m_anaglyphShader.reset();
+    m_anaglyphShaderFailed = false;
 
     m_active = false;
 }
