+// A network screen in one of its 3D formats: what it sends is that output's picture, the two eyes
+// packed as the format packs them.
+static std::optional<OutputModeline::Flag> networkFormat(BackendOutput *output)
+{
+    using Flag = OutputModeline::Flag;
+    if (!output->offersNetworkFormats() || !output->currentMode()) {
+        return std::nullopt;
+    }
+    const auto flags = output->currentMode()->flags();
+    if (!(flags & Flag::VirtualStereo)) {
+        return std::nullopt;
+    }
+    for (const Flag layout : {Flag::Stereo3DSideBySideHalf, Flag::Stereo3DTopAndBottom, Flag::Stereo3DAnaglyphModern, Flag::Stereo3DAnaglyphCrt}) {
+        if (flags.testFlag(layout)) {
+            return layout;
+        }
+    }
+    return std::nullopt;
+}
