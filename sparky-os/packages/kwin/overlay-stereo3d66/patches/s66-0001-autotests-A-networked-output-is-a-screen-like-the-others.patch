+// A network screen without split eyes (a Cast device) is a screen like the others: what its stream carries is that
+// output's picture, in the 3D format the person chose for it, with its eye swap; in 2D one view.
+void ScreencastingTest::testNetworkedOutput_data()
+{
+    using Flag = OutputModeline::Flag;
+    QTest::addColumn<int>("layout");
+    QTest::addColumn<bool>("swapEyes");
+    QTest::newRow("2d") << 0 << false;
+    QTest::newRow("side-by-side-half") << int(Flag::Stereo3DSideBySideHalf) << false;
+    QTest::newRow("top-and-bottom") << int(Flag::Stereo3DTopAndBottom) << false;
+    QTest::newRow("anaglyph-modern") << int(Flag::Stereo3DAnaglyphModern) << false;
+    QTest::newRow("anaglyph-crt") << int(Flag::Stereo3DAnaglyphCrt) << false;
+    QTest::newRow("side-by-side-half-swapped") << int(Flag::Stereo3DSideBySideHalf) << true;
+    QTest::newRow("top-and-bottom-swapped") << int(Flag::Stereo3DTopAndBottom) << true;
+    QTest::newRow("anaglyph-modern-swapped") << int(Flag::Stereo3DAnaglyphModern) << true;
+}
+
+void ScreencastingTest::testNetworkedOutput()
+{
+    using Flag = OutputModeline::Flag;
+    QFETCH(int, layout);
+    QFETCH(bool, swapEyes);
+    const QSize deviceSize(1280, 720);
+    const int refresh = 30000;
+    const auto outputCount = workspace()->outputs().size();
+    auto stream = std::make_unique<Test::ScreencastingStreamV1>(nullptr);
+    stream->init(Test::screencasting()->stream_virtual_output_with_properties(QStringLiteral("cast-test-device"), QStringLiteral("Living room TV"),
+        deviceSize.width(), deviceSize.height(), refresh, wl_fixed_from_double(1), 0, 0, 0, QtWayland::zkde_screencast_unstable_v1::pointer_hidden));
+    QSignalSpy created(stream.get(), &Test::ScreencastingStreamV1::created);
+    QSignalSpy failed(stream.get(), &Test::ScreencastingStreamV1::failed);
+    QVERIFY(created.wait());
+    QCOMPARE(failed.count(), 0);
+    QTRY_COMPARE(workspace()->outputs().size(), outputCount + 1);
+    auto backendOutput = kwinApp()->outputBackend()->findOutput(QStringLiteral("Virtual-cast-test-device"));
+    QVERIFY(backendOutput);
+    QVERIFY(backendOutput->isNetworked());
+    QVERIFY(!backendOutput->isSplitEyeDisplay());
+    auto output = workspace()->findOutput(backendOutput);
+    QVERIFY(output);
+    QCOMPARE(backendOutput->modeSize(), deviceSize);
+    QVERIFY(!backendOutput->currentMode()->flags().testFlag(Flag::VirtualStereo));
+    if (layout) {
+        OutputConfiguration configuration;
+        configuration.source = OutputConfiguration::Source::User;
+        configuration.changeSet(backendOutput)->otherStereoFormats = true;
+        configuration.changeSet(backendOutput)->anaglyph = true;
+        configuration.changeSet(backendOutput)->stereoSwapEyes = swapEyes;
+        configuration.changeSet(backendOutput)->currentMode = OutputModeline(deviceSize, refresh, Flag::VirtualStereo | Flag(layout));
+        QCOMPARE(workspace()->applyOutputConfiguration(configuration), OutputConfigurationError::None);
+        QVERIFY(backendOutput->currentMode()->flags().testFlag(Flag(layout)));
+        QCOMPARE(backendOutput->stereoSwapEyes(), swapEyes);
+    }
+    QCOMPARE(output->geometry().size(), deviceSize);
+
+    const QColor leftColor(255, 0, 0);
+    const QColor rightColor(0, 0, 255);
+    QImage pair(QSize(deviceSize.width() * 2, deviceSize.height()), QImage::Format_RGBA8888_Premultiplied);
+    {
+        QPainter painter(&pair);
+        painter.fillRect(QRect(QPoint(), deviceSize), leftColor);
+        painter.fillRect(QRect(QPoint(deviceSize.width(), 0), deviceSize), rightColor);
+    }
+    QTemporaryDir fixtureDirectory;
+    QVERIFY(fixtureDirectory.isValid());
+    const auto fixturePath = fixtureDirectory.filePath(QStringLiteral("pair.png"));
+    QVERIFY(pair.save(fixturePath));
+    QProcess producer;
+    auto environment = QProcessEnvironment::systemEnvironment();
+    environment.insert(QStringLiteral("WAYLAND_DISPLAY"), waylandServer()->socketName());
+    producer.setProcessEnvironment(environment);
+    producer.setProgram(QCoreApplication::applicationDirPath() + QStringLiteral("/capturefixture"));
+    producer.setArguments({fixturePath, QString::number(deviceSize.width()), QString::number(deviceSize.height()), QStringLiteral("stereo")});
+    const auto stopProducer = qScopeGuard([&] {
+        producer.terminate();
+        producer.waitForFinished();
+    });
+    producer.start();
+    Window *window = Test::waitForWaylandWindowShown();
+    QVERIFY2(window, producer.readAllStandardError().constData());
+    window->move(output->geometry().topLeft());
+    QCOMPARE(window->frameGeometry().size(), QSizeF(deviceSize));
+
+    PipeWireSourceStream receiver;
+    std::optional<QImage> image;
+    receiver.setAllowDmaBuf(false);
+    connect(&receiver, &PipeWireSourceStream::frameReceived, this, [&](const PipeWireFrame &frame) {
+        if (frame.dataFrame) {
+            image = frame.dataFrame->toImage().convertedTo(QImage::Format_RGBA8888);
+        }
+    });
+    receiver.createStream(stream->nodeId(), 0);
+    // the window is in place before the stream starts, so its first frame shows it
+    QTRY_VERIFY_WITH_TIMEOUT(image.has_value(), 10000);
+    QCOMPARE(image->size(), deviceSize);
+    const QString proofDirectory = qEnvironmentVariable("KWIN_THROW_PROOF_DIR");
+    if (!proofDirectory.isEmpty()) {
+        QVERIFY(QDir().mkpath(proofDirectory));
+        QVERIFY(image->save(proofDirectory + QStringLiteral("/") + QString::fromLatin1(QTest::currentDataTag()) + QStringLiteral(".png")));
+    }
+    // the mean colour of a region, away from the seam between two halves
+    const auto mean = [&](const QRect &region) {
+        qint64 r = 0, g = 0, b = 0;
+        for (int y = region.top(); y <= region.bottom(); ++y) {
+            for (int x = region.left(); x <= region.right(); ++x) {
+                const QColor c = image->pixelColor(x, y);
+                r += c.red();
+                g += c.green();
+                b += c.blue();
+            }
+        }
+        const qint64 n = qint64(region.width()) * region.height();
+        return QColor(r / n, g / n, b / n);
+    };
+    const auto near = [](const QColor &a, const QColor &b) {
+        return std::abs(a.red() - b.red()) <= 16 && std::abs(a.green() - b.green()) <= 16 && std::abs(a.blue() - b.blue()) <= 16;
+    };
+    const int w = deviceSize.width();
+    const int h = deviceSize.height();
+    const QRect leftHalf(16, 16, w / 2 - 32, h - 32);
+    const QRect rightHalf(w / 2 + 16, 16, w / 2 - 32, h - 32);
+    const QRect topHalf(16, 16, w - 32, h / 2 - 32);
+    const QRect bottomHalf(16, h / 2 + 16, w - 32, h / 2 - 32);
+    const QColor first = swapEyes ? rightColor : leftColor;
+    const QColor second = swapEyes ? leftColor : rightColor;
+    const auto describe = [&](const QRect &region) {
+        const QColor c = mean(region);
+        return QStringLiteral("%1,%2,%3").arg(c.red()).arg(c.green()).arg(c.blue()).toLatin1();
+    };
+    switch (Flag(layout)) {
+    case Flag::Stereo3DSideBySideHalf:
+        QVERIFY2(near(mean(leftHalf), first), describe(leftHalf).constData());
+        QVERIFY2(near(mean(rightHalf), second), describe(rightHalf).constData());
+        break;
+    case Flag::Stereo3DTopAndBottom:
+        QVERIFY2(near(mean(topHalf), first), describe(topHalf).constData());
+        QVERIFY2(near(mean(bottomHalf), second), describe(bottomHalf).constData());
+        break;
+    case Flag::Stereo3DAnaglyphModern:
+    case Flag::Stereo3DAnaglyphCrt: {
+        // one picture over the whole frame: the Dubois mix of the first and the second eye, in linear light
+        // (sRGB is a 2.2 gamma in KWin), predicted here from the two colours
+        const bool modern = Flag(layout) == Flag::Stereo3DAnaglyphModern;
+        const auto linear = [](const QColor &c) {
+            return QVector4D(std::pow(c.redF(), 2.2f), std::pow(c.greenF(), 2.2f), std::pow(c.blueF(), 2.2f), 0);
+        };
+        const QVector4D mixed = duboisAnaglyphMatrix(modern, true) * linear(first) + duboisAnaglyphMatrix(modern, false) * linear(second);
+        const auto encode = [](float v) {
+            return int(std::lround(255 * std::pow(std::clamp(v, 0.0f, 1.0f), 1 / 2.2f)));
+        };
+        const QColor predicted(encode(mixed.x()), encode(mixed.y()), encode(mixed.z()));
+        const QColor whole = mean(QRect(16, 16, w - 32, h - 32));
+        const auto within = [](const QColor &a, const QColor &b, int tolerance) {
+            return std::abs(a.red() - b.red()) <= tolerance && std::abs(a.green() - b.green()) <= tolerance && std::abs(a.blue() - b.blue()) <= tolerance;
+        };
+        QVERIFY2(near(mean(leftHalf), mean(rightHalf)), describe(leftHalf).constData());
+        QVERIFY2(within(whole, predicted, 6),
+                 QStringLiteral("measured %1,%2,%3 predicted %4,%5,%6").arg(whole.red()).arg(whole.green()).arg(whole.blue()).arg(predicted.red()).arg(predicted.green()).arg(predicted.blue()).toLatin1().constData());
+        break;
+    }
+    default:
+        // 2D: one view, the left eye's, over the whole frame
+        QVERIFY2(near(mean(leftHalf), leftColor), describe(leftHalf).constData());
+        QVERIFY2(near(mean(rightHalf), leftColor), describe(rightHalf).constData());
+        break;
+    }
+    receiver.stopStreaming();
+    stream.reset();
+    QTRY_COMPARE(workspace()->outputs().size(), outputCount);
+    QVERIFY(!kwinApp()->outputBackend()->findOutput(QStringLiteral("Virtual-cast-test-device")));
+}
+
 void ScreencastingTest::testNativePanelMirror_data()
 {
     QTest::addColumn<bool>("stereo");
