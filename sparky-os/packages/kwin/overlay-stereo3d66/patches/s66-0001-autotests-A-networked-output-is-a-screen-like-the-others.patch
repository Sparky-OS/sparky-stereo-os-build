 void ScreencastingTest::testNativePanelMirror_data()
 {
     QTest::addColumn<bool>("stereo");
diff --git a/autotests/integration/throw_to_menu_test.cpp b/autotests/integration/throw_to_menu_test.cpp
new file mode 100644
