+// The window menu keeps "Move to Screen" for the computer's own screens; a network screen (an output made for a
+// device on the network, flagged as networked) is listed under "Throw to" instead, by the device's name.
+class ThrowToMenuTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase();
+    void init();
+    void cleanup();
+    void testNetworkScreensUnderThrowTo();
+
+private:
+    QMenu *submenu(const QString &title) const;
+};
+
+void ThrowToMenuTest::initTestCase()
+{
+    qRegisterMetaType<KWin::Window *>();
+    QVERIFY(waylandServer()->init(qAppName()));
+    kwinApp()->start();
+    Test::setOutputConfig({
+        Rect(0, 0, 1280, 1024),
+        Rect(1280, 0, 1280, 1024),
+    });
+    QCOMPARE(workspace()->outputs().count(), 2);
+}
+
+void ThrowToMenuTest::init()
+{
+    QVERIFY(Test::setupWaylandConnection());
+    workspace()->setActiveOutput(QPoint(640, 512));
+    KWin::input()->pointer()->warp(QPoint(640, 512));
+}
+
+void ThrowToMenuTest::cleanup()
+{
+    Test::destroyWaylandConnection();
+}
+
+QMenu *ThrowToMenuTest::submenu(const QString &title) const
+{
+    for (QWidget *widget : QApplication::topLevelWidgets()) {
+        auto menu = qobject_cast<QMenu *>(widget);
+        if (!menu || !menu->isVisible()) {
+            continue;
+        }
+        for (QAction *action : menu->actions()) {
+            if (action->menu() && action->text() == title) {
+                // the entries are made when the submenu is about to show
+                QMetaObject::invokeMethod(action->menu(), "aboutToShow");
+                return action->menu();
+            }
+        }
+    }
+    return nullptr;
+}
+
+void ThrowToMenuTest::testNetworkScreensUnderThrowTo()
+{
+    const auto outputCount = workspace()->outputs().size();
+    // a network screen as a Throw makes it: the screencast request marks the output it creates as networked
+    BackendOutput *device = kwinApp()->outputBackend()->createVirtualOutput(VirtualOutputProperties{
+        .name = QStringLiteral("cast-menu-device"),
+        .description = QStringLiteral("Living room TV"),
+        .pixelSize = QSize(1280, 720),
+        .refreshRate = 30000,
+        .scale = 1,
+        .networked = true,
+    });
+    QVERIFY(device);
+    QTRY_COMPARE(workspace()->outputs().size(), outputCount + 1);
+    QVERIFY(device->isNetworked());
+    LogicalOutput *deviceOutput = workspace()->findOutput(device);
+    QVERIFY(deviceOutput);
+
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> shellSurface(Test::createXdgToplevelSurface(surface.get()));
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    QVERIFY(window->output() != deviceOutput);
+
+    workspace()->showWindowMenu(Rect(), window);
+    auto userActionsMenu = workspace()->userActionsMenu();
+    QTRY_VERIFY(userActionsMenu->isShown());
+
+    // the computer's own screens, and only those
+    QMenu *moveTo = submenu(QStringLiteral("Move to &Screen"));
+    QVERIFY(moveTo);
+    QStringList moveEntries;
+    for (QAction *action : moveTo->actions()) {
+        moveEntries << action->text();
+    }
+    QCOMPARE(moveEntries.size(), 2);
+    for (const QString &entry : moveEntries) {
+        QVERIFY2(!entry.contains(QStringLiteral("cast-menu-device")) && !entry.contains(QStringLiteral("Living room TV")), qPrintable(entry));
+    }
+
+    // the network screen, by the device's name
+    QMenu *throwTo = submenu(QStringLiteral("Throw &to"));
+    QVERIFY(throwTo);
+    QCOMPARE(throwTo->actions().size(), 1);
+    QAction *throwAction = throwTo->actions().first();
+    QVERIFY2(throwAction->text().contains(QStringLiteral("Living room TV")), qPrintable(throwAction->text()));
+    throwAction->trigger();
+    QTRY_COMPARE(window->output(), deviceOutput);
+
+    Test::keyboardKeyPressed(KEY_ESC, 0);
+    Test::keyboardKeyReleased(KEY_ESC, 1);
+    QTRY_VERIFY(!userActionsMenu->isShown());
+
+    // a window on the network screen can be brought back with "Move to Screen"
+    workspace()->showWindowMenu(Rect(), window);
+    QTRY_VERIFY(userActionsMenu->isShown());
+    moveTo = submenu(QStringLiteral("Move to &Screen"));
+    QVERIFY(moveTo);
+    QCOMPARE(moveTo->actions().size(), 2);
+    moveTo->actions().first()->trigger();
+    QTRY_VERIFY(window->output() != deviceOutput);
+    Test::keyboardKeyPressed(KEY_ESC, 0);
+    Test::keyboardKeyReleased(KEY_ESC, 1);
+    QTRY_VERIFY(!userActionsMenu->isShown());
+
+    kwinApp()->outputBackend()->removeVirtualOutput(device);
+    QTRY_COMPARE(workspace()->outputs().size(), outputCount);
+}
+
+WAYLANDTEST_MAIN(ThrowToMenuTest)
+#include "throw_to_menu_test.moc"
diff --git a/autotests/test_virtual_output_properties.cpp b/autotests/test_virtual_output_properties.cpp
index b00fbe6..836e542 100644
--- a/autotests/test_virtual_output_properties.cpp
+++ b/autotests/test_virtual_output_properties.cpp
@@ -16,6 +16,7 @@
 #include <QTest>
 #include <QTemporaryDir>
 
+#include <algorithm>
 #include <limits>
 
 using namespace KWin;
@@ -274,6 +275,150 @@ private Q_SLOTS:
         backend.removeVirtualOutput(output);
     }
 
+    // A network screen (a Cast device thrown to) is a screen like the others: it offers the 3D formats and the
+    // eye swap a monitor offers, arrives in 2D at the device's own mode, and makes the format twins of that mode
+    // when the person switches them on.
+    void networkedOutput_data()
+    {
+        QTest::addColumn<bool>("drm");
+        QTest::newRow("headless-network") << false;
+        QTest::newRow("drm-network") << true;
+    }
+
+    void networkedOutput()
+    {
+        using Flag = OutputModeline::Flag;
+        QFETCH(bool, drm);
+        NoScanoutBackend renderer;
+        std::unique_ptr<OutputBackend> backend;
+        if (drm) {
+            auto drmBackend = std::make_unique<DrmBackend>(nullptr);
+            drmBackend->setRenderBackend(&renderer);
+            backend = std::move(drmBackend);
+        } else {
+            backend = std::make_unique<VirtualBackend>();
+        }
+        const QSize deviceSize(1920, 1080);
+        const VirtualOutputProperties properties{
+            .name = QStringLiteral("cast-living-room"),
+            .description = QStringLiteral("Living room TV"),
+            .pixelSize = deviceSize,
+            .refreshRate = 30000,
+            .scale = 1,
+            .networked = true,
+        };
+        BackendOutput *output = backend->createVirtualOutput(properties);
+        QVERIFY(output);
+        QVERIFY(output->isNetworked());
+        QVERIFY(!output->isSplitEyeDisplay());
+        QVERIFY(output->capabilities() & BackendOutput::Capability::VirtualStereo);
+        QVERIFY(output->capabilities() & BackendOutput::Capability::StereoSwapEyes);
+        QCOMPARE(output->modes().size(), 1);
+        QVERIFY(output->currentMode()->flags().testFlag(Flag::Preferred));
+        QVERIFY(!output->currentMode()->flags().testFlag(Flag::VirtualStereo));
+        QVERIFY(!output->otherStereoFormats());
+        QVERIFY(!output->anaglyph());
+        QVERIFY(!output->hasStereoEyes());
+        QCOMPARE(output->viewSize(), deviceSize);
+
+        OutputConfiguration formats;
+        formats.changeSet(output)->otherStereoFormats = true;
+        formats.changeSet(output)->anaglyph = true;
+        output->applyChanges(formats);
+        QVERIFY(output->otherStereoFormats());
+        QVERIFY(output->anaglyph());
+        const QList<Flag> layouts{Flag::Stereo3DSideBySideHalf, Flag::Stereo3DTopAndBottom, Flag::Stereo3DAnaglyphModern, Flag::Stereo3DAnaglyphCrt};
+        const auto modes = output->modes();
+        for (const Flag layout : layouts) {
+            const auto twin = std::ranges::find_if(modes, [layout](const auto &mode) {
+                return mode->flags().testFlag(layout) && mode->flags().testFlag(Flag::VirtualStereo);
+            });
+            QVERIFY2(twin != modes.end(), qPrintable(QString::number(int(layout))));
+            QCOMPARE((*twin)->size(), deviceSize);
+            QCOMPARE((*twin)->refreshRate(), 30000u);
+        }
+        QCOMPARE(output->modes().size(), 1 + layouts.size());
+        QVERIFY(!output->currentMode()->flags().testFlag(Flag::VirtualStereo));
+
+        OutputConfiguration sideBySide;
+        sideBySide.changeSet(output)->currentMode = OutputModeline(deviceSize, 30000, Flag::VirtualStereo | Flag::Stereo3DSideBySideHalf);
+        output->applyChanges(sideBySide);
+        QVERIFY(output->currentMode()->flags().testFlag(Flag::Stereo3DSideBySideHalf));
+        QCOMPARE(output->viewSize(), deviceSize);
+
+        OutputConfiguration swap;
+        swap.changeSet(output)->stereoSwapEyes = true;
+        output->applyChanges(swap);
+        QVERIFY(output->stereoSwapEyes());
+        QVERIFY(output->currentMode()->flags().testFlag(Flag::Stereo3DSideBySideHalf));
+
+        OutputConfiguration off;
+        off.changeSet(output)->otherStereoFormats = false;
+        off.changeSet(output)->anaglyph = false;
+        output->applyChanges(off);
+        QCOMPARE(output->modes().size(), 1);
+        QVERIFY(!output->currentMode()->flags().testFlag(Flag::VirtualStereo));
+        QCOMPARE(output->currentMode()->size(), deviceSize);
+        backend->removeVirtualOutput(output);
+    }
+
+    // The person's choice of a 3D format for a device comes back at the next Throw to the same device, and to no
+    // other one; a choice made at another mode of the device is not forced onto a new mode.
+    void networkedChoiceKeptByIdentity()
+    {
+        using Flag = OutputModeline::Flag;
+        QTemporaryDir configHome;
+        QVERIFY(configHome.isValid());
+        qputenv("XDG_CONFIG_HOME", configHome.path().toUtf8());
+        OutputConfigurationStore store;
+        store.clear();
+        VirtualBackend backend;
+        const VirtualOutputProperties properties{.name = QStringLiteral("cast-den"), .description = QStringLiteral("Den TV"), .pixelSize = QSize(1280, 720), .refreshRate = 30000, .scale = 1, .networked = true};
+        auto output = backend.createVirtualOutput(properties);
+        auto queried = store.queryConfig({output}, false, AccelerometerOrientation::Undefined, false);
+        QVERIFY(queried);
+        QVERIFY(!queried->first.constChangeSet(output)->currentMode->flags().testFlag(Flag::VirtualStereo));
+        output->applyChanges(queried->first);
+        OutputConfiguration chosen;
+        chosen.changeSet(output)->otherStereoFormats = true;
+        // as Display Settings applies a mode: the current and the desired mode
+        chosen.changeSet(output)->currentMode = OutputModeline(QSize(1280, 720), 30000, Flag::VirtualStereo | Flag::Stereo3DTopAndBottom);
+        chosen.changeSet(output)->desiredMode = chosen.changeSet(output)->currentMode;
+        chosen.changeSet(output)->stereoSwapEyes = true;
+        output->applyChanges(chosen);
