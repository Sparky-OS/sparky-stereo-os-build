+bool BackendOutput::offersNetworkFormats() const
+{
+    return isNetworked() && !isSplitEyeDisplay();
+}
+
+QList<std::shared_ptr<OutputMode>> BackendOutput::withNetworkFormatModes(const QList<std::shared_ptr<OutputMode>> &modes, bool anaglyph, bool otherStereoFormats)
+{
+    using Flag = OutputModeline::Flag;
+    // the 2D modes stay, the twins are made again from them; a twin already made is kept as the same object
+    QList<std::shared_ptr<OutputMode>> result;
+    QList<std::shared_ptr<OutputMode>> previousTwins;
+    for (const auto &mode : modes) {
+        if (mode->flags() & Flag::VirtualStereo) {
+            previousTwins.append(mode);
+        } else {
+            result.append(mode);
+        }
+    }
+    QList<Flag> layouts;
+    if (otherStereoFormats) {
+        // the packings a television takes by its own 3D button, at the device's raster
+        layouts << Flag::Stereo3DSideBySideHalf << Flag::Stereo3DTopAndBottom;
+    }
+    if (anaglyph) {
+        layouts << Flag::Stereo3DAnaglyphModern << Flag::Stereo3DAnaglyphCrt;
+    }
+    const auto bases = result;
+    for (const auto &base : bases) {
+        if (base->flags() & Flag::Custom) {
+            continue;
+        }
+        for (const Flag layout : layouts) {
+            const OutputModeline twin(base->size(), base->refreshRate(), Flag::VirtualStereo | layout);
+            if (auto previous = twin.match(previousTwins)) {
+                result.append(previous);
+            } else {
+                result.append(std::make_shared<OutputMode>(twin));
+            }
+        }
+    }
+    return result;
+}
+
 const Edid &BackendOutput::edid() const
 {
     return m_information.edid;
