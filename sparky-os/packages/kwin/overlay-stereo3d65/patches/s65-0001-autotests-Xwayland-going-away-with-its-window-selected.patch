+using namespace KWin;
+
+class TranslucencyXwaylandTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase();
+    void init();
+    void cleanup();
+
+    void testSelectedWindowAfterXwaylandCrash();
+
+private:
+    Effect *m_translucencyEffect = nullptr;
+};
+
+// The opacity, in percent, the effect keeps a window at once its animations have ended: the lowest target of an
+// opacity animation it still holds for the window, or 100 when it holds none. AnimationEffect::debug() lists each
+// animated window by its caption, then for each animation its attribute, "From:" and "To:".
+static int heldOpacity(Effect *effect, const QString &caption)
+{
+    qreal opacity = 1.0;
+    const QStringList windows = effect->debug(QString()).split(QStringLiteral("Animating window: "));
+    for (const QString &window : windows) {
+        const QStringList lines = window.split(QLatin1Char('\n'));
+        if (lines.first() != caption) {
+            continue;
+        }
+        for (int i = 0; i + 2 < lines.size(); ++i) {
+            const QString to = lines[i + 2].trimmed();
+            if (lines[i].trimmed() == QLatin1StringView("Animation: Opacity") && to.startsWith(QLatin1StringView("To: "))) {
+                opacity = std::min(opacity, to.mid(4).section(QLatin1Char(','), 0, 0).toDouble());
+            }
+        }
+    }
+    return qRound(opacity * 100);
+}
+
+void TranslucencyXwaylandTest::initTestCase()
+{
+    qputenv("XDG_DATA_DIRS", QCoreApplication::applicationDirPath().toUtf8());
+    qRegisterMetaType<KWin::Window *>();
+    qRegisterMetaType<KWin::Effect *>();
+    QVERIFY(waylandServer()->init(qAppName()));
+
+    auto config = KSharedConfig::openConfig(QString(), KConfig::SimpleConfig);
+    KConfigGroup plugins(config, QStringLiteral("Plugins"));
+    const auto builtinNames = EffectLoader().listOfKnownEffects();
+    for (const QString &name : builtinNames) {
+        plugins.writeEntry(name + QStringLiteral("Enabled"), false);
+    }
+    // the edition's value (sparky-stereo-look's /etc/xdg/kwinrc)
+    config->group(QStringLiteral("Effect-translucency")).writeEntry(QStringLiteral("Inactive"), 91);
+    config->sync();
+    kwinApp()->setConfig(config);
+
+    qputenv("KWIN_EFFECTS_FORCE_ANIMATIONS", "1");
+    kwinApp()->start();
+    QVERIFY(Compositor::self());
+    Test::setOutputConfig({
+        Rect(0, 0, 1280, 1024),
+    });
+}
+
+void TranslucencyXwaylandTest::init()
+{
+    QVERIFY(Test::setupWaylandConnection());
+
+    auto effectloader = effects->findChild<AbstractEffectLoader *>();
+    QVERIFY(effectloader);
+    QSignalSpy effectLoadedSpy(effectloader, &AbstractEffectLoader::effectLoaded);
+    QVERIFY(effects->loadEffect(QStringLiteral("translucency")));
+    QCOMPARE(effectLoadedSpy.count(), 1);
+    m_translucencyEffect = effectLoadedSpy.first().first().value<Effect *>();
+    QVERIFY(m_translucencyEffect);
+}
+
+void TranslucencyXwaylandTest::cleanup()
+{
+    Test::destroyWaylandConnection();
+    if (effects->isEffectLoaded(QStringLiteral("translucency"))) {
+        effects->unloadEffect(QStringLiteral("translucency"));
+    }
+    m_translucencyEffect = nullptr;
+}
+
+void TranslucencyXwaylandTest::testSelectedWindowAfterXwaylandCrash()
+{
+    // An X11 window is the selected one when Xwayland goes away. KWin releases the X11 windows on the shutdown path,
+    // where nothing activates another window. The windows selected next must be opaque, the others at 91 %, and the
+    // effect must not fail on the window that went with Xwayland (queue row 862).
+    QTest::failOnWarning(QRegularExpression(QStringLiteral("references invalid window")));
+
+    std::unique_ptr<KWayland::Client::Surface> surfaceA = Test::createSurface();
+    std::unique_ptr<Test::XdgToplevel> toplevelA = Test::createXdgToplevelSurface(surfaceA.get());
+    toplevelA->set_title(QStringLiteral("translucency-a"));
+    Window *windowA = Test::renderAndWaitForShown(surfaceA.get(), QSize(100, 50), Qt::white);
+    QVERIFY(windowA);
+    std::unique_ptr<KWayland::Client::Surface> surfaceB = Test::createSurface();
+    std::unique_ptr<Test::XdgToplevel> toplevelB = Test::createXdgToplevelSurface(surfaceB.get());
+    toplevelB->set_title(QStringLiteral("translucency-b"));
+    Window *windowB = Test::renderAndWaitForShown(surfaceB.get(), QSize(100, 50), Qt::white);
+    QVERIFY(windowB);
+
+    Test::XcbConnectionPtr c = Test::createX11Connection();
+    QVERIFY(!xcb_connection_has_error(c.get()));
+    const Rect geometry(0, 0, 100, 200);
+    xcb_window_t windowId = xcb_generate_id(c.get());
+    xcb_create_window(c.get(), XCB_COPY_FROM_PARENT, windowId, rootWindow(), geometry.x(), geometry.y(),
+                      geometry.width(), geometry.height(), 0, XCB_WINDOW_CLASS_INPUT_OUTPUT, XCB_COPY_FROM_PARENT, 0, nullptr);
+    xcb_size_hints_t hints{};
+    xcb_icccm_size_hints_set_position(&hints, 1, geometry.x(), geometry.y());
+    xcb_icccm_size_hints_set_size(&hints, 1, geometry.width(), geometry.height());
+    xcb_icccm_set_wm_normal_hints(c.get(), windowId, &hints);
+    xcb_map_window(c.get(), windowId);
+    xcb_flush(c.get());
+    QSignalSpy windowAddedSpy(workspace(), &Workspace::windowAdded);
+    QVERIFY(windowAddedSpy.wait());
+    QPointer<X11Window> x11Window = windowAddedSpy.last().first().value<X11Window *>();
+    QVERIFY(x11Window);
+    workspace()->activateWindow(x11Window);
+    QTRY_COMPARE(workspace()->activeWindow(), x11Window.data());
+    QTRY_COMPARE(heldOpacity(m_translucencyEffect, windowA->caption()), 91);
+    QTRY_COMPARE(heldOpacity(m_translucencyEffect, windowB->caption()), 91);
+
+    // Xwayland goes away with its window selected
+    QSignalSpy x11ConnectionChangedSpy(kwinApp(), &Application::x11ConnectionChanged);
+    Xwl::Xwayland *xwayland = static_cast<Xwl::Xwayland *>(kwinApp()->xwayland());
+    xwayland->xwaylandLauncher()->process()->kill();
+    QVERIFY(x11ConnectionChangedSpy.wait());
+    QTRY_VERIFY(!x11Window);
+    c.reset();
+
+    workspace()->activateWindow(windowA);
+    QTRY_COMPARE(workspace()->activeWindow(), windowA);
+    QTRY_COMPARE(heldOpacity(m_translucencyEffect, windowA->caption()), 100);
+    QTRY_COMPARE(heldOpacity(m_translucencyEffect, windowB->caption()), 91);
+
+    workspace()->activateWindow(windowB);
+    QTRY_COMPARE(workspace()->activeWindow(), windowB);
+    QTRY_COMPARE(heldOpacity(m_translucencyEffect, windowB->caption()), 100);
+    QTRY_COMPARE(heldOpacity(m_translucencyEffect, windowA->caption()), 91);
+}
+
+WAYLANDTEST_MAIN(TranslucencyXwaylandTest)
+#include "translucency_xwayland_test.moc"
