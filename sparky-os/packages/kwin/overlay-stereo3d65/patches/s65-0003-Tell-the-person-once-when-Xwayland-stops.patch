+#include <QTime>
 #include <QDataStream>
 #include <QDir>
 #include <QFile>
@@ -390,6 +393,16 @@ void Xwayland::dispatchEvents(DispatchEventsMode mode)
     const int connectionError = xcb_connection_has_error(connection);
     if (connectionError) {
         qCWarning(KWIN_XWL, "The X11 connection broke (error %d)", connectionError);
+        // Xwayland went away: the person is told once which X11 programs closed with it, before they are released
+        QStringList programs;
+        for (Window *window : workspace()->windows()) {
+            auto x11Window = qobject_cast<X11Window *>(window);
+            if (x11Window && x11Window->isClient() && !x11Window->isDeleted() && !x11Window->resourceClass().isEmpty()
+                && !programs.contains(x11Window->resourceClass())) {
+                programs.append(x11Window->resourceClass());
+            }
+        }
+        setXwaylandStoppedNotice(QTime::currentTime().toString(QStringLiteral("HH:mm:ss")), programs);
         m_launcher->stop();
         return;
     }
