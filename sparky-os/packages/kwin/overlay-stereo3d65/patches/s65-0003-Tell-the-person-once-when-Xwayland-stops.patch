+ */
+KWIN_EXPORT void setXwaylandStoppedNotice(const QString &time, const QStringList &programs);
+/**
+ * Ends the notice of an earlier session.
+ */
+KWIN_EXPORT void clearXwaylandStoppedNotice();
 }
