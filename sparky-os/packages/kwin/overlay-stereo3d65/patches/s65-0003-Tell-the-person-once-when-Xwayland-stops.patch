 #include "utils/xcbutils.h"
 #include "wayland/display.h"
 #include "wayland_server.h"
 #include "waylandwindow.h"
 #include "workspace.h"
 #include "x11eventfilter.h"
+#include "x11window.h"
 #include "xkb.h"
 #include "xwayland_logging.h"
 
@@ -38,6 +40,7 @@
 #include <wayland/surface.h>
 
 #include <QAbstractEventDispatcher>
+#include <QTime>
 #include <QDataStream>
 #include <QDir>
 #include <QFile>
@@ -364,6 +367,8 @@ Xwayland::~Xwayland()
 
 void Xwayland::init()
 {
+    // a notice that Xwayland stopped belongs to the session it happened in
+    clearXwaylandStoppedNotice();
     m_launcher->enable();
 
     auto env = m_app->processStartupEnvironment();
@@ -390,6 +395,16 @@ void Xwayland::dispatchEvents(DispatchEventsMode mode)
     const int connectionError = xcb_connection_has_error(connection);
     if (connectionError) {
         qCWarning(KWIN_XWL, "The X11 connection broke (error %d)", connectionError);
+        // Xwayland went away: the person is told once which X11 programs closed with it, before they are released
+        QStringList programs;
+        for (Window *window : workspace()->windows()) {
+            auto x11Window = qobject_cast<X11Window *>(window);
+            if (x11Window && x11Window->isClient() && !x11Window->isDeleted() && !x11Window->resourceClass().isEmpty()
+                && !programs.contains(x11Window->resourceClass())) {
+                programs.append(x11Window->resourceClass());
+            }
+        }
+        setXwaylandStoppedNotice(QTime::currentTime().toString(QStringLiteral("HH:mm")), programs);
         m_launcher->stop();
         return;
     }
