 KWIN_EXPORT void setStereoReplicaConfigurationProblem(BackendOutput *output, std::optional<StereoReplicaFailure> failure, const QString &identity);
+
+/**
+ * Tells the person, through the edition's problems engine, that Xwayland stopped and the X11 @p programs on it were
