+QDBusPendingReply<> NetworkManager::setConnectivityCheckEnabled(bool enabled)
+{
+    auto message = QDBusMessage::createMethodCall(NetworkManagerPrivate::DBUS_SERVICE,
+                                                 NetworkManagerPrivate::DBUS_DAEMON_PATH,
+                                                 NetworkManagerPrivate::FDO_DBUS_PROPERTIES,
+                                                 QStringLiteral("Set"));
+    message << NetworkManagerPrivate::DBUS_DAEMON_INTERFACE << QStringLiteral("ConnectivityCheckEnabled")
+            << QVariant::fromValue(QDBusVariant(enabled));
+    return QDBusConnection::systemBus().asyncCall(message);
+}
+
 bool NetworkManager::isConnectivityCheckEnabled()
 {
     return globalNetworkManager->isConnectivityCheckEnabled();
