diff --git a/libs/qCC_glWindow/src/ccGLWindowDepthLimits.cpp b/libs/qCC_glWindow/src/ccGLWindowDepthLimits.cpp
new file mode 100644
index 0000000..fab838c
--- /dev/null
+++ b/libs/qCC_glWindow/src/ccGLWindowDepthLimits.cpp
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "ccGLWindowDepthLimits.h"
+
+#ifdef CC_WITH_STEREO_DECLARE
+#include <QX11Info>
+#include <cerrno>
+#include <stereo-declare.h>
+#endif
+
+int ccDepthLimits::readX11(unsigned long window, double bufferWidth, double& sunk, double& popped)
+{
+#ifdef CC_WITH_STEREO_DECLARE
+	if (!QX11Info::isPlatformX11())
+	{
+		return 3;
+	}
+	stereo_depth_limits limits;
+	const int r = stereo_depth_x11_get_buffer_limits(QX11Info::display(), static_cast<Window>(window), bufferWidth, bufferWidth, &limits);
+	if (r == 0)
+	{
+		sunk = limits.sunk;
+		popped = limits.popped;
+		return 0;
+	}
+	// never zeros, never a guess: not delivered yet, or not offered (an older compositor, or the window is not declared)
+	return (r == -ENODATA ? 2 : 1);
+#else
+	(void)window;
+	(void)bufferWidth;
+	(void)sunk;
+	(void)popped;
+	return 3;
+#endif
+}
diff --git a/libs/qCC_glWindow/src/ccGLWindowInterface.cpp b/libs/qCC_glWindow/src/ccGLWindowInterface.cpp
