+bool ccGLWindowInterface::pollDepthLimits()
+{
+	DepthLimitsState state = DepthLimitsState::Unused;
+	double sunk = 0.0;
+	double popped = 0.0;
+	if (m_stereoModeEnabled)
+	{
+		switch (readDepthLimits(sunk, popped))
+		{
+		case 0:
+			state = DepthLimitsState::Delivered;
+			break;
+		case 1:
+			state = DepthLimitsState::NotOffered;
+			sunk = popped = 0.0;
+			break;
+		case 2:
+			state = DepthLimitsState::NotDelivered;
+			sunk = popped = 0.0;
+			break;
+		default:
+			state = DepthLimitsState::NotReadable;
+			sunk = popped = 0.0;
+			break;
+		}
+	}
+	const bool changed = (state != m_depthLimitsState || sunk != m_depthSunk || popped != m_depthPopped);
+	m_depthLimitsState = state;
+	m_depthSunk = sunk;
+	m_depthPopped = popped;
+	return changed;
+}
