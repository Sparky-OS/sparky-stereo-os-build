--- /dev/null
+++ b/libs/qCC_glWindow/include/ccGLWindowDepthLimits.h
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The person's depth limits of an X11 window (Sparky Stereo OS), read through libstereo-declare 1.10. Its own file: the X11 headers
+// define macros (None, Status, Bool...) that break Qt's headers when they come first.
+#ifndef CC_GL_WINDOW_DEPTH_LIMITS_H
+#define CC_GL_WINDOW_DEPTH_LIMITS_H
+
+namespace ccDepthLimits
+{
+//! Reads the depth limits of the X11 window in the pixels of its buffer (libstereo-declare 1.11: the desktop's limits, pixels of a view 1920 wide
+//! of the screen, times the output's width over 1920; the window is shown as it is drawn): 0 delivered, 1 not offered, 2 not delivered yet, 3 not readable
+int readX11(unsigned long window, double bufferWidth, double& sunk, double& popped);
+}
+
+#endif
