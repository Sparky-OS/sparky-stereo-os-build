 private:
     QTemporaryDir mBin;
+    QString mModelPath;
+
+    // Vibe's own store: the model selected there and, when LANGUAGE is not null, the language set there
+    // (built as JSON objects: moc counts braces inside raw string literals and then finds no class here)
+    QByteArray vibeStore(const QByteArray &language) const
+    {
+        QJsonObject store{{u"model.path"_s, mModelPath}, {u"analytics_enabled"_s, false}};
+        if (!language.isNull()) {
+            store.insert(u"transcription.modelOptions"_s, QJsonObject{{u"lang"_s, QString::fromUtf8(language)}});
+        }
+        return QJsonDocument(store).toJson(QJsonDocument::Compact);
+    }
+
+    static QString storeFile()
+    {
+        return QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + "/github.com.thewh1teagle.vibe/app_config.json"_L1;
+    }
+
+    static bool writeFile(const QString &path, const QByteArray &data)
+    {
+        QFile file(path);
+        return file.open(QIODevice::WriteOnly | QIODevice::Truncate) && file.write(data) == data.size();
+    }
 
     static QByteArray tone()
     {
@@ -101,7 +127,8 @@ private Q_SLOTS:
