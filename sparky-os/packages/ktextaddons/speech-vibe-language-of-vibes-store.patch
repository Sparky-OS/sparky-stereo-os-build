         config.close();
         qputenv("PATH", (mBin.path() + ":/usr/bin:/bin"_L1).toLocal8Bit());
         QCoreApplication::setLibraryPaths({QStringLiteral(PLUGIN_BUILD_ROOT)});
@@ -201,6 +228,49 @@ private Q_SLOTS:
         QVERIFY(done.wait(20000));
         QCOMPARE(done.at(0).at(0).toString(), u"Text from the stand-in server."_s);
     }
+
+    // the language Vibe's store names goes to the server; with none, or automatic, the server's model chooses it and
+    // transcribes. The stand-in answers detect_language=true with an empty text, as Vibe 3.3.5's server does.
+    void shouldTranscribeInTheLanguageOfVibesStore_data()
+    {
+        QTest::addColumn<QByteArray>("language");
+        QTest::addColumn<QString>("sent");
+        QTest::newRow("no language in Vibe") << QByteArray() << QString();
+        QTest::newRow("automatic in Vibe") << QByteArray("auto") << QString();
+        QTest::newRow("Portuguese in Vibe") << QByteArray("pt") << u"pt"_s;
+    }
+
+    void shouldTranscribeInTheLanguageOfVibesStore()
+    {
+        QFETCH(QByteArray, language);
+        QFETCH(QString, sent);
+        // the engine reads Vibe's store at every dictation: this case's store stays until the case ends
+        QVERIFY(writeFile(storeFile(), vibeStore(language)));
+        const auto restore = qScopeGuard([this]() {
+            writeFile(storeFile(), vibeStore(QByteArray()));
+        });
+        QTemporaryDir record;
+        standin(u"ok"_s, record.path());
+        std::unique_ptr<TextSpeechToText::SpeechToTextPlugin> plugin(vibe());
+        QVERIFY(plugin);
+        QSignalSpy done(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextDone);
+        QSignalSpy failed(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextFailed);
+        plugin->speechToText();
+        speak(plugin.get());
+        QTRY_VERIFY_WITH_TIMEOUT(serverRunning(record.path()), 10000);
+        plugin->stop();
+        QTRY_VERIFY_WITH_TIMEOUT(done.count() + failed.count() > 0, 20000);
+        QVERIFY2(failed.isEmpty(), failed.isEmpty() ? "" : qPrintable(failed.at(0).at(0).toString()));
+        QCOMPARE(done.at(0).at(0).toString(), u"Text from the stand-in server."_s);
+        const QByteArray request = readFile(record.filePath(u"request.json"_s));
+        QVERIFY2(!request.contains("\"detect_language\""), request.constData());
+        if (sent.isEmpty()) {
+            QVERIFY2(!request.contains("\"language\""), request.constData());
+        } else {
+            const QByteArray field = QByteArray("\"language\": \"") + sent.toUtf8() + QByteArray("\"");
+            QVERIFY2(request.contains(field), request.constData());
+        }
+    }
 };
 
