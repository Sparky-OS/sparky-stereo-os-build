 #include <QUrl>
 
+namespace
+{
+// Sparky Stereo OS: the local engine is turned on in System Settings, Partners (its user service, on the card the person
+// chose), never started by a program behind that switch
+bool partnersPage()
+{
+    return !QStandardPaths::findExecutable(QStringLiteral("sparky-stereo-partners")).isEmpty();
+}
+
+void openPartnersPage()
+{
+    QProcess::startDetached(QStringLiteral("systemsettings"), {QStringLiteral("kcm_sparkystereo_partners")});
+}
+}
