+
+#include <optional>
 
 using namespace Qt::Literals::StringLiterals;
 using namespace TextAutoGenerateText;
+
+namespace
+{
+// Sparky Stereo OS: the Partners page in System Settings keeps one system default for text, and a program's own choice beside
+// it; its command answers who that is (sparky-stereo-partners resolve). Read only when the person has set up no instance here.
+struct PartnersChoice {
+    QString kind; // the interface's protocol: "ollama", "openai-compatible", ...
+    QString name;
+    QString url;
+    QString model;
+};
+
+std::optional<PartnersChoice> partnersTextChoice()
+{
+    const QString command = QStandardPaths::findExecutable(u"sparky-stereo-partners"_s);
+    if (command.isEmpty()) {
+        return std::nullopt;
+    }
+    QString program = QGuiApplication::desktopFileName();
+    if (program.isEmpty()) {
+        program = KAboutData::applicationData().desktopFileName();
+    }
+    QStringList arguments{u"resolve"_s, u"--kind"_s, u"text"_s};
+    if (!program.isEmpty()) {
+        arguments << u"--program"_s << program;
+    }
+    QProcess process;
+    process.start(command, arguments);
+    if (!process.waitForFinished(10000)) {
+        qCWarning(TEXTAUTOGENERATETEXT_CORE_LOG) << "Partners: sparky-stereo-partners did not answer" << process.errorString();
+        process.kill();
+        return std::nullopt;
+    }
+    // it answers with its lines also when no model is chosen yet (status 1) or the card cannot be used now (4)
+    PartnersChoice choice;
+    const QStringList lines = QString::fromUtf8(process.readAllStandardOutput()).split(u'\n');
+    for (const QString &line : lines) {
+        const qsizetype eq = line.indexOf(u'=');
+        if (eq < 0) {
+            continue;
+        }
+        const QString key = line.left(eq);
+        const QString value = line.mid(eq + 1);
+        if (key == u"PARTNER_KIND"_s) {
+            choice.kind = value;
+        } else if (key == u"PARTNER_NAME"_s) {
+            choice.name = value;
+        } else if (key == u"PARTNER_URL"_s) {
+            choice.url = value;
+        } else if (key == u"PARTNER_MODEL"_s) {
+            choice.model = value;
+        }
+    }
+    return choice;
+}
+}
 TextAutoGenerateTextInstancesManager::TextAutoGenerateTextInstancesManager(TextAutoGenerateManager *manager, QObject *parent)
     : QObject{parent}
     , mTextAutoGenerateTextInstanceModel(new TextAutoGenerateTextInstanceModel(this))
@@ -46,7 +110,46 @@
     mTextAutoGenerateEngineLoader->loadPlugins();
     const QStringList instancesList = TextAutoGenerateTextUtils::instancesList(config);
     if (instancesList.isEmpty()) {
-        return; // nothing to be done...
+        // Sparky Stereo OS: no instance of the person's own, so the Partners page's choice answers, while it lasts: nothing
+        // is written here until the person changes this instance's settings, which makes it theirs
+        const auto partners = partnersTextChoice();
+        if (!partners) {
+            return; // nothing to be done...
+        }
+        if (partners->kind != u"ollama"_s || partners->url.isEmpty()) {
+            // said on the Partners page too: these add-ons reach only Ollama for now
+            qCInfo(TEXTAUTOGENERATETEXT_CORE_LOG) << "Partners: the text choice is" << partners->name << partners->kind
+                                                  << "which these add-ons cannot use; set up an instance of your own";
+            return;
+        }
+        auto client = mTextAutoGenerateEngineLoader->searchTextAutoGenerateTextClient(u"ollama"_s);
+        if (!client) {
+            qCWarning(TEXTAUTOGENERATETEXT_CORE_LOG) << "Partners: the Ollama add-on is not installed";
+            return;
+        }
+        KConfig memory(QString(), KConfig::SimpleConfig);
+        KConfigGroup group(&memory, u"Instance #0"_s);
+        group.writeEntry("enabled", true);
+        group.writeEntry("pluginName", u"ollama"_s);
+        group.writeEntry("pluginIdentifier", u"ollama"_s);
+        group.writeEntry("uuid", QByteArray("sparky-stereo-partners-text"));
+        group.writeEntry(u"Name"_s, partners->name);
+        group.writeEntry(u"ServerUrl"_s, QUrl(partners->url));
+        group.writeEntry(u"CurrentModel"_s, partners->model);
+        auto inst = new TextAutoGenerateTextInstance;
+        inst->load(group);
+        auto plugin = client->createTextAutoGeneratePlugin(mManager, inst);
+        if (!plugin) {
+            qCWarning(TEXTAUTOGENERATETEXT_CORE_LOG) << "Partners: the Ollama add-on could not be created";
+            delete inst;
+            return;
+        }
+        plugin->load(group);
+        connect(plugin, &TextAutoGenerateTextPlugin::configChanged, this, &TextAutoGenerateTextInstancesManager::saveInstances);
+        inst->setPlugin(plugin);
+        setInstances({inst});
+        setCurrentinstance(inst->instanceUuid());
+        return;
     }
 
     QList<TextAutoGenerateTextInstance *> lstInstances;
