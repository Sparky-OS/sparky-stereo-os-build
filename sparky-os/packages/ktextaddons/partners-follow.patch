@@ -10,11 +10,75 @@
 #include "core/textautogeneratetextplugin.h"
 #include "textautogeneratetextcore_debug.h"
 #include "textautogeneratetextutils.h"
+#include <KAboutData>
+#include <KConfig>
 #include <KConfigGroup>
 #include <KSharedConfig>
+#include <QGuiApplication>
+#include <QProcess>
