diff --git a/po/pt_BR/libtextspeechtotext.po b/po/pt_BR/libtextspeechtotext.po
index f1bbd27..ed2109a 100644
--- a/po/pt_BR/libtextspeechtotext.po
+++ b/po/pt_BR/libtextspeechtotext.po
@@ -251,3 +251,39 @@ msgstr ""
 #, kde-format
 msgid "The microphone could not be opened for dictation."
 msgstr "Não foi possível abrir o microfone para o ditado."
+
+#: speechtotext/speechtotextengineloader.cpp
+#, kde-format
+msgid ""
+"The %1 speech-to-text engine is not available in this version: choose "
+"another engine in the speech-to-text settings."
+msgstr ""
+"O mecanismo de fala para texto %1 não está disponível nesta versão: escolha "
+"outro mecanismo nas configurações de fala para texto."
+
+#: speechtotext/speechtotextengineloader.cpp
+#, kde-format
+msgid ""
+"The %1 speech-to-text engine needs %2, which is not installed: install it, or "
+"choose another engine in the speech-to-text settings."
+msgstr ""
+"O mecanismo de fala para texto %1 precisa do %2, que não está instalado: "
+"instale-o ou escolha outro mecanismo nas configurações de fala para texto."
+
+#: speechtotext/speechtotextengineloader.cpp
+#, kde-format
+msgid ""
+"The speech-to-text engine %1 is not installed: install it, or choose another "
+"engine in the speech-to-text settings."
+msgstr ""
+"O mecanismo de fala para texto %1 não está instalado: instale-o ou escolha "
+"outro mecanismo nas configurações de fala para texto."
+
+#: speechtotext/plugins/vibe/vibespeechtotextplugin.cpp
+#, kde-format
+msgid ""
+"Vibe is still transcribing your previous dictation: wait for its text, then "
+"start again."
+msgstr ""
+"O Vibe ainda está transcrevendo o seu ditado anterior: aguarde o texto dele e "
+"depois comece de novo."
