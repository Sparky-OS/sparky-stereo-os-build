+
+// The Vibe engine as a program gets it, through the library's loader and the plugin interface only: when its server
+// runs, how soon the text comes, and what is said. It uses no class of the engine itself, so it runs against any build.
+#include <QDir>
+#include <QElapsedTimer>
+#include <QFile>
+#include <QSignalSpy>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <QTest>
+#include <QtEndian>
+#include <TextSpeechToText/SpeechToTextClient>
+#include <TextSpeechToText/SpeechToTextEngineLoader>
+#include <TextSpeechToText/SpeechToTextPlugin>
+#include <cmath>
+
+using namespace Qt::Literals::StringLiterals;
+
+class VibeSpeechToTextPluginTest : public QObject
+{
+    Q_OBJECT
+private:
+    QTemporaryDir mBin;
+
+    static QByteArray tone()
+    {
+        QByteArray pcm;
+        for (int i = 0; i < 16000; ++i) {
+            const auto sample = static_cast<qint16>(8000 * std::sin(2 * M_PI * 440 * i / 16000.0));
+            char bytes[2];
+            qToLittleEndian(sample, bytes);
+            pcm.append(bytes, 2);
+        }
+        return pcm;
+    }
+
+    static QByteArray readFile(const QString &path)
+    {
+        QFile file(path);
+        return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+    }
+
+    static bool serverRunning(const QString &record)
+    {
+        const QByteArray pid = readFile(record + "/pid"_L1);
+        return !pid.isEmpty() && QFile::exists("/proc/"_L1 + QString::fromLatin1(pid));
+    }
+
+    static bool serverGone(const QString &record)
+    {
+        const QByteArray pid = readFile(record + "/pid"_L1);
+        return !pid.isEmpty() && !QFile::exists("/proc/"_L1 + QString::fromLatin1(pid));
+    }
+
+    // the stand-in reads these from the environment the engine gives vibe-server
+    static void standin(const QString &mode, const QString &record, const char *loadSeconds = "0", const char *answerSeconds = "0")
+    {
+        qputenv("STANDIN_MODE", mode.toUtf8());
+        qputenv("STANDIN_RECORD", record.toUtf8());
+        qputenv("STANDIN_LOAD_SECONDS", loadSeconds);
+        qputenv("STANDIN_ANSWER_SECONDS", answerSeconds);
+    }
+
+    static TextSpeechToText::SpeechToTextPlugin *vibe()
+    {
+        auto client = TextSpeechToText::SpeechToTextEngineLoader::self()->createSpeechToTextClient(u"vibe"_s);
+        if (!client) {
+            return nullptr;
+        }
+        auto plugin = client->createTextToSpeech();
+        return plugin && plugin->loadSettings() ? plugin : nullptr;
+    }
+
+    // the person speaks for a while: what the microphone gives goes into the engine's device
+    static void speak(TextSpeechToText::SpeechToTextPlugin *plugin)
+    {
+        if (QIODevice *device = plugin->audioDevice(); device && device->isOpen()) {
+            device->write(tone());
+        }
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        QVERIFY(mBin.isValid());
+        const QString program = mBin.filePath(u"vibe-server"_s);
+        QVERIFY(QFile::copy(QFINDTESTDATA("data/vibe-server-standin.py"), program));
+        QVERIFY(QFile::setPermissions(program, QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+        QFile model(mBin.filePath(u"model.bin"_s));
+        QVERIFY(model.open(QIODevice::WriteOnly));
+        model.write("not a real model");
+        model.close();
+        // the model selected in Vibe, in Vibe's own store
+        const QString store = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + "/github.com.thewh1teagle.vibe"_L1;
+        QVERIFY(QDir().mkpath(store));
+        QFile config(store + "/app_config.json"_L1);
+        QVERIFY(config.open(QIODevice::WriteOnly));
+        config.write(R"({"model.path": ")" + model.fileName().toUtf8() + R"(", "analytics_enabled": false})");
+        config.close();
+        qputenv("PATH", (mBin.path() + ":/usr/bin:/bin"_L1).toLocal8Bit());
+        QCoreApplication::setLibraryPaths({QStringLiteral(PLUGIN_BUILD_ROOT)});
+        QVERIFY(TextSpeechToText::SpeechToTextEngineLoader::self()->speechToTextEngineInfos().contains(u"vibe"_s));
+    }
+
+    // the server is up while the person is still speaking, and gone when the text is in
+    void shouldRunTheServerDuringTheRecording()
+    {
+        QTemporaryDir record;
+        standin(u"ok"_s, record.path());
+        std::unique_ptr<TextSpeechToText::SpeechToTextPlugin> plugin(vibe());
+        QVERIFY(plugin);
+        QSignalSpy done(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextDone);
+        bool goneWhenDone = false;
+        connect(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextDone, this, [&goneWhenDone, &record]() {
+            goneWhenDone = serverGone(record.path());
+        });
+        plugin->speechToText();
+        speak(plugin.get());
+        QTRY_VERIFY_WITH_TIMEOUT(serverRunning(record.path()), 10000);
+        QVERIFY(!QFile::exists(record.filePath(u"request"_s)));
+        plugin->stop();
+        QVERIFY(done.wait(20000));
+        QCOMPARE(done.at(0).at(0).toString(), u"Text from the stand-in server."_s);
+        QVERIFY(goneWhenDone);
+    }
+
+    // a model that takes 2 s to load, a person who speaks for 4 s: the text comes without waiting for the load
+    void shouldAnswerWithoutWaitingForTheModelLoad()
+    {
+        QTemporaryDir record;
+        standin(u"ok"_s, record.path(), "2");
+        std::unique_ptr<TextSpeechToText::SpeechToTextPlugin> plugin(vibe());
+        QVERIFY(plugin);
+        QSignalSpy done(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextDone);
+        plugin->speechToText();
+        speak(plugin.get());
+        QTest::qWait(4000);
+        QElapsedTimer waited;
+        waited.start();
+        plugin->stop();
+        QVERIFY(done.wait(20000));
+        const qint64 elapsed = waited.elapsed();
+        qInfo() << "from the end of the recording to the text:" << elapsed << "ms (model load 2000 ms)";
+        QVERIFY2(elapsed < 1500, qPrintable(QString::number(elapsed)));
+    }
+
+    // a model that does not load is said while the person still speaks, and the server is gone
+    void shouldSayAFailureWhileThePersonStillSpeaks()
+    {
+        QTemporaryDir record;
+        standin(u"noload"_s, record.path(), "1");
+        std::unique_ptr<TextSpeechToText::SpeechToTextPlugin> plugin(vibe());
+        QVERIFY(plugin);
+        QSignalSpy failed(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextFailed);
+        plugin->speechToText();
+        speak(plugin.get());
+        QVERIFY(failed.wait(10000)); // stop() was never called
+        QVERIFY2(failed.at(0).at(0).toString().startsWith(u"Vibe could not load the speech model model.bin: "_s), qPrintable(failed.at(0).at(0).toString()));
+        QVERIFY(serverGone(record.path()));
+    }
+
+    // a dictation dropped before its end (the engine's plugin deleted: cancelled, the program closing) ends its server
+    void shouldStopTheServerWhenTheDictationIsDropped()
+    {
+        QTemporaryDir record;
+        standin(u"ok"_s, record.path());
+        auto plugin = vibe();
+        QVERIFY(plugin);
+        plugin->speechToText();
+        speak(plugin);
+        QTRY_VERIFY_WITH_TIMEOUT(serverRunning(record.path()), 10000);
+        delete plugin;
+        QTRY_VERIFY_WITH_TIMEOUT(serverGone(record.path()), 7000);
+        QVERIFY(QFile::exists(record.filePath(u"terminated"_s)));
+        QVERIFY(!QFile::exists(record.filePath(u"request"_s)));
+    }
+
+    // one server and one model in memory: a second dictation while the first is transcribed waits and says so
+    void shouldSayThatTheEarlierDictationIsStillTranscribed()
+    {
+        QTemporaryDir record;
+        standin(u"ok"_s, record.path(), "0", "3");
+        std::unique_ptr<TextSpeechToText::SpeechToTextPlugin> plugin(vibe());
+        QVERIFY(plugin);
+        QSignalSpy done(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextDone);
+        QSignalSpy failed(plugin.get(), &TextSpeechToText::SpeechToTextPlugin::speechToTextFailed);
+        plugin->speechToText();
+        speak(plugin.get());
+        QTRY_VERIFY_WITH_TIMEOUT(serverRunning(record.path()), 10000);
+        plugin->stop();
+        QTRY_VERIFY_WITH_TIMEOUT(QFile::exists(record.filePath(u"request"_s)), 10000);
+        plugin->speechToText();
+        QCOMPARE(failed.count(), 1);
+        QCOMPARE(failed.at(0).at(0).toString(), u"Vibe is still transcribing your previous dictation: wait for its text, then start again."_s);
+        QVERIFY(done.wait(20000));
+        QCOMPARE(done.at(0).at(0).toString(), u"Text from the stand-in server."_s);
+    }
+};
+
+QTEST_GUILESS_MAIN(VibeSpeechToTextPluginTest)
+#include "vibespeechtotextplugintest.moc"
