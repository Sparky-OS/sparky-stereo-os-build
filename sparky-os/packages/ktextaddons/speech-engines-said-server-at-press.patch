+void SpeechToTextConfigureWidget::updateEngineMessage(const QString &engineName)
+{
+    QString reason;
+    if (engineName == TextSpeechToTextUtil::engineTurnedOffName()) {
+        reason = i18n("Dictation is off: no partner takes speech in System Settings, Partners.");
+    } else if (!engineName.isEmpty()) {
+        reason = SpeechToTextEngineLoader::self()->engineNotReadyReason(engineName);
+    }
+    mEngineMessage->setText(reason);
