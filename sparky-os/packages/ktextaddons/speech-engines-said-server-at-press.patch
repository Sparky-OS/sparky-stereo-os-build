+    {
+        KConfigGroup group(KSharedConfig::openConfig(), u"SpeechToText"_s);
+        group.writeEntry("engine", u"vibe"_s);
+        group.sync();
+        TextSpeechToText::SpeechToTextConfigureWidget w;
+        w.loadSettings();
+        auto text = w.findChild<KMessageWidget *>(u"mEngineMessage"_s);
+        QVERIFY2(text, "the settings have no place to say why");
+        QVERIFY(!text->isHidden());
+        QCOMPARE(text->text(),
