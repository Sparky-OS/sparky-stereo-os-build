+        auto text = w.findChild<KMessageWidget *>(u"mEngineMessage"_s);
+        QVERIFY2(text, "the settings have no place to say why");
+        // the person picks the engine in the list
+        combo->setCurrentIndex(combo->findData(engine == u"whisper"_s ? u"google"_s : u"whisper"_s));
+        combo->setCurrentIndex(combo->findData(engine));
+        QVERIFY(!text->isHidden());
+        QCOMPARE(text->text(), message);
+    }
