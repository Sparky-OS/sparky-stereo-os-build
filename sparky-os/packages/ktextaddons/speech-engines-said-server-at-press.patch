+
+// What a program hears from KDE's speech-to-text manager when the engine chosen cannot take a dictation, through the
+// public interface only. EXPECT_VIBE says whether vibe-server is on PATH; the loader is one per process, so each
+// case of the two is its own test program.
+#include <QAudioDevice>
+#include <QDir>
+#include <QFile>
+#include <QMediaDevices>
+#include <QRegularExpression>
+#include <QSignalSpy>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <QTest>
+#include <TextSpeechToText/SpeechToTextEngineLoader>
+#include <TextSpeechToText/SpeechToTextManager>
+
+using namespace Qt::Literals::StringLiterals;
+using TextSpeechToText::SpeechToTextManager;
+
+// the process number of the last vibe-server the engine started, from its own log line
+static QString s_serverProcess;
+static QtMessageHandler s_previousHandler = nullptr;
+static void readServerProcess(QtMsgType type, const QMessageLogContext &context, const QString &message)
+{
+    static const QRegularExpression started(u"vibe-server started, process (\\d+)"_s);
+    if (const auto match = started.match(message); match.hasMatch()) {
+        s_serverProcess = match.captured(1);
+    }
+    if (s_previousHandler) {
+        s_previousHandler(type, context, message);
+    }
+}
+
+class SpeechToTextManagerTest : public QObject
+{
+    Q_OBJECT
+private:
+    QTemporaryDir mBin;
+
+    // the sentence the program gets for a dictation it asks for now, and whether recording started
+    QString dictate()
+    {
+        QSignalSpy failed(SpeechToTextManager::self(), &SpeechToTextManager::speechToTextFailedFor);
+        SpeechToTextManager::self()->speechToText(this);
+        const bool recording = SpeechToTextManager::self()->isRecording();
+        SpeechToTextManager::self()->stop();
+        if (recording) {
+            return u"(recording started)"_s;
+        }
+        return failed.isEmpty() ? QString() : failed.at(0).at(1).toString();
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        QVERIFY(mBin.isValid());
+        s_previousHandler = qInstallMessageHandler(readServerProcess);
+        if (EXPECT_VIBE) {
+            const QString program = mBin.filePath(u"vibe-server"_s);
+            QVERIFY(QFile::copy(QFINDTESTDATA("data/vibe-server-standin.py"), program));
+            QVERIFY(QFile::setPermissions(program, QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+        }
+        QFile model(mBin.filePath(u"model.bin"_s));
+        QVERIFY(model.open(QIODevice::WriteOnly));
+        model.write("not a real model");
+        model.close();
+        const QString store = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + "/github.com.thewh1teagle.vibe"_L1;
+        QVERIFY(QDir().mkpath(store));
+        QFile config(store + "/app_config.json"_L1);
+        QVERIFY(config.open(QIODevice::WriteOnly));
+        config.write(R"({"model.path": ")" + model.fileName().toUtf8() + R"(", "analytics_enabled": false})");
+        config.close();
+        // vibe-server is in this folder or nowhere; no Partners command
+        qputenv("PATH", (mBin.path() + ":/usr/bin:/bin"_L1).toLocal8Bit());
+        QCoreApplication::setLibraryPaths({QStringLiteral(PLUGIN_BUILD_ROOT)});
+        const auto engines = TextSpeechToText::SpeechToTextEngineLoader::self()->speechToTextEngineInfos();
+        QVERIFY(engines.contains(u"google"_s));
+        QVERIFY(engines.contains(u"whisper"_s));
+        QCOMPARE(engines.contains(u"vibe"_s), bool(EXPECT_VIBE));
+    }
+
+    // an engine chosen that is not installed is said, and no other engine is taken in its place
+    void shouldSayTheChosenEngineIsMissing()
+    {
+        SpeechToTextManager::self()->switchEngine(u"nosuchengine"_s);
+        QVERIFY(!SpeechToTextManager::self()->isReady());
+        QCOMPARE(dictate(), u"The speech-to-text engine nosuchengine is not installed: install it, or choose another engine in the speech-to-text settings."_s);
+        QVERIFY(!SpeechToTextManager::self()->isReady());
+    }
+
+    void shouldNameTheMissingProgram()
+    {
+        if (EXPECT_VIBE) {
+            QSKIP("vibe-server is installed in this case");
+        }
+        SpeechToTextManager::self()->switchEngine(u"vibe"_s);
+        QCOMPARE(dictate(), u"The Vibe speech-to-text engine needs vibe-server, which is not installed: install it, or choose another engine in the speech-to-text settings."_s);
+    }
+
+    // the engines this version only lists say so when a dictation is asked of them
+    void shouldSayTheEngineIsNotAvailable_data()
+    {
+        QTest::addColumn<QString>("engine");
+        QTest::addColumn<QString>("message");
+        QTest::newRow("whisper") << u"whisper"_s
+                                 << u"The Whisper speech-to-text engine is not available in this version: choose another engine in the speech-to-text settings."_s;
+        QTest::newRow("google") << u"google"_s
+                                << u"The Google speech-to-text engine is not available in this version: choose another engine in the speech-to-text settings."_s;
+    }
+
+    void shouldSayTheEngineIsNotAvailable()
+    {
+        QFETCH(QString, engine);
+        QFETCH(QString, message);
+        SpeechToTextManager::self()->switchEngine(engine);
+        QCOMPARE(dictate(), message);
+    }
+
+    // with nothing chosen, the engine that can take a dictation is used: Vibe where it is installed
+    void shouldUseTheReadyEngineWhenNothingIsChosen()
+    {
+        SpeechToTextManager::self()->switchEngine(QString());
+        if (EXPECT_VIBE) {
+            QVERIFY(SpeechToTextManager::self()->isReady());
+        } else {
+            QCOMPARE(dictate(), u"No speech-to-text engine is ready for dictation: choose one in the speech-to-text settings."_s);
+        }
+    }
+
+    // a microphone that cannot be opened ends the dictation, and the server started at the press with it
+    void shouldStopTheServerWhenTheMicrophoneFails()
+    {
+        if (!EXPECT_VIBE) {
+            QSKIP("needs vibe-server");
+        }
+        if (!QMediaDevices::defaultAudioInput().isNull()) {
+            QSKIP("this computer has a microphone: the case needs one that cannot be opened");
+        }
+        QTemporaryDir record;
+        qputenv("STANDIN_MODE", "ok");
+        qputenv("STANDIN_RECORD", record.path().toUtf8());
+        SpeechToTextManager::self()->switchEngine(u"vibe"_s);
+        s_serverProcess.clear();
+        QCOMPARE(dictate(), u"The microphone could not be opened for dictation."_s);
+        QVERIFY2(!s_serverProcess.isEmpty(), "the server was not started at the press");
+        QTRY_VERIFY_WITH_TIMEOUT(!QFile::exists("/proc/"_L1 + s_serverProcess), 7000);
+    }
+};
+
+QTEST_GUILESS_MAIN(SpeechToTextManagerTest)
+#include "speechtotextmanagertest.moc"
