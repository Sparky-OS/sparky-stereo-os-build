--- /dev/null
+++ b/textspeechtotext/speechtotext/plugins/vibe/vibespeechtotextplugin.cpp
@@ -0,0 +1,76 @@
+/*
+  SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>
+
+  SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "vibespeechtotextplugin.h"
+#include "vibespeechtotextjob.h"
+
+#include <KLocalizedString>
+#include <QBuffer>
+#include <QStandardPaths>
+
+using namespace Qt::Literals::StringLiterals;
+
+VibeSpeechToTextPlugin::VibeSpeechToTextPlugin(QObject *parent)
+    : TextSpeechToText::SpeechToTextPlugin{parent}
+    , mAudio(new QBuffer(this))
+{
+}
+
+VibeSpeechToTextPlugin::~VibeSpeechToTextPlugin() = default;
+
+void VibeSpeechToTextPlugin::speechToText()
+{
+    // read again at every dictation: a model selected in Vibe or a choice changed in Partners applies at once
+    mSettings = VibeSpeechToTextSettings::load();
+    if (mSettings.serverProgram.isEmpty()) {
+        Q_EMIT speechToTextFailed(i18n("Vibe's speech engine did not start: %1", i18n("vibe-server is not installed.")));
+        return;
+    }
+    if (mSettings.modelPath.isEmpty()) {
+        // said before the person speaks, so nothing they say is lost; nothing is downloaded here
+        Q_EMIT speechToTextFailed(VibeSpeechToTextSettings::missingModelMessage(mSettings.recommendedModelHere()));
+        return;
+    }
+    clear();
+    mAudio->open(QIODevice::WriteOnly);
+}
+
+void VibeSpeechToTextPlugin::stop()
+{
+    mAudio->close();
+    const QByteArray pcm = mAudio->data();
+    clear();
+    auto job = new VibeSpeechToTextJob(this);
+    job->setSettings(mSettings);
+    job->setAudio(pcm, sampleRate());
+    connect(job, &VibeSpeechToTextJob::finished, this, &VibeSpeechToTextPlugin::speechToTextDone);
+    connect(job, &VibeSpeechToTextJob::failed, this, &VibeSpeechToTextPlugin::speechToTextFailed);
+    job->start();
+}
+
+int VibeSpeechToTextPlugin::sampleRate() const
+{
+    // whisper.cpp's models take 16 kHz mono, which vibe-server reads without converting
+    return 16000;
+}
+
+QIODevice *VibeSpeechToTextPlugin::audioDevice() const
+{
+    return mAudio;
+}
+
+bool VibeSpeechToTextPlugin::loadSettings()
+{
+    return !QStandardPaths::findExecutable(u"vibe-server"_s).isEmpty();
+}
+
