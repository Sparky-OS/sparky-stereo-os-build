diff --git a/textspeechtotext/speechtotext/plugins/vibe/vibespeechtotextjob.cpp b/textspeechtotext/speechtotext/plugins/vibe/vibespeechtotextjob.cpp
new file mode 100644
index 0000000..444a670
--- /dev/null
+++ b/textspeechtotext/speechtotext/plugins/vibe/vibespeechtotextjob.cpp
@@ -0,0 +1,260 @@
+/*
+  SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>
+
+  SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "vibespeechtotextjob.h"
+#include "speechtotext_vibe_debug.h"
+
+#include <KLocalizedString>
+#include <QFileInfo>
+#include <QHttpMultiPart>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkAccessManager>
+#include <QNetworkProxy>
+#include <QNetworkReply>
+#include <QTimer>
+#include <QtEndian>
+
+using namespace Qt::Literals::StringLiterals;
+
+namespace
+{
+void appendLE32(QByteArray &data, quint32 value)
+{
+    char bytes[4];
+    qToLittleEndian(value, bytes);
+    data.append(bytes, 4);
+}
+
+void appendLE16(QByteArray &data, quint16 value)
+{
+    char bytes[2];
+    qToLittleEndian(value, bytes);
+    data.append(bytes, 2);
+}
+
+QHttpPart formField(const QString &name, const QByteArray &value)
+{
+    QHttpPart part;
+    part.setHeader(QNetworkRequest::ContentDispositionHeader, QVariant(u"form-data; name=\"%1\""_s.arg(name)));
+    part.setBody(value);
+    return part;
+}
+}
+
+VibeSpeechToTextJob::VibeSpeechToTextJob(QObject *parent)
+    : QObject{parent}
+    , mNetwork(new QNetworkAccessManager(this))
+    , mReadyTimer(new QTimer(this))
+{
+    // the server is on this computer: never through a proxy
+    mNetwork->setProxy(QNetworkProxy::NoProxy);
+    mReadyTimer->setSingleShot(true);
+    connect(mReadyTimer, &QTimer::timeout, this, [this]() {
+        done(false, i18n("Vibe's speech engine did not start: %1", i18np("it did not answer within %1 second.", "it did not answer within %1 seconds.", mReadyTimeout / 1000)));
+    });
+}
+
+VibeSpeechToTextJob::~VibeSpeechToTextJob()
+{
+    stopServer();
+}
+
+void VibeSpeechToTextJob::setSettings(const VibeSpeechToTextSettings &settings)
+{
+    mSettings = settings;
+}
+
+void VibeSpeechToTextJob::setAudio(const QByteArray &pcm, int sampleRate)
+{
+    mPcm = pcm;
+    mSampleRate = sampleRate;
+}
+
+void VibeSpeechToTextJob::setReadyTimeout(int milliseconds)
+{
+    mReadyTimeout = milliseconds;
+}
+
+QByteArray VibeSpeechToTextJob::wavFile(const QByteArray &pcm, int sampleRate)
+{
+    QByteArray wav;
+    wav.reserve(44 + pcm.size());
+    wav.append("RIFF");
+    appendLE32(wav, 36 + pcm.size());
+    wav.append("WAVEfmt ");
+    appendLE32(wav, 16); // the size of the PCM format block
+    appendLE16(wav, 1); // PCM
+    appendLE16(wav, 1); // one channel
+    appendLE32(wav, sampleRate);
+    appendLE32(wav, sampleRate * 2); // bytes a second
+    appendLE16(wav, 2); // bytes a frame
+    appendLE16(wav, 16); // bits a sample
+    wav.append("data");
+    appendLE32(wav, pcm.size());
+    wav.append(pcm);
+    return wav;
+}
+
+void VibeSpeechToTextJob::start()
+{
+    if (mSettings.serverProgram.isEmpty()) {
+        done(false, i18n("Vibe's speech engine did not start: %1", i18n("vibe-server is not installed.")));
+        return;
+    }
+    if (mPcm.isEmpty()) {
+        done(false, i18n("Nothing was recorded from the microphone."));
+        return;
+    }
+    if (mSettings.modelPath.isEmpty()) {
+        done(false, VibeSpeechToTextSettings::missingModelMessage(mSettings.recommendedModelHere()));
+        return;
+    }
+    mServer = new QProcess(this);
+    mServer->setProcessEnvironment(mSettings.environment);
+    connect(mServer, &QProcess::readyReadStandardOutput, this, &VibeSpeechToTextJob::readServerOutput);
+    connect(mServer, &QProcess::readyReadStandardError, this, [this]() {
+        mServerErrors.append(mServer->readAllStandardError());
+    });
+    connect(mServer, &QProcess::finished, this, &VibeSpeechToTextJob::serverFinished);
+    connect(mServer, &QProcess::errorOccurred, this, &VibeSpeechToTextJob::serverError);
+    // port 0: the server takes a free port and says which in its ready line; it also ends with its parent
+    mServer->start(mSettings.serverProgram, {u"serve"_s, mSettings.modelPath, u"--host"_s, u"127.0.0.1"_s, u"--port"_s, u"0"_s});
+    mReadyTimer->start(mReadyTimeout);
+}
+
+void VibeSpeechToTextJob::readServerOutput()
+{
+    mServerOutput.append(mServer->readAllStandardOutput());
+    qsizetype end;
+    while (!mReady && (end = mServerOutput.indexOf('\n')) >= 0) {
+        const QByteArray line = mServerOutput.left(end).trimmed();
+        mServerOutput.remove(0, end + 1);
+        // {"status":"ready","port":N,"version":...,"commit":...}, printed once the model is loaded and the port is bound
+        const QJsonObject ready = QJsonDocument::fromJson(line).object();
+        const int port = ready.value("port"_L1).toInt();
+        if (ready.value("status"_L1).toString() == "ready"_L1 && port > 0 && port < 65536) {
+            mReady = true;
+            mReadyTimer->stop();
+            sendAudio(port);
+        }
+    }
+}
+
+QString VibeSpeechToTextJob::serverReason() const
+{
+    const QList<QByteArray> lines = mServerErrors.trimmed().split('\n');
+    for (auto it = lines.crbegin(); it != lines.crend(); ++it) {
+        if (const QString line = QString::fromUtf8(*it).trimmed(); !line.isEmpty()) {
+            return line;
+        }
+    }
+    return i18n("it stopped with status %1.", mServer ? mServer->exitCode() : -1);
+}
+
+void VibeSpeechToTextJob::serverFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    if (mDone) {
+        return;
+    }
+    qCWarning(SPEECHTOTEXT_VIBE_LOG) << "vibe-server stopped" << exitCode << exitStatus << mServerErrors.trimmed();
+    const QString reason = serverReason();
+    if (!mReady) {
+        // the model is loaded before the server answers, so a server that ends here with a model error could not load it
+        if (reason.contains("model"_L1, Qt::CaseInsensitive)) {
+            done(false, i18n("Vibe could not load the speech model %1: %2", QFileInfo(mSettings.modelPath).fileName(), reason));
+        } else {
+            done(false, i18n("Vibe's speech engine did not start: %1", reason));
+        }
+        return;
+    }
+    done(false, i18n("Vibe could not transcribe the recording: %1", reason));
+}
+
+void VibeSpeechToTextJob::serverError(QProcess::ProcessError error)
+{
+    if (error == QProcess::FailedToStart && !mDone) {
+        done(false, i18n("Vibe's speech engine did not start: %1", mServer->errorString()));
+    }
+}
+
+void VibeSpeechToTextJob::sendAudio(int port)
+{
+    auto multiPart = new QHttpMultiPart(QHttpMultiPart::FormDataType);
+    QHttpPart filePart;
+    filePart.setHeader(QNetworkRequest::ContentTypeHeader, QVariant(u"audio/wav"_s));
+    filePart.setHeader(QNetworkRequest::ContentDispositionHeader, QVariant(u"form-data; name=\"file\"; filename=\"dictation.wav\""_s));
+    filePart.setBody(wavFile(mPcm, mSampleRate));
+    multiPart->append(filePart);
+    multiPart->append(formField(u"response_format"_s, "json"));
+    if (mSettings.language.isEmpty()) {
+        multiPart->append(formField(u"detect_language"_s, "true"));
+    } else {
+        multiPart->append(formField(u"language"_s, mSettings.language.toUtf8()));
+    }
+    QNetworkRequest request(QUrl(u"http://127.0.0.1:%1/v1/audio/transcriptions"_s.arg(port)));
+    // a long dictation on a processor takes minutes
+    request.setTransferTimeout(10 * 60 * 1000);
+    QNetworkReply *reply = mNetwork->post(request, multiPart);
+    multiPart->setParent(reply);
+    connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+        replyFinished(reply);
+    });
+}
+
+void VibeSpeechToTextJob::replyFinished(QNetworkReply *reply)
+{
+    reply->deleteLater();
+    const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+    const QJsonObject answer = QJsonDocument::fromJson(reply->readAll()).object();
+    if (reply->error() == QNetworkReply::NoError && status == 200) {
+        const QString text = answer.value("text"_L1).toString().trimmed();
+        if (text.isEmpty()) {
+            done(false, i18n("Vibe heard no speech in the recording."));
+        } else {
+            done(true, text);
+        }
+        return;
+    }
+    // {"error":{"code":"invalid_audio","message":"..."}}
+    const QJsonObject error = answer.value("error"_L1).toObject();
+    const QString message = error.value("message"_L1).toString();
+    if (error.value("code"_L1).toString() == "invalid_audio"_L1) {
+        done(false, i18n("Vibe refused the recorded audio: %1", message));
+    } else {
+        done(false, i18n("Vibe could not transcribe the recording: %1", message.isEmpty() ? reply->errorString() : message));
+    }
+}
+
+void VibeSpeechToTextJob::stopServer()
+{
+    if (!mServer || mServer->state() == QProcess::NotRunning) {
+        return;
+    }
+    mServer->terminate();
+    if (!mServer->waitForFinished(5000)) {
+        mServer->kill();
+        mServer->waitForFinished(2000);
+    }
+}
+
+void VibeSpeechToTextJob::done(bool success, const QString &textOrMessage)
+{
+    if (mDone) {
+        return;
+    }
+    mDone = true;
+    mReadyTimer->stop();
+    // the server runs only while a recording is transcribed
+    stopServer();
+    if (success) {
+        Q_EMIT finished(textOrMessage);
+    } else {
+        qCWarning(SPEECHTOTEXT_VIBE_LOG) << textOrMessage;
+        Q_EMIT failed(textOrMessage);
+    }
+    deleteLater();
+}
