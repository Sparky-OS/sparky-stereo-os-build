+/*
+  SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>
+
+  SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include "libvibespeechtotext_export.h"
+#include "vibespeechtotextsettings.h"
+#include <QObject>
+#include <QProcess>
+
+class QNetworkAccessManager;
+class QNetworkReply;
+class QTimer;
+
+/*!
+ * One transcription: starts vibe-server on a free port of this computer with the chosen model, sends it the recording
+ * as 16 kHz mono WAV through its local HTTP API (/v1/audio/transcriptions) and stops it again, whatever the outcome.
+ * Emits finished() or failed() once, then deletes itself.
+ */
+class LIBVIBESPEECHTOTEXT_EXPORT VibeSpeechToTextJob : public QObject
+{
+    Q_OBJECT
+public:
+    explicit VibeSpeechToTextJob(QObject *parent = nullptr);
+    ~VibeSpeechToTextJob() override;
+
+    void setSettings(const VibeSpeechToTextSettings &settings);
+    void setAudio(const QByteArray &pcm, int sampleRate);
+    void setReadyTimeout(int milliseconds);
+    void start();
+
+    /*!
+     * A WAV file (RIFF, PCM, one channel, 16 bits) around \a pcm, the form vibe-server reads without converting.
+     */
+    [[nodiscard]] static QByteArray wavFile(const QByteArray &pcm, int sampleRate);
+
+Q_SIGNALS:
+    void finished(const QString &text);
+    void failed(const QString &message);
+
+private:
+    void readServerOutput();
+    void serverFinished(int exitCode, QProcess::ExitStatus exitStatus);
+    void serverError(QProcess::ProcessError error);
+    void sendAudio(int port);
+    void replyFinished(QNetworkReply *reply);
+    void done(bool success, const QString &textOrMessage);
+    void stopServer();
+    [[nodiscard]] QString serverReason() const;
+
+    VibeSpeechToTextSettings mSettings;
+    QByteArray mPcm;
+    int mSampleRate = 16000;
+    int mReadyTimeout = 120000;
+    QProcess *mServer = nullptr;
+    QNetworkAccessManager *const mNetwork;
+    QTimer *const mReadyTimer;
+    QByteArray mServerOutput;
+    QByteArray mServerErrors;
+    bool mReady = false;
+    bool mDone = false;
+};
diff --git a/textspeechtotext/speechtotext/plugins/vibe/vibespeechtotextplugin.cpp b/textspeechtotext/speechtotext/plugins/vibe/vibespeechtotextplugin.cpp
