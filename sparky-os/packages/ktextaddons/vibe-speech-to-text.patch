+namespace
+{
+bool isUsableFile(const QString &path)
+{
+    const QFileInfo info(path);
+    return !path.isEmpty() && info.isAbsolute() && info.isFile() && info.isReadable();
+}
+
+qint64 memoryKiB()
+{
+    QFile file(u"/proc/meminfo"_s);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return 0;
+    }
+    const QStringList lines = QString::fromLatin1(file.readAll()).split(u'\n');
+    for (const QString &line : lines) {
+        if (line.startsWith("MemTotal:"_L1)) {
+            return line.section(u' ', 1, 1, QString::SectionSkipEmpty).toLongLong();
+        }
+    }
+    return 0;
+}
+}
+
+QString VibeSpeechToTextSettings::vibeSettingsFile()
+{
+    // Vibe reads its store from the data folder, not the configuration folder (measured on its 3.3.5 release)
+    return QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + "/github.com.thewh1teagle.vibe/app_config.json"_L1;
+}
+
+VibeSpeechToTextSettings VibeSpeechToTextSettings::load()
+{
+    VibeSpeechToTextSettings settings;
+    settings.serverProgram = QStandardPaths::findExecutable(u"vibe-server"_s);
+    settings.environment = QProcessEnvironment::systemEnvironment();
+
+    // System Settings, Partners: who takes speech, a model chosen there, and the card chosen for partners
+    QString partnersModel;
+    if (const QString partners = QStandardPaths::findExecutable(u"sparky-stereo-partners"_s); !partners.isEmpty()) {
+        QStringList arguments{u"resolve"_s, u"--kind"_s, u"speech"_s};
+        if (const QString program = QGuiApplication::desktopFileName(); !program.isEmpty()) {
+            arguments << u"--program"_s << program;
+        }
+        QProcess process;
+        process.start(partners, arguments);
+        if (process.waitForFinished(10000)) {
+            static const QRegularExpression variableName(u"^[A-Z_][A-Z0-9_]*$"_s);
+            const QStringList lines = QString::fromUtf8(process.readAllStandardOutput()).split(u'\n');
+            for (const QString &line : lines) {
+                const qsizetype eq = line.indexOf(u'=');
+                if (eq <= 0) {
+                    continue;
+                }
+                const QString key = line.left(eq);
+                const QString value = line.mid(eq + 1);
+                if (key == "PARTNER_MODEL"_L1) {
+                    partnersModel = value;
+                } else if (!key.startsWith("PARTNER_"_L1) && variableName.match(key).hasMatch()) {
+                    settings.environment.insert(key, value);
+                }
+            }
+        } else {
+            qCWarning(SPEECHTOTEXT_VIBE_LOG) << "Partners: sparky-stereo-partners did not answer" << process.errorString();
+            process.kill();
+            process.waitForFinished(1000);
+        }
+    }
+
+    // Vibe's own settings: the model the person selected there, and the language they set
+    QJsonObject store;
+    if (QFile file(vibeSettingsFile()); file.open(QIODevice::ReadOnly)) {
+        store = QJsonDocument::fromJson(file.readAll()).object();
+    }
+    if (isUsableFile(partnersModel)) {
+        settings.modelPath = partnersModel;
+    } else if (const QString vibeModel = store.value("model.path"_L1).toString(); isUsableFile(vibeModel)) {
+        settings.modelPath = vibeModel;
+    }
+    const QString language = store.value("transcription.modelOptions"_L1).toObject().value("lang"_L1).toString();
+    if (language != "auto"_L1) {
+        settings.language = language;
+    }
+    return settings;
+}
+
+VibeSpeechToTextSettings::RecommendedModel VibeSpeechToTextSettings::recommendedModel(qint64 memoryKiB, bool engineHasDevice)
+{
+    // the rule of Vibe's presets in the edition (sparky-stereo-vibe's seed); sizes from the publisher's file list
+    if (memoryKiB >= 8LL * 1024 * 1024 || engineHasDevice) {
+        return {u"ggml-large-v3-turbo.bin"_s, 1624555275};
+    }
+    return {u"ggml-medium-q8_0.bin"_s, 823369779};
+}
+
+QString VibeSpeechToTextSettings::missingModelMessage(const RecommendedModel &model)
+{
+    return i18n("No speech model is selected in Vibe. Vibe's recommended model for this computer is %1 (%2): download it in Vibe, then select it there.",
+                model.fileName,
+                QLocale().formattedDataSize(model.size));
+}
+
+VibeSpeechToTextSettings::RecommendedModel VibeSpeechToTextSettings::recommendedModelHere() const
+{
+    bool hasDevice = false;
+    if (!serverProgram.isEmpty()) {
+        QProcess devices;
+        devices.setProcessEnvironment(environment);
+        devices.start(serverProgram, {u"devices"_s});
+        if (devices.waitForFinished(30000) && devices.exitCode() == 0) {
+            hasDevice = !QJsonDocument::fromJson(devices.readAllStandardOutput()).array().isEmpty();
+        } else {
+            devices.kill();
+            devices.waitForFinished(1000);
+        }
+    }
+    return recommendedModel(memoryKiB(), hasDevice);
+}
