index 0000000..8411662
--- /dev/null
+++ b/textspeechtotext/speechtotext/plugins/vibe/autotests/data/vibe-server-standin.py
@@ -0,0 +1,143 @@
+#!/usr/bin/python3
+# SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""A stand-in for vibe-server in tests: no model, no speech engine.
+
+It speaks vibe-server's command line ("serve MODEL --host H --port 0"), its ready line and its
+/v1/audio/transcriptions route with the error shapes of Vibe 3.3.5's server/mod.rs and
+routes/transcriptions.rs. STANDIN_MODE chooses the behaviour; STANDIN_RECORD is a folder where it writes
+its process number (pid), the form fields it received (request.json) and the audio (audio.wav).
+STANDIN_CLIP names a 16 kHz mono WAV: in mode "clip" the answer is STANDIN_TEXT only when the received
+audio's loudness follows the clip's, otherwise "UNRECOGNISED AUDIO".
+"""
+import email.parser
+import email.policy
+import http.server
+import json
+import math
+import os
+import signal
+import struct
+import sys
+import wave
+
+MODE = os.environ.get('STANDIN_MODE', 'ok')
+RECORD = os.environ.get('STANDIN_RECORD', '')
+TEXT = os.environ.get('STANDIN_TEXT', 'Text from the stand-in server.')
+
+
+def record(name, data):
+    if RECORD:
+        with open(os.path.join(RECORD, name), 'wb') as stream:
+            stream.write(data)
+
+
+def envelope(samples, rate):
+    step = max(1, rate // 50)
+    return [math.sqrt(sum(s * s for s in samples[i:i + step]) / step) for i in range(0, len(samples) - step + 1, step)]
+
+
+def correlation(a, b):
+    """Best normalized correlation of two loudness envelopes over shifts of up to one second."""
+    best = 0.0
+    for lag in range(-50, 51):
+        pairs = [(a[i], b[i - lag]) for i in range(len(a)) if 0 <= i - lag < len(b)]
+        if len(pairs) < 20:
+            continue
+        xs, ys = zip(*pairs)
+        mx, my = sum(xs) / len(xs), sum(ys) / len(ys)
+        sxy = sum((x - mx) * (y - my) for x, y in pairs)
+        sxx = sum((x - mx) ** 2 for x in xs)
+        syy = sum((y - my) ** 2 for y in ys)
+        if sxx > 0 and syy > 0:
+            best = max(best, sxy / math.sqrt(sxx * syy))
+    return best
+
+
+def wav_samples(data):
+    import io
+    with wave.open(io.BytesIO(data)) as w:
+        frames = w.readframes(w.getnframes())
+        return w.getframerate(), w.getnchannels(), w.getsampwidth(), list(struct.unpack('<%dh' % (len(frames) // 2), frames))
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def answer(self, status, body):
+        data = json.dumps(body).encode()
+        self.send_response(status)
+        self.send_header('Content-Type', 'application/json')
+        self.send_header('Content-Length', str(len(data)))
+        self.end_headers()
+        self.wfile.write(data)
+
+    def do_GET(self):
+        if self.path == '/health':
+            self.answer(200, {'status': 'ok'})
+        else:
+            self.answer(404, {'error': {'code': 'not_found', 'message': 'not found'}})
+
+    def do_POST(self):
+        length = int(self.headers.get('Content-Length', '0'))
+        body = self.rfile.read(length)
+        message = email.parser.BytesParser(policy=email.policy.HTTP).parsebytes(
+            b'Content-Type: ' + self.headers.get('Content-Type', '').encode() + b'\r\n\r\n' + body)
+        fields, audio = {}, b''
+        for part in message.iter_parts():
+            name = part.get_param('name', header='content-disposition')
+            if name == 'file':
+                audio = part.get_payload(decode=True)
+                fields['file'] = {'filename': part.get_filename(), 'content_type': part.get_content_type()}
+            else:
+                fields[name] = part.get_payload(decode=True).decode()
+        record('audio.wav', audio)
+        fields['path'] = self.path
+        if MODE == 'clip':
+            rate, channels, width, samples = wav_samples(audio)
+            _, _, _, clip = wav_samples(open(os.environ['STANDIN_CLIP'], 'rb').read())
+            score = correlation(envelope(samples, rate), envelope(clip, 16000))
+            fields['clip_correlation'] = round(score, 3)
+            text = TEXT if score >= 0.6 else 'UNRECOGNISED AUDIO'
+        else:
+            text = TEXT
+        record('request.json', json.dumps(fields, indent=1).encode())
+        if self.path != '/v1/audio/transcriptions':
+            self.answer(404, {'error': {'code': 'not_found', 'message': 'not found'}})
+        elif MODE == 'invalid-audio':
+            self.answer(400, {'error': {'code': 'invalid_audio', 'message': 'invalid audio file: stand-in refusal'}})
+        elif MODE == 'busy':
+            self.answer(429, {'error': {'code': 'busy', 'message': 'server is busy with another transcription'}})
+        elif MODE == 'empty':
+            self.answer(200, {'text': ''})
+        else:
+            self.answer(200, {'text': text})
+
+
+def main():
+    record('pid', str(os.getpid()).encode())
+    record('argv.json', json.dumps(sys.argv[1:]).encode())
+    if sys.argv[1:2] == ['devices']:
+        print(os.environ.get('STANDIN_DEVICES', '[]'))
+        return 0
+    if sys.argv[1:2] != ['serve']:
+        print('stand-in: only "serve" is understood', file=sys.stderr)
+        return 2
+    if MODE == 'noload':
+        print('Error: failed to load model %s: invalid model file' % sys.argv[2], file=sys.stderr)
+        return 1
+    if MODE == 'noready':
+        print('Error: Address already in use (os error 98)', file=sys.stderr)
+        return 1
+    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
+    if MODE == 'silent':
+        signal.pause()
+    host = sys.argv[sys.argv.index('--host') + 1] if '--host' in sys.argv else '127.0.0.1'
+    server = http.server.HTTPServer((host, 0), Handler)
+    print(json.dumps({'status': 'ready', 'port': server.server_address[1], 'version': 'stand-in', 'commit': 'stand-in'}), flush=True)
+    server.serve_forever()
+
+
+if __name__ == '__main__':
+    sys.exit(main())
