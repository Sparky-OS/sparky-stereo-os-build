+    }
+
+    void shouldRecommendThePresetsModel()
+    {
+        QCOMPARE(VibeSpeechToTextSettings::recommendedModel(8LL * 1024 * 1024, false).fileName, u"ggml-large-v3-turbo.bin"_s);
+        QCOMPARE(VibeSpeechToTextSettings::recommendedModel(8LL * 1024 * 1024, false).size, 1624555275);
+        QCOMPARE(VibeSpeechToTextSettings::recommendedModel(4LL * 1024 * 1024, true).fileName, u"ggml-large-v3-turbo.bin"_s);
+        QCOMPARE(VibeSpeechToTextSettings::recommendedModel(4LL * 1024 * 1024, false).fileName, u"ggml-medium-q8_0.bin"_s);
+        QCOMPARE(VibeSpeechToTextSettings::recommendedModel(4LL * 1024 * 1024, false).size, 823369779);
+        const QString message = VibeSpeechToTextSettings::missingModelMessage(VibeSpeechToTextSettings::recommendedModel(0, false));
+        QVERIFY2(message.contains(u"ggml-medium-q8_0.bin ("_s), qPrintable(message));
