+/*
+  SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>
+
+  SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "vibespeechtotextjob.h"
+#include "vibespeechtotextsettings.h"
+
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QSignalSpy>
+#include <QTemporaryDir>
+#include <QTest>
+#include <QtEndian>
+#include <cmath>
+
+using namespace Qt::Literals::StringLiterals;
+
+class VibeSpeechToTextJobTest : public QObject
+{
+    Q_OBJECT
+private:
+    QTemporaryDir mBin;
+    QString mModel;
+
+    // one second of a 440 Hz tone, 16 kHz mono, 16 bits
+    static QByteArray tone()
+    {
+        QByteArray pcm;
+        for (int i = 0; i < 16000; ++i) {
+            const auto sample = static_cast<qint16>(8000 * std::sin(2 * M_PI * 440 * i / 16000.0));
+            char bytes[2];
+            qToLittleEndian(sample, bytes);
+            pcm.append(bytes, 2);
+        }
+        return pcm;
+    }
+
+    VibeSpeechToTextSettings settings(const QString &mode, const QString &record) const
+    {
+        VibeSpeechToTextSettings s;
+        s.serverProgram = mBin.filePath(u"vibe-server"_s);
+        s.modelPath = mModel;
+        s.environment = QProcessEnvironment::systemEnvironment();
+        s.environment.insert(u"STANDIN_MODE"_s, mode);
+        s.environment.insert(u"STANDIN_RECORD"_s, record);
+        return s;
+    }
+
+    static QByteArray readFile(const QString &path)
+    {
+        QFile file(path);
+        return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+    }
+
+    // the server the job started is gone once the job is done
+    static bool serverGone(const QString &record)
+    {
+        const QByteArray pid = readFile(record + "/pid"_L1);
+        return !pid.isEmpty() && !QFile::exists("/proc/"_L1 + QString::fromLatin1(pid));
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QVERIFY(mBin.isValid());
+        const QString program = mBin.filePath(u"vibe-server"_s);
+        QVERIFY(QFile::copy(QFINDTESTDATA("data/vibe-server-standin.py"), program));
+        QVERIFY(QFile::setPermissions(program, QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+        mModel = mBin.filePath(u"model.bin"_s);
+        QFile model(mModel);
+        QVERIFY(model.open(QIODevice::WriteOnly));
+        model.write("not a real model");
+    }
+
+    void shouldBuildWavFile()
+    {
+        const QByteArray pcm = tone();
+        const QByteArray wav = VibeSpeechToTextJob::wavFile(pcm, 16000);
+        QCOMPARE(wav.size(), 44 + pcm.size());
+        QCOMPARE(wav.left(4), QByteArray("RIFF"));
+        QCOMPARE(qFromLittleEndian<quint32>(wav.constData() + 4), quint32(36 + pcm.size()));
+        QCOMPARE(wav.mid(8, 8), QByteArray("WAVEfmt "));
+        QCOMPARE(qFromLittleEndian<quint16>(wav.constData() + 20), quint16(1)); // PCM
+        QCOMPARE(qFromLittleEndian<quint16>(wav.constData() + 22), quint16(1)); // mono
+        QCOMPARE(qFromLittleEndian<quint32>(wav.constData() + 24), quint32(16000));
+        QCOMPARE(qFromLittleEndian<quint16>(wav.constData() + 34), quint16(16));
+        QCOMPARE(wav.mid(36, 4), QByteArray("data"));
+        QCOMPARE(qFromLittleEndian<quint32>(wav.constData() + 40), quint32(pcm.size()));
+        QCOMPARE(wav.mid(44), pcm);
+    }
+
+    void shouldSendTheRecordingAndStopTheServer()
+    {
+        QTemporaryDir record;
+        auto job = new VibeSpeechToTextJob;
+        job->setSettings(settings(u"ok"_s, record.path()));
+        const QByteArray pcm = tone();
+        job->setAudio(pcm, 16000);
+        QSignalSpy finished(job, &VibeSpeechToTextJob::finished);
+        QSignalSpy failed(job, &VibeSpeechToTextJob::failed);
+        bool goneWhenDone = false;
+        connect(job, &VibeSpeechToTextJob::finished, this, [&goneWhenDone, &record]() {
+            goneWhenDone = serverGone(record.path());
+        });
+        job->start();
+        QVERIFY(finished.wait(20000));
+        QCOMPARE(failed.count(), 0);
+        QCOMPARE(finished.at(0).at(0).toString(), u"Text from the stand-in server."_s);
+        QVERIFY(goneWhenDone);
+        // the command line: a free port of this computer, the chosen model
+        QCOMPARE(QJsonDocument::fromJson(readFile(record.filePath(u"argv.json"_s))).array().toVariantList(),
+                 QVariantList({u"serve"_s, mModel, u"--host"_s, u"127.0.0.1"_s, u"--port"_s, u"0"_s}));
+        // the request: the route, the form and 16 kHz mono 16-bit WAV holding exactly the recording
+        const QJsonObject request = QJsonDocument::fromJson(readFile(record.filePath(u"request.json"_s))).object();
+        QCOMPARE(request.value("path"_L1).toString(), u"/v1/audio/transcriptions"_s);
+        QCOMPARE(request.value("response_format"_L1).toString(), u"json"_s);
+        QCOMPARE(request.value("detect_language"_L1).toString(), u"true"_s);
+        QVERIFY(!request.contains("language"_L1));
+        QCOMPARE(request.value("file"_L1).toObject().value("content_type"_L1).toString(), u"audio/wav"_s);
+        QCOMPARE(readFile(record.filePath(u"audio.wav"_s)), VibeSpeechToTextJob::wavFile(pcm, 16000));
+        QTRY_VERIFY(serverGone(record.path()));
+    }
+
+    void shouldSendTheLanguageSetInVibe()
+    {
+        QTemporaryDir record;
+        auto job = new VibeSpeechToTextJob;
+        auto s = settings(u"ok"_s, record.path());
+        s.language = u"pt"_s;
+        job->setSettings(s);
+        job->setAudio(tone(), 16000);
+        QSignalSpy finished(job, &VibeSpeechToTextJob::finished);
+        job->start();
+        QVERIFY(finished.wait(20000));
+        const QJsonObject request = QJsonDocument::fromJson(readFile(record.filePath(u"request.json"_s))).object();
+        QCOMPARE(request.value("language"_L1).toString(), u"pt"_s);
+        QVERIFY(!request.contains("detect_language"_L1));
+    }
+
+    void shouldSayWhatFailed_data()
+    {
+        QTest::addColumn<QString>("mode");
+        QTest::addColumn<QString>("message");
+        QTest::newRow("model not loaded") << u"noload"_s
+                                          << u"Vibe could not load the speech model model.bin: Error: failed to load model %1: invalid model file"_s;
+        QTest::newRow("server not started") << u"noready"_s << u"Vibe's speech engine did not start: Error: Address already in use (os error 98)"_s;
+        QTest::newRow("audio refused") << u"invalid-audio"_s << u"Vibe refused the recorded audio: invalid audio file: stand-in refusal"_s;
+        QTest::newRow("busy") << u"busy"_s << u"Vibe could not transcribe the recording: server is busy with another transcription"_s;
+        QTest::newRow("no speech") << u"empty"_s << u"Vibe heard no speech in the recording."_s;
+    }
+
+    void shouldSayWhatFailed()
+    {
+        QFETCH(QString, mode);
+        QFETCH(QString, message);
+        QTemporaryDir record;
+        auto job = new VibeSpeechToTextJob;
+        job->setSettings(settings(mode, record.path()));
+        job->setAudio(tone(), 16000);
+        QSignalSpy finished(job, &VibeSpeechToTextJob::finished);
+        QSignalSpy failed(job, &VibeSpeechToTextJob::failed);
+        bool goneWhenDone = false;
+        connect(job, &VibeSpeechToTextJob::failed, this, [&goneWhenDone, &record]() {
+            goneWhenDone = serverGone(record.path());
+        });
+        job->start();
+        QVERIFY(failed.wait(20000));
+        QVERIFY(goneWhenDone);
+        QCOMPARE(finished.count(), 0);
+        QCOMPARE(failed.at(0).at(0).toString(), message.contains("%1"_L1) ? message.arg(mModel) : message);
+        QTRY_VERIFY(serverGone(record.path()));
+    }
+
+    void shouldSayWhenTheServerNeverAnswers()
+    {
+        QTemporaryDir record;
+        auto job = new VibeSpeechToTextJob;
+        job->setSettings(settings(u"silent"_s, record.path()));
+        job->setAudio(tone(), 16000);
+        job->setReadyTimeout(1500);
+        QSignalSpy failed(job, &VibeSpeechToTextJob::failed);
+        bool goneWhenDone = false;
+        connect(job, &VibeSpeechToTextJob::failed, this, [&goneWhenDone, &record]() {
+            goneWhenDone = serverGone(record.path());
+        });
+        job->start();
+        QVERIFY(failed.wait(20000));
+        QVERIFY(goneWhenDone);
+        QCOMPARE(failed.at(0).at(0).toString(), u"Vibe's speech engine did not start: it did not answer within 1 second."_s);
+        QTRY_VERIFY(serverGone(record.path()));
+    }
+
+    void shouldSayWhenTheProgramCannotStart()
+    {
+        QTemporaryDir record;
+        auto job = new VibeSpeechToTextJob;
+        auto s = settings(u"ok"_s, record.path());
+        s.serverProgram = record.filePath(u"missing/vibe-server"_s);
+        job->setSettings(s);
+        job->setAudio(tone(), 16000);
+        QSignalSpy failed(job, &VibeSpeechToTextJob::failed);
+        job->start();
+        QVERIFY(failed.wait(20000));
+        QVERIFY(failed.at(0).at(0).toString().startsWith(u"Vibe's speech engine did not start: "_s));
+        QVERIFY(!QFile::exists(record.filePath(u"pid"_s)));
+    }
+
+    void shouldStartNothingWithoutAudio()
+    {
+        QTemporaryDir record;
+        auto job = new VibeSpeechToTextJob;
+        job->setSettings(settings(u"ok"_s, record.path()));
+        job->setAudio({}, 16000);
+        QSignalSpy failed(job, &VibeSpeechToTextJob::failed);
+        job->start();
+        QCOMPARE(failed.count(), 1);
+        QCOMPARE(failed.at(0).at(0).toString(), u"Nothing was recorded from the microphone."_s);
+        QVERIFY(!QFile::exists(record.filePath(u"pid"_s)));
+    }
+
+    void shouldNameTheMissingModelAndStartNoServer()
+    {
+        QTemporaryDir record;
+        auto job = new VibeSpeechToTextJob;
+        auto s = settings(u"ok"_s, record.path());
+        s.modelPath.clear();
+        job->setSettings(s);
+        job->setAudio(tone(), 16000);
+        QSignalSpy failed(job, &VibeSpeechToTextJob::failed);
+        job->start();
+        QCOMPARE(failed.count(), 1);
+        const QString message = failed.at(0).at(0).toString();
