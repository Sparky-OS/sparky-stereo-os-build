+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "runscriptdialog.h"
+
+#include <KLocalizedString>
+#include <KShell>
+#include <KTerminalLauncherJob>
+
+#include <QDialogButtonBox>
+#include <QFileInfo>
+#include <QLabel>
+#include <QPlainTextEdit>
+#include <QPushButton>
+#include <QVBoxLayout>
+
+RunScriptDialog::RunScriptDialog(const QString &filePath, const QString &script, QWidget *parent)
+    : QDialog(parent)
+{
+    setWindowTitle(i18nc("@title:window", "Run in a terminal"));
+    setObjectName(QStringLiteral("runScriptDialog"));
+    auto layout = new QVBoxLayout(this);
+    auto path = new QLabel(filePath, this);
+    path->setTextFormat(Qt::PlainText);
+    path->setWordWrap(true);
+    layout->addWidget(path);
+    auto preview = new QPlainTextEdit(script, this);
+    preview->setObjectName(QStringLiteral("scriptPreview"));
+    preview->setReadOnly(true);
+    layout->addWidget(preview);
+    auto buttons = new QDialogButtonBox(QDialogButtonBox::Cancel, this);
+    auto run = buttons->addButton(i18nc("@action:button", "Run in a terminal"), QDialogButtonBox::AcceptRole);
+    run->setObjectName(QStringLiteral("runScriptButton"));
+    auto cancel = buttons->button(QDialogButtonBox::Cancel);
+    cancel->setDefault(true);
+    cancel->setFocus();
+    layout->addWidget(buttons);
+    resize(640, 480);
+
+    QStringList command;
+    if (script.startsWith(QLatin1String("#!"))) {
+        command = KShell::splitArgs(script.section(QLatin1Char('\n'), 0, 0).mid(2));
+    }
+    if (command.isEmpty()) {
+        command.append(QStringLiteral("/bin/sh"));
+    }
+    command.append(filePath);
+    connect(buttons, &QDialogButtonBox::rejected, this, &QDialog::reject);
+    connect(buttons, &QDialogButtonBox::accepted, this, [this, command, filePath] {
+        auto job = new KTerminalLauncherJob(KShell::joinArgs(command));
+        job->setWorkingDirectory(QFileInfo(filePath).absolutePath());
+        job->start();
+        accept();
+    });
+}
