+void DolphinRecoveryActionsTest::reviewScript_data()
+{
+    QTest::addColumn<QString>("shebang");
+    QTest::addColumn<bool>("run");
+    QTest::newRow("cancel-sh") << QStringLiteral("#!/bin/sh\n") << false;
+    QTest::newRow("run-sh") << QStringLiteral("#!/bin/sh\n") << true;
+    QTest::newRow("run-bash") << QStringLiteral("#!/bin/bash -e\n") << true;
+    QTest::newRow("run-env") << QStringLiteral("#!/usr/bin/env bash\n") << true;
+    QTest::newRow("run-without-shebang") << QString() << true;
+}
+
+void DolphinRecoveryActionsTest::reviewScript()
+{
+    QFETCH(QString, shebang);
+    QFETCH(bool, run);
+    const QString marker = m_directory.filePath(QStringLiteral("marker"));
+    QFile::remove(marker);
+    const QString path = m_directory.filePath(QStringLiteral("script '$()\n.sh"));
+    const QString script = shebang + QStringLiteral("printf verified > %1\n").arg(KShell::quoteArg(marker));
+    QFile file(path);
+    QVERIFY(file.open(QIODevice::WriteOnly));
+    const QByteArray contents = script.toUtf8();
+    QCOMPARE(file.write(contents), contents.size());
+    file.close();
+    QVERIFY(file.setPermissions(QFile::ReadOwner | QFile::WriteOwner));
+    const auto permissions = file.permissions();
+    const KFileItem item(QUrl::fromLocalFile(path));
+    QVERIFY(!item.isExecutable());
+    DolphinMainWindow window;
+    window.openDirectories({QUrl::fromLocalFile(m_directory.path())}, false);
+    KFileItemActions actions;
+    DolphinContextMenu menu(&window, item, {item}, QUrl::fromLocalFile(m_directory.path()), &actions);
+    auto action = menu.findChild<QAction *>(QStringLiteral("run_in_terminal"));
+    QVERIFY(action);
+    bool previewMatches = false;
+    bool ranBeforeConsent = true;
+    bool previewRecorded = true;
+    QTimer::singleShot(0, &menu, [&] {
+        auto dialog = window.findChild<QDialog *>(QStringLiteral("runScriptDialog"));
+        if (!dialog) {
+            if (auto unexpected = qobject_cast<QDialog *>(QApplication::activeModalWidget())) {
+                unexpected->reject();
+            }
+            return;
+        }
+        auto preview = dialog->findChild<QPlainTextEdit *>(QStringLiteral("scriptPreview"));
+        previewMatches = preview && preview->isReadOnly() && preview->toPlainText() == script;
+        previewRecorded = recordWindow(dialog, QStringLiteral("script-") + QString::fromLatin1(QTest::currentDataTag()));
+        QTest::qWait(300); // UNAVOIDABLE: No signal reports the absence of execution while the user reviews the script.
+        ranBeforeConsent = QFile::exists(marker);
+        if (run) {
+            auto button = dialog->findChild<QPushButton *>(QStringLiteral("runScriptButton"));
+            if (button) {
+                button->click();
+            } else {
+                dialog->reject();
+            }
+        } else {
+            dialog->reject();
+        }
+    });
+    action->trigger();
+    QVERIFY(previewMatches);
+    QVERIFY(previewRecorded);
+    QVERIFY(!ranBeforeConsent);
+    QCOMPARE(file.permissions(), permissions);
+    if (run) {
+        QTRY_VERIFY_WITH_TIMEOUT(QFile::exists(marker), 30000);
+        QFile result(marker);
+        QVERIFY(result.open(QIODevice::ReadOnly));
+        QCOMPARE(result.readAll(), QByteArray("verified"));
+    } else {
+        QTest::qWait(300); // UNAVOIDABLE: No signal reports the absence of execution after cancellation.
+        QVERIFY(!QFile::exists(marker));
+    }
+}
+
+void DolphinRecoveryActionsTest::executableScript()
+{
+    const QString path = m_directory.filePath(QStringLiteral("executable.sh"));
+    QFile file(path);
+    QVERIFY(file.open(QIODevice::WriteOnly));
+    QVERIFY(file.write("#!/bin/sh\nexit 0\n") > 0);
+    file.close();
+    QVERIFY(file.setPermissions(QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+    const KFileItem item(QUrl::fromLocalFile(path));
+    DolphinMainWindow window;
+    window.openDirectories({QUrl::fromLocalFile(m_directory.path())}, false);
+    KFileItemActions actions;
+    DolphinContextMenu menu(&window, item, {item}, QUrl::fromLocalFile(m_directory.path()), &actions);
+    QVERIFY(!menu.findChild<QAction *>(QStringLiteral("run_in_terminal")));
+}
