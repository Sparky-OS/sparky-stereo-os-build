+
+private:
+    QTemporaryDir m_directory;
+};
+
+void DolphinRecoveryActionsTest::initTestCase()
+{
+    QVERIFY(m_directory.isValid());
+    QStandardPaths::setTestModeEnabled(true);
+    const QString fakeHw = QFINDTESTDATA("data/fakecomputer.xml");
+    QVERIFY(!fakeHw.isEmpty());
+    qputenv("SOLID_FAKEHW", QFile::encodeName(fakeHw));
+    const QString terminal = m_directory.filePath(QStringLiteral("terminal"));
+    QFile file(terminal);
+    QVERIFY(file.open(QIODevice::WriteOnly));
+    const QByteArray wrapper("#!/bin/sh\nwhile [ \"$1\" != '-e' ]; do shift; done\nshift\nexec \"$@\"\n");
+    QCOMPARE(file.write(wrapper), wrapper.size());
+    file.close();
+    QVERIFY(file.setPermissions(QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+    auto config = KSharedConfig::openConfig();
+    KConfigGroup general(config, QStringLiteral("General"));
+    general.writeEntry("TerminalApplication", qEnvironmentVariableIsSet("DOLPHIN_TEST_REAL_TERMINAL") ? QStringLiteral("konsole") : KShell::quoteArg(terminal));
+    general.writeEntry("TerminalService", QString());
+    config->sync();
+}
+
+void DolphinRecoveryActionsTest::reloadInToolbar()
+{
+    DolphinMainWindow window;
+    window.openDirectories({QUrl::fromLocalFile(m_directory.path())}, false);
+    window.resize(1280, 800);
+    window.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&window));
+    const QAction *reload = window.actionCollection()->action(KStandardAction::name(KStandardAction::Redisplay));
+    QVERIFY(reload);
+    auto toolbar = window.findChild<QToolBar *>(QStringLiteral("mainToolBar"));
+    QVERIFY(toolbar);
+    QVERIFY(recordWindow(&window, QStringLiteral("toolbar")));
+    QVERIFY(toolbar->actions().contains(reload));
+    QVERIFY(toolbar->widgetForAction(reload)->isVisible());
+}
+
+void DolphinRecoveryActionsTest::customizedToolbar()
+{
+    QString path;
+    QDomDocument document;
+    {
+        DolphinMainWindow window;
+        path = window.localXMLFile();
+        document = window.domDocument();
+    }
+    QVERIFY(!path.isEmpty());
+    QVERIFY(!QFile::exists(path));
+    const auto cleanup = qScopeGuard([path] { QFile::remove(path); });
+    QDomElement toolbar;
+    const auto toolbars = document.elementsByTagName(QStringLiteral("ToolBar"));
+    for (int index = 0; index < toolbars.size(); ++index) {
+        const auto element = toolbars.at(index).toElement();
+        if (element.attribute(QStringLiteral("name")) == QLatin1String("mainToolBar")) {
+            toolbar = element;
+            break;
+        }
+    }
+    QVERIFY(!toolbar.isNull());
+    while (!toolbar.firstChild().isNull()) {
+        toolbar.removeChild(toolbar.firstChild());
+    }
+    toolbar.setAttribute(QStringLiteral("noMerge"), QStringLiteral("1"));
+    for (const auto &name : {QStringLiteral("go_home"), QStringLiteral("hamburger_menu")}) {
+        auto action = document.createElement(QStringLiteral("Action"));
+        action.setAttribute(QStringLiteral("name"), name);
+        toolbar.appendChild(action);
+    }
+    QVERIFY(KXMLGUIFactory::saveConfigFile(document, path));
+    DolphinMainWindow window;
+    window.openDirectories({QUrl::fromLocalFile(m_directory.path())}, false);
+    window.resize(1280, 800);
+    window.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&window));
+    auto liveToolbar = window.findChild<QToolBar *>(QStringLiteral("mainToolBar"));
+    QVERIFY(liveToolbar);
+    const QAction *home = window.actionCollection()->action(QStringLiteral("go_home"));
+    QVERIFY(home);
+    QVERIFY(liveToolbar->actions().contains(home));
+    const QAction *reload = window.actionCollection()->action(KStandardAction::name(KStandardAction::Redisplay));
+    QVERIFY(reload);
+    QVERIFY(!liveToolbar->actions().contains(reload));
+    QVERIFY(recordWindow(&window, QStringLiteral("customized-toolbar")));
+}
