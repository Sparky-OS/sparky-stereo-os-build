+static bool recordWindow(QWidget *widget, const QString &name)
+{
+    const QString directory = qEnvironmentVariable("DOLPHIN_PROOF_IMAGES");
+    if (directory.isEmpty()) {
+        return true;
+    }
+    return QDir().mkpath(directory) && widget->grab().save(directory + QLatin1Char('/') + name + QLatin1Char('-') + QGuiApplication::platformName() + QStringLiteral(".png"));
+}
+
+class DolphinRecoveryActionsTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void reloadInToolbar();
+    void customizedToolbar();
+    void reviewScript_data();
+    void reviewScript();
+    void executableScript();
+    void formatDrive_data();
