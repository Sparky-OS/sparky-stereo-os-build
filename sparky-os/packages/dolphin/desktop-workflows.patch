+void DolphinRecoveryActionsTest::formatDrive_data()
+{
+    QTest::addColumn<QString>("udi");
+    QTest::addColumn<bool>("formatAvailable");
+    QTest::newRow("removable") << QStringLiteral("/org/kde/solid/fakehw/volume_part1_size_993284096") << true;
+    QTest::newRow("internal") << QStringLiteral("/org/kde/solid/fakehw/volume_uuid_f00ba7") << false;
+    QTest::newRow("optical") << QStringLiteral("/org/kde/solid/fakehw/volume_uuid_5011") << false;
+}
+
+void DolphinRecoveryActionsTest::formatDrive()
+{
+    QFETCH(QString, udi);
+    QFETCH(bool, formatAvailable);
+    const QByteArray previousPath = qgetenv("PATH");
+    const auto restorePath = qScopeGuard([previousPath] { qputenv("PATH", previousPath); });
+    qputenv("PATH", QFile::encodeName(m_directory.path()) + ':' + previousPath);
+    const QString marker = m_directory.filePath(QStringLiteral("format-arguments"));
+    QFile::remove(marker);
+    QFile executable(m_directory.filePath(QStringLiteral("partitionmanager")));
+    QVERIFY(executable.open(QIODevice::WriteOnly));
+    const QByteArray script = QStringLiteral("#!/bin/sh\nprintf '%s\\n' \"$@\" > %1\n").arg(KShell::quoteArg(marker)).toUtf8();
+    QCOMPARE(executable.write(script), script.size());
+    executable.close();
+    QVERIFY(executable.setPermissions(QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+    PlacesPanel panel(nullptr);
+    auto model = qobject_cast<KFilePlacesModel *>(panel.model());
+    QVERIFY(model);
+    auto deviceIndex = [&] {
+        for (int row = 0; row < model->rowCount(); ++row) {
+            const auto index = model->index(row, 0);
+            if (model->deviceForIndex(index).udi() == udi) {
+                return index;
+            }
+        }
+        return QModelIndex();
+    };
+    QTRY_VERIFY_WITH_TIMEOUT(deviceIndex().isValid(), 30000);
+    const auto index = deviceIndex();
+    bool found = false;
+    connect(&panel, &KFilePlacesView::contextMenuAboutToShow, &panel, [&](const QModelIndex &, QMenu *menu) {
+        QTimer::singleShot(0, menu, [&, menu] {
+            auto action = menu->findChild<QAction *>(QStringLiteral("format_removable_drive"));
+            found = action && action->isVisible();
+            if (action) {
+                action->trigger();
+            }
+            menu->close();
+        });
+    });
+    panel.selectionModel()->setCurrentIndex(index, QItemSelectionModel::ClearAndSelect);
+    QContextMenuEvent event(QContextMenuEvent::Keyboard, QPoint(), QPoint());
+    QApplication::sendEvent(&panel, &event);
+    QCOMPARE(found, formatAvailable);
+    if (formatAvailable) {
+        QTRY_VERIFY_WITH_TIMEOUT(QFile::exists(marker), 30000);
+        QFile arguments(marker);
+        QVERIFY(arguments.open(QIODevice::ReadOnly));
+        const auto block = model->deviceForIndex(index).as<Solid::Block>();
+        QVERIFY(block);
+        QCOMPARE(arguments.readAll(), QStringLiteral("--device\n%1\n--format\n").arg(block->device()).toUtf8());
+    } else {
+        QVERIFY(!QFile::exists(marker));
+    }
+}
+
+QTEST_MAIN(DolphinRecoveryActionsTest)
+#include "dolphinrecoveryactionstest.moc"
