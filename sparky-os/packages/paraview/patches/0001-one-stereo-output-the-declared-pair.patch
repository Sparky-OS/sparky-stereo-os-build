+//-----------------------------------------------------------------------------
+void pqRenderView::keepStereoPair()
+{
+  vtkSMProxy* proxy = this->getProxy();
+  if (!proxy || !proxy->GetProperty("StereoType") || !proxy->GetProperty("ServerStereoType"))
+  {
+    return;
+  }
+  const int type = vtkSMPropertyHelper(proxy, "StereoType").GetAsInt();
+  const int serverType = vtkSMPropertyHelper(proxy, "ServerStereoType").GetAsInt();
+  const bool client = vtkPVStereoEdition::IsOutputFormat(type);
+  const bool server = vtkPVStereoEdition::IsOutputFormat(serverType);
+  if (!client && !server)
+  {
+    return;
+  }
+  const std::string name = vtkPVStereoEdition::OutputFormatName(client ? type : serverType);
+  const bool pair = vtkRemotingCoreConfiguration::GetInstance()->GetUseStereoRendering();
+  if (client)
+  {
+    vtkSMPropertyHelper(proxy, "StereoType").Set(pair ? 1 /* Crystal Eyes */ : 10 /* None */);
+    vtkSMPropertyHelper(proxy, "StereoRender").Set(pair ? 1 : 0);
+  }
+  if (server)
+  {
+    vtkSMPropertyHelper(proxy, "ServerStereoType").Set(0 /* Same As Client */);
+  }
+  proxy->UpdateVTKObjects();
+  this->render();
+
+  static bool told = false;
+  if (told)
+  {
+    return;
+  }
+  told = true;
+  const QString text = QString::fromStdString(pair
+      ? vtkPVStereoEdition::Format("A saved setting or state file asked for \"%1\" stereo, which "
+                                   "ParaView no longer makes itself: the view is shown as a stereo "
+                                   "pair, and the desktop makes each screen's format, red-blue, "
+                                   "interlaced and checkerboard among them, in its 3D display "
+                                   "settings (View menu).",
+          name)
+      : vtkPVStereoEdition::Format("A saved setting or state file asked for \"%1\" stereo, which "
+                                   "ParaView no longer makes itself; the view is shown flat "
+                                   "because Enable 3D is off (View menu).",
+          name));
+  QTimer::singleShot(0, pqCoreUtilities::mainWidget(),
+    [text]()
+    {
+      auto* box = new QMessageBox(QMessageBox::Information, QStringLiteral("ParaView"), text,
+        QMessageBox::Ok, pqCoreUtilities::mainWidget());
+      box->setObjectName("Stereo3DNotice");
+      box->setAttribute(Qt::WA_DeleteOnClose);
+      box->open();
+    });
 }
 
