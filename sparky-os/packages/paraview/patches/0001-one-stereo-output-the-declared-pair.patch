@@ -0,0 +1,91 @@
+// SPDX-FileCopyrightText: Copyright (c) Daniel Campos Ramos, Sparky Stereo OS
+// SPDX-License-Identifier: BSD-3-Clause
+/**
+ * @file vtkPVStereoEdition.h
+ * Sparky Stereo OS: ParaView hands its 3D views to the desktop as one stereo
+ * pair (Crystal Eyes: a quad-buffered window, which the edition's Mesa packs
+ * side by side and declares to the compositor), and the desktop makes each
+ * screen's own format. ParaView's own stereo output formats are not offered.
+ *
+ * This header holds the sentences of ParaView's 3D options (gettext domain
+ * "paraview-stereo") and the VTK stereo types that are output formats.
+ * It is used by the client's sources only and is not installed.
+ */
+#ifndef vtkPVStereoEdition_h
+#define vtkPVStereoEdition_h
+
+#include <libintl.h>
+#include <string>
+
+#ifndef PARAVIEW_STEREO_LOCALEDIR
+#define PARAVIEW_STEREO_LOCALEDIR "/usr/share/locale"
+#endif
+
+namespace vtkPVStereoEdition
+{
+/// The sentence `msgid` in the person's language.
+inline const char* Text(const char* msgid)
+{
+  static const bool bound = []()
+  {
+    bindtextdomain("paraview-stereo", PARAVIEW_STEREO_LOCALEDIR);
+    bind_textdomain_codeset("paraview-stereo", "UTF-8");
+    return true;
+  }();
+  (void)bound;
+  return dgettext("paraview-stereo", msgid);
+}
+
+/// `Text(msgid)` with "%1" replaced by `argument`.
+inline std::string Format(const char* msgid, const std::string& argument)
+{
+  std::string text = Text(msgid);
+  const std::string::size_type at = text.find("%1");
+  if (at != std::string::npos)
+  {
+    text.replace(at, 2, argument);
+  }
+  return text;
+}
+
+/// The VTK stereo types that are output formats ParaView would make itself.
+inline bool IsOutputFormat(int type)
+{
+  switch (type)
+  {
+    case 2: // VTK_STEREO_RED_BLUE
+    case 3: // VTK_STEREO_INTERLACED
+    case 6: // VTK_STEREO_DRESDEN
+    case 7: // VTK_STEREO_ANAGLYPH
+    case 8: // VTK_STEREO_CHECKERBOARD
+    case 9: // VTK_STEREO_SPLITVIEWPORT_HORIZONTAL
+      return true;
+    default:
+      return false;
+  }
+}
+
+/// The name ParaView gives an output format.
+inline const char* OutputFormatName(int type)
+{
+  switch (type)
+  {
+    case 2:
+      return "Red-Blue";
+    case 3:
+      return "Interlaced";
+    case 6:
+      return "Dresden";
+    case 7:
+      return "Anaglyph";
+    case 8:
+      return "Checkerboard";
+    case 9:
+      return "SplitViewportHorizontal";
+    default:
+      return "";
+  }
+}
+}
+
+#endif
