+// Sparky Stereo OS: the render views' one stereo choice, a Render View setting.
+const char* const Enable3DSetting = ".settings.RenderViewSettings.Enable3D";
+const char* const Enable3DLabel = "Enable 3D";
+const char* const Enable3DDocumentation =
+  "Show the render views in 3D: ParaView hands each view to the desktop as a stereo pair, and the "
+  "desktop makes each screen's format in its 3D display settings (View menu).";
+
+// The Settings dialog shows the setting's label and documentation from the XML through
+// QCoreApplication::translate("ServerManagerXML", ...): give them the person's language.
+class pqStereoEditionTranslator : public QTranslator
+{
+public:
+  using QTranslator::QTranslator;
+  bool isEmpty() const override { return false; }
+  QString translate(const char* context, const char* sourceText, const char* disambiguation = nullptr,
+    int n = -1) const override
+  {
+    (void)disambiguation;
+    (void)n;
+    if (context && sourceText && qstrcmp(context, "ServerManagerXML") == 0 &&
+      (qstrcmp(sourceText, Enable3DLabel) == 0 || qstrcmp(sourceText, Enable3DDocumentation) == 0))
+    {
+      return QString::fromUtf8(vtkPVStereoEdition::Text(sourceText));
+    }
+    return QString();
+  }
+};
+}
