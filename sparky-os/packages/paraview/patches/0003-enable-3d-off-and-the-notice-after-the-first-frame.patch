 }
 
+
+namespace
+{
+// Sparky Stereo OS: a told-once notice over ParaView's main window, opened once that window is
+// on screen; checked again every quarter second for up to 30 s, after which the log line is all.
+void openStereoNotice(const char* objectName, const QString& text, int triesLeft = 120)
+{
+  QWidget* mainWidget = pqCoreUtilities::mainWidget();
+  QWindow* handle = mainWidget ? mainWidget->windowHandle() : nullptr;
+  if (!mainWidget || !mainWidget->isVisible() || !handle || !handle->isExposed())
+  {
+    if (triesLeft > 0)
+    {
+      QTimer::singleShot(250,
+        [objectName, text, triesLeft]() { openStereoNotice(objectName, text, triesLeft - 1); });
+    }
+    return;
+  }
+  auto* box = new QMessageBox(
+    QMessageBox::Information, QStringLiteral("ParaView"), text, QMessageBox::Ok, mainWidget);
+  box->setObjectName(QString::fromLatin1(objectName));
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->open();
+}
+}
