+  // Shown once the view has drawn: a dialog opened while ParaView is still starting is closed
+  // with the main window's first platform window, which Qt replaces when the view's OpenGL window
+  // is put in it. The sentence also goes to the log.
+  vtkLogF(INFO, "%s", text.toUtf8().constData());
+  QObject::connect(
+    this, &pqView::endRender, this, [text]() { ::openStereoNotice("Stereo3DNotice", text); },
+    Qt::SingleShotConnection);
