--- /dev/null
+++ b/Qt/Core/pqStereoEditionNotice.h
@@ -0,0 +1,46 @@
+// SPDX-FileCopyrightText: Copyright (c) Kitware Inc.
+// SPDX-License-Identifier: BSD-3-Clause
+// Sparky Stereo OS (ORDER 50, step 5): the told-once notices of the edition's 3D options; a private
+// header of pqCore, not installed.
+#ifndef pqStereoEditionNotice_h
+#define pqStereoEditionNotice_h
+
+#include "pqCoreUtilities.h"
+
+#include <QMessageBox>
+#include <QString>
+#include <QTimer>
+#include <QWidget>
+#include <QWindow>
+
+namespace pqStereoEditionNotice
+{
+/// Shows `text` in a box of its own once ParaView's main window is on screen, checking again
+/// every quarter second for up to 30 s. The box has no parent: on Wayland Qt recreates the main
+/// window's platform window when the first render-to-texture widget (such as VTK's
+/// QVTKOpenGLNativeWidget in the color map editor) is added to it, and a dialog parented to the
+/// window it replaces is closed with it.
+inline void Open(const char* objectName, const QString& text, int triesLeft = 120)
+{
+  QWidget* mainWidget = pqCoreUtilities::mainWidget();
+  QWindow* handle = mainWidget ? mainWidget->windowHandle() : nullptr;
+  if (!mainWidget || !mainWidget->isVisible() || !handle || !handle->isExposed())
+  {
+    if (triesLeft > 0)
+    {
+      QTimer::singleShot(
+        250, [objectName, text, triesLeft]() { Open(objectName, text, triesLeft - 1); });
+    }
+    return;
+  }
+  auto* box =
+    new QMessageBox(QMessageBox::Information, QStringLiteral("ParaView"), text, QMessageBox::Ok);
+  box->setObjectName(QString::fromLatin1(objectName));
+  box->setAttribute(Qt::WA_DeleteOnClose);
+  box->show();
+  box->raise();
+  box->activateWindow();
+}
+}
+
+#endif
