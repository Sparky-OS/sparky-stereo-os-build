msgid "%1 could not be started."
msgstr "No se pudo iniciar %1."

#: kcm/ui/main.qml:76
msgctxt "@info"
msgid "Not happening now"
msgstr "No ocurre ahora"

#: kcm/ui/main.qml:92
msgctxt "@action:button"
msgid "Repair"
msgstr "Reparar"

#: kcm/ui/main.qml:109
msgctxt "@action:button"
msgid "Dismiss"
msgstr "Descartar"

#: kcm/ui/main.qml:116
msgctxt "@action:button"
msgid "Bring back"
msgstr "Recuperar"

#: kcm/ui/main.qml:134
msgctxt "@info placeholder"
msgid "No problems"
msgstr "Sin problemas"

#: kcm/ui/main.qml:135
msgctxt "@info placeholder"
msgid "Nothing on this computer needs attention. When something fails, it is listed here until it is repaired, and what you dismiss stays listed here too, so you can bring it back."
msgstr ""
"Nada en este equipo necesita atención. Cuando algo falla, se lista "
"aquí hasta que se repara, y lo que usted descarta también sigue "
"listado aquí, para que pueda recuperarlo."

#: kcm/ui/main.qml:142
msgctxt "@title:group"
msgid "Current problem (%1)"
msgid_plural "Current problems (%1)"
msgstr[0] "Problema actual (%1)"
msgstr[1] "Problemas actuales (%1)"

#: kcm/ui/main.qml:150
msgctxt "@info"
msgid "Nothing needs your attention now."
msgstr "Ahora nada necesita su atención."

#: kcm/ui/main.qml:162
msgctxt "@title:group"
msgid "Dismissed problem (%1)"
msgid_plural "Dismissed problems (%1)"
msgstr[0] "Problema descartado (%1)"
msgstr[1] "Problemas descartados (%1)"

#: kcm/ui/main.qml:169
msgctxt "@info"
msgid "You do not get notified about these. A dismissed problem is shown again when its message changes or a repair fails; a failed service that fails the same way again at a later start stays dismissed."
msgstr ""
"No recibirá notificaciones sobre estos. Un problema descartado vuelve "
"a mostrarse cuando cambia su mensaje o falla una reparación; un "
"servicio fallido que vuelve a fallar del mismo modo en un inicio "
"posterior sigue descartado."
