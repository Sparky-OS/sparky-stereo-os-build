#: kcm/ui/main.qml:76
msgctxt "@info"
msgid "Not happening now"
msgstr "Ne se produit pas en ce moment"

#: kcm/ui/main.qml:92
msgctxt "@action:button"
msgid "Repair"
msgstr "Réparer"

#: kcm/ui/main.qml:109
msgctxt "@action:button"
msgid "Dismiss"
msgstr "Ignorer"

#: kcm/ui/main.qml:116
msgctxt "@action:button"
msgid "Bring back"
msgstr "Rétablir"

#: kcm/ui/main.qml:134
msgctxt "@info placeholder"
msgid "No problems"
msgstr "Aucun problème"

#: kcm/ui/main.qml:135
msgctxt "@info placeholder"
msgid "Nothing on this computer needs attention. When something fails, it is listed here until it is repaired, and what you dismiss stays listed here too, so you can bring it back."
msgstr "Rien sur cet ordinateur ne demande votre attention. Quand quelque chose échoue, c’est listé ici jusqu’à sa réparation, et ce que vous ignorez reste listé ici aussi, pour que vous puissiez le rétablir."

#: kcm/ui/main.qml:142
msgctxt "@title:group"
msgid "Current problem (%1)"
msgid_plural "Current problems (%1)"
msgstr[0] "Problème actuel (%1)"
msgstr[1] "Problèmes actuels (%1)"

#: kcm/ui/main.qml:150
msgctxt "@info"
msgid "Nothing needs your attention now."
msgstr "Rien ne demande votre attention pour le moment."

#: kcm/ui/main.qml:162
msgctxt "@title:group"
msgid "Dismissed problem (%1)"
msgid_plural "Dismissed problems (%1)"
msgstr[0] "Problème ignoré (%1)"
msgstr[1] "Problèmes ignorés (%1)"

#: kcm/ui/main.qml:169
msgctxt "@info"
msgid "You do not get notified about these. A dismissed problem is shown again when its message changes or a repair fails; a failed service that fails the same way again at a later start stays dismissed."
msgstr "Vous n’êtes pas averti de ceux-ci. Un problème ignoré réapparaît quand son message change ou qu’une réparation échoue ; un service en échec qui échoue de la même façon à un démarrage ultérieur reste ignoré."
