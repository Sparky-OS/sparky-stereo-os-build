msgstr "Trazer de volta"

#: kcm/ui/main.qml:134
msgctxt "@info placeholder"
msgid "No problems"
msgstr "Nenhum problema"

#: kcm/ui/main.qml:135
msgctxt "@info placeholder"
msgid "Nothing on this computer needs attention. When something fails, it is listed here until it is repaired, and what you dismiss stays listed here too, so you can bring it back."
msgstr "Nada neste computador precisa de atenção. Quando algo falha, fica listado aqui até ser reparado, e o que você dispensar também continua listado aqui, para você poder trazer de volta."

#: kcm/ui/main.qml:142
msgctxt "@title:group"
msgid "Current problem (%1)"
msgid_plural "Current problems (%1)"
msgstr[0] "Problema atual (%1)"
msgstr[1] "Problemas atuais (%1)"

#: kcm/ui/main.qml:150
msgctxt "@info"
msgid "Nothing needs your attention now."
msgstr "Nada precisa da sua atenção agora."

#: kcm/ui/main.qml:162
msgctxt "@title:group"
msgid "Dismissed problem (%1)"
msgid_plural "Dismissed problems (%1)"
msgstr[0] "Problema dispensado (%1)"
msgstr[1] "Problemas dispensados (%1)"

#: kcm/ui/main.qml:169
msgctxt "@info"
msgid "You do not get notified about these. A dismissed problem is shown again when its message changes or a repair fails; a failed service that fails the same way again at a later start stays dismissed."
msgstr "Você não é notificado sobre estes. Um problema dispensado volta a aparecer quando a mensagem dele muda ou um reparo falha; um serviço que falhou e falha do mesmo jeito em uma inicialização posterior continua dispensado."
