#: kcm/ui/main.qml:134
msgctxt "@info placeholder"
msgid "No problems"
msgstr "Brak problemów"

#: kcm/ui/main.qml:135
msgctxt "@info placeholder"
msgid "Nothing on this computer needs attention. When something fails, it is listed here until it is repaired, and what you dismiss stays listed here too, so you can bring it back."
msgstr "Nic na tym komputerze nie wymaga uwagi. Gdy coś zawiedzie, zostanie wypisane tutaj do czasu naprawy, a to, co odrzucisz, też pozostanie tu na liście, żebyś mógł to przywrócić."

#: kcm/ui/main.qml:142
msgctxt "@title:group"
msgid "Current problem (%1)"
