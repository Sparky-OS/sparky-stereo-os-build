msgstr[2] "Bieżące problemy (%1)"

#: kcm/ui/main.qml:150
msgctxt "@info"
msgid "Nothing needs your attention now."
msgstr "Teraz nic nie wymaga twojej uwagi."

#: kcm/ui/main.qml:162
msgctxt "@title:group"
msgid "Dismissed problem (%1)"
msgid_plural "Dismissed problems (%1)"
msgstr[0] "Odrzucony problem (%1)"
msgstr[1] "Odrzucone problemy (%1)"
msgstr[2] "Odrzucone problemy (%1)"

#: kcm/ui/main.qml:169
msgctxt "@info"
msgid "You do not get notified about these. A dismissed problem is shown again when its message changes or a repair fails; a failed service that fails the same way again at a later start stays dismissed."
msgstr "O tych problemach nie dostajesz powiadomień. Odrzucony problem pojawia się ponownie, gdy zmieni się jego komunikat albo naprawa się nie powiedzie; usługa, która przy późniejszym uruchomieniu zawiedzie tak samo, pozostaje odrzucona."
