+	private static boolean isPairedEndpoint(java.net.URI uri) {
+		return "https".equals(uri.getScheme()) && uri.getUserInfo() == null &&
+			uri.getPath().matches("/paired/[a-f0-9]{64}/[^/]+/(control|event)");
+	}
+
+	@Override
+	public StreamResponseMessage sendRequest(StreamRequestMessage message) throws InterruptedException {
+		if (!isPairedEndpoint(message.getUri())) {
+			return super.sendRequest(message);
+		}
+		// jUPnP's base client rejects HTTPS before reaching createRequest().
+		// The paired client authenticates both certificates and disables redirects.
+		Request request = null;
+		try {
+			request = createRequest(message);
+			if (request == null) {
+				return null;
+			}
+			request.timeout(configuration.getTimeoutSeconds(), java.util.concurrent.TimeUnit.SECONDS);
+			return createCallable(message, request).call();
+		} catch (InterruptedException error) {
+			if (request != null) {
+				abort(request);
+			}
+			throw error;
+		} catch (Exception error) {
+			if (request != null) {
+				abort(request);
+			}
+			LOGGER.warn("Paired headset request failed: {}", error.toString());
+			return null;
+		}
+	}
