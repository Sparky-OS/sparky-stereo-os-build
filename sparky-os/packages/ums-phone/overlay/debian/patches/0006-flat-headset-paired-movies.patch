+	public void updateReportedPanel(String userAgent) {
+		if (getBoolean("UseReportedPanelSize", false)) {
+			int[] panel = ReportedPanel.parse(userAgent);
+			if (panel != null) {
+				httpPanel = panel;
+			}
+		}
