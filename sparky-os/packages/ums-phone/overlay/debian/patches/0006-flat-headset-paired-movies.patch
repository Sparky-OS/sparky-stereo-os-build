+/* SPDX-License-Identifier: GPL-2.0-only */
+package net.pms.network.mediaserver;
+
+import jakarta.servlet.http.HttpServletRequest;
+import java.io.ByteArrayInputStream;
+import java.net.URI;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.KeyFactory;
+import java.security.KeyStore;
+import java.security.MessageDigest;
+import java.security.cert.CertificateException;
+import java.security.cert.CertificateFactory;
+import java.security.cert.X509Certificate;
+import java.security.spec.PKCS8EncodedKeySpec;
+import java.util.HexFormat;
+import java.util.concurrent.TimeUnit;
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.TrustManager;
+import javax.net.ssl.X509TrustManager;
+
+/** The headset uses KDE Connect's current trust, including its unpair action. */
+public final class KdeConnectTrust {
+	private KdeConnectTrust() {
+	}
+
+	private static Path directory() {
+		String home = System.getenv("XDG_CONFIG_HOME");
+		return Path.of(home == null || home.isBlank() ? System.getProperty("user.home") + "/.config" : home, "kdeconnect");
+	}
+
+	private static X509Certificate certificate(byte[] bytes) throws CertificateException {
+		return (X509Certificate) CertificateFactory.getInstance("X.509").generateCertificate(new ByteArrayInputStream(bytes));
+	}
+
+	public static String fingerprint(X509Certificate certificate) {
+		try {
+			return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(certificate.getEncoded()));
+		} catch (Exception error) {
+			throw new IllegalStateException(error);
+		}
+	}
+
+	public static boolean isPaired(X509Certificate peer) {
+		return isPaired(fingerprint(peer));
+	}
+
+	public static boolean isPaired(String identity) {
+		try {
+			Path file = directory().resolve("trusted_devices");
+			if (Files.size(file) > 1024 * 1024) {
+				return false;
+			}
+			for (String row : Files.readAllLines(file)) {
+				if (row.startsWith("certificate=")) {
+					String pem = row.substring("certificate=".length());
+					if (pem.startsWith("\"") && pem.endsWith("\"")) {
+						pem = pem.substring(1, pem.length() - 1);
+					}
+					X509Certificate peer = certificate(pem.replace("\\n", "\n").getBytes(java.nio.charset.StandardCharsets.US_ASCII));
+					if (identity.equals(fingerprint(peer))) {
+						peer.checkValidity();
+						return true;
+					}
+				}
+			}
+		} catch (Exception ignored) {
+			return false;
+		}
+		return false;
+	}
+
+	public static boolean authenticated(HttpServletRequest request) {
+		Object certificates = request.getAttribute("jakarta.servlet.request.X509Certificate");
+		return request.isSecure() && certificates instanceof X509Certificate[] chain && chain.length > 0 && isPaired(chain[0]);
+	}
+
+	public static SSLContext context(String expectedPeer) throws Exception {
+		X509Certificate local = certificate(Files.readAllBytes(directory().resolve("certificate.pem")));
+		// OpenSSL consumes KDE Connect's SEC1 or PKCS#1 PEM and returns PKCS#8 in memory.
+		Process conversion = new ProcessBuilder("openssl", "pkcs8", "-topk8", "-nocrypt", "-passin", "pass:", "-in",
+			directory().resolve("privateKey.pem").toString(), "-outform", "DER").redirectError(ProcessBuilder.Redirect.DISCARD).start();
+		byte[] encoded = conversion.getInputStream().readNBytes(65537);
+		if (!conversion.waitFor(5, TimeUnit.SECONDS) || conversion.exitValue() != 0 || encoded.length > 65536) {
+			conversion.destroyForcibly();
+			throw new CertificateException("Cannot read the local KDE Connect identity");
+		}
+		var key = KeyFactory.getInstance(local.getPublicKey().getAlgorithm()).generatePrivate(new PKCS8EncodedKeySpec(encoded));
+		KeyStore store = KeyStore.getInstance(KeyStore.getDefaultType());
+		store.load(null, null);
+		store.setKeyEntry("kdeconnect", key, new char[0], new java.security.cert.Certificate[] {local});
+		KeyManagerFactory keys = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm());
+		keys.init(store, new char[0]);
+		X509TrustManager trust = new X509TrustManager() {
+			@Override
+			public X509Certificate[] getAcceptedIssuers() {
+				return new X509Certificate[0];
+			}
+
+			private void check(X509Certificate[] chain) throws CertificateException {
+				if (chain.length == 0 || !isPaired(chain[0]) || (expectedPeer != null && !expectedPeer.equals(fingerprint(chain[0])))) {
+					throw new CertificateException("Pair this headset with this computer in KDE Connect before connecting.");
+				}
+			}
+
+			@Override
+			public void checkClientTrusted(X509Certificate[] chain, String type) throws CertificateException {
+				check(chain);
+			}
+
+			@Override
+			public void checkServerTrusted(X509Certificate[] chain, String type) throws CertificateException {
+				if (expectedPeer == null) {
+					throw new CertificateException("A paired server identity is required");
+				}
+				check(chain);
+			}
+		};
+		SSLContext result = SSLContext.getInstance("TLSv1.2");
+		result.init(keys.getKeyManagers(), new TrustManager[] {trust}, null);
+		return result;
+	}
+
+	public static String secureUrl(String address) {
+		URI uri = URI.create(address);
+		if (!"http".equals(uri.getScheme()) || uri.getUserInfo() != null || uri.getPort() < 1 || uri.getPort() >= 65535) {
+			throw new IllegalArgumentException("No secure movie endpoint for this address");
+		}
+		try {
+			return new URI("https", null, uri.getHost(), uri.getPort() + 1, uri.getPath(), uri.getQuery(), null).toString();
+		} catch (java.net.URISyntaxException error) {
+			throw new IllegalArgumentException(error);
+		}
+	}
+}
