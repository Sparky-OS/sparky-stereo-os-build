+# Flat Headset: local Media3 decoding into the Cardboard viewer.
+RendererName = Flat Headset
+UpnpDetailsSearch = Flat Headset
+UserAgentSearch = FlatHeadset
+LoadingPriority = 10
+Video = true
+Audio = false
+Image = false
+MediaInfo = true
+TranscodeVideo = MPEGTS-H264-AAC
+SeekByTime = true
+Output3DFormat = sbsl
+UseReportedPanelSize = true
+MaxVideoWidth = 1920
+MaxVideoHeight = 1080
+H264LevelLimit = 5.1
+KeepAspectRatio = false
+KeepAspectRatioTranscoding = false
+Supported = f:mp4 v:h264 a:aac m:video/mp4
+Supported = f:mp4 v:h264 m:video/mp4
+Supported = f:mkv v:h264 m:video/x-matroska
+Supported = f:webm v:vp8|vp9 m:video/webm
+Supported = f:mpegts v:h264 a:aac m:video/mp2t
