+//------------------------------------------------------------------------------
+int vtkF3DGLXRenderWindow::UpdateStereoDepthLimits()
+{
+#ifdef F3D_WITH_STEREO_DECLARE
+  if (!this->DisplayId || !this->WindowId)
+  {
+    this->StereoDepthState = 3;
+    return this->StereoDepthState;
+  }
+  stereo_depth_limits limits;
+  const int r = stereo_depth_x11_get_limits(this->DisplayId, this->WindowId, &limits);
+  if (r == 0)
+  {
+    this->StereoDepthSunk = limits.sunk;
+    this->StereoDepthPopped = limits.popped;
+    this->StereoDepthState = 0;
+    // The limits are pixels of a view 1920 wide of the screen: this window's buffer holds
+    // screen width / 1920 * (its width / the width Stereo KWin shows it at) pixels of it per pixel of the limit,
+    // a unit conversion that does not depend on how large the window is. The shown width is the window's own
+    // _KDE_NET_WM_STEREO_CONTENT_ONE_VIEW_SIZE when a program declared one, else the window's width.
+    double shown = this->Size[0];
+    const Atom oneView = XInternAtom(this->DisplayId, "_KDE_NET_WM_STEREO_CONTENT_ONE_VIEW_SIZE", True);
+    if (oneView != None)
+    {
+      Atom type = None;
+      int format = 0;
+      unsigned long count = 0, after = 0;
+      unsigned char* data = nullptr;
+      if (XGetWindowProperty(this->DisplayId, this->WindowId, oneView, 0, 2, False, XA_CARDINAL, &type,
+            &format, &count, &after, &data) == Success &&
+        data && format == 32 && count == 2 && reinterpret_cast<long*>(data)[0] > 0)
+      {
+        shown = static_cast<double>(reinterpret_cast<long*>(data)[0]);
+      }
+      if (data)
+      {
+        XFree(data);
+      }
+    }
+    // the conversion is libstereo-declare's (1.11): the output the window is on, never the whole X layout
+    const struct stereo_depth_limits unit = { 1.0, 1.0 };
+    struct stereo_depth_limits perLimit = { 0.0, 0.0 };
+    double outputWidth = 0.0;
+    this->StereoDepthBufferPerLimit =
+      (shown > 0 && stereo_depth_x11_output_width(this->DisplayId, this->WindowId, &outputWidth) == 0 &&
+        stereo_depth_limits_for_buffer(&unit, outputWidth, this->Size[0], shown, &perLimit) == 0)
+      ? perLimit.sunk
+      : 0.0;
+  }
+  else if (r == -ENODATA)
+  {
+    this->StereoDepthState = 2;
+  }
+  else
+  {
+    // -ENOTSUP, or a property that is not the limits: never zeros, never a guess
+    this->StereoDepthState = 1;
+  }
+#else
+  this->StereoDepthState = 3;
+#endif
+  return this->StereoDepthState;
+}
