#!/bin/bash
# Created by Daniel Ramos (Capitain Jack) 2026/08/01
# Copyright 2026 under the GNU GPL3 License
# Last update 2026/11/02
#
# Cushion Swap File: the swap area stays off, is deployed under memory
# pressure and retracted only when that is safe. Daniel Ramos's design, his
# "Dynamic Swap Parachute" (cgm_swap_parachute.sh, 2026-08-01): "swap is a
# rescue parachute, never a floor". His decision rules and arithmetic are
# kept as he wrote them; README.md lists what the edition added around them.
#
#   cushion-swap [--dry-run] [--once] [--interval N]   the daemon (his options)
#   cushion-swap --thresholds        the values for this machine and why
#   cushion-swap --status            the state file the System Settings page reads; exit 0 protecting,
#                                    1 protecting with a problem kept, 2 not protecting, 3 not running,
#                                    4 the state cannot be read
#   cushion-swap --problems          what is wrong, why and what to do, in the system's language
#   cushion-swap --resume-target     where the hibernation image goes, and which setting says so
#   cushion-swap --hibernate-deploy  switch that area on before hibernation
#   cushion-swap --hibernate-resume  switch it off again after resume if unused
#   cushion-swap --stopped           the unit's ExecStopPost: says why the daemon is no longer running
#   cushion-swap --wait-ready EPOCH  the package's check that a daemon started after EPOCH runs and protects
#   cushion-swap --notify            starts the session's notifier, which shows every kept problem
#   cushion-swap --say KEY [ARG...]  one message of the language files, for the maintainer scripts
#
# Nothing fails silently (Daniel, 2026-11-01: "either it works or not and the user must know"). Whatever keeps
# the daemon from protecting memory, or from protecting it the way it was set, is a problem kept by the edition's one
# engine for this boot (sparky-stereo-problems; what, why and what to do), named in the status (PROTECTION=yes, degraded or no,
# PROBLEMS, REASON), said once in the journal and shown once per session as a notification; it clears when it
# is gone. A running service is never taken for working protection.
#
# Settings: /etc/default/cushion-swap (every value can be set there).
# Hibernation: /etc/initramfs-tools/conf.d/resume (RESUME=, RESUME_OFFSET=),
# else resume= and resume_offset= on the kernel command line.
# Test hooks (production never sets them): MEMINFO_PATH SWAPS_PATH FSTAB_PATH
# STATE_DIR NOW_EPOCH NOW_EPOCH_MS PSI_PATH PSI_WAKE RUN_USER_DIR PROC_DIR
# CUSHION_SWAP_CONFIG CUSHION_SWAP_AREA SWAPON_BIN SWAPOFF_BIN
# INITRAMFS_RESUME_PATH CMDLINE_PATH DEV_DISK_DIR SYS_BLOCK_DIR SYS_POWER_DIR
# FINDMNT_BIN FILEFRAG_BIN BTRFS_BIN CUSHION_SWAP_LANG_DIR SYSTEMCTL_BIN BUSCTL_BIN.
set -u
# Not set -e: a long-running daemon must survive one failed command
# (Daniel's rule); every command whose failure matters is checked.

readonly KIB_PER_MIB=1024
readonly KIB_PER_GIB=1048576
# MemTotal from which Daniel's values apply exactly as he set them: his
# machine has 96 GB (MemTotal 93.42 GiB); every 96 GB machine reports
# 92 to 95 GiB, so 90 GiB keeps all of them on his exact values.
readonly REFERENCE_KIB=$((90 * KIB_PER_GIB))

CONFIG=${CUSHION_SWAP_CONFIG:-/etc/default/cushion-swap}
if [[ -r $CONFIG ]]; then
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^[[:space:]]*([A-Z_][A-Z0-9_]*)=(.*)$ ]] || continue
		key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
		value=${value%%[[:space:]]#*}
		value=${value#\"} value=${value%\"} value=${value#\'} value=${value%\'}
		[[ -z ${!key+set} ]] && printf -v "$key" '%s' "$value"
	done <"$CONFIG"
fi
unset line key value

CUSHION_SWAP=${CUSHION_SWAP:-on}
AREA=${CUSHION_SWAP_AREA:-${AREA:-}}
RATE_WINDOW_SEC=${RATE_WINDOW_SEC:-10}
QUIET_SECONDS=${QUIET_SECONDS:-600}
POLL_INTERVAL_SEC=${POLL_INTERVAL_SEC:-3}
FAST_INTERVAL_SEC=${FAST_INTERVAL_SEC:-0.5}
FAIL_LOG_THROTTLE_SEC=${FAIL_LOG_THROTTLE_SEC:-60}
PSI=${PSI:-auto}
PSI_TRIGGER=${PSI_TRIGGER:-some 150000 1000000}
SAFETY_TICK_SEC=${SAFETY_TICK_SEC:-10}
GAME_OPENING_MAX_SEC=${GAME_OPENING_MAX_SEC:-180}
STEADY_SEC=${STEADY_SEC:-10}
LAUNCHERS=${LAUNCHERS:-reaper steam-launch-wr pressure-vessel pv-bwrap umu-run powerprofilesct proton wine-preloader wine64-preloade lutris-wrapper gamemoderun legendary gogdl}
# Problems only by default (Daniel, 2026-10-10 22:47). yes records every
# cycle's arithmetic in the file; actions and failures also reach the journal.
LOG_EVERY_CYCLE=${LOG_EVERY_CYCLE:-no}
# headroom (the default, Daniel 2026-10-10): the next sample comes before
# memory could fall to the early-warning floor at MAX_ALLOC_MIB_S, never
# sooner than MIN_INTERVAL_SEC unless the hard floor requires it, and
# never later than the normal interval (his
# 3 s poller, or the 10 s tick beside the PSI wake-up) or, while a game
# opens, his 0.5 s. fixed: those intervals as they are.
PACING=${PACING:-headroom}
ALLOC_RATE_OVERRIDE=${MAX_ALLOC_MIB_S:+yes}
MAX_ALLOC_MIB_S=${MAX_ALLOC_MIB_S:-8192}
ALLOC_RATE_HELPER=${ALLOC_RATE_HELPER:-/usr/libexec/cushion-swap/alloc-rate}
CALIBRATION_DIR=${CALIBRATION_DIR:-/var/lib/cushion-swap}
CPU_STAT_PATH=${CPU_STAT_PATH:-/proc/stat}
CALIBRATION_FINGERPRINT=""
CALIBRATED=${ALLOC_RATE_OVERRIDE:-no}
CALIBRATION_AFTER_MS=0
IDLE_PREVIOUS_TOTAL=0
IDLE_PREVIOUS_IDLE=0
ALLOC_SAFETY_FACTOR=${ALLOC_SAFETY_FACTOR:-2}
CALIBRATION_CHECK_SEC=${CALIBRATION_CHECK_SEC:-10}
MIN_INTERVAL_SEC=${MIN_INTERVAL_SEC:-0.25}

MEMINFO_PATH=${MEMINFO_PATH:-/proc/meminfo}
SWAPS_PATH=${SWAPS_PATH:-/proc/swaps}
FSTAB_PATH=${FSTAB_PATH:-/etc/fstab}
STATE_DIR=${STATE_DIR:-/run/cushion-swap}
STATE_FILE=$STATE_DIR/state
STATUS_FILE=$STATE_DIR/status
HIBERNATE_MARK=$STATE_DIR/hibernate-deployed
# the problems are kept by the edition's one engine, sparky-stereo-problems, for this boot (ORDER 350): one record per
# problem in its /run store, its code the record's key; its session notifier shows them
PROBLEMS_BIN=${PROBLEMS_BIN:-sparky-stereo-problems}
PROBLEM_PKG=sparky-stereo-cushion-swap
PROBLEM_DIR=${SPARKY_STEREO_ROOT:-}/run/sparky-stereo-problems
LANG_DIR=${CUSHION_SWAP_LANG_DIR:-/usr/share/sparky/sparky-stereo-cushion-swap}
SYSTEMCTL_BIN=${SYSTEMCTL_BIN:-systemctl}
BUSCTL_BIN=${BUSCTL_BIN:-busctl}
# the daemon's own problems (the hibernation commands keep theirs beside them)
readonly DAEMON_PROBLEMS="no-area area-missing meminfo swaps deploy-failed retract-failed psi-missing psi-lost calibration-failed calibration-unavailable calibration-save service-failed status-write"
# a daemon that keeps stopping is one problem, not one per restart: it clears after this long running
SERVICE_OK_AFTER_SEC=${SERVICE_OK_AFTER_SEC:-60}
CALIBRATION_RETRY_SEC=${CALIBRATION_RETRY_SEC:-60}
PSI_PATH=${PSI_PATH:-/proc/pressure/memory}
PSI_WAKE=${PSI_WAKE:-/usr/libexec/cushion-swap/psi-wake}
RUN_USER_DIR=${RUN_USER_DIR:-/run/user}
PROC_DIR=${PROC_DIR:-/proc}
INITRAMFS_RESUME_PATH=${INITRAMFS_RESUME_PATH:-/etc/initramfs-tools/conf.d/resume}
CMDLINE_PATH=${CMDLINE_PATH:-/proc/cmdline}
DEV_DISK_DIR=${DEV_DISK_DIR:-/dev/disk}
SYS_BLOCK_DIR=${SYS_BLOCK_DIR:-/sys/class/block}
SYS_POWER_DIR=${SYS_POWER_DIR:-/sys/power}
GAME_SIGNAL=cushion-swap-game-opening

DRY_RUN=0
RUN_ONCE=0
MODE=compatibility
MODE_REASON=""
FAST_SINCE_MS=0
CYCLE=0
CALIBRATION=pending
CALIBRATION_FAILURES=0
CALIBRATION_LAST_ERROR=""
STARTED=0

_find_bin() {
	local name=$1 c
	for c in "/sbin/$name" "/usr/sbin/$name" "/bin/$name" "/usr/bin/$name"; do
		[[ -x $c ]] && { printf '%s\n' "$c"; return 0; }
	done
	printf '%s\n' "$name"
}
SWAPON_BIN=${SWAPON_BIN:-$(_find_bin swapon)}
SWAPOFF_BIN=${SWAPOFF_BIN:-$(_find_bin swapoff)}
FINDMNT_BIN=${FINDMNT_BIN:-findmnt}
FILEFRAG_BIN=${FILEFRAG_BIN:-filefrag}
BTRFS_BIN=${BTRFS_BIN:-btrfs}

# Every cycle's arithmetic goes to standard output, which the unit appends
# to /var/log/cushion-swap/cushion-swap.log (rotated by logrotate). Actions,
# failures go to standard error as well, which the
# unit sends to the journal; once only where both are the same place.
JOURNAL_TOO=0
[[ /proc/self/fd/1 -ef /proc/self/fd/2 ]] || JOURNAL_TOO=1

log_cycle() {
	printf '[%(%Y-%m-%d %H:%M:%S%z)T] %s\n' -1 "$*"
}

log() {
	local line
	printf -v line '[%(%Y-%m-%d %H:%M:%S%z)T] %s' -1 "$*"
	printf '%s\n' "$line"
	((JOURNAL_TOO)) && printf '%s\n' "$line" >&2
	return 0
}

log_err() {
	local line
	printf -v line '[%(%Y-%m-%d %H:%M:%S%z)T] ERROR: %s' -1 "$*"
	((JOURNAL_TOO)) && printf '%s\n' "$line"
	printf '%s\n' "$line" >&2
	return 0
}

# --- What is said to the person ---------------------------------------------
# The messages are the package's language files (LOCALn="text", %s for the arguments) in the nine languages
# the edition requires. The language: LANG, else /etc/default/locale; the whole name, then the bare language,
# then English; Chinese keeps its territory, zh_CN when none is named.
lang_code() {
	local lang=${LANG:-} line code
	if [[ -z $lang || $lang == C || $lang == C.* || $lang == POSIX ]] && [[ -r /etc/default/locale ]]; then
		while IFS= read -r line; do
			[[ $line == LANG=* ]] && { lang=${line#LANG=}; lang=${lang//\"/}; }
		done </etc/default/locale
	fi
	lang=${lang%%.*} lang=${lang%%@*}
	for code in "$lang" "$( [[ $lang == zh* ]] && echo zh_CN || echo "${lang%%_*}")"; do
		case $code in en | pl | pt_BR | fr | de | es | ja | ko | zh_CN | zh_TW) LANG_CODE=$code; return ;; esac
	done
	LANG_CODE=en
}

# text_into VAR LANG KEY [ARG...]: the message KEY in LANG with its %s filled; a key missing from the language's
# file comes from the English file, and a key missing from both is the key and its arguments, never nothing.
text_into() {
	local out=$1 lang=$2 key=$3 line template="" file
	shift 3
	for file in "$LANG_DIR/$lang" "$LANG_DIR/en"; do
		[[ -r $file ]] || continue
		while IFS= read -r line; do
			if [[ $line == "$key="* ]]; then
				template=${line#"$key="} template=${template#\"} template=${template%\"}
				break
			fi
		done <"$file"
		[[ -n $template ]] && break
	done
	if [[ -z $template ]]; then
		printf -v "$out" '%s' "$key $*"
		return
	fi
	# shellcheck disable=SC2059
	printf -v "$out" "${template//\\/\\\\}" "$@"
}

# say KEY [ARG...]: on standard error in the system's language, and in English too when that is another
say() {
	local message
	lang_code
	text_into message "$LANG_CODE" "$@"
	printf 'cushion-swap: %s\n' "$message" >&2
	if [[ $LANG_CODE != en ]]; then
		text_into message en "$@"
		printf 'cushion-swap: (en) %s\n' "$message" >&2
	fi
}

# --- Problems ----------------------------------------------------------------
# One record per problem, kept by the engine in $PROBLEM_DIR/$PROBLEM_PKG_CODE.json, this boot's: its severity
# (failed: memory is not protected; degraded: protected another way than set; notice: protected, something else did
# not work), its message (KEY and ARGs), when it began (the same while it lasts) and its English text. Kept only when
# it changes: the daemon remembers what it kept, and a record another run kept with the same message (the hash of
# its message in the record's data) is said once, not again.
declare -A PROBLEM_BODY=()
problem_file() { printf '%s/%s_%s.json' "$PROBLEM_DIR" "$PROBLEM_PKG" "$1"; }
json_str() {
	local v=$1
	v=${v//\\/\\\\} v=${v//\"/\\\"} v=${v//$'\t'/\\t} v=${v//$'\r'/} v=${v//$'\n'/\\n}
	printf '"%s"' "$v"
}
problem_set() {
	local code=$1 effect=$2 key=$3 arg body hash severity args="" english file
	file=$(problem_file "$1")
	shift 3
	body="EFFECT=$effect"$'\n'"KEY=$key"
	for arg in "$@"; do body+=$'\n'"ARG=${arg//$'\n'/ }"; args+="${args:+,}$(json_str "${arg//$'\n'/ }")"; done
	[[ ${PROBLEM_BODY[$code]:-} == "$body" && -e $file ]] && return 0
	hash=$(printf '%s' "$body" | sha1sum) hash=${hash%% *}
	# the same problem another run of this program kept already: said once, not again
	if [[ -r $file ]] && grep -q "\"body\":\"$hash\"" "$file"; then
		PROBLEM_BODY[$code]=$body
		return 0
	fi
	text_into english en "$key" "$@"
	PROBLEM_BODY[$code]=$body
	log_err "$english"
	((DRY_RUN)) && return 0
	case $effect in no) severity=failed ;; degraded) severity=degraded ;; *) severity=notice ;; esac
	if ! "$PROBLEMS_BIN" keep --boot --quiet --severity "$severity" "$PROBLEM_PKG" "$code" "$key" \
		--details "{\"args\":[$args],\"data\":{\"body\":\"$hash\"}}" 2>/dev/null; then
		log_err "cannot keep the problem $code ($PROBLEMS_BIN keep failed): the journal line above is all there is"
	fi
	STATUS_TEXT=""
}

problem_clear() {
	local code=$1 file
	file=$(problem_file "$1")
	[[ -n ${PROBLEM_BODY[$code]:-} || -e $file ]] || return 0
	unset "PROBLEM_BODY[$code]"
	if ((!DRY_RUN)) && [[ -e $file ]]; then
		"$PROBLEMS_BIN" clear --boot "$PROBLEM_PKG" "$code" 2>/dev/null || log_err "cannot clear the problem $code ($PROBLEMS_BIN clear failed)"
		# the default log has only real problems (Daniel, 2026-10-10): that one is gone shows in the status, and
		# in the log only with every-cycle logging
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "resolved: $code"
	fi
	STATUS_TEXT=""
}

# The kept problems' codes, oldest file first
problem_codes() {
	local file code
	for file in "$PROBLEM_DIR/${PROBLEM_PKG}_"*.json; do
		[[ -f $file ]] || continue
		code=${file##*/${PROBLEM_PKG}_} code=${code%.json}
		printf '%s\n' "$code"
	done
}

# PROTECTION (yes, degraded, no), PROBLEMS (their codes) and REASON (the first one's English line), from every
# kept problem, the hibernation commands' too.
protection_state() {
	local file code severity text
	PROTECTION=yes PROBLEMS="" REASON=""
	while IFS= read -r code; do
		[[ -n $code ]] || continue
		file=$(problem_file "$code")
		severity=$(sed -n 's/.*"severity":"\([a-z]*\)".*/\1/p' "$file" 2>/dev/null)
		text=$("$PROBLEMS_BIN" text --boot --lang en "$PROBLEM_PKG" "$code" 2>/dev/null)
		PROBLEMS+="${PROBLEMS:+ }$code"
		case $severity in
		failed) [[ $PROTECTION == no ]] || REASON=$text; PROTECTION=no ;;
		degraded) [[ $PROTECTION == yes ]] && { PROTECTION=degraded REASON=$text; } ;;
		*) [[ -z $REASON ]] && REASON=$text ;;
		esac
	done < <(problem_codes)
}

# Sets NOW_MS (milliseconds) without a subshell: this runs every cycle.
now_ms() {
	if [[ -n ${NOW_EPOCH_MS:-} ]]; then
		NOW_MS=$NOW_EPOCH_MS
	elif [[ -n ${NOW_EPOCH:-} ]]; then
		NOW_MS=$((NOW_EPOCH * 1000))
	else
		local t=${EPOCHREALTIME/[.,]/}
		NOW_MS=$((10#${t:0:${#t}-3}))
	fi
}

# KiB as "N.NNGiB" into the variable named $1, without a subshell.
gib_into() {
	printf -v "$1" '%d.%02dGiB' "$(($2 / KIB_PER_GIB))" "$((($2 % KIB_PER_GIB) * 100 / KIB_PER_GIB))"
}

# Whole GiB as Daniel wrote them ("20GiB"), other values with two decimals.
label_into() {
	if (($2 % KIB_PER_GIB == 0)); then
		printf -v "$1" '%dGiB' "$(($2 / KIB_PER_GIB))"
	else
		gib_into "$1" "$2"
	fi
}

gib_str() {
	local text
	gib_into text "$1"
	printf '%s' "$text"
}

# MEMINFO_WHY says what was wrong; the caller keeps it as the meminfo problem (said once, not every cycle).
read_meminfo() {
	MEMINFO_WHY=""
	if [[ ! -r $MEMINFO_PATH ]]; then
		MEMINFO_WHY="it is missing or unreadable"
		return 1
	fi
	local key number total="" avail="" stotal="" sfree=""
	while read -r key number _; do
		case $key in
		MemTotal:) total=$number ;;
		MemAvailable:) avail=$number ;;
		SwapTotal:) stotal=$number ;;
		SwapFree:) sfree=$number ;;
		esac
	done <"$MEMINFO_PATH"
	if [[ -z $avail || -z $stotal || -z $sfree ]]; then
		MEMINFO_WHY="malformed: MemAvailable='${avail}' SwapTotal='${stotal}' SwapFree='${sfree}'"
		return 1
	fi
	if ! [[ $avail =~ ^[0-9]+$ && $stotal =~ ^[0-9]+$ && $sfree =~ ^[0-9]+$ ]]; then
		MEMINFO_WHY="a field is not a number: MemAvailable='${avail}' SwapTotal='${stotal}' SwapFree='${sfree}'"
		return 1
	fi
	[[ $total =~ ^[0-9]+$ ]] || total=$REFERENCE_KIB
	MEM_TOTAL_KIB=$total
	MEM_AVAILABLE_KIB=$avail
	SWAP_TOTAL_KIB=$stotal
	SWAP_FREE_KIB=$sfree
	# A person's compressed swap is not disk swap and is never ours to retract.
	local name kind size used rest
	if [[ -r $SWAPS_PATH ]]; then
		while read -r name kind size used rest; do
			is_zram "$name" || continue
			[[ $size =~ ^[0-9]+$ && $used =~ ^[0-9]+$ ]] || continue
			SWAP_TOTAL_KIB=$((SWAP_TOTAL_KIB - size))
			SWAP_FREE_KIB=$((SWAP_FREE_KIB - size + used))
		done <"$SWAPS_PATH"
	fi
	((SWAP_TOTAL_KIB < 0)) && SWAP_TOTAL_KIB=0
	((SWAP_FREE_KIB < 0)) && SWAP_FREE_KIB=0
	return 0
}

# Daniel's thresholds below the reference scale with MemTotal: each one is
# the same share of RAM as on his machine. A value in the settings file wins;
# his own GiB names are accepted too.
setting_kib() {
	local out=$1 mib_name=$2 gib_name=$3 base_gib=$4 floor_mib=$5 value total=$MEM_TOTAL_KIB
	if [[ -n ${!mib_name:-} ]]; then
		value=$((${!mib_name} * KIB_PER_MIB))
	elif [[ -n ${!gib_name:-} ]]; then
		value=$((${!gib_name} * KIB_PER_GIB))
	else
		((total > REFERENCE_KIB)) && total=$REFERENCE_KIB
		value=$((base_gib * KIB_PER_GIB * total / REFERENCE_KIB))
		((value < floor_mib * KIB_PER_MIB)) && value=$((floor_mib * KIB_PER_MIB))
	fi
	printf -v "$out" '%s' "$value"
}

compute_thresholds() {
	setting_kib DEPLOY_HARD_KIB DEPLOY_HARD_MIB DEPLOY_HARD_GIB 6 256
	setting_kib DEPLOY_SOFT_KIB DEPLOY_SOFT_MIB DEPLOY_SOFT_GIB 12 512
	setting_kib RATE_KIB RATE_MIB RATE_GIB 1 16
	setting_kib RETRACT_MARGIN_KIB RETRACT_MARGIN_MIB RETRACT_MARGIN_GIB 20 512
	if [[ -n ${DEPLOY_HARD_MIB:-}${DEPLOY_HARD_GIB:-}${DEPLOY_SOFT_MIB:-}${DEPLOY_SOFT_GIB:-}${RATE_MIB:-}${RATE_GIB:-}${RETRACT_MARGIN_MIB:-}${RETRACT_MARGIN_GIB:-} ]]; then
		THRESHOLD_SOURCE=settings
	elif ((MEM_TOTAL_KIB >= REFERENCE_KIB)); then
		THRESHOLD_SOURCE=reference
	else
		THRESHOLD_SOURCE=scaled
	fi
}

# A device name as fstab and initramfs-tools write it (UUID=, LABEL= or a
# path) to the path it stands for, into SPEC_PATH.
spec_path() {
	case $1 in
	UUID=*) SPEC_PATH=$DEV_DISK_DIR/by-uuid/${1#UUID=} ;;
	PARTUUID=*) SPEC_PATH=$DEV_DISK_DIR/by-partuuid/${1#PARTUUID=} ;;
	LABEL=*) SPEC_PATH=$DEV_DISK_DIR/by-label/${1#LABEL=} ;;
	PARTLABEL=*) SPEC_PATH=$DEV_DISK_DIR/by-partlabel/${1#PARTLABEL=} ;;
	*) SPEC_PATH=$1 ;;
	esac
	[[ -L $SPEC_PATH ]] && SPEC_PATH=$(readlink -f -- "$SPEC_PATH")
}

is_zram() {
	local device=$1
	[[ -L $device ]] && device=$(readlink -f -- "$device")
	[[ $device =~ ^/dev/zram[0-9]+$ ]]
}

AREA_REJECTED_ZRAM=0
resolve_area() {
	local spec _ type options rest
	if [[ -z $AREA && -r $FSTAB_PATH ]]; then
		while read -r spec _ type options rest; do
			[[ $spec == \#* || $type != swap ]] && continue
			[[ ,$options, == *,noauto,* ]] || continue
			spec_path "$spec"
			is_zram "$SPEC_PATH" && continue
			AREA=$spec
			break
		done <"$FSTAB_PATH"
	fi
	[[ -n $AREA ]] || return 0
	spec_path "$AREA"
	AREA=$SPEC_PATH
	if is_zram "$AREA"; then
		AREA=""
		AREA_REJECTED_ZRAM=1
	fi
}

# Is this swap area active? 0 yes, 1 no, 2 unknown; SWAP_USED_KIB from its
# own line in /proc/swaps.
swap_state() {
	SWAP_USED_KIB=0
	[[ -r $SWAPS_PATH ]] || return 2
	[[ -n $1 ]] || return 1
	local name type _ used rest wanted=${1// /\\040}
	while read -r name type _ used rest; do
		if [[ $name == "$wanted" ]]; then
			[[ $used =~ ^[0-9]+$ ]] && SWAP_USED_KIB=$used
			return 0
		fi
	done <"$SWAPS_PATH"
	return 1
}

# The Cushion Swap File's own area. Only this area is ever switched on or off
# by the daemon; other swap areas are not ours.
area_state() {
	local rc
	swap_state "$AREA"
	rc=$?
	AREA_USED_KIB=$SWAP_USED_KIB
	return $rc
}

load_state() {
	PREV_EPOCH="" PREV_AVAIL_KIB="" LAST_DANGER_EPOCH="" LAST_FAIL_LOG_EPOCH="" PREV_MS=""
	if [[ -r $STATE_FILE ]]; then
		read -r PREV_EPOCH PREV_AVAIL_KIB LAST_DANGER_EPOCH LAST_FAIL_LOG_EPOCH PREV_MS <"$STATE_FILE" 2>/dev/null || true
	fi
}

# One short line, written every cycle without starting a process; a torn
# file only resets the quiet timer, the conservative direction.
save_state() {
	[[ -d $STATE_DIR ]] || mkdir -p "$STATE_DIR" 2>/dev/null
	printf '%s %s %s %s %s\n' "${PREV_EPOCH:-0}" "${PREV_AVAIL_KIB:-0}" \
		"${LAST_DANGER_EPOCH:-0}" "${LAST_FAIL_LOG_EPOCH:-0}" "${PREV_MS:-0}" \
		>"$STATE_FILE" 2>/dev/null || true
}

# The area the daemon switches: none configured, or one that is not there, means no protection.
area_problem() {
	if [[ -z $AREA ]]; then
		if ((AREA_REJECTED_ZRAM)); then
			problem_set no-area no LOCAL24
		else
			problem_set no-area no LOCAL1
		fi
		problem_clear area-missing
	elif [[ ! -e $AREA ]]; then
		problem_clear no-area
		problem_set area-missing no LOCAL2 "$AREA"
	else
		problem_clear no-area
		problem_clear area-missing
	fi
}

STATUS_TEXT=""
STATUS_FAILED=0
write_status() {
	local state=$1 text fast=no
	((FAST_SINCE_MS)) && fast=yes
	protection_state
	# no swap area, no numbers, or no daemon: memory is not protected whatever else is said
	case $state in no-area | unknown | stopped | disabled) PROTECTION=no ;; esac
	[[ $state == disabled ]] && REASON=${REASON_OFF:-$REASON}
	[[ $state == stopped && -z $REASON ]] && REASON="the service was stopped"
	text="STATE=$state
PROTECTION=$PROTECTION
PROBLEMS=$PROBLEMS
REASON=$REASON
MODE=$MODE
MODE_REASON=$MODE_REASON
CALIBRATION=$CALIBRATION
STARTED=$STARTED
PID=${STATUS_PID-$$}
FAST=$fast
PACING=$PACING
MAX_ALLOC_MIB_S=$MAX_ALLOC_MIB_S
CALIBRATED=$CALIBRATED
AREA=$AREA
AREA_USED_KIB=${AREA_USED_KIB:-0}
MEM_TOTAL_KIB=${MEM_TOTAL_KIB:-0}
THRESHOLDS=${THRESHOLD_SOURCE:-}
DEPLOY_HARD_KIB=${DEPLOY_HARD_KIB:-0}
DEPLOY_SOFT_KIB=${DEPLOY_SOFT_KIB:-0}
RATE_KIB=${RATE_KIB:-0}
RATE_WINDOW_SEC=$RATE_WINDOW_SEC
RETRACT_MARGIN_KIB=${RETRACT_MARGIN_KIB:-0}
QUIET_SECONDS=$QUIET_SECONDS"
	[[ $text == "$STATUS_TEXT" ]] && return
	[[ -d $STATE_DIR ]] || mkdir -p "$STATE_DIR" 2>/dev/null
	if printf '%s\n' "$text" >"$STATUS_FILE.tmp" 2>/dev/null && mv -f "$STATUS_FILE.tmp" "$STATUS_FILE" 2>/dev/null; then
		STATUS_TEXT=$text
		STATUS_FAILED=0
		notify_systemd
	elif ((!STATUS_FAILED)); then
		# the page and --status read this file: that it cannot be written is said, once until it works again
		STATUS_FAILED=1
		log_err "cannot write $STATUS_FILE: System Settings and cushion-swap --status show an old state"
		notify_systemd
	fi
}

# systemd's own status line (systemctl status cushion-swap: "Status: ..."), where the unit gives a notify
# socket (NotifyAccess=all); the first one also says the daemon is ready.
NOTIFIED_STATUS=""
notify_systemd() {
	[[ -n ${NOTIFY_SOCKET:-} ]] || return 0
	local line="memory protection: $PROTECTION${REASON:+ ($REASON)}"
	((STATUS_FAILED)) && line+="; cannot write $STATUS_FILE"
	[[ $line == "$NOTIFIED_STATUS" ]] && return 0
	NOTIFIED_STATUS=$line
	systemd-notify --ready --status="$line" 2>/dev/null || log_err "systemd-notify failed: systemctl status shows no protection state"
}

# ExecStartPre acquires the area before systemd-sleep starts; ExecStopPost
# releases it after the entire operation, including every internal RTC wake.
# /run clears on boot. A long sleep is not a stale transaction.
hibernation_hold() {
	[[ -e $HIBERNATE_MARK ]]
}

# Serialize preparation, cleanup and the daemon's read/decide/swap operation.
# Keep this lock only while awake; the marker owns the full sleep lifetime.
lock_actions() {
	if { [[ -d $STATE_DIR ]] || mkdir -p "$STATE_DIR"; } && exec {ACTION_FD}>"$STATE_DIR/swap-actions.lock" && flock "$ACTION_FD"; then
		problem_clear action-lock
		return 0
	fi
	problem_set action-lock notice LOCAL23 "$STATE_DIR/swap-actions.lock"
	return 1
}

run_cycle() {
	lock_actions || return 1
	run_cycle_unlocked
	local rc=$?
	exec {ACTION_FD}>&-
	return "$rc"
}

run_cycle_unlocked() {
	local now now_millis
	now_ms
	now_millis=$NOW_MS
	now=$((now_millis / 1000))
	CYCLE=$((CYCLE + 1))

	if ! read_meminfo; then
		# Daniel's fail-safe: no action without the numbers; and the person is told memory is not protected
		problem_set meminfo no LOCAL3 "$MEMINFO_PATH" "$MEMINFO_WHY"
		((DRY_RUN)) || write_status unknown
		return 0
	fi
	problem_clear meminfo
	compute_thresholds
	area_problem

	local swap_used_kib=$((SWAP_TOTAL_KIB - SWAP_FREE_KIB))
	((swap_used_kib < 0)) && swap_used_kib=0

	load_state
	[[ -z $LAST_DANGER_EPOCH || $LAST_DANGER_EPOCH == 0 ]] && LAST_DANGER_EPOCH=$now
	[[ -z $LAST_FAIL_LOG_EPOCH ]] && LAST_FAIL_LOG_EPOCH=0

	local avail_s stotal_s used_s hard_l soft_l rate_l margin_l drop_s
	gib_into avail_s "$MEM_AVAILABLE_KIB"
	gib_into stotal_s "$SWAP_TOTAL_KIB"
	gib_into used_s "$swap_used_kib"
	label_into hard_l "$DEPLOY_HARD_KIB"
	label_into soft_l "$DEPLOY_SOFT_KIB"
	label_into rate_l "$RATE_KIB"
	label_into margin_l "$RETRACT_MARGIN_KIB"

	# --- DEPLOY evaluation (Daniel's) ---------------------------------------
	local hard_trigger=0 rate_trigger=0 rate_reason=""
	((MEM_AVAILABLE_KIB < DEPLOY_HARD_KIB)) && hard_trigger=1

	if [[ -n $PREV_EPOCH && $PREV_EPOCH != 0 && -n $PREV_AVAIL_KIB ]]; then
		local prev_ms=$PREV_MS
		[[ -z $prev_ms || $prev_ms == 0 ]] && prev_ms=$((PREV_EPOCH * 1000))
		local dt_ms=$((now_millis - prev_ms))
		if ((dt_ms > 0)); then
			local drop_kib=$((PREV_AVAIL_KIB - MEM_AVAILABLE_KIB))
			if ((MEM_AVAILABLE_KIB < DEPLOY_SOFT_KIB && drop_kib > 0)); then
				# drop / dt >= RATE / RATE_WINDOW, cross-multiplied in integers
				if ((drop_kib * RATE_WINDOW_SEC * 1000 >= RATE_KIB * dt_ms)); then
					rate_trigger=1
					gib_into drop_s "$drop_kib"
					printf -v rate_reason 'dropped %s over %d.%03ds (>= %s/%ss projected-exhaustion rate)' \
						"$drop_s" $((dt_ms / 1000)) $((dt_ms % 1000)) "$rate_l" "$RATE_WINDOW_SEC"
				fi
			fi
		fi
	fi

	local deploy_trigger=0 deploy_reason=""
	if ((hard_trigger)); then
		deploy_trigger=1
		deploy_reason="MemAvailable $avail_s < hard floor $hard_l"
	elif ((rate_trigger)); then
		deploy_trigger=1
		deploy_reason="MemAvailable $avail_s < soft floor $soft_l AND ${rate_reason}"
	fi
	((deploy_trigger)) && LAST_DANGER_EPOCH=$now

	# --- RETRACT evaluation (Daniel's, plus an unused area) ------------------
	local swap_active_rc=0
	area_state
	swap_active_rc=$?
	if ((swap_active_rc == 2)); then
		problem_set swaps no LOCAL4 "$SWAPS_PATH"
	else
		problem_clear swaps
	fi

	local quiet_elapsed=$((now - LAST_DANGER_EPOCH))
	local margin_kib=$((swap_used_kib + RETRACT_MARGIN_KIB))
	local retract_ok=0 area_empty=0 hold=0
	((swap_active_rc == 0 && AREA_USED_KIB == 0)) && area_empty=1
	if hibernation_hold; then
		hold=1
		# Suspended time and intermediate wakes never count as quiet time.
		LAST_DANGER_EPOCH=$now
		quiet_elapsed=0
	fi
	# His rule: something in swap, MemAvailable above it plus the margin
	# (swapoff reads every swapped page back), quiet for the window. Daniel,
	# 2026-10-10: an area that is on and holds nothing goes off after the
	# quiet window too; swapoff then reads nothing back. Never while a
	# hibernation is using the area.
	if ((((swap_used_kib > 0 && MEM_AVAILABLE_KIB > margin_kib) || area_empty) && quiet_elapsed >= QUIET_SECONDS && !hold)); then
		retract_ok=1
	fi

	local margin_s
	gib_into margin_s "$margin_kib"
	if ((DRY_RUN)) || [[ $LOG_EVERY_CYCLE == yes ]]; then
		local active_s area_used_s margin_pass=no quiet_pass=no empty_s=no hold_s=no
		case $swap_active_rc in 0) active_s=yes ;; 1) active_s=no ;; *) active_s=unknown ;; esac
		gib_into margin_s "$margin_kib"
		gib_into area_used_s "$AREA_USED_KIB"
		((MEM_AVAILABLE_KIB > margin_kib && swap_used_kib > 0)) && margin_pass=yes
		((quiet_elapsed >= QUIET_SECONDS)) && quiet_pass=yes
		((area_empty)) && empty_s=yes
		((hold)) && hold_s=yes
		log_cycle "sample: MemAvailable=$avail_s SwapTotal=$stotal_s SwapUsed=$used_s swap_active=$active_s area=${AREA:-none} mode=$MODE cycle=$CYCLE"
		log_cycle "deploy-check: hard_trigger=${hard_trigger} (avail < $hard_l) rate_trigger=${rate_trigger} (avail < $soft_l AND falling >= $rate_l/${RATE_WINDOW_SEC}s) => deploy_trigger=${deploy_trigger}${deploy_reason:+ [$deploy_reason]}"
		log_cycle "retract-check: swap_used=$used_s required_avail(>swap_used+$margin_l)=$margin_s actual_avail=$avail_s margin_pass=$margin_pass quiet_elapsed=${quiet_elapsed}s/required=${QUIET_SECONDS}s quiet_pass=$quiet_pass area_used=$area_used_s area_empty=$empty_s hibernating=$hold_s => retract_ok=${retract_ok}"
	fi

	local state=off
	((swap_active_rc == 0)) && state=deployed
	# no area, or one that is not there: nothing to deploy, whatever /proc/swaps says
	[[ -z $AREA ]] || { ((swap_active_rc != 0)) && [[ ! -e $AREA ]]; } && state=no-area

	if ((deploy_trigger)); then
		if [[ -z $AREA ]]; then
			# the no-area problem says it once; here only the moment it mattered
			log_err "deploy wanted (${deploy_reason}) but no Cushion Swap File area is configured (AREA= or a noauto swap line in $FSTAB_PATH)"
		elif ((swap_active_rc == 1)); then
			log "DEPLOY triggered: ${deploy_reason} -- swap currently OFF -> $( ((DRY_RUN)) && echo '[dry-run] would run' || echo 'running') '${SWAPON_BIN} ${AREA}'"
			if ((!DRY_RUN)); then
				local output rc
				output=$("$SWAPON_BIN" -- "$AREA" 2>&1)
				rc=$?
				[[ -n $output ]] && printf '%s\n' "$output" >&2
				if ((rc == 0)); then
					log "DEPLOY succeeded."
					problem_clear deploy-failed
					state=deployed
				else
					log_err "DEPLOY command failed (swapon ${AREA} returned $rc). Will re-evaluate next cycle."
					problem_set deploy-failed no LOCAL5 "$AREA" "exit status $rc${output:+: ${output##*$'\n'}}" "$AREA"
				fi
			fi
		elif ((swap_active_rc == 2)); then
			log_err "swap state unknown (cannot read ${SWAPS_PATH}); fail-safe: not attempting deploy this cycle"
		fi
	elif ((swap_active_rc == 0)); then
		problem_clear deploy-failed
	fi

	if ((retract_ok)); then
		if ((swap_active_rc == 0)); then
			log "RETRACT triggered: swap_used=$used_s avail=$avail_s quiet_elapsed=${quiet_elapsed}s required_avail=$margin_s margin=$margin_l hard=$hard_l soft=$soft_l$( ((area_empty)) && echo ' area unused') -- swap currently ON -> $( ((DRY_RUN)) && echo '[dry-run] would run' || echo 'running') '${SWAPOFF_BIN} ${AREA}'"
			if ((!DRY_RUN)); then
				write_status retracting
				local output rc
				output=$("$SWAPOFF_BIN" -- "$AREA" 2>&1)
				rc=$?
				[[ -n $output ]] && printf '%s\n' "$output" >&2
				if ((rc == 0)); then
					log "RETRACT succeeded."
					problem_clear retract-failed
					state=off
				else
					local since_fail=$((now - LAST_FAIL_LOG_EPOCH))
					if ((since_fail >= FAIL_LOG_THROTTLE_SEC)); then
						log_err "RETRACT command failed (swapoff ${AREA} returned $rc). Will retry next cycle (throttled logging: next failure log in >=${FAIL_LOG_THROTTLE_SEC}s)."
						LAST_FAIL_LOG_EPOCH=$now
					fi
					problem_set retract-failed degraded LOCAL6 "$AREA" "exit status $rc${output:+: ${output##*$'\n'}}"
				fi
			fi
		elif ((swap_active_rc == 2)); then
			log_err "swap state unknown (cannot read ${SWAPS_PATH}); fail-safe: not attempting retract this cycle"
		fi
	fi

	CYCLE_NOW_MS=$now_millis
	PREV_EPOCH=$now
	PREV_MS=$now_millis
	PREV_AVAIL_KIB=$MEM_AVAILABLE_KIB
	save_state
	((DRY_RUN)) || write_status "$state"
	CYCLE_AVAIL_KIB=$MEM_AVAILABLE_KIB
}

# The wake-up (Daniel, 2026-10-10): the kernel's PSI trigger where the kernel has PSI, else his poller
# (compatibility mode). That a kernel has no PSI, or that PSI=off was chosen, is said in MODE_REASON and is no
# problem; a kernel that has PSI while the trigger cannot be armed or is lost is one: the poller keeps memory
# protected meanwhile, as before, and the person is told, with PSI=off to make that mode their choice and a
# restart to arm the trigger again.
start_psi() {
	MODE=compatibility
	if [[ $PSI == off ]]; then
		MODE_REASON="PSI=off in $CONFIG"
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "PSI switched off in settings: compatibility mode"
		problem_clear psi-missing
		problem_clear psi-lost
		return
	fi
	if [[ ! -e $PSI_PATH ]]; then
		MODE_REASON="this kernel has no PSI ($PSI_PATH is absent)"
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "PSI not available here: compatibility mode (poll ${POLL_INTERVAL_SEC}s, ${FAST_INTERVAL_SEC}s while a game is opening)"
		problem_clear psi-missing
		problem_clear psi-lost
		return
	fi
	if [[ ! -x $PSI_WAKE ]]; then
		MODE_REASON="the PSI helper $PSI_WAKE is missing"
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "no PSI helper at $PSI_WAKE: compatibility mode"
		problem_set psi-missing degraded LOCAL7 "$PSI_WAKE is missing or not executable"
		return
	fi
	problem_clear psi-missing
	mkdir -p "$STATE_DIR" 2>/dev/null
	coproc PSIWAKE { exec "$PSI_WAKE" "$PSI_PATH" "$PSI_TRIGGER" 2>"$STATE_DIR/psi-wake.err"; }
	PSI_FD=${PSIWAKE[0]}
	PSI_HELPER_PID=$PSIWAKE_PID
	local line="" why
	if read -r -t 5 -u "$PSI_FD" line && [[ $line == ready ]]; then
		MODE=psi
		MODE_REASON="the kernel's PSI trigger '$PSI_TRIGGER' on $PSI_PATH"
		problem_clear psi-lost
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "PSI mode: woken by the kernel when memory stalls ($PSI_PATH, trigger '$PSI_TRIGGER'), safety tick ${SAFETY_TICK_SEC}s"
	else
		psi_helper_reason why
		MODE_REASON="the PSI trigger could not be armed: $why"
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "PSI not available here: compatibility mode (poll ${POLL_INTERVAL_SEC}s, ${FAST_INTERVAL_SEC}s while a game is opening)"
		problem_set psi-lost degraded LOCAL8 "the trigger could not be armed: $why"
	fi
}

# Why the helper stopped: its own last error line and exit status (psi-wake: 2 no PSI or refused, 3 lost).
psi_helper_reason() {
	local _out=$1 err="" rc
	if [[ -n ${PSI_HELPER_PID:-} ]]; then
		kill "$PSI_HELPER_PID" 2>/dev/null
		wait "$PSI_HELPER_PID" 2>/dev/null
		rc=$?
	fi
	[[ -r $STATE_DIR/psi-wake.err ]] && err=$(tail -n 1 "$STATE_DIR/psi-wake.err" 2>/dev/null)
	printf -v "$_out" '%s' "${err:-it gave no answer}${rc:+ (exit status $rc)}"
}

# Compatibility mode: the edition's game launcher signal, or a launcher process
# that was not there before, starts the fast rate; steady memory ends it.
# Only processes started since the last look are read: the PIDs after the
# last one the kernel handed out then (/proc/sys/kernel/ns_last_pid). The
# first look, a wrap of the counter or a burst of new processes reads all.
LAUNCHER_PIDS=" "
LAST_PID=0
scan_launchers() {
	local last=0 pid entry found=" " new=0
	read -r last 2>/dev/null <"$PROC_DIR/sys/kernel/ns_last_pid"
	for pid in $LAUNCHER_PIDS; do
		[[ -e $PROC_DIR/$pid ]] && found+="$pid "
	done
	if ((last == 0 || LAST_PID == 0 || last < LAST_PID || last - LAST_PID > 4096)); then
		for entry in "$PROC_DIR"/[0-9]*; do
			launcher_check "${entry##*/}"
		done
	else
		for ((pid = LAST_PID + 1; pid <= last; pid++)); do
			[[ -e $PROC_DIR/$pid ]] && launcher_check "$pid"
		done
	fi
	LAST_PID=$last
	LAUNCHER_PIDS=$found
	return $((!new))
}

launcher_check() {
	local comm
	[[ $found == *" $1 "* ]] && return
	read -r comm 2>/dev/null <"$PROC_DIR/$1/comm" || return
	case " $LAUNCHERS " in *" $comm "*) found+="$1 " new=1 ;; esac
}

update_game_opening() {
	local now_millis=$1 started="" signal
	[[ -e $STATE_DIR/game-seen ]] || : >"$STATE_DIR/game-seen"
	for signal in "$RUN_USER_DIR"/*/"$GAME_SIGNAL"; do
		if [[ -e $signal && $signal -nt $STATE_DIR/game-seen ]]; then
			started="signal from ${signal%/*}"
			: >"$STATE_DIR/game-seen"
		fi
	done
	if scan_launchers && [[ -n ${LAUNCHERS_SCANNED:-} ]]; then
		started=${started:-"launcher process started"}
	fi
	LAUNCHERS_SCANNED=1
	if [[ -n $started ]]; then
		((FAST_SINCE_MS)) || [[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "game opening ($started): sampling every ${FAST_INTERVAL_SEC}s at most"
		FAST_SINCE_MS=$now_millis
		STEADY_REF_KIB=${CYCLE_AVAIL_KIB:-0}
		STEADY_REF_MS=$now_millis
		return
	fi
	((FAST_SINCE_MS)) || return
	local avail=${CYCLE_AVAIL_KIB:-0} moved
	moved=$((avail - STEADY_REF_KIB))
	((moved < 0)) && moved=$((-moved))
	# Steady: moving slower than Daniel's rate threshold for STEADY_SEC.
	if ((moved * RATE_WINDOW_SEC >= RATE_KIB * STEADY_SEC)); then
		STEADY_REF_KIB=$avail
		STEADY_REF_MS=$now_millis
	elif ((now_millis - STEADY_REF_MS >= STEADY_SEC * 1000)); then
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "game loaded (memory steady for ${STEADY_SEC}s): back to every ${POLL_INTERVAL_SEC}s at most"
		FAST_SINCE_MS=0
	fi
	if ((FAST_SINCE_MS && now_millis - FAST_SINCE_MS >= GAME_OPENING_MAX_SEC * 1000)); then
		[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "game opening longer than ${GAME_OPENING_MAX_SEC}s: back to every ${POLL_INTERVAL_SEC}s at most"
		FAST_SINCE_MS=0
	fi
}

# Seconds until memory could reach the early-warning floor at MAX_ALLOC_MIB_S,
# at most $1 milliseconds.
headroom_interval() {
	local floor_ms=$((DEPLOY_HARD_KIB * 1000 / (MAX_ALLOC_MIB_S * KIB_PER_MIB * 2)))
	((floor_ms < 1)) && floor_ms=1
	((floor_ms > MIN_MS)) && floor_ms=$MIN_MS
	local head=$((${CYCLE_AVAIL_KIB:-0} - ${DEPLOY_SOFT_KIB:-0})) max_ms=$1 ms
	((head < 0)) && head=0
	ms=$((head * 1000 / (MAX_ALLOC_MIB_S * KIB_PER_MIB)))
	((ms < floor_ms)) && ms=$floor_ms
	((ms > max_ms)) && ms=$max_ms
	printf -v INTERVAL '%d.%03d' $((ms / 1000)) $((ms % 1000))
}

to_ms() {
	local whole=${1%%.*} fraction=000
	[[ $1 == *.* ]] && fraction=${1#*.}000
	echo $((10#${whole:-0} * 1000 + 10#${fraction:0:3}))
}

wait_next() {
	local line rc cap_ms
	if [[ $MODE == psi ]]; then
		INTERVAL=$SAFETY_TICK_SEC
		[[ $PACING == headroom ]] && headroom_interval "$TICK_MS"
		read -r -t "$INTERVAL" -u "$PSI_FD" line
		rc=$?
		if ((rc == 0)); then
			while read -r -t 0 -u "$PSI_FD" && read -r -u "$PSI_FD" line; do :; done
		elif ((rc <= 128)); then
			# the helper ended: the poller protects memory, as before, and the person is told
			local why
			psi_helper_reason why
			MODE=compatibility
			MODE_REASON="the PSI trigger was lost: $why"
			problem_set psi-lost degraded LOCAL8 "the trigger was lost: $why"
			[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "PSI helper ended: compatibility mode"
		fi
		return
	fi
	now_ms
	update_game_opening "$NOW_MS"
	cap_ms=$POLL_MS
	((FAST_SINCE_MS)) && cap_ms=$FAST_MS
	if [[ $PACING == headroom ]]; then
		headroom_interval "$cap_ms"
	else
		printf -v INTERVAL '%d.%03d' $((cap_ms / 1000)) $((cap_ms % 1000))
	fi
	read -r -t "$INTERVAL" -u "$SLEEP_FD"
}

# The persistent rate is invalidated only by a kernel/CPU/RAM change. CALIBRATION: override (MAX_ALLOC_MIB_S
# set, the person's choice), measured, pending (waiting for an idle moment), failed or unavailable (both kept
# as problems: the conservative pace stays, which costs CPU, never protection).
CONSERVATIVE_MIB_S=$MAX_ALLOC_MIB_S
load_calibration() {
	if [[ $CALIBRATED == yes ]]; then
		CALIBRATION=override
		return
	fi
	if [[ ! -x $ALLOC_RATE_HELPER ]]; then
		CALIBRATION=unavailable
		problem_set calibration-unavailable notice LOCAL10 "$ALLOC_RATE_HELPER is missing or not executable" \
			"$CONSERVATIVE_MIB_S" "$CONSERVATIVE_MIB_S"
		return
	fi
	local output
	if ! output=$("$ALLOC_RATE_HELPER" --fingerprint 2>&1) || [[ -z $output ]]; then
		CALIBRATION=unavailable
		problem_set calibration-unavailable notice LOCAL10 "$ALLOC_RATE_HELPER --fingerprint failed${output:+: ${output##*$'\n'}}" \
			"$CONSERVATIVE_MIB_S" "$CONSERVATIVE_MIB_S"
		return
	fi
	problem_clear calibration-unavailable
	CALIBRATION_FINGERPRINT=$output
	CALIBRATION=pending
	local fingerprint rate rest
	if read -r fingerprint rate rest 2>/dev/null <"$CALIBRATION_DIR/allocation-rate"; then
		if [[ $fingerprint == "$CALIBRATION_FINGERPRINT" && $rate =~ ^[1-9][0-9]*$ ]]; then
			MAX_ALLOC_MIB_S=$rate
			CALIBRATED=yes
			CALIBRATION=measured
		fi
	fi
}

# A measurement that failed: kept and said from the first failure (the conservative pace stays), and tried again
# as before: a minute later for a helper that failed, at the next idle check for one that gave no rate; a later
# success clears it.
calibration_failed() {
	CALIBRATION_FAILURES=$((CALIBRATION_FAILURES + 1))
	CALIBRATION_LAST_ERROR=$1
	CALIBRATION=failed
	problem_set calibration-failed notice LOCAL9 "$1" "$CONSERVATIVE_MIB_S" "$CONSERVATIVE_MIB_S"
	[[ ${2:-} == later ]] && CALIBRATION_AFTER_MS=$((NOW_MS + $(to_ms "$CALIBRATION_RETRY_SEC")))
	return 0
}

# Require two CPU snapshots separated by the normal loop, at least 90% idle,
# no game-opening signal/launcher, ample RAM, and no recent memory stalls.
calibrate_when_idle() {
	[[ $CALIBRATED == yes || -z $CALIBRATION_FINGERPRINT ]] && return
	now_ms
	((NOW_MS < CALIBRATION_AFTER_MS)) && return
	CALIBRATION_AFTER_MS=$((NOW_MS + $(to_ms "$CALIBRATION_CHECK_SEC")))
	local name user nice system idle iowait irq softirq steal rest total delta line
	read -r name user nice system idle iowait irq softirq steal rest <"$CPU_STAT_PATH" || return
	[[ $name == cpu ]] || return
	total=$((user + nice + system + idle + iowait + irq + softirq + steal))
	delta=$((total - IDLE_PREVIOUS_TOTAL))
	local previous=$IDLE_PREVIOUS_IDLE old_total=$IDLE_PREVIOUS_TOTAL
	IDLE_PREVIOUS_TOTAL=$total IDLE_PREVIOUS_IDLE=$idle
	((old_total && delta > 0 && (idle - previous) * 100 >= delta * 90)) || return
	((MEM_AVAILABLE_KIB > DEPLOY_SOFT_KIB + 256 * KIB_PER_MIB)) || return
	((FAST_SINCE_MS)) && return
	scan_launchers
	[[ $LAUNCHER_PIDS == " " ]] || return
	for line in "$RUN_USER_DIR"/*/"$GAME_SIGNAL"; do
		if [[ -e $line && $line -nt $STATE_DIR/game-seen ]]; then
			: >"$STATE_DIR/game-seen"
			CALIBRATION_AFTER_MS=$((NOW_MS + GAME_OPENING_MAX_SEC * 1000))
			return
		fi
	done
	if [[ -r $PSI_PATH ]]; then
		while read -r name line rest; do
			[[ $line == avg10=0.00 ]] || return
		done <"$PSI_PATH"
	fi
	local rate cpus workers duration
	local observation rc
	observation=$("$ALLOC_RATE_HELPER" 2>"$STATE_DIR/alloc-rate.err")
	rc=$?
	if ((rc != 0)); then
		local err
		err=$(tail -n 1 "$STATE_DIR/alloc-rate.err" 2>/dev/null)
		calibration_failed "$ALLOC_RATE_HELPER exited $rc${err:+: $err}" later
		return
	fi
	read -r rate cpus workers duration <<<"$observation"
	if ! [[ $rate =~ ^[1-9][0-9]*$ && $cpus =~ ^[1-9][0-9]*$ && $workers =~ ^[1-9][0-9]*$ ]]; then
		calibration_failed "$ALLOC_RATE_HELPER gave '${observation:0:80}', not a rate"
		return
	fi
	MAX_ALLOC_MIB_S=$((rate * cpus * ALLOC_SAFETY_FACTOR / workers))
	CALIBRATED=yes
	CALIBRATION=measured
	problem_clear calibration-failed
	local error
	if error=$( { mkdir -p "$CALIBRATION_DIR" && printf '%s %s %s %s %s %s\n' "$CALIBRATION_FINGERPRINT" \
		"$MAX_ALLOC_MIB_S" "$rate" "$cpus" "$workers" "$duration" >"$CALIBRATION_DIR/allocation-rate.tmp" \
		&& mv -f "$CALIBRATION_DIR/allocation-rate.tmp" "$CALIBRATION_DIR/allocation-rate"; } 2>&1); then
		problem_clear calibration-save
	else
		# measured and in use for this run; measured again at the next start
		problem_set calibration-save notice LOCAL11 "$CALIBRATION_DIR" "${error##*$'\n'}"
	fi
}

print_help() {
	sed -n '2,/^set -u$/p' "$0" | sed '$d; s/^# \{0,1\}//'
}

print_thresholds() {
	read_meminfo || { printf 'cushion-swap: cannot read %s: %s\n' "$MEMINFO_PATH" "$MEMINFO_WHY" >&2; exit 1; }
	compute_thresholds
	resolve_area
	local reference
	label_into reference "$REFERENCE_KIB"
	printf 'MemTotal=%s\nsource=%s\nreference=MemTotal >= %s gets Daniel'"'"'s values unchanged; below it each value is the same share of RAM\n' \
		"$(gib_str "$MEM_TOTAL_KIB")" "$THRESHOLD_SOURCE" "$reference"
	printf 'deploy_hard=%s deploy_soft=%s rate=%s/%ss retract_margin=%s quiet=%ss\n' \
		"$(gib_str "$DEPLOY_HARD_KIB")" "$(gib_str "$DEPLOY_SOFT_KIB")" "$(gib_str "$RATE_KIB")" "$RATE_WINDOW_SEC" \
		"$(gib_str "$RETRACT_MARGIN_KIB")" "$QUIET_SECONDS"
	printf 'DEPLOY_HARD_KIB=%s DEPLOY_SOFT_KIB=%s RATE_KIB=%s RETRACT_MARGIN_KIB=%s\narea=%s\n' \
		"$DEPLOY_HARD_KIB" "$DEPLOY_SOFT_KIB" "$RATE_KIB" "$RETRACT_MARGIN_KIB" "${AREA:-none}"
}

# Where the hibernation image goes (Daniel, 2026-10-10: "pointing to the
# file"). First the installer's /etc/initramfs-tools/conf.d/resume:
# RESUME= names the device (initramfs.conf(5)), RESUME_OFFSET= the swap
# file's first page on it; RESUME=none means no hibernation. Without a
# RESUME= line there, resume= and resume_offset= on the kernel command line
# (initramfs-tools(7)). The initramfs takes the command line's resume_offset=
# over the file's, so that one wins for the offset too. Returns 1 when no
# device is named; RESUME_NOTE says why.
resume_config() {
	local line word words=() from_file=0 cmd_resume="" cmd_offset="" file_offset="" noresume=0
	RESUME_SOURCE="" RESUME_SPEC="" RESUME_OFFSET_VALUE="" RESUME_NOTE=""
	if [[ -r $CMDLINE_PATH ]]; then
		read -r -a words <"$CMDLINE_PATH"
		for word in "${words[@]}"; do
			case $word in
			resume=*) cmd_resume=${word#resume=} ;;
			resume_offset=*) cmd_offset=${word#resume_offset=} ;;
			noresume) noresume=1 ;;
			esac
		done
	fi
	if [[ -r $INITRAMFS_RESUME_PATH ]]; then
		while IFS= read -r line || [[ -n $line ]]; do
			if [[ $line =~ ^[[:space:]]*RESUME=[\"\']?([^\"\'[:space:]#]*) ]]; then
				RESUME_SPEC=${BASH_REMATCH[1]} from_file=1
			elif [[ $line =~ ^[[:space:]]*RESUME_OFFSET=[\"\']?([0-9]*) ]]; then
				file_offset=${BASH_REMATCH[1]}
			fi
		done <"$INITRAMFS_RESUME_PATH"
	fi
	if ((from_file)); then
		RESUME_SOURCE=$INITRAMFS_RESUME_PATH
		RESUME_OFFSET_VALUE=${cmd_offset:-$file_offset}
		if [[ -n $cmd_resume && $cmd_resume != "$RESUME_SPEC" ]]; then
			RESUME_NOTE="the kernel command line's resume=$cmd_resume differs, and the initramfs takes that one"
		fi
	elif [[ -n $cmd_resume ]]; then
		RESUME_SOURCE="kernel command line"
		RESUME_SPEC=$cmd_resume RESUME_OFFSET_VALUE=$cmd_offset
	else
		RESUME_SOURCE=none
		RESUME_NOTE="no RESUME= in $INITRAMFS_RESUME_PATH and no resume= on the kernel command line"
		return 1
	fi
	if ((noresume)); then
		RESUME_NOTE="noresume on the kernel command line"
		return 1
	fi
	case $RESUME_SPEC in
	"" | none) RESUME_NOTE="RESUME=${RESUME_SPEC:-(empty)} in $RESUME_SOURCE: no hibernation"; return 1 ;;
	auto) RESUME_NOTE="RESUME=auto names no device here (mkinitramfs picks one when it builds the image)"; return 1 ;;
	esac
	return 0
}

# Is the swap file on this device (its file system's source, Btrfs
# subvolume brackets removed)?
on_device() {
	local source
	source=$("$FINDMNT_BIN" -n -o SOURCE -T "$1" 2>/dev/null) || return 1
	source=${source%%\[*}
	[[ -n $source && $(readlink -f -- "$source") == "$(readlink -f -- "$2")" ]]
}

# A swap file's first page on its device, the value resume_offset takes:
# filefrag's first physical extent in pages, or Btrfs's own answer.
file_offset() {
	local line page
	if [[ $(stat -f -c %T -- "$1" 2>/dev/null) == btrfs ]]; then
		"$BTRFS_BIN" inspect-internal map-swapfile -r "$1" 2>/dev/null
		return
	fi
	page=$(getconf PAGESIZE 2>/dev/null) || page=4096
	while read -r line; do
		if [[ $line =~ ^0:[[:space:]]+0\.\.[[:space:]]*[0-9]+:[[:space:]]+([0-9]+)\.\. ]]; then
			echo "${BASH_REMATCH[1]}"
			return
		fi
	done < <("$FILEFRAG_BIN" -v -b"$page" "$1" 2>/dev/null)
}

size_kib() {
	local sectors
	TARGET_SIZE_KIB=""
	if [[ -b $1 ]]; then
		read -r sectors 2>/dev/null <"$SYS_BLOCK_DIR/${1##*/}/size" && TARGET_SIZE_KIB=$((sectors / 2))
	elif [[ -f $1 ]]; then
		TARGET_SIZE_KIB=$(($(stat -c %s -- "$1") / 1024))
	fi
}

# The swap area resume_config names: the device itself (a swap partition or
# volume, which need not be in fstab), or with an offset the swap file on
# that device whose first page is there, among the Cushion Swap File's area
# and fstab's swap lines. TARGET_STATE: found; absent (nothing to look at
# now, for example not mounted yet); mismatch (swap files on that device,
# none at that offset: the initramfs would look in the wrong place).
resume_target() {
	TARGET="" TARGET_KIND="" TARGET_SIZE_KIB="" TARGET_NOTE="" TARGET_STATE=""
	resume_config || return 1
	spec_path "$RESUME_SPEC"
	local device=$SPEC_PATH
	if is_zram "$device"; then
		lang_code
		text_into RESUME_NOTE "$LANG_CODE" LOCAL24
		return 1
	fi
	if [[ -z $RESUME_OFFSET_VALUE || $RESUME_OFFSET_VALUE == 0 ]]; then
		TARGET_KIND='device'
		if [[ -e $device ]]; then
			TARGET=$device TARGET_STATE=found
			size_kib "$TARGET"
		else
			TARGET_STATE=absent TARGET_NOTE="$device is not present now"
		fi
		return 0
	fi
	TARGET_KIND='file'
	resolve_area
	local candidates=() spec _ type options rest candidate offset on=() unchecked=()
	[[ -f $AREA ]] && candidates+=("$AREA")
	if [[ -r $FSTAB_PATH ]]; then
		while read -r spec _ type options rest; do
			[[ $spec == /* && $type == swap && -f $spec && $spec != "$AREA" ]] && candidates+=("$spec")
		done <"$FSTAB_PATH"
	fi
	for candidate in "${candidates[@]}"; do
		on_device "$candidate" "$device" || continue
		on+=("$candidate")
		offset=$(file_offset "$candidate")
		if [[ $offset == "$RESUME_OFFSET_VALUE" ]]; then
			TARGET=$candidate
			break
		fi
		[[ -z $offset ]] && unchecked+=("$candidate")
	done
	if [[ -z $TARGET && ${#on[@]} == 1 && ${#unchecked[@]} == 1 ]]; then
		TARGET=${on[0]}
		TARGET_NOTE="its offset could not be read here (no filefrag), the only swap file on $device"
	fi
	if [[ -n $TARGET ]]; then
		TARGET_STATE=found
		size_kib "$TARGET"
	elif ((${#on[@]})); then
		TARGET_STATE=mismatch TARGET_NOTE="no swap file on $device starts at page $RESUME_OFFSET_VALUE (${on[*]} do not)"
	else
		TARGET_STATE=absent TARGET_NOTE="no swap file on $device was found now (the Cushion Swap File's area and $FSTAB_PATH were searched)"
	fi
	return 0
}

print_resume_target() {
	local rc=0
	resume_target || rc=1
	printf 'SOURCE=%s\nRESUME=%s\nRESUME_OFFSET=%s\nKIND=%s\nTARGET=%s\nSTATE=%s\nSIZE_KIB=%s\nNOTE=%s\n' \
		"$RESUME_SOURCE" "$RESUME_SPEC" "$RESUME_OFFSET_VALUE" "${TARGET_KIND:-}" "${TARGET:-}" "${TARGET_STATE:-}" \
		"${TARGET_SIZE_KIB:-}" "${TARGET_NOTE:-$RESUME_NOTE}"
	exit $rc
}

# The block device behind a swap area, as major:minor.
device_number() {
	local device=$1
	if [[ -f $device ]]; then
		device=$("$FINDMNT_BIN" -n -o SOURCE -T "$1" 2>/dev/null)
		device=${device%%\[*}
	fi
	stat -L -c '%Hr:%Lr' -- "$device" 2>/dev/null
}

# systemd-sleep hibernates only to the active swap area that matches the
# kernel's resume device, which the initramfs set at boot (systemd
# src/shared/hibernate-util.c, find_suitable_hibernation_device_full()).
kernel_resume_check() {
	local kernel="" offset=0 wanted
	read -r kernel 2>/dev/null <"$SYS_POWER_DIR/resume" || return 0
	read -r offset 2>/dev/null <"$SYS_POWER_DIR/resume_offset"
	if [[ -z $kernel || $kernel == 0:0 ]]; then
		log "hibernation: the kernel has no resume device yet; systemd-sleep sets it from the active swap area"
		return 0
	fi
	wanted=$(device_number "$TARGET")
	if [[ $kernel != "$wanted" ]] || [[ $TARGET_KIND == file && $offset != "$RESUME_OFFSET_VALUE" ]]; then
		log_err "hibernation: the kernel resumes from $kernel offset ${offset:-0} (set by the initramfs at boot), but $RESUME_SOURCE names $TARGET ($wanted offset ${RESUME_OFFSET_VALUE:-0}); systemd-sleep will refuse until the initramfs is rebuilt (update-initramfs -u) and the system restarted"
		problem_set hibernate-mismatch notice LOCAL13 "$kernel offset ${offset:-0}" "$RESUME_SOURCE" "$TARGET ($wanted offset ${RESUME_OFFSET_VALUE:-0})"
		return 1
	fi
	problem_clear hibernate-mismatch
}

# Hibernation needs the area on before systemd-sleep looks for it
# (systemd src/sleep/sleep.c: find_suitable_hibernation_device() runs
# before the system-sleep hooks). Each native sleep service calls this
# through ExecStartPre, whose failure prevents its ExecStart (systemd.service(5)).
# ExecStopPost ends the hold even if preparation or systemd-sleep fails.
hibernate_deploy() {
	local now
	if ! resume_target; then
		problem_set hibernate-swapon notice LOCAL14 "$RESUME_NOTE"
		exit 1
	fi
	if [[ -z $TARGET ]]; then
		log_err "hibernation: $RESUME_SOURCE names RESUME=$RESUME_SPEC${RESUME_OFFSET_VALUE:+ RESUME_OFFSET=$RESUME_OFFSET_VALUE}, but $TARGET_NOTE"
		problem_set hibernate-swapon notice LOCAL14 "$RESUME_SOURCE names RESUME=$RESUME_SPEC${RESUME_OFFSET_VALUE:+ RESUME_OFFSET=$RESUME_OFFSET_VALUE}, but $TARGET_NOTE"
		exit 1
	fi
	now_ms
	now=$((NOW_MS / 1000))
	mkdir -p "$STATE_DIR"
	# The marker must exist before swapon. Failure to keep it must block sleep.
	if ! printf '%s %s 0\n' "$now" "$TARGET" >"$HIBERNATE_MARK"; then
		problem_set hibernate-swapon notice LOCAL14 "cannot write $HIBERNATE_MARK"
		exit 1
	fi
	swap_state "$TARGET"
	case $? in
	0)
		printf '%s %s 0\n' "$now" "$TARGET" >"$HIBERNATE_MARK"
		log "hibernation: $TARGET is already on (from $RESUME_SOURCE)"
		;;
	1)
		if ! printf '%s %s 1\n' "$now" "$TARGET" >"$HIBERNATE_MARK"; then
			problem_set hibernate-swapon notice LOCAL14 "cannot write $HIBERNATE_MARK"
			exit 1
		fi
		local output rc
		output=$("$SWAPON_BIN" -- "$TARGET" 2>&1)
		rc=$?
		[[ -n $output ]] && printf '%s\n' "$output" >&2
		if ((rc != 0)); then
			rm -f "$HIBERNATE_MARK"
			log_err "hibernation: swapon $TARGET failed"
			problem_set hibernate-swapon notice LOCAL14 "swapon $TARGET failed (exit status $rc${output:+: ${output##*$'\n'}})"
			exit 1
		fi
		log "hibernation: $TARGET switched on for the image (from $RESUME_SOURCE)"
		;;
	*)
		log_err "hibernation: cannot read $SWAPS_PATH"
		problem_set hibernate-swapon notice LOCAL14 "cannot read $SWAPS_PATH"
		exit 1
		;;
	esac
	problem_clear hibernate-swapon
	[[ -n $RESUME_NOTE ]] && log "hibernation: note: $RESUME_NOTE"
	# a resume device the kernel does not share makes systemd-sleep refuse: the unit fails and says why
	kernel_resume_check || exit 1
	exit 0
}

# After resume: an area switched on only for the image goes off again when
# nothing stayed in it. Pages left in it are retracted by Daniel's rules.
hibernate_resume() {
	local since="" target="" switched=""
	[[ -e $HIBERNATE_MARK ]] || exit 0
	read -r since target switched <"$HIBERNATE_MARK" 2>/dev/null
	# Reset the quiet window even if the daemon slept for the entire operation.
	now_ms
	PREV_EPOCH=0 PREV_AVAIL_KIB=0 PREV_MS=0 LAST_FAIL_LOG_EPOCH=0
	LAST_DANGER_EPOCH=$((NOW_MS / 1000))
	if ! printf '0 0 %s 0 0\n' "$LAST_DANGER_EPOCH" >"$STATE_FILE" || ! rm -f "$HIBERNATE_MARK"; then
		problem_set action-lock notice LOCAL23 "$STATE_DIR"
		exit 1
	fi
	[[ $switched == 1 && -n $target ]] || exit 0
	swap_state "$target"
	case $? in
	0)
		if ((SWAP_USED_KIB == 0)); then
			local output rc
			output=$("$SWAPOFF_BIN" -- "$target" 2>&1)
			rc=$?
			[[ -n $output ]] && printf '%s\n' "$output" >&2
			if ((rc != 0)); then
				log_err "after resume: swapoff $target failed (exit status $rc)"
				problem_set resume-swapoff notice LOCAL15 "$target" "exit status $rc${output:+: ${output##*$'\n'}}"
				exit 1
			fi
			log "after resume: $target was empty, switched off again"
		else
			log "after resume: $target holds $(gib_str "$SWAP_USED_KIB"); the daemon retracts it when it is safe"
		fi
		;;
	1) log "after resume: $target is already off" ;;
	*)
		log_err "after resume: cannot read $SWAPS_PATH, so $target is left as it is"
		problem_set resume-swapoff notice LOCAL15 "$target" "cannot read $SWAPS_PATH"
		exit 1
		;;
	esac
	problem_clear resume-swapoff
	exit 0
}

# problem_message VAR LANG FILE: a kept problem's message in LANG
problem_message() {
	# the record's text, in the language $2, from the engine (its catalogs are this package's language files)
	local _code=${3##*/${PROBLEM_PKG}_} _out
	_code=${_code%.json}
	_out=$("$PROBLEMS_BIN" text --boot --lang "$2" "$PROBLEM_PKG" "$_code" 2>&1)
	printf -v "$1" '%s' "$_out"
}

# The service as systemd has it, for a daemon that is not running: active state, result, unit file state.
unit_state() {
	local out
	out=$("$SYSTEMCTL_BIN" show -p ActiveState -p SubState -p Result -p UnitFileState cushion-swap.service 2>&1) ||
		{ printf -v "$1" 'systemctl cannot say (%s)' "${out##*$'\n'}"; return; }
	out=${out//$'\n'/, }
	printf -v "$1" 'cushion-swap.service: %s' "$out"
}

# --status: the file the page reads, and an exit status a script can trust (help text above).
print_status() {
	local text line protection="" state="" pid="" problems="" why
	if [[ ! -e $STATUS_FILE ]]; then
		unit_state why
		if [[ $CUSHION_SWAP == off ]]; then
			printf 'STATE=disabled\nPROTECTION=no\nREASON=CUSHION_SWAP=off in %s\n' "$CONFIG"
		else
			printf 'STATE=stopped\nPROTECTION=no\nREASON=not running (%s)\n' "$why"
		fi
		exit 3
	fi
	if ! text=$(cat -- "$STATUS_FILE" 2>&1); then
		printf 'STATE=unknown\nPROTECTION=unknown\nREASON=cannot read %s: %s\n' "$STATUS_FILE" "${text##*: }"
		exit 4
	fi
	printf '%s\n' "$text"
	while IFS= read -r line; do
		case $line in
		STATE=*) state=${line#STATE=} ;; PROTECTION=*) protection=${line#PROTECTION=} ;;
		PID=*) pid=${line#PID=} ;; PROBLEMS=*) problems=${line#PROBLEMS=} ;;
		esac
	done <<<"$text"
	case $state in stopped | disabled) exit 3 ;; esac
	# a status left by a daemon that is gone is not a running one
	if [[ -n $pid && ! -d $PROC_DIR/$pid ]]; then
		printf 'RUNNING=no\n'
		exit 3
	fi
	case $protection in
	yes) [[ -z $problems ]] && exit 0; exit 1 ;;
	degraded) exit 1 ;;
	no) exit 2 ;;
	*) exit 4 ;;
	esac
}

# --problems: each kept problem in the system's language (the English line beside it); exit 1 while any.
print_problems() {
	local file code message english found=0
	lang_code
	for file in "$PROBLEM_DIR/${PROBLEM_PKG}_"*.json; do
		[[ -f $file ]] || continue
		found=1
		problem_message message "$LANG_CODE" "$file"
		code=${file##*/${PROBLEM_PKG}_}
		printf '%s: %s\n' "${code%.json}" "$message"
		if [[ $LANG_CODE != en ]]; then
			problem_message english en "$file"
			printf '  (en) %s\n' "$english"
		fi
	done
	if ((!found)); then
		text_into message "$LANG_CODE" LOCAL17
		printf '%s\n' "$message"
		[[ -e $STATUS_FILE ]] || { unit_state english; text_into message "$LANG_CODE" LOCAL20 "$english"; printf '%s\n' "$message"; exit 3; }
		exit 0
	fi
	exit 1
}

# ExecStopPost: why the daemon is no longer running, from systemd's SERVICE_RESULT, EXIT_CODE and EXIT_STATUS
# (systemd.exec(5)). A stop that was not asked for is a problem; a stop the person or the shutdown asked for
# ends the daemon's own problems. CUSHION_SWAP=off keeps its "disabled".
stopped() {
	local line state="" code why
	if [[ -r $STATUS_FILE ]]; then
		while IFS= read -r line; do [[ $line == STATE=* ]] && state=${line#STATE=}; done <"$STATUS_FILE"
	fi
	[[ $state == disabled ]] && exit 0
	# the daemon is gone: no PID, and nothing more for systemd's status line
	STATUS_PID="" NOTIFY_SOCKET=""
	mkdir -p "$STATE_DIR"
	if [[ -n ${SERVICE_RESULT:-} && $SERVICE_RESULT != success ]]; then
		why="result $SERVICE_RESULT, ${EXIT_CODE:-?} ${EXIT_STATUS:-?}"
		problem_set service-failed no LOCAL12 "$why"
	else
		why="stopped"
		for code in $DAEMON_PROBLEMS; do problem_clear "$code"; done
	fi
	STATUS_TEXT=""
	write_status stopped
	exit 0
}

# --wait-ready EPOCH: after the package restarted the unit, a daemon started since EPOCH must be running and say
# whether it protects memory. The person's own switches (CUSHION_SWAP=off, a disabled or masked unit) are said as
# their choice. Exit 1 when it did not start.
wait_ready() {
	local since=$1 i line started=0 pid="" protection="" enabled why file message
	if [[ $CUSHION_SWAP == off ]]; then
		say LOCAL21 "CUSHION_SWAP=off in $CONFIG"
		return 0
	fi
	if [[ -e ${CGM_PARACHUTE_UNIT:-/etc/systemd/system/cgm-swap-parachute.service} ]]; then
		say LOCAL21 "cgm-swap-parachute.service is in charge here"
		return 0
	fi
	enabled=$("$SYSTEMCTL_BIN" is-enabled cushion-swap.service 2>/dev/null)
	case $enabled in
	disabled | masked | masked-runtime)
		if ! "$SYSTEMCTL_BIN" --quiet is-active cushion-swap.service; then
			say LOCAL21 "cushion-swap.service is $enabled"
			return 0
		fi
		;;
	esac
	for ((i = 0; i < ${READY_WAIT_SEC:-20} * 10; i++)); do
		started=0 pid="" protection=""
		if [[ -r $STATUS_FILE ]]; then
			while IFS= read -r line; do
				case $line in STARTED=*) started=${line#STARTED=} ;; PID=*) pid=${line#PID=} ;; PROTECTION=*) protection=${line#PROTECTION=} ;; esac
			done <"$STATUS_FILE"
		fi
		[[ $started =~ ^[0-9]+$ ]] || started=0
		((started >= since)) && [[ -n $pid && -d $PROC_DIR/$pid ]] && break
		started=0
		sleep 0.1
	done
	if ((started < since)); then
		unit_state why
		say LOCAL22 "$why"
		return 1
	fi
	if [[ $protection != yes ]]; then
		say LOCAL18
		for file in "$PROBLEM_DIR/${PROBLEM_PKG}_"*.json; do
			[[ -f $file ]] || continue
			lang_code
			problem_message message "$LANG_CODE" "$file"
			printf 'cushion-swap: %s\n' "$message" >&2
		done
	fi
	return 0
}

# --notify: the session's notifier (sparky-stereo-problems-plasma) shows every kept problem: this starts it.
notify_session() {
	"$SYSTEMCTL_BIN" --user start sparky-stereo-problems-notifier.service
}

while [[ $# -gt 0 ]]; do
	case $1 in
	--dry-run) DRY_RUN=1; shift ;;
	--once) RUN_ONCE=1; shift ;;
	--interval) POLL_INTERVAL_SEC=$2; shift 2 ;;
	--thresholds) print_thresholds; exit 0 ;;
	--status) print_status ;;
	--problems) print_problems ;;
	--resume-target) print_resume_target ;;
	--hibernate-deploy) lock_actions || exit 1; hibernate_deploy; exit $? ;;
	--hibernate-resume) lock_actions || exit 1; hibernate_resume; exit $? ;;
	--stopped) stopped ;;
	--wait-ready) wait_ready "${2:?--wait-ready needs the epoch the restart began}"; exit $? ;;
	--notify) notify_session; exit $? ;;
	--say) shift; say "$@"; exit 0 ;;
	--help | -h) print_help; exit 0 ;;
	*)
		log_err "unknown argument: $1"
		exit 2
		;;
	esac
done

resolve_area
now_ms
STARTED=$((NOW_MS / 1000))

if [[ $CUSHION_SWAP == off ]]; then
	[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "Cushion Swap File is off ($CONFIG: CUSHION_SWAP=off); the swap state is left as it is"
	if ((!DRY_RUN)); then
		# the person's choice: no problem of the daemon's holds, and the status says memory is not protected
		for code in $DAEMON_PROBLEMS; do problem_clear "$code"; done
		REASON_OFF="CUSHION_SWAP=off in $CONFIG"
		write_status disabled
	fi
	exit 0
fi

if ((DRY_RUN)); then
	log "cushion-swap: starting in --dry-run mode (no swapon/swapoff will be executed; MEMINFO_PATH=${MEMINFO_PATH} SWAPS_PATH=${SWAPS_PATH} STATE_DIR=${STATE_DIR} area=${AREA:-none})"
elif [[ $LOG_EVERY_CYCLE == yes ]]; then
	log_cycle "cushion-swap: starting (area=${AREA:-none} pacing=${PACING} poll=${POLL_INTERVAL_SEC}s rate_window=${RATE_WINDOW_SEC}s quiet=${QUIET_SECONDS}s every_cycle=${LOG_EVERY_CYCLE})"
fi

if ((RUN_ONCE)); then
	# one cycle, no daemon left behind: its status names no PID
	STATUS_PID=""
	run_cycle
	exit 0
fi

mkdir -p "$STATE_DIR"
[[ -p $STATE_DIR/tick ]] || mkfifo -m 600 "$STATE_DIR/tick"
exec {SLEEP_FD}<>"$STATE_DIR/tick"
MIN_MS=$(to_ms "$MIN_INTERVAL_SEC") POLL_MS=$(to_ms "$POLL_INTERVAL_SEC") TICK_MS=$(to_ms "$SAFETY_TICK_SEC") FAST_MS=$(to_ms "$FAST_INTERVAL_SEC")
load_calibration
start_psi
run_cycle
[[ $LOG_EVERY_CYCLE == yes ]] && log_cycle "thresholds ($THRESHOLD_SOURCE, MemTotal $(gib_str "$MEM_TOTAL_KIB")): hard $(gib_str "$DEPLOY_HARD_KIB") soft $(gib_str "$DEPLOY_SOFT_KIB") rate $(gib_str "$RATE_KIB")/${RATE_WINDOW_SEC}s margin $(gib_str "$RETRACT_MARGIN_KIB") quiet ${QUIET_SECONDS}s"
SERVICE_OK_MS=$((STARTED * 1000 + SERVICE_OK_AFTER_SEC * 1000))
while true; do
	calibrate_when_idle
	wait_next
	run_cycle
	# a daemon that stopped unexpectedly is fixed once this one has run a while (a restart loop stays one problem)
	if ((SERVICE_OK_MS)) && ((CYCLE_NOW_MS >= SERVICE_OK_MS)); then
		problem_clear service-failed
		SERVICE_OK_MS=0
	fi
done
