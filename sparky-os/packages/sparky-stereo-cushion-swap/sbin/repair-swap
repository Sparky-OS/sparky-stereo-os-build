"""Apply the swap layout when the person invokes a Problems repair."""
import fcntl
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

CUSHION = "/usr/sbin/cushion-swap"
FSTAB = Path("/etc/fstab")
RESUME = Path("/etc/initramfs-tools/conf.d/resume")
SWAP = Path("/swapfile")
STATE = Path("/run/cushion-swap")
ADOPTED = Path("/var/lib/cushion-swap/adopted")
MIB = 1024 ** 2


def output(*command):
    return subprocess.check_output(command, text=True).strip()


def write_config(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as new:
        temporary = Path(new.name)
        try:
            mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
            os.fchmod(new.fileno(), mode)
            new.write(data)
            new.flush()
            os.fsync(new.fileno())
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


def resume_target():
    result = subprocess.run([CUSHION, "--resume-target"], text=True, capture_output=True, check=False)
    if result.returncode not in (0, 1):
        raise ValueError(result.stderr or "Cushion Swap could not read the resume target")
    return dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)


def memory():
    return {key.rstrip(":"): int(value) for key, value, *_ in
            (line.split() for line in Path("/proc/meminfo").read_text().splitlines())}


def active_areas():
    return {fields[0]: int(fields[3]) for fields in
            (row.split() for row in Path("/proc/swaps").read_text().splitlines()[1:])}


def current_configuration(mode, total):
    fstab = FSTAB.read_bytes()
    lines = [line.split() for line in fstab.decode().splitlines() if not line.lstrip().startswith("#")]
    swaps = [line for line in lines if len(line) >= 4 and line[2] == "swap"]
    explicit = Path("/etc/default/cushion-swap").read_text()
    area = re.search(r"(?m)^[ \t]*AREA=([^#\n]*)", explicit)
    if area and area[1].strip().strip("\"'"):
        raise ValueError("Cushion Swap already has an area set in /etc/default/cushion-swap")
    if re.search(r"(?m)^\s*CUSHION_SWAP=[\"']?off(?:[\s\"']|$)", explicit):
        raise ValueError("Cushion Swap is switched off in /etc/default/cushion-swap")
    cmdline = Path("/proc/cmdline").read_text().split()
    if mode == "hibernate" and ("noresume" in cmdline or
            re.search(r"(?m)^\s*HIBERNATE=[\"']?off(?:[\s\"']|$)", explicit)):
        raise ValueError("Hibernation is explicitly disabled in this system's settings")
    resume = resume_target()
    partition = None
    if resume.get("STATE") == "found" and resume.get("KIND") == "device":
        device = Path(resume["TARGET"])
        if stat.S_ISBLK(device.stat().st_mode) and output("blkid", "-s", "TYPE", "-o", "value", str(device)) == "swap":
            partition = device
    enough = int(resume.get("SIZE_KIB") or 0) >= total
    if mode == "hibernate" and partition and not enough:
        if any(arg.startswith("resume=") for arg in cmdline):
            raise ValueError("The boot configuration still names a smaller resume area")
    if mode == "cushion" and swaps:
        raise ValueError("There is already a swap entry in /etc/fstab. Review which area to give to Cushion Swap.")
    if swaps:
        old = ADOPTED.read_text() if ADOPTED.exists() else ""
        managed = any(line.split()[1:] == ["installer", str(SWAP)] or
                      line.split()[1:] == ["repair", str(SWAP)] for line in old.splitlines())
        if (len(swaps) != 1 or swaps[0] not in ([str(SWAP), "swap", "swap", "noauto", "0", "0"],
                                                [str(SWAP), "none", "swap", "noauto", "0", "0"]) or not managed):
            raise ValueError("The swap entries in /etc/fstab were not made by the installer or this repair")
    if SWAP.is_symlink() or (SWAP.exists() and
                            (not swaps or not SWAP.is_file() or SWAP.stat().st_nlink != 1)):
        raise ValueError("An existing /swapfile is outside this repair's managed area")
    if not partition and mode == "hibernate" and any(arg.startswith("resume=") for arg in cmdline):
        raise ValueError("The boot configuration has an explicit resume device. Review it before changing the resume area.")
    return fstab, swaps, partition, enough


def allocate_swap(path, size):
    if output("findmnt", "-n", "-o", "FSTYPE", "-T", str(path.parent)) not in {"ext4", "xfs"}:
        raise ValueError("This repair can prepare a swap file on ext4 or XFS")
    with open(path, "xb", opener=lambda name, flags: os.open(name, flags, 0o600)) as swap:
        os.posix_fallocate(swap.fileno(), 0, size)
        os.fsync(swap.fileno())
    subprocess.run(["mkswap", path], check=True)


def file_resume(path):
    uuid = output("findmnt", "-n", "-o", "UUID", "-T", str(path))
    pagesize = os.sysconf("SC_PAGE_SIZE")
    result = subprocess.check_output(["filefrag", "-v", f"-b{pagesize}", path],
                                     text=True, env=dict(os.environ, LC_ALL="C"))
    first = re.search(r"^\s*0:\s+0\.\.\s*\d+:\s+(\d+)\.\.", result, re.MULTILINE)
    if not uuid or not first or int(first[1]) == 0:
        raise ValueError("Could not read the filesystem UUID and first page of the prepared swap file")
    return f"RESUME=UUID={uuid}\nRESUME_OFFSET={first[1]}\n".encode("ascii")


def repair(mode):
    numbers = memory()
    total = numbers["MemTotal"]
    fstab, swaps, partition, enough = current_configuration(mode, total)
    if (STATE / "hibernate-deployed").exists():
        raise ValueError("Wait for the hibernation operation to finish")
    before = active_areas()
    if str(SWAP) in before:
        raise ValueError("The swap file is active. Retry once Cushion Swap has released it.")
    used = before.get(str(partition))
    if used and numbers["MemAvailable"] <= used + 512 * 1024:
        raise ValueError("The hibernation partition still holds more pages than can safely fit back in memory")
    size = (total // 1024 + 1) * MIB
    space = os.statvfs(SWAP.parent)
    free = space.f_bavail * space.f_frsize
    if free < size + 20 * 1024 ** 3:
        if mode == "hibernate" or free < 512 * MIB:
            raise ValueError("The machine needs enough space for a swap file the size of memory and 20 GiB left free")
        size = 512 * MIB
    old_resume = RESUME.read_bytes() if RESUME.exists() else None
    if mode == "cushion" and not partition and old_resume not in (None, b"RESUME=none\n"):
        raise ValueError("Review the existing resume setting before creating a different swap area")
    with tempfile.TemporaryDirectory(prefix=".sparky-swap-repair-", dir=SWAP.parent) as scratch:
        new = Path(scratch) / "swapfile"
        old = Path(scratch) / "previous"
        allocate_swap(new, size)
        use_file_for_resume = mode == "hibernate" and not (partition and enough)
        new_resume = file_resume(new) if use_file_for_resume else old_resume
        if partition and used is not None:
            subprocess.run(["swapoff", partition], check=True)
        try:
            if SWAP.exists():
                old.hardlink_to(SWAP)
            new.replace(SWAP)
            if not swaps:
                separator = b"" if fstab.endswith(b"\n") else b"\n"
                write_config(FSTAB, fstab + separator + b"/swapfile none swap noauto 0 0\n")
            if new_resume != old_resume:
                write_config(RESUME, new_resume)
                subprocess.run(["update-initramfs", "-u", "-k", "all"], check=True)
        except (OSError, subprocess.CalledProcessError):
            if not new.exists():
                if old.exists():
                    old.replace(SWAP)
                else:
                    SWAP.unlink(missing_ok=True)
            write_config(FSTAB, fstab)
            if new_resume != old_resume:
                if old_resume is None:
                    RESUME.unlink(missing_ok=True)
                else:
                    write_config(RESUME, old_resume)
                subprocess.run(["update-initramfs", "-u", "-k", "all"], check=True)
            if partition and used is not None:
                subprocess.run(["swapon", partition], check=True)
            raise
    ADOPTED.parent.mkdir(parents=True, exist_ok=True)
    with ADOPTED.open("a") as log:
        log.write(output("date", "-u", "+%Y-%m-%dT%H:%M:%SZ") + " repair /swapfile\n")
    print("The swap file is ready for Cushion Swap. Restart to apply the boot settings.")


if __name__ == "__main__":
    if os.geteuid() != 0 or sys.argv[1:] not in (["hibernate"], ["cushion"]):
        sys.exit("This repair needs authorization and a hibernate or cushion request")
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with (STATE / "swap-actions.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            repair(sys.argv[1])
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "try-restart", "cushion-swap.service"], check=True)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
