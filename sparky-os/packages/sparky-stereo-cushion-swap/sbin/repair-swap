"""Apply the swap layout when the person invokes a Problems repair."""
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile

CUSHION = "/usr/sbin/cushion-swap"
FSTAB = Path("/etc/fstab")
RESUME = Path("/etc/initramfs-tools/conf.d/resume")
# dracut's initramfs resumes only from resume= and resume_offset= on the kernel command line
# (systemd-hibernate-resume-generator(8)); grub-mkconfig reads this file after /etc/default/grub
DRACUT_RESUME = Path("/etc/default/grub.d/zz-cushion-swap-resume.cfg")
DRACUT_LINE = b"""\
case " ${GRUB_CMDLINE_LINUX:-} ${GRUB_CMDLINE_LINUX_DEFAULT:-} " in
*" resume="* | *" noresume "*) ;;
*) GRUB_CMDLINE_LINUX="${GRUB_CMDLINE_LINUX:+$GRUB_CMDLINE_LINUX }resume=$RESUME${RESUME_OFFSET:+ resume_offset=$RESUME_OFFSET}" ;;
esac
unset RESUME RESUME_OFFSET
"""
DRACUT_HEAD = b"""\
# Written by Cushion Swap's hibernation repair (sparky-stereo-cushion-swap), for dracut:
# its initramfs resumes only from resume= and resume_offset= on the kernel command line.
# update-grub reads this file after /etc/default/grub; a resume= or noresume already on the line is kept.
"""
SWAP = Path("/swapfile")
STATE = Path("/run/cushion-swap")
ADOPTED = Path("/var/lib/cushion-swap/adopted")
MIB = 1024 ** 2
PACKAGE = "sparky-stereo-cushion-swap"
# stable exit statuses for the Problems page; pkexec reserves 126 and 127
RESULTS = {0: "LOCAL27", **{code: f"LOCAL{code - 12}" for code in range(40, 58)}}


class Refusal(Exception):
    def __init__(self, code, detail):
        super().__init__(detail)
        self.code = code


def result(code, detail=None):
    if detail:
        logged = subprocess.run(["logger", "-t", "cushion-swap-repair", "--", detail], check=False)
        if logged.returncode:
            print(detail, file=sys.stderr)
    subprocess.run([CUSHION, "--say", RESULTS[code]], check=True)
    return code


def output(*command):
    return subprocess.check_output(command, text=True, stderr=subprocess.STDOUT).strip()


def write_config(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as new:
        temporary = Path(new.name)
        try:
            mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
            os.fchmod(new.fileno(), mode)
            new.write(data)
            new.flush()
            os.fsync(new.fileno())
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


def resume_target():
    result = subprocess.run([CUSHION, "--resume-target"], text=True, capture_output=True, check=False)
    if result.returncode not in (0, 1):
        raise Refusal(55, result.stderr or "Cushion Swap could not read the resume target")
    return dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)


def boot_config(generator):
    """Where this system's initramfs generator reads the resume area, what applies it, and why it cannot."""
    if generator == "initramfs-tools":
        return RESUME, [["update-initramfs", "-u", "-k", "all"]], None
    if generator == "dracut":
        if shutil.which("update-grub") is None:
            return DRACUT_RESUME, None, Refusal(57, "dracut resumes only from the kernel command line, and update-grub "
                                                   "is not installed to put resume= there")
        return DRACUT_RESUME, [["update-grub"]], None
    return None, None, Refusal(56, "Neither initramfs-tools nor dracut is installed, so no boot image can be told "
                                   "where to resume from")


def dracut_config(resume):
    return DRACUT_HEAD + resume + DRACUT_LINE


def explicit_resume(cmdline, generator):
    """resume= arguments on the kernel command line other than the one this repair put there for dracut."""
    ours = None
    if generator == "dracut" and DRACUT_RESUME.exists():
        found = re.search(rb"(?m)^RESUME=(\S+)$", DRACUT_RESUME.read_bytes())
        ours = "resume=" + found[1].decode() if found else None
    return [arg for arg in cmdline if arg.startswith("resume=") and arg != ours]


def memory():
    return {key.rstrip(":"): int(value) for key, value, *_ in
            (line.split() for line in Path("/proc/meminfo").read_text().splitlines())}


def active_areas():
    return {fields[0]: int(fields[3]) for fields in
            (row.split() for row in Path("/proc/swaps").read_text().splitlines()[1:])}


def current_configuration(mode, total, swapfile):
    fstab = FSTAB.read_bytes()
    lines = [line.split() for line in fstab.decode().splitlines() if not line.lstrip().startswith("#")]
    swaps = [line for line in lines if len(line) >= 4 and line[2] == "swap"]
    explicit = Path("/etc/default/cushion-swap").read_text()
    area = re.search(r"(?m)^[ \t]*AREA=([^#\n]*)", explicit)
    if area and area[1].strip().strip("\"'"):
        raise Refusal(40, "Cushion Swap already has an area set in /etc/default/cushion-swap")
    if re.search(r"(?m)^\s*CUSHION_SWAP=[\"']?off(?:[\s\"']|$)", explicit):
        raise Refusal(41, "Cushion Swap is switched off in /etc/default/cushion-swap")
    cmdline = Path("/proc/cmdline").read_text().split()
    if mode == "hibernate" and ("noresume" in cmdline or
            re.search(r"(?m)^\s*HIBERNATE=[\"']?off(?:[\s\"']|$)", explicit)):
        raise Refusal(42, "Hibernation is explicitly disabled in this system's settings")
    resume = resume_target()
    generator = resume.get("GENERATOR", "none")
    explicit = explicit_resume(cmdline, generator)
    partition = None
    if resume.get("STATE") == "found" and resume.get("KIND") == "device":
        device = Path(resume["TARGET"])
        if stat.S_ISBLK(device.stat().st_mode) and output("blkid", "-s", "TYPE", "-o", "value", str(device)) == "swap":
            partition = device
    enough = int(resume.get("SIZE_KIB") or 0) >= total
    if mode == "hibernate" and partition and not enough:
        if explicit:
            raise Refusal(43, "The boot configuration still names a smaller resume area")
    if mode == "cushion" and swaps:
        raise Refusal(44, "There is already a swap entry in /etc/fstab. Review which area to give to Cushion Swap.")
    if swaps:
        old = ADOPTED.read_text() if ADOPTED.exists() else ""
        managed = any(line.split()[1:] == ["installer", str(swapfile)] or
                      line.split()[1:] == ["repair", str(swapfile)] for line in old.splitlines())
        if (len(swaps) != 1 or swaps[0] not in ([str(swapfile), "swap", "swap", "noauto", "0", "0"],
                                                [str(swapfile), "none", "swap", "noauto", "0", "0"]) or not managed):
            raise Refusal(44, "The swap entries in /etc/fstab were not made by the installer or this repair")
    if swapfile.is_symlink() or (swapfile.exists() and
                            (not swaps or not swapfile.is_file() or swapfile.stat().st_nlink != 1)):
        raise Refusal(45, f"{swapfile} is outside this repair's managed area")
    if not partition and mode == "hibernate" and explicit:
        raise Refusal(43, "The boot configuration has an explicit resume device. Review it before changing the resume area.")
    return fstab, swaps, partition, enough, generator


def allocate_swap(path, size, btrfs):
    if btrfs:
        output("btrfs", "filesystem", "mkswapfile", "--size", str(size), str(path))
        path.chmod(0o600)
        return
    with open(path, "xb", opener=lambda name, flags: os.open(name, flags, 0o600)) as swap:
        os.posix_fallocate(swap.fileno(), 0, size)
        os.fsync(swap.fileno())
    output("mkswap", str(path))


def file_resume(path, btrfs):
    uuid = output("findmnt", "-n", "-o", "UUID", "-T", str(path))
    if btrfs:
        offset = output("btrfs", "inspect-internal", "map-swapfile", "-r", str(path))
    else:
        pagesize = os.sysconf("SC_PAGE_SIZE")
        result = subprocess.check_output(["filefrag", "-v", f"-b{pagesize}", path],
                                         text=True, stderr=subprocess.STDOUT,
                                         env=dict(os.environ, LC_ALL="C"))
        first = re.search(r"^\s*0:\s+0\.\.\s*\d+:\s+(\d+)\.\.", result, re.MULTILINE)
        offset = first[1] if first else ""
    if not uuid or not offset.isdecimal() or int(offset) == 0:
        raise Refusal(52, f"Invalid filesystem UUID or resume page offset for {path}")
    return f"RESUME=UUID={uuid}\nRESUME_OFFSET={offset}\n".encode("ascii")


@contextmanager
def swap_directory(path, btrfs):
    created = btrfs and not path.exists()
    if btrfs:
        if path.is_symlink():
            raise Refusal(46, f"{path} is a symbolic link")
        if created:
            output("btrfs", "subvolume", "create", str(path))
    try:
        if btrfs:
            if created:
                path.chmod(0o700)
            try:
                output("btrfs", "subvolume", "show", str(path))
            except subprocess.CalledProcessError as error:
                raise Refusal(46, f"{path}: {error.output}") from error
            info = path.stat()
            if info.st_dev == path.parent.stat().st_dev or info.st_uid != 0 or info.st_mode & 0o022:
                raise Refusal(46, f"{path}: expected a root-owned Btrfs subvolume without group or other write "
                                  f"access (UID={info.st_uid}, mode={stat.S_IMODE(info.st_mode):o}, "
                                  f"device={info.st_dev}, parent device={path.parent.stat().st_dev})")
        yield
    finally:
        if created and not any(path.iterdir()):
            output("btrfs", "subvolume", "delete", str(path))


def repair(mode):
    numbers = memory()
    total = numbers["MemTotal"]
    filesystem = output("findmnt", "-n", "-o", "FSTYPE", "-T", "/")
    if filesystem not in {"ext4", "xfs", "btrfs"}:
        raise Refusal(47, f"Root filesystem is {filesystem}")
    btrfs = filesystem == "btrfs"
    swapfile = Path("/swap/swapfile") if btrfs else SWAP
    fstab, swaps, partition, enough, generator = current_configuration(mode, total, swapfile)
    config, apply, cannot = boot_config(generator)
    use_file_for_resume = mode == "hibernate" and not (partition and enough)
    if use_file_for_resume and cannot:
        raise cannot
    if (STATE / "hibernate-deployed").exists():
        raise Refusal(48, "Wait for the hibernation operation to finish")
    before = active_areas()
    if str(swapfile) in before:
        raise Refusal(49, "The swap file is active. Retry once Cushion Swap has released it.")
    used = before.get(str(partition))
    if used and numbers["MemAvailable"] <= used + 512 * 1024:
        raise Refusal(50, "The hibernation partition still holds more pages than can safely fit back in memory")
    size = (total // 1024 + 1) * MIB
    space = os.statvfs(swapfile.parent if swapfile.parent.exists() else "/")
    free = space.f_bavail * space.f_frsize
    if free < size + 20 * 1024 ** 3:
        if mode == "hibernate" or free < 512 * MIB:
            raise Refusal(51, "The machine needs enough space for a swap file the size of memory and 20 GiB left free")
        size = 512 * MIB
    old_resume = config.read_bytes() if config and config.exists() else None
    if mode == "cushion" and not partition and old_resume not in (None, b"RESUME=none\n"):
        raise Refusal(43, "Review the existing resume setting before creating a different swap area")
    with (swap_directory(swapfile.parent, btrfs),
          tempfile.TemporaryDirectory(prefix=".sparky-swap-repair-", dir=swapfile.parent) as scratch):
        new = Path(scratch) / "swapfile"
        old = Path(scratch) / "previous"
        allocate_swap(new, size, btrfs)
        file_config = file_resume(new, btrfs) if btrfs or use_file_for_resume else None
        if file_config and generator == "dracut":
            file_config = dracut_config(file_config)
        new_resume = file_config if use_file_for_resume else old_resume
        if partition and used is not None:
            subprocess.run(["swapoff", partition], check=True)
        try:
            if swapfile.exists():
                old.hardlink_to(swapfile)
            new.replace(swapfile)
            if not swaps:
                separator = b"" if fstab.endswith(b"\n") else b"\n"
                write_config(FSTAB, fstab + separator + f"{swapfile} none swap noauto 0 0\n".encode("ascii"))
            if new_resume != old_resume:
                write_config(config, new_resume)
                for command in apply:
                    subprocess.run(command, check=True)
        except (OSError, subprocess.CalledProcessError):
            if not new.exists():
                if old.exists():
                    old.replace(swapfile)
                else:
                    swapfile.unlink(missing_ok=True)
            write_config(FSTAB, fstab)
            if new_resume != old_resume:
                if old_resume is None:
                    config.unlink(missing_ok=True)
                else:
                    write_config(config, old_resume)
                for command in apply:
                    subprocess.run(command, check=True)
            if partition and used is not None:
                subprocess.run(["swapon", partition], check=True)
            raise
    ADOPTED.parent.mkdir(parents=True, exist_ok=True)
    with ADOPTED.open("a") as log:
        log.write(output("date", "-u", "+%Y-%m-%dT%H:%M:%SZ") + f" repair {swapfile}\n")


if __name__ == "__main__":
    if sys.argv[1:] == ["--feedback"]:
        print(json.dumps({"package": PACKAGE, "messages": RESULTS}, separators=(",", ":")))
        sys.exit(0)
    if os.geteuid() != 0 or sys.argv[1:] not in (["hibernate"], ["cushion"]):
        sys.exit(result(53, "This repair needs authorization and a hibernate or cushion request"))
    os.umask(0o077)
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with (STATE / "swap-actions.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            repair(sys.argv[1])
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "try-restart", "cushion-swap.service"], check=True)
    except Refusal as error:
        sys.exit(result(error.code, str(error)))
    except subprocess.CalledProcessError as error:
        sys.exit(result(54, f"{error}\n{error.output or ''}".strip()))
    except (OSError, ValueError) as error:
        sys.exit(result(55, str(error)))
    sys.exit(result(0))
