[Unit]
Description=Sparky Stereo OS: show the kept memory protection problems
Documentation=file:///usr/share/doc/sparky-stereo-cushion-swap/README.md
# people's sessions only: the login screen's accounts are system users
ConditionUser=!@system
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/cushion-swap --notify

[Install]
WantedBy=graphical-session.target
