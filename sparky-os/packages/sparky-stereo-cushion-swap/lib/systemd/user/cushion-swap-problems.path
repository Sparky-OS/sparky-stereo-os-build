[Unit]
Description=Sparky Stereo OS: a memory protection problem was kept
Documentation=file:///usr/share/doc/sparky-stereo-cushion-swap/README.md
# people's sessions only: the login screen's accounts are system users
ConditionUser=!@system

[Path]
PathChanged=/run/cushion-swap/problems
Unit=cushion-swap-problems.service

[Install]
WantedBy=graphical-session.target
