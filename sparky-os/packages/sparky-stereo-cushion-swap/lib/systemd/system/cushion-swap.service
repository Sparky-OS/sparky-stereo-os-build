[Unit]
Description=Cushion Swap File (swap deployed under memory pressure)
Documentation=file:///usr/share/doc/sparky-stereo-cushion-swap/README.md
After=local-fs.target swap.target
Before=systemd-oomd.service
# Daniel's own host version stays in charge where it is installed.
ConditionPathExists=!/etc/systemd/system/cgm-swap-parachute.service

[Service]
Type=simple
ExecStart=/usr/sbin/cushion-swap
Restart=on-failure
RestartSec=3
OOMScoreAdjust=-1000
RuntimeDirectory=cushion-swap
RuntimeDirectoryMode=0755
# The status and the kept problems outlive the daemon, and the stop says why it happened, so a stopped or failed
# daemon is never shown as a working one; its status line reaches systemctl status through the notify socket.
RuntimeDirectoryPreserve=yes
ExecStopPost=/usr/sbin/cushion-swap --stopped
NotifyAccess=all
StateDirectory=cushion-swap
StateDirectoryMode=0700
# Problems to both destinations; optional cycle arithmetic only to the file.
# The file is kept open by systemd: hence
# copytruncate there); actions and failures to the journal as well.
StandardOutput=append:/var/log/cushion-swap/cushion-swap.log
StandardError=journal
# No ProtectSystem=, PrivateTmp= or other namespace option, on purpose:
# swapon/swapoff must act on the real system, not a private mount namespace.

[Install]
WantedBy=multi-user.target
