# After resume, the Cushion Swap File goes off again if it was switched on
# only to hold the image and nothing stayed in it.
case "$1/$2" in
post/hibernate | post/hybrid-sleep | post/suspend-then-hibernate)
	exec /usr/sbin/cushion-swap --hibernate-resume
	;;
esac
