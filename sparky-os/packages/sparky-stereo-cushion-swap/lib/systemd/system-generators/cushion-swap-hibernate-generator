#
# Offers Hibernate while the Cushion Swap File is off. logind reports
# CanHibernate=yes only with an active swap area that can hold the image
# (systemd src/shared/hibernate-util.c, hibernation_is_safe()), unless
# SYSTEMD_BYPASS_HIBERNATION_MEMORY_CHECK=1 is set for it (docs/ENVIRONMENT.md).
# This generator sets it only where hibernation can work: the area exists,
# it is at least the size of RAM when that can be checked now, and the kernel
# command line has resume=. cushion-swap-hibernate.service switches the area
# on before systemd-sleep looks for it.
set -u
out=${1:-/run/systemd/generator}
config=${CUSHION_SWAP_CONFIG:-/etc/default/cushion-swap}
fstab=${FSTAB_PATH:-/etc/fstab}
cmdline=${CMDLINE_PATH:-/proc/cmdline}
meminfo=${MEMINFO_PATH:-/proc/meminfo}

setting() {
	[ -r "$config" ] || return 0
	sed -n "s/^[[:space:]]*$1=[\"']\{0,1\}\([^\"'#[:space:]]*\).*/\1/p" "$config" | tail -n 1
}

say() {
	echo "cushion-swap-hibernate-generator: $*" >&2
}

# Daniel's own host version stays in charge where it is installed (as in the units).
[ -e "${CGM_PARACHUTE_UNIT:-/etc/systemd/system/cgm-swap-parachute.service}" ] && exit 0
[ "$(setting CUSHION_SWAP)" = off ] && exit 0
[ "$(setting HIBERNATE)" = off ] && exit 0

area=${CUSHION_SWAP_AREA:-$(setting AREA)}
if [ -z "$area" ] && [ -r "$fstab" ]; then
	area=$(awk '$1 !~ /^#/ && $3 == "swap" && ("," $4 ",") ~ /,noauto,/ { print $1; exit }' "$fstab")
fi
[ -n "$area" ] || exit 0

grep -qE '(^| )resume=' "$cmdline" || { say "no resume= on the kernel command line: Hibernate not offered"; exit 0; }

if [ -f "$area" ]; then
	size=$(( $(stat -c %s "$area") / 1024 ))
	ram=$(awk '$1 == "MemTotal:" { print $2 }' "$meminfo")
	if [ "$size" -lt "$ram" ]; then
		say "$area holds $size KiB, less than RAM ($ram KiB): Hibernate not offered"
		exit 0
	fi
fi

mkdir -p "$out/systemd-logind.service.d"
printf '[Service]\nEnvironment=SYSTEMD_BYPASS_HIBERNATION_MEMORY_CHECK=1\n' >"$out/systemd-logind.service.d/50-cushion-swap.conf"
