#
# Offers Hibernate while the swap area is off. Where the image goes is set by
# the installer in /etc/initramfs-tools/conf.d/resume: RESUME= the device
# (initramfs.conf(5)), RESUME_OFFSET= a swap file's first page on it,
# RESUME=none no hibernation. Without a RESUME= line there, resume= and
# resume_offset= on the kernel command line (initramfs-tools(7)).
# "cushion-swap --resume-target" reads both and names the area.
# logind reports CanHibernate=yes only with an active swap area that can hold
# the image (systemd src/shared/hibernate-util.c, hibernation_is_safe()),
# unless SYSTEMD_BYPASS_HIBERNATION_MEMORY_CHECK=1 is set for it
# (docs/ENVIRONMENT.md). This generator sets it where a device is named,
# unless what can be checked now says the image would not fit or the named
# swap file is not where the offset points.
# cushion-swap-hibernate.service switches that area on before systemd-sleep
# looks for it, whether or not the area is the Cushion Swap File's.
set -u
out=${1:-/run/systemd/generator}
config=${CUSHION_SWAP_CONFIG:-/etc/default/cushion-swap}
meminfo=${MEMINFO_PATH:-/proc/meminfo}
cushion=${CUSHION_SWAP_BIN:-/usr/sbin/cushion-swap}
kmsg=${KMSG_PATH:-/dev/kmsg}

setting() {
	[ -r "$config" ] || return 0
	sed -n "s/^[[:space:]]*$1=[\"']\{0,1\}\([^\"'#[:space:]]*\).*/\1/p" "$config" | tail -n 1
}

# Generators log to /dev/kmsg (systemd.generator(7)), so the decision is in the journal.
say() {
	if [ -w "$kmsg" ]; then
		echo "<6>cushion-swap-hibernate-generator[$$]: $*" >"$kmsg"
	else
		echo "cushion-swap-hibernate-generator: $*" >&2
	fi
}

# Daniel's own host version stays in charge where it is installed (as in the units).
[ -e "${CGM_PARACHUTE_UNIT:-/etc/systemd/system/cgm-swap-parachute.service}" ] && exit 0
[ "$(setting CUSHION_SWAP)" = off ] && exit 0
[ "$(setting HIBERNATE)" = off ] && exit 0

if ! found=$("$cushion" --resume-target 2>/dev/null); then
	say "$(printf '%s\n' "$found" | sed -n 's/^NOTE=//p'): Hibernate not offered"
	exit 0
fi
value() {
	printf '%s\n' "$found" | sed -n "s/^$1=//p"
}
target=$(value TARGET)
if [ "$(value STATE)" = mismatch ]; then
	say "$(value SOURCE): $(value NOTE): Hibernate not offered"
	exit 0
fi
size=$(value SIZE_KIB)
ram=$(awk '$1 == "MemTotal:" { print $2 }' "$meminfo")
if [ -n "$size" ] && [ -n "$ram" ] && [ "$size" -lt "$ram" ]; then
	say "$target holds $size KiB, less than RAM ($ram KiB): Hibernate not offered"
	exit 0
fi

mkdir -p "$out/systemd-logind.service.d"
printf '# Automatically generated by cushion-swap-hibernate-generator\n[Service]\nEnvironment=SYSTEMD_BYPASS_HIBERNATION_MEMORY_CHECK=1\n' >"$out/systemd-logind.service.d/50-cushion-swap.conf"
say "Hibernate offered: $(value SOURCE) names RESUME=$(value RESUME)$(o=$(value RESUME_OFFSET); [ -n "$o" ] && echo " offset $o"), the area ${target:-(not found now: $(value NOTE))}"
