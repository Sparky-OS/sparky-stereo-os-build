"""Language task selection, installation and post-apt migration."""
import fcntl
import gettext
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

SHARE = Path('/usr/share/sparky-stereo-language-tasks')
STATE = Path('/var/lib/sparky-stereo-language-tasks')
PROTECTION = Path('/etc/apt/apt.conf.d/90sparky-language-pending')
DATA = json.loads((SHARE / 'manifest.json').read_text())
ROWS = {r['code'].lower(): r for r in DATA['languages']}
FAILURE = 'Language %s is incomplete (%s). Connect to the network and retry this installation step.'
MIGRATION = 'Language support could not be completed: %s. Check the network and retry the update.'
DRY = os.environ.get('SPARKY_STEREO_LANG_DRY_RUN') == '1'
LIVE = ('installed', 'triggers-pending', 'triggers-awaited', 'half-configured')
NETWORK = re.compile(r'Could not resolve|Failed to fetch|Temporary failure|Unable to connect|Connection (?:failed|timed out|refused)|Network is unreachable|^Err:\d', re.M)
locale = os.environ.get('INSTALLER_LANG') or os.environ.get('LANG', 'en')
_ = gettext.translation('sparky-stereo-language-tasks', '/usr/share/locale', languages=[locale.split('.')[0]], fallback=True).gettext


def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as stream:
        stream.write(text)
        stream.flush()
        os.fsync(stream.fileno())
        temporary = stream.name
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def run(args, check=True):
    p = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       env=os.environ | {'DEBIAN_FRONTEND': 'noninteractive', 'LC_ALL': 'C'})
    if check and p.returncode:
        raise RuntimeError(p.stdout.strip())
    return p


class Blocked(RuntimeError):
    def __init__(self, blockers):
        self.blockers = sorted(blockers)
        super().__init__('Remv: ' + ', '.join(self.blockers))


def installed():
    text = run(['dpkg-query', '-W', '-f', '${Package}\t${db:Status-Status}\t${Depends}, ${Pre-Depends}, ${Recommends}\t${Provides}\n']).stdout
    return {f[0]: {'deps': f[2], 'provides': f[3], 'status': f[1]} for line in text.splitlines()
            if len(f := line.split('\t')) == 4 and f[1] in LIVE}


def debian_tasks():
    # Debian's own task packages: built from the tasksel source, each locked to tasksel's exact version.
    text = run(['dpkg-query', '-W', '-f', '${Package}\t${db:Status-Status}\t${Source}\n']).stdout
    return {f[0] for line in text.splitlines() if len(f := line.split('\t')) == 3 and f[1] in LIVE
            and f[0].startswith('task-') and not f[0].startswith('task-sparky-') and re.match(r'tasksel(?: |$)', f[2])}


def held():
    # A Debian task locked to the installed tasksel while Debian offers a newer one.
    have = installed()
    tasks = debian_tasks() & set(have)
    if not tasks or 'tasksel' not in have:
        return False
    policy = run(['apt-cache', 'policy', 'tasksel'], False).stdout
    current = re.search(r'Installed: (\S+)', policy)
    candidate = re.search(r'Candidate: (\S+)', policy)
    if not current or not candidate or current[1] == candidate[1]:
        return False
    return any(re.search(r'tasksel \(= ' + re.escape(current[1]) + r'\)', have[n]['deps']) for n in tasks)


def names(groups):
    return set(re.findall(r'(?:^|[,|])\s*([a-z0-9][a-z0-9+.-]*)', ', '.join(groups)))


def payload(row):
    return names(row['depends'])


def select(value):
    value = value.strip().strip('"\'').split('.')[0].split('@')[0].replace('_', '-').lower()
    if value in ('c', 'posix', 'en') or value.startswith('en-'):
        return 'en'
    if value in ('nb', 'nn', 'no') or value.startswith(('nb-', 'nn-', 'no-')):
        return 'no'
    if value.startswith(('zh-cn', 'zh-sg', 'zh-hans')):
        return 'zh-cn'
    if value.startswith(('zh-tw', 'zh-hk', 'zh-mo', 'zh-hant')):
        return 'zh-tw'
    if value == 'pt-br':
        return 'pt-br'
    if value.startswith('es-') and value != 'es-es':
        return 'es-419'
    if value in ROWS:
        return value
    base = value.split('-')[0]
    if base in ROWS:
        return base
    raise ValueError(value)


def system_language():
    if not Path('/etc/default/locale').exists():
        return select(os.environ.get('LANG', 'C.UTF-8'))
    for line in Path('/etc/default/locale').read_text().splitlines():
        if line.startswith('LANG='):
            return select(line[5:])
    return select(os.environ.get('LANG', 'C.UTF-8'))


def requested(values):
    return {system_language() if v == 'system' else select(v)
            for arg in values for v in re.split('[, ]+', arg) if v}


def plan(args, allowed=()):
    p = run(['apt-get', '-s', '-o', 'DPkg::Lock::Timeout=-1', '--no-install-recommends'] + args)
    removed = removals(p)
    if removed - set(allowed):
        raise Blocked(removed - set(allowed))
    print(p.stdout, end='')
    return p


def removals(p):
    return {line.split()[1].split(':')[0] for line in p.stdout.splitlines() if line.startswith(('Remv ', 'Purg '))}


def keep_payload(retired, have, leaving):
    # What a retired Debian task brought stays, as the person's own packages.
    kept = actual(names([have[n]['deps'] for n in retired if n in have]), have) - set(leaving) - {'tasksel', 'tasksel-data'}
    if kept and not DRY:
        run(['apt-mark', 'manual'] + sorted(kept))
    return kept


def verify(codes):
    have = installed()
    missing = [ROWS[c]['name'] for c in codes if ROWS[c]['name'] not in have or have[ROWS[c]['name']]['status'] == 'half-configured']
    if missing:
        raise RuntimeError(', '.join(missing))
    # Check the installed dependency graph, not the mere presence of a pack.
    run(['apt-get', '-q', 'check'])


def add(codes, refresh=False):
    try:
        verify(codes)
        if not DRY:
            run(['apt-mark', 'manual'] + [ROWS[c]['name'] for c in sorted(codes)])
        return
    except RuntimeError:
        if refresh:
            run(['apt-get', 'update', '-o', 'APT::Update::Error-Mode=any'])
    wrappers = {n for c in codes for n in ROWS[c]['conflicts']}
    args = ['install'] + [ROWS[c]['name'] for c in sorted(codes)]
    plan(args, wrappers)
    if DRY:
        return
    print(run(['apt-get', '-y', '-o', 'DPkg::Lock::Timeout=-1', '--no-install-recommends'] + args).stdout)
    verify(codes)
    run(['apt-mark', 'manual'] + [ROWS[c]['name'] for c in sorted(codes)])


def actual(wanted, have):
    return wanted & set(have) | {n for n, fields in have.items() if wanted & names([fields['provides']])}


def retain(codes):
    codes |= {'en', system_language()}
    have = installed()
    kept_payload = actual(names(DATA['common']) | set().union(*(payload(ROWS[c]) for c in codes)), have)
    unwanted = set(ROWS) - codes
    purge = actual({ROWS[c]['name'] for c in unwanted} | set().union(*(payload(ROWS[c]) for c in unwanted)), have)
    purge -= kept_payload
    if purge:
        args = ['purge'] + sorted(purge)
        plan(args, purge)
        if not DRY:
            print(run(['apt-get', '-y', '-o', 'DPkg::Lock::Timeout=-1'] + args).stdout)
    if DRY:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    atomic(STATE / 'retained.json', json.dumps(sorted(codes)) + '\n')
    add(codes)
    if (STATE / 'pending').exists():
        capture()


def capture():
    have = installed()
    roots = names(DATA['common']) | set().union(*(payload(r) for r in ROWS.values()))
    roots = actual(roots, have)
    protected = set(roots)
    todo = list(roots)
    while todo:
        for n in actual(names([have[todo.pop()]['deps']]), have):
            if n in have and n not in protected and not n.startswith('task-'):
                protected.add(n)
                todo.append(n)
    if (STATE / 'retained.json').exists():
        codes = set(json.loads((STATE / 'retained.json').read_text()))
    else:
        # Shared data alone cannot resurrect a removed regional language.
        counts = {}
        for r in ROWS.values():
            for n in r['ours']:
                counts[n] = counts.get(n, 0) + 1
        codes = {c for c, r in ROWS.items() if any(n in have and counts[n] == 1 and not n.startswith('fonts-') for n in r['ours'])}
    codes |= {'en', system_language()}
    STATE.mkdir(parents=True, exist_ok=True)
    old = json.loads((STATE / 'pending').read_text()) if (STATE / 'pending').exists() else {}
    roots |= set(old.get('roots', [])) & set(have)
    protected |= set(old.get('protected', [])) & set(have)
    atomic(PROTECTION, 'APT::NeverAutoRemove {\n' + ''.join(' "^' + re.escape(n) + '$";\n' for n in sorted(protected)) + '};\n')
    atomic(STATE / 'pending', json.dumps({'codes': sorted(codes), 'roots': sorted(roots), 'protected': sorted(protected)}, indent=2) + '\n')


def migrate():
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not (STATE / 'pending').exists():
            return
        # Same wait-for-apt pattern as kernel-settings' deferred migration.
        run(['apt-get', '-q', '-o', 'DPkg::Lock::Timeout=-1', 'check'])
        pending = json.loads((STATE / 'pending').read_text())
        roots = sorted(set(pending['roots']) & set(installed()))
        if roots:
            run(['apt-mark', 'manual'] + roots)
        codes = set(pending['codes'])
        wrappers = {n for c in codes for n in ROWS[c]['conflicts']}
        debian = debian_tasks()
        args = ['install', 'tasksel', 'tasksel-data'] + [ROWS[c]['name'] for c in sorted(codes)] + roots
        p = plan(args, wrappers | debian)
        retired = removals(p) & debian
        if retired:
            kept = keep_payload(retired, installed(), wrappers | debian)
            print('Debian tasks retired with tasksel: ' + ', '.join(sorted(retired)))
            print('Kept as installed packages: ' + ', '.join(sorted(kept)))
        print(run(['apt-get', '-y', '-o', 'DPkg::Lock::Timeout=-1', '--no-install-recommends'] + args).stdout)
        verify(codes)
        after = run(['apt-get', '-s', 'autoremove'])
        removed = {line.split()[1] for line in after.stdout.splitlines() if line.startswith('Remv ')}
        if removed & set(pending['protected']):
            raise RuntimeError('autoremove: ' + ', '.join(sorted(removed & set(pending['protected']))))
        atomic(STATE / 'retained.json', json.dumps(sorted(codes)) + '\n')
        (STATE / 'pending').unlink()
        PROTECTION.unlink(missing_ok=True)
        run(['sparky-stereo-problems', 'clear', '--machine', 'sparky-stereo-language-tasks', 'migration'], False)


def main():
    action, *values = sys.argv[1:]
    if action == 'list':
        print(' '.join(r['name'] for r in ROWS.values()))
    elif action == 'select':
        print(' '.join(sorted(requested(values))))
    elif action == 'queue':
        capture()
    elif action == 'retry':
        if not (STATE / 'pending').exists() and held():
            capture()
        if (STATE / 'pending').exists() and Path('/run/systemd/system').is_dir():
            run(['systemctl', 'reset-failed', 'sparky-stereo-language-tasks.path', 'sparky-stereo-language-tasks.timer', 'sparky-stereo-language-tasks.service'])
            run(['systemctl', '--no-block', 'start', 'sparky-stereo-language-tasks.path', 'sparky-stereo-language-tasks.timer', 'sparky-stereo-language-tasks.service'])
    elif action == 'migrate':
        migrate()
    elif action == 'verify':
        verify(set(ROWS) if values == ['all'] else requested(values))
    elif action == 'add':
        codes = requested(values)
        add(codes, refresh=True)
        if not DRY and (STATE / 'retained.json').exists():
            kept = set(json.loads((STATE / 'retained.json').read_text())) | codes
            atomic(STATE / 'retained.json', json.dumps(sorted(kept)) + '\n')
        if not DRY and (STATE / 'pending').exists():
            capture()
    elif action == 'keep':
        retain(set(ROWS) if values == ['all'] else requested(values))
    elif action == 'installer':
        code = 'system'
        try:
            code = system_language()
            add({code}, refresh=True)
        except (RuntimeError, ValueError) as error:
            raise RuntimeError(_(FAILURE) % (code, str(error))) from error
    else:
        raise ValueError(action)


def failure(error):
    # The message names what really failed: packages apt would remove, a fetch that failed, or apt's own error.
    if isinstance(error, Blocked):
        return 'LOCAL3', ', '.join(error.blockers)
    text = str(error)
    lines = text.splitlines()
    first = next((i for i, line in enumerate(lines) if line.startswith('E:')), None)
    if first is None:
        picked = [line.strip() for line in lines if line.strip()][-3:]
    else:
        # apt gives the reason on the lines after its first E: line
        picked = [line.strip() for line in lines[first:first + 6] if line.strip()]
    summary = ' '.join(picked)[:600].rstrip(' :.') or type(error).__name__
    return ('LOCAL2' if NETWORK.search(text) else 'LOCAL4'), summary


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        if sys.argv[1:2] == ['migrate']:
            key, argument = failure(error)
            run(['sparky-stereo-problems', 'keep', '--machine', '--repair',
                 '["/usr/lib/sparky-stereo-language-tasks/languages","migrate"]',
                 'sparky-stereo-language-tasks', 'migration', key, argument], False)
        sys.exit(1)
