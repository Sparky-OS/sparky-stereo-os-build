# tasksel's Test-* contract: 0 installs a hidden task, 1 hides it unselected.
[ -n "${NEW_INSTALL:-}" ] || exit 1
selected=$(/usr/lib/sparky-stereo-language-tasks/languages select "${LANG:-C.UTF-8}") || exit 1
[ "$selected" = "$2" ]
