"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr\n"

msgid "Required dictionaries, translations and input methods for this language."
msgstr "Dictionnaires, traductions et méthodes de saisie nécessaires à cette langue."

msgid "Shared language support"
msgstr "Prise en charge commune des langues"

msgid "Shared fonts, locales and input methods."
msgstr "Polices, paramètres régionaux et méthodes de saisie communs."

msgid "Language %s is incomplete (%s). Connect to the network and retry this installation step."
msgstr "La langue %s est incomplète (%s). Connectez-vous au réseau et réessayez cette étape de l’installation."

msgid "Language support could not be completed: %s. Check the network and retry the update."
msgstr "La prise en charge des langues n’a pas pu être terminée : %s. Vérifiez la connexion et réessayez la mise à jour."

msgid "Language support was not changed: the update would also remove %s, which it does not manage. Keep them with apt-mark manual or remove them yourself, then retry the update."
msgstr "La prise en charge des langues n'a pas été modifiée : la mise à jour supprimerait aussi %s, qu'elle ne gère pas. Conservez-les avec apt-mark manual ou supprimez-les vous-même, puis relancez la mise à jour."

msgid "Language support could not be completed: %s. The details are in the journal (journalctl -u sparky-stereo-language-tasks). Retry the update when this is fixed."
msgstr "La prise en charge des langues n'a pas pu être terminée : %s. Les détails sont dans le journal (journalctl -u sparky-stereo-language-tasks). Relancez la mise à jour une fois le problème corrigé."

