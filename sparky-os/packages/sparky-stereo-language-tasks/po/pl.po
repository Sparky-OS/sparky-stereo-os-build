msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pl\n"

msgid "Required dictionaries, translations and input methods for this language."
msgstr "Wymagane słowniki, tłumaczenia i metody wprowadzania dla tego języka."

msgid "Shared language support"
msgstr "Wspólna obsługa języków"

msgid "Shared fonts, locales and input methods."
msgstr "Wspólne czcionki, ustawienia regionalne i metody wprowadzania."

msgid "Language %s is incomplete (%s). Connect to the network and retry this installation step."
msgstr "Obsługa języka %s jest niekompletna (%s). Połącz się z siecią i ponów ten krok instalacji."

msgid "Language support could not be completed: %s. Check the network and retry the update."
msgstr "Nie udało się ukończyć obsługi języków: %s. Sprawdź połączenie sieciowe i ponów aktualizację."

msgid "Language support was not changed: the update would also remove %s, which it does not manage. Keep them with apt-mark manual or remove them yourself, then retry the update."
msgstr "Obsługa języków nie została zmieniona: aktualizacja usunęłaby także %s, którymi nie zarządza. Zachowaj je poleceniem apt-mark manual albo usuń samodzielnie, a potem ponów aktualizację."

msgid "Language support could not be completed: %s. The details are in the journal (journalctl -u sparky-stereo-language-tasks). Retry the update when this is fixed."
msgstr "Nie udało się dokończyć obsługi języków: %s. Szczegóły są w dzienniku (journalctl -u sparky-stereo-language-tasks). Ponów aktualizację po naprawieniu problemu."

