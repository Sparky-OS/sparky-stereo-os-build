#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON "-DCMAKE_CXX_FLAGS=-ffile-prefix-map=$(CURDIR)=."

override_dh_auto_install:
	dh_auto_install
	sparky-stereo-problems catalog sparky-stereo-partners po debian/sparky-stereo-partners/usr/lib/systemd/catalog \
		--domain kcm_sparkystereo_partners --context "@info" --context "@action:button" \
		--subject "@title notification|A partner cannot work"
