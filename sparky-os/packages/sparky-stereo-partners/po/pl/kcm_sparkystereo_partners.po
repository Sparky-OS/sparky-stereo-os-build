msgctxt "@info:shell %1 an engine, %2 its state"
msgid "%1: %2"
msgstr "%1: %2"

#: bin/sparky-stereo-partners:811
msgctxt "@info:shell %1 a card, %2 why"
msgid "Card: %1 (%2)"
msgstr "Karta: %1 (%2)"

#: bin/sparky-stereo-partners:813
msgctxt "@info:shell %1 a kind of work, %2 who answers, %3 the model"
msgid "%1: %2, %3"
msgstr "%1: %2, %3"
