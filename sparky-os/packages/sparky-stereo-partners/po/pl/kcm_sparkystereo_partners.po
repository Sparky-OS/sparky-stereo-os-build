#, kde-format
msgctxt "@title:group"
msgid "Programs"
msgstr "Programy"

#: src/ui/main.qml:474
#, kde-format
msgctxt "@item %1 a program"
msgid "%1 (not installed)"
msgstr "%1 (niezainstalowany)"

#: src/ui/main.qml:484
#, kde-format
msgctxt "@info"
msgid "It uses the services you sign in to in it; this page cannot choose for it."
msgstr "Program używa usług, do których logujesz się w nim. Na tej stronie nie można ich wybrać."

#: src/ui/main.qml:485
#, kde-format
msgctxt "@info"
msgid "It uses its own engines and models on this computer; this page cannot choose for it."
msgstr "Program używa własnych silników i modeli na tym komputerze. Na tej stronie nie można ich wybrać."

#: src/ui/main.qml:487
#, kde-format
msgctxt "@info"
msgid "KDE's text add-ons follow this choice when you have set up no instance of your own in them."
msgstr "Dodatki tekstowe KDE stosują ten wybór, jeśli nie skonfigurowano w nich własnej instancji."

#: src/ui/main.qml:490
#, kde-format
msgctxt "@info"
msgid "They can follow only Ollama for now: their llama.cpp add-on is not finished in version 2.1.2, and they cannot reach a provider's own address."
msgstr "Na razie mogą korzystać tylko z Ollama. Ich dodatek llama.cpp nie jest gotowy w wersji 2.1.2 i nie mają dostępu do własnego adresu dostawcy."

#: src/ui/main.qml:492
#, kde-format
msgctxt "@info"
msgid "Its presets take this choice when they are set up; a later change here reaches it when they are set up again."
msgstr "Ustawienia wstępne programu przyjmują ten wybór przy konfiguracji. Późniejsza zmiana tutaj zostanie uwzględniona przy ponownej konfiguracji ustawień wstępnych."

#: src/ui/main.qml:493
#, kde-format
msgctxt "@info"
msgid "When you add the ThunderAI add-on in Betterbird, it starts from this choice; what you set in ThunderAI wins, and a provider's key is entered there."
msgstr "Po dodaniu rozszerzenia ThunderAI w programie Betterbird ten wybór jest ustawieniem początkowym. Ustawienia w ThunderAI mają pierwszeństwo. Tam też wpisuje się klucz dostawcy."

#: src/ui/main.qml:507
#, kde-format
msgctxt "@option:radio"
msgid "Follow the system default"
msgstr "Użyj domyślnego ustawienia systemu"

#: src/ui/main.qml:513
#, kde-format
msgctxt "@option:radio"
msgid "Its own choice"
msgstr "Własny wybór"

