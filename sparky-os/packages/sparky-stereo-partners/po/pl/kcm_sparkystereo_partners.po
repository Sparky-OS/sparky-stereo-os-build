#: src/ui/main.qml:283
#, kde-format
msgctxt "@action:button"
msgid "Download"
msgstr "Pobierz"

#: src/ui/main.qml:286
#, kde-format
msgctxt "@info a model"
msgid "On this computer"
msgstr "Na tym komputerze"

#: src/ui/main.qml:291
#, kde-format
msgctxt "@action:button"
msgid "Download anyway"
msgstr "Pobierz mimo to"

#: src/ui/main.qml:299
#, kde-format
msgctxt "@info"
msgid "Models hosted by Ollama's service are allowed: they send what you write to ollama.com."
msgstr "Można używać modeli udostępnianych przez usługę Ollama. Wysyłają wpisywany tekst do ollama.com."

#: src/ui/main.qml:300
#, kde-format
msgctxt "@info"
msgid "While Ollama is on, it asks ollama.com for its list of hosted models and its suggestions; nothing you write is sent."
msgstr "Gdy Ollama jest włączona, pobiera z ollama.com listę udostępnianych modeli oraz propozycje. Wpisywany tekst nie jest wtedy wysyłany."

#: src/ui/main.qml:306
#, kde-format
msgctxt "@info %1 the computer's memory"
msgid "A model on this computer will be slow and may not fit in its memory (%1)."
msgstr "Model uruchomiony na tym komputerze będzie działał wolno i może nie zmieścić się w dostępnej pamięci (%1)."

#: src/ui/main.qml:331
#, kde-format
msgctxt "@info %1 a size"
msgid "Installing downloads Debian's llama-server (%1) and its Vulkan back end, which runs on any card; every size is shown before anything is downloaded."
msgstr "Instalacja pobiera pakiet llama-server z repozytorium Debian (%1) oraz jego mechanizm Vulkan, który działa na każdej karcie. Wszystkie rozmiary są wyświetlane przed pobraniem."

#: src/ui/main.qml:356
#, kde-format
msgctxt "@action:button"
msgid "Open the models folder"
msgstr "Otwórz katalog modeli"

#: src/ui/main.qml:362
#, kde-format
msgctxt "@action:button"
msgid "Look again"
msgstr "Wyszukaj ponownie"

#: src/ui/main.qml:380
#, kde-format
msgctxt "@info %1 a folder"
msgid "llama.cpp downloads no model by itself: put model files (GGUF) in %1, then choose Look again."
msgstr "llama.cpp sam nie pobiera modeli. Umieść pliki modeli (GGUF) w %1, a następnie wybierz „Wyszukaj ponownie”."

