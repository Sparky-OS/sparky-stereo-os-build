msgid "Asking…"
msgstr "Pobieranie informacji…"

#: src/ui/main.qml:413
#, kde-format
msgctxt "@info %1 a computer's name, %2 a file"
msgid "Signing in opens ollama.com in your browser and links this computer's name (%1) and Ollama's key for it (kept by Ollama in %2) to your account there."
msgstr "Logowanie otwiera ollama.com w przeglądarce i wiąże z kontem w tej usłudze nazwę komputera (%1) oraz jego klucz Ollama (przechowywany przez Ollama w %2)."

#: src/ui/main.qml:420
#, kde-format
msgctxt "@action:button"
msgid "Sign in…"
msgstr "Zaloguj się…"

#: src/ui/main.qml:427
#, kde-format
msgctxt "@action:button"
msgid "Check"
msgstr "Sprawdź"

#: src/ui/main.qml:434
#, kde-format
