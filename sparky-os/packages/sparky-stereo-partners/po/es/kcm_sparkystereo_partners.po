msgctxt "@info"
msgid "%1 did not start: the card chosen for partners cannot be used now. See System Settings, Graphics."
msgstr "%1 no se inició: ahora no se puede usar la tarjeta elegida para los colaboradores. Consulta «Gráficos» en Preferencias del sistema."

#: bin/sparky-stereo-partners:268 bin/sparky-stereo-partners:293
msgctxt "@info"
msgid "sparky-stereo-gpu-env is missing: install sparky-stereo-graphics."
msgstr "Falta sparky-stereo-gpu-env. Instala sparky-stereo-graphics."

#: bin/sparky-stereo-partners:322
msgctxt "@info"
msgid "The model registry %1 is not an https address."
msgstr "El registro de modelos %1 no tiene una dirección HTTPS."

#: bin/sparky-stereo-partners:392
msgctxt "@info"
msgid "This connection is metered, so the download waits. It starts when you choose Download again on a connection that is not metered."
msgstr "Esta conexión es de uso medido, así que la descarga queda en espera. Para iniciarla, vuelve a seleccionar «Descargar» en una conexión que no sea de uso medido."

#: bin/sparky-stereo-partners:395
msgctxt "@info"
msgid "Whether this connection is metered could not be read (%1), so the download waits. Choose Download anyway to start it."
msgstr "No se pudo saber si esta conexión es de uso medido (%1), así que la descarga queda en espera. Elige «Descargar de todos modos» para iniciarla."

#: bin/sparky-stereo-partners:403
msgctxt "@info"
msgid "The local partner is off. Turn it on in System Settings, Partners."
msgstr "El colaborador local está desactivado. Actívalo en «Colaboradores», en Preferencias del sistema."

