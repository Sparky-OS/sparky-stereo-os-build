"""sparky-stereo-partners: the Partners page's choices, for the page, for programs and for tests (ORDER 70); --help says how."""
import configparser
import gettext
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

PACKAGE = 'sparky-stereo-partners'
DOMAIN = 'kcm_sparkystereo_partners'
CONFIG = 'sparky-stereo-partnersrc'
HELPER = '/usr/libexec/sparky-stereo-partners/install-engine'
KINDS_DEFAULT = ['text', 'speech', 'image', '3d']
ACCEPT = 'application/vnd.docker.distribution.manifest.v2+json'
# the two local engines the page offers (Daniel's answer: "Ollama, with llama.cpp as the fallback", a path the person chooses)
ENGINES = {
    'ollama': {'interface': 'ollama-local', 'unit': 'ollama.service', 'package': 'ollama', 'url': 'http://127.0.0.1:11434',
               'name': ('@item the local engine', 'Ollama'), 'problem': 'engine'},
    'llamacpp': {'interface': 'llamacpp-local', 'unit': 'sparky-stereo-llama-server.service', 'package': 'llama.cpp-tools',
                 'url': 'http://127.0.0.1:8080/v1', 'name': ('@item the other local engine', 'llama.cpp'), 'problem': 'engine-llamacpp'},
}
# where llama.cpp's server finds its model files (its unit's --models-dir): it downloads no model by itself
LLAMACPP_MODELS = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'share'), 'llama.cpp', 'models')

_tr = gettext.translation(DOMAIN, fallback=True)


def tr(context, text, *args):
    """The page's own sentences (CONTEXT|TEXT of its catalogue), %1, %2 filled as KDE's i18n does."""
    out = _tr.pgettext(context, text)
    for number, value in enumerate(args, 1):
        out = out.replace('%%%d' % number, str(value))
    return out


def key(context, text):
    return context + '|' + text


# the title the problems engine's notification gives every kept problem of this package (its catalogue's subject)
SUBJECT = key('@title notification', 'A partner cannot work')


try:
    import sparky_stereo_problems as problems
except (ImportError, OSError):
    problems = None


def keep(name, context, text, args):
    """Said on standard error, and kept by the edition's one problems engine until it works (ORDER 350)."""
    print(PACKAGE + ': ' + tr(context, text, *args), file=sys.stderr)
    if problems is None:
        print(PACKAGE + ': the problems engine is not installed, so this is not kept', file=sys.stderr)
        return
    actions = [{'id': 'open', 'label': [key('@action:button', 'Open Partners')], 'command': ['systemsettings', 'kcm_sparkystereo_partners']}]
    try:
        problems.keep(PACKAGE, name, key(context, text), [str(a) for a in args], actions=actions)
    except Exception as error:  # the engine's own reason, said; the failure itself was already said above
        print(PACKAGE + ': ' + str(error), file=sys.stderr)


def clear(name):
    if problems is not None:
        try:
            problems.clear(PACKAGE, name)
        except Exception as error:
            print(PACKAGE + ': ' + str(error), file=sys.stderr)


# The names the shipped settings give (sparky-stereo-partnersrc's Name= is English), in the person's language through the page's
# catalogue; a name the person or another package gave stays as it is written.
SHIPPED_NAMES = [
    key('@item:inlistbox an interface', 'Ollama on this computer'),
    key('@item:inlistbox an interface', 'llama.cpp on this computer'),
    key('@item:inlistbox an interface', 'Vibe on this computer'),
    key('@item:inlistbox an interface', 'Spirula Studio on this computer'),
    key('@item a program', 'KMail, Kontact and the Sieve editor'),
    key('@item a program', 'Betterbird with ThunderAI'),
]


def shown_name(name):
    for entry in SHIPPED_NAMES:
        context, _, text = entry.partition('|')
        if text == name:
            return tr(context, text)
    return name


# ---------- the settings file, as KConfig cascades it ----------

def config_files():
    dirs = (os.environ.get('XDG_CONFIG_DIRS') or '/etc/xdg').split(':')
    home = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    files = [os.path.join(d, CONFIG) for d in reversed(dirs) if d]
    return files, os.path.join(home, CONFIG)


def read_file(path):
    parser = configparser.RawConfigParser(strict=False, interpolation=None, comment_prefixes=('#',), inline_comment_prefixes=None,
                                          delimiters=('=',))
    parser.optionxform = str
    try:
        with open(path, encoding='utf-8') as stream:
            parser.read_file(stream)
    except (OSError, configparser.Error):
        return {}
    groups = {}
    for section in parser.sections():
        # KConfig writes a nested group as [A][B]; configparser keeps "A][B" as the section's name
        path_ = tuple(section.split(']['))
        groups[path_] = {k.split('[$')[0]: v.strip() for k, v in parser.items(section)}
    return groups


class Settings:
    def __init__(self):
        system, self.person = config_files()
        self.groups = {}
        for path in system + [self.person]:
            for group, values in read_file(path).items():
                self.groups.setdefault(group, {}).update(values)

    def get(self, group, name, default=None):
        return self.groups.get(tuple(group), {}).get(name, default)

    def children(self, *prefix):
        out = []
        for group in self.groups:
            if group[:len(prefix)] == prefix and len(group) == len(prefix) + 1 and group[-1] not in out:
                out.append(group[-1])
        return out

    def kinds(self):
        return [k for k in (self.get(['General'], 'Kinds') or ','.join(KINDS_DEFAULT)).split(',') if k]


def write(groups, name, value):
    """The person's file, through KConfig's own writer; value None deletes the key."""
    tool = shutil.which('kwriteconfig6')
    if not tool:
        print(PACKAGE + ': ' + tr('@info', 'kwriteconfig6 is not installed, so the choice cannot be saved.'), file=sys.stderr)
        raise SystemExit(3)
    args = [tool, '--file', CONFIG]
    for g in groups:
        args += ['--group', g]
    args += ['--key', name]
    args += ['--delete'] if value is None else ['--', value]
    if subprocess.run(args).returncode:
        print(PACKAGE + ': ' + tr('@info', 'The choice could not be saved.'), file=sys.stderr)
        raise SystemExit(3)


# ---------- the local engines ----------

def engine_name(eng):
    return tr(*ENGINES[eng]['name'])


def engine_address(settings, eng='ollama'):
    url = settings.get(['Interface', ENGINES[eng]['interface']], 'Url', ENGINES[eng]['url']).rstrip('/')
    parts = urllib.parse.urlsplit(url)
    return url, parts.hostname or '127.0.0.1', parts.port or 80


def root_of(url):
    """llama.cpp's interface is its OpenAI-style address (…/v1); its own routes (/health) are at the server's root."""
    parts = urllib.parse.urlsplit(url)
    return '%s://%s' % (parts.scheme, parts.netloc)


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], capture_output=True, text=True)


def unit_state(eng='ollama'):
    out = systemctl('show', '-p', 'LoadState,ActiveState,UnitFileState,Result,ExecMainStatus,NRestarts', ENGINES[eng]['unit'])
    state = dict(line.split('=', 1) for line in out.stdout.splitlines() if '=' in line)
    return {'loaded': state.get('LoadState') == 'loaded', 'active': state.get('ActiveState', ''), 'enabled': state.get('UnitFileState', ''),
            'result': state.get('Result', ''), 'status': int(state.get('ExecMainStatus', '0') or 0)}


def listening(host, port):
    try:
        with socket.create_connection((host, port), timeout=1):
            return True
    except OSError:
        return False


def owner_of(port):
    """The program that listens on the port, as ss can name it for this account ("" when it cannot)."""
    out = subprocess.run(['ss', '-Hltnp', 'sport = :%d' % port], capture_output=True, text=True)
    m = re.search(r'users:\(\("([^"]+)",pid=(\d+)', out.stdout)
    return '%s, pid %s' % (m.group(1), m.group(2)) if m else tr('@info a program we cannot name', 'a program of another account')


def api(base, path, body=None, timeout=10):
    data = None if body is None else json.dumps(body).encode()
    request = urllib.request.Request(base + path, data=data, headers={'Content-Type': 'application/json'} if data else {})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)


def installed(package):
    out = subprocess.run(['dpkg-query', '-W', '-f', '${db:Status-Status} ${Version}', package], capture_output=True, text=True)
    status = out.stdout.split()
    return status[1] if len(status) == 2 and status[0] == 'installed' else ''


def journal_tail(eng='ollama', lines=6):
    out = subprocess.run(['journalctl', '--user', '-u', ENGINES[eng]['unit'], '-n', str(lines), '-o', 'cat', '--no-pager'],
                         capture_output=True, text=True)
    return [line for line in out.stdout.splitlines() if line.strip()]


def engine_on(settings, eng='ollama'):
    name, unit, problem = engine_name(eng), ENGINES[eng]['unit'], ENGINES[eng]['problem']
    if not installed(ENGINES[eng]['package']):
        print(PACKAGE + ': ' + tr('@info', '%1 is not installed. Install it on the Partners page.', name), file=sys.stderr)
        return 3
    url, host, port = engine_address(settings, eng)
    state = unit_state(eng)
    if state['active'] == 'active' and listening(host, port):
        clear(problem)
        return 0
    if listening(host, port):
        keep(problem, '@info', "Another program already uses %1's address, %2 (%3). Close it, then turn %1 on again.",
             [name, '%s:%d' % (host, port), owner_of(port)])
        return 6
    systemctl('reset-failed', unit)
    out = systemctl('enable', '--now', unit)
    if out.returncode:
        keep(problem, '@info', '%1 could not start: %2', [name, (out.stderr.strip().splitlines() or ['systemctl'])[-1]])
        return 3
    for _ in range(80):
        state = unit_state(eng)
        if state['active'] == 'failed' or (state['active'] == 'inactive' and state['result'] not in ('', 'success')):
            break
        if state['active'] == 'active' and listening(host, port):
            clear(problem)
            return 0
        time.sleep(0.25)
    if state['status'] == 4:
        # the card: sparky-stereo-gpu-env said why and keeps it (Graphics, key partners); the engine is left enabled for the next try
        print(PACKAGE + ': ' + tr('@info', '%1 did not start: the card chosen for partners cannot be used now. See System Settings, Graphics.', name),
              file=sys.stderr)
        return 4
    why = ' / '.join(journal_tail(eng, 3)) or state['result'] or 'unknown'
    keep(problem, '@info', '%1 could not start: %2', [name, why])
    return 3


def engine_off(eng='ollama'):
    out = systemctl('disable', '--now', ENGINES[eng]['unit'])
    if out.returncode:
        print(PACKAGE + ': ' + (out.stderr.strip() or 'systemctl failed'), file=sys.stderr)
        return 3
    clear(ENGINES[eng]['problem'])
    return 0


def llamacpp_models(settings, on):
    """The models llama.cpp's server offers: its own list while it runs (router mode on the folder), else the folder's files."""
    out = []
    if on:
        url = engine_address(settings, 'llamacpp')[0]
        try:
            out = [{'name': m.get('id', ''), 'size': 0, 'sizeText': ''} for m in api(url, '/models').get('data', []) if m.get('id')]
        except (urllib.error.URLError, OSError, ValueError):
            out = []
    if not out:
        try:
            for entry in sorted(os.scandir(LLAMACPP_MODELS), key=lambda e: e.name):
                if entry.is_file() and entry.name.endswith('.gguf'):
                    size = entry.stat().st_size
                    out.append({'name': entry.name[:-len('.gguf')], 'size': size, 'sizeText': human(size)})
        except OSError:
            pass
    return out


# ---------- Ollama's service (ollama.com), through the local engine ----------

def account(settings, open_browser=False):
    """Signed in or not, as the local engine answers (it signs the question with its own key, ~/.ollama/id_ed25519)."""
    url, host, port = engine_address(settings, 'ollama')
    if not listening(host, port):
        return {'state': 'off', 'why': tr('@info', 'The local partner is off. Turn it on in System Settings, Partners.')}, 3
    request = urllib.request.Request(url + '/api/me', data=b'', headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            user = json.load(response)
        return {'state': 'signed-in', 'name': user.get('name', ''), 'plan': user.get('plan', '')}, 0
    except urllib.error.HTTPError as error:
        try:
            body = json.loads(error.read() or b'{}')
        except ValueError:
            body = {}
        if error.code == 401 and body.get('signin_url', '').startswith('https://ollama.com/'):
            found = {'state': 'signed-out', 'url': body['signin_url'], 'computer': socket.gethostname()}
            if open_browser:
                opener = shutil.which('xdg-open')
                if opener:
                    subprocess.Popen([opener, body['signin_url']], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(tr('@info %1 an address', 'Finish signing in on ollama.com in your browser, then choose Check. The address: %1', body['signin_url']))
            return found, 7
        why = body.get('error') or str(error)
    except (urllib.error.URLError, OSError, ValueError) as error:
        why = str(getattr(error, 'reason', error))
    print(PACKAGE + ': ' + tr('@info %1 why', "Ollama's service could not be reached: %1", why), file=sys.stderr)
    return {'state': 'unavailable', 'why': why}, 3


def signout(settings):
    url, host, port = engine_address(settings, 'ollama')
    if not listening(host, port):
        print(PACKAGE + ': ' + tr('@info', 'The local partner is off. Turn it on in System Settings, Partners.'), file=sys.stderr)
        return 3
    try:
        api(url, '/api/signout', body={}, timeout=30)
    except urllib.error.HTTPError as error:
        if error.code == 401:
            return 0  # not signed in: nothing to undo
        print(PACKAGE + ': ' + tr('@info %1 why', "Ollama's service could not be reached: %1", str(error)), file=sys.stderr)
        return 3
    except (urllib.error.URLError, OSError, ValueError) as error:
        print(PACKAGE + ': ' + tr('@info %1 why', "Ollama's service could not be reached: %1", str(getattr(error, 'reason', error))), file=sys.stderr)
        return 3
    return 0


# ---------- the card (the one key of the Graphics package) ----------

def gpu_env(*args):
    tool = shutil.which('sparky-stereo-gpu-env')
    if not tool:
        return None
    return subprocess.run([tool, *args], capture_output=True, text=True)


def card_state():
    card = {'choice': 'auto', 'id': '', 'name': '', 'reason': '', 'memory': 0, 'problem': '', 'options': []}
    out = gpu_env('--category', 'partners', '--print', 'id')
    if out is None:
        card['problem'] = tr('@info', 'sparky-stereo-gpu-env is missing: install sparky-stereo-graphics.')
        return card
    if out.returncode:
        card['problem'] = out.stderr.strip()
    card['id'] = out.stdout.strip()
    for what, field in (('gpu', 'name'), ('reason', 'reason')):
        res = gpu_env('--category', 'partners', '--print', what)
        card[field] = res.stdout.strip() if res and res.returncode == 0 else ''
    res = gpu_env('--category', 'partners', '--print', 'memory')
    card['memory'] = int(res.stdout.strip()) if res and res.returncode == 0 and res.stdout.strip().isdigit() else 0
    graphics = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config'), 'sparky-stereo-graphicsrc')
    card['choice'] = (read_file(graphics).get(('Render',), {}).get('Partners') or 'auto')
    res = gpu_env('--list', '--json')
    if res and res.returncode == 0:
        try:
            card['options'] = [{'id': g['id'], 'name': g['name'], 'kind': g['kind'], 'memory': g.get('memory', 0)} for g in json.loads(res.stdout)
                               if g.get('canRender')]
        except (ValueError, KeyError):
            pass
    return card


def card_set(value):
    res = gpu_env('--use', 'partners', value)
    if res is None:
        print(PACKAGE + ': ' + tr('@info', 'sparky-stereo-gpu-env is missing: install sparky-stereo-graphics.'), file=sys.stderr)
        return 3
    sys.stderr.write(res.stderr)
    return res.returncode


# ---------- the model the page proposes (the accepted design, 2026-11-21) ----------

def proposal(card):
    mem = 0
    try:
        with open('/proc/meminfo') as stream:
            mem = int(re.search(r'^MemTotal:\s+(\d+) kB', stream.read(), re.M).group(1)) * 1024
    except (OSError, AttributeError):
        pass
    threads = os.cpu_count() or 1
    big_card = card.get('choice') != 'cpu' and card.get('memory', 0) >= 6 * 1024 ** 3
    big_computer = mem >= 16 * 1024 ** 3 and threads >= 8
    model = 'qwen3.5:4b' if big_card or big_computer else 'qwen3.5:2b'
    return {'model': model, 'memory': mem, 'threads': threads, 'cardMemory': card.get('memory', 0), 'slow': mem and mem < 4 * 1024 ** 3}


# ---------- models and their sizes, from the registry ----------

def registry(settings):
    url = (os.environ.get('SPARKY_STEREO_PARTNERS_REGISTRY') or settings.get(['Models'], 'Registry') or 'https://registry.ollama.ai').rstrip('/')
    parts = urllib.parse.urlsplit(url)
    # plain http only to this computer (a stand-in registry for tests); every other registry is https
    if parts.scheme != 'https' and not (parts.scheme == 'http' and parts.hostname in ('127.0.0.1', 'localhost', '::1')):
        print(PACKAGE + ': ' + tr('@info', 'The model registry %1 is not an https address.', url), file=sys.stderr)
        raise SystemExit(2)
    return url


def pull_name(name, reg):
    parts = urllib.parse.urlsplit(reg)
    if parts.netloc == 'registry.ollama.ai':
        return name, False
    model, _, tag = name.partition(':')
    if '/' not in model:
        model = 'library/' + model
    return '%s/%s:%s' % (parts.netloc, model, tag or 'latest'), parts.scheme == 'http'


def model_size(reg, name):
    model, _, tag = name.partition(':')
    if '/' not in model:
        model = 'library/' + model
    request = urllib.request.Request('%s/v2/%s/manifests/%s' % (reg, model, tag or 'latest'), headers={'Accept': ACCEPT})
    with urllib.request.urlopen(request, timeout=15) as response:
        manifest = json.load(response)
    return sum(layer.get('size', 0) for layer in manifest.get('layers', [])) + manifest.get('config', {}).get('size', 0)


def catalogue(settings):
    names = [n for n in (settings.get(['Models'], 'Text') or 'qwen3.5:4b,qwen3.5:2b,qwen3.5:0.8b').split(',') if n]
    notes = {n: settings.get(['Models', n], 'Note', '') for n in names}
    return names, notes


def human(count):
    for unit, size in (('GB', 1000 ** 3), ('MB', 1000 ** 2), ('kB', 1000)):
        if count >= size:
            return '%.2f %s' % (count / size, unit) if unit == 'GB' else '%d %s' % (round(count / size), unit)
    return '%d B' % count


def models(settings):
    reg = registry(settings)
    names, notes = catalogue(settings)
    out = []
    for name in names:
        entry = {'name': name, 'note': notes[name], 'size': 0, 'sizeText': '', 'error': ''}
        try:
            entry['size'] = model_size(reg, name)
            entry['sizeText'] = human(entry['size'])
        except (urllib.error.URLError, OSError, ValueError) as error:
            entry['error'] = str(getattr(error, 'reason', error))
        out.append(entry)
    return out


def metered_state():
    if os.environ.get('SPARKY_STEREO_PARTNERS_METERED') in ('yes', 'no', 'unknown'):
        return os.environ['SPARKY_STEREO_PARTNERS_METERED'], 'set for this run'
    sys.path.insert(0, '/usr/lib/sparky-stereo-apt')
    try:
        import sparky_install_downloads
    except ImportError:
        return 'unknown', 'sparky-stereo-apt is not installed'
    return sparky_install_downloads.metered()


def held(even):
    """A download waits on a metered connection, and when the state cannot be read (said, never guessed)."""
    state, detail = metered_state()
    if state == 'no' or even:
        return False
    if state == 'yes':
        print(PACKAGE + ': ' + tr('@info', 'This connection is metered, so the download waits. It starts when you choose Download again on a connection that is not metered.'),
              file=sys.stderr)
    else:
        print(PACKAGE + ': ' + tr('@info', 'Whether this connection is metered could not be read (%1), so the download waits. Choose Download anyway to start it.', detail),
              file=sys.stderr)
    return True


def download(settings, name, even):
    url, host, port = engine_address(settings)
    if not listening(host, port):
        print(PACKAGE + ': ' + tr('@info', 'The local partner is off. Turn it on in System Settings, Partners.'), file=sys.stderr)
        return 3
    reg = registry(settings)
    if held(even):
        return 5
    try:
        size = model_size(reg, name)
    except (urllib.error.URLError, OSError, ValueError) as error:
        keep('download', '@info', 'The model %1 could not be downloaded: %2', [name, str(getattr(error, 'reason', error))])
        return 3
    print(tr('@info', 'Downloading %1 (%2).', name, human(size)), flush=True)
    target, insecure = pull_name(name, reg)
    body = json.dumps({'model': target, 'insecure': insecure, 'stream': True}).encode()
    request = urllib.request.Request(url + '/api/pull', data=body, headers={'Content-Type': 'application/json'})
    last = ''
    try:
        with urllib.request.urlopen(request, timeout=3600) as response:
            for line in response:
                event = json.loads(line)
                if 'error' in event:
                    keep('download', '@info', 'The model %1 could not be downloaded: %2', [name, event['error']])
                    return 3
                status = event.get('status', '')
                if status != last or event.get('completed') == event.get('total'):
                    print(json.dumps({k: event[k] for k in ('status', 'completed', 'total') if k in event}), flush=True)
                    last = status
    except (urllib.error.URLError, OSError, ValueError) as error:
        keep('download', '@info', 'The model %1 could not be downloaded: %2', [name, str(getattr(error, 'reason', error))])
        return 3
    if last != 'success':
        keep('download', '@info', 'The model %1 could not be downloaded: %2', [name, last or 'no answer'])
        return 3
    clear('download')
    if not settings.get(['Default', 'text'], 'Model'):
        write(['Default', 'text'], 'Model', name)
        sync(Settings())
    return 0


# ---------- providers: keys in KDE Wallet ----------

def wallet_name():
    home = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return read_file(os.path.join(home, 'kwalletrc')).get(('Wallet',), {}).get('Default Wallet', 'kdewallet')


def provider_add(provider, name, url, secret):
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,40}', provider):
        print(PACKAGE + ': ' + tr('@info', 'A provider is named with small letters, digits and dashes.'), file=sys.stderr)
        return 2
    if urllib.parse.urlsplit(url).scheme != 'https':
        print(PACKAGE + ': ' + tr('@info', "A provider's address starts with https://."), file=sys.stderr)
        return 2
    group = ['Interface', 'provider-' + provider]
    if secret:
        tool = shutil.which('kwallet-query')
        if not tool:
            print(PACKAGE + ': ' + tr('@info', 'KDE Wallet is not installed (kwallet-query), so the key cannot be kept. Nothing was saved.'), file=sys.stderr)
            return 3
        wallet = wallet_name()
        probe = subprocess.run([tool, '-l', '-f', PACKAGE, wallet], capture_output=True, text=True, timeout=60)
        if 'not found' in probe.stdout + probe.stderr:
            # no wallet yet (a new account): KDE Wallet makes it through its own dialog, where the person sets its password
            gdbus = shutil.which('gdbus')
            # the dialog waits for the person: gdbus's own 25 s limit would end the call first (KIO's kpasswdserver notes that
            # KWallet opens a wallet synchronously with a 24-day timeout); ten minutes, then said
            opened = subprocess.run([gdbus or 'gdbus', 'call', '--session', '--timeout', '600', '--dest', 'org.kde.kwalletd6', '--object-path', '/modules/kwalletd6',
                                     '--method', 'org.kde.KWallet.open', wallet, '0', PACKAGE], capture_output=True, text=True, timeout=620) \
                if gdbus else None
            # the wallet's own answer decides: it is there now, or it was not made (the dialog's handle is not read: KF 6.30's
            # shim answered a handle the wallet then did not have, measured in the rig)
            again = subprocess.run([tool, '-l', '-f', PACKAGE, wallet], capture_output=True, text=True, timeout=60)
            if not opened or 'not found' in again.stdout + again.stderr:
                why = (opened.stderr.strip() if opened else 'gdbus is not installed') or tr('@info', 'the wallet was not made')
                keep('wallet', '@info', 'The key of %1 could not be kept in KDE Wallet: %2', [name, why])
                return 3
        out = subprocess.run([tool, '-w', 'provider-' + provider, '-f', PACKAGE, wallet], input=secret, capture_output=True, text=True)
        back = subprocess.run([tool, '-r', 'provider-' + provider, '-f', PACKAGE, wallet], capture_output=True, text=True)
        if not out.returncode and back.stdout.strip() != secret:
            out = back  # what the wallet says, said below
        if out.returncode or back.stdout.strip() != secret:
            keep('wallet', '@info', 'The key of %1 could not be kept in KDE Wallet: %2', [name, out.stderr.strip() or out.stdout.strip() or tr('@info', 'the wallet was not made')])
            return 3
        clear('wallet')
    for field, value in (('Name', name), ('Kind', 'openai-compatible'), ('Url', url), ('Runs', 'provider'),
                         ('Wallet', '%s/provider-%s' % (PACKAGE, provider) if secret else None)):
        write(group, field, value)
    return 0


def provider_remove(provider):
    group = ['Interface', 'provider-' + provider]
    for field in ('Name', 'Kind', 'Url', 'Runs', 'Wallet'):
        write(group, field, None)
    tool = shutil.which('kwallet-query')
    if tool:
        # kwallet-query has no removal; the entry is emptied, so no key stays behind
        subprocess.run([tool, '-w', 'provider-' + provider, '-f', PACKAGE, wallet_name()], input='', capture_output=True, text=True)
    return 0


# ---------- programs that read a file of their own ----------

# Betterbird (the app center's entry places it in /opt/betterbird) with ThunderAI, offered, not installed: ThunderAI reads
# browser.storage.managed, which Betterbird answers from an enterprise policy for the add-on, else from a managed-storage
# manifest, per person in ~/.mozilla/managed-storage/ (read in Betterbird 153.7.0esr-bb13's own ext-storage.js and
# NativeManifests.sys.mjs). The values are unlocked: the person's own settings in ThunderAI win (its order: locked policy,
# the person's value, unlocked policy, its default). No key is written: a provider's key stays in KDE Wallet.
BETTERBIRD = 'eu.betterbird.Betterbird'


def betterbird_installed(settings):
    paths = [p for p in settings.get(['ProgramInfo', BETTERBIRD], 'Executables', '').split(',') if p]
    return any(os.access(p, os.X_OK) for p in paths) or bool(shutil.which('betterbird'))


def thunderai_data(c):
    if c['protocol'] == 'ollama' and c['url']:
        return {'connection_type': 'ollama_api', 'ollama_host': c['url'], 'ollama_model': c['model']}
    if c['protocol'] == 'openai-compatible' and c['url']:
        host, v1 = c['url'].rstrip('/'), False
        if host.endswith('/v1'):
            host, v1 = host[:-3], True
        return {'connection_type': 'openai_comp_api', 'openai_comp_host': host, 'openai_comp_model': c['model'], 'openai_comp_use_v1': v1}
    return None


def sync(settings):
    """Writes, or removes, the files of programs that cannot ask the command: Betterbird's ThunderAI manifest."""
    addon = settings.get(['ProgramInfo', BETTERBIRD], 'ManagedStorage', '')
    if not addon:
        return 0
    folder = os.path.join(os.path.expanduser('~'), '.mozilla', 'managed-storage')
    path = os.path.join(folder, addon + '.json')
    data = thunderai_data(choice(settings, 'text', BETTERBIRD)) if betterbird_installed(settings) else None
    if data is None:
        # Betterbird not installed, or a choice ThunderAI cannot use (none): nothing of ours stays behind
        try:
            with open(path, encoding='utf-8') as stream:
                ours = json.load(stream).get('description', '').startswith(PACKAGE)
        except (OSError, ValueError):
            ours = False
        if ours:
            os.remove(path)
        return 0
    manifest = {'name': addon, 'description': PACKAGE + ': the text choice of System Settings, Partners, for Betterbird',
                'type': 'storage', 'data': data}
    os.makedirs(folder, exist_ok=True)
    temporary = path + '.new'
    with open(temporary, 'w', encoding='utf-8') as stream:
        json.dump(manifest, stream, indent=1)
        stream.write('\n')
    os.replace(temporary, path)
    return 0


# ---------- who answers ----------

def interfaces(settings):
    out = []
    for iid in settings.children('Interface'):
        g = ['Interface', iid]
        if not settings.get(g, 'Name'):
            continue
        out.append({'id': iid, 'name': shown_name(settings.get(g, 'Name')), 'kind': settings.get(g, 'Kind', ''), 'url': settings.get(g, 'Url', ''),
                    'runs': settings.get(g, 'Runs', 'here'), 'package': settings.get(g, 'Package', ''),
                    'installed': bool(installed(settings.get(g, 'Package'))) if settings.get(g, 'Package') else settings.get(g, 'Runs') == 'provider',
                    'wallet': settings.get(g, 'Wallet', '')})
    return out


def program_id(settings, program):
    """A program listed under another's entry (ProgramInfo Also=) takes that entry's choice: KMail's answers Kontact and the
    Sieve editor, which share KDE's text add-ons and their one settings file."""
    if not program or settings.get(['ProgramInfo', program], 'Name'):
        return program
    for pid in settings.children('ProgramInfo'):
        if program in [a for a in settings.get(['ProgramInfo', pid], 'Also', '').split(',') if a]:
            return pid
    return program


def choice(settings, kind, program=None):
    program = program_id(settings, program)
    base = ['Default', kind]
    own = ['Program', program, kind] if program else None
    result = {'kind': kind, 'program': program or '', 'own': False}
    for field in ('Interface', 'Model'):
        value = settings.get(own, field) if own else None
        if value:
            result['own'] = True
        result[field.lower()] = value or settings.get(base, field, '')
    iface = ['Interface', result['interface']]
    result['url'] = settings.get(iface, 'Url', '')
    result['runs'] = settings.get(iface, 'Runs', 'here') if result['interface'] not in ('', 'none') else ''
    result['name'] = shown_name(settings.get(iface, 'Name', ''))
    result['protocol'] = settings.get(iface, 'Kind', '') if result['interface'] not in ('', 'none') else ''
    return result


def resolve(settings, kind, program, shell):
    c = choice(settings, kind, program)
    lines = [('PARTNER_INTERFACE', c['interface']), ('PARTNER_KIND', c['protocol']), ('PARTNER_NAME', c['name']), ('PARTNER_URL', c['url']),
             ('PARTNER_MODEL', c['model']), ('PARTNER_RUNS', c['runs'])]
    env = gpu_env('--category', 'partners', '--print', 'compute-env')
    status = 0
    if env is None or env.returncode:
        sys.stderr.write(env.stderr if env else PACKAGE + ': sparky-stereo-gpu-env is missing\n')
        status = 4
    for name, value in lines:
        print("export %s='%s'" % (name, value.replace("'", "'\\''")) if shell else '%s=%s' % (name, value))
    if env is not None and env.returncode == 0:
        for line in env.stdout.splitlines():
            name, _, value = line.partition('=')
            print("export %s='%s'" % (name, value.replace("'", "'\\''")) if shell else line)
    if not c['model'] and c['interface'] not in ('', 'none'):
        print(PACKAGE + ': ' + tr('@info', 'No model is chosen yet. Choose one in System Settings, Partners.'), file=sys.stderr)
        status = status or 1
    return status


def status(settings):
    url, host, port = engine_address(settings)
    unit = unit_state()
    engine = {'installed': installed('ollama'), 'cuda': installed('ollama-cuda'), 'rocm': installed('ollama-rocm'),
              'unit': unit, 'address': '%s:%d' % (host, port), 'listening': listening(host, port), 'models': []}
    engine['on'] = unit['active'] == 'active' and engine['listening']
    if engine['listening'] and unit['active'] != 'active':
        engine['other'] = owner_of(port)
    l_url, l_host, l_port = engine_address(settings, 'llamacpp')
    l_unit = unit_state('llamacpp')
    llamacpp = {'installed': installed('llama.cpp-tools'), 'unit': l_unit, 'address': '%s:%d' % (l_host, l_port),
                'listening': listening(l_host, l_port), 'folder': LLAMACPP_MODELS, 'size': apt_size('llama.cpp-tools')}
    llamacpp['on'] = l_unit['active'] == 'active' and llamacpp['listening']
    if llamacpp['listening'] and l_unit['active'] != 'active':
        llamacpp['other'] = owner_of(l_port)
    llamacpp['models'] = llamacpp_models(settings, llamacpp['on']) if llamacpp['installed'] else []
    if engine['on']:
        try:
            engine['models'] = [{'name': m['name'], 'size': m.get('size', 0), 'sizeText': human(m.get('size', 0))} for m in api(url, '/api/tags').get('models', [])]
        except (urllib.error.URLError, OSError, ValueError):
            pass
    card = card_state()
    kept = []
    if problems is not None:
        try:
            kept = [{'key': p.get('key'), 'text': p.get('text'), 'package': p.get('package')} for p in problems.list(None)
                    if p.get('package') == PACKAGE or (p.get('package') == 'sparky-stereo-graphics' and p.get('key') == 'partners')]
        except Exception:
            kept = []
    programs = []
    for pid in settings.children('ProgramInfo'):
        g = ['ProgramInfo', pid]
        programs.append({'id': pid, 'name': shown_name(settings.get(g, 'Name', pid)), 'kinds': [k for k in settings.get(g, 'Kinds', '').split(',') if k],
                         'package': settings.get(g, 'Package', ''),
                         'installed': bool(installed(settings.get(g, 'Package', ''))) if settings.get(g, 'Package', '') else
                         any(os.access(e, os.X_OK) for e in settings.get(g, 'Executables', '').split(',') if e),
                         'note': settings.get(g, 'Note', ''),
                         'choices': [choice(settings, k, pid) for k in settings.get(g, 'Kinds', '').split(',') if k]})
    return {'engine': engine, 'llamacpp': llamacpp, 'card': card, 'proposal': proposal(card),
            'defaults': [choice(settings, k) for k in settings.kinds()],
            'interfaces': interfaces(settings), 'programs': programs, 'problems': kept,
            'ollamaSize': apt_size('ollama'), 'computer': socket.gethostname(), 'ollamaKey': os.path.join(os.path.expanduser('~'), '.ollama', 'id_ed25519')}


def apt_size(package):
    out = subprocess.run(['apt-cache', 'show', '--no-all-versions', package], capture_output=True, text=True)
    m = re.search(r'^Size: (\d+)', out.stdout, re.M)
    return int(m.group(1)) if m else 0


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        # for people: in their language, through the page's catalogue
        print(tr('@info:shell the command\'s help', """sparky-stereo-partners: the Partners page's choices, for the page, for programs and for tests (ORDER 70).

    sparky-stereo-partners status [--json]               the engine, its card, the defaults, the programs, the providers
    sparky-stereo-partners resolve --kind KIND [--program DESKTOP-ID] [--shell]
                                                          who answers: the interface's address, the model, the card's variables
    sparky-stereo-partners set-default KIND [--interface ID] [--model NAME|--no-model]
    sparky-stereo-partners program DESKTOP-ID KIND follow | own [--interface ID] [--model NAME]
    sparky-stereo-partners card auto|cpu|integrated|discrete|profile|pci-...   (the one key, [Render] Partners, as the Graphics page)
    sparky-stereo-partners engine on|off [--engine ollama|llamacpp]
                                                          a local engine's user service (ollama.service, sparky-stereo-llama-server.service)
    sparky-stereo-partners account [--json] | signin | signout
                                                          Ollama's service (ollama.com), through the local engine: signed in or not
    sparky-stereo-partners models [--json]               the models the page offers, each with its size from the registry
    sparky-stereo-partners download NAME [--even-if-metered]   the engine downloads one model (its size said first)
    sparky-stereo-partners provider add ID --name NAME --url URL   (the key is read from standard input, kept in KDE Wallet)
    sparky-stereo-partners provider remove ID | provider list [--json]
    sparky-stereo-partners sync                          programs that read a file of their own get the page's choice: Betterbird's
                                                          ThunderAI (a managed-storage manifest in ~/.mozilla), when Betterbird is installed
    sparky-stereo-partners install-plan [--engine E] | install [--engine E] [--even-if-metered]
                                                          (through pkexec: the engine and this computer's runner)

The choices live in sparky-stereo-partnersrc: the system's in /etc/xdg (shipped), the person's in ~/.config, key by key as
KConfig cascades them; this command writes only the person's file, through kwriteconfig6. Keys never go into either file.
Exit status: 0 done, 1 not known (a value nobody set), 2 wrong arguments, 3 failed (said, and kept by the problems engine), 4 the
card cannot be used (sparky-stereo-gpu-env said why), 5 held: the connection is metered or its state could not be read,
6 another program already uses the engine's address, 7 not signed in to Ollama's service (the address to sign in is printed).
"""))
        return 0 if argv else 2
    settings = Settings()
    cmd, rest = argv[0], argv[1:]
    flag = lambda name: name in rest
    def opt(name):
        return rest[rest.index(name) + 1] if name in rest and rest.index(name) + 1 < len(rest) else None
    if cmd == 'status':
        data = status(settings)
        if flag('--json'):
            print(json.dumps(data, ensure_ascii=False))
        else:
            # for people, in their language (programs read --json)
            for key, engine in (('engine', ENGINES['ollama']), ('llamacpp', ENGINES['llamacpp'])):
                e = data[key]
                state = (tr('@info', 'Not installed') if not e['installed'] else
                         tr('@info %1 an address', 'On, answering on this computer only (%1)', e['address']) if e['on'] else tr('@info', 'Off'))
                print(tr('@info:shell %1 an engine, %2 its state', '%1: %2', tr(*engine['name']), state))
            card = data['card']
            print(tr('@info:shell %1 a card, %2 why', 'Card: %1 (%2)', card['name'] or card['id'], card['reason']))
            for d in data['defaults']:
                print(tr('@info:shell %1 a kind of work, %2 who answers, %3 the model', '%1: %2, %3', d['kind'],
                         d['name'] or tr('@item:inlistbox no interface', 'None'), d['model'] or tr('@item:inlistbox', 'No model chosen')))
        return 0
    if cmd == 'resolve':
        kind = opt('--kind')
        if not kind:
            return 2
        return resolve(settings, kind, opt('--program'), flag('--shell'))
    if cmd == 'set-default' and rest:
        if opt('--interface'):
            write(['Default', rest[0]], 'Interface', opt('--interface'))
        if opt('--model'):
            write(['Default', rest[0]], 'Model', opt('--model'))
        if flag('--no-model'):
            write(['Default', rest[0]], 'Model', None)
        return sync(Settings())
    if cmd == 'sync':
        return sync(settings)
    if cmd == 'program' and len(rest) >= 3:
        pid, kind, how = rest[:3]
        if how == 'follow':
            write(['Program', pid, kind], 'Interface', None)
            write(['Program', pid, kind], 'Model', None)
            return sync(Settings())
        if how == 'own':
            for field in ('Interface', 'Model'):
                if opt('--' + field.lower()):
                    write(['Program', pid, kind], field, opt('--' + field.lower()))
            return sync(Settings())
        return 2
    if cmd == 'card' and rest:
        return card_set(rest[0])
    if cmd == 'engine' and rest and rest[0] in ('on', 'off'):
        eng = opt('--engine') or 'ollama'
        if eng not in ENGINES:
            return 2
        return engine_on(settings, eng) if rest[0] == 'on' else engine_off(eng)
    if cmd in ('account', 'signin'):
        found, code = account(settings, open_browser=cmd == 'signin')
        if cmd == 'account':
            print(json.dumps(found, ensure_ascii=False) if flag('--json') else found['state'] + ('\t' + found['name'] if found.get('name') else ''))
        return code
    if cmd == 'signout':
        return signout(settings)
    if cmd == 'models':
        data = models(settings)
        print(json.dumps(data, ensure_ascii=False) if flag('--json') else '\n'.join('%s\t%s%s' % (m['name'], m['sizeText'], '\t' + m['error'] if m['error'] else '') for m in data))
        return 0 if all(not m['error'] for m in data) else 3
    if cmd == 'download' and rest:
        return download(settings, rest[0], flag('--even-if-metered'))
    if cmd == 'provider' and rest:
        if rest[0] == 'add' and len(rest) >= 2 and opt('--name') and opt('--url'):
            secret = '' if sys.stdin.isatty() else sys.stdin.read().strip()
            return provider_add(rest[1], opt('--name'), opt('--url'), secret)
        if rest[0] == 'remove' and len(rest) >= 2:
            return provider_remove(rest[1])
        if rest[0] == 'list':
            data = [i for i in interfaces(settings) if i['runs'] == 'provider']
            print(json.dumps(data, ensure_ascii=False) if flag('--json') else '\n'.join('%s\t%s\t%s' % (i['id'], i['name'], i['url']) for i in data))
            return 0
        return 2
    if cmd in ('install-plan', 'install'):
        eng = opt('--engine') or 'ollama'
        if eng not in ENGINES:
            return 2
        args = ['pkexec', HELPER, 'plan' if cmd == 'install-plan' else 'install', eng]
        if os.geteuid() == 0:
            args = args[1:]
        if cmd == 'install':
            if held(flag('--even-if-metered')):
                return 5
            args.append('--even-if-metered')
        return subprocess.run(args).returncode
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
