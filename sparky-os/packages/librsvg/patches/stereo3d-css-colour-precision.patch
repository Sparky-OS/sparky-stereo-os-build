+//! CSS colour values: the `<color>` grammar of CSS Color 4 (CRD 1 November 2026) sections 4 to 10,
+//! CSS Color 5 (WD 29 October 2026) sections 2 to 8 and CSS Color HDR 1 (WD 26 October 2026) sections 4 to 8.
+//!
+//! Each colour is kept in its own colour space in double precision.  The conversions port the specifications'
+//! own sample code (CSS Color 4 sections 7.1, 7.2, 8.1, 8.2, 19 and 20.3, CSS Color HDR section 11, CSS Color 5
+//! section 6.1), which W3C publishes under its software and document licence.  Gamut mapping is CSS Color 4
+//! section 14.2.2; interpolation is CSS Color 4 section 13 and CSS Color 5 section 3.3.
+
+use std::f64::consts::{E, PI};
+
+type Vec3 = [f64; 3];
+type Mat3 = [[f64; 3]; 3];
+
+fn mul(m: &Mat3, v: &Vec3) -> Vec3 {
+    [
+        m[0][0] * v[0] + m[0][1] * v[1] + m[0][2] * v[2],
+        m[1][0] * v[0] + m[1][1] * v[1] + m[1][2] * v[2],
+        m[2][0] * v[0] + m[2][1] * v[1] + m[2][2] * v[2],
+    ]
+}
+
+fn spow(base: f64, e: f64) -> f64 {
+    base.abs().powf(e).copysign(base)
+}
+
+// CSS Color 4 section 19
+const D50: [f64; 3] = [0.3457 / 0.3585, 1.0, (1.0 - 0.3457 - 0.3585) / 0.3585];
+
