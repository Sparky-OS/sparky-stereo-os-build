+
+struct Channels {
+    names: [&'static str; 3],
+    values: [f64; 4], // NaN for a missing component
+}
+
+impl Channels {
+    fn get(&self, name: &str) -> Option<f64> {
+        if name == "alpha" {
+            return Some(self.values[3]);
+        }
+        self.names.iter().position(|n| *n == name).map(|i| self.values[i])
+    }
+}
+
+type PResult<T> = Result<T, String>;
+
+struct Parser<'a> {
+    t: Vec<Tok>,
+    i: usize,
+    ctx: &'a Context,
+    arg_count: usize,
+}
+
+impl<'a> Parser<'a> {
+    fn peek(&self) -> Option<&Tok> {
+        self.t.get(self.i)
+    }
+
+    fn next(&mut self) -> Option<Tok> {
+        let t = self.t.get(self.i).cloned();
+        self.i += 1;
+        t
+    }
+
+    fn ws(&mut self) {
+        while let Some(Tok::Ws) = self.peek() {
+            self.i += 1;
+        }
+    }
+
+    fn at_comma(&mut self) -> bool {
+        self.ws();
+        matches!(self.peek(), Some(Tok::Comma))
+    }
+
+    fn at_ident(&mut self, name: &str) -> bool {
+        self.ws();
+        matches!(self.peek(), Some(Tok::Ident(s)) if s == name)
+    }
+
+    fn at_slash(&mut self) -> bool {
+        self.ws();
+        matches!(self.peek(), Some(Tok::Delim('/')))
+    }
+
+    fn expect_comma(&mut self) -> PResult<()> {
+        self.ws();
+        match self.next() {
+            Some(Tok::Comma) => Ok(()),
+            _ => Err("expected ','".to_string()),
+        }
+    }
+
+    fn expect_close(&mut self) -> PResult<()> {
+        self.ws();
+        match self.next() {
+            Some(Tok::RParen) => Ok(()),
+            _ => Err("expected ')'".to_string()),
+        }
+    }
+
+    /// A speculative parse: on failure the position is restored.
+    fn attempt<T>(&mut self, f: impl FnOnce(&mut Self) -> PResult<T>) -> Option<T> {
+        let save = self.i;
+        match f(self) {
+            Ok(v) => Some(v),
+            Err(_) => {
+                self.i = save;
+                None
+            }
+        }
+    }
+
+    fn angle(v: f64, unit: &str) -> PResult<Num> {
+        let f = match unit {
+            "deg" => 1.0,
+            "grad" => 0.9,
+            "rad" => 180.0 / PI,
+            "turn" => 360.0,
+            _ => return Err(format!("unit {} is not an angle", unit)),
+        };
+        Ok(Num { v: v * f, t: Unit::Angle })
+    }
+
+    // ---- math functions (CSS Values 4 section 10), with channel keywords as numbers
+    fn math_value(&mut self, ch: Option<&Channels>) -> PResult<Num> {
+        self.ws();
+        match self.next() {
+            Some(Tok::Number(v, _)) => Ok(Num { v, t: Unit::Number }),
+            Some(Tok::Percentage(v, _)) => Ok(Num { v, t: Unit::Percentage }),
+            Some(Tok::Dimension(v, u, _)) => Parser::angle(v, &u),
+            Some(Tok::Ident(name)) => {
+                if let Some(v) = ch.and_then(|c| c.get(&name)) {
+                    return Ok(Num { v: if v.is_nan() { 0.0 } else { v }, t: Unit::Number });
+                }
+                let v = match name.as_str() {
+                    "e" => E,
+                    "pi" => PI,
+                    "infinity" => f64::INFINITY,
+                    "-infinity" => f64::NEG_INFINITY,
+                    "nan" => f64::NAN,
+                    _ => return Err(format!("unknown keyword {} in a math function", name)),
+                };
+                Ok(Num { v, t: Unit::Number })
+            }
+            Some(Tok::LParen) => {
+                let v = self.math_sum(ch)?;
+                self.expect_close()?;
+                Ok(v)
+            }
+            Some(Tok::Function(name)) if is_math(&name) => self.math_function(&name, ch),
+            _ => Err("not a math value".to_string()),
+        }
+    }
+
+    fn math_product(&mut self, ch: Option<&Channels>) -> PResult<Num> {
+        let mut v = self.math_value(ch)?;
+        loop {
+            let save = self.i;
+            self.ws();
+            match self.peek() {
+                Some(Tok::Delim(op @ ('*' | '/'))) => {
+                    let times = *op == '*';
+                    self.i += 1;
+                    let w = self.math_value(ch)?;
+                    if times {
+                        if v.t != Unit::Number && w.t != Unit::Number {
+                            return Err("a product of two dimensions".to_string());
+                        }
+                        v = Num { v: v.v * w.v, t: if v.t == Unit::Number { w.t } else { v.t } };
+                    } else {
+                        if w.t != Unit::Number && w.t != v.t {
+                            return Err("a division by a dimension".to_string());
+                        }
+                        v = Num { v: v.v / w.v, t: if w.t == v.t { Unit::Number } else { v.t } };
+                    }
+                }
+                _ => {
+                    self.i = save;
+                    return Ok(v);
+                }
+            }
+        }
+    }
+
+    fn math_sum(&mut self, ch: Option<&Channels>) -> PResult<Num> {
+        let mut v = self.math_product(ch)?;
+        loop {
+            let save = self.i;
+            let had_ws = matches!(self.peek(), Some(Tok::Ws));
+            self.ws();
+            let ws_after = matches!(self.t.get(self.i + 1), Some(Tok::Ws));
+            match self.peek().cloned() {
+                Some(Tok::Delim(op @ ('+' | '-'))) if had_ws && ws_after => {
+                    self.i += 1;
+                    let w = self.math_product(ch)?;
+                    if w.t != v.t {
+                        return Err("a sum of different types".to_string());
+                    }
+                    v = Num { v: if op == '+' { v.v + w.v } else { v.v - w.v }, t: v.t };
+                }
+                Some(Tok::Number(_, true)) | Some(Tok::Percentage(_, true)) | Some(Tok::Dimension(_, _, true)) if had_ws => {
+                    return Err("+ and - need whitespace on both sides".to_string());
+                }
+                _ => {
+                    self.i = save;
+                    return Ok(v);
+                }
+            }
+        }
+    }
+
+    fn math_args(&mut self, ch: Option<&Channels>) -> PResult<Vec<Num>> {
+        let mut args = vec![self.math_sum(ch)?];
+        while self.at_comma() {
+            self.i += 1;
+            args.push(self.math_sum(ch)?);
+        }
+        self.expect_close()?;
+        self.arg_count = args.len();
+        Ok(args)
+    }
+
+    fn math_function(&mut self, name: &str, ch: Option<&Channels>) -> PResult<Num> {
+        let nan = f64::NAN;
+        if name == "round" {
+            let mut strategy = 0;
+            self.ws();
+            if let Some(Tok::Ident(s)) = self.peek().cloned() {
+                if let Some(k) = ["nearest", "up", "down", "to-zero"].iter().position(|x| *x == s) {
+                    self.i += 1;
+                    strategy = k;
+                    self.expect_comma()?;
+                }
+            }
+            let a = self.math_args(ch)?;
+            let b = if a.len() > 1 { a[1].v } else { 1.0 };
+            if b == 0.0 {
+                return Ok(Num { v: nan, t: a[0].t });
+            }
+            let q = a[0].v / b;
+            let r = match strategy {
+                0 => (q + 0.5).floor(),
+                1 => q.ceil(),
+                2 => q.floor(),
+                _ => q.trunc(),
+            };
+            return Ok(Num { v: r * b, t: a[0].t });
+        }
+        let a = self.math_args(ch)?;
+        let same = |a: &[Num]| -> PResult<Unit> {
+            if a.iter().any(|x| x.t != a[0].t) {
+                Err(format!("{}() of different types", name))
+            } else {
+                Ok(a[0].t)
+            }
+        };
+        let radians = |x: &Num| -> PResult<f64> {
+            match x.t {
+                Unit::Percentage => Err("trigonometry of a percentage".to_string()),
+                Unit::Angle => Ok(x.v * PI / 180.0),
+                Unit::Number => Ok(x.v),
+            }
+        };
+        let n = |v: f64| Num { v, t: Unit::Number };
+        match name {
+            "calc" => {
+                if a.len() != 1 {
+                    return Err("calc() takes one argument".to_string());
+                }
+                Ok(a[0])
+            }
+            "min" | "max" => {
+                let t = same(&a)?;
+                let v = a.iter().map(|x| x.v).fold(a[0].v, |m, x| if name == "min" { m.min(x) } else { m.max(x) });
+                Ok(Num { v, t })
+            }
+            "clamp" => {
+                if a.len() != 3 {
+                    return Err("clamp() takes three arguments".to_string());
+                }
+                let t = same(&a)?;
+                Ok(Num { v: a[0].v.max(a[1].v.min(a[2].v)), t })
+            }
+            "mod" | "rem" => {
+                let t = same(&a)?;
+                if a.len() != 2 {
+                    return Err(format!("{}() takes two arguments", name));
+                }
+                if a[1].v == 0.0 {
+                    return Ok(Num { v: nan, t });
+                }
+                let q = a[0].v / a[1].v;
+                Ok(Num { v: a[0].v - a[1].v * if name == "mod" { q.floor() } else { q.trunc() }, t })
+            }
+            "sin" => Ok(n(radians(&a[0])?.sin())),
+            "cos" => Ok(n(radians(&a[0])?.cos())),
+            "tan" => Ok(n(radians(&a[0])?.tan())),
+            "asin" | "acos" | "atan" => {
+                if a[0].t != Unit::Number {
+                    return Err(format!("{}() of a dimension", name));
+                }
+                let r = match name {
+                    "asin" => a[0].v.asin(),
+                    "acos" => a[0].v.acos(),
+                    _ => a[0].v.atan(),
+                };
+                Ok(Num { v: r * 180.0 / PI, t: Unit::Angle })
+            }
+            "atan2" => {
+                same(&a)?;
+                if a.len() != 2 {
+                    return Err("atan2() takes two arguments".to_string());
+                }
+                Ok(Num { v: a[0].v.atan2(a[1].v) * 180.0 / PI, t: Unit::Angle })
+            }
+            "pow" => {
+                if a.len() != 2 || a[0].t != Unit::Number || a[1].t != Unit::Number {
+                    return Err("pow() takes two numbers".to_string());
+                }
+                Ok(n(a[0].v.powf(a[1].v)))
+            }
+            "sqrt" => Ok(n(if a[0].v >= 0.0 { a[0].v.sqrt() } else { nan })),
+            "hypot" => {
+                let t = same(&a)?;
+                Ok(Num { v: a.iter().map(|x| x.v * x.v).sum::<f64>().sqrt(), t })
+            }
+            "log" => {
+                let v = a[0].v;
+                let r = if v > 0.0 {
+                    v.ln()
+                } else if v == 0.0 {
+                    f64::NEG_INFINITY
+                } else {
+                    nan
+                };
+                Ok(n(if a.len() > 1 { r / a[1].v.ln() } else { r }))
+            }
+            "exp" => Ok(n(a[0].v.exp())),
+            "abs" => Ok(Num { v: a[0].v.abs(), t: a[0].t }),
+            "sign" => Ok(n(if a[0].v == 0.0 { 0.0 } else { 1.0f64.copysign(a[0].v) })),
+            _ => Err(name.to_string()),
+        }
+    }
+
+    fn component(&mut self, ch: Option<&Channels>, allow_percent: bool, hue: bool, allow_none: bool) -> PResult<Comp> {
+        self.ws();
+        let v = match self.peek().cloned() {
+            Some(Tok::Ident(name)) if name == "none" => {
+                if !allow_none {
+                    return Err("none is not allowed here".to_string());
+                }
+                self.i += 1;
+                return Ok(Comp { v: 0.0, t: Unit::Number, none: true });
+            }
+            Some(Tok::Ident(name)) if ch.and_then(|c| c.get(&name)).is_some() => {
+                self.i += 1;
+                let v = ch.unwrap().get(&name).unwrap();
+                return Ok(Comp { v: if v.is_nan() { 0.0 } else { v }, t: Unit::Number, none: v.is_nan() });
+            }
+            Some(Tok::Function(name)) if is_math(&name) => {
+                self.i += 1;
+                self.math_function(&name, ch)?
+            }
+            Some(Tok::Number(v, _)) => {
+                self.i += 1;
+                Num { v, t: Unit::Number }
+            }
+            Some(Tok::Percentage(v, _)) => {
+                self.i += 1;
+                Num { v, t: Unit::Percentage }
+            }
+            Some(Tok::Dimension(v, u, _)) => {
+                self.i += 1;
+                if !hue {
+                    return Err(format!("unit {} is not allowed here", u));
+                }
+                Parser::angle(v, &u)?
+            }
+            _ => return Err("expected a number".to_string()),
+        };
+        if v.t == Unit::Percentage && !allow_percent {
+            return Err("a percentage is not allowed here".to_string());
+        }
+        if v.t == Unit::Angle && !hue {
+            return Err("an angle is not allowed here".to_string());
+        }
+        Ok(Comp { v: if v.v.is_nan() { 0.0 } else { v.v }, t: v.t, none: false })
+    }
+
+    /// `[ / [<alpha-value> | none] ]?`
+    fn alpha_part(&mut self, c: &mut CssColor, ch: Option<&Channels>, origin: Option<&CssColor>) -> PResult<()> {
+        if self.at_slash() {
+            self.i += 1;
+            let a = self.component(ch, true, false, true)?;
+            if a.none {
+                c.set_alpha_missing();
+                return Ok(());
+            }
+            let mut v = if a.t == Unit::Percentage { a.v / 100.0 } else { a.v };
+            if v.is_infinite() {
+                v = if v > 0.0 { 1.0 } else { 0.0 };
+            }
+            c.set_alpha(v.clamp(0.0, 1.0));
+        } else if let Some(o) = origin {
+            if o.alpha_missing() {
+                c.set_alpha_missing();
+            } else {
+                c.set_alpha(o.alpha);
+            }
+        } else {
+            c.set_alpha(1.0);
+        }
+        Ok(())
+    }
+
+    fn color(&mut self) -> PResult<CssColor> {
+        self.ws();
+        match self.next() {
+            Some(Tok::Hash(h)) => hex(&h),
+            Some(Tok::Ident(name)) => {
+                if let Some((_, v)) = NAMED_COLORS.iter().find(|(n, _)| *n == name) {
+                    return Ok(CssColor::srgb8(*v, 1.0));
+                }
+                if name == "transparent" {
+                    return Ok(CssColor::srgb8(0, 0.0));
+                }
+                if name == "currentcolor" {
+                    return self.ctx.current_color.ok_or_else(|| {
+                        "currentcolor inside a colour function needs the computed colour, which librsvg does not \
+                         have where colours are parsed"
+                            .to_string()
+                    });
+                }
+                if SYSTEM_COLORS.contains(&name.as_str()) {
+                    return Err(format!(
+                        "the system colour {} needs the platform's palette (CSS Color 4 section 6.2), which librsvg \
+                         does not have",
+                        name
+                    ));
+                }
+                Err(format!("unknown colour {}", name))
+            }
+            Some(Tok::Function(f)) => match f.as_str() {
+                "rgb" | "rgba" => self.rgb_function(),
+                "hsl" | "hsla" => self.hsl_function(),
+                "hwb" => self.modern(Space::Hwb, None, false),
+                "lab" => self.modern(Space::Lab, None, false),
+                "lch" => self.modern(Space::Lch, None, false),
+                "oklab" => self.modern(Space::Oklab, None, false),
+                "oklch" => self.modern(Space::Oklch, None, false),
+                "ictcp" => self.modern(Space::Ictcp, None, false),
+                "jzazbz" => self.modern(Space::Jzazbz, None, false),
+                "jzczhz" => self.modern(Space::Jzczhz, None, false),
+                "color" => self.color_function(),
+                "color-mix" => self.color_mix(),
+                "alpha" => self.alpha_function(),
+                "light-dark" => {
+                    let a = self.color()?;
+                    self.expect_comma()?;
+                    let b = self.color()?;
+                    self.expect_close()?;
+                    Ok(if self.ctx.dark_scheme { b } else { a })
+                }
+                "contrast-color" => {
+                    let c = self.color()?;
+                    self.expect_close()?;
+                    Ok(contrast_color(&c))
+                }
+                "device-cmyk" => self.device_cmyk(),
+                "hdr-color" | "color-hdr" => self.hdr_color(),
+                _ => Err(format!("{}() is not a colour function", f)),
+            },
+            _ => Err("not a colour".to_string()),
+        }
+    }
+
+    fn origin(&mut self) -> PResult<Option<CssColor>> {
+        if self.at_ident("from") {
+            self.i += 1;
+            return Ok(Some(self.color()?));
+        }
+        Ok(None)
+    }
+
+    fn rgb_function(&mut self) -> PResult<CssColor> {
+        let o = self.origin()?;
+        if o.is_none() {
+            if let Some(c) = self.attempt(|p| p.rgb_legacy()) {
+                return Ok(c);
+            }
+        }
+        let ch = o.map(|o| {
+            let s = o.converted_to(Space::Srgb);
+            let g = |i: usize| if s.is_missing(i) { f64::NAN } else { s.c[i] * 255.0 };
+            Channels { names: ["r", "g", "b"], values: [g(0), g(1), g(2), if o.alpha_missing() { f64::NAN } else { o.alpha }] }
+        });
+        let mut c = CssColor::new(Space::Srgb, 0.0, 0.0, 0.0, 1.0);
+        for i in 0..3 {
+            let v = self.component(ch.as_ref(), true, false, true)?;
+            if v.none {
+                c.set_missing(i);
+                continue;
+            }
+            let mut x = (if v.t == Unit::Percentage { v.v * 255.0 / 100.0 } else { v.v }) / 255.0;
+            if o.is_none() {
+                x = x.clamp(0.0, 1.0);
+            }
+            c.set(i, x);
+        }
+        self.alpha_part(&mut c, ch.as_ref(), o.as_ref())?;
+        self.expect_close()?;
+        Ok(c)
+    }
+
+    fn rgb_legacy(&mut self) -> PResult<CssColor> {
+        let mut v = [0.0; 3];
+        let mut kind = Unit::Number;
+        for i in 0..3 {
+            if i > 0 {
+                self.expect_comma()?;
+            }
+            self.ws();
+            if let Some(Tok::Ident(_)) = self.peek() {
+                return Err("keyword in the legacy syntax".to_string());
+            }
+            let c = self.component(None, true, false, false)?;
+            if i > 0 && c.t != kind {
+                return Err("the legacy syntax does not mix numbers and percentages".to_string());
+            }
+            kind = c.t;
+            v[i] = c.v;
+        }
+        let mut alpha = 1.0;
+        if self.at_comma() {
+            self.i += 1;
+            let a = self.component(None, true, false, false)?;
+            alpha = (if a.t == Unit::Percentage { a.v / 100.0 } else { a.v }).clamp(0.0, 1.0);
+        }
+        self.expect_close()?;
+        let k = if kind == Unit::Percentage { 255.0 / 100.0 } else { 1.0 };
+        Ok(CssColor::new(
+            Space::Srgb,
+            (v[0] * k / 255.0).clamp(0.0, 1.0),
+            (v[1] * k / 255.0).clamp(0.0, 1.0),
+            (v[2] * k / 255.0).clamp(0.0, 1.0),
+            alpha,
+        ))
+    }
+
+    fn hsl_function(&mut self) -> PResult<CssColor> {
+        let o = self.origin()?;
+        if o.is_none() {
+            let legacy = self.attempt(|p| {
+                let h = p.component(None, false, true, false)?;
+                p.expect_comma()?;
+                let s = p.component(None, true, false, false)?;
+                p.expect_comma()?;
+                let l = p.component(None, true, false, false)?;
+                if s.t != Unit::Percentage || l.t != Unit::Percentage {
+                    return Err("legacy hsl() takes percentages".to_string());
+                }
+                let mut alpha = 1.0;
+                if p.at_comma() {
+                    p.i += 1;
+                    let a = p.component(None, true, false, false)?;
+                    alpha = (if a.t == Unit::Percentage { a.v / 100.0 } else { a.v }).clamp(0.0, 1.0);
+                }
+                p.expect_close()?;
+                Ok(CssColor::new(Space::Hsl, positive_mod(h.v, 360.0), s.v.max(0.0), l.v, alpha))
+            });
+            if let Some(c) = legacy {
+                return Ok(c);
+            }
+        }
+        self.modern(Space::Hsl, o, true)
+    }
+
+    // CSS Color 4 sections 7 to 9 and CSS Color HDR section 6: percentage reference ranges and parse-time clamps
+    fn modern(&mut self, space: Space, o: Option<CssColor>, origin_parsed: bool) -> PResult<CssColor> {
+        let o = if origin_parsed { o } else { self.origin()? };
+        // (name, percentage reference, hue, clamp low, clamp high)
+        type Rule = (&'static str, f64, bool, Option<f64>, Option<f64>);
+        let rules: [Rule; 3] = match space {
+            Space::Hsl => [("h", 0.0, true, None, None), ("s", 100.0, false, None, None), ("l", 100.0, false, None, None)],
+            Space::Hwb => [("h", 0.0, true, None, None), ("w", 100.0, false, None, None), ("b", 100.0, false, None, None)],
+            Space::Lab => [("l", 100.0, false, Some(0.0), Some(100.0)), ("a", 125.0, false, None, None), ("b", 125.0, false, None, None)],
+            Space::Lch => [("l", 100.0, false, Some(0.0), Some(100.0)), ("c", 150.0, false, Some(0.0), None), ("h", 0.0, true, None, None)],
+            Space::Oklab => [("l", 1.0, false, Some(0.0), Some(1.0)), ("a", 0.4, false, None, None), ("b", 0.4, false, None, None)],
+            Space::Oklch => [("l", 1.0, false, Some(0.0), Some(1.0)), ("c", 0.4, false, Some(0.0), None), ("h", 0.0, true, None, None)],
+            Space::Ictcp => [("i", 1.0, false, None, None), ("ct", 0.5, false, None, None), ("cp", 0.5, false, None, None)],
+            Space::Jzazbz => [("j", 1.0, false, None, None), ("a", 0.21, false, None, None), ("b", 0.21, false, None, None)],
+            Space::Jzczhz => [("j", 1.0, false, None, None), ("c", 0.26, false, None, None), ("h", 0.0, true, None, None)],
+            _ => return Err("internal: not a colour function space".to_string()),
+        };
+        let ch = o.map(|o| {
+            let s = o.converted_to(space);
+            let g = |i: usize| if s.is_missing(i) { f64::NAN } else { s.c[i] };
+            Channels {
+                names: [rules[0].0, rules[1].0, rules[2].0],
+                values: [g(0), g(1), g(2), if o.alpha_missing() { f64::NAN } else { o.alpha }],
+            }
+        });
+        // relative colours keep their values, except that Lab, LCH, Oklab and OkLCh lightness and chroma keep their
+        // parse-time clamps (as the web-platform-tests relative colour tests expect)
+        let keep_clamps = o.is_none() || matches!(space, Space::Lab | Space::Lch | Space::Oklab | Space::Oklch);
+        let mut c = CssColor::new(space, 0.0, 0.0, 0.0, 1.0);
+        for (i, &(_, reference, hue, low, high)) in rules.iter().enumerate() {
+            let v = self.component(ch.as_ref(), !hue, hue, true)?;
+            if v.none {
+                c.set_missing(i);
+                continue;
+            }
+            let mut x = if v.t == Unit::Percentage { v.v * reference / 100.0 } else { v.v };
+            if hue {
+                x = if x.is_infinite() { 0.0 } else { positive_mod(x, 360.0) };
+            }
+            if keep_clamps {
+                if let Some(lo) = low {
+                    x = x.max(lo);
+                }
+                if let Some(hi) = high {
+                    x = x.min(hi);
+                }
+            }
+            if o.is_none() && space == Space::Hsl && i == 1 {
+                x = x.max(0.0);
+            }
+            c.set(i, x);
+        }
+        self.alpha_part(&mut c, ch.as_ref(), o.as_ref())?;
+        self.expect_close()?;
+        Ok(c)
+    }
+
+    fn color_function(&mut self) -> PResult<CssColor> {
+        let o = self.origin()?;
+        self.ws();
+        let name = match self.next() {
+            Some(Tok::Ident(n)) => n,
+            _ => return Err("color() needs a colour space".to_string()),
+        };
+        let space = match name.as_str() {
+            "srgb" => Space::Srgb,
+            "srgb-linear" => Space::SrgbLinear,
+            "display-p3" => Space::DisplayP3,
+            "display-p3-linear" => Space::DisplayP3Linear,
+            "a98-rgb" => Space::A98Rgb,
+            "prophoto-rgb" => Space::ProphotoRgb,
+            "rec2020" => Space::Rec2020,
+            "rec2100-pq" => Space::Rec2100Pq,
+            "rec2100-hlg" => Space::Rec2100Hlg,
+            "rec2100-linear" => Space::Rec2100Linear,
+            "xyz" | "xyz-d65" => Space::XyzD65,
+            "xyz-d50" => Space::XyzD50,
+            n if n.starts_with("--") => {
+                return Err(format!("the custom colour space {} needs an @color-profile, which librsvg does not load", n));
+            }
+            n => return Err(format!("{} is not a predefined colour space", n)),
+        };
+        let xyz = matches!(space, Space::XyzD50 | Space::XyzD65);
+        let ch = o.map(|o| {
+            let s = o.converted_to(space);
+            let g = |i: usize| if s.is_missing(i) { f64::NAN } else { s.c[i] };
+            Channels {
+                names: if xyz { ["x", "y", "z"] } else { ["r", "g", "b"] },
+                values: [g(0), g(1), g(2), if o.alpha_missing() { f64::NAN } else { o.alpha }],
+            }
+        });
+        let mut c = CssColor::new(space, 0.0, 0.0, 0.0, 1.0);
+        for i in 0..3 {
+            let v = self.component(ch.as_ref(), true, false, true)?;
+            if v.none {
+                c.set_missing(i);
+            } else {
+                c.set(i, if v.t == Unit::Percentage { v.v / 100.0 } else { v.v });
+            }
+        }
+        self.alpha_part(&mut c, ch.as_ref(), o.as_ref())?;
+        self.expect_close()?;
+        Ok(c)
+    }
+
+    fn alpha_function(&mut self) -> PResult<CssColor> {
+        let o = self.origin()?.ok_or_else(|| "alpha() needs from <color>".to_string())?;
+        if !self.at_slash() {
+            return Err("alpha() needs / <alpha-value>".to_string());
+        }
+        let ch = Channels { names: ["", "", ""], values: [0.0, 0.0, 0.0, if o.alpha_missing() { f64::NAN } else { o.alpha }] };
+        let mut c = o;
+        self.alpha_part(&mut c, Some(&ch), Some(&o))?;
+        self.expect_close()?;
+        Ok(c)
+    }
+
+    fn device_cmyk(&mut self) -> PResult<CssColor> {
+        let mut c = CssColor::new(Space::Srgb, 0.0, 0.0, 0.0, 1.0);
+        let legacy = self.attempt(|p| {
+            let mut v = [0.0; 4];
+            for (i, x) in v.iter_mut().enumerate() {
+                if i > 0 {
+                    p.expect_comma()?;
+                }
+                *x = p.component(None, false, false, false)?.v;
+            }
+            p.expect_close()?;
+            Ok(v)
+        });
+        let mut v = match legacy {
+            Some(v) => v,
+            None => {
+                let mut v = [0.0; 4];
+                for x in v.iter_mut() {
+                    let k = self.component(None, true, false, true)?;
+                    *x = if k.none { 0.0 } else if k.t == Unit::Percentage { k.v / 100.0 } else { k.v };
+                }
+                self.alpha_part(&mut c, None, None)?;
+                self.expect_close()?;
+                v
+            }
+        };
+        for x in v.iter_mut() {
+            *x = x.clamp(0.0, 1.0);
+        }
+        // CSS Color 5 section 6.1, the naive conversion (there is no @color-profile for device-cmyk)
+        for i in 0..3 {
+            c.set(i, 1.0 - (v[i] * (1.0 - v[3]) + v[3]).min(1.0));
+        }
+        Ok(c)
+    }
+
+    // CSS Color 5 section 3.3, with CSS Values 5 section 6.1's percentage normalization
+    fn color_mix(&mut self) -> PResult<CssColor> {
+        let mut space = Space::Oklab;
+        let mut hue_method = 0;
+        if self.at_ident("in") {
+            self.i += 1;
+            self.ws();
+            let name = match self.next() {
+                Some(Tok::Ident(n)) => n,
+                _ => return Err("not an interpolation colour space".to_string()),
+            };
+            space = match name.as_str() {
+                "srgb" => Space::Srgb,
+                "srgb-linear" => Space::SrgbLinear,
+                "display-p3" => Space::DisplayP3,
+                "display-p3-linear" => Space::DisplayP3Linear,
+                "a98-rgb" => Space::A98Rgb,
+                "prophoto-rgb" => Space::ProphotoRgb,
+                "rec2020" => Space::Rec2020,
+                "lab" => Space::Lab,
+                "oklab" => Space::Oklab,
+                "xyz" | "xyz-d65" => Space::XyzD65,
+                "xyz-d50" => Space::XyzD50,
+                "hsl" => Space::Hsl,
+                "hwb" => Space::Hwb,
+                "lch" => Space::Lch,
+                "oklch" => Space::Oklch,
+                _ => return Err("not an interpolation colour space".to_string()),
+            };
+            self.ws();
+            if space.is_polar() {
+                if let Some(Tok::Ident(m)) = self.peek().cloned() {
+                    if let Some(k) = ["shorter", "longer", "increasing", "decreasing"].iter().position(|x| *x == m) {
+                        self.i += 1;
+                        hue_method = k;
+                        if !self.at_ident("hue") {
+                            return Err("expected hue".to_string());
+                        }
+                        self.i += 1;
+                    }
+                }
+            }
+            self.expect_comma()?;
+        }
+        let mut items: Vec<(CssColor, f64, bool)> = Vec::new();
+        loop {
+            let mut pct = 0.0;
+            let mut given = false;
+            let col;
+            if self.at_percent() {
+                pct = self.mix_percent()?;
+                given = true;
+                col = self.color()?;
+            } else {
+                col = self.color()?;
+                if self.at_percent() {
+                    pct = self.mix_percent()?;
+                    given = true;
+                }
+            }
+            items.push((col, pct, given));
+            if self.at_comma() {
+                self.i += 1;
+                continue;
+            }
+            self.expect_close()?;
+            break;
+        }
+        let specified: f64 = items.iter().filter(|x| x.2).map(|x| x.1).sum();
+        let omitted = items.iter().filter(|x| !x.2).count();
+        let specified_clamped = specified.min(100.0);
+        let mut total = 0.0;
+        for it in items.iter_mut() {
+            if !it.2 {
+                it.1 = (100.0 - specified_clamped) / omitted as f64;
+            }
+            total += it.1;
+        }
+        if total > 0.0 {
+            for it in items.iter_mut() {
+                it.1 = it.1 * 100.0 / total;
+            }
+        }
+        let leftover = if total < 100.0 { 100.0 - total } else { 0.0 };
+        let mut result = if items.len() == 1 {
+            items[0].0.converted_to(space)
+        } else {
+            let mut acc = items[0].0;
+            let mut acc_pct = items[0].1;
+            for it in items.iter().skip(1) {
+                let combined = acc_pct + it.1;
+                let p = if combined > 0.0 { it.1 / combined } else { 0.5 };
+                acc = interpolate(&acc, &it.0, p, space, hue_method);
+                acc_pct = combined;
+            }
+            acc
+        };
+        if !result.alpha_missing() {
+            result.alpha *= 1.0 - leftover / 100.0;
+        }
+        Ok(result)
+    }
+
+    fn at_percent(&mut self) -> bool {
+        self.ws();
+        match self.peek() {
+            Some(Tok::Percentage(..)) => true,
+            Some(Tok::Function(f)) => is_math(f),
+            _ => false,
+        }
+    }
+
+    fn mix_percent(&mut self) -> PResult<f64> {
+        self.ws();
+        let literal = matches!(self.peek(), Some(Tok::Percentage(..)));
+        let v = self.component(None, true, false, false)?;
+        if v.t != Unit::Percentage {
+            return Err("a color-mix() amount is a percentage".to_string());
+        }
+        if literal && !(0.0..=100.0).contains(&v.v) {
+            return Err("a color-mix() amount is between 0% and 100%".to_string());
+        }
+        Ok(v.v.clamp(0.0, 100.0))
+    }
+
+    // CSS Color HDR sections 5.1 and 11.6; librsvg draws on SDR targets, so the colour is the one at headroom 0
+    fn hdr_color(&mut self) -> PResult<CssColor> {
+        let mut c = [CssColor::new(Space::Srgb, 0.0, 0.0, 0.0, 1.0); 2];
+        let mut h = [0.0; 2];
+        for i in 0..2 {
+            if i > 0 {
+                self.expect_comma()?;
+            }
+            self.ws();
+            if let Some(Tok::Number(v, _)) = self.peek().cloned() {
+                self.i += 1;
+                h[i] = v;
+                c[i] = self.color()?;
+            } else {
+                c[i] = self.color()?;
+                self.ws();
+                if let Some(Tok::Number(v, _)) = self.peek().cloned() {
+                    self.i += 1;
+                    h[i] = v;
+                }
+            }
+            if h[i] < 0.0 {
+                return Err("a negative headroom".to_string());
+            }
+        }
+        self.expect_close()?;
+        if h[0] == h[1] {
+            return Err("hdr-color() needs two different headrooms".to_string());
+        }
+        Ok(hdr_mix(&c[0], h[0], &c[1], h[1], 0.0))
+    }
+}
+
+fn hex(h: &str) -> PResult<CssColor> {
+    if ![3, 4, 6, 8].contains(&h.len()) || !h.chars().all(|c| c.is_ascii_hexdigit()) {
+        return Err(format!("#{} is not a hex colour", h));
+    }
+    let x: String = if h.len() <= 4 { h.chars().flat_map(|c| [c, c]).collect() } else { h.to_string() };
+    let v = u32::from_str_radix(&x, 16).map_err(|_| format!("#{} is not a hex colour", h))?;
+    if x.len() == 8 {
+        Ok(CssColor::srgb8(v >> 8, f64::from(v & 255) / 255.0))
+    } else {
+        Ok(CssColor::srgb8(v, 1.0))
+    }
+}
+
+/// CSS Color 5 section 8: white or black, whichever contrasts more; white on a tie.  The algorithm is UA-defined;
+/// this one uses the WCAG 2.1 relative luminance of the gamut-mapped sRGB colour.
+fn contrast_color(c: &CssColor) -> CssColor {
+    let mut opaque = *c;
+    opaque.set_alpha(1.0);
+    let (rgb, _) = gamut_map(&opaque, Space::Srgb);
+    let lum = mul(&SRGB_TO_XYZ, &lin_srgb(&rgb))[1];
+    if 1.05 / (lum + 0.05) >= (lum + 0.05) / 0.05 {
+        CssColor::srgb8(0xffffff, 1.0)
+    } else {
+        CssColor::srgb8(0x000000, 1.0)
+    }
+}
+
+fn hdr_mix(c1: &CssColor, h1: f64, c2: &CssColor, h2: f64, headroom: f64) -> CssColor {
+    let x1 = c1.to_xyz_d65();
+    let x2 = c2.to_xyz_d65();
+    let w1 = ((headroom - h2) / (h1 - h2)).clamp(0.0, 1.0);
+    let w2 = ((headroom - h1) / (h2 - h1)).clamp(0.0, 1.0);
+    let eps = 0.001;
+    let mut out = [0.0; 3];
+    for i in 0..3 {
+        out[i] = ((x1[i] * YW + eps).powf(w1) * (x2[i] * YW + eps).powf(w2) - eps) / YW;
+    }
+    let a1 = if c1.alpha_missing() { 1.0 } else { c1.alpha };
+    let a2 = if c2.alpha_missing() { 1.0 } else { c2.alpha };
+    CssColor::new(Space::XyzD65, out[0], out[1], out[2], a1 * w1 + a2 * w2)
+}
+
+// CSS Color 4 section 13
+fn interpolate(a: &CssColor, b: &CssColor, p: f64, space: Space, hue_method: usize) -> CssColor {
+    let ca = a.converted_to(space);
+    let cb = b.converted_to(space);
+    let mut va = ca.c;
+    let mut vb = cb.c;
+    let mut ma = [ca.is_missing(0), ca.is_missing(1), ca.is_missing(2)];
+    let mut mb = [cb.is_missing(0), cb.is_missing(1), cb.is_missing(2)];
+    for i in 0..3 {
+        if ma[i] && !mb[i] {
+            va[i] = vb[i];
+            ma[i] = false;
+        } else if mb[i] && !ma[i] {
+            vb[i] = va[i];
+            mb[i] = false;
+        }
+    }
+    let (mut amiss_a, amiss_b) = (a.alpha_missing(), b.alpha_missing());
+    let (mut aa, mut ab) = (a.alpha, b.alpha);
+    if amiss_a && !amiss_b {
+        aa = ab;
+        amiss_a = false;
+    } else if amiss_b && !amiss_a {
+        ab = aa;
+    }
+    let hi = space.hue_index();
+    if let Some(h) = hi {
+        if !ma[h] && !mb[h] {
+            let mut t1 = positive_mod(va[h], 360.0);
+            let mut t2 = positive_mod(vb[h], 360.0);
+            let d = t2 - t1;
+            match hue_method {
+                0 => {
+                    if d > 180.0 {
+                        t1 += 360.0;
+                    } else if d < -180.0 {
+                        t2 += 360.0;
+                    }
+                }
+                1 => {
+                    if 0.0 < d && d < 180.0 {
+                        t1 += 360.0;
+                    } else if -180.0 < d && d <= 0.0 {
+                        t2 += 360.0;
+                    }
+                }
+                2 => {
+                    if t2 < t1 {
+                        t2 += 360.0;
+                    }
+                }
+                _ => {
+                    if t1 < t2 {
+                        t1 += 360.0;
+                    }
+                }
+            }
+            va[h] = t1;
+            vb[h] = t2;
+        }
+    }
+    let alpha_none = amiss_a;
+    let alpha = if alpha_none { 0.0 } else { aa * (1.0 - p) + ab * p };
+    let mut out = CssColor::new(space, 0.0, 0.0, 0.0, 1.0);
+    for i in 0..3 {
+        if ma[i] || mb[i] {
+            out.set_missing(i);
+            continue;
+        }
+        let mut x;
+        if alpha_none || Some(i) == hi {
+            x = va[i] * (1.0 - p) + vb[i] * p;
+        } else {
+            x = va[i] * aa * (1.0 - p) + vb[i] * ab * p;
+            if alpha != 0.0 {
+                x /= alpha;
+            }
+        }
+        if Some(i) == hi {
+            x = positive_mod(x, 360.0);
+        }
+        out.set(i, x);
+    }
+    if alpha_none {
+        out.set_alpha_missing();
+    } else {
+        out.set_alpha(alpha);
+    }
+    out
+}
+
+/// Parses a `<color>`; the whole string must be one colour.
+pub fn parse_css_color(text: &str, ctx: &Context) -> Result<CssColor, String> {
+    let mut p = Parser { t: tokenize(text), i: 0, ctx, arg_count: 0 };
+    let c = p.color()?;
+    p.ws();
+    if p.i < p.t.len() {
+        return Err("unexpected text after the colour".to_string());
+    }
+    let _ = p.arg_count;
+    Ok(c)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn close(a: &[f64], b: &[f64], eps: f64) -> bool {
+        a.iter().zip(b).all(|(x, y)| (x - y).abs() <= eps)
+    }
+
+    // the specifications' own examples (CSS Color 4 sections 10.1 and 14.1.3, CSS Color HDR sections 5 and 8)
+    #[test]
+    fn spec_examples() {
+        let ctx = Context::default();
+        let white = [1.0, 1.0, 1.0];
+        for text in ["color(rec2100-pq 0.5807 0.5807 0.5807)", "color(rec2100-hlg 0.75 0.75 0.75)", "ictcp(0.58069 0 0)"] {
+            let c = parse_css_color(text, &ctx).unwrap();
+            assert!(close(&c.display_values(Space::Srgb), &white, 2e-4), "{}", text);
+        }
+        let p3 = parse_css_color("color(rec2020 0.42053 0.979780 0.00579)", &ctx).unwrap();
+        assert!(close(&p3.display_values(Space::DisplayP3), &[-0.350289, 1.00707, -0.144209], 2e-4));
+        let yellow = parse_css_color("color(display-p3 1 1 0)", &ctx).unwrap();
+        let (mapped, was) = gamut_map(&yellow, Space::Srgb);
+        assert!(was && close(&mapped, &[0.99116, 0.99733, 0.00001], 0.01));
+        let hdr = parse_css_color(
+            "color-hdr(color(rec2100-linear 0.9 1.0 0.8) 0, color(rec2100-linear 1.8 2.0 1.5) 2)",
+            &ctx,
+        )
+        .unwrap();
+        let first = parse_css_color("color(rec2100-linear 0.9 1.0 0.8)", &ctx).unwrap();
+        assert!(close(&hdr.to_xyz_d65(), &first.to_xyz_d65(), 1e-4));
+    }
+
+    #[test]
+    fn invalid_colours_say_why() {
+        let ctx = Context::default();
+        for text in ["color(profoto-rgb 0.4835 0.9167 0.2188)", "lab(50% 40 abc)", "rgb(none, 20, 30)", "color(srgb, 1, 0, 0)"] {
+            assert!(parse_css_color(text, &ctx).is_err(), "{}", text);
+        }
+    }
+}
