+fn lin_srgb(v: &Vec3) -> Vec3 {
+    v.map(|x| {
+        let a = x.abs();
+        if a <= 0.04045 { x / 12.92 } else { ((a + 0.055) / 1.055).powf(2.4).copysign(x) }
+    })
+}
+
+fn gam_srgb(v: &Vec3) -> Vec3 {
+    v.map(|x| {
+        let a = x.abs();
+        if a > 0.0031308 { (1.055 * a.powf(1.0 / 2.4) - 0.055).copysign(x) } else { 12.92 * x }
+    })
+}
+
+fn lin_prophoto(v: &Vec3) -> Vec3 {
+    v.map(|x| if x.abs() <= 16.0 / 512.0 { x / 16.0 } else { spow(x, 1.8) })
+}
+
+fn gam_prophoto(v: &Vec3) -> Vec3 {
+    v.map(|x| if x.abs() >= 1.0 / 512.0 { spow(x, 1.0 / 1.8) } else { 16.0 * x })
+}
+
+fn pow_each(v: &Vec3, e: f64) -> Vec3 {
+    v.map(|x| spow(x, e))
+}
+
+fn xyz_to_lab(xyz_d50: &Vec3) -> Vec3 {
+    let eps = 216.0 / 24389.0;
+    let kappa = 24389.0 / 27.0;
+    let mut f = [0.0; 3];
+    for i in 0..3 {
+        let v = xyz_d50[i] / D50[i];
+        f[i] = if v > eps { v.cbrt() } else { (kappa * v + 16.0) / 116.0 };
+    }
+    [116.0 * f[1] - 16.0, 500.0 * (f[0] - f[1]), 200.0 * (f[1] - f[2])]
+}
+
+fn lab_to_xyz(lab: &Vec3) -> Vec3 {
+    let kappa = 24389.0 / 27.0;
+    let eps = 216.0 / 24389.0;
+    let l116 = lab[0] / 116.0;
+    let a500 = lab[1] / 500.0;
+    let b200 = lab[2] / 200.0;
+    let f1 = l116 + 16.0 / 116.0;
+    let f0 = f1 + a500;
+    let f2 = f1 - b200;
+    let xyz = [
+        if f0 * f0 * f0 > eps { f0 * f0 * f0 } else { (l116 + a500) * (116.0 / kappa) },
+        if lab[0] > kappa * eps { ((lab[0] + 16.0) / 116.0).powi(3) } else { lab[0] / kappa },
+        if f2 * f2 * f2 > eps { f2 * f2 * f2 } else { (l116 - b200) * (116.0 / kappa) },
+    ];
+    [xyz[0] * D50[0], xyz[1] * D50[1], xyz[2] * D50[2]]
+}
+
+/// Rectangular to polar; the hue is NaN when powerless (chroma <= epsilon).
+fn to_polar(lab: &Vec3, epsilon: f64) -> Vec3 {
+    let chroma = lab[1].hypot(lab[2]);
+    let mut hue = lab[2].atan2(lab[1]) * 180.0 / PI;
+    if hue < 0.0 {
+        hue += 360.0;
+    }
+    if chroma <= epsilon {
+        hue = f64::NAN;
+    }
+    [lab[0], chroma, hue]
+}
+
+fn from_polar(lch: &Vec3) -> Vec3 {
+    let h = if lch[2].is_nan() { 0.0 } else { lch[2] * PI / 180.0 };
+    [lch[0], lch[1] * h.cos(), lch[1] * h.sin()]
+}
+
+fn xyz_to_oklab(xyz: &Vec3) -> Vec3 {
+    let lms = mul(&XYZ_TO_LMS, xyz);
+    mul(&LMS_TO_OKLAB, &lms.map(f64::cbrt))
+}
+
+fn oklab_to_xyz(lab: &Vec3) -> Vec3 {
+    let lms = mul(&OKLAB_TO_LMS, lab);
+    mul(&LMS_TO_XYZ, &lms.map(|c| c * c * c))
+}
