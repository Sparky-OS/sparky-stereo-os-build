+// CSS Color HDR section 11
+const YW: f64 = 203.0;
+const PQ_C1: f64 = 3424.0 / 4096.0;
+const PQ_C2: f64 = 2413.0 / 128.0;
+const PQ_C3: f64 = 2392.0 / 128.0;
+const PQ_N: f64 = 2610.0 / 16384.0;
+const PQ_M: f64 = 2523.0 / 32.0;
+
+fn pq_encode(v: &Vec3) -> Vec3 {
+    v.map(|x| {
+        let x = (x * YW / 10000.0).max(0.0).powf(PQ_N);
+        ((PQ_C1 + PQ_C2 * x) / (1.0 + PQ_C3 * x)).powf(PQ_M)
+    })
+}
+
+fn pq_decode(v: &Vec3) -> Vec3 {
+    v.map(|x| {
+        let vm = spow(x, 1.0 / PQ_M);
+        ((vm - PQ_C1).max(0.0) / (PQ_C2 - PQ_C3 * vm)).powf(1.0 / PQ_N) * 10000.0 / YW
+    })
+}
+
+const HLG_A: f64 = 0.17883277;
+const HLG_B: f64 = 0.28466892;
+const HLG_C: f64 = 0.55991073;
+const HLG_SCALE: f64 = 3.7743;
+
+fn hlg_encode(v: &Vec3) -> Vec3 {
+    v.map(|x| {
+        let x = x / HLG_SCALE;
+        if x <= 1.0 / 12.0 { spow(3.0 * x, 0.5) } else { HLG_A * (12.0 * x - HLG_B).ln() + HLG_C }
+    })
+}
+
+fn hlg_decode(v: &Vec3) -> Vec3 {
+    v.map(|x| {
+        if x <= 0.5 { x * x / 3.0 * HLG_SCALE } else { ((x - HLG_C) / HLG_A).exp().mul_add(1.0, HLG_B) / 12.0 * HLG_SCALE }
+    })
+}
+
+const JZ_M: Mat3 = [[0.41478972, 0.579999, 0.0146480], [-0.2015100, 1.120649, 0.0531008], [-0.0166008, 0.264800, 0.6684799]];
+const JZ_LMS_TO_IAB: Mat3 = [[0.5, 0.5, 0.0], [3.524000, -4.066708, 0.542708], [0.199076, 1.096799, -1.295875]];
+const JZ_LMS_TO_XYZ: Mat3 = [
+    [1.9242264357876067, -1.0047923125953657, 0.037651404030618],
+    [0.35031676209499907, 0.7264811939316552, -0.06538442294808501],
+    [-0.09098281098284752, -0.3127282905230739, 1.5227665613052603],
+];
+const JZ_IAB_TO_LMS: Mat3 = [
+    [1.0, 0.13860504327153927, 0.05804731615611883],
+    [1.0, -0.1386050432715393, -0.058047316156118904],
+    [1.0, -0.09601924202631895, -0.81189189605603900],
+];
+const JZ_B: f64 = 1.15;
+const JZ_G: f64 = 0.66;
+const JZ_D: f64 = -0.56;
+const JZ_D0: f64 = 1.6295499532821566e-11;
+const JZ_P: f64 = 1.7 * 2523.0 / 32.0;
+
+fn xyz_to_jzazbz(xyz: &Vec3) -> Vec3 {
+    let (xa, ya, za) = (xyz[0] * YW, xyz[1] * YW, xyz[2] * YW);
+    let lms = mul(&JZ_M, &[JZ_B * xa - (JZ_B - 1.0) * za, JZ_G * ya - (JZ_G - 1.0) * xa, za]);
+    let pq = lms.map(|v| {
+        let x = spow(v / 10000.0, PQ_N);
+        spow((PQ_C1 + PQ_C2 * x) / (1.0 + PQ_C3 * x), JZ_P)
+    });
+    let iab = mul(&JZ_LMS_TO_IAB, &pq);
+    [(1.0 + JZ_D) * iab[0] / (1.0 + JZ_D * iab[0]) - JZ_D0, iab[1], iab[2]]
+}
+
+/// The sample code returns absolute XYZ; divided by Yw so that diffuse white is jzazbz(0.22207 ...) (HDR section 6.4).
+fn jzazbz_to_xyz(j: &Vec3) -> Vec3 {
+    let iz = (j[0] + JZ_D0) / (1.0 + JZ_D - JZ_D * (j[0] + JZ_D0));
+    let pq = mul(&JZ_IAB_TO_LMS, &[iz, j[1], j[2]]);
+    let lms = pq.map(|v| {
+        let p = spow(v, 1.0 / JZ_P);
+        10000.0 * spow((PQ_C1 - p) / (PQ_C3 * p - PQ_C2), 1.0 / PQ_N)
+    });
+    let m = mul(&JZ_LMS_TO_XYZ, &lms);
+    let xa = (m[0] + (JZ_B - 1.0) * m[2]) / JZ_B;
+    let ya = (m[1] + (JZ_G - 1.0) * xa) / JZ_G;
+    [xa / YW, ya / YW, m[2] / YW]
+}
+
+const ICTCP_XYZ_TO_LMS: Mat3 = [
+    [0.3592832590121217, 0.6976051147779502, -0.0358915932320290],
+    [-0.1920808463704993, 1.1004767970374321, 0.0753748658519118],
+    [0.0070797844607479, 0.0748396662186362, 0.8433265453898765],
+];
+const ICTCP_LMS_TO_ICTCP: Mat3 = [
+    [2048.0 / 4096.0, 2048.0 / 4096.0, 0.0],
+    [6610.0 / 4096.0, -13613.0 / 4096.0, 7003.0 / 4096.0],
+    [17933.0 / 4096.0, -17390.0 / 4096.0, -543.0 / 4096.0],
+];
+const ICTCP_LMS_TO_XYZ: Mat3 = [
+    [2.0701522183894223, -1.3263473389671563, 0.2066510476294053],
+    [0.3647385209748072, 0.6805660249472273, -0.0453045459220347],
+    [-0.0497472075358123, -0.0492609666966131, 1.1880659249923042],
+];
+const ICTCP_TO_LMS: Mat3 = [
+    [0.9999999999999998, 0.0086090370379328, 0.1110296250030260],
+    [0.9999999999999998, -0.0086090370379328, -0.1110296250030259],
+    [0.9999999999999998, 0.5600313357106791, -0.3206271749873188],
+];
+
+fn xyz_to_ictcp(xyz: &Vec3) -> Vec3 {
+    let lms = mul(&ICTCP_XYZ_TO_LMS, &xyz.map(|v| v * YW));
+    let pq = lms.map(|v| {
+        let x = (v.max(0.0) / 10000.0).powf(PQ_N);
+        ((PQ_C1 + PQ_C2 * x) / (1.0 + PQ_C3 * x)).powf(PQ_M)
+    });
+    mul(&ICTCP_LMS_TO_ICTCP, &pq)
+}
+
+/// The sample code returns absolute XYZ; divided by Yw so that ictcp(0.58069 0 0) is diffuse white (HDR section 6.3).
+fn ictcp_to_xyz(i: &Vec3) -> Vec3 {
+    let pq = mul(&ICTCP_TO_LMS, i);
+    let lms = pq.map(|v| {
+        let vm = spow(v, 1.0 / PQ_M);
+        10000.0 * ((vm - PQ_C1).max(0.0) / (PQ_C2 - PQ_C3 * vm)).powf(1.0 / PQ_N)
+    });
+    mul(&ICTCP_LMS_TO_XYZ, &lms).map(|v| v / YW)
+}
+
+// CSS Color 4 sections 7.1, 7.2, 8.1 and 8.2
+fn hsl_to_rgb(hue: f64, sat: f64, light: f64) -> Vec3 {
+    let sat = sat / 100.0;
+    let light = light / 100.0;
+    let f = |n: f64| {
+        let k = (n + hue / 30.0) % 12.0;
+        let a = sat * light.min(1.0 - light);
+        light - a * (-1.0f64).max((k - 3.0).min(9.0 - k).min(1.0))
+    };
+    [f(0.0), f(8.0), f(4.0)]
+}
+
+fn rgb_to_hsl(r: f64, g: f64, b: f64) -> Vec3 {
+    let mx = r.max(g).max(b);
+    let mn = r.min(g).min(b);
+    let (mut hue, mut sat, light) = (f64::NAN, 0.0, (mn + mx) / 2.0);
+    let d = mx - mn;
+    let epsilon = 1.0 / 100000.0;
+    if d != 0.0 {
+        sat = if light.abs() <= epsilon || (1.0 - light).abs() < epsilon {
+            0.0
+        } else {
+            (mx - light) / light.min(1.0 - light)
+        };
+        hue = if mx == r {
+            (g - b) / d + if g < b { 6.0 } else { 0.0 }
+        } else if mx == g {
+            (b - r) / d + 2.0
+        } else {
+            (r - g) / d + 4.0
+        };
+        hue *= 60.0;
+    }
+    if sat < 0.0 {
+        hue = if hue.is_nan() { 0.0 } else { hue } + 180.0;
+        sat = sat.abs();
+    }
+    if !hue.is_nan() && hue >= 360.0 {
+        hue -= 360.0;
+    }
+    if sat <= epsilon {
+        hue = f64::NAN;
+        sat = 0.0;
+    }
+    [hue, sat * 100.0, light * 100.0]
+}
+
+fn hwb_to_rgb(hue: f64, white: f64, black: f64) -> Vec3 {
+    let white = white / 100.0;
+    let black = black / 100.0;
+    if white + black >= 1.0 {
+        let gray = white / (white + black);
+        return [gray, gray, gray];
+    }
+    hsl_to_rgb(hue, 100.0, 50.0).map(|c| c * (1.0 - white - black) + white)
+}
+
+fn rgb_to_hwb(r: f64, g: f64, b: f64) -> Vec3 {
+    let mx = r.max(g).max(b);
+    let mn = r.min(g).min(b);
+    let d = mx - mn;
+    let mut hue = f64::NAN;
+    if d != 0.0 {
+        hue = if mx == r {
+            (g - b) / d + if g < b { 6.0 } else { 0.0 }
+        } else if mx == g {
+            (b - r) / d + 2.0
+        } else {
+            (r - g) / d + 4.0
+        };
+        hue *= 60.0;
+    }
+    if !hue.is_nan() && hue >= 360.0 {
+        hue -= 360.0;
+    }
+    let (white, black) = (mn, 1.0 - mx);
+    if white + black >= 1.0 - 1.0 / 100000.0 {
+        hue = f64::NAN;
+    }
+    [hue, white * 100.0, black * 100.0]
+}
+
+fn positive_mod(a: f64, m: f64) -> f64 {
+    a.rem_euclid(m)
+}
+
+/// The colour spaces of CSS Color 4 sections 7 to 10 and CSS Color HDR sections 6 and 8.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Space {
+    Srgb,
+    SrgbLinear,
+    DisplayP3,
+    DisplayP3Linear,
+    A98Rgb,
+    ProphotoRgb,
+    Rec2020,
+    Rec2100Pq,
+    Rec2100Hlg,
+    Rec2100Linear,
+    XyzD50,
+    XyzD65,
+    Hsl,
+    Hwb,
+    Lab,
+    Lch,
+    Oklab,
+    Oklch,
+    Ictcp,
+    Jzazbz,
+    Jzczhz,
+}
+
+impl Space {
+    pub fn name(self) -> &'static str {
+        match self {
+            Space::Srgb => "srgb",
+            Space::SrgbLinear => "srgb-linear",
+            Space::DisplayP3 => "display-p3",
+            Space::DisplayP3Linear => "display-p3-linear",
+            Space::A98Rgb => "a98-rgb",
+            Space::ProphotoRgb => "prophoto-rgb",
+            Space::Rec2020 => "rec2020",
+            Space::Rec2100Pq => "rec2100-pq",
+            Space::Rec2100Hlg => "rec2100-hlg",
+            Space::Rec2100Linear => "rec2100-linear",
+            Space::XyzD50 => "xyz-d50",
+            Space::XyzD65 => "xyz-d65",
+            Space::Hsl => "hsl",
+            Space::Hwb => "hwb",
+            Space::Lab => "lab",
+            Space::Lch => "lch",
+            Space::Oklab => "oklab",
+            Space::Oklch => "oklch",
+            Space::Ictcp => "ictcp",
+            Space::Jzazbz => "jzazbz",
+            Space::Jzczhz => "jzczhz",
+        }
+    }
+
+    fn is_polar(self) -> bool {
+        matches!(self, Space::Hsl | Space::Hwb | Space::Lch | Space::Oklch | Space::Jzczhz)
+    }
+
+    fn hue_index(self) -> Option<usize> {
+        match self {
+            Space::Hsl | Space::Hwb => Some(0),
+            Space::Lch | Space::Oklch | Space::Jzczhz => Some(2),
+            _ => None,
+        }
+    }
+
+    fn is_rgb_or_xyz(self) -> bool {
+        matches!(
+            self,
+            Space::Srgb
+                | Space::SrgbLinear
+                | Space::DisplayP3
+                | Space::DisplayP3Linear
+                | Space::A98Rgb
+                | Space::ProphotoRgb
+                | Space::Rec2020
+                | Space::Rec2100Pq
+                | Space::Rec2100Hlg
+                | Space::Rec2100Linear
+                | Space::XyzD50
+                | Space::XyzD65
+        )
+    }
+}
+
+fn to_xyz(space: Space, c: &Vec3) -> Vec3 {
+    match space {
+        Space::Srgb => mul(&SRGB_TO_XYZ, &lin_srgb(c)),
+        Space::SrgbLinear => mul(&SRGB_TO_XYZ, c),
+        Space::DisplayP3 => mul(&P3_TO_XYZ, &lin_srgb(c)),
+        Space::DisplayP3Linear => mul(&P3_TO_XYZ, c),
+        Space::A98Rgb => mul(&A98_TO_XYZ, &pow_each(c, 563.0 / 256.0)),
+        Space::ProphotoRgb => mul(&D50_TO_D65, &mul(&PROPHOTO_TO_XYZ, &lin_prophoto(c))),
+        Space::Rec2020 => mul(&REC2020_TO_XYZ, &pow_each(c, 2.4)),
+        Space::Rec2100Linear => mul(&REC2020_TO_XYZ, c),
+        Space::Rec2100Pq => mul(&REC2020_TO_XYZ, &pq_decode(c)),
+        Space::Rec2100Hlg => mul(&REC2020_TO_XYZ, &hlg_decode(c)),
+        Space::XyzD65 => *c,
+        Space::XyzD50 => mul(&D50_TO_D65, c),
+        Space::Hsl => to_xyz(Space::Srgb, &hsl_to_rgb(positive_mod(c[0], 360.0), c[1], c[2])),
+        Space::Hwb => to_xyz(Space::Srgb, &hwb_to_rgb(positive_mod(c[0], 360.0), c[1], c[2])),
+        Space::Lab => mul(&D50_TO_D65, &lab_to_xyz(c)),
+        Space::Lch => mul(&D50_TO_D65, &lab_to_xyz(&from_polar(c))),
+        Space::Oklab => oklab_to_xyz(c),
+        Space::Oklch => oklab_to_xyz(&from_polar(c)),
+        Space::Jzazbz => jzazbz_to_xyz(c),
+        Space::Jzczhz => jzazbz_to_xyz(&from_polar(c)),
+        Space::Ictcp => ictcp_to_xyz(c),
+    }
+}
+
+fn from_xyz(space: Space, xyz: &Vec3) -> Vec3 {
+    match space {
+        Space::Srgb => gam_srgb(&mul(&XYZ_TO_SRGB, xyz)),
+        Space::SrgbLinear => mul(&XYZ_TO_SRGB, xyz),
+        Space::DisplayP3 => gam_srgb(&mul(&XYZ_TO_P3, xyz)),
+        Space::DisplayP3Linear => mul(&XYZ_TO_P3, xyz),
+        Space::A98Rgb => pow_each(&mul(&XYZ_TO_A98, xyz), 256.0 / 563.0),
+        Space::ProphotoRgb => gam_prophoto(&mul(&XYZ_TO_PROPHOTO, &mul(&D65_TO_D50, xyz))),
+        Space::Rec2020 => pow_each(&mul(&XYZ_TO_REC2020, xyz), 1.0 / 2.4),
+        Space::Rec2100Linear => mul(&XYZ_TO_REC2020, xyz),
+        Space::Rec2100Pq => pq_encode(&mul(&XYZ_TO_REC2020, xyz)),
+        Space::Rec2100Hlg => hlg_encode(&mul(&XYZ_TO_REC2020, xyz)),
+        Space::XyzD65 => *xyz,
+        Space::XyzD50 => mul(&D65_TO_D50, xyz),
+        Space::Hsl => {
+            let r = from_xyz(Space::Srgb, xyz);
+            rgb_to_hsl(r[0], r[1], r[2])
+        }
+        Space::Hwb => {
+            let r = from_xyz(Space::Srgb, xyz);
+            rgb_to_hwb(r[0], r[1], r[2])
+        }
+        Space::Lab => xyz_to_lab(&mul(&D65_TO_D50, xyz)),
+        Space::Lch => to_polar(&xyz_to_lab(&mul(&D65_TO_D50, xyz)), 0.0015),
+        Space::Oklab => xyz_to_oklab(xyz),
+        Space::Oklch => to_polar(&xyz_to_oklab(xyz), 0.000004),
+        Space::Jzazbz => xyz_to_jzazbz(xyz),
+        Space::Jzczhz => to_polar(&xyz_to_jzazbz(xyz), 0.0000026),
+        Space::Ictcp => xyz_to_ictcp(xyz),
+    }
+}
+
+// CSS Color 4 section 13.3: analogous component categories; CSS Color HDR names no analogs for its spaces
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Analog {
+    None,
+    Reds,
+    Greens,
+    Blues,
+    Lightness,
+    Colorfulness,
+    Hue,
+    OpponentA,
+    OpponentB,
+}
+
+fn analogs(space: Space) -> [Analog; 3] {
+    use Analog::*;
+    if space.is_rgb_or_xyz() {
+        return [Reds, Greens, Blues];
+    }
+    match space {
+        Space::Hsl => [Hue, Colorfulness, Lightness],
+        Space::Hwb => [Hue, None, None],
+        Space::Lab | Space::Oklab => [Lightness, OpponentA, OpponentB],
+        Space::Lch | Space::Oklch => [Lightness, Colorfulness, Hue],
+        _ => [None, None, None],
+    }
+}
+
+// CSS Color 4 section 19, powerlessToMissing (and CSS Color HDR section 6.5 for jzczhz)
+fn powerless_to_missing(space: Space, c: &mut Vec3, missing: &mut [bool; 3]) {
+    match space {
+        Space::Hsl => {
+            let sat = if missing[1] { 0.0 } else { c[1] };
+            if sat <= 0.001 {
+                missing[0] = true;
+                if !missing[1] && c[1] > 0.0 {
+                    c[1] = 0.0;
+                }
+            }
+        }
+        Space::Hwb => {
+            let w = if missing[1] { 0.0 } else { c[1] };
+            let b = if missing[2] { 0.0 } else { c[2] };
+            if w + b >= 99.999 {
+                missing[0] = true;
+                if w + b < 100.0 {
+                    if missing[1] {
+                        c[2] = 100.0;
+                    } else if missing[2] {
+                        c[1] = 100.0;
+                    } else {
+                        c[2] = 100.0 - c[1];
+                    }
+                }
+            }
+        }
+        Space::Lch | Space::Oklch | Space::Jzczhz => {
+            let eps = match space {
+                Space::Lch => 0.0015,
+                Space::Oklch => 0.000004,
+                _ => 0.0000026,
+            };
+            let ch = if missing[1] { 0.0 } else { c[1] };
+            if ch <= eps {
+                missing[2] = true;
+                if !missing[1] && c[1] > 0.0 {
+                    c[1] = 0.0;
+                }
+            }
+        }
+        _ => (),
+    }
+}
+
+/// A `<color>` value in its own colour space; missing (`none`) components and alpha are flagged.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct CssColor {
+    pub space: Space,
+    pub c: [f64; 3],
+    pub alpha: f64,
+    /// bit i: component i is missing; bit 3: alpha is missing
+    pub missing: u8,
+}
+
+impl CssColor {
+    pub fn new(space: Space, c0: f64, c1: f64, c2: f64, alpha: f64) -> CssColor {
+        CssColor { space, c: [c0, c1, c2], alpha, missing: 0 }
+    }
+
+    pub fn is_missing(&self, i: usize) -> bool {
+        self.missing & (1 << i) != 0
+    }
+
+    pub fn alpha_missing(&self) -> bool {
+        self.missing & 8 != 0
+    }
+
+    fn set(&mut self, i: usize, v: f64) {
+        self.c[i] = v;
+        self.missing &= !(1 << i);
+    }
+
+    fn set_missing(&mut self, i: usize) {
+        self.c[i] = 0.0;
+        self.missing |= 1 << i;
+    }
+
+    fn set_alpha(&mut self, a: f64) {
+        self.alpha = a;
+        self.missing &= !8;
+    }
+
+    fn set_alpha_missing(&mut self) {
+        self.alpha = 0.0;
+        self.missing |= 8;
+    }
+
+    fn values(&self) -> Vec3 {
+        let mut v = self.c;
+        for (i, x) in v.iter_mut().enumerate() {
+            if self.is_missing(i) || x.is_nan() {
+                *x = 0.0;
+            }
+        }
+        v
+    }
+
+    pub fn to_xyz_d65(&self) -> Vec3 {
+        to_xyz(self.space, &self.values())
+    }
+
+    fn from_xyz_d65(space: Space, xyz: &Vec3, alpha: f64) -> CssColor {
+        let mut c = from_xyz(space, xyz);
+        let mut missing = [false; 3];
+        if space.is_polar() {
+            powerless_to_missing(space, &mut c, &mut missing);
+        }
+        let mut out = CssColor::new(space, 0.0, 0.0, 0.0, alpha);
+        for i in 0..3 {
+            if missing[i] || c[i].is_nan() {
+                out.set_missing(i);
+            } else {
+                out.set(i, c[i]);
+            }
+        }
+        out
+    }
+
+    /// CSS Color 4 section 11.2, with the missing components of section 13.3 carried forward.
+    pub fn converted_to(&self, space: Space) -> CssColor {
+        if space == self.space {
+            return *self;
+        }
+        let mut src = self.c;
+        let mut src_missing = [self.is_missing(0), self.is_missing(1), self.is_missing(2)];
+        powerless_to_missing(self.space, &mut src, &mut src_missing);
+        let mut z = src;
+        for i in 0..3 {
+            if src_missing[i] || z[i].is_nan() {
+                z[i] = 0.0;
+            }
+        }
+        let mut out = CssColor::from_xyz_d65(space, &to_xyz(self.space, &z), self.alpha);
+        if self.alpha_missing() {
+            out.set_alpha_missing();
+        }
+        let sa = analogs(self.space);
+        let da = analogs(space);
+        let shared = |a: Analog| a != Analog::None && da.contains(&a) && sa.contains(&a);
+        let mut have_set = false;
+        let mut all_missing = true;
+        let mut have_dst_set = false;
+        for i in 0..3 {
+            if !shared(sa[i]) {
+                have_set = true;
+                all_missing = all_missing && src_missing[i];
+            } else if src_missing[i] {
+                for j in 0..3 {
+                    if da[j] == sa[i] {
+                        out.set_missing(j);
+                    }
+                }
+            }
+            if !shared(da[i]) {
+                have_dst_set = true;
+            }
+        }
+        if have_set && have_dst_set && all_missing {
+            for j in 0..3 {
+                if !shared(da[j]) {
+                    out.set_missing(j);
+                }
+            }
+        }
+        out
+    }
+
+    /// The colour in `dest` for display: missing components are zero (CSS Color 4 section 4.4), none carried.
+    pub fn display_values(&self, dest: Space) -> Vec3 {
+        if self.space == dest {
+            return self.values();
+        }
+        from_xyz(dest, &self.to_xyz_d65())
+    }
+
+    fn srgb8(v: u32, alpha: f64) -> CssColor {
+        CssColor::new(
+            Space::Srgb,
+            f64::from((v >> 16) & 255) / 255.0,
+            f64::from((v >> 8) & 255) / 255.0,
+            f64::from(v & 255) / 255.0,
+            alpha,
+        )
+    }
+}
+
+// ---------------------------------------------------------------- gamut mapping, CSS Color 4 section 14.2.2
+
+fn in_unit(v: &Vec3) -> bool {
+    // eps absorbs the rounding of the matrix round trip, so that a colour on the gamut boundary (white) is in gamut
+    let eps = 1e-9;
+    v.iter().all(|&x| x >= -eps && x <= 1.0 + eps)
+}
+
+fn clip(v: &Vec3) -> Vec3 {
+    v.map(|x| x.clamp(0.0, 1.0))
+}
+
+fn delta_eok(a: &Vec3, b: &Vec3) -> f64 {
+    ((a[0] - b[0]).powi(2) + (a[1] - b[1]).powi(2) + (a[2] - b[2]).powi(2)).sqrt()
+}
+
+/// Gamut maps `color` into the RGB space `dest`; returns the values in [0, 1] and whether they were mapped.
+pub fn gamut_map(color: &CssColor, dest: Space) -> (Vec3, bool) {
+    let target = color.display_values(dest);
+    if in_unit(&target) {
+        return (clip(&target), false);
+    }
+    let o = color.converted_to(Space::Oklch);
+    let l = if o.is_missing(0) { 0.0 } else { o.c[0] };
+    let c = if o.is_missing(1) { 0.0 } else { o.c[1] };
+    let h = if o.is_missing(2) { 0.0 } else { o.c[2] };
+    if l >= 1.0 {
+        return (clip(&from_xyz(dest, &oklab_to_xyz(&[1.0, 0.0, 0.0]))), true);
+    }
+    if l <= 0.0 {
+        return (clip(&from_xyz(dest, &oklab_to_xyz(&[0.0, 0.0, 0.0]))), true);
+    }
+    let jnd = 0.02;
+    let epsilon = 0.0001;
+    let oklab_of_dest = |v: &Vec3| xyz_to_oklab(&to_xyz(dest, v));
+    let mut current = [l, c, h];
+    let mut cur_dest = from_xyz(dest, &oklab_to_xyz(&from_polar(&current)));
+    let mut clipped = clip(&cur_dest);
+    let mut e = delta_eok(&oklab_of_dest(&clipped), &from_polar(&current));
+    if e < jnd {
+        return (clipped, true);
+    }
+    let (mut lo, mut hi) = (0.0, c);
+    let mut min_in_gamut = true;
+    while hi - lo > epsilon {
+        let chroma = (lo + hi) / 2.0;
+        current = [l, chroma, h];
+        cur_dest = from_xyz(dest, &oklab_to_xyz(&from_polar(&current)));
+        if min_in_gamut && in_unit(&cur_dest) {
+            lo = chroma;
+            continue;
+        }
+        clipped = clip(&cur_dest);
+        e = delta_eok(&oklab_of_dest(&clipped), &from_polar(&current));
+        if e < jnd {
+            if jnd - e < epsilon {
+                return (clipped, true);
+            }
+            min_in_gamut = false;
+            lo = chroma;
+        } else {
+            hi = chroma;
+        }
+    }
+    (clipped, true)
+}
+
+// ---------------------------------------------------------------- parsing
+
+#[derive(Clone, PartialEq, Debug)]
+enum Tok {
+    Ws,
+    Ident(String),
+    Function(String),
+    Number(f64, bool),
+    Percentage(f64, bool),
+    Dimension(f64, String, bool),
+    Hash(String),
+    Comma,
+    Delim(char),
+    LParen,
+    RParen,
+}
+
+fn is_name_start(c: char) -> bool {
+    c.is_alphabetic() || c == '_' || !c.is_ascii()
+}
+
+fn is_name_char(c: char) -> bool {
+    is_name_start(c) || c.is_ascii_digit() || c == '-'
+}
+
+fn tokenize(s: &str) -> Vec<Tok> {
+    let ch: Vec<char> = s.chars().collect();
+    let n = ch.len();
+    let mut out = Vec::new();
+    let mut i = 0;
+    let starts_number = |k: usize| -> bool {
+        if k >= n {
+            return false;
+        }
+        let c = ch[k];
+        if c.is_ascii_digit() {
+            return true;
+        }
+        if c == '.' {
+            return k + 1 < n && ch[k + 1].is_ascii_digit();
+        }
+        if c == '+' || c == '-' {
+            return k + 1 < n
+                && (ch[k + 1].is_ascii_digit() || (ch[k + 1] == '.' && k + 2 < n && ch[k + 2].is_ascii_digit()));
+        }
+        false
+    };
+    let starts_ident = |k: usize| -> bool {
+        if k >= n {
+            return false;
+        }
+        if is_name_start(ch[k]) {
+            return true;
+        }
+        ch[k] == '-' && k + 1 < n && (is_name_start(ch[k + 1]) || ch[k + 1] == '-')
+    };
+    while i < n {
+        let c = ch[i];
+        if c.is_whitespace() {
+            while i < n && ch[i].is_whitespace() {
+                i += 1;
+            }
+            out.push(Tok::Ws);
+            continue;
+        }
+        if c == '/' && i + 1 < n && ch[i + 1] == '*' {
+            let mut k = i + 2;
+            while k + 1 < n && !(ch[k] == '*' && ch[k + 1] == '/') {
+                k += 1;
+            }
+            i = if k + 1 < n { k + 2 } else { n };
+            continue;
+        }
+        if starts_number(i) {
+            let start = i;
+            let signed = ch[i] == '+' || ch[i] == '-';
+            if signed {
+                i += 1;
+            }
+            while i < n && ch[i].is_ascii_digit() {
+                i += 1;
+            }
+            if i + 1 < n && ch[i] == '.' && ch[i + 1].is_ascii_digit() {
+                i += 1;
+                while i < n && ch[i].is_ascii_digit() {
+                    i += 1;
+                }
+            }
+            if i + 1 < n && (ch[i] == 'e' || ch[i] == 'E') {
+                let mut k = i + 1;
+                if k < n && (ch[k] == '+' || ch[k] == '-') {
+                    k += 1;
+                }
+                if k < n && ch[k].is_ascii_digit() {
+                    i = k;
+                    while i < n && ch[i].is_ascii_digit() {
+                        i += 1;
+                    }
+                }
+            }
+            let text: String = ch[start..i].iter().collect();
+            let v: f64 = text.parse().unwrap_or(0.0);
+            if i < n && ch[i] == '%' {
+                out.push(Tok::Percentage(v, signed));
+                i += 1;
+            } else if starts_ident(i) {
+                let us = i;
+                while i < n && is_name_char(ch[i]) {
+                    i += 1;
+                }
+                out.push(Tok::Dimension(v, ch[us..i].iter().collect::<String>().to_ascii_lowercase(), signed));
+            } else {
+                out.push(Tok::Number(v, signed));
+            }
+            continue;
+        }
+        if c == '#' {
+            let mut k = i + 1;
+            while k < n && is_name_char(ch[k]) {
+                k += 1;
+            }
+            if k > i + 1 {
+                out.push(Tok::Hash(ch[i + 1..k].iter().collect()));
+                i = k;
+                continue;
+            }
+        }
+        if starts_ident(i) {
+            let start = i;
+            while i < n && is_name_char(ch[i]) {
+                i += 1;
+            }
+            let name = ch[start..i].iter().collect::<String>().to_ascii_lowercase();
+            if i < n && ch[i] == '(' {
+                out.push(Tok::Function(name));
+                i += 1;
+            } else {
+                out.push(Tok::Ident(name));
+            }
+            continue;
+        }
+        out.push(match c {
+            '(' => Tok::LParen,
+            ')' => Tok::RParen,
+            ',' => Tok::Comma,
+            _ => Tok::Delim(c),
+        });
+        i += 1;
+    }
+    out
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Unit {
+    Number,
+    Percentage,
+    Angle,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Num {
+    v: f64,
+    t: Unit,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Comp {
+    v: f64,
+    t: Unit,
+    none: bool,
+}
