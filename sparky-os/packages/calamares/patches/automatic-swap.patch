+def create_managed_swapfile(path, size, btrfs):
+    if btrfs:
+        subprocess.run(["btrfs", "filesystem", "mkswapfile", "--size", str(size), path], check=True)
+        os.chmod(path, 0o600)
+        return
+    with open(path, "xb", opener=lambda name, flags: os.open(name, flags, 0o600)) as swap:
+        os.posix_fallocate(swap.fileno(), 0, size)
+        os.fsync(swap.fileno())
+    subprocess.run(["mkswap", path], check=True)
+
+
+def resume_offset(path, btrfs):
+    if btrfs:
+        offset = subprocess.check_output(["btrfs", "inspect-internal", "map-swapfile", "-r", path],
+                                         text=True).strip()
+    else:
+        page_size = os.sysconf("SC_PAGE_SIZE")
+        extents = subprocess.check_output(["filefrag", "-v", "-b" + str(page_size), path], text=True,
+                                          env=dict(os.environ, LC_ALL="C"))
+        first = re.search(r"^\s*0:\s+0\.\.\s*\d+:\s+(\d+)\.\.", extents, re.MULTILINE)
+        offset = first[1] if first else ""
+    if not offset.isdecimal() or int(offset) == 0:
+        raise ValueError("Could not read the resume offset of " + path)
+    return offset
+
+
+def configure_edition_swap(partitions, target, choices, plan):
+    """Return the fstab entries after allocating the selected swap area."""
+    partitions = list(partitions)
+    root = next(p for p in partitions if p["mountPoint"] == "/")
+    btrfs = root["fs"].lower() == "btrfs"
+    swap = next((p for p in partitions if p["fs"] == "linuxswap" and p.get("claimed")), None)
+    automatic = choices.get("swap") == "automatic"
+    file_size = plan.get("fileBytes", 0) if automatic else 0
+    if choices.get("swap") == "file":
+        file_size = 512 * 1024 ** 2
+    hibernate = plan.get("hibernate", False) if automatic else choices.get("swap") == "suspend"
+    if automatic and plan.get("partitionBytes") and not swap:
+        raise ValueError("The planned swap partition was not created")
+    path = "/swap/swapfile" if btrfs else "/swapfile"
+    if file_size:
+        available = os.statvfs(target)
+        reserve = 20 * 1024 ** 3 if hibernate else 0
+        if available.f_bavail * available.f_frsize < file_size + reserve:
+            raise ValueError("The planned swap file does not fit in the space remaining after installation")
+        create_managed_swapfile(target + path, file_size, btrfs)
+        partitions.append(dict(fs="swap", mountPoint=None, claimed=True, device=path, uuid=None))
+
+    resume = "RESUME=none\n"
+    omit_from_fstab = None
+    if swap and hibernate:
+        if swap.get("luksMapperName"):
+            resume = "RESUME=/dev/mapper/" + swap["luksMapperName"] + "\n"
+        elif swap.get("uuid"):
+            resume = "RESUME=UUID=" + swap["uuid"] + "\n"
+        else:
+            raise ValueError("The hibernation partition has no swap UUID")
+        if file_size:
+            omit_from_fstab = swap  # the file entry prevents GPT auto-activation of this partition
+    elif file_size and hibernate:
+        if not root.get("uuid"):
+            raise ValueError("The hibernation file's filesystem has no UUID")
+        resume = "RESUME=UUID=" + root["uuid"] + "\nRESUME_OFFSET=" + resume_offset(target + path, btrfs) + "\n"
+
+    directory = os.path.join(target, "etc/initramfs-tools/conf.d")
+    os.makedirs(directory, exist_ok=True)
+    with open(os.path.join(directory, "resume"), "w", encoding="ascii") as config:
+        config.write(resume)
+    return partitions, omit_from_fstab
+
