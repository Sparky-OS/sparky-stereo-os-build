+QString
+ChoicePage::automaticSwapDescription() const
+{
+    const auto* device = m_core ? selectedDevice() : nullptr;
+    if ( !device )
+    {
+        return tr( "Automatic swap", "@label" );
+    }
+    const auto plan = PartitionActions::automaticSwapPlan( *device, autoPartitionOptions() );
+    const auto fileSize = Calamares::BytesToMiB( plan.fileBytes );
+    const auto partSize = Calamares::BytesToMiB( plan.partitionBytes );
+    if ( plan.fileBytes && plan.partitionBytes )
+    {
+        return tr( "%1 MiB hibernation partition and %2 MiB Cushion Swap file", "@label" )
+            .arg( partSize ).arg( fileSize );
+    }
+    if ( plan.hibernate )
+    {
+        return plan.fileBytes
+            ? tr( "%1 MiB file shared by hibernation and Cushion Swap", "@label" ).arg( fileSize )
+            : tr( "%1 MiB partition shared by hibernation and Cushion Swap", "@label" ).arg( partSize );
+    }
+    return plan.fileBytes
+        ? tr( "%1 MiB swap file. Hibernation needs more disk space.", "@label" ).arg( fileSize )
+        : tr( "%1 MiB swap partition. Hibernation needs more disk space.", "@label" ).arg( partSize );
+}
