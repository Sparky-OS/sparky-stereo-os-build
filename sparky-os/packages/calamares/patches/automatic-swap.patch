 namespace PartitionActions
 {

+AutomaticSwapPlan
+automaticSwapPlan( const Device& device, const Choices::AutoPartitionOptions& options )
+{
+    const quint64 ram = Calamares::System::instance()->getTotalMemoryB().first;
+    // Round up and leave room for the swap header itself.
+    const quint64 area = ( ram / 1_MiB + 1 ) * 1_MiB;
+    const quint64 disk = device.capacity();
+    const auto* gs = Calamares::JobQueue::instance()->globalStorage();
+    const bool needsEsp = PartUtils::isEfiSystem() || gs->value( "createHybridBootloaderLayout" ).toBool();
+    const quint64 boot = 16_MiB + ( needsEsp ? PartUtils::efiFilesystemRecommendedSize() : 0 );
+    const bool ext = options.defaultFsType.startsWith( "ext" );
+    const bool supportsFile = ext || options.defaultFsType == "btrfs" || options.defaultFsType == "xfs";
+    // ext filesystems reserve space for root; keep the 20 GiB usable by the person.
+    const quint64 base = options.requiredSpaceB + boot + ( ext ? disk / 20 : 0 );
+    if ( ram && disk > base + 20_GiB )
+    {
+        const auto available = disk - base - 20_GiB;
+        if ( supportsFile && disk > 256'000'000'000ULL && available >= 2 * area )
+        {
+            return { area, area, true };
+        }
+        if ( available >= area && ( disk <= 256'000'000'000ULL || !supportsFile ) )
+        {
+            return supportsFile ? AutomaticSwapPlan { 0, area, true }
+                                : AutomaticSwapPlan { area, 0, true };
+        }
+    }
+    return supportsFile ? AutomaticSwapPlan { 0, 512_MiB, false }
+                        : AutomaticSwapPlan { 512_MiB, 0, false };
+}
