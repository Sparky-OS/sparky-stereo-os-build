prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Name: media-gpu-route
Description: Shared default display GPU preference for media engines
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmedia-gpu-route
Cflags: -I${includedir}
