+QDir pairingDirectory()
+{
+    return QDir(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/kdeconnect"));
+}
+
+QList<QSslCertificate> pairedCertificates()
+{
+    const auto *bus = QDBusConnection::sessionBus().interface();
+    if (!bus || bus->serviceOwner(QStringLiteral("org.kde.kdeconnect")).value().isEmpty())
+        return {};
+    QSettings store(pairingDirectory().filePath(QStringLiteral("trusted_devices")), QSettings::IniFormat);
+    store.sync();
+    QList<QSslCertificate> certificates;
+    for (const auto &device : store.childGroups()) {
+        const QSslCertificate certificate(store.value(device + QStringLiteral("/certificate")).toByteArray());
+        if (!certificate.isNull())
+            certificates.append(certificate);
+    }
+    return certificates;
+}
+
+bool isPaired(const QSslCertificate &certificate)
+{
+    return !certificate.isNull() && pairedCertificates().contains(certificate);
+}
+
+QString pairingRequired()
+{
+    return i18n("Pair this headset with this computer in KDE Connect before connecting.");
+}
+
+QSize wirePixels(const QString &layout, const QSize &native)
+{
+    if (layout == QLatin1StringView("native"))
+        return native;
+    if (layout == QLatin1StringView("sbs-720"))
+        return {2560, 720};
+    if (layout == QLatin1StringView("tb-720"))
+        return {1280, 1440};
+    if (layout == QLatin1StringView("sbs-half-720") || layout == QLatin1StringView("tb-half-720"))
+        return {1280, 720};
+    return {};
+}
+}
