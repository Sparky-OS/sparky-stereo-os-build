+namespace {
+
+QString stereoLayoutString(AVStereo3DType type, uint32_t flags, AVStereo3DView view)
+{
+    QString layout;
+    switch (type) {
+    case AV_STEREO3D_SIDEBYSIDE:
+        layout = QStringLiteral("sideBySide");
+        break;
+    case AV_STEREO3D_SIDEBYSIDE_QUINCUNX:
+        layout = QStringLiteral("sideBySideQuincunx");
+        break;
+    case AV_STEREO3D_TOPBOTTOM:
+        layout = QStringLiteral("topBottom");
+        break;
+    case AV_STEREO3D_CHECKERBOARD:
+        layout = QStringLiteral("checkerboard");
+        break;
+    case AV_STEREO3D_LINES:
+        layout = QStringLiteral("rowInterleaved");
+        break;
+    case AV_STEREO3D_COLUMNS:
+        layout = QStringLiteral("columnInterleaved");
+        break;
+    case AV_STEREO3D_FRAMESEQUENCE:
+        layout = QStringLiteral("frameSequential");
+        break;
+    default:
+        return {};
+    }
+
+    const bool rightFirst = flags & AV_STEREO3D_FLAG_INVERT;
+    const bool invertOtherwise = !rightFirst && (view == AV_STEREO3D_VIEW_RIGHT);
+    layout += (rightFirst || invertOtherwise) ? QStringLiteral("RightFirst")
+        : QStringLiteral("LeftFirst");
+   return layout;
+}
+
+QString stereoLayoutString(const AVStereo3D* stereo)
+{
+    if (stereo->type == AV_STEREO3D_2D) {
+        return QStringLiteral("mono");
+    }
+
+    return stereoLayoutString(stereo->type, stereo->flags, stereo->view);
+}
+
+QString binaryStereoLayoutString(const uint8_t* data, qsizetype size)
+{
+    if (size < qsizetype(sizeof(uint32_t) * 2 + sizeof(uint64_t))) {
+        return {};
+    }
+
+    const uint32_t type = uint32_t(data[0]) | (uint32_t(data[1]) << 8)
+        | (uint32_t(data[2]) << 16) | (uint32_t(data[3]) << 24);
+    const uint32_t flags = uint32_t(data[4]) | (uint32_t(data[5]) << 8)
+        | (uint32_t(data[6]) << 16) | (uint32_t(data[7]) << 24);
+
+    if (type == uint32_t(AV_STEREO3D_2D)) {
+        return QStringLiteral("mono");
+    }
+
+    return stereoLayoutString(AVStereo3DType(type), flags, AV_STEREO3D_VIEW_PACKED);
+}
+
+void extractStereoLayout(ExtractionResult* result, const AVCodecParameters* codec)
+{
+    if (const auto* sideData = av_packet_side_data_get(codec->coded_side_data,
+                                                       codec->nb_coded_side_data,
+                                                       AV_PKT_DATA_STEREO3D)) {
+        const QString layout = binaryStereoLayoutString(sideData->data, sideData->size);
+        if (!layout.isEmpty()) {
+            result->add(Property::Stereo3dLayout, layout);
+        }
+    }
+}
+
