+void ffmpegExtractorTest::testStereoLayout_data()
+{
+    QTest::addColumn<QString>("fileBase");
+    QTest::addColumn<QString>("expectedLayout");
+
+    const std::initializer_list<std::pair<QString, QString>> cases = {
+        {QStringLiteral("test_stereo0"), QStringLiteral("mono")},
+        {QStringLiteral("test_stereo1"), QStringLiteral("sideBySideLeftFirst")},
+        {QStringLiteral("test_stereo2"), QStringLiteral("topBottomRightFirst")},
+        {QStringLiteral("test_stereo3"), QStringLiteral("topBottomLeftFirst")},
+        {QStringLiteral("test_stereo4"), QStringLiteral("checkerboardRightFirst")},
+        {QStringLiteral("test_stereo5"), QStringLiteral("checkerboardLeftFirst")},
+        {QStringLiteral("test_stereo6"), QStringLiteral("rowInterleavedRightFirst")},
+        {QStringLiteral("test_stereo7"), QStringLiteral("rowInterleavedLeftFirst")},
+        {QStringLiteral("test_stereo8"), QStringLiteral("columnInterleavedRightFirst")},
+        {QStringLiteral("test_stereo9"), QStringLiteral("columnInterleavedLeftFirst")},
+        {QStringLiteral("test_stereo11"), QStringLiteral("sideBySideRightFirst")},
+        {QStringLiteral("test_stereo13"), QStringLiteral("frameSequentialLeftFirst")},
+        {QStringLiteral("test_stereo14"), QStringLiteral("frameSequentialRightFirst")},
+    };
+
+    for (const auto& [fileBase, expectedLayout] : cases) {
+        QTest::addRow(fileBase.toLatin1().constData()) << fileBase << expectedLayout;
+    }
+}
