+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+# SPDX-License-Identifier: CC0-1.0
+"""Generate tiny clips; change SEI eye order independently of the encoders."""
+import os
+import pathlib
+import re
+import subprocess
+
+root = pathlib.Path(__file__).parent.resolve() / 'stereo'
+root.mkdir(exist_ok=True)
+scratch = pathlib.Path(os.environ['STEREO_VIDEO_SCRATCH'])
+scratch.mkdir(parents=True, exist_ok=True)
+x265 = os.environ['STEREO_X265']
+
+
+def run(*args):
+    subprocess.run(args, check=True)
+
+
+def escape(data):
+    out = bytearray()
+    zeros = 0
+    for byte in data:
+        if zeros >= 2 and byte <= 3:
+            out.append(3)
+            zeros = 0
+        out.append(byte)
+        zeros = zeros + 1 if byte == 0 else 0
+    return bytes(out)
+
+
+def reverse_order(data, hevc):
+    parts = re.split(b'\x00\x00\x00?\x01', data)
+    found = 0
+    for i, nal in enumerate(parts):
+        header = 2 if hevc else 1
+        typ = (nal[0] >> 1) & 63 if hevc and nal else nal[0] & 31 if nal else -1
+        if typ != (39 if hevc else 6):
+            continue
+        rbsp = re.sub(b'\x00\x00\x03', b'\x00\x00', nal[header:])
+        if rbsp[:1] != b'\x2d':
+            continue
+        payload = bytearray(rbsp)
+        # ue(0), cancel, type and quincunx occupy ten bits; interpretation occupies six.
+        assert payload[3] & 63 == 1
+        payload[3] = (payload[3] & 192) | 2
+        parts[i] = nal[:header] + escape(payload)
+        found += 1
+    assert found >= 2, found
+    return b''.join(b'\x00\x00\x00\x01' + part for part in parts if part)
+
+
+def quincunx(data, hevc, right):
+    parts = re.split(b'\x00\x00\x00?\x01', data)
+    found = 0
+    for i, nal in enumerate(parts):
+        header = 2 if hevc else 1
+        if not nal or ((nal[0] >> 1) & 63 if hevc else nal[0] & 31) != (39 if hevc else 6):
+            continue
+        rbsp = re.sub(b'\x00\x00\x03', b'\x00\x00', nal[header:])
+        if rbsp[:1] != b'\x2d':
+            continue
+        # Table D-8 type 3, quincunx=1: grid-position fields are absent.
+        bits = '10' + '0000011' + '1' + format(2 if right else 1, '06b')
+        bits += '000100' + '00000000' + '10'
+        assert len(bits) == 32
+        payload = int(bits, 2).to_bytes(4, 'big')
+        parts[i] = nal[:header] + escape(bytes([45, 4]) + payload + b'\x80')
+        found += 1
+    assert found == 2
+    return b''.join(b'\x00\x00\x00\x01' + part for part in parts if part)
+
+
+raw = scratch / 'pair.yuv'
+# Constant red left and blue right YUV420 samples, no photographs.
+row = bytes([81] * 8 + [41] * 8)
+frame = row * 16 + bytes([90] * 4 + [240] * 4) * 8 + bytes([240] * 4 + [110] * 4) * 8
+raw.write_bytes(frame * 4)
+for hevc in (False, True):
+    codec = 'hevc' if hevc else 'h264'
+    for typ in ((3, 4, 5) if hevc else range(6)):
+        encoded = scratch / f'{codec}-{typ}.bin'
+        if hevc:
+            run(x265, '--ctu', '16', '--input', str(raw), '--input-res', '16x16', '--fps', '2', '--frames', '4',
+                '--pools', '1', '--frame-threads', '1', '--keyint', '2', '--min-keyint', '2',
+                '--no-scenecut', '--bframes', '0', '--repeat-headers', '--frame-packing', str(typ),
+                '--preset', 'ultrafast', '--output', str(encoded))
+        else:
+            run('ffmpeg', '-v', 'error', '-y', '-f', 'rawvideo', '-pixel_format', 'yuv420p',
+                '-video_size', '16x16', '-framerate', '2', '-i', str(raw), '-c:v', 'libx264',
+                '-threads', '1', '-x264-params', f'frame-packing={typ}:keyint=2:min-keyint=2:scenecut=0:bframes=0',
+                '-f', 'h264', str(encoded))
+            if typ == 3:
+                parts = re.split(b'\x00\x00\x00?\x01', encoded.read_bytes())
+                removed_slice = removed_sei = False
+                for i, nal in enumerate(parts):
+                    if not nal:
+                        continue
+                    if nal[0] & 31 == 5 and not removed_slice:
+                        parts[i] = b''
+                        removed_slice = True
+                    elif nal[0] & 31 == 6 and nal[1:2] == bytes([45]) and not removed_sei:
+                        parts[i] = b''
+                        removed_sei = True
+                assert removed_slice and removed_sei
+                delayed = scratch / 'delayed.h264'
+                delayed.write_bytes(b''.join(b'\x00\x00\x00\x01' + part for part in parts if part))
+                run('ffmpeg', '-v', 'error', '-y', '-r', '2', '-i', str(delayed), '-c', 'copy',
+                    str(root / 'test_sei_delayed_key.mp4'))
+        for right in (False, True):
+            stream = scratch / f'{codec}-{typ}-{int(right)}.bin'
+            stream.write_bytes(reverse_order(encoded.read_bytes(), hevc) if right else encoded.read_bytes())
+            run('ffmpeg', '-v', 'error', '-y', '-f', codec, '-r', '2', '-i', str(stream), '-c', 'copy',
+                str(root / f'test_sei_{codec}_{typ}_{int(right)}.mp4'))
+            if typ == 3:
+                stream.write_bytes(quincunx(encoded.read_bytes(), hevc, right))
+                run('ffmpeg', '-v', 'error', '-y', '-f', codec, '-r', '2', '-i', str(stream), '-c', 'copy',
+                    str(root / f'test_sei_{codec}_quincunx_{int(right)}.mp4'))
+run('ffmpeg', '-v', 'error', '-y', '-f', 'rawvideo', '-pixel_format', 'yuv420p', '-video_size', '16x16',
+    '-framerate', '2', '-i', str(raw), '-c:v', 'libx264', '-threads', '1', str(root / 'test_sei_plain.mp4'))
