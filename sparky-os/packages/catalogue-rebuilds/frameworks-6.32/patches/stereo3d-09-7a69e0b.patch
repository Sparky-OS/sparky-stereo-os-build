+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+# SPDX-License-Identifier: CC0-1.0
+"""Generate MV-HEVC, using H.265 G.14.2.3 to declare either eye order."""
+import os
+import pathlib
+import re
+import subprocess
+
+root = pathlib.Path(__file__).parent / 'stereo'
+scratch = pathlib.Path(os.environ['STEREO_VIDEO_SCRATCH']).resolve()
+scratch.mkdir(parents=True, exist_ok=True)
+
+
+def run(*args):
+    subprocess.run(args, check=True)
+
+
+def ue(value):
+    bits = bin(value + 1)[2:]
+    return '0' * (len(bits) - 1) + bits
+
+
+def reference(left, right):
+    bits = ue(31) + '0' + ue(0) + ue(left) + ue(right) + '000000' + '0' + '0' + '0'
+    bits += '1' + '0' * ((-len(bits) - 1) % 8)
+    return int(bits, 2).to_bytes(len(bits) // 8, 'big')
+
+
+def escape(data):
+    out = bytearray()
+    zeros = 0
+    for byte in data:
+        if zeros >= 2 and byte <= 3:
+            out.append(3)
+            zeros = 0
+        out.append(byte)
+        zeros = zeros + 1 if byte == 0 else 0
+    return bytes(out)
+
+
+for name, y, u, v in [('left', 81, 90, 240), ('right', 41, 240, 110)]:
+    (scratch / (name + '.yuv')).write_bytes((bytes([y]) * 256 + bytes([u]) * 64 + bytes([v]) * 64) * 2)
+config = scratch / 'multiview.cfg'
+config.write_text(f'--num-views 2\n--format 0\n--input "{scratch}/left.yuv"\n--input "{scratch}/right.yuv"\n')
+encoded = scratch / 'multiview.hevc'
+run(os.environ['STEREO_X265_MV'], '--ctu', '16', '--multiview-config', str(config), '--input-res',
+    '16x16', '--fps', '2', '--frames', '2', '--pools', '1', '--frame-threads', '1',
+    '--keyint', '1', '--bframes', '0', '--repeat-headers', '--preset', 'ultrafast', '--output', str(encoded))
+for order in ('left', 'right', 'unknown'):
+    parts = re.split(b'\x00\x00\x00?\x01', encoded.read_bytes())
+    found = 0
+    for i, nal in enumerate(parts):
+        if not nal or (nal[0] >> 1) & 63 != 39:
+            continue
+        data = re.sub(b'\x00\x00\x03', b'\x00\x00', nal[2:])
+        # x265 emits this message as its own prefix SEI NAL unit.
+        if data[:1] != bytes([176]):
+            continue
+        found += 1
+        if order == 'unknown':
+            parts[i] = b''
+        else:
+            payload = reference(0, 1) if order == 'left' else reference(1, 0)
+            parts[i] = nal[:2] + escape(bytes([176, len(payload)]) + payload + b'\x80')
+    assert found == 4, found  # Two access units, each with a prefix SEI for both layers.
+    stream = scratch / f'multiview-{order}.hevc'
+    stream.write_bytes(b''.join(b'\x00\x00\x00\x01' + part for part in parts if part))
+    run('ffmpeg', '-v', 'error', '-y', '-r', '2', '-i', str(stream), '-c', 'copy',
+        str(root / f'test_mv_{order}.mp4'))
