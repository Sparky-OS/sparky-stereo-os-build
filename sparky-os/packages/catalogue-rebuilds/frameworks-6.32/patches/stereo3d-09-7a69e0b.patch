-void extractStereoLayout(ExtractionResult *result, const AVStream *stream)
+QString decodedStereoLayout(AVFormatContext *format, const AVStream *stream)
+{
+    const auto *parameters = stream->codecpar;
+    if (parameters->codec_id != AV_CODEC_ID_H264 && parameters->codec_id != AV_CODEC_ID_HEVC) {
+        return {};
+    }
+    const AVCodec *decoder = avcodec_find_decoder(parameters->codec_id);
+    if (!decoder) {
+        return {};
+    }
+    AVCodecContext *context = avcodec_alloc_context3(decoder);
+    if (!context) {
+        return {};
+    }
+    const auto contextGuard = qScopeGuard([&context]() { avcodec_free_context(&context); });
+    if (avcodec_parameters_to_context(context, parameters) < 0) {
+        return {};
+    }
+    context->thread_count = 1;
+    if (avcodec_open2(context, decoder, nullptr) < 0) {
+        return {};
+    }
+    AVFrame *frame = av_frame_alloc();
+    AVPacket *packet = av_packet_alloc();
+    const auto frameGuard = qScopeGuard([&frame]() { av_frame_free(&frame); });
+    const auto packetGuard = qScopeGuard([&packet]() { av_packet_free(&packet); });
+    if (!frame || !packet) {
+        return {};
+    }
+
+    // Bound metadata probing even when an input has no decodable keyframe.
+    qint64 bytes = 0;
+    for (int packets = 0; packets < 512 && bytes < 32 * 1024 * 1024; ++packets) {
+        const bool end = av_read_frame(format, packet) < 0;
+        if (!end && packet->stream_index != stream->index) {
+            av_packet_unref(packet);
+            continue;
+        }
+        bytes += packet->size;
+        const int sent = avcodec_send_packet(context, end ? nullptr : packet);
+        av_packet_unref(packet);
+        if (sent < 0 && sent != AVERROR(EAGAIN)) {
+            break;
+        }
+        while (avcodec_receive_frame(context, frame) == 0) {
+            if (const auto *data = av_frame_get_side_data(frame, AV_FRAME_DATA_STEREO3D)) {
+                if (data->size >= offsetof(AVStereo3D, flags) + sizeof(AVStereo3D::flags)) {
+                    const auto *stereo = reinterpret_cast<const AVStereo3D *>(data->data);
+#if LIBAVUTIL_VERSION_INT >= AV_VERSION_INT(59, 39, 100)
+                    if (parameters->codec_id == AV_CODEC_ID_HEVC && av_frame_get_side_data(frame, AV_FRAME_DATA_VIEW_ID)
+                        && data->size >= offsetof(AVStereo3D, view) + sizeof(AVStereo3D::view)) {
+                        if (stereo->view == AV_STEREO3D_VIEW_LEFT) {
+                            return QStringLiteral("multiViewLeftFirst");
+                        }
+                        if (stereo->view == AV_STEREO3D_VIEW_RIGHT) {
+                            return QStringLiteral("multiViewRightFirst");
+                        }
+                        return {};
+                    }
+#endif
+                    const QString layout = stereoLayoutString(stereo);
+                    if (!layout.isEmpty()) {
+                        return layout;
+                    }
+                }
+            }
+#if LIBAVUTIL_VERSION_MAJOR >= 58
+            const bool key = frame->flags & AV_FRAME_FLAG_KEY;
+#else
+            const bool key = frame->key_frame;
+#endif
+            av_frame_unref(frame);
+            if (key) {
+                return {};
+            }
+        }
+        if (end) {
+            break;
+        }
+    }
+    return {};
+}
