+void ffmpegExtractorTest::testSeiLayout()
+{
+    QFETCH(QString, baseName);
+    QFETCH(QString, layout);
+    const QString fileName = testFilePath(QStringLiteral("stereo/") + baseName, QStringLiteral("mp4"));
+    QVERIFY(QFile::exists(fileName));
+    const bool multiview = baseName.startsWith(QStringLiteral("test_mv_"));
+    const char *decoder = baseName.contains(QStringLiteral("hevc")) || multiview ? "hevc" : "h264";
+    if ((!layout.isEmpty() || multiview) && !avcodec_find_decoder_by_name(decoder)) {
+        QSKIP("Native codec with stereo frame side data is unavailable");
+    }
+#if LIBAVCODEC_VERSION_MAJOR < 61
+    if (multiview) {
+        QSKIP("This FFmpeg version cannot decode MV-HEVC");
+    }
+#endif
+    FFmpegExtractor plugin{this};
+    SimpleExtractionResult result(fileName, QStringLiteral("video/mp4"));
+    plugin.extract(&result);
+    QVERIFY(result.types().contains(Type::Video));
+    if (layout.isEmpty()) {
+        QVERIFY(!result.properties().contains(Property::Stereo3dLayout));
+    } else {
+        QCOMPARE(result.properties().value(Property::Stereo3dLayout).toString(), layout);
+    }
