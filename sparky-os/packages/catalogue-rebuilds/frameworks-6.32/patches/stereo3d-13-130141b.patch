+void ffmpegExtractorTest::testStereoStream_data()
+{
+    QTest::addColumn<QString>("baseName");
+    QTest::addColumn<QString>("layout");
+    QTest::addRow("first codec stream despite second default") << QStringLiteral("test_streams_first") << QStringLiteral("sideBySideLeftFirst");
+    QTest::addRow("unmarked first codec stream") << QStringLiteral("test_streams_plain") << QString();
+    QTest::addRow("attached picture") << QStringLiteral("test_streams_cover") << QStringLiteral("sideBySideLeftFirst");
+    QTest::addRow("codec stream after VP9") << QStringLiteral("test_streams_after_vp9") << QStringLiteral("topBottomRightFirst");
+}
+
+void ffmpegExtractorTest::testStereoStream()
+{
+    QFETCH(QString, baseName);
+    QFETCH(QString, layout);
+    if (!avcodec_find_decoder_by_name("h264")) {
+        QSKIP("Native H.264 decoder is unavailable");
+    }
+    const QString fileName = testFilePath(QStringLiteral("stereo/") + baseName,
+                                          baseName.endsWith(QStringLiteral("cover")) ? QStringLiteral("mp4") : QStringLiteral("mkv"));
+    QVERIFY(QFile::exists(fileName));
+    FFmpegExtractor plugin{this};
+    SimpleExtractionResult result(fileName, QStringLiteral("video/x-matroska"));
+    plugin.extract(&result);
+    const auto values = result.properties().values(Property::Stereo3dLayout);
+    if (layout.isEmpty()) {
+        QVERIFY(values.isEmpty());
+    } else {
+        QCOMPARE(values.size(), 1);
+        QCOMPARE(values.constFirst().toString(), layout);
+    }
 }
 
