+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+# SPDX-License-Identifier: CC0-1.0
+"""Combine generated clips to check selection of one stereo video stream."""
+import pathlib
+import subprocess
+
+root = pathlib.Path(__file__).parent / 'stereo'
+for name, first, second, default in (
+    ('first', 'test_sei_h264_3_0.mp4', 'test_sei_h264_4_1.mp4', 1),
+    ('plain', 'test_sei_plain.mp4', 'test_sei_h264_4_1.mp4', 1),
+    ('after_vp9', 'test_stereo2.mkv', 'test_sei_h264_4_1.mp4', 0),
+):
+    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', str(root / first),
+                    '-i', str(root / second), '-map', '0:v:0', '-map', '1:v:0',
+                    '-c', 'copy', '-disposition:v:0', 'default' if default == 0 else '0',
+                    '-disposition:v:1', 'default' if default == 1 else '0',
+                    str(root / f'test_streams_{name}.mkv')], check=True)
+
+subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', str(root / 'test_jps_unmarked.jpg'),
+                '-i', str(root / 'test_sei_h264_3_0.mp4'), '-map', '0:v:0', '-map', '1:v:0',
+                '-c', 'copy', '-disposition:v:0', 'attached_pic',
+                str(root / 'test_streams_cover.mp4')], check=True)
