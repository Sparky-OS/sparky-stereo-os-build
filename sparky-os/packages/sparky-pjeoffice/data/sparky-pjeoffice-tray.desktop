[Desktop Entry]
Type=Application
Version=1.0
Name=PJeOffice Pro tray entry
Name[de]=PJeOffice-Pro-Symbol im Systemabschnitt
Name[es]=Entrada de bandeja de PJeOffice Pro
Name[fr]=Icône de PJeOffice Pro dans la zone de notification
Name[ja]=PJeOffice Pro のトレイ項目
Name[ko]=PJeOffice Pro 트레이 항목
Name[pl]=Ikona PJeOffice Pro w zasobniku
Name[pt_BR]=Item de bandeja do PJeOffice Pro
Name[zh_CN]=PJeOffice Pro 托盘项
Name[zh_TW]=PJeOffice Pro 系統匣項目
Exec=/usr/bin/sparky-pjeoffice-tray
Icon=application-certificate
Terminal=false
OnlyShowIn=KDE;
X-KDE-autostart-condition=sparkystereopjeofficerc:General:Autostart:true
X-KDE-autostart-phase=2
X-KDE-StartupNotify=false
