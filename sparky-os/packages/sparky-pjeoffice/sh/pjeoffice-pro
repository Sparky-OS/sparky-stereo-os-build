# Starts CNJ's PJeOffice Pro from the version sparky-pjeoffice installed, and waits until it answers on localhost. CNJ's own
# pjeoffice-pro.sh is not used: it deletes the program's logs at every start and runs from its own folder. Every path here is the
# resolved folder of one version, so a switch to another version never changes the files a running signer reads.
# Two starts at once (the menu entry and the tray at login) would make the second instance shut the first down ("Tentativa de shutdown
# da porta 8800", measured), so the check and the start are made under one lock and the second start finds the signer answering.
LINK=/opt/pjeoffice-pro/current
APP=$(readlink -f "$LINK" 2>/dev/null)
if [ -z "$APP" ] || [ ! -x "$APP/jre/bin/java" ]; then
	/usr/bin/sparky-pjeoffice status >&2
	exit 1
fi
VERSION=$(basename "$APP")
TRUST=/var/lib/sparky-pjeoffice/trust/$VERSION
if [ ! -f "$TRUST/pjeoffice.jks" ]; then
	/usr/bin/sparky-pjeoffice trust --if-changed >&2 || exit 1
fi
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/sparky-pjeoffice
mkdir -p "$STATE" || exit 1
answers() {
	curl -fs --max-time 2 -X PUT -H 'Content-Type: application/json' -H 'Force-Preflight: true' -H 'Origin: http://127.0.0.1:8800' \
		'http://127.0.0.1:8800/pjeOffice/?u=18' 2>/dev/null | grep -q '"success"'
}
exec 9>"$STATE/start.lock"
flock -w 120 9 || { echo "PJeOffice Pro: another start is still waiting for the signer" >&2; exit 1; }
if answers; then
	exit 0
fi
# the last three starts keep their log
[ -f "$STATE/signer.log.1" ] && mv -f "$STATE/signer.log.1" "$STATE/signer.log.2"
[ -f "$STATE/signer.log" ] && mv -f "$STATE/signer.log" "$STATE/signer.log.1"
case "${LANG:-C}" in C | POSIX | '') export LANG=C.UTF-8 ;; esac
CODEC=/usr/lib/sparky-pjeoffice/codec
if [ -d "$CODEC" ]; then
	LD_LIBRARY_PATH="$CODEC${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
	export LD_LIBRARY_PATH
fi
cd "$APP" || exit 1
"$APP/jre/bin/java" -XX:+UseG1GC -XX:MinHeapFreeRatio=3 -XX:MaxHeapFreeRatio=3 -Xms20m -Xmx2048m \
	-Dpjeoffice_home="$APP" -Dffmpeg_home=/var/lib/sparky-pjeoffice/ffmpeg \
	-Dpjeoffice_looksandfeels=Metal -Dcutplayer4j_looksandfeels=Nimbus -Dsigner4j_a3auto=true \
	-cp "$TRUST:$APP/pjeoffice-pro.jar" br.jus.cnj.pje.office.imp.PjeOfficePROUser < /dev/null >> "$STATE/signer.log" 2>&1 9>&- &
PID=$!
echo "$PID" > "$STATE/signer.pid"
for _ in $(seq 90); do
	if answers; then
		exit 0
	fi
	if ! kill -0 "$PID" 2>/dev/null; then
		echo "PJeOffice Pro ended while starting; its log is $STATE/signer.log" >&2
		exit 1
	fi
	sleep 1
done
echo "PJeOffice Pro did not answer within 90 seconds; its log is $STATE/signer.log" >&2
exit 1
