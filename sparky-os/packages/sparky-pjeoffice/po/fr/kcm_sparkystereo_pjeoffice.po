"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "PJeOffice Pro"
msgstr "PJeOffice Pro"

msgid "Open the signer"
msgstr "Ouvrir le signataire"

msgid "Restart the signer"
msgstr "Redémarrer le signataire"

msgid "Check CNJ's update address"
msgstr "Vérifier l’adresse de mise à jour du CNJ"

msgid "Settings…"
msgstr "Configuration…"

msgid "Quit this tray entry (the signer keeps running)"
msgstr "Quitter cette icône (le signataire continue de tourner)"

msgid "The signer stopped answering."
msgstr "Le signataire ne répond plus."

msgid "PJeOffice Pro is not installed."
msgstr "PJeOffice Pro n’est pas installé."

msgid "Version %1"
msgstr "Version %1"

msgid "Install it from the app center."
msgstr "Installez-le depuis le centre d’applications."

msgid "Reviewed version %1 is waiting; %2 is in use."
msgstr "La version examinée %1 attend ; la %2 est en service."

msgid "The installed version is the reviewed one."
msgstr "La version installée est celle qui a été examinée."

msgid "Looking for the signer…"
msgstr "Recherche du signataire…"

msgid "The signer answers on this computer. The system's certificate list changed: restart the signer to use it."
msgstr "Le signataire répond sur cet ordinateur. La liste de certificats du système a changé : redémarrez le signataire pour l’utiliser."

msgid "The signer answers on this computer."
msgstr "Le signataire répond sur cet ordinateur."

msgid "The signer does not answer on this computer. Open it from this menu."
msgstr "Le signataire ne répond pas sur cet ordinateur. Ouvrez-le depuis ce menu."

msgid "Restart the signer now? Finish any signing first: a signing in progress would be cut."
msgstr "Redémarrer le signataire maintenant ? Terminez d’abord toute signature : une signature en cours serait interrompue."

msgid "PJeOffice Pro is not installed. Install it from the app center."
msgstr "PJeOffice Pro n’est pas installé. Installez-le depuis le centre d’applications."

msgid "Up to date: version %1 is the reviewed one. Updates arrive with the package, after each new version is reviewed."
msgstr "À jour : la version %1 est celle qui a été examinée. Les mises à jour arrivent avec le paquet, après examen de chaque nouvelle version."

msgid "Version %1 is in use. The reviewed version %2 did not install: see the Problems page."
msgstr "La version %1 est en service. La version examinée %2 n’a pas été installée : voir la page Problèmes."

msgid "CNJ's update address has not been looked at yet."
msgstr "L’adresse de mise à jour du CNJ n’a pas encore été consultée."

msgid "CNJ's update address could not be read on %1: %2"
msgstr "L’adresse de mise à jour du CNJ n’a pas pu être lue le %1 : %2"

msgid "On %1 CNJ's update address named version %2."
msgstr "Le %1, l’adresse de mise à jour du CNJ indiquait la version %2."

msgid "The signer does not answer on this computer. Open it with the button below."
msgstr "Le signataire ne répond pas sur cet ordinateur. Ouvrez-le avec le bouton ci-dessous."

msgid "The system's certificate list changed. Restart the signer to use it."
msgstr "La liste de certificats du système a changé. Redémarrez le signataire pour l’utiliser."

msgid "At login:"
msgstr "À la connexion :"

msgid "Start PJeOffice Pro when I log in"
msgstr "Démarrer PJeOffice Pro à ma connexion"

msgid "Installed version:"
msgstr "Version installée :"

msgid "none"
msgstr "aucune"

msgid "Reviewed version:"
msgstr "Version examinée :"

msgid "Previous version kept:"
msgstr "Version précédente conservée :"

msgid "Update:"
msgstr "Mise à jour :"

msgid "CNJ's address:"
msgstr "Adresse du CNJ :"

msgid "Open the certificate manager"
msgstr "Ouvrir le gestionnaire de certificats"

msgid "The certificate manager (Kleopatra) is not installed."
msgstr "Le gestionnaire de certificats (Kleopatra) n’est pas installé."

msgid "Certificates, token drivers and PINs are set in the signer's own window. What the system trusts for secure connections is Sparky CA's."
msgstr "Les certificats, les pilotes de jeton et les codes PIN se règlent dans la fenêtre du signataire elle-même. Ce à quoi le système fait confiance pour les connexions sécurisées relève de Sparky CA."
