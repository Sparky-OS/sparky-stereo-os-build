msgid "PJeOffice Pro"
msgstr "PJeOffice Pro"

msgid "Open the signer"
msgstr "서명 프로그램 열기"

msgid "Restart the signer"
msgstr "서명 프로그램 다시 시작"

msgid "Check CNJ's update address"
msgstr "CNJ 업데이트 주소 확인"

msgid "Settings…"
msgstr "설정…"

msgid "Quit this tray entry (the signer keeps running)"
msgstr "이 트레이 항목 끝내기(서명 프로그램은 계속 실행됩니다)"

msgid "The signer stopped answering."
msgstr "서명 프로그램이 응답하지 않게 되었습니다."

msgid "PJeOffice Pro is not installed."
msgstr "PJeOffice Pro가 설치되어 있지 않습니다."

msgid "Version %1"
msgstr "버전 %1"

msgid "Install it from the app center."
msgstr "앱 센터에서 설치하세요."

msgid "Reviewed version %1 is waiting; %2 is in use."
msgstr "검토된 버전 %1이(가) 대기 중이며 %2을(를) 사용 중입니다."

msgid "The installed version is the reviewed one."
msgstr "설치된 버전이 검토된 버전입니다."

msgid "Looking for the signer…"
msgstr "서명 프로그램을 찾는 중…"

msgid "The signer answers on this computer. The system's certificate list changed: restart the signer to use it."
msgstr "서명 프로그램이 이 컴퓨터에서 응답합니다. 시스템의 인증서 목록이 바뀌었습니다. 사용하려면 서명 프로그램을 다시 시작하세요."

msgid "The signer answers on this computer."
msgstr "서명 프로그램이 이 컴퓨터에서 응답합니다."

msgid "The signer does not answer on this computer. Open it from this menu."
msgstr "서명 프로그램이 이 컴퓨터에서 응답하지 않습니다. 이 메뉴에서 여세요."

msgid "Restart the signer now? Finish any signing first: a signing in progress would be cut."
msgstr "서명 프로그램을 지금 다시 시작할까요? 먼저 서명을 마치세요. 진행 중인 서명은 중단됩니다."

msgid "PJeOffice Pro is not installed. Install it from the app center."
msgstr "PJeOffice Pro가 설치되어 있지 않습니다. 앱 센터에서 설치하세요."

msgid "Up to date: version %1 is the reviewed one. Updates arrive with the package, after each new version is reviewed."
msgstr "최신 상태입니다. 버전 %1이(가) 검토된 버전입니다. 업데이트는 새 버전이 검토된 뒤 패키지와 함께 옵니다."

msgid "Version %1 is in use. The reviewed version %2 did not install: see the Problems page."
msgstr "버전 %1을(를) 사용 중입니다. 검토된 버전 %2이(가) 설치되지 않았습니다. 문제 페이지를 보세요."

msgid "CNJ's update address has not been looked at yet."
msgstr "CNJ의 업데이트 주소를 아직 확인하지 않았습니다."

msgid "CNJ's update address could not be read on %1: %2"
msgstr "%1에 CNJ의 업데이트 주소를 읽지 못했습니다: %2"

msgid "On %1 CNJ's update address named version %2."
msgstr "%1에 CNJ의 업데이트 주소가 알려 준 버전은 %2입니다."

msgid "The signer does not answer on this computer. Open it with the button below."
msgstr "서명 프로그램이 이 컴퓨터에서 응답하지 않습니다. 아래 버튼으로 여세요."

msgid "The system's certificate list changed. Restart the signer to use it."
msgstr "시스템의 인증서 목록이 바뀌었습니다. 사용하려면 서명 프로그램을 다시 시작하세요."

msgid "At login:"
msgstr "로그인할 때:"

msgid "Start PJeOffice Pro when I log in"
msgstr "로그인할 때 PJeOffice Pro 시작"

msgid "Installed version:"
msgstr "설치된 버전:"

msgid "none"
msgstr "없음"

msgid "Reviewed version:"
msgstr "검토된 버전:"

msgid "Previous version kept:"
msgstr "보관 중인 이전 버전:"

msgid "Update:"
msgstr "업데이트:"

msgid "CNJ's address:"
msgstr "CNJ 주소:"

msgid "Open the certificate manager"
msgstr "인증서 관리자 열기"

msgid "The certificate manager (Kleopatra) is not installed."
msgstr "인증서 관리자(Kleopatra)가 설치되어 있지 않습니다."

msgid "Certificates, token drivers and PINs are set in the signer's own window. What the system trusts for secure connections is Sparky CA's."
msgstr "인증서, 토큰 드라이버, PIN은 서명 프로그램 자체 창에서 설정합니다. 보안 연결에서 시스템이 신뢰하는 대상은 Sparky CA가 관리합니다."
