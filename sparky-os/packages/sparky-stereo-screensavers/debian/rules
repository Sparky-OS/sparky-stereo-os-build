#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DKDE_INSTALL_USE_QT_SYS_PATHS=ON "-DCMAKE_CXX_FLAGS=-ffile-prefix-map=$(CURDIR)=." "-DCMAKE_C_FLAGS=-ffile-prefix-map=$(CURDIR)=."

override_dh_auto_test:
	python3 po/tools/make-po.py . --check
	dh_auto_test
