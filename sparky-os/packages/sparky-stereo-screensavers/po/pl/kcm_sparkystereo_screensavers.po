"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "The installed saver %1 differs from the one qualified (qualified %2, installed %3)."
msgstr "Zainstalowany wygaszacz %1 różni się od sprawdzonego (sprawdzony %2, zainstalowany %3)."

msgid "The settings file %1 differs from the one qualified (qualified %2, installed %3)."
msgstr "Plik ustawień %1 różni się od sprawdzonego (sprawdzony %2, zainstalowany %3)."

msgid "The stereo layer %1 differs from the one qualified (qualified %2, installed %3)."
msgstr "Warstwa stereo %1 różni się od sprawdzonej (sprawdzona %2, zainstalowana %3)."

msgid "The file %1 is not installed (qualified %2)."
msgstr "Plik %1 nie jest zainstalowany (sprawdzony %2)."

msgid "Its qualification record does not pass the checks."
msgstr "Jego zapis sprawdzenia nie przechodzi kontroli."

msgid "Its qualification record is incomplete."
msgstr "Jego zapis sprawdzenia jest niepełny."

msgid "The stereo savers are not installed (the package gl-stereo-savers). Install it to choose and see them."
msgstr "Wygaszacze stereo nie są zainstalowane (pakiet gl-stereo-savers). Zainstaluj go, aby je wybierać i oglądać."

msgid "The stereo savers could not be checked: %1"
msgstr "Nie udało się sprawdzić wygaszaczy stereo: %1"

msgid "“%1” cannot be shown: its files are not the ones its stereo check was made on. Update the system; if it stays, reinstall gl-stereo-savers."
msgstr "Nie można pokazać „%1”: jego pliki nie są tymi, na których wykonano sprawdzenie stereo. Zaktualizuj system; jeśli to nie pomoże, zainstaluj ponownie gl-stereo-savers."

msgid "“%1” is not installed. Reinstall the XScreenSaver packages."
msgstr "„%1” nie jest zainstalowany. Zainstaluj ponownie pakiety XScreenSaver."

msgid "“%1” could not start: the private display it draws on did not start. Check that the package xvfb is installed."
msgstr "Nie udało się uruchomić „%1”: prywatny ekran, na którym rysuje, nie uruchomił się. Sprawdź, czy pakiet xvfb jest zainstalowany."

msgid "“%1” stopped by itself (%2). Choose another screensaver, or try again."
msgstr "„%1” zatrzymał się sam (%2). Wybierz inny wygaszacz albo spróbuj ponownie."

msgid "“%1” drew no picture. Try again; on a busy computer a screensaver can take a while to start."
msgstr "„%1” nie narysował żadnego obrazu. Spróbuj ponownie; na obciążonym komputerze wygaszacz może uruchamiać się dłużej."

msgid "The preview program is missing (%1). Reinstall sparky-stereo-screensavers."
msgstr "Brakuje programu podglądu (%1). Zainstaluj ponownie sparky-stereo-screensavers."

msgid "“%1” sent a picture the page could not accept (%2). Choose another screensaver."
msgstr "„%1” przesłał obraz, którego strona nie mogła przyjąć (%2). Wybierz inny wygaszacz."

msgid "This desktop does not take 3D pictures from programs, so the preview shows one view."
msgstr "Ten pulpit nie przyjmuje obrazów 3D od programów, więc podgląd pokazuje jeden widok."

msgid "The preview does not fit in the window, so it shows one view. Make the window larger to see it in 3D."
msgstr "Podgląd nie mieści się w oknie, więc pokazuje jeden widok. Powiększ okno, aby zobaczyć go w 3D."

msgid "The desktop did not say your depth limits, so this preview has the screensaver's own depth."
msgstr "Pulpit nie podał Twoich granic głębi, więc ten podgląd ma własną głębię wygaszacza."

msgid "The desktop refused the 3D picture, so the preview shows one view."
msgstr "Pulpit odrzucił obraz 3D, więc podgląd pokazuje jeden widok."

msgid "%1 screensaver cannot be offered. Select it to read why."
msgid_plural "%1 screensavers cannot be offered. Select one to read why."
msgstr[0] "%1 wygaszacz nie może być oferowany. Zaznacz go, aby przeczytać dlaczego."
msgstr[1] "%1 wygaszacze nie mogą być oferowane. Zaznacz jeden, aby przeczytać dlaczego."
msgstr[2] "%1 wygaszaczy nie może być oferowanych. Zaznacz jeden, aby przeczytać dlaczego."

msgid "The screensaver show is switched off. The choices below are kept and used when it is switched on again."
msgstr "Pokaz wygaszaczy jest wyłączony. Poniższe wybory są zachowane i zostaną użyte po ponownym włączeniu."

msgid "Stereo Variety could not be opened. Check that the package variety is installed."
msgstr "Nie udało się otworzyć Stereo Variety. Sprawdź, czy pakiet variety jest zainstalowany."

msgid "%1 in 3D, %2 in 2D"
msgstr "%1 w 3D, %2 w 2D"

msgid "In the show"
msgstr "W pokazie"

msgid "Not offered"
msgstr "Nie oferowany"

msgctxt "a screensaver drawn with depth"
msgid "3D"
msgstr "3D"

msgctxt "a screensaver drawn flat"
msgid "2D"
msgstr "2D"

msgid "%1 screensaver in the show"
msgid_plural "%1 screensavers in the show"
msgstr[0] "%1 wygaszacz w pokazie"
msgstr[1] "%1 wygaszacze w pokazie"
msgstr[2] "%1 wygaszaczy w pokazie"

msgid "Only This One"
msgstr "Tylko ten"

msgid "All 3D Ones"
msgstr "Wszystkie 3D"

msgid "Select a screensaver to see it here."
msgstr "Zaznacz wygaszacz, aby zobaczyć go tutaj."

msgid "Starting “%1”…"
msgstr "Uruchamianie „%1”…"

msgid "Full Screen Preview"
msgstr "Podgląd na pełnym ekranie"

msgid "Shows the selected screensaver on the whole screen. Any key or a move of the pointer ends it."
msgstr "Pokazuje zaznaczony wygaszacz na całym ekranie. Kończy go dowolny klawisz lub ruch wskaźnika."

msgid "Try Again"
msgstr "Spróbuj ponownie"

msgid "Drawn in 3D: one view for each eye. Its far side stands at your depth limit."
msgstr "Rysowany w 3D: jeden widok dla każdego oka. Jego dalsza strona stoi na Twojej granicy głębi."

msgid "Drawn in 2D: the same picture in both eyes, at the screen. It joins the show when ticked."
msgstr "Rysowany w 2D: ten sam obraz w obu oczach, na płaszczyźnie ekranu. Dołącza do pokazu po zaznaczeniu."

msgid "By %1. XScreenSaver is by Jamie Zawinski and its contributors."
msgstr "Autor: %1. XScreenSaver stworzył Jamie Zawinski ze współtwórcami."

msgid "Show:"
msgstr "Pokaz:"

msgid "Screensaver show on AC power"
msgstr "Pokaz wygaszaczy przy zasilaniu sieciowym"

msgid "Start after idle:"
msgstr "Start po bezczynności:"

msgid "%1 minute"
msgid_plural "%1 minutes"
msgstr[0] "%1 minuta"
msgstr[1] "%1 minuty"
msgstr[2] "%1 minut"

msgid "Change screensaver every:"
msgstr "Zmiana wygaszacza co:"

msgid "Lock screen automatically:"
msgstr "Automatyczna blokada ekranu:"

msgid "After %1 minute"
msgid_plural "After %1 minutes"
msgstr[0] "Po %1 minucie"
msgstr[1] "Po %1 minutach"
msgstr[2] "Po %1 minutach"

msgctxt "the screen is never locked automatically"
msgid "Never"
msgstr "Nigdy"

msgid "Desktop background:"
msgstr "Tło pulpitu:"

msgid "Lock screen background:"
msgstr "Tło ekranu blokady:"

msgid "The show also plays after a manual lock while the screen is on. The desktop and the lock screen each keep their own background: a picture, a slide show, a stereo image or a video is chosen on Wallpaper for the desktop and on Screen Locking for the lock screen."
msgstr "Pokaz jest odtwarzany także po ręcznym zablokowaniu, gdy ekran jest włączony. Pulpit i ekran blokady mają każdy własne tło: obraz, pokaz slajdów, obraz stereo lub wideo wybiera się na stronie Tapeta dla pulpitu i na stronie Blokowanie ekranu dla ekranu blokady."

msgid "The video background is not installed (the package %1). Install it to choose a video on Wallpaper and on Screen Locking."
msgstr "Tło wideo nie jest zainstalowane (pakiet %1). Zainstaluj je, aby wybrać wideo na stronach Tapeta i Blokowanie ekranu."

msgctxt "@action:button opens that settings page"
msgid "Wallpaper…"
msgstr "Tapeta…"

msgctxt "@action:button opens that settings page"
msgid "Screen Locking…"
msgstr "Blokowanie ekranu…"

msgctxt "@action:button opens that settings page"
msgid "Display && Monitor…"
msgstr "Ekran i monitor…"

msgctxt "@action:button opens that settings page"
msgid "Power Management…"
msgstr "Zarządzanie energią…"

msgctxt "@action:button opens the wallpaper slide show's own settings"
msgid "Stereo Variety (slide show)…"
msgstr "Stereo Variety (pokaz slajdów)…"
