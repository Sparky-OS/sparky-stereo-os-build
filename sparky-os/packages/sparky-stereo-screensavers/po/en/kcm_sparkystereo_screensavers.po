msgid "The installed saver %1 differs from the one qualified (qualified %2, installed %3)."
msgstr "The installed saver %1 differs from the one qualified (qualified %2, installed %3)."

msgid "The settings file %1 differs from the one qualified (qualified %2, installed %3)."
msgstr "The settings file %1 differs from the one qualified (qualified %2, installed %3)."

msgid "The stereo layer %1 differs from the one qualified (qualified %2, installed %3)."
msgstr "The stereo layer %1 differs from the one qualified (qualified %2, installed %3)."

msgid "The file %1 is not installed (qualified %2)."
msgstr "The file %1 is not installed (qualified %2)."

msgid "Its qualification record does not pass the checks."
msgstr "Its qualification record does not pass the checks."

msgid "Its qualification record is incomplete."
msgstr "Its qualification record is incomplete."

msgid "The stereo savers are not installed (the package gl-stereo-savers). Install it to choose and see them."
msgstr "The stereo savers are not installed (the package gl-stereo-savers). Install it to choose and see them."

msgid "The stereo savers could not be checked: %1"
msgstr "The stereo savers could not be checked: %1"

msgid "“%1” cannot be shown: its files are not the ones its stereo check was made on. Update the system; if it stays, reinstall gl-stereo-savers."
msgstr "“%1” cannot be shown: its files are not the ones its stereo check was made on. Update the system; if it stays, reinstall gl-stereo-savers."

msgid "“%1” is not installed. Reinstall the XScreenSaver packages."
msgstr "“%1” is not installed. Reinstall the XScreenSaver packages."

msgid "“%1” could not start: the private display it draws on did not start. Check that the package xvfb is installed."
msgstr "“%1” could not start: the private display it draws on did not start. Check that the package xvfb is installed."

msgid "“%1” stopped by itself (%2). Choose another screensaver, or try again."
msgstr "“%1” stopped by itself (%2). Choose another screensaver, or try again."

msgid "“%1” drew no picture. Try again; on a busy computer a screensaver can take a while to start."
msgstr "“%1” drew no picture. Try again; on a busy computer a screensaver can take a while to start."

msgid "The preview program is missing (%1). Reinstall sparky-stereo-screensavers."
msgstr "The preview program is missing (%1). Reinstall sparky-stereo-screensavers."

msgid "“%1” sent a picture the page could not accept (%2). Choose another screensaver."
msgstr "“%1” sent a picture the page could not accept (%2). Choose another screensaver."

msgid "This desktop does not take 3D pictures from programs, so the preview shows one view."
msgstr "This desktop does not take 3D pictures from programs, so the preview shows one view."

msgid "The preview does not fit in the window, so it shows one view. Make the window larger to see it in 3D."
msgstr "The preview does not fit in the window, so it shows one view. Make the window larger to see it in 3D."

msgid "The desktop did not say your depth limits, so this preview has the screensaver's own depth."
msgstr "The desktop did not say your depth limits, so this preview has the screensaver's own depth."

msgid "The desktop refused the 3D picture, so the preview shows one view."
msgstr "The desktop refused the 3D picture, so the preview shows one view."

msgid "%1 screensaver cannot be offered. Select it to read why."
msgid_plural "%1 screensavers cannot be offered. Select one to read why."
msgstr[0] "%1 screensaver cannot be offered. Select it to read why."
msgstr[1] "%1 screensavers cannot be offered. Select one to read why."

msgid "The screensaver show is switched off. The choices below are kept and used when it is switched on again."
msgstr "The screensaver show is switched off. The choices below are kept and used when it is switched on again."

msgid "Stereo Variety could not be opened. Check that the package variety is installed."
msgstr "Stereo Variety could not be opened. Check that the package variety is installed."

