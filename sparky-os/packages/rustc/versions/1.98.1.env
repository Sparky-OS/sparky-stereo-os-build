# Sparky Stereo OS: the first link of the Rust chain, Debian's rustc 1.98.1 source built by Debian testing's rustc 1.97.1.
# DEBIAN_VERSION and DSC_SHA256: Debian unstable's source package, as apt-get source downloads it (read 2026-11-12).
UPSTREAM=1.98.1
DEBIAN_VERSION=1.98.1+dfsg1-1
DSC_SHA256=e773109b3a36ab6363b9ffa7391eef1e8e31c19590b58606ea2820d28526f9e4
EDITION=stereo3d1
# The compiler that builds this one: the rustc package apt must offer in the build container.
SEED_VERSION=1.97.1+dfsg1-1
# The 16 hex digits rustc gives this build's standard library (libstd-HASH.so): the runtime package is libstd-rust-HASH.
# "discover" on the first build of a version; the build then says the value to record here (README, "The first build").
STD_HASH=61d1d3882fa5d346
