+class StructuredPreviewTestCase(common.BleachbitTestCase):
+    @pytest.mark.skipif(not sys.platform.startswith('linux'), reason='Linux mount IDs')
+    def test_scoped_json_accounting(self):
+        """A real cleaner supplies the file, option, mount and allocated bytes."""
+        import json
+        with tempfile.TemporaryDirectory() as home:
+            env = dict(os.environ, HOME=home, BLEACHBIT_TEST_OPTIONS_DIR=home)
+            path = os.path.join(home, '.cache', 'sparse')
+            os.mkdir(os.path.dirname(path))
+            with open(path, 'wb') as file:
+                file.write(b'x')
+                file.truncate(2 * 1024 * 1024)
+            command = [sys.executable, 'bleachbit.py', '--preview', '--json',
+                       '--volume', '/', 'system.cache']
+            code, stdout, stderr = run_external(command, env=env, clean_env=False, timeout=30)
+            self.assertEqual(code, 0, stderr)
+            rows = json.loads(stdout)['items']
+            rows = [row for row in rows if row['path'] == path]
+            self.assertEqual(len(rows), 1)
+            self.assertEqual(rows[0]['cleaner'], 'system')
+            self.assertEqual(rows[0]['option'], 'cache')
+            self.assertEqual(rows[0]['bytes'], os.stat(path).st_blocks * 512)
+            self.assertTrue(os.path.exists(path))
