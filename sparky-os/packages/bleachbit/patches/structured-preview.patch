new file mode 100644
index 0000000..9b20623
--- /dev/null
+++ b/bleachbit/Structured.py
@@ -0,0 +1,265 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Volume-specific preview and confirmation for BleachBit frontends."""
+
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+import shlex
+import subprocess
+import stat
+import time
+
+from bleachbit import Command, FileUtilities, Options
+from bleachbit.Cleaner import backends
+from bleachbit.Language import get_text as _
+
+PROTECTED_EVIDENCE = ('/var/log/journal', '/run/log/journal', '/var/lib/systemd/coredump',
+                      '/var/crash')
+
+
+@contextmanager
+def open_path(path, parent=None, extra_flags=0):
+    fd = os.open(path, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC | extra_flags,
+                 dir_fd=parent)
+    try:
+        yield fd
+    finally:
+        os.close(fd)
+
+
+@contextmanager
+def open_directory(path):
+    fd = os.open('/', os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
+    try:
+        for name in path.split('/')[1:]:
+            if name:
+                next_fd = os.open(name, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
+                                  dir_fd=fd)
+                os.close(fd)
+                fd = next_fd
+        yield fd
+    finally:
+        os.close(fd)
+
+
+def mount_id(fd):
+    with open(f'/proc/self/fdinfo/{fd}', encoding='ascii') as info:
+        for line in info:
+            if line.startswith('mnt_id:'):
+                return int(line.split()[1])
+    raise OSError(_('The filesystem of this item could not be identified.'))
+
+
+def mount_types():
+    with open('/proc/self/mountinfo', encoding='utf-8', errors='surrogateescape') as info:
+        for line in info:
+            mount, filesystem = line.split(' - ', 1)
+            yield int(mount.split()[0]), filesystem.split()[0]
+
+
+def identity(info):
+    return [info.st_dev, info.st_ino, info.st_uid, info.st_mode, info.st_nlink,
+            info.st_size, info.st_blocks, info.st_ctime_ns, info.st_mtime_ns]
+
+
+def catalog():
+    """Return the same options and selection as BleachBit's own window."""
+    options = Options.options
+    return [{
+        'id': cleaner.get_id(), 'label': cleaner.get_name(),
+        'description': cleaner.get_description(),
+        'options': [{
+            'id': name, 'label': label,
+            'description': dict(cleaner.get_option_descriptions()).get(label, ''),
+            'warning': cleaner.get_warning(name) or '',
+            'checked': options.get_tree(cleaner.get_id(), name),
+        } for name, label in cleaner.get_options()],
+    } for cleaner in sorted(backends.values(), key=lambda item: item.get_name().casefold())]
+
+
+class Structured:
+    """Filter the real Worker commands before allowing any changes."""
+
+    def __init__(self, volume, approved=None, temporary_age=7):
+        self.volume = os.path.normpath(volume)
+        self.approved = approved
+        self.temporary_age = temporary_age
+        self.items = []
+        self.errors = []
+        self.seen = set()
+        if not self.volume.startswith('/') or self.volume.startswith('//'):
+            raise ValueError(_('Provide an absolute path to a mounted volume.'))
+        with open_directory(self.volume) as fd:
+            self.mount = mount_id(fd)
+            if self.volume != '/':
+                with open_directory(os.path.dirname(self.volume)) as parent:
+                    if mount_id(parent) == self.mount:
+                        raise ValueError(_('Provide an absolute path to a mounted volume.'))
+            self.read_only = bool(os.fstatvfs(fd).f_flag & os.ST_RDONLY)
+        fs_type = dict(mount_types()).get(self.mount)
+        self.estimated = fs_type not in ('ext2', 'ext3', 'ext4', 'tmpfs')
+
+    def blocked(self, operation, reason):
+        if operation not in self.seen:
+            self.seen.add(operation)
+            self.errors.append({'operation': operation, 'reason': reason})
+
+    def temporary_commands(self):
+        """Pass eligible top-level temporary files to the same BleachBit command."""
+        directories = {'/tmp', '/var/tmp'}
+        private = os.environ.get('TMPDIR')
+        if private and os.path.isabs(private):
+            private = os.path.normpath(private)
+            home = os.path.normpath(os.path.expanduser('~'))
+            preserved = [os.path.join(home, name) for name in ('Documents', 'Downloads', 'Desktop',
+                         'Pictures', 'Music', 'Videos', '.config', '.local')]
+            if private != home and not any(private == path or private.startswith(path + '/')
+                                          for path in preserved):
+                try:
+                    with open_directory(private) as folder:
+                        info = os.fstat(folder)
+                        if info.st_uid == os.getuid() and info.st_mode & 0o777 == 0o700:
+                            directories.add(private)
+                except OSError as error:
+                    self.blocked('system.tmp', str(error))
+        for path in sorted(directories):
+            try:
+                with open_directory(path) as folder:
+                    if mount_id(folder) != self.mount:
+                        continue
+                    fd = os.open('.', os.O_RDONLY | os.O_DIRECTORY, dir_fd=folder)
+                    try:
+                        for name in sorted(os.listdir(fd)):
+                            self.process(Command.Delete(os.path.join(path, name)), 'system.tmp')
+                    finally:
+                        os.close(fd)
+            except OSError as error:
+                self.blocked('system.tmp', str(error))
+
+    def apt_commands(self, option):
+        """Expand APT's configured cache and list directories under its own locks."""
+        import fcntl
+
+        operation = f'apt.{option}'
+        key = 'Dir::State::lists/d' if option == 'package_lists' else 'Dir::Cache::archives/d'
+        try:
+            output = subprocess.check_output(['apt-config', 'shell', 'directory', key], text=True)
+            first, = shlex.split(output)
+            prefix, directory = first.split('=', 1)
+            if prefix != 'directory' or not directory.startswith('/'):
+                raise ValueError(_('APT did not report an absolute cache directory.'))
+            directory = os.path.normpath(directory)
+            with open_directory(directory) as parent:
+                if mount_id(parent) != self.mount:
+                    return
+                fd = os.open('lock', os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+                try:
+                    try:
+                        fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                    except BlockingIOError as error:
+                        raise OSError(_('APT is using this directory.')) from error
+                    for path in (directory, os.path.join(directory, 'partial')):
+                        with open_directory(path) as folder:
+                            if mount_id(folder) != self.mount:
+                                continue
+                            read_fd = os.open('.', os.O_RDONLY | os.O_DIRECTORY, dir_fd=folder)
+                            try:
+                                for name in sorted(os.listdir(read_fd)):
+                                    if name != 'lock':
+                                        self.process(Command.Delete(os.path.join(path, name)),
+                                                     operation)
+                            finally:
+                                os.close(read_fd)
+                finally:
+                    os.close(fd)
+        except (OSError, ValueError, subprocess.SubprocessError) as error:
+            self.blocked(operation, str(error))
+
+    def process(self, cmd, operation):
+        """Expose or execute a single command generated by a BleachBit cleaner."""
+        path = getattr(cmd, 'path', None)
+        if not path or not os.path.isabs(path):
+            message = _('This action does not expose individual paths for a volume preview.')
+            if operation == 'journald.clean':
+                message = _('Archived journals can contain logs from the current boot.')
+            self.blocked(operation, message)
+            return
+        if type(cmd) not in (Command.Delete, Command.Truncate) or cmd.shred:
+            self.blocked(operation, _('This action cannot be confined to the selected item.'))
+            return
+        path = os.path.normpath(path)
+        if any(path == directory or path.startswith(directory + '/') for directory in PROTECTED_EVIDENCE):
+            self.blocked(operation, _('Logs and crash evidence are protected.'))
+            return
+        if path in ('/', self.volume) or (operation, path) in self.seen:
+            return
+        self.seen.add((operation, path))
+        parent_path, name = os.path.split(path)
+        try:
+            with open_directory(parent_path) as parent, open_path(name, parent) as fd:
+                if mount_id(fd) != self.mount or FileUtilities.whitelisted(path):
+                    return
+                info = os.fstat(fd)
+                if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
+                    return
+                cleaner, option = operation.split('.', 1)
+                record = [self.mount, operation, path, identity(info), type(cmd).__name__]
+                token = hashlib.sha256(json.dumps(record).encode('ascii')).hexdigest()
+                if self.approved is not None and token not in self.approved:
+                    return
+                if operation == 'system.tmp':
+                    if os.getuid() != 0 and info.st_uid != os.getuid():
+                        return
+                    cutoff = time.time() - self.temporary_age * 24 * 3600
+                    if max(info.st_atime, info.st_mtime, info.st_ctime) > cutoff:
+                        return
+                result = {
+                    'id': token, 'cleaner': cleaner, 'option': option, 'path': path,
+                    'bytes': info.st_blocks * 512, 'estimated': self.estimated,
+                    'label': _('Delete') if type(cmd) is Command.Delete else _('Truncate'),
+                }
+                if operation == 'system.tmp' or self.approved is not None:
+                    self._locked_command(cmd, parent, name, info)
+                self.items.append(result)
+        except FileNotFoundError:
+            return
+        except OSError as error:
+            self.errors.append({'operation': operation, 'path': path, 'reason': str(error)})
+
+    def _locked_command(self, cmd, parent, name, info):
+        """Hold a Linux write lease across the final check and removal."""
+        import fcntl
+        import signal
+
+        is_truncate = isinstance(cmd, Command.Truncate)
+        mode = os.O_WRONLY if is_truncate else os.O_RDONLY
+        fd = os.open(name, mode | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOATIME,
+                     dir_fd=parent)
+        previous = signal.signal(signal.SIGIO, lambda *_: None)
+        try:
+            if identity(os.fstat(fd)) != identity(info) or mount_id(fd) != self.mount:
+                raise OSError(_('This item changed since the preview.'))
+            try:
+                fcntl.fcntl(fd, fcntl.F_SETLEASE, fcntl.F_WRLCK)
+            except BlockingIOError as error:
+                raise OSError(_('This item is currently open or mapped.')) from error
+            if self.approved is None:
+                return
+            current = os.stat(name, dir_fd=parent, follow_symlinks=False)
+            if identity(current) != identity(info):
+                raise OSError(_('This item changed since the preview.'))
+            if fcntl.fcntl(fd, fcntl.F_GETLEASE) != fcntl.F_WRLCK:
+                raise OSError(_('This item is currently open or mapped.'))
+            cmd.execute_scoped(parent, name, fd)
+        finally:
+            os.close(fd)
+            signal.signal(signal.SIGIO, previous)
+
+    def result(self):
+        if self.approved is not None:
+            completed = {item['id'] for item in self.items}
+            for token in sorted(self.approved - completed):
+                self.errors.append({'id': token, 'reason': _('The approved item could not be cleaned.')})
+        return {'schema': 1, 'volume': self.volume, 'read_only': self.read_only,
+                'items': self.items, 'errors': self.errors}
