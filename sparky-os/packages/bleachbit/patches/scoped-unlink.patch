+def remove_reviewed_path(cmd, parent, name, fd):
+    """Unlink a checked entry inside a newly created private directory."""
+    import fcntl
+    import secrets
+
+    room = '.bleachbit-' + secrets.token_hex(16)
+    os.mkdir(room, mode=0o700, dir_fd=parent)
+    empty = True
+    try:
+        with open_path(room, parent, os.O_DIRECTORY) as holding:
+            os.rename(name, 'entry', src_dir_fd=parent, dst_dir_fd=holding)
+            empty = False
+            try:
