+                        empty = True
+                    except OSError as error:
+                        # Report where the intact entry was retained if a
+                        # concurrent writer took its original name.
+                        location = os.path.join(os.readlink(f'/proc/self/fd/{holding}'), 'entry')
+                        raise OSError(error.errno, error.strerror, location) from error
+    finally:
