+def remove_reviewed_path(cmd, parent, name, fd):
+    """Unlink a checked entry inside a newly created private directory."""
+    import fcntl
+    import secrets
+
+    room = '.bleachbit-' + secrets.token_hex(16)
+    os.mkdir(room, mode=0o700, dir_fd=parent)
+    empty = True
+    try:
+        with open_path(room, parent, os.O_DIRECTORY) as holding:
+            os.rename(name, 'entry', src_dir_fd=parent, dst_dir_fd=holding)
+            empty = False
+            try:
+                # Renaming itself changes ctime. Both observations must now
+                # describe the original, still open inode in the private room.
+                moved = os.stat('entry', dir_fd=holding, follow_symlinks=False)
+                if identity(moved) != identity(os.fstat(fd)):
+                    raise OSError(_('This item changed since the preview.'))
+                if fcntl.fcntl(fd, fcntl.F_GETLEASE) != fcntl.F_WRLCK:
+                    raise OSError(_('This item is currently open or mapped.'))
+                cmd.execute_scoped(holding, 'entry', fd)
+                empty = True
+            finally:
+                if not empty:
+                    try:
+                        rename_without_replacing(holding, 'entry', parent, name)
+                        empty = True
+                    except OSError as error:
+                        # Report where the intact entry was retained if a
+                        # concurrent writer took its original name.
+                        location = os.path.join(os.readlink(f'/proc/self/fd/{holding}'), 'entry')
+                        raise OSError(error.errno, error.strerror, location) from error
+    finally:
+        if empty:
+            os.rmdir(room, dir_fd=parent)
 
 
