+def rename_without_replacing(source_fd, source, target_fd, target):
+    """Return a staged entry without overwriting a new arrival at its old name."""
+    import ctypes
+
+    renameat2 = ctypes.CDLL(None, use_errno=True).renameat2
+    renameat2.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int,
+                          ctypes.c_char_p, ctypes.c_uint)
+    if renameat2(source_fd, os.fsencode(source), target_fd, os.fsencode(target), 1):
+        err = ctypes.get_errno()
+        raise OSError(err, os.strerror(err), target)
