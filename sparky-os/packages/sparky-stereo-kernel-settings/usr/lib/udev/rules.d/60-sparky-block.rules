# Sparky Stereo OS: block device defaults.
# Source: CachyOS-Settings usr/lib/udev/rules.d/60-ioschedulers.rules (GPL-3.0) for the rotating disk rule; the read-ahead value is the CachyOS kernel
# tag cachyos-7.3.1-1, include/linux/pagemap.h:1429 (SZ_256K), applied as a rule.
# Bazzite's OGC v7.3.1-ogc5 has SZ_128K at the same source line; our 256 KiB follows CachyOS.

# Rotating disks: BFQ keeps the desktop responsive while something big is copied.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", TEST=="queue/scheduler", ATTR{queue/scheduler}="bfq"
# SSDs and NVMe keep the kernel defaults (mq-deadline / none): CachyOS sets mq-deadline / kyber; no measurement here favours changing them.
# To try the ADIOS scheduler of this kernel on an SSD:  modprobe adios  and then  ATTR{queue/scheduler}="adios".

# Read-ahead 256 KiB instead of 128 KiB (fewer, larger requests for game assets and media files).
# Queue attributes belong to whole disks; partitions can match these name globs.
ACTION=="add|change", KERNEL=="sd[a-z]*|nvme[0-9]*n[0-9]*|mmcblk[0-9]*", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", TEST=="queue/read_ahead_kb", ATTR{queue/read_ahead_kb}="256"
