#!/bin/sh
# preinst script
set -e
package=@PACKAGE@
held=/var/lib/$package/held

say_kept() {
    locale=${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}
    case "$locale" in C|C.*|POSIX) locale=en ;; *) locale=${LANGUAGE:-$locale} ;; esac
    locale=${locale%%:*}
    case "$locale" in
        pl*) message='Twoje zmiany w /etc/skel/.bashrc zachowano w /var/backups/sparky-stereo-console-skel.bashrc; wrócił własny plik /etc/skel/.bashrc pakietu bash, a znak zachęty, kolory i edytor, które edycja ustawia nowym kontom, są teraz w /etc/skel/.bash_aliases.' ;;
        pt*) message='Suas alterações em /etc/skel/.bashrc foram mantidas em /var/backups/sparky-stereo-console-skel.bashrc; o /etc/skel/.bashrc do próprio bash voltou, e o prompt, as cores e o editor que a edição dá às novas contas agora estão em /etc/skel/.bash_aliases.' ;;
        de*) message='Ihre Änderungen an /etc/skel/.bashrc bleiben in /var/backups/sparky-stereo-console-skel.bashrc erhalten; die eigene /etc/skel/.bashrc von bash ist zurück, und Eingabeaufforderung, Farben und Editor, die die Edition neuen Konten gibt, stehen jetzt in /etc/skel/.bash_aliases.' ;;
        es*) message='Sus cambios en /etc/skel/.bashrc se conservan en /var/backups/sparky-stereo-console-skel.bashrc; el /etc/skel/.bashrc propio de bash ha vuelto, y el prompt, los colores y el editor que la edición da a las cuentas nuevas están ahora en /etc/skel/.bash_aliases.' ;;
        fr*) message='Vos modifications de /etc/skel/.bashrc sont conservées dans /var/backups/sparky-stereo-console-skel.bashrc ; le /etc/skel/.bashrc propre à bash est rétabli, et l’invite, les couleurs et l’éditeur que l’édition donne aux nouveaux comptes sont désormais dans /etc/skel/.bash_aliases.' ;;
        ja*) message='/etc/skel/.bashrc への変更は /var/backups/sparky-stereo-console-skel.bashrc に保存されました。bash 本来の /etc/skel/.bashrc が戻り、エディションが新しいアカウントに与えるプロンプト、色、エディターは /etc/skel/.bash_aliases に移りました。' ;;
        ko*) message='/etc/skel/.bashrc에 대한 변경 사항은 /var/backups/sparky-stereo-console-skel.bashrc에 보존되었습니다. bash 고유의 /etc/skel/.bashrc가 돌아왔으며, 에디션이 새 계정에 주는 프롬프트, 색상, 편집기는 이제 /etc/skel/.bash_aliases에 있습니다.' ;;
        zh_CN*|zh_SG*) message='您对 /etc/skel/.bashrc 的修改已保留在 /var/backups/sparky-stereo-console-skel.bashrc 中；bash 自带的 /etc/skel/.bashrc 已恢复，本版本为新账户设置的提示符、颜色和编辑器现位于 /etc/skel/.bash_aliases。' ;;
        zh_TW*|zh_HK*|zh_MO*) message='您對 /etc/skel/.bashrc 的修改已保留在 /var/backups/sparky-stereo-console-skel.bashrc 中；bash 本身的 /etc/skel/.bashrc 已恢復，本版本為新帳號設定的提示字元、顏色和編輯器現位於 /etc/skel/.bash_aliases。' ;;
        *) message='Your changes to /etc/skel/.bashrc are kept in /var/backups/sparky-stereo-console-skel.bashrc; bash'\''s own /etc/skel/.bashrc is back, and the prompt, colours and editor the edition gives new accounts are now in /etc/skel/.bash_aliases.' ;;
    esac
    printf '%s: %s\n' "$package" "$message" >&2
    logger -t "$package" -- "$message" 2>/dev/null || :
}

# A file the person did not make: the old version's own bytes (its md5sums), or a default another package puts at
# that name (base-files' postinst writes /etc/motd from /usr/share/base-files/motd, and our older postrm put it back).
not_theirs() {
    have=$(md5sum <"$1" | cut -d' ' -f1)
    [ -n "$sums" ] && [ "$(awk -v p="${1#/}" '$2 == p {print $1}' "$sums")" = "$have" ] && return 0
    case "$1" in
    /etc/motd) [ -f /usr/share/base-files/motd ] && [ "$(md5sum </usr/share/base-files/motd | cut -d' ' -f1)" = "$have" ] && return 0 ;;
    esac
    return 1
}

if [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then
    for f in @DIVERTED@; do
        before=$(dpkg-divert --listpackage "$f")
        dpkg-divert --quiet --package "$package" --add --rename --divert "$f.debian" "$f"
        # The owning package unpacked earlier in this dpkg run keeps its conffile as $f.dpkg-new until it is
        # configured; our own $f is unpacked through that same name and would replace it, so the owner's conffile
        # would never be installed (rows 629/802). It goes where dpkg now installs the owner's copy.
        if [ -z "$before" ] && [ -e "$f.dpkg-new" ] && [ ! -e "$f.debian.dpkg-new" ]; then
            mv "$f.dpkg-new" "$f.debian.dpkg-new"
        fi
    done
    # Up to 20261102 our own copy of bash's skel .bashrc was at @GIVEN_BACK@. It is no file of ours any more, so dpkg
    # removes it at this unpack; a person's change to it is kept and said. Not in /etc/skel: useradd copies every file
    # there into each new account (Debian's adduser skips *.dpkg-old, useradd does not).
    for f in @GIVEN_BACK@; do
        if [ "$1" = "upgrade" ] && [ "$(dpkg-divert --listpackage "$f")" = "$package" ] && [ -f "$f" ]; then
            sums=$(dpkg-query --control-path "$package" md5sums 2>/dev/null) || sums=
            want=$([ -n "$sums" ] && awk -v p="${f#/}" '$2 == p {print $1}' "$sums")
            have=$(md5sum <"$f" | cut -d' ' -f1)
            if [ -n "$want" ] && [ "$want" != "$have" ]; then
                mkdir -p /var/backups
                cp -p "$f" /var/backups/sparky-stereo-console-skel.bashrc
                say_kept
            fi
        fi
    done
    # Before @FIRST@ the files under /etc were plain files, which dpkg replaced at every upgrade, a person's change
    # with them (Debian Policy 10.7.3: "local changes must be preserved during a package upgrade"). From @FIRST@
    # @CONFF@ are conffiles, and @MANAGED@ (at names this package diverts, where dpkg cannot keep two packages'
    # conffiles apart) are kept through ucf by the postinst. Each such file is set aside here, so dpkg asks nothing about
    # a file it has no record of and removes nothing of the person's; the postinst gives a changed one back.
    if [ "$1" = "install" ] && [ -z "$2" ] || dpkg --compare-versions "$2" lt @FIRST@; then
        sums=
        [ "$1" = "upgrade" ] && { sums=$(dpkg-query --control-path "$package" md5sums 2>/dev/null) || sums=; }
        for f in @CONFF@ @MANAGED@; do
            [ -f "$f" ] || [ -L "$f" ] || continue
            mkdir -p "$held${f%/*}"
            rm -f "$held$f.edited"
            not_theirs "$f" || : >"$held$f.edited"
            mv "$f" "$held$f"
        done
    fi
fi
exit 0
