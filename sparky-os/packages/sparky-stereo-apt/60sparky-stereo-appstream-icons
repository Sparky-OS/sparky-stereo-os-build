// Fetch the DEP-11 icons advertised by each repository so AppStream clients
// can show program icons in Discover and KRunner, including on HiDPI displays.
Acquire::IndexTargets::deb {
    DEP-11-icons-small::DefaultEnabled "true";
    DEP-11-icons::DefaultEnabled "true";
    DEP-11-icons-hidpi::DefaultEnabled "true";
    DEP-11-icons-large::DefaultEnabled "true";
    DEP-11-icons-large-hidpi::DefaultEnabled "true";
};
