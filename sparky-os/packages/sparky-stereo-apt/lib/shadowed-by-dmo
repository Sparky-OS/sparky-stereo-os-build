# deb-multimedia's packages that ship files of ours under another name (apt/shadowed.py; /usr/share/sparky-stereo-apt/shadowed-by-dmo.tsv, one
# "theirs<TAB>ours" per line). sparky-stereo-only-ours pins them at -1, so apt never chooses one again; this settles the machines that already
# have one, because a pin does not remove an installed package. Ours is the one we offer (Daniel, 2026-11-02), and a package the person
# installed by hand stays theirs (Daniel, 2026-11-07, ORDER 43: "If manually installed leave it"):
#   automatic   marked automatic by apt (a dependency, not asked for) and needed by nothing else: removed (apt-get remove, not purge), then ours
#               installed again where it is installed, so the files it had taken over come back; said in the journal, once.
#   manual      the person asked for it: left exactly as it is, and told with the way to change it (a problem the engine keeps, which the person
#               may dismiss; it ends when the package is gone).
#   needed      automatic, but a package that stays needs it: left, and told which.
# Same shape as thermald-manual and nvidia-i386 (sparky-stereo-hardware):
#   check    after every dpkg run (dpkg's post-invoke hook) and in postinst: does nothing unless a listed package is installed. Inside an apt
#            run apt rewrites its state file (the automatic marks) when the run ends, so nothing is decided now: it says so and starts
#            sparky-stereo-apt-shadowed.service without waiting (systemctl --no-block).
#   auto     the unit's step: waits until no apt or dpkg run holds dpkg's locks (apt-get check with DPkg::Lock::Timeout=-1), decides, acts.
#            A failed step is kept by sparky-stereo-problems with its repair (this step again); ours installed again is the last step, so a
#            failure there says that files may be missing.
# SPARKY_SHADOWED_LIST, SPARKY_SHADOWED_NESTED and SPARKY_PROBLEMS exist for the tests.
set -u
LIST=${SPARKY_SHADOWED_LIST:-/usr/share/sparky-stereo-apt/shadowed-by-dmo.tsv}
PKG=sparky-stereo-apt
UNIT=sparky-stereo-apt-shadowed.service
SELF=/usr/lib/sparky-stereo-apt/shadowed-by-dmo
PROBLEMS=${SPARKY_PROBLEMS:-sparky-stereo-problems}
installed() { dpkg-query -W -f='${db:Status-Status}\n' "$1" 2>/dev/null | grep -qx installed; }
automatic() { [[ -n $(apt-mark showauto "$1" 2>/dev/null) ]]; }
# the packages apt would remove with these, without their architecture suffix
would_remove() { apt-get -s -q remove "$@" 2>/dev/null | awk '/^Remv/ { sub(/:[a-z0-9]+$/, "", $2); print $2 }' | sort -u; }
say() { "$PROBLEMS" say "$PKG" "$@" || echo "$PKG: $* (sparky-stereo-problems could not say it)" >&2; }
keep() { "$PROBLEMS" keep --machine --repair "[\"$SELF\",\"auto\"]" "$PKG" "$@" || echo "$PKG: $* (sparky-stereo-problems could not keep it)" >&2; }
clear_key() { "$PROBLEMS" clear --machine "$PKG" "$1" >/dev/null 2>&1 || true; }
# fills: PAIRS (theirs:ours of the installed ones), GONE (theirs of the listed ones no longer installed)
PAIRS=() GONE=()
scan() {
	PAIRS=() GONE=()
	[[ -r $LIST ]] || { echo "$PKG: $LIST cannot be read: the shadowing packages cannot be settled" >&2; return 1; }
	local t o
	while IFS=$'\t' read -r t o; do
		[[ -n $t ]] || continue
		if installed "$t"; then PAIRS+=("$t:$o"); else GONE+=("$t"); fi
	done <"$LIST"
}
case ${1:-} in
check)
	[[ -n ${SPARKY_SHADOWED_NESTED:-} ]] && exit 0
	scan || exit 1
	[[ ${#PAIRS[@]} -eq 0 ]] && exit 0
	names=$(printf '%s ' "${PAIRS[@]%%:*}")
	if [[ -d /run/systemd/system ]] && ! systemd-detect-virt --quiet --chroot 2>/dev/null; then
		echo "$PKG: ${names% } from deb-multimedia ships files of the edition's packages under another name; it is settled right after this apt run (journalctl -u $UNIT)" >&2
		out=$(systemctl --no-block start "$UNIT" 2>&1) || echo "$PKG: systemctl start $UNIT failed ($out); run: $SELF auto" >&2
	else
		echo "$PKG: ${names% } from deb-multimedia ships files of the edition's packages under another name and systemd cannot start $UNIT here; run: $SELF auto" >&2
	fi
	;;
auto)
	apt-get -q -o DPkg::Lock::Timeout=-1 check >/dev/null 2>&1
	export SPARKY_SHADOWED_NESTED=1 DEBIAN_FRONTEND=noninteractive
	scan || exit 1
	for t in "${GONE[@]}"; do clear_key "shadow-$t"; done
	AUTO=() MANUAL=()
	for p in "${PAIRS[@]}"; do
		if automatic "${p%%:*}"; then AUTO+=("$p"); else MANUAL+=("$p"); fi
	done
	for p in "${MANUAL[@]}"; do
		keep "shadow-${p%%:*}" LOCAL3 "${p%%:*}" "${p##*:}" "${p%%:*}" "${p##*:}"
	done
	[[ ${#AUTO[@]} -eq 0 ]] && exit 0
	theirs=("${AUTO[@]%%:*}")
	extras=$(comm -23 <(would_remove "${theirs[@]}") <(printf '%s\n' "${theirs[@]}" | sort -u) | tr '\n' ' ')
	if [[ -n $extras ]]; then
		for p in "${AUTO[@]}"; do keep "shadow-${p%%:*}" LOCAL4 "${p%%:*}" "${p##*:}" "${extras% }" "${p%%:*}" "${p##*:}"; done
		exit 0
	fi
	ours=() reinstall=()
	for p in "${AUTO[@]}"; do
		ours+=("${p##*:}")
		installed "${p##*:}" && reinstall+=("${p##*:}")
	done
	"$PROBLEMS" run "$PKG" remove LOCAL5 "${theirs[*]}" "${ours[*]}" -- apt-get -y -q remove "${theirs[@]}" || exit 1
	if [[ ${#reinstall[@]} -gt 0 ]]; then
		"$PROBLEMS" run "$PKG" reinstall LOCAL6 "${theirs[*]}" "${reinstall[*]}" -- apt-get -y -q install --reinstall "${reinstall[@]}" || exit 1
	fi
	for p in "${AUTO[@]}"; do
		clear_key "shadow-${p%%:*}"
		if installed "${p##*:}"; then say LOCAL2 "${p%%:*}" "${p##*:}" "${p##*:}"; else say LOCAL7 "${p%%:*}" "${p##*:}" "${p##*:}"; fi
	done
	;;
*) echo "usage: ${0##*/} check|auto" >&2; exit 2 ;;
esac
