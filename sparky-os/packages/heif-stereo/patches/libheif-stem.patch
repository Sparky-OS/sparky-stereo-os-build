+Error Box_stem::parse(BitstreamRange& range, const heif_security_limits* limits)
+{
+  Error err = Box_EntityToGroup::parse(range, limits);
+  if (err) {
+    return err;
+  }
+  if (get_version() != 0 || entity_ids.size() != 3) {
+    return {heif_error_Invalid_input,
+            heif_suberror_Invalid_box_size,
+            "'stem' entity group requires version zero and exactly three image IDs"};
+  }
+  return Error::Ok;
+}
