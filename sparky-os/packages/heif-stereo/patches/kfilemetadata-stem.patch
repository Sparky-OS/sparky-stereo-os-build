+QString entityLayout(const QString &path)
+{
+    heif_context *ctx = heif_context_alloc();
+    heif_item_id primary = 0;
+    QString layout;
+    if (heif_context_read_from_file(ctx, QFile::encodeName(path).constData(), nullptr).code == heif_error_Ok
+        && heif_context_get_primary_image_ID(ctx, &primary).code == heif_error_Ok) {
+        for (const uint32_t type : {heif_entity_group_ster, heif_entity_group_stem}) {
+            int count = 0;
+            auto *groups = heif_context_get_entity_groups(ctx, type, primary, &count);
+            for (int i = 0; i < count && layout.isEmpty(); ++i) {
+                const auto &group = groups[i];
+                if (group.num_entities != (type == heif_entity_group_stem ? 3u : 2u) || group.entities[0] == group.entities[1]) {
+                    continue;
+                }
+                bool valid = true;
+                for (uint32_t n = 0; n < group.num_entities; ++n) {
+                    heif_image_handle *handle = nullptr;
+                    valid &= heif_context_get_image_handle(ctx, group.entities[n], &handle).code == heif_error_Ok;
+                    if (handle) {
+                        heif_image_handle_release(handle);
+                    }
+                }
+                if (valid) {
+                    layout = primary == group.entities[1] ? QStringLiteral("multiViewRightFirst") : QStringLiteral("multiViewLeftFirst");
+                }
+            }
+            heif_entity_groups_release(groups, count);
+            if (!layout.isEmpty()) {
+                break;
+            }
+        }
+    }
+    heif_context_free(ctx);
+    return layout;
+}
+}
