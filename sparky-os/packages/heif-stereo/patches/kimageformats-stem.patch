+    void stemPair()
+    {
+        QFETCH(QString, file);
+        QFETCH(bool, stereo);
+        QFETCH(int, primary);
+        QByteArray data = fixture(QStringLiteral("heif-stem/") + file);
+        QBuffer buffer(&data);
+        QVERIFY(buffer.open(QIODevice::ReadOnly));
+        QImageReader reader(&buffer);
+        const QString layout = reader.text(QStringLiteral("Stereo3DLayout"));
+        if (!stereo) {
+            QVERIFY(layout.isEmpty());
+            return;
+        }
+        QVERIFY(layout.startsWith(QLatin1String("multiView")));
+        const auto samePixels = [](const QImage &actual, const QImage &expected) {
+            if (actual.isNull() || actual.size() != expected.size()) {
+                return false;
+            }
+            for (int y = 0; y < actual.height(); ++y) {
+                for (int x = 0; x < actual.width(); ++x) {
+                    if (actual.pixelColor(x, y) != expected.pixelColor(x, y)) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        };
+        const QImage shown = reader.read();
+        QVERIFY(samePixels(shown, QImage::fromData(fixture(QStringLiteral("heif-stem/reference-%1.png").arg(primary)))));
+        if (primary == 2) {
+            QCOMPARE(reader.imageCount(), 3);
+            QCOMPARE(reader.text(QStringLiteral("Stereo3DViewIndices")), QStringLiteral("1,2"));
+            QVERIFY(reader.jumpToImage(1));
+            QVERIFY(samePixels(reader.read(), QImage::fromData(fixture(QStringLiteral("heif-stem/reference-0.png")))));
+            QVERIFY(reader.jumpToImage(2));
+            QVERIFY(samePixels(reader.read(), QImage::fromData(fixture(QStringLiteral("heif-stem/reference-1.png")))));
+        } else {
+            QCOMPARE(reader.imageCount(), 2);
+            QVERIFY(reader.jumpToImage(1));
+            QVERIFY(samePixels(reader.read(), QImage::fromData(fixture(QStringLiteral("heif-stem/reference-%1.png").arg(1 - primary)))));
+        }
+    }
+
