+    void stemPair_data()
+    {
+        QTest::addColumn<QString>("file");
+        QTest::addColumn<bool>("stereo");
+        QTest::addColumn<int>("primary");
+        QTest::newRow("ster-primary-0.heic") << QStringLiteral("ster-primary-0.heic") << true << 0;
+        QTest::newRow("ster-primary-1.heic") << QStringLiteral("ster-primary-1.heic") << true << 1;
+        QTest::newRow("stem-primary-0.heic") << QStringLiteral("stem-primary-0.heic") << true << 0;
+        QTest::newRow("stem-primary-1.heic") << QStringLiteral("stem-primary-1.heic") << true << 1;
+        QTest::newRow("stem-primary-2.heic") << QStringLiteral("stem-primary-2.heic") << true << 2;
+        QTest::newRow("stem-fallback-alias-0.heic") << QStringLiteral("stem-fallback-alias-0.heic") << true << 0;
+        QTest::newRow("stem-fallback-alias-1.heic") << QStringLiteral("stem-fallback-alias-1.heic") << true << 1;
+        QTest::newRow("unmarked.heic") << QStringLiteral("unmarked.heic") << false << 2;
+        QTest::newRow("unrelated-group.heic") << QStringLiteral("unrelated-group.heic") << false << 2;
+        QTest::newRow("duplicate-eyes.heic") << QStringLiteral("duplicate-eyes.heic") << false << 2;
+        QTest::newRow("missing-eye.heic") << QStringLiteral("missing-eye.heic") << false << 2;
+        QTest::newRow("short-stem.heic") << QStringLiteral("short-stem.heic") << false << 0;
+        QTest::newRow("reserved-version.heic") << QStringLiteral("reserved-version.heic") << false << 2;
+    }
+
+    void stemPair()
+    {
+        QFETCH(QString, file);
+        QFETCH(bool, stereo);
+        QFETCH(int, primary);
+        QByteArray data = fixture(QStringLiteral("heif-stem/") + file);
+        QBuffer buffer(&data);
+        QVERIFY(buffer.open(QIODevice::ReadOnly));
+        QImageReader reader(&buffer);
+        const QString layout = reader.text(QStringLiteral("Stereo3DLayout"));
+        if (!stereo) {
+            QVERIFY(layout.isEmpty());
+            return;
+        }
+        QVERIFY(layout.startsWith(QLatin1String("multiView")));
+        const auto samePixels = [](const QImage &actual, const QImage &expected) {
+            if (actual.isNull() || actual.size() != expected.size()) {
+                return false;
+            }
+            for (int y = 0; y < actual.height(); ++y) {
+                for (int x = 0; x < actual.width(); ++x) {
+                    if (actual.pixelColor(x, y) != expected.pixelColor(x, y)) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        };
+        const QImage shown = reader.read();
+        QVERIFY(samePixels(shown, QImage::fromData(fixture(QStringLiteral("heif-stem/reference-%1.png").arg(primary)))));
+        if (primary == 2) {
+            QCOMPARE(reader.imageCount(), 3);
+            QCOMPARE(reader.text(QStringLiteral("Stereo3DViewIndices")), QStringLiteral("1,2"));
+            QVERIFY(reader.jumpToImage(1));
+            QVERIFY(samePixels(reader.read(), QImage::fromData(fixture(QStringLiteral("heif-stem/reference-0.png")))));
+            QVERIFY(reader.jumpToImage(2));
+            QVERIFY(samePixels(reader.read(), QImage::fromData(fixture(QStringLiteral("heif-stem/reference-1.png")))));
+        } else {
+            QCOMPARE(reader.imageCount(), 2);
+            QVERIFY(reader.jumpToImage(1));
+            QVERIFY(samePixels(reader.read(), QImage::fromData(fixture(QStringLiteral("heif-stem/reference-%1.png").arg(1 - primary)))));
+        }
+    }
+
