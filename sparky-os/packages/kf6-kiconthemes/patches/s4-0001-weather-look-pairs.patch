+KIconLoader::WeatherIconPaths KIconLoader::weatherIconPaths(const QString &requested, const QSize &size, qreal scale) const
+{
+    static const QRegularExpression condition(QStringLiteral("^weather-[a-z0-9-]+$"));
+    if (!condition.match(requested).hasMatch() || size.isEmpty()) {
+        return {};
+    }
+
+    KConfig settings(QStringLiteral("sparky-stereo-weatherrc"), KConfig::SimpleConfig);
+    const KConfigGroup weather(&settings, QStringLiteral("Weather"));
+    auto look = weather.readEntry("Look", QStringLiteral("Auto"));
+    if (look == QLatin1String("Auto")) {
+        look = weather.readEntry("HardwareLook", QString());
+    }
+    const bool vector = look == QLatin1String("Vector");
+    QString theme;
+    if (vector) {
+        theme = QStringLiteral("sparky-weather-vector");
+    } else if (look == QLatin1String("Photoreal")) {
+        theme = QStringLiteral("sparky-weather-photoreal");
+    } else if (look == QLatin1String("RealWeather")) {
+        theme = QStringLiteral("sparky-weather-real");
+    } else {
+        return {};
+    }
+
+    QString name = requested;
+    const bool symbolic = name.endsWith(QLatin1String("-symbolic"));
+    if (symbolic && weather.readEntry("PanelIcon", QStringLiteral("Colour")) == QLatin1String("Colour")) {
+        name.chop(9);
+    }
+    const int extent = qFloor(std::min(size.width(), size.height()) * scale);
+    const auto path = [&](const QString &themeName) {
+        const KIconTheme theme(themeName);
+        QList<int> sizes = theme.querySizes(KIconLoader::Desktop);
+        std::sort(sizes.begin(), sizes.end(), std::greater<int>());
+        for (const int nativeSize : sizes) {
+            if (nativeSize <= extent) {
+                const QString exact = theme.stereoIconPathByName(name, nativeSize, KIconLoader::MatchExact, 1);
+                if (!exact.isEmpty()) {
+                    return exact;
+                }
+            }
+        }
+        return QString();
+    };
+
+    WeatherIconPaths result;
+    if (weather.readEntry("Shade", QStringLiteral("Present")) == QLatin1String("Darker")) {
+        result.still = path(theme + QLatin1String("-darker"));
+    }
+    if (result.still.isEmpty()) {
+        result.still = path(theme);
+    }
+    if (!result.still.isEmpty()) {
+        const QFileInfo info(result.still);
+        result.loop = info.dir().filePath(info.completeBaseName() + (vector ? QLatin1String(".loop.svg") : QLatin1String(".loop.jxl")));
+        result.animateOnHover = weather.readEntry("Animation", true);
+    }
+    return result;
+}
+
+QPair<QImage, QImage> KIconLoader::readWeatherIcon(const QString &path) const
+{
+    if (path.isEmpty()) {
+        return {};
+    }
+    const auto pair = Stereo::Picture::load(path, {}, Stereo::OutputMode::Stereo);
+    return {pair.left, pair.right};
+}
