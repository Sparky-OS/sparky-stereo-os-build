-// The eye the loads of one drawing are made for
+// The eye the loads of one drawing are made for. On the gui thread the drawing also says whether
+// the icon has a stereo picture: each such drawing, in either eye or plain outside an eye pass,
+// adds one to the application's _q_stereo_icons_drawn, so that what draws windows once per eye
+// (the KDE platform theme, an item in Qt Quick) learns which windows show such icons.
 class StereoEyeScope
 {
 public:
     explicit StereoEyeScope(int eye)
         : m_previous(KIconLoaderPrivate::stereoEye())
+        , m_previousProbe(KIconLoaderPrivate::stereoProbe())
+        , m_probe(onGuiThread())
     {
         KIconLoaderPrivate::setStereoEye(eye);
+        KIconLoaderPrivate::setStereoProbe(m_probe);
+        KIconLoaderPrivate::setStereoDrawn(false);
     }
     ~StereoEyeScope()
     {
+        const bool drawn = m_probe && KIconLoaderPrivate::stereoDrawn();
         KIconLoaderPrivate::setStereoEye(m_previous);
+        KIconLoaderPrivate::setStereoProbe(m_previousProbe);
+        KIconLoaderPrivate::setStereoDrawn(false);
+        if (drawn) {
+            QCoreApplication *application = QCoreApplication::instance();
+            application->setProperty("_q_stereo_icons_drawn", application->property("_q_stereo_icons_drawn").toULongLong() + 1);
+        }
     }
     StereoEyeScope(const StereoEyeScope &) = delete;
     StereoEyeScope &operator=(const StereoEyeScope &) = delete;
 
 private:
     const int m_previous;
+    const bool m_previousProbe;
+    const bool m_probe;
 };
 
