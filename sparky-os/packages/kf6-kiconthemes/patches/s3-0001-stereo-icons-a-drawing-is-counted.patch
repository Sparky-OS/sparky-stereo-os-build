+    void drawingAStereoIconIsCounted()
+    {
+        // Each drawing of an icon the theme has in stereo adds one to the application's _q_stereo_icons_drawn, in an
+        // eye pass and outside one; a plain icon, and a load that is no drawing by the engine, adds nothing
+        const auto drawn = [] {
+            return qApp->property("_q_stereo_icons_drawn").toULongLong();
+        };
+        const QIcon pair(new KIconEngine(QStringLiteral("test-pair"), KIconLoader::global()));
+        const QIcon plain(new KIconEngine(QStringLiteral("test-plain"), KIconLoader::global()));
+        const auto before = drawn();
+        QCOMPARE(middle(pair.pixmap(QSize(32, 32))), QColor(Qt::blue));
+        QCOMPARE(drawn(), before + 1);
+        QCOMPARE(middle(pair.pixmap(QSize(32, 32))), QColor(Qt::blue));
+        QCOMPARE(drawn(), before + 2);
+        QCOMPARE(middle(plain.pixmap(QSize(32, 32))), QColor(Qt::yellow));
+        QCOMPARE(drawn(), before + 2);
+        qApp->setProperty("_q_stereo_icon_eye", 2);
+        QCOMPARE(middle(pair.pixmap(QSize(32, 32))), QColor(Qt::green));
+        QCOMPARE(drawn(), before + 3);
+        QCOMPARE(middle(plain.pixmap(QSize(32, 32))), QColor(Qt::yellow));
+        QCOMPARE(drawn(), before + 3);
+        qApp->setProperty("_q_stereo_icon_eye", QVariant());
+        KIconLoader::global()->loadIcon(QStringLiteral("test-pair"), KIconLoader::Desktop, 32);
+        QCOMPARE(drawn(), before + 3);
+    }
+
+    void aThemeWithoutStereoFoldersCountsNothing()
+    {
+        KIconTheme::forceThemeForTests(QStringLiteral("fakeplain"));
+        KIconLoader::global()->reconfigure(QString());
+        const auto guard = qScopeGuard([] {
+            KIconTheme::forceThemeForTests(QStringLiteral("fakepair"));
+            KIconLoader::global()->reconfigure(QString());
+        });
+        const auto before = qApp->property("_q_stereo_icons_drawn").toULongLong();
+        const QIcon icon(new KIconEngine(QStringLiteral("test-pair"), KIconLoader::global()));
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::blue));
+        QCOMPARE(qApp->property("_q_stereo_icons_drawn").toULongLong(), before);
+    }
