+
+bool KIconLoaderPrivate::hasStereoPicture(const QString &name, const QSize &size, qreal scale, const QString &key)
+{
+    if (!mHasStereoFolders) {
+        return false;
+    }
+    const QString probeKey = key + QLatin1String("_stereo-probe");
+    QPixmap none;
+    QString path;
+    if (!findCachedPixmapWithPath(probeKey, none, path)) {
+        // An empty path records an icon without a stereo picture
+        path = findStereoIconPath(name, std::min(size.width(), size.height()), scale);
+        insertCachedPixmapWithPath(probeKey, QPixmap(), path);
+    }
+    return !path.isEmpty();
+}
 
