+class WeatherSettings
+{
+public:
+    WeatherSettings()
+    {
+        const auto changed = [this] {
+            reload();
+            Q_EMIT KIconLoader::global()->weatherSettingsChanged();
+        };
+        QObject::connect(&watcher, &QFileSystemWatcher::fileChanged, &watcher, changed);
+        QObject::connect(&watcher, &QFileSystemWatcher::directoryChanged, &watcher, [this, changed] {
+            if (updateWatches()) {
+                changed();
+            }
+        });
+        reload();
+    }
+
+    const KIconTheme &theme(const QString &name)
+    {
+        auto &entry = themes[name];
+        if (!entry) {
+            entry = std::make_unique<KIconTheme>(name);
+        }
+        return *entry;
+    }
+
+    QString look;
+    bool coloured = true;
+    bool darker = false;
+    bool animation = true;
+
+private:
+    struct Entry {
+        const char *key;
+        QString fallback;
+        QStringList valid;
+    };
+
+    QString read(const KConfigGroup &group, const Entry &entry, const QString &source = {})
+    {
+        const auto value = group.readEntry(entry.key, entry.fallback);
+        if (value == entry.fallback || entry.valid.contains(value)) {
+            return value;
+        }
+
+        if (!source.isEmpty()) {
+            const QString setting = QString::fromLatin1(entry.key) + QLatin1Char('=') + value;
+            const auto warning = qMakePair(source, setting);
+            if (!warnings.contains(warning)) {
+                warnings.insert(warning);
+                qCWarning(KICONTHEMES).noquote() << "Invalid weather setting" << setting << "in" << source
+                                                 << "Valid values:" << entry.valid.join(QLatin1String(", "))
+                                                 << "Default:" << (entry.fallback.isEmpty() ? QStringLiteral("(unset)") : entry.fallback);
+            }
+        }
+        return entry.fallback;
+    }
+
+    bool updateWatches()
+    {
+        QSet<QString> paths;
+        for (const auto &root : roots) {
+            const QDir directory(root);
+            const auto file = directory.filePath(name);
+            if (QFileInfo::exists(file)) {
+                paths.insert(file);
+            }
+
+            QDir ancestor = directory;
+            while (!ancestor.exists() && ancestor.cdUp()) {
+            }
+            if (ancestor.exists()) {
+                paths.insert(ancestor.absolutePath());
+            }
+        }
+
+        const auto watched = watcher.files() + watcher.directories();
+        const QSet<QString> current(watched.cbegin(), watched.cend());
+        const auto removed = (current - paths).values();
+        const auto added = (paths - current).values();
+        if (!removed.isEmpty()) {
+            watcher.removePaths(removed);
+        }
+        if (!added.isEmpty()) {
+            watcher.addPaths(added);
+        }
+        return !removed.isEmpty() || !added.isEmpty();
+    }
+
+    void reload()
+    {
+        static const std::array entries{
+            Entry{"Look", QStringLiteral("Auto"),
+                  {QStringLiteral("Auto"), QStringLiteral("IconTheme"), QStringLiteral("Vector"),
+                   QStringLiteral("Photoreal"), QStringLiteral("RealWeather")}},
+            Entry{"HardwareLook", {}, {QStringLiteral("Photoreal"), QStringLiteral("RealWeather")}},
+            Entry{"PanelIcon", QStringLiteral("Colour"), {QStringLiteral("Colour"), QStringLiteral("OneColour")}},
+            Entry{"Shade", QStringLiteral("Present"), {QStringLiteral("Present"), QStringLiteral("Darker")}},
+            Entry{"Animation", QStringLiteral("true"), {QStringLiteral("true"), QStringLiteral("false")}},
+        };
+        updateWatches();
+
+        // Check each file for diagnostics, including entries masked by a higher priority source.
+        for (const auto &root : roots) {
+            const auto file = QDir(root).filePath(name);
+            if (QFileInfo::exists(file)) {
+                const KConfig source(file, KConfig::SimpleConfig);
+                const KConfigGroup group(&source, QStringLiteral("Weather"));
+                for (const auto &entry : entries) {
+                    read(group, entry, file);
+                }
+            }
+        }
+
+        const KConfig merged(name, KConfig::NoGlobals);
+        const KConfigGroup weather(&merged, QStringLiteral("Weather"));
+        look = read(weather, entries[0]);
+        if (look == QLatin1String("Auto")) {
+            look = read(weather, entries[1]);
+        }
+        coloured = read(weather, entries[2]) == QLatin1String("Colour");
+        darker = read(weather, entries[3]) == QLatin1String("Darker");
+        animation = read(weather, entries[4]) == QLatin1String("true");
+    }
+
+    const QString name = QStringLiteral("sparky-stereo-weatherrc");
+    const QStringList roots = QStandardPaths::standardLocations(QStandardPaths::GenericConfigLocation);
+    QFileSystemWatcher watcher;
+    QSet<QPair<QString, QString>> warnings;
+    std::map<QString, std::unique_ptr<KIconTheme>> themes;
+};
+}
