+namespace
+{
+class WeatherSettings
+{
+public:
+    WeatherSettings()
+    {
+        const auto changed = [this] {
+            reload();
+            Q_EMIT KIconLoader::global()->weatherSettingsChanged();
+        };
+        QObject::connect(&watcher, &QFileSystemWatcher::fileChanged, &watcher, changed);
+        QObject::connect(&watcher, &QFileSystemWatcher::directoryChanged, &watcher, [this, changed] {
+            if (watcher.files().isEmpty() && QFileInfo::exists(file)) {
+                changed();
+            }
+        });
+        watcher.addPath(QFileInfo(file).absolutePath());
+        reload();
+    }
+
+    const KIconTheme &theme(const QString &name)
+    {
+        auto &entry = themes[name];
+        if (!entry) {
+            entry = std::make_unique<KIconTheme>(name);
+        }
+        return *entry;
+    }
+
+    QString look;
+    bool coloured = true;
+    bool darker = false;
+    bool animation = true;
+
+private:
+    QString read(const KConfigGroup &group, const char *key, const QString &fallback, const QStringList &valid)
+    {
+        const auto value = group.readEntry(key, fallback);
+        if (value == fallback || valid.contains(value)) {
+            return value;
+        }
+        const QString warning = QString::fromLatin1(key) + QLatin1Char('=') + value;
+        if (!warnings.contains(warning)) {
+            warnings.insert(warning);
+            qCWarning(KICONTHEMES).noquote() << "Invalid weather setting" << warning << "Valid values:" << valid.join(QLatin1String(", "))
+                                             << "Default:" << (fallback.isEmpty() ? QStringLiteral("(unset)") : fallback);
+        }
+        return fallback;
+    }
+
+    void reload()
+    {
+        if (QFileInfo::exists(file) && !watcher.files().contains(file)) {
+            watcher.addPath(file);
+        }
+        const KConfig config(file, KConfig::SimpleConfig);
+        const KConfigGroup group(&config, QStringLiteral("Weather"));
+        look = read(group, "Look", QStringLiteral("Auto"), {QStringLiteral("Auto"), QStringLiteral("IconTheme"),
+                    QStringLiteral("Vector"), QStringLiteral("Photoreal"), QStringLiteral("RealWeather")});
+        const auto hardware = read(group, "HardwareLook", {}, {QStringLiteral("Photoreal"), QStringLiteral("RealWeather")});
+        if (look == QLatin1String("Auto")) {
+            look = hardware;
+        }
+        coloured = read(group, "PanelIcon", QStringLiteral("Colour"),
+                        {QStringLiteral("Colour"), QStringLiteral("OneColour")}) == QLatin1String("Colour");
+        darker = read(group, "Shade", QStringLiteral("Present"),
+                      {QStringLiteral("Present"), QStringLiteral("Darker")}) == QLatin1String("Darker");
+        animation = read(group, "Animation", QStringLiteral("true"),
+                         {QStringLiteral("true"), QStringLiteral("false")}) == QLatin1String("true");
+    }
+
+    const QString file = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/sparky-stereo-weatherrc");
+    QFileSystemWatcher watcher;
+    QSet<QString> warnings;
+    std::map<QString, std::unique_ptr<KIconTheme>> themes;
+};
+}
