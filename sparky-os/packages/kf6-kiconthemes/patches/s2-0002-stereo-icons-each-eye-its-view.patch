 #include <QPainter>
+#include <QThread>
+#include <QWindow>
 #include <qscopeguard.h>
 
+// The eye a window drawn once per eye is painted for, from its _q_stereo_eye: 1 the left eye, 2 the right eye, else 0
+static int windowEye(const QWindow *window)
+{
+    const int eye = window ? window->property("_q_stereo_eye").toInt() : 0;
+    return eye == 1 || eye == 2 ? eye : 0;
+}
+
+// The eye an icon is drawn for. Qt draws a window once per eye while it shows depth inside it, and says which eye
+// it draws; then an icon the theme has in stereo gives that eye's view. Everywhere else it is 0: the plain icon.
+static int paintedEye()
+{
+    const auto *application = qobject_cast<QGuiApplication *>(QCoreApplication::instance());
+    if (!application || QThread::currentThread() != application->thread()) {
+        return 0;
+    }
+    // An item that draws itself once per eye (an icon in Qt Quick) names the eye it asks for while it asks
+    const int asked = application->property("_q_stereo_icon_eye").toInt();
+    if (asked == 1 || asked == 2) {
+        return asked;
+    }
+    // A widget drawing an icon while its window is painted: Qt Widgets sets a window's eye only while it paints
+    // that eye, one window at a time, so the window with an eye now is the one being painted
+    const auto windows = QGuiApplication::topLevelWindows();
+    for (const QWindow *window : windows) {
+        if (window->inherits("QWidgetWindow")) {
+            if (const int eye = windowEye(window)) {
+                return eye;
+            }
+        }
+    }
+    return 0;
+}
+
+// The eye the loads of one drawing are made for
+class StereoEyeScope
+{
+public:
+    explicit StereoEyeScope(int eye)
+        : m_previous(KIconLoaderPrivate::stereoEye())
+    {
+        KIconLoaderPrivate::setStereoEye(eye);
+    }
+    ~StereoEyeScope()
+    {
+        KIconLoaderPrivate::setStereoEye(m_previous);
+    }
+    StereoEyeScope(const StereoEyeScope &) = delete;
+    StereoEyeScope &operator=(const StereoEyeScope &) = delete;
+
+private:
+    const int m_previous;
+};
