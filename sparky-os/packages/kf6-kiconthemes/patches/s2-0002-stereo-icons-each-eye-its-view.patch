 // Finds the absolute path to an icon.
 
+QString KIconLoaderPrivate::findStereoIconPath(const QString &name, int size, qreal scale) const
+{
+    for (KIconThemeNode *themeNode : std::as_const(links)) {
+        const QString path = themeNode->theme->stereoIconPathByName(name, size, KIconLoader::MatchBest, scale);
+        if (!path.isEmpty() || !themeNode->theme->iconPathByName(name, size, KIconLoader::MatchBest, scale).isEmpty()) {
+            return path;
+        }
+    }
+    return QString();
+}
+
+static thread_local int t_stereoEye = 0;
+
+int KIconLoaderPrivate::stereoEye()
+{
+    return t_stereoEye;
+}
+
+void KIconLoaderPrivate::setStereoEye(int eye)
+{
+    t_stereoEye = eye;
+}
+
+bool KIconLoaderPrivate::loadStereoView(const QString &name,
+                                        KIconLoader::Group group,
+                                        qreal scale,
+                                        const QSize &size,
+                                        int state,
+                                        const QStringList &overlays,
+                                        int eye,
+                                        const QString &key,
+                                        QPixmap *view,
+                                        QString *path)
+{
+    const QString eyeKey = key + (eye == 1 ? QLatin1String("_stereo-left") : QLatin1String("_stereo-right"));
+    if (findCachedPixmapWithPath(eyeKey, *view, *path)) {
+        // An empty path records an icon without a stereo picture
+        return !path->isEmpty();
+    }
+
+    QImage image;
+    const QString stereoPath = findStereoIconPath(name, std::min(size.width(), size.height()), scale);
+    if (!stereoPath.isEmpty()) {
+        // Both views side by side, left view first, read at twice the width of one view; the eye keeps its half
+        const QSize pixels = (QSizeF(size) * scale).toSize();
+        QImageReader reader(stereoPath);
+        reader.setScaledSize(QSize(pixels.width() * 2, pixels.height()));
+        const QImage picture = reader.read();
+        if (picture.isNull()) {
+            qCWarning(KICONTHEMES) << "Could not read the stereo icon" << stereoPath << reader.errorString();
+        } else {
+            const int width = picture.width() / 2;
+            image = picture.copy(eye == 1 ? 0 : width, 0, width, picture.height());
+        }
+    }
+    if (image.isNull()) {
+        insertCachedPixmapWithPath(eyeKey, QPixmap(), QString());
+        return false;
+    }
+
+    // The effects of the plain icon (see makeCacheKey), then its overlays, over each view
+    if ((group == KIconLoader::Desktop || group == KIconLoader::Panel) && state == KIconLoader::ActiveState) {
+        KIconEffect::toActive(image);
+    }
+    if (state == KIconLoader::DisabledState && group >= 0 && group < KIconLoader::LastGroup) {
+        KIconEffect::toDisabled(image);
+    }
+    *view = QPixmap::fromImage(std::move(image));
+    view->setDevicePixelRatio(scale);
+    drawOverlays(q, group, state, *view, overlays);
+    *path = stereoPath;
+    insertCachedPixmapWithPath(eyeKey, *view, stereoPath);
+    return true;
+}
