+// Qt draws a window once per eye while it shows depth inside it, naming the eye on the window (_q_stereo_eye); an
+// icon the theme has in stereo then gives that eye's view through QIcon, and the plain icon everywhere else. A stereo
+// folder the loader refuses is told to the theme's author, with the file, the section and the key.
+class KIconEngineStereoTest : public QObject
+{
+    Q_OBJECT
+
+private:
+    QDir m_iconsDir;
+
+    void writeFile(const QString &path, const QByteArray &contents)
+    {
+        QVERIFY(m_iconsDir.mkpath(QFileInfo(m_iconsDir.filePath(path)).path()));
+        QFile file(m_iconsDir.filePath(path));
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write(contents);
+    }
+
+    void writePicture(const QString &path, const QSize &size, const QColor &first, const QColor &second = QColor())
+    {
+        QImage image(size, QImage::Format_ARGB32);
+        image.fill(first);
+        if (second.isValid()) {
+            QPainter painter(&image);
+            painter.fillRect(size.width() / 2, 0, size.width() / 2, size.height(), second);
+        }
+        QVERIFY(m_iconsDir.mkpath(QFileInfo(m_iconsDir.filePath(path)).path()));
+        QVERIFY(image.save(m_iconsDir.filePath(path)));
+    }
+
+    static QColor middle(const QPixmap &pixmap)
+    {
+        const QImage image = pixmap.toImage();
+        return image.pixelColor(image.width() / 2, image.height() / 2);
+    }
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        QStandardPaths::setTestModeEnabled(true);
+        m_iconsDir = QDir(QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/icons"));
+        QVERIFY(m_iconsDir.absolutePath().contains(QLatin1String("qttest")));
+        m_iconsDir.removeRecursively();
+
+        // The plain icon is blue; its stereo picture has a red left view and a green right view
+        writeFile(QStringLiteral("fakepair/index.theme"),
+                  "[Icon Theme]\nName=Fake pair\nDirectories=32x32/places\nX-StereoDirectories=stereo/32x32/places\n\n"
+                  "[32x32/places]\nSize=32\nContext=Places\nType=Fixed\n\n"
+                  "[stereo/32x32/places]\nX-StereoSize=32\nContext=Places\nType=Fixed\nX-StereoLayout=sbs-left-first\n");
+        writePicture(QStringLiteral("fakepair/32x32/places/test-pair.png"), QSize(32, 32), Qt::blue);
+        writePicture(QStringLiteral("fakepair/32x32/places/test-plain.png"), QSize(32, 32), Qt::yellow);
+        writePicture(QStringLiteral("fakepair/stereo/32x32/places/test-pair.png"), QSize(64, 32), Qt::red, Qt::green);
+
+        // Stereo folders the loader refuses, and one it reads
+        writeFile(QStringLiteral("fakerefused/index.theme"),
+                  "[Icon Theme]\nName=Fake refused\nDirectories=32x32/places\n"
+                  "X-StereoDirectories=stereo/nolayout,stereo/toptobottom,stereo/nosize,stereo/zerosize,stereo/good\n\n"
+                  "[32x32/places]\nSize=32\nContext=Places\nType=Fixed\n\n"
+                  "[stereo/nolayout]\nX-StereoSize=32\nContext=Places\nType=Fixed\n\n"
+                  "[stereo/toptobottom]\nX-StereoSize=32\nContext=Places\nType=Fixed\nX-StereoLayout=tb-left-first\n\n"
+                  "[stereo/nosize]\nContext=Places\nType=Fixed\nX-StereoLayout=sbs-left-first\n\n"
+                  "[stereo/zerosize]\nX-StereoSize=0\nContext=Places\nType=Fixed\nX-StereoLayout=sbs-left-first\n\n"
+                  "[stereo/good]\nX-StereoSize=32\nContext=Places\nType=Fixed\nX-StereoLayout=sbs-left-first\n");
+        for (const QString &folder : {QStringLiteral("32x32/places"),
+                                      QStringLiteral("stereo/nolayout"),
+                                      QStringLiteral("stereo/toptobottom"),
+                                      QStringLiteral("stereo/nosize"),
+                                      QStringLiteral("stereo/zerosize"),
+                                      QStringLiteral("stereo/good")}) {
+            QVERIFY(m_iconsDir.mkpath(QStringLiteral("fakerefused/") + folder));
+        }
+
+        KIconTheme::forceThemeForTests(QStringLiteral("fakepair"));
+        KIconLoader::global()->reconfigure(QString());
+        QVERIFY(KIconLoader::global()->theme()->isValid());
+    }
+
+    void refusedStereoFoldersAreTold()
+    {
+        const QString file = QRegularExpression::escape(m_iconsDir.filePath(QStringLiteral("fakerefused/index.theme")));
+        const auto told = [&file](const QString &folder, const QString &why) {
+            return QRegularExpression(QStringLiteral("^The icon theme file %1 lists the stereo folder %2 in X-StereoDirectories, but the loader does not use "
+                                                     "it: its section \\[%2\\] %3")
+                                          .arg(file, QRegularExpression::escape(folder), why));
+        };
+        QTest::ignoreMessage(QtWarningMsg, told(QStringLiteral("stereo/nolayout"), QStringLiteral("has no X-StereoLayout key; add X-StereoLayout=sbs-left-first")));
+        QTest::ignoreMessage(QtWarningMsg,
+                             told(QStringLiteral("stereo/toptobottom"),
+                                  QStringLiteral("has X-StereoLayout=tb-left-first, which is not a layout the loader reads; the one layout is "
+                                                 "X-StereoLayout=sbs-left-first")));
+        QTest::ignoreMessage(QtWarningMsg, told(QStringLiteral("stereo/nosize"), QStringLiteral("has no X-StereoSize key; give the size of one view")));
+        QTest::ignoreMessage(QtWarningMsg, told(QStringLiteral("stereo/zerosize"), QStringLiteral("has X-StereoSize=0, which is not a size in pixels")));
+        QTest::failOnWarning(QRegularExpression(QStringLiteral("stereo/good")));
+        const KIconTheme theme(QStringLiteral("fakerefused"));
+        QVERIFY(theme.isValid());
+    }
+
+    void plainOutsideAnEyePass()
+    {
+        const QIcon icon(new KIconEngine(QStringLiteral("test-pair"), KIconLoader::global()));
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::blue));
+        QImage image(32, 32, QImage::Format_ARGB32_Premultiplied);
+        image.fill(Qt::transparent);
+        QPainter painter(&image);
+        icon.paint(&painter, image.rect());
+        painter.end();
+        QCOMPARE(image.pixelColor(16, 16), QColor(Qt::blue));
+    }
+
+    void eachEyeOfAWidgetWindow()
+    {
+        const QIcon icon(new KIconEngine(QStringLiteral("test-pair"), KIconLoader::global()));
+        const QIcon plain(new KIconEngine(QStringLiteral("test-plain"), KIconLoader::global()));
+        QWidget widget;
+        widget.resize(64, 64);
+        widget.winId();
+        QWindow *window = widget.windowHandle();
+        QVERIFY(window);
+
+        window->setProperty("_q_stereo_eye", 1);
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::red));
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32), 1.25)), QColor(Qt::red));
+        QCOMPARE(middle(icon.pixmap(QSize(16, 16))), QColor(Qt::red));
+        // An icon without a stereo picture is the plain icon in both eyes
+        QCOMPARE(middle(plain.pixmap(QSize(32, 32))), QColor(Qt::yellow));
+        // A disabled icon gets the plain icon's effect over the eye's view
+        QVERIFY(middle(icon.pixmap(QSize(32, 32), QIcon::Disabled)) != middle(icon.pixmap(QSize(32, 32))));
+
+        window->setProperty("_q_stereo_eye", 2);
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::green));
+        QImage image(32, 32, QImage::Format_ARGB32_Premultiplied);
+        image.fill(Qt::transparent);
+        QPainter painter(&image);
+        icon.paint(&painter, image.rect());
+        painter.end();
+        QCOMPARE(image.pixelColor(16, 16), QColor(Qt::green));
+
+        window->setProperty("_q_stereo_eye", 0);
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::blue));
+    }
+
+    void anItemNamesTheEyeItAsksFor()
+    {
+        const QIcon icon(new KIconEngine(QStringLiteral("test-pair"), KIconLoader::global()));
+        qApp->setProperty("_q_stereo_icon_eye", 2);
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::green));
+        qApp->setProperty("_q_stereo_icon_eye", 1);
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::red));
+        qApp->setProperty("_q_stereo_icon_eye", QVariant());
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::blue));
+    }
+
+    void otherWindowsDoNotChooseAnEye()
+    {
+        // Only a widget window says which eye it paints while it paints; a Qt Quick window's item names its eye itself
+        const QIcon icon(new KIconEngine(QStringLiteral("test-pair"), KIconLoader::global()));
+        QWindow window;
+        window.setProperty("_q_stereo_eye", 1);
+        QCOMPARE(middle(icon.pixmap(QSize(32, 32))), QColor(Qt::blue));
+    }
+};
+
+QTEST_MAIN(KIconEngineStereoTest)
+
