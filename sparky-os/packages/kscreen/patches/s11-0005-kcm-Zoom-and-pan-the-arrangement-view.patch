From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sun, 1 Nov 2026 01:31:04 -0300
Subject: [PATCH] kcm: Zoom and pan the arrangement view

The arrangement view always fits every screen into itself, so with a
large and a small screen, or a long row of them, each screen is a few
pixels tall and hard to place exactly.

The view now zooms with the wheel while Ctrl is held, around the point
under the pointer, between a quarter and sixteen times the size at which
everything fits. Dragging its empty part with the left button, or any
part with the middle button, pans it. A View menu next to Edit
Arrangement has Zoom In, Zoom Out and Fit All, which brings back the view
where every screen fits. Zooming and panning only change the view: the
screens keep their places, and dragging a screen still moves it.

wdisplays, the wlroots display tool, has the same controls.

Assisted-by: Claude Opus 5.5
---
 kcm/ui/ScreenView.qml | 76 +++++++++++++++++++++++++++++++++++++++++--
 kcm/ui/main.qml       | 48 +++++++++++++++++++++++++++
 2 files changed, 121 insertions(+), 3 deletions(-)

diff --git a/kcm/ui/ScreenView.qml b/kcm/ui/ScreenView.qml
index 6f282e36..61993c2d 100644
--- a/kcm/ui/ScreenView.qml
+++ b/kcm/ui/ScreenView.qml
@@ -23,7 +23,8 @@ QQC2.ScrollView {
     onWidthChanged: resetTotalSize()
     onHeightChanged: resetTotalSize()
 
-    readonly property real relativeFactor: {
+    // The factor at which every screen fits into the view
+    readonly property real fitFactor: {
         const relativeSize = Qt.size(
             totalSize.width / (0.6 * width),
             totalSize.height / (0.65 * height),
@@ -37,8 +38,77 @@ QQC2.ScrollView {
         }
     }
 
-    readonly property int xOffset: (width - totalSize.width / relativeFactor) / 2;
-    readonly property int yOffset: (height - totalSize.height / relativeFactor) / 2;
+    // 1 shows every screen; the view pans by pan, in view pixels
+    property real zoom: 1
+    property point pan: Qt.point(0, 0)
+    readonly property real minimumZoom: 0.25
+    readonly property real maximumZoom: 16
+    readonly property bool zoomed: zoom !== 1 || pan.x !== 0 || pan.y !== 0
+
+    readonly property real relativeFactor: fitFactor / zoom
+
+    readonly property int xOffset: (width - totalSize.width / relativeFactor) / 2 + pan.x;
+    readonly property int yOffset: (height - totalSize.height / relativeFactor) / 2 + pan.y;
+
+    // Zooms by factor, keeping the point of the arrangement under viewPoint where it is
+    function zoomAt(viewPoint, factor) {
+        const newZoom = Math.min(maximumZoom, Math.max(minimumZoom, zoom * factor));
+        if (newZoom === zoom) {
+            return;
+        }
+        const arrangementX = (viewPoint.x - xOffset) * relativeFactor;
+        const arrangementY = (viewPoint.y - yOffset) * relativeFactor;
+        const newFactor = fitFactor / newZoom;
+        pan = Qt.point(viewPoint.x - arrangementX / newFactor - (width - totalSize.width / newFactor) / 2,
+                       viewPoint.y - arrangementY / newFactor - (height - totalSize.height / newFactor) / 2);
+        zoom = newZoom;
+    }
+
+    function zoomIn() {
+        zoomAt(Qt.point(width / 2, height / 2), 1.25);
+    }
+
+    function zoomOut() {
+        zoomAt(Qt.point(width / 2, height / 2), 0.8);
+    }
+
+    function fitAll() {
+        zoom = 1;
+        pan = Qt.point(0, 0);
+        resetTotalSize();
+    }
+
+    clip: true
+
+    WheelHandler {
+        acceptedModifiers: Qt.ControlModifier
+        onWheel: event => {
+            const steps = event.angleDelta.y / 120;
+            if (steps !== 0) {
+                screenView.zoomAt(point.position, Math.pow(1.25, steps));
+            }
+        }
+    }
+
+    // Drag the empty arrangement, or anywhere with the middle button, to pan
+    DragHandler {
+        id: panHandler
+        property point panStart
+        target: null
+        acceptedButtons: Qt.LeftButton | Qt.MiddleButton
+        grabPermissions: PointerHandler.CanTakeOverFromAnything | PointerHandler.TakeOverForbidden
+        cursorShape: active ? Qt.ClosedHandCursor : Qt.ArrowCursor
+        onActiveChanged: {
+            if (active) {
+                panStart = screenView.pan;
+            }
+        }
+        onTranslationChanged: {
+            if (active) {
+                screenView.pan = Qt.point(panStart.x + translation.x, panStart.y + translation.y);
+            }
+        }
+    }
 
     Kirigami.Heading {
         id: dragHint
diff --git a/kcm/ui/main.qml b/kcm/ui/main.qml
index 518d1388..11600bc9 100644
--- a/kcm/ui/main.qml
+++ b/kcm/ui/main.qml
@@ -390,6 +390,54 @@ KCM.AbstractKCM {
                 interactive: false
             }
 
+            QQC2.ToolButton {
+                id: screenViewOptions
+                anchors.left: parent.left
+                anchors.bottom: parent.bottom
+                anchors.margins: Kirigami.Units.smallSpacing
+
+                enabled: kcm.outputModel && kcm.backendReady
+
+                Accessible.description: text
+                text: i18nc("@action:button Options of the view that shows the arrangement of the screens", "View")
+                icon.name: "view-visible"
+                down: pressed || viewMenu.visible
+
+                onClicked: viewMenu.popup(screenViewOptions, 0, screenViewOptions.height)
+
+                QQC2.Menu {
+                    id: viewMenu
+
+                    QQC2.MenuItem {
+                        action: QQC2.Action {
+                            objectName: "zoomInAction"
+                            text: i18nc("@action:inmenu Magnify the view of the screen arrangement", "Zoom In")
+                            icon.name: "zoom-in"
+                            enabled: screen.zoom < screen.maximumZoom
+                            onTriggered: screen.zoomIn()
+                        }
+                    }
+                    QQC2.MenuItem {
+                        action: QQC2.Action {
+                            objectName: "zoomOutAction"
+                            text: i18nc("@action:inmenu Make the view of the screen arrangement smaller", "Zoom Out")
+                            icon.name: "zoom-out"
+                            enabled: screen.zoom > screen.minimumZoom
+                            onTriggered: screen.zoomOut()
+                        }
+                    }
+                    QQC2.MenuItem {
+                        action: QQC2.Action {
+                            objectName: "fitAllAction"
+                            text: i18nc("@action:inmenu Zoom and move the view so that every screen is shown", "Fit All")
+                            icon.name: "zoom-fit-best"
+                            enabled: screen.zoomed
+                            onTriggered: screen.fitAll()
+                        }
+                    }
+                }
+            }
+
             QQC2.ToolButton {
                 id: screenEdit
                 anchors.right: parent.right
-- 
