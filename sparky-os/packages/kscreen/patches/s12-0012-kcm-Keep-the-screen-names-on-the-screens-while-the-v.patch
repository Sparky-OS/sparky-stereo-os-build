diff --git a/kcm/viewoptions.cpp b/kcm/viewoptions.cpp
new file mode 100644
index 00000000..c4c0c0ca
--- /dev/null
+++ b/kcm/viewoptions.cpp
@@ -0,0 +1,112 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "viewoptions.h"
+
+#include <KConfigGroup>
+#include <KSharedConfig>
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+
+using namespace Qt::StringLiterals;
+
+static const QString s_configFile = u"kcm_kscreenrc"_s;
+static const QString s_configGroup = u"ArrangementView"_s;
+static const QString s_namesKey = u"ShowScreenNames"_s;
+static const QString s_wheelKey = u"WheelPans"_s;
+
+static const QString s_locatorService = u"org.kde.KWin"_s;
+static const QString s_locatorPath = u"/org/kde/KWin/Effect/OutputLocator1"_s;
+static const QString s_locatorInterface = u"org.kde.KWin.Effect.OutputLocator1"_s;
+
+ViewOptions::ViewOptions(QObject *parent)
+    : QObject(parent)
+{
+    const KConfigGroup group = KSharedConfig::openConfig(s_configFile)->group(s_configGroup);
+    m_showScreenNames = group.readEntry(s_namesKey, false);
+    m_wheelPans = group.readEntry(s_wheelKey, false);
+
+    m_timer.setInterval(refreshInterval);
+    connect(&m_timer, &QTimer::timeout, this, [this]() {
+        sendToKWin(u"show"_s);
+    });
+}
+
+ViewOptions::~ViewOptions()
+{
+    if (m_shown) {
+        sendToKWin(u"hide"_s);
+    }
+}
+
+bool ViewOptions::showScreenNames() const
+{
+    return m_showScreenNames;
+}
+
+void ViewOptions::setShowScreenNames(bool show)
+{
+    if (m_showScreenNames == show) {
+        return;
+    }
+    m_showScreenNames = show;
+    KConfigGroup group = KSharedConfig::openConfig(s_configFile)->group(s_configGroup);
+    group.writeEntry(s_namesKey, show);
+    group.sync();
+    Q_EMIT showScreenNamesChanged();
+    updateNames();
+}
+
+bool ViewOptions::wheelPans() const
+{
+    return m_wheelPans;
+}
+
+void ViewOptions::setWheelPans(bool pans)
+{
+    if (m_wheelPans == pans) {
+        return;
+    }
+    m_wheelPans = pans;
+    KConfigGroup group = KSharedConfig::openConfig(s_configFile)->group(s_configGroup);
+    group.writeEntry(s_wheelKey, pans);
+    group.sync();
+    Q_EMIT wheelPansChanged();
+}
+
+bool ViewOptions::isActive() const
+{
+    return m_active;
+}
+
+void ViewOptions::setActive(bool active)
+{
+    if (m_active == active) {
+        return;
+    }
+    m_active = active;
+    Q_EMIT activeChanged();
+    updateNames();
+}
+
+void ViewOptions::updateNames()
+{
+    const bool wanted = m_showScreenNames && m_active;
+    if (wanted && !m_timer.isActive()) {
+        m_timer.start();
+        m_shown = true;
+        sendToKWin(u"show"_s);
+    } else if (!wanted && m_timer.isActive()) {
+        m_timer.stop();
+        m_shown = false;
+        sendToKWin(u"hide"_s);
+    }
+}
+
+void ViewOptions::sendToKWin(const QString &method)
+{
+    QDBusConnection::sessionBus().send(QDBusMessage::createMethodCall(s_locatorService, s_locatorPath, s_locatorInterface, method));
+}
diff --git a/kcm/viewoptions.h b/kcm/viewoptions.h
new file mode 100644
index 00000000..b774caf7
--- /dev/null
+++ b/kcm/viewoptions.h
@@ -0,0 +1,57 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QObject>
+#include <QTimer>
+
+/*
+ * The choices of the arrangement view that the person keeps, in the group ArrangementView of kcm_kscreenrc.
+ *
+ * Show Screen Names keeps the labels of Identify Screens on every screen as long as the view is on screen.
+ * KWin's OutputLocator effect shows them for two and a half seconds, and showing them again extends that,
+ * so they are shown again every two seconds and hidden when the choice is switched off or the view goes.
+ *
+ * The plain wheel pans the view, as it does in wdisplays, instead of doing nothing over it.
+ */
+class ViewOptions : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool showScreenNames READ showScreenNames WRITE setShowScreenNames NOTIFY showScreenNamesChanged)
+    Q_PROPERTY(bool wheelPans READ wheelPans WRITE setWheelPans NOTIFY wheelPansChanged)
+    Q_PROPERTY(bool active READ isActive WRITE setActive NOTIFY activeChanged)
+
+public:
+    explicit ViewOptions(QObject *parent = nullptr);
+    ~ViewOptions() override;
+
+    bool showScreenNames() const;
+    void setShowScreenNames(bool show);
+
+    bool wheelPans() const;
+    void setWheelPans(bool pans);
+
+    // Whether the view is on screen
+    bool isActive() const;
+    void setActive(bool active);
+
+    static constexpr int refreshInterval = 2000;
+
+Q_SIGNALS:
+    void showScreenNamesChanged();
+    void wheelPansChanged();
+    void activeChanged();
+
+private:
+    void updateNames();
+    void sendToKWin(const QString &method);
+
+    QTimer m_timer;
+    bool m_showScreenNames = false;
+    bool m_wheelPans = false;
+    bool m_active = false;
+    bool m_shown = false;
+};
