+#if HAVE_KSCREEN_INTERLACED
+    void interlacedResolutionAndSelection()
+    {
+        const auto progressive = mode("p60", Layout::None, 60, {1920, 1080}, false);
+        const auto interlaced60 = mode("i60", Layout::None, 60, {1920, 1080}, false);
+        interlaced60->setInterlaced(true);
+        const auto interlaced50 = mode("i50", Layout::None, 50, {1920, 1080}, false);
+        interlaced50->setInterlaced(true);
+        const auto packed60 = mode("ifp60", Layout::FramePacking, 60, {1920, 1080}, false);
+        packed60->setInterlaced(true);
+        const auto packed50 = mode("ifp50", Layout::FramePacking, 50, {1920, 1080}, false);
+        packed50->setInterlaced(true);
+        ConfigHandler handler;
+        const auto output = configure(handler, {progressive, interlaced60, interlaced50, packed60, packed50});
+        auto model = handler.outputModel();
+        const auto index = model->indexForOutput(output);
+        const auto resolutions = entries(model, OutputModel::ResolutionsRole);
+        QCOMPARE(resolutions.size(), 2);
+        int interlacedIndex = -1;
+        int progressiveIndex = -1;
+        for (int i = 0; i < resolutions.size(); ++i) {
+            if (resolutions[i].toString().contains(QStringLiteral("1080i"))) {
+                interlacedIndex = i;
+            } else {
+                progressiveIndex = i;
+            }
+        }
+        QVERIFY(interlacedIndex >= 0);
+        QVERIFY(progressiveIndex >= 0);
+        QCOMPARE(model->data(index, OutputModel::ResolutionIndexRole).toInt(), progressiveIndex);
+        QCOMPARE(entries(model, OutputModel::RefreshRatesRole).size(), 1);
+        QVERIFY(model->setData(index, interlacedIndex, OutputModel::ResolutionIndexRole));
+        QVERIFY(output->currentMode()->interlaced());
+        QCOMPARE(model->data(index, OutputModel::ResolutionIndexRole).toInt(), interlacedIndex);
+        const auto rates = entries(model, OutputModel::RefreshRatesRole);
+        QCOMPARE(rates.size(), 4);
+        int packedIndex = -1;
+        for (int i = 0; i < rates.size(); ++i) {
+            const auto text = rates[i].toString();
+            if (text.startsWith(QStringLiteral("60")) && text.contains(QStringLiteral("frame packing"))) {
+                packedIndex = i;
+            }
+        }
+        QVERIFY(packedIndex >= 0);
+        QVERIFY(model->setData(index, packedIndex, OutputModel::RefreshRateIndexRole));
+        QCOMPARE(output->currentModeId(), packed60->id());
+        QVERIFY(output->currentMode()->interlaced());
+        QVERIFY(model->setData(index, progressiveIndex, OutputModel::ResolutionIndexRole));
+        QCOMPARE(output->currentModeId(), progressive->id());
+        QVERIFY(!output->currentMode()->interlaced());
+    }
