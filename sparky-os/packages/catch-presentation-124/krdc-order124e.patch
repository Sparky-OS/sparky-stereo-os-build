+
+void CatchController::stopWaitingScene()
+{
+    if (m_scene) {
+        m_scene->requestInterruption();
+        m_scene->wait();
+        m_scene.reset();
+    }
+    if (m_showingScene && m_view)
+        m_view->setWaitingFrame({});
+    m_showingScene = false;
+}
+
+void CatchController::startWaitingScene(bool reconnect)
+{
+    stopWaitingScene();
+    m_reconnecting = reconnect;
+    if (!m_view || m_scenes.isEmpty())
+        return;
+    QSettings settings;
+    settings.beginGroup(QStringLiteral("headset-fit"));
+    const auto explicitId = settings.value(QStringLiteral("waiting-explicit-scene")).toString();
+    const auto previous = settings.value(QStringLiteral("last-waiting-scene")).toString();
+    const auto selection = std::find_if(m_scenes.cbegin(), m_scenes.cend(), [&explicitId](const auto &scene) { return scene.id == explicitId; });
+    QList<qsizetype> available;
+    for (qsizetype index = 0; index < m_scenes.size(); ++index)
+        if (m_scenes.size() == 1 || m_scenes.at(index).id != previous)
+            available.append(index);
+    const auto scene = selection != m_scenes.cend()
+        ? *selection
+        : m_scenes.at(available.at(QRandomGenerator::global()->bounded(int(available.size()))));
+    settings.setValue(QStringLiteral("last-waiting-scene"), scene.id);
+    const auto caption = reconnect ? i18n("Waiting for the next Throw…") : i18n("Waiting for Throw…");
+    const auto fail = [this, id = scene.id](CatchPresentation::ScenePlayback::Failure reason) {
+        stopWaitingScene();
+        const auto description = reason == CatchPresentation::ScenePlayback::Failure::DecoderUnavailable
+            ? i18n("No hardware video decoder is available.")
+            : i18n("The media must declare left-first side-by-side stereo.");
+        const auto message = i18n("Waiting scene “%1” could not be shown:\n%2", id, description);
+        if (m_view && listening()) {
+            m_showingScene = true;
+            m_view->setWaitingFrame({}, message);
+        }
+        setStatus(message);
+    };
+    const auto directory = QDir(m_sceneDirectory);
+    using Failure = CatchPresentation::ScenePlayback::Failure;
+    const auto show = [this, caption](const QImage &image) {
+        if (!m_view || m_receiving || !listening())
+            return;
+        m_view->setWaitingFrame(image, caption);
+        if (!m_showingScene) {
+            m_showingScene = true;
+            Q_EMIT changed();
+        }
+    };
+    if (m_reduceMotion) {
+        const auto still = CatchPresentation::readMarkedStill(directory.filePath(scene.still));
+        if (still.isNull())
+            fail(Failure::InvalidMedia);
+        else
+            show(still);
+        return;
+    }
+    m_scene = std::make_unique<CatchPresentation::ScenePlayback>(directory.filePath(reconnect ? scene.reconnect : scene.connect));
+    const QPointer<CatchPresentation::ScenePlayback> active(m_scene.get());
+    connect(m_scene.get(), &CatchPresentation::ScenePlayback::frameReady, this, [active, show](const QImage &image) {
+        if (active)
+            show(image);
+    });
+    connect(m_scene.get(), &CatchPresentation::ScenePlayback::failed, this, [active, fail](Failure reason) {
+        if (active)
+            fail(reason);
+    });
+    m_scene->start();
+}
