@@ -0,0 +1,253 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "waitingscenes.h"
+
+#include <QFile>
+#include <QImageReader>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QSet>
+#include <QtEndian>
+#include <algorithm>
+#include <memory>
+#include <zlib.h>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/stereo3d.h>
+#include <libswscale/swscale.h>
+}
+
+namespace CatchPresentation
+{
+QList<Scene> readScenes(const QString &catalogue)
+{
+    QFile file(catalogue);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > 65536)
+        return {};
+    const auto document = QJsonDocument::fromJson(file.readAll());
+    if (!document.isArray() || document.array().size() > 32)
+        return {};
+    const QRegularExpression id(QStringLiteral("^[a-zA-Z0-9_-]{1,64}$"));
+    const QRegularExpression clip(QStringLiteral("^[a-zA-Z0-9_-]+\\.(mp4|mkv)$"));
+    const QRegularExpression still(QStringLiteral("^[a-zA-Z0-9_-]+\\.png$"));
+    QSet<QString> ids;
+    QList<Scene> scenes;
+    for (const auto &item : document.array()) {
+        const auto entry = item.toObject();
+        const Scene scene{entry[QStringLiteral("id")].toString(),
+                          entry[QStringLiteral("connect")].toString(),
+                          entry[QStringLiteral("reconnect")].toString(),
+                          entry[QStringLiteral("still")].toString()};
+        if (!id.match(scene.id).hasMatch() || ids.contains(scene.id) || !clip.match(scene.connect).hasMatch()
+            || !clip.match(scene.reconnect).hasMatch() || !still.match(scene.still).hasMatch())
+            return {};
+        ids.insert(scene.id);
+        scenes.append(scene);
+    }
+    return scenes;
+}
+
+QImage readMarkedStill(const QString &path)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > 16 * 1024 * 1024)
+        return {};
+    const auto bytes = file.readAll();
+    if (!bytes.startsWith("\x89PNG\x0d\x0a\x1a\x0a"))
+        return {};
+    bool marked = false, ended = false, imageData = false;
+    for (qsizetype offset = 8; offset + 12 <= bytes.size();) {
+        const auto size = qFromBigEndian<quint32>(bytes.constData() + offset);
+        const char *type = bytes.constData() + offset + 4;
+        if (size > bytes.size() - offset - 12)
+            return {};
+        const QByteArrayView tag(type, 4);
+        if (tag == "IDAT")
+            imageData = true;
+        if (tag == "sTER") {
+            if (marked || imageData || size != 1 || type[4] != 1
+                || qFromBigEndian<quint32>(type + 5) != crc32(0, reinterpret_cast<const Bytef *>(type), 5))
+                return {};
+            marked = true;
+        }
+        offset += 12 + size;
+        if (tag == "IEND") {
+            ended = size == 0 && offset == bytes.size();
+            break;
+        }
+    }
+    if (!ended || !marked || !imageData)
+        return {};
+    QImageReader reader(path, "png");
+    const auto size = reader.size();
+    if (size.isEmpty() || size.width() % 16 || qint64(size.width()) * size.height() > 16 * 1024 * 1024)
+        return {};
+    return reader.read();
+}
+
+namespace
+{
+using Codec = std::unique_ptr<AVCodecContext, void (*)(AVCodecContext *)>;
+
+Codec openCodec(const AVCodec *codec, const AVCodecParameters *parameters, AVPixelFormat &hardwareFormat, bool vaapi)
+{
+    Codec context(codec ? avcodec_alloc_context3(codec) : nullptr, [](AVCodecContext *c) { avcodec_free_context(&c); });
+    if (!context || avcodec_parameters_to_context(context.get(), parameters) < 0)
+        return {nullptr, context.get_deleter()};
+    if (vaapi) {
+        const AVCodecHWConfig *configuration = nullptr;
+        for (int index = 0; (configuration = avcodec_get_hw_config(codec, index)); ++index) {
+            if (configuration->device_type == AV_HWDEVICE_TYPE_VAAPI && (configuration->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX))
+                break;
+        }
+        if (!configuration || av_hwdevice_ctx_create(&context->hw_device_ctx, AV_HWDEVICE_TYPE_VAAPI, nullptr, nullptr, 0) < 0)
+            return {nullptr, context.get_deleter()};
+        hardwareFormat = configuration->pix_fmt;
+        context->opaque = &hardwareFormat;
+        context->get_format = [](AVCodecContext *c, const AVPixelFormat *formats) {
+            const auto format = *static_cast<const AVPixelFormat *>(c->opaque);
+            for (; *formats != AV_PIX_FMT_NONE; ++formats)
+                if (*formats == format)
+                    return format;
+            return AV_PIX_FMT_NONE;
+        };
+    }
+    if (avcodec_open2(context.get(), codec, nullptr) < 0)
+        return {nullptr, context.get_deleter()};
+    return context;
+}
+
+const AVCodec *v4l2Decoder(AVCodecID codec)
+{
+    switch (codec) {
+    case AV_CODEC_ID_H264:
+        return avcodec_find_decoder_by_name("h264_v4l2m2m");
+    case AV_CODEC_ID_HEVC:
+        return avcodec_find_decoder_by_name("hevc_v4l2m2m");
+    default:
+        return nullptr;
+    }
+}
+}
+
+ScenePlayback::ScenePlayback(QString path, QObject *parent)
+    : QThread(parent)
+    , m_path(std::move(path))
+{
+}
+
+void ScenePlayback::run()
+{
+    AVFormatContext *source = avformat_alloc_context();
+    if (!source) {
+        Q_EMIT failed(Failure::InvalidMedia);
+        return;
+    }
+    source->interrupt_callback = {[](void *object) { return int(static_cast<ScenePlayback *>(object)->isInterruptionRequested()); }, this};
+    AVDictionary *options = nullptr;
+    av_dict_set(&options, "protocol_whitelist", "file", 0);
+    const int opened = avformat_open_input(&source, QFile::encodeName(m_path).constData(), nullptr, &options);
+    av_dict_free(&options);
+    std::unique_ptr<AVFormatContext, void (*)(AVFormatContext *)> media(source, [](AVFormatContext *c) { avformat_close_input(&c); });
+    const int video = opened >= 0 && avformat_find_stream_info(source, nullptr) >= 0
+        ? av_find_best_stream(source, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0)
+        : -1;
+    if (video < 0) {
+        Q_EMIT failed(Failure::InvalidMedia);
+        return;
+    }
+    const auto *parameters = source->streams[video]->codecpar;
+    const auto *sideData = av_packet_side_data_get(parameters->coded_side_data, parameters->nb_coded_side_data, AV_PKT_DATA_STEREO3D);
+    const auto *stereo = sideData && sideData->size >= sizeof(AVStereo3D) ? reinterpret_cast<const AVStereo3D *>(sideData->data) : nullptr;
+    if (!stereo || stereo->type != AV_STEREO3D_SIDEBYSIDE || (stereo->flags & AV_STEREO3D_FLAG_INVERT)
+        || parameters->width < 2 || parameters->width % 2 || parameters->height < 1
+        || qint64(parameters->width) * parameters->height > 16 * 1024 * 1024) {
+        Q_EMIT failed(Failure::InvalidMedia);
+        return;
+    }
+    AVPixelFormat hardwareFormat = AV_PIX_FMT_NONE;
+    auto decoder = openCodec(avcodec_find_decoder(parameters->codec_id), parameters, hardwareFormat, true);
+    const bool useVaapi = bool(decoder);
+    if (!decoder)
+        decoder = openCodec(v4l2Decoder(parameters->codec_id), parameters, hardwareFormat, false);
+    if (!decoder) {
+        Q_EMIT failed(Failure::DecoderUnavailable);
+        return;
+    }
+    std::unique_ptr<AVFrame, void (*)(AVFrame *)> frame(av_frame_alloc(), [](AVFrame *f) { av_frame_free(&f); });
+    std::unique_ptr<AVFrame, void (*)(AVFrame *)> mapped(av_frame_alloc(), [](AVFrame *f) { av_frame_free(&f); });
+    std::unique_ptr<AVPacket, void (*)(AVPacket *)> packet(av_packet_alloc(), [](AVPacket *p) { av_packet_free(&p); });
+    std::unique_ptr<SwsContext, decltype(&sws_freeContext)> scale(nullptr, sws_freeContext);
+    if (!frame || !mapped || !packet) {
+        Q_EMIT failed(Failure::DecoderUnavailable);
+        return;
+    }
+    const double fps = av_q2d(av_guess_frame_rate(source, source->streams[video], nullptr));
+    const unsigned interval = fps > 0 ? std::clamp(qRound(1000.0 / fps), 5, 1000) : 40;
+    bool displayed = false;
+    while (!isInterruptionRequested()) {
+        const int read = av_read_frame(source, packet.get());
+        const bool end = read == AVERROR_EOF;
+        if (read < 0 && !end)
+            break;
+        if (!end && packet->stream_index != video) {
+            av_packet_unref(packet.get());
+            continue;
+        }
+        const int status = avcodec_send_packet(decoder.get(), end ? nullptr : packet.get());
+        av_packet_unref(packet.get());
+        if (status < 0)
+            break;
+        int received = AVERROR(EAGAIN);
+        while (!isInterruptionRequested() && (received = avcodec_receive_frame(decoder.get(), frame.get())) == 0) {
+            const AVFrame *input = frame.get();
+            if (useVaapi) {
+                av_frame_unref(mapped.get());
+                if (frame->format != hardwareFormat || av_hwframe_transfer_data(mapped.get(), frame.get(), 0) < 0) {
+                    Q_EMIT failed(Failure::DecoderUnavailable);
+                    return;
+                }
+                input = mapped.get();
+            }
+            if (input->width != parameters->width || input->height != parameters->height) {
+                Q_EMIT failed(Failure::InvalidMedia);
+                return;
+            }
+            QImage output(input->width, input->height, QImage::Format_RGB32);
+            auto *converter = sws_getCachedContext(scale.release(), input->width, input->height, AVPixelFormat(input->format),
+                                                   input->width, input->height, AV_PIX_FMT_BGRA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+            scale.reset(converter);
+            if (output.isNull() || !converter) {
+                Q_EMIT failed(Failure::DecoderUnavailable);
+                return;
+            }
+            uint8_t *pixels[] = {output.bits()};
+            int stride[] = {int(output.bytesPerLine())};
+            sws_scale(converter, input->data, input->linesize, 0, input->height, pixels, stride);
+            Q_EMIT frameReady(output);
+            av_frame_unref(frame.get());
+            displayed = true;
+            for (unsigned left = interval; left && !isInterruptionRequested();) {
+                const auto pause = std::min(left, 50u);
+                msleep(pause);
+                left -= pause;
+            }
+        }
+        if (received != AVERROR(EAGAIN) && received != AVERROR_EOF)
+            break;
+        if (end) {
+            if (!displayed || av_seek_frame(source, video, 0, AVSEEK_FLAG_BACKWARD) < 0)
+                break;
+            avcodec_flush_buffers(decoder.get());
+            displayed = false;
+        }
+    }
+    if (!isInterruptionRequested())
+        Q_EMIT failed(Failure::DecoderUnavailable);
+}
+}
