diff --git a/rdp/catch/presentation.cpp b/rdp/catch/presentation.cpp
new file mode 100644
index 00000000..d803fe8b
--- /dev/null
+++ b/rdp/catch/presentation.cpp
@@ -0,0 +1,162 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "presentation.h"
+#include "optics/Viewer/Sampling.h"
+
+#include <QPainter>
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+namespace CatchPresentation
+{
+QRect eyeFit(QSize eye, QSize cell)
+{
+    if (eye.isEmpty() || cell.isEmpty())
+        return {};
+    const QSize fit = eye.scaled(cell, Qt::KeepAspectRatio);
+    return QRect(QPoint((cell.width() - fit.width()) / 2, (cell.height() - fit.height()) / 2), fit);
+}
+
+int symmetricMargin(int panelWidth, int leftInset, int rightInset)
+{
+    return std::clamp(std::max(leftInset, rightInset), 0, std::max(0, panelWidth / 4 - 1));
+}
+
+void drawPair(QPainter &painter, const QImage &image, const QString &layout, QSize panel, int margin, bool swap)
+{
+    const bool topBottom = layout == QLatin1StringView("tb-720") || layout == QLatin1StringView("tb-half-720");
+    const QSize encodedEye = topBottom ? QSize(image.width(), image.height() / 2) : QSize(image.width() / 2, image.height());
+    QSize eye = encodedEye;
+    if (layout == QLatin1StringView("tb-half-720"))
+        eye.rheight() *= 2;
+    if (layout == QLatin1StringView("sbs-half-720"))
+        eye.rwidth() *= 2;
+    const int eyeWidth = panel.width() / 2;
+    const QRect fit = eyeFit(eye, QSize(eyeWidth, panel.height()));
+    const QRect leftMask(margin, 0, eyeWidth - 2 * margin, panel.height());
+    for (int index = 0; index < 2; ++index) {
+        const int sourceEye = swap ? 1 - index : index;
+        const QPoint start = topBottom ? QPoint(0, sourceEye * encodedEye.height()) : QPoint(sourceEye * encodedEye.width(), 0);
+        painter.save();
+        painter.setClipRect(leftMask.translated(index * eyeWidth, 0), Qt::IntersectClip);
+        painter.drawImage(fit.translated(index * eyeWidth, 0), image, QRect(start, encodedEye));
+        painter.restore();
+    }
+}
+
+void drawGuide(QPainter &painter, QSizeF panel, qreal density)
+{
+    const qreal centre = panel.width() / 2;
+    const qreal tip = panel.height() - 8 * density;
+    const qreal arrow = 12 * density;
+    painter.save();
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setPen(QPen(Qt::white, 2 * density));
+    painter.drawLine(QPointF(centre, panel.height() / 2), QPointF(centre, tip));
+    painter.drawLine(QPointF(centre - arrow, tip - arrow), QPointF(centre, tip));
+    painter.drawLine(QPointF(centre + arrow, tip - arrow), QPointF(centre, tip));
+    painter.restore();
+}
+
+Projection::Projection(QSize panel, QSizeF millimeters, LensMode mode, const QString &viewer)
+    : m_panel(panel)
+{
+    if (mode == LensMode::None)
+        return;
+    if (panel.width() < 2 || panel.width() % 2 || panel.height() < 1 || qint64(panel.width()) * panel.height() > 16 * 1024 * 1024)
+        throw std::invalid_argument("Invalid lens panel size");
+    m_samples.resize(size_t(panel.width()) * panel.height());
+    if (mode == LensMode::Cardboard) {
+        if (viewer.isEmpty())
+            throw std::invalid_argument("Missing viewer QR");
+        const auto profile = flatheadset::makeViewer(mode, viewer.toStdString(), panel.width(), panel.height(), millimeters.width(), millimeters.height());
+        for (int eye = 0; eye < 2; ++eye)
+            projectMesh(profile->eyes[eye], eye);
+        return;
+    }
+    for (int y = 0; y < panel.height(); ++y) {
+        for (int x = 0; x < panel.width(); ++x) {
+            const auto source = fittedSample(x, y, panel.width(), panel.height());
+            if (source.visible)
+                m_samples[y * panel.width() + x] = {source.x, source.y};
+        }
+    }
+}
+
+void Projection::projectMesh(const flatheadset::EyeMesh &mesh, int eye)
+{
+    const int width = m_panel.width(), height = m_panel.height();
+    const int eyeWidth = width / 2;
+    const int start = eye * eyeWidth;
+    auto vertices = mesh.vertices;
+    for (auto &v : vertices) {
+        // Cardboard vertices are on the whole panel. The scissor and source sampling stay per eye.
+        v.x = (v.x + 1) * width / 2;
+        v.y = (1 - v.y) * height / 2;
+    }
+    for (std::size_t index = 2; index < mesh.indices.size(); ++index) {
+        const auto &a = vertices[mesh.indices[index - 2]];
+        const auto &b = vertices[mesh.indices[index - 1]];
+        const auto &c = vertices[mesh.indices[index]];
+        const float determinant = (b.x - a.x) * (c.y - a.y) - (c.x - a.x) * (b.y - a.y);
+        if (determinant == 0)
+            continue;
+        const int left = std::max(start, int(std::floor(std::min({a.x, b.x, c.x}))));
+        const int right = std::min(start + eyeWidth, int(std::ceil(std::max({a.x, b.x, c.x}))));
+        const int top = std::max(0, int(std::floor(std::min({a.y, b.y, c.y}))));
+        const int bottom = std::min(height, int(std::ceil(std::max({a.y, b.y, c.y}))));
+        for (int y = top; y < bottom; ++y) {
+            for (int x = left; x < right; ++x) {
+                const float dx = x + 0.5f - a.x;
+                const float dy = y + 0.5f - a.y;
+                const float wb = (dx * (c.y - a.y) - dy * (c.x - a.x)) / determinant;
+                const float wc = ((b.x - a.x) * dy - (b.y - a.y) * dx) / determinant;
+                const float wa = 1 - wb - wc;
+                if (std::min({wa, wb, wc}) < -1e-6f)
+                    continue;
+                const float u = wa * a.u + wb * b.u + wc * c.u;
+                const float v = wa * a.v + wb * b.v + wc * c.v;
+                m_samples[y * width + x] = {std::clamp(start + u * eyeWidth - 0.5f, float(start), float(start + eyeWidth - 1)),
+                                             std::clamp(v * height - 0.5f, 0.0f, float(height - 1))};
+            }
+        }
+    }
+}
+
+QImage Projection::apply(const QImage &panel) const
+{
+    if (m_samples.empty())
+        return panel;
+    if (panel.size() != m_panel || panel.format() != QImage::Format_RGB32)
+        return {};
+    QImage output(m_panel, QImage::Format_RGB32);
+    if (output.isNull())
+        return {};
+    const int width = panel.width();
+    const int eyeWidth = width / 2;
+    for (int y = 0; y < panel.height(); ++y) {
+        auto *target = reinterpret_cast<QRgb *>(output.scanLine(y));
+        for (int x = 0; x < width; ++x) {
+            const auto &sample = m_samples[y * width + x];
+            if (sample.x < 0) {
+                target[x] = qRgb(0, 0, 0);
+                continue;
+            }
+            const int sx = int(sample.x);
+            const int sy = int(sample.y);
+            const int right = std::min(sx + 1, x < eyeWidth ? eyeWidth - 1 : width - 1);
+            const auto *above = reinterpret_cast<const QRgb *>(panel.constScanLine(sy));
+            const auto *below = reinterpret_cast<const QRgb *>(panel.constScanLine(std::min(sy + 1, panel.height() - 1)));
+            const float fx = sample.x - sx, fy = sample.y - sy;
+            const auto mix = [&](auto channel) {
+                return qRound(std::lerp(std::lerp(float(channel(above[sx])), float(channel(above[right])), fx),
+                                        std::lerp(float(channel(below[sx])), float(channel(below[right])), fx), fy));
+            };
+            target[x] = qRgb(mix([](QRgb color) { return qRed(color); }), mix([](QRgb color) { return qGreen(color); }), mix([](QRgb color) { return qBlue(color); }));
+        }
+    }
+    return output;
+}
+}
