+    def get_renamed(self, command):
+        """
+        return the packages that install this command under another name
+
+        Debian Policy 10.1: of two programs with one name, "one of the
+        programs must be renamed". The renamed-commands file in the data
+        directory lists those programs, one per line: the command as its
+        upstream names it, the package, and the name Debian installs it as.
+        Each result is (package, version, component, installed name, path):
+        path is where the installed name already is, otherwise None and the
+        package is one the database has for the installed name.
+        """
+        try:
+            with open(os.path.join(self.data_dir, self.renamed_file)) as fp:
+                rows = [line.split() for line in fp
+                        if line.strip() and not line.lstrip().startswith("#")]
+        except IOError:
+            return []
+        results = []
+        for row in rows:
+            if len(row) != 3 or row[0] != command:
+                continue
+            package, name = row[1], row[2]
+            places = [os.path.join(prefix, name) for prefix in self.prefixes
+                      if os.path.isfile(os.path.join(prefix, name))]
+            if places:
+                results.append((package, None, None, name, places[0]))
+                continue
+            for (pkg, ver, comp) in self.get_packages(name):
+                if pkg == package:
+                    results.append((pkg, ver, comp, name, None))
+                    break
+        return results
+
