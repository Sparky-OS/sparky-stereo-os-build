diff --git a/CommandNotFound/tests/test_renamed_commands.py b/CommandNotFound/tests/test_renamed_commands.py
new file mode 100644
index 0000000..2f8e975
--- /dev/null
+++ b/CommandNotFound/tests/test_renamed_commands.py
@@ -0,0 +1,139 @@
+#!/usr/bin/python3
+
+import os
+import shutil
+import tempfile
+import unittest
+
+import CommandNotFound.CommandNotFound as CommandNotFound_Module
+from CommandNotFound.CommandNotFound import CommandNotFound
+from CommandNotFound.db.creator import DbCreator
+
+
+class MockAptDB:
+    def __init__(self, debs):
+        self._db = {}
+        for deb in debs.split(";"):
+            name, cmds = deb.split(":")
+            for cmd in cmds.split(","):
+                self._db.setdefault(cmd, []).append((name, None, "main"))
+
+    def lookup(self, command):
+        return self._db.get(command, [])
+
+
+TABLE = """\
+# command	package	installed as
+bat	bat	batcat
+fd	fd-find	fdfind
+"""
+
+
+class RenamedCommandsTest(unittest.TestCase):
+
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmpdir)
+        commands_file = os.path.join(self.tmpdir, "Commands-all")
+        with open(commands_file, "w"):
+            pass
+        DbCreator([commands_file]).create(os.path.join(self.tmpdir, "test.db"))
+        CommandNotFound_Module.dbpath = os.path.join(self.tmpdir, "test.db")
+        self.data_dir = os.path.join(self.tmpdir, "data")
+        os.mkdir(self.data_dir)
+        with open(os.path.join(self.data_dir, "renamed-commands"), "w") as fp:
+            fp.write(TABLE)
+        self.bindir = os.path.join(self.tmpdir, "bin")
+        os.mkdir(self.bindir)
+
+    def advise(self, debs, command, euid=1000, sudo=True, data_dir=None):
+        cnf = CommandNotFound(data_dir or self.data_dir)
+        cnf.db = MockAptDB(debs)
+        cnf.snap_cmd = os.path.join(self.tmpdir, "no-snap")
+        cnf.prefixes = (self.bindir,)
+        cnf.sources_list = set(["main"])
+        cnf.euid = euid
+        cnf.user_can_sudo = sudo
+        cnf.output_fd = open(os.path.join(self.tmpdir, "output"), "w")
+        found = cnf.advise(command)
+        cnf.output_fd.close()
+        with open(cnf.output_fd.name) as fp:
+            return found, fp.read()
+
+    def test_renamed_first_literal_kept(self):
+        self.assertEqual(self.advise("fdclone:fd;fd-find:fdfind", "fd"), (True, """\
+Command 'fd' not found, but can be installed with:
+sudo apt install fd-find  # run it as 'fdfind'
+sudo apt install fdclone
+"""))
+        self.assertEqual(self.advise("bacula-console-qt:bat;bat:batcat", "bat"), (True, """\
+Command 'bat' not found, but can be installed with:
+sudo apt install bat                # run it as 'batcat'
+sudo apt install bacula-console-qt
+"""))
+
+    def test_renamed_only(self):
+        self.assertEqual(self.advise("fd-find:fdfind", "fd"), (True, """\
+Command 'fd' not found, but can be installed with:
+sudo apt install fd-find  # run it as 'fdfind'
+"""))
+
+    def test_renamed_installed(self):
+        open(os.path.join(self.bindir, "fdfind"), "w").close()
+        self.assertEqual(self.advise("fdclone:fd;fd-find:fdfind", "fd"), (True, """\
+Command 'fd' is installed as '%s/fdfind' from deb fd-find
+Command 'fd' not found, but can be installed with:
+sudo apt install fdclone
+""" % self.bindir))
+        self.assertEqual(self.advise("fd-find:fdfind", "fd"), (True, """\
+Command 'fd' is installed as '%s/fdfind' from deb fd-find
+""" % self.bindir))
+
+    def test_renamed_package_not_in_the_archive(self):
+        # a row whose package the archive does not have is not offered
+        self.assertEqual(self.advise("fdclone:fd", "fd"), (True, """\
+Command 'fd' not found, but can be installed with:
+sudo apt install fdclone
+"""))
+
+    def test_no_table_or_no_row_unchanged(self):
+        for data_dir in (self.data_dir, os.path.join(self.tmpdir, "missing")):
+            self.assertEqual(self.advise("vim:x-vi;neovim:x-vi", "x-vi", data_dir=data_dir), (True, """\
+Command 'x-vi' not found, but can be installed with:
+sudo apt install vim""" + "   " + """
+sudo apt install neovim
+"""))
+        self.assertEqual(self.advise("fdclone:fd;fd-find:fdfind", "fd",
+                                     data_dir=os.path.join(self.tmpdir, "missing")), (True, """\
+Command 'fd' not found, but can be installed with:
+sudo apt install fdclone
+"""))
+
+    def test_without_sudo(self):
+        self.assertEqual(self.advise("fdclone:fd;fd-find:fdfind", "fd", sudo=False), (True, """\
+Command 'fd' not found, but can be installed with:
+apt install fd-find  # run it as 'fdfind'
+apt install fdclone
+Ask your administrator to install one of them.
+"""))
+        self.assertEqual(self.advise("fd-find:fdfind", "fd", euid=0), (True, """\
+Command 'fd' not found, but can be installed with:
+apt install fd-find  # run it as 'fdfind'
+"""))
+
+    def test_shipped_table(self):
+        path = os.path.join(os.path.dirname(__file__), "..", "..", "data", "renamed-commands")
+        rows = {}
+        with open(path) as fp:
+            for line in fp:
+                if line.strip() and not line.lstrip().startswith("#"):
+                    fields = line.split()
+                    self.assertEqual(len(fields), 3, line)
+                    self.assertNotIn(fields[0], rows, line)
+                    rows[fields[0]] = (fields[1], fields[2])
+        self.assertEqual(rows["fd"], ("fd-find", "fdfind"))
+        self.assertEqual(rows["bat"], ("bat", "batcat"))
+
+
+if __name__ == "__main__":
+    unittest.main()
