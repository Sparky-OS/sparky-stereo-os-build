+    def advice_renamed(self, command, renamed, packages, snaps):
+        """
+        name the programs Debian installs this command as first, then the
+        packages and snaps that have the command under its own name; return
+        False when every renamed program is installed and nothing was offered
+        """
+        for (package, ver, comp, name, place) in renamed:
+            if place:
+                print(_("Command '%(command)s' is installed as '%(place)s' from deb %(package)s") % {
+                    'command': command, 'place': place, 'package': package}, file=self.output_fd)
+        offered = [r for r in renamed if not r[4]]
+        if not offered:
+            self.output_fd.flush()
+            return False
+        self._print_exact_header(command)
+        rows = [(r[0], r[1], r[2], r[3]) for r in offered]
+        rows += [(p[0], p[1], p[2], None) for p in packages]
+        pad = max([len(r[0]) for r in rows] + [len(s[0]) for s in snaps])
+        for (package, ver, comp, name) in rows:
+            notes = []
+            if name:
+                notes.append(_("run it as '%s'") % name)
+            if ver:
+                notes.append("version %s" % ver)
+            line = "%sapt install %-*s" % (self.sudo(), pad, package)
+            if notes:
+                line += "  # " + ", ".join(notes)
+            if comp not in self.sources_list:
+                line += " (" + _("You will have to enable component called '%s'") % comp + ")"
+            print(line.rstrip(), file=self.output_fd)
+        for snap in snaps:
+            ver = ""
+            if snap[2]:
+                ver = "  # version %s" % snap[2]
+            print("%ssnap install %-*s%s" % (self.sudo(), pad, snap[0], ver), file=self.output_fd)
+        if snaps:
+            print(_("See 'snap info <snapname>' for additional versions."), file=self.output_fd)
+        if self.euid != 0 and not self.user_can_sudo:
+            if len(rows) + len(snaps) == 1:
+                print(_("Please ask your administrator."), file=self.output_fd)
+            else:
+                print(_("Ask your administrator to install one of them."), file=self.output_fd)
+        elif len(rows) == 1 and not snaps:
+            self.install_prompt(rows[0][0])
+        self.output_fd.flush()
+        return True
