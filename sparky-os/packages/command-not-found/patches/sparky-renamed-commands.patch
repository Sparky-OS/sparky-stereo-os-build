+    def get_renamed(self, command):
+        """
+        return the packages that install this command under another name
+
+        Debian Policy 10.1: of two programs with one name, "one of the
+        programs must be renamed". The renamed-commands file in the data
+        directory lists those programs, one per line: the command as its
+        upstream names it, the package, the name Debian installs it as, and
+        "first" or "after": whether the package is named before the packages
+        that have the command itself or after them.
+        Each result is (package, version, component, installed name, path,
+        first): path is where the installed name already is, otherwise None
+        and the package is one the database has for the installed name.
+        A table that cannot be read is said, and no package is renamed.
+        """
+        path = os.path.join(self.data_dir, self.renamed_file)
+        try:
+            with open(path) as fp:
+                lines = fp.readlines()
+        except (IOError, OSError) as e:
+            self.print_renamed_problem(path, e.strerror or str(e))
+            return []
+        rows = []
+        for number, line in enumerate(lines, 1):
+            if not line.strip() or line.lstrip().startswith("#"):
+                continue
+            row = line.split()
+            if len(row) != 4 or row[3] not in ("first", "after"):
+                self.print_renamed_problem(path, "line %d: %s" % (number, line.strip()))
+                return []
+            rows.append(row)
+        results = []
+        for (cmd, package, name, order) in rows:
+            if cmd != command:
+                continue
+            first = order == "first"
+            places = [os.path.join(prefix, name) for prefix in self.prefixes
+                      if os.path.isfile(os.path.join(prefix, name))]
+            if places:
+                results.append((package, None, None, name, places[0], first))
+                continue
+            for (pkg, ver, comp) in self.get_packages(name):
+                if pkg == package:
+                    results.append((pkg, ver, comp, name, None, first))
+                    break
+        return results
+
