Description: Translate headset pairing refusal and revocation
Author: Daniel Campos Ramos
Origin: backport, edition commit c91ac51
Last-Update: 2026-11-19

--- a/discovery/PanelDiscovery.cpp
+++ b/discovery/PanelDiscovery.cpp
@@ -2,6 +2,7 @@
 #include "PanelDiscovery.h"
 #include "PairingTrust.h"
 #include <PanelDescriptor.h>
+#include <KLocalizedString>
 #include <QCryptographicHash>
 #include <QDBusInterface>
 #include <QDBusArgument>
@@ -106,7 +107,7 @@
     QSslCertificate certificate;
     QSslKey key;
     if (paired.isNull() || !PairingTrust::localIdentity(certificate, key)) {
-        qWarning("Headset control requires KDE Connect pairing and its local TLS identity");
+        qWarning().noquote() << i18n("Pair this headset with this computer in KDE Connect before connecting.");
         return;
     }
     auto socket = new QSslSocket(this);
@@ -123,7 +124,12 @@
         if (QString::fromLatin1(socket->peerCertificate().digest(QCryptographicHash::Sha256).toHex()) != peer->identity || !PairingTrust::isPaired(socket->peerCertificate())) { socket->abort(); return; }
         peer->lastReply.start();
         connect(&peer->heartbeat, &QTimer::timeout, socket, [socket, peer] {
-            if (peer->lastReply.elapsed() > 15000 || !PairingTrust::isPaired(socket->peerCertificate())) { socket->abort(); return; }
+            if (!PairingTrust::isPaired(socket->peerCertificate())) {
+                qWarning().noquote() << i18n("Headset disconnected: KDE Connect pairing was removed.");
+                socket->abort();
+                return;
+            }
+            if (peer->lastReply.elapsed() > 15000) { socket->abort(); return; }
             socket->write("{\"action\":\"ping\"}\n");
         });
         peer->heartbeat.start(5000);
