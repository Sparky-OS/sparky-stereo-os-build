+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#pragma once
+
+#include <QSslCertificate>
+#include <QSslKey>
+#include <QString>
+
+// KDE Connect owns these credentials. Read its current pairing store each time;
+// discovery and the old standalone approval store never grant trust.
+namespace PairingTrust
+{
+QSslCertificate pairedCertificate(const QString &fingerprint);
+bool isPaired(const QSslCertificate &certificate);
+bool localIdentity(QSslCertificate &certificate, QSslKey &key);
+}
