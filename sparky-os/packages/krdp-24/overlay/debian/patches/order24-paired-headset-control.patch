--- /dev/null
+++ b/discovery/PairingTrust.cpp
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "PairingTrust.h"
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QSettings>
+#include <QStandardPaths>
+
+static QDir configDirectory()
+{
+    return QDir(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/kdeconnect"));
+}
+
+QSslCertificate PairingTrust::pairedCertificate(const QString &fingerprint)
+{
+    if (fingerprint.size() != 64) return {};
+    QSettings devices(configDirectory().filePath(QStringLiteral("trusted_devices")), QSettings::IniFormat);
+    devices.sync();
+    for (const auto &device : devices.childGroups()) {
+        const QSslCertificate certificate(devices.value(device + QStringLiteral("/certificate")).toByteArray());
+        if (!certificate.isNull() && QString::fromLatin1(certificate.digest(QCryptographicHash::Sha256).toHex()) == fingerprint) return certificate;
+    }
+    return {};
+}
+
+bool PairingTrust::isPaired(const QSslCertificate &certificate)
+{
+    return !certificate.isNull() && pairedCertificate(QString::fromLatin1(certificate.digest(QCryptographicHash::Sha256).toHex())) == certificate;
+}
+
+bool PairingTrust::localIdentity(QSslCertificate &certificate, QSslKey &key)
+{
+    QFile certFile(configDirectory().filePath(QStringLiteral("certificate.pem")));
+    QFile keyFile(configDirectory().filePath(QStringLiteral("privateKey.pem")));
+    if (!certFile.open(QIODevice::ReadOnly) || !keyFile.open(QIODevice::ReadOnly)) return false;
+    certificate = QSslCertificate(certFile.readAll());
+    const auto bytes = keyFile.readAll();
+    key = QSslKey(bytes, QSsl::Rsa);
+    if (key.isNull()) key = QSslKey(bytes, QSsl::Ec);
+    return !certificate.isNull() && !key.isNull();
+}
