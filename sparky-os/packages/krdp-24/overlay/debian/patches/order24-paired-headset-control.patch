new file mode 100644
index 0000000..4d355ac
--- /dev/null
+++ b/autotests/PairingTrustTest.cpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#include "../discovery/PairingTrust.h"
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QProcess>
+#include <QSettings>
+#include <QTemporaryDir>
+#include <QTest>
+
+class PairingTrustTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void pairingLifecycle()
+    {
+        QTemporaryDir home;
+        QVERIFY(home.isValid());
+        qputenv("XDG_CONFIG_HOME", home.path().toUtf8());
+        QDir().mkpath(home.path() + QStringLiteral("/kdeconnect"));
+        const QString base = home.path() + QStringLiteral("/kdeconnect/");
+        const auto makeCertificate = [&base](const QString &prefix) {
+            return QProcess::execute(QStringLiteral("openssl"), {QStringLiteral("req"), QStringLiteral("-x509"), QStringLiteral("-newkey"), QStringLiteral("rsa:2048"), QStringLiteral("-nodes"), QStringLiteral("-days"), QStringLiteral("1"),
+                QStringLiteral("-subj"), QStringLiteral("/CN=isolated-test-") + prefix, QStringLiteral("-keyout"), base + prefix + QStringLiteral("Key.pem"), QStringLiteral("-out"), base + prefix + QStringLiteral("Certificate.pem")});
+        };
+        QCOMPARE(makeCertificate(QStringLiteral("peer")), 0);
+        QCOMPARE(makeCertificate(QStringLiteral("stranger")), 0);
+        QFile file(base + QStringLiteral("peerCertificate.pem"));
+        QVERIFY(file.open(QIODevice::ReadOnly));
+        const QSslCertificate peer(file.readAll());
+        QVERIFY(!peer.isNull());
+        const auto fingerprint = QString::fromLatin1(peer.digest(QCryptographicHash::Sha256).toHex());
+        QVERIFY(PairingTrust::pairedCertificate(fingerprint).isNull());
+        QSettings obsolete(home.path() + QStringLiteral("/KDE/krdp-panel-discovery.conf"), QSettings::IniFormat);
+        obsolete.setValue(QStringLiteral("approvedPanels/") + fingerprint, true);
+        obsolete.sync();
+        QVERIFY(!PairingTrust::isPaired(peer));
+        QSettings trusted(base + QStringLiteral("trusted_devices"), QSettings::IniFormat);
+        trusted.setValue(QStringLiteral("named-pc/certificate"), peer.toPem());
+        trusted.sync();
+        QCOMPARE(PairingTrust::pairedCertificate(fingerprint), peer);
+        QVERIFY(PairingTrust::isPaired(peer));
+        QFile strangerFile(base + QStringLiteral("strangerCertificate.pem"));
+        QVERIFY(strangerFile.open(QIODevice::ReadOnly));
+        const QSslCertificate stranger(strangerFile.readAll());
+        QVERIFY(!PairingTrust::isPaired(stranger));
+        trusted.setValue(QStringLiteral("named-pc/certificate"), stranger.toPem());
+        trusted.sync();
+        QVERIFY(!PairingTrust::isPaired(peer));
+        trusted.remove(QStringLiteral("named-pc"));
+        trusted.sync();
+        QVERIFY(!PairingTrust::isPaired(stranger));
+        QSslCertificate local;
+        QSslKey key;
+        QVERIFY(!PairingTrust::localIdentity(local, key));
+        QVERIFY(QFile::copy(base + QStringLiteral("peerCertificate.pem"), base + QStringLiteral("certificate.pem")));
+        QVERIFY(QFile::copy(base + QStringLiteral("peerKey.pem"), base + QStringLiteral("privateKey.pem")));
+        QVERIFY(PairingTrust::localIdentity(local, key));
+        QCOMPARE(local, peer);
+        QVERIFY(!key.isNull());
+    }
+};
+
+QTEST_GUILESS_MAIN(PairingTrustTest)
+#include "PairingTrustTest.moc"
