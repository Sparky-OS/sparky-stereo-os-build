@@ -0,0 +1,137 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#include "stereoicons.h"
+
+#include <QApplication>
+#include <QDynamicPropertyChangeEvent>
+#include <QScreen>
+#include <QWidget>
+#include <QWindow>
+
+#include <stereo-layer/screenmode.h>
+
+static constexpr char IconsDrawnProperty[] = "_q_stereo_icons_drawn";
+static constexpr char IconProperty[] = "_q_stereo_icon";
+static constexpr char DepthProperty[] = "_q_stereo_depth";
+
+StereoIcons::StereoIcons(QObject *parent)
+    : QObject(parent)
+{
+    QCoreApplication::instance()->installEventFilter(this);
+}
+
+StereoIcons::~StereoIcons() = default;
+
+bool StereoIcons::eventFilter(QObject *watched, QEvent *event)
+{
+    if (event->type() == QEvent::DynamicPropertyChange) {
+        const QByteArray name = static_cast<QDynamicPropertyChangeEvent *>(event)->propertyName();
+        if (name == IconsDrawnProperty && watched == QCoreApplication::instance()) {
+            iconsDrawn();
+        } else if (name == IconProperty && watched->isWindowType() && watched->property(IconProperty).toBool()) {
+            watch(static_cast<QWindow *>(watched));
+        }
+    }
+    return false;
+}
+
+// Whether the widget or one inside it is being painted (Qt sets WA_WState_InPaintEvent around a paint event)
+static bool paintingIn(const QWidget *widget)
+{
+    if (widget->testAttribute(Qt::WA_WState_InPaintEvent)) {
+        return true;
+    }
+    for (const QObject *child : widget->children()) {
+        if (child->isWidgetType() && !static_cast<const QWidget *>(child)->isWindow() && paintingIn(static_cast<const QWidget *>(child))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void StereoIcons::iconsDrawn()
+{
+    // A stereo icon was just drawn: if a widget window not yet marked is being painted, it showed the icon
+    if (!qobject_cast<QApplication *>(QCoreApplication::instance())) {
+        return;
+    }
+    const auto topLevels = QApplication::topLevelWidgets();
+    for (const QWidget *topLevel : topLevels) {
+        QWindow *window = topLevel->windowHandle();
+        if (!window || !topLevel->isVisible() || window->property(IconProperty).toBool()) {
+            continue;
+        }
+        if (paintingIn(topLevel)) {
+            window->setProperty(IconProperty, true);
+            return;
+        }
+    }
+}
+
+void StereoIcons::watch(QWindow *window)
+{
+    if (!m_windows.contains(window)) {
+        m_windows.insert(window, false);
+        connect(window, &QWindow::screenChanged, this, [this, window] {
+            update(window);
+        });
+        connect(window, &QObject::destroyed, this, [this, window] {
+            m_windows.remove(window);
+        });
+    }
+    update(window);
+}
+
+Stereo::ScreenMode *StereoIcons::screenMode(QScreen *screen)
+{
+    Stereo::ScreenMode *&mode = m_screenModes[screen];
+    if (!mode) {
+        mode = new Stereo::ScreenMode(this);
+        mode->setScreen(screen);
+        connect(mode, &Stereo::ScreenMode::modeChanged, this, [this, screen] {
+            for (auto it = m_windows.cbegin(); it != m_windows.cend(); ++it) {
+                if (it.key()->screen() == screen) {
+                    update(it.key());
+                }
+            }
+        });
+        connect(screen, &QObject::destroyed, this, [this, screen] {
+            delete m_screenModes.take(screen);
+        });
+    }
+    return mode;
+}
+
+void StereoIcons::update(QWindow *window)
+{
+    QScreen *screen = window->screen();
+    const Stereo::OutputMode mode = screen ? screenMode(screen)->mode() : Stereo::OutputMode::Unknown;
+    const bool twoEyes = mode == Stereo::OutputMode::Stereo || mode == Stereo::OutputMode::Anaglyph;
+    bool &ours = m_windows[window];
+    const bool depth = window->property(DepthProperty).toBool();
+    if (twoEyes && !depth) {
+        window->setProperty(DepthProperty, true);
+        ours = true;
+    } else if (!twoEyes && depth && ours) {
+        window->setProperty(DepthProperty, QVariant());
+        ours = false;
+    } else {
+        return;
+    }
+    // Qt Widgets reads _q_stereo_depth when it paints the window, Qt Quick when the property changes
+    if (qobject_cast<QApplication *>(QCoreApplication::instance())) {
+        const auto topLevels = QApplication::topLevelWidgets();
+        for (QWidget *topLevel : topLevels) {
+            if (topLevel->windowHandle() == window) {
+                topLevel->update();
+                break;
+            }
+        }
+    }
+}
+
+#include "moc_stereoicons.cpp"
