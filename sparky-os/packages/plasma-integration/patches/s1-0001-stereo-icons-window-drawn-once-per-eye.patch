new file mode 100644
index 0000000..01a0698
--- /dev/null
+++ b/qt6/src/platformtheme/stereoicons.h
@@ -0,0 +1,51 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QHash>
+#include <QObject>
+
+class QScreen;
+class QWindow;
+
+namespace Stereo
+{
+class ScreenMode;
+}
+
+/*
+ * A window that shows an icon the icon theme has in stereo is drawn once per eye while it is on
+ * an output that shows two eyes (a 3D mode, a stereo pair of outputs, anaglyph), so that each eye
+ * gets its view of the icon; on any other output, and for a window that never drew such an icon,
+ * nothing changes.
+ *
+ * KIconEngine counts each drawing of such an icon on the application (_q_stereo_icons_drawn). A
+ * widget window drawing one is marked here (_q_stereo_icon); an item that draws itself, such as
+ * Kirigami's Icon, marks its own window. A marked window gets _q_stereo_depth, which makes the
+ * edition's Qt draw it once per eye, while Stereo::ScreenMode says its screen shows two eyes; the
+ * property is taken away again when it does not, unless something else set it.
+ */
+class StereoIcons : public QObject
+{
+    Q_OBJECT
+public:
+    explicit StereoIcons(QObject *parent = nullptr);
+    ~StereoIcons() override;
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void iconsDrawn();
+    void watch(QWindow *window);
+    void update(QWindow *window);
+    Stereo::ScreenMode *screenMode(QScreen *screen);
+
+    // The windows that drew a stereo icon, and whether their _q_stereo_depth is ours
+    QHash<QWindow *, bool> m_windows;
+    QHash<QScreen *, Stereo::ScreenMode *> m_screenModes;
+};
