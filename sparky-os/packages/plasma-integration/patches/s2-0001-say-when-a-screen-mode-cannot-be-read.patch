index d9707e9..1595b08 100644
--- a/qt6/src/platformtheme/stereoicons.cpp
+++ b/qt6/src/platformtheme/stereoicons.cpp
@@ -14,6 +14,8 @@
 
 #include <stereo-layer/screenmode.h>
 
+#include <KScreen/GetConfigOperation>
+
 static constexpr char IconsDrawnProperty[] = "_q_stereo_icons_drawn";
 static constexpr char IconProperty[] = "_q_stereo_icon";
 static constexpr char DepthProperty[] = "_q_stereo_depth";
@@ -102,10 +104,50 @@ Stereo::ScreenMode *StereoIcons::screenMode(QScreen *screen)
         connect(screen, &QObject::destroyed, this, [this, screen] {
             delete m_screenModes.take(screen);
         });
+        if (m_screensRead == ScreensRead::Failed) {
+            tellUnread(screen);
+        } else {
+            readScreens();
+        }
     }
     return mode;
 }
 
+void StereoIcons::readScreens()
+{
+    // Stereo::ScreenMode leaves a screen whose mode KScreen cannot give as unknown, and its windows are drawn once;
+    // the same read here says so, once per screen, instead of leaving the plain icons unexplained
+    if (m_screensRead != ScreensRead::NotYet) {
+        return;
+    }
+    m_screensRead = ScreensRead::Reading;
+    auto *operation = new KScreen::GetConfigOperation(KScreen::ConfigOperation::NoEDID, this);
+    connect(operation, &KScreen::ConfigOperation::finished, this, [this, operation] {
+        if (!operation->hasError()) {
+            m_screensRead = ScreensRead::Read;
+            return;
+        }
+        m_screensRead = ScreensRead::Failed;
+        m_screensError = operation->errorString();
+        const auto screens = m_screenModes.keys();
+        for (QScreen *screen : screens) {
+            tellUnread(screen);
+        }
+    });
+}
+
+void StereoIcons::tellUnread(QScreen *screen)
+{
+    if (!screen || m_toldScreens.contains(screen->name())) {
+        return;
+    }
+    m_toldScreens.insert(screen->name());
+    qWarning().noquote() << QStringLiteral(
+                                "The mode of screen %1 cannot be read (KScreen: %2), so a window on it that shows an icon the icon theme has in stereo is "
+                                "drawn once, with the plain icon, even if the screen shows two eyes.")
+                                .arg(screen->name(), m_screensError.isEmpty() ? QStringLiteral("no reason given") : m_screensError);
+}
+
 void StereoIcons::update(QWindow *window)
 {
     QScreen *screen = window->screen();
