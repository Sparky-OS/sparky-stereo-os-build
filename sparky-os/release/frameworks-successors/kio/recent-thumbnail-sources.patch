+void FilePreviewJobTest::testOlderFileDoesNotWait()
+{
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString path = dir.filePath(QStringLiteral("image.png"));
+    QVERIFY(writeImage(path, Qt::red));
+    QFile file(path);
+    QVERIFY(file.open(QIODevice::ReadWrite));
+    QVERIFY(file.setFileTime(QDateTime::currentDateTimeUtc().addSecs(-60), QFileDevice::FileModificationTime));
+    file.close();
+    const KFileItem item = previewItem(path);
+    const auto plugins = FilePreviewJob::standardThumbnailers();
+    const auto it = std::find_if(plugins.cbegin(), plugins.cend(), [](const KPluginMetaData &plugin) {
+        return plugin.pluginId() == QStringLiteral("kiotest");
+    });
+    QVERIFY(it != plugins.cend());
+    PreviewSetupData setup;
+    setup.thumbRoot = ThumbnailCache::rootPath();
+    struct stat sourceStat;
+    QVERIFY(::stat(QFile::encodeName(path).constData(), &sourceStat) == 0);
+    setup.thumbRootDeviceId = sourceStat.st_dev;
+    setup.pluginByMimeTable.insert(item.mimetype(), *it);
+    PreviewOptions options;
+    options.size = QSize(256, 256);
+    FilePreviewJob job(item, sourceStat.st_dev, options, setup);
+    job.setAutoDelete(false);
+    job.m_currentDeviceCachePolicy = FilePreviewJob::Allow;
+    job.m_partialFileStabilityInterval = 60000;
+    QSignalSpy result(&job, &KJob::result);
+    job.start();
+    QTRY_COMPARE(result.count(), 1);
+    QVERIFY(!job.m_partialFileStabilityTimer);
+    QVERIFY(!job.previewImage().isNull());
+    QCOMPARE(job.previewImage().pixelColor(0, 0), QColor(Qt::red));
+}
