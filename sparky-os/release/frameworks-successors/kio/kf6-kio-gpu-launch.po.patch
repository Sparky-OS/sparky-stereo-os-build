+#: src/gui/gpudetection.cpp:193
+#, kde-format
+msgctxt "@info %1 is the name of a program"
+msgid "%1 was not started."
+msgstr "Das Programm %1 wurde nicht gestartet."
+
+#: src/gui/gpudetection.cpp:202
+#, kde-format
