+void FilePreviewJobTest::testPartialFileSidecar_data()
+{
+    QTest::addColumn<QString>("suffix");
+    QTest::addColumn<bool>("self");
+    const QStringList patterns = QMimeDatabase().mimeTypeForName(QStringLiteral("application/x-partial-download")).globPatterns();
+    QVERIFY(!patterns.isEmpty());
+    for (const QString &pattern : patterns) {
+        QVERIFY(pattern.startsWith(QLatin1Char('*')));
+        QTest::newRow(qPrintable(pattern)) << pattern.mid(1) << false;
+        QTest::newRow(qPrintable(pattern + QStringLiteral("-self"))) << pattern.mid(1) << true;
+    }
+}
+
+void FilePreviewJobTest::testPartialFileSidecar()
+{
+    QFETCH(QString, suffix);
+    QFETCH(bool, self);
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString finalPath = dir.filePath(QStringLiteral("image.png"));
+    const QString path = self ? finalPath + suffix : finalPath;
+    QVERIFY(writeImage(path, Qt::red));
+    QFile sidecar(path + suffix);
+    if (!self) {
+        QVERIFY(sidecar.open(QIODevice::WriteOnly));
+        sidecar.close();
+    }
+    const KFileItem item = previewItem(path);
+    TestPreviewJob job(item);
+    QSignalSpy failed(&job, &PreviewJob::failed);
+    QSignalSpy preview(&job, &PreviewJob::gotPreview);
+    QSignalSpy result(&job, &KJob::result);
+    QTRY_COMPARE(result.count(), 1);
+    QCOMPARE(failed.count(), 1);
+    QCOMPARE(qvariant_cast<KFileItem>(failed.at(0).at(0)).url(), item.url());
+    QCOMPARE(preview.count(), 0);
+    QVERIFY(!QFileInfo::exists(thumbnailPath(item)));
+    QVERIFY(!QDir(ThumbnailCache::rootPath() + QStringLiteral("/fail")).exists());
+
+    if (self) {
+        QVERIFY(QFile::rename(path, finalPath));
+    } else {
+        QVERIFY(sidecar.remove());
+    }
+    QVERIFY(writeImage(finalPath, Qt::green));
+    const KFileItem complete = previewItem(finalPath);
+    TestPreviewJob retry(complete);
+    QSignalSpy retryFailed(&retry, &PreviewJob::failed);
+    QSignalSpy retryPreview(&retry, &PreviewJob::gotPreview);
+    QSignalSpy retryResult(&retry, &KJob::result);
+    QTRY_COMPARE(retryResult.count(), 1);
+    QCOMPARE(retryFailed.count(), 0);
+    QCOMPARE(retryPreview.count(), 1);
+    QCOMPARE(qvariant_cast<QPixmap>(retryPreview.at(0).at(1)).toImage().pixelColor(0, 0), QColor(Qt::green));
+    QTRY_VERIFY(!cachedThumbnailFor(complete, QSize(256, 256)).isNull());
+    const QImage cached(thumbnailPath(complete));
+    QCOMPARE(cached.pixelColor(0, 0), QColor(Qt::green));
+    QCOMPARE(cached.text(QStringLiteral("Thumb::URI")), QString::fromUtf8(cacheUri(complete)));
+    QCOMPARE(cached.text(QStringLiteral("Thumb::Size")), QString::number(complete.size()));
+    QCOMPARE(cached.text(QStringLiteral("Thumb::MTime")), QString::number(complete.time(KFileItem::ModificationTime).toSecsSinceEpoch()));
+}
