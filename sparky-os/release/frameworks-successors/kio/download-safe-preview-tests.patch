+void FilePreviewJobTest::cleanupTestCase()
+{
+    QVERIFY(QFile::remove(m_thumbnailerPath));
+}
+
+namespace
+{
+class TestPreviewJob : public PreviewJob
+{
+public:
+    TestPreviewJob(const KFileItem &item, const std::function<void(FilePreviewJob *)> &configure = {})
+        : PreviewJob({item}, QSize(256, 256), &plugins)
+        , m_configure(configure)
+    {
+        setAutoDelete(false);
+    }
+
+    QPointer<FilePreviewJob> fileJob;
+
+protected:
+    bool addSubjob(KJob *job) override
+    {
+        if (auto *preview = qobject_cast<FilePreviewJob *>(job)) {
+            fileJob = preview;
+            if (m_configure) {
+                m_configure(preview);
+            }
+        }
+        return PreviewJob::addSubjob(job);
+    }
+
+private:
+    static inline const QStringList plugins{QStringLiteral("kiotest")};
+    const std::function<void(FilePreviewJob *)> m_configure;
+};
+
+KFileItem previewItem(const QString &path)
+{
+    KFileItem item(QUrl::fromLocalFile(path));
+    item.determineMimeType();
+    return item;
+}
+
+QString thumbnailPath(const KFileItem &item)
+{
+    return ThumbnailCache::filePath(cacheUri(item), ThumbnailCache::rootPath(), QSize(256, 256), 1.0);
+}
+
+bool writeImage(const QString &path, Qt::GlobalColor color)
+{
+    QImage image(16, 16, QImage::Format_ARGB32);
+    image.fill(color);
+    return image.save(path, "PNG");
+}
+}
