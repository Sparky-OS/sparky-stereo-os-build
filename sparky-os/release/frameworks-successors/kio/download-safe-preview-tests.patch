+#include <QCoreApplication>
+#include <QImage>
+
+int main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    const QStringList args = app.arguments();
+    if (args.size() != 3) {
+        return 1;
+    }
+    const QImage image(args.at(1));
+    return !image.isNull() && image.save(args.at(2), "PNG") ? 0 : 1;
+}
