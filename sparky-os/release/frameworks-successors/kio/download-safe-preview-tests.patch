+void FilePreviewJobTest::testChangingSource_data()
+{
+    QTest::addColumn<QString>("change");
+    QTest::newRow("size") << QStringLiteral("size");
+    QTest::newRow("mtime-only") << QStringLiteral("mtime");
+    QTest::newRow("sidecar-appears") << QStringLiteral("sidecar");
+    QTest::newRow("removed") << QStringLiteral("removed");
+}
+
+void FilePreviewJobTest::testChangingSource()
+{
+    QFETCH(QString, change);
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString path = dir.filePath(QStringLiteral("image.png"));
+    QVERIFY(writeImage(path, Qt::red));
+    const KFileItem item = previewItem(path);
+    TestPreviewJob job(item, [](FilePreviewJob *fileJob) {
+        fileJob->m_partialFileStabilityInterval = 1000;
+    });
+    QSignalSpy failed(&job, &PreviewJob::failed);
+    QSignalSpy preview(&job, &PreviewJob::gotPreview);
+    QSignalSpy result(&job, &KJob::result);
+    QTRY_VERIFY(job.fileJob && job.fileJob->m_partialFileStabilityTimer && job.fileJob->m_partialFileStabilityTimer->isActive());
+    if (change == QStringLiteral("removed")) {
+        QVERIFY(QFile::remove(path));
+    } else if (change == QStringLiteral("sidecar")) {
+        QFile sidecar(path + QStringLiteral(".part"));
+        QVERIFY(sidecar.open(QIODevice::WriteOnly));
+    } else {
+        QFile file(path);
+        QVERIFY(file.open(QIODevice::ReadWrite));
+        if (change == QStringLiteral("size")) {
+            QVERIFY(file.seek(file.size()));
+            QCOMPARE(file.write("more"), 4);
+            QVERIFY(file.flush());
+        } else {
+            QVERIFY(file.setFileTime(QFileInfo(path).lastModified().addSecs(2), QFileDevice::FileModificationTime));
+        }
+    }
+    job.fileJob->m_partialFileStabilityTimer->start(0);
+    QTRY_COMPARE(result.count(), 1);
+    QCOMPARE(failed.count(), 1);
+    QCOMPARE(preview.count(), 0);
+    QVERIFY(!QFileInfo::exists(thumbnailPath(item)));
+    if (change == QStringLiteral("sidecar")) {
+        QVERIFY(QFile::remove(path + QStringLiteral(".part")));
+    }
+    QVERIFY(writeImage(path, Qt::green));
+    const KFileItem complete = previewItem(path);
+    TestPreviewJob retry(complete);
+    QSignalSpy retryPreview(&retry, &PreviewJob::gotPreview);
+    QSignalSpy retryFailed(&retry, &PreviewJob::failed);
+    QSignalSpy retryResult(&retry, &KJob::result);
+    QTRY_COMPARE(retryResult.count(), 1);
+    QCOMPARE(retryFailed.count(), 0);
+    QCOMPARE(retryPreview.count(), 1);
+    QTRY_VERIFY(!cachedThumbnailFor(complete, QSize(256, 256)).isNull());
+    QCOMPARE(QImage(thumbnailPath(complete)).pixelColor(0, 0), QColor(Qt::green));
+}
+
+void FilePreviewJobTest::testUnrelatedPreview()
+{
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString growingPath = dir.filePath(QStringLiteral("growing.png"));
+    const QString stablePath = dir.filePath(QStringLiteral("stable.png"));
+    QVERIFY(writeImage(growingPath, Qt::red));
+    QVERIFY(writeImage(stablePath, Qt::blue));
+    TestPreviewJob waiting(previewItem(growingPath), [](FilePreviewJob *fileJob) {
+        fileJob->m_partialFileStabilityInterval = 4000;
+    });
+    QSignalSpy waitingResult(&waiting, &KJob::result);
+    QTRY_VERIFY(waiting.fileJob && waiting.fileJob->m_partialFileStabilityTimer && waiting.fileJob->m_partialFileStabilityTimer->isActive());
+    TestPreviewJob unrelated(previewItem(stablePath), [](FilePreviewJob *fileJob) {
+        fileJob->m_partialFileStabilityInterval = 0;
+    });
+    QSignalSpy preview(&unrelated, &PreviewJob::gotPreview);
+    QSignalSpy result(&unrelated, &KJob::result);
+    QTRY_COMPARE(result.count(), 1);
+    QCOMPARE(preview.count(), 1);
+    QCOMPARE(waitingResult.count(), 0);
+    QVERIFY(waiting.fileJob->m_partialFileStabilityTimer->isActive());
+    QFile file(growingPath);
+    QVERIFY(file.open(QIODevice::Append));
+    QCOMPARE(file.write("more"), 4);
+    file.close();
+    QSignalSpy failed(&waiting, &PreviewJob::failed);
+    waiting.fileJob->m_partialFileStabilityTimer->start(0);
+    QTRY_COMPARE(waitingResult.count(), 1);
+    QCOMPARE(failed.count(), 1);
+}
