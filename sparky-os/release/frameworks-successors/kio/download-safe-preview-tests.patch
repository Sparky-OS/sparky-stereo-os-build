+void FilePreviewJobTest::testGenerationPaths()
+{
+    QFETCH(bool, cache);
+    QFETCH(int, sequence);
+    QFETCH(int, scaleType);
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString path = dir.filePath(QStringLiteral("image.png"));
+    QVERIFY(writeImage(path, Qt::red));
+    const KFileItem item = previewItem(path);
+    const auto plugins = FilePreviewJob::standardThumbnailers();
+    const auto it = std::find_if(plugins.cbegin(), plugins.cend(), [](const KPluginMetaData &plugin) {
+        return plugin.pluginId() == QStringLiteral("kiotest");
+    });
+    QVERIFY(it != plugins.cend());
+    QJsonObject metadata = it->rawData();
+    metadata.insert(QStringLiteral("CacheThumbnail"), cache);
+    metadata.insert(QStringLiteral("HandleSequences"), true);
+    PreviewSetupData setup;
+    setup.thumbRoot = ThumbnailCache::rootPath();
+    struct stat sourceStat;
+    QVERIFY(::stat(QFile::encodeName(path).constData(), &sourceStat) == 0);
+    setup.thumbRootDeviceId = sourceStat.st_dev;
+    setup.pluginByMimeTable.insert(item.mimetype(), KPluginMetaData(metadata, it->fileName()));
+    PreviewOptions options;
+    options.size = QSize(256, 256);
+    options.sequenceIndex = sequence;
+    options.scaleType = static_cast<PreviewJob::ScaleType>(scaleType);
+    writeCachedThumbnail(item.url(), options.size, 1.0, 0, item.size());
+    QFile cacheFile(thumbnailPath(item));
+    QVERIFY(cacheFile.open(QIODevice::ReadOnly));
+    const QByteArray oldCache = cacheFile.readAll();
+    cacheFile.close();
+    FilePreviewJob blocked(item, sourceStat.st_dev, options, setup);
+    blocked.setAutoDelete(false);
+    blocked.m_currentDeviceCachePolicy = FilePreviewJob::Allow;
+    QFile sidecar(path + QStringLiteral(".part"));
+    QVERIFY(sidecar.open(QIODevice::WriteOnly));
+    sidecar.close();
+    QSignalSpy blockedResult(&blocked, &KJob::result);
+    blocked.start();
+    QTRY_COMPARE(blockedResult.count(), 1);
+    QVERIFY(blocked.previewImage().isNull());
+    QVERIFY(cacheFile.open(QIODevice::ReadOnly));
+    QCOMPARE(cacheFile.readAll(), oldCache);
+    cacheFile.close();
+
+    QVERIFY(sidecar.remove());
+    FilePreviewJob stable(item, sourceStat.st_dev, options, setup);
+    stable.setAutoDelete(false);
+    stable.m_currentDeviceCachePolicy = FilePreviewJob::Allow;
+    stable.m_partialFileStabilityInterval = 0;
+    QSignalSpy stableResult(&stable, &KJob::result);
+    stable.start();
+    QTRY_COMPARE(stableResult.count(), 1);
+    QVERIFY(!stable.previewImage().isNull());
+    QCOMPARE(stable.previewImage().pixelColor(0, 0), QColor(Qt::red));
+}
