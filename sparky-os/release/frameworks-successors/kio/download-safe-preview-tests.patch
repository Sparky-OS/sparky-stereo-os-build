+void FilePreviewJobTest::testCacheHitWithSidecar()
+{
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString path = dir.filePath(QStringLiteral("image.png"));
+    QVERIFY(writeImage(path, Qt::red));
+    const KFileItem item = previewItem(path);
+    writeCachedThumbnail(item.url(), QSize(256, 256), 1.0, item.time(KFileItem::ModificationTime).toSecsSinceEpoch(), item.size());
+    QFile cache(thumbnailPath(item));
+    QVERIFY(cache.open(QIODevice::ReadOnly));
+    const QByteArray contents = cache.readAll();
+    cache.close();
+    QFile sidecar(path + QStringLiteral(".part"));
+    QVERIFY(sidecar.open(QIODevice::WriteOnly));
+    TestPreviewJob job(item);
+    QSignalSpy preview(&job, &PreviewJob::gotPreview);
+    QSignalSpy failed(&job, &PreviewJob::failed);
+    QSignalSpy result(&job, &KJob::result);
+    QTRY_COMPARE(result.count(), 1);
+    QCOMPARE(preview.count(), 1);
+    QCOMPARE(failed.count(), 0);
+    QVERIFY(!job.fileJob);
+    QCOMPARE(qvariant_cast<QPixmap>(preview.at(0).at(1)).toImage().pixelColor(0, 0), QColor(Qt::blue));
+    QVERIFY(cache.open(QIODevice::ReadOnly));
+    QCOMPARE(cache.readAll(), contents);
+}
