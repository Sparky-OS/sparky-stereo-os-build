+// A thumbnail plugin takes precedence over a standard thumbnailer for the same MIME type, also where the plugin names
+// it only by its group (video/*) and the standard thumbnailer on its own (video/mp4)
+static KPluginMetaData makeThumbnailer(const QString &id, const QStringList &mimeTypes, bool standard)
+{
+    QJsonObject kplugin;
+    kplugin[QStringLiteral("Id")] = id;
+    kplugin[QStringLiteral("MimeTypes")] = QJsonArray::fromStringList(mimeTypes);
+    if (standard) {
+        kplugin[QStringLiteral("Category")] = QStringLiteral("standardthumbnailer");
+    }
+    QJsonObject root;
+    root[QStringLiteral("KPlugin")] = kplugin;
+    return KPluginMetaData(root, id);
+}
+
+void FilePreviewJobTest::testPluginBeforeStandardThumbnailer_data()
+{
+    QTest::addColumn<QStringList>("pluginMimeTypes");
+    QTest::addColumn<QStringList>("standardMimeTypes");
+    QTest::addColumn<QString>("expected");
+    QTest::addColumn<bool>("exactMatch");
+
+    QTest::newRow("plugin by group, standard thumbnailer by name") << QStringList{QStringLiteral("video/*")} << QStringList{QStringLiteral("video/mp4")}
+                                                                   << QStringLiteral("plugin") << false;
+    QTest::newRow("both by name") << QStringList{QStringLiteral("video/mp4")} << QStringList{QStringLiteral("video/mp4")} << QStringLiteral("plugin") << true;
+    QTest::newRow("no plugin for the type") << QStringList{QStringLiteral("image/*")} << QStringList{QStringLiteral("video/mp4")}
+                                            << QStringLiteral("standard") << true;
+    QTest::newRow("standard thumbnailer by group") << QStringList{QStringLiteral("image/png")} << QStringList{QStringLiteral("video/*")}
+                                                   << QStringLiteral("standard") << false;
+}
+
+void FilePreviewJobTest::testPluginBeforeStandardThumbnailer()
+{
+    QFETCH(QStringList, pluginMimeTypes);
+    QFETCH(QStringList, standardMimeTypes);
+    QFETCH(QString, expected);
+    QFETCH(bool, exactMatch);
+
+    QTemporaryDir thumbRoot;
+    QVERIFY(thumbRoot.isValid());
+    const KFileItem item(QUrl::fromLocalFile(thumbRoot.filePath(QStringLiteral("video.mp4"))));
+
+    PreviewOptions options;
+    options.size = QSize(128, 128);
+    PreviewSetupData setupData;
+    setupData.thumbRoot = thumbRoot.path();
+    const KPluginMetaData plugin = makeThumbnailer(QStringLiteral("plugin"), pluginMimeTypes, false);
+    for (const QString &mimeType : pluginMimeTypes) {
+        setupData.pluginByMimeTable.insert(mimeType, plugin);
+    }
+    const KPluginMetaData standard = makeThumbnailer(QStringLiteral("standard"), standardMimeTypes, true);
+    for (const QString &mimeType : standardMimeTypes) {
+        setupData.standardThumbnailerByMimeTable.insert(mimeType, standard);
+    }
+
+    // what the job makes the thumbnail with, and what a lookup in the thumbnail cache takes the thumbnail's version from
+    auto *job = new FilePreviewJob(item, FilePreviewJob::UnknownDeviceId, options, setupData);
+    QVERIFY(job->preparePluginForMimetype(QStringLiteral("video/mp4")));
+    QCOMPARE(job->m_plugin.pluginId(), expected);
+    QCOMPARE(job->m_standardThumbnailer, expected == QLatin1String("standard"));
+    delete job;
+    bool exact = !exactMatch;
+    const KPluginMetaData *found = FilePreviewJob::pluginForMimeType(setupData, QStringLiteral("video/mp4"), &exact);
+    QVERIFY(found);
+    QCOMPARE(found->pluginId(), expected);
+    QCOMPARE(exact, exactMatch);
+}
 
