+// The plugin a table has for a MIME type: its own, then one of its parents', then the one for its group
+static const KPluginMetaData *findPluginForMimeType(const QMap<QString, KPluginMetaData> &pluginByMimeTable, const QString &mimeType, bool *exactMatch)
+{
+    auto pluginIt = pluginByMimeTable.constFind(mimeType);
+    if (exactMatch) {
+        *exactMatch = pluginIt != pluginByMimeTable.constEnd();
+    }
+    if (pluginIt == pluginByMimeTable.constEnd()) {
+        // check MIME type inheritance, resolve aliases
+        QMimeDatabase db;
+        const QMimeType mimeInfo = db.mimeTypeForName(mimeType);
+        if (mimeInfo.isValid()) {
+            const QStringList parentMimeTypes = mimeInfo.allAncestors();
+            for (const QString &parentMimeType : parentMimeTypes) {
+                pluginIt = pluginByMimeTable.constFind(parentMimeType);
+                if (pluginIt != pluginByMimeTable.constEnd()) {
+                    break;
+                }
+            }
+        }
+
+        if (pluginIt == pluginByMimeTable.constEnd()) {
+            // Check the wildcards last, see BUG 453480
+            QString groupMimeType = mimeType;
+            const int slashIdx = groupMimeType.indexOf(QLatin1Char('/'));
+            if (slashIdx != -1) {
+                // Replace everything after '/' with '*'
+                groupMimeType.truncate(slashIdx + 1);
+                groupMimeType += QLatin1Char('*');
+            }
+            pluginIt = pluginByMimeTable.constFind(groupMimeType);
+        }
+    }
+    return pluginIt != pluginByMimeTable.constEnd() ? &pluginIt.value() : nullptr;
+}
+
+const KPluginMetaData *FilePreviewJob::pluginForMimeType(const PreviewSetupData &setupData, const QString &mimeType, bool *exactMatch)
+{
+    // Thumbnail plugins take precedence over standard thumbnailers, also where a plugin names the MIME type only by its
+    // group (video/*) and a standard thumbnailer names it on its own (video/mp4)
+    if (const KPluginMetaData *plugin = findPluginForMimeType(setupData.pluginByMimeTable, mimeType, exactMatch)) {
+        return plugin;
+    }
+    return findPluginForMimeType(setupData.standardThumbnailerByMimeTable, mimeType, exactMatch);
 }
 
