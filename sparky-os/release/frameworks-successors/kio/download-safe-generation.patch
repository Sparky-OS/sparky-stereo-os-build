+bool FilePreviewJob::isPartialFile(const QFileInfo &file)
+{
+    const QStringList patterns = QMimeDatabase().mimeTypeForName(u"application/x-partial-download"_s).globPatterns();
+    for (const QString &pattern : patterns) {
+        if (!pattern.startsWith(QLatin1Char('*'))) {
+            continue;
+        }
+        const QString suffix = pattern.mid(1);
+        if (!suffix.isEmpty() && (file.fileName().endsWith(suffix) || QFileInfo::exists(file.absoluteFilePath() + suffix))) {
+            return true;
+        }
+    }
+    return false;
 }
 
