+void FilePreviewJob::slotPartialFileStabilityTimeout()
+{
+    const QFileInfo info(m_fileItem.localPath());
+    const qulonglong size = static_cast<qulonglong>(info.size());
+    const QDateTime mtime = info.lastModified();
+    if (!info.isFile() || isPartialFile(info) || m_partialFileSize != size || m_partialFileMTime != mtime) {
+        emitResult();
+        return;
+    }
+
+    finishStatFile();
