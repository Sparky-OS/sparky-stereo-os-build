diff --git a/CMakeLists.txt b/CMakeLists.txt
index e82f5f9..5c6d7c0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -72,6 +72,9 @@ find_package(KF6 REQUIRED COMPONENTS
 
 find_package(KF6KirigamiAddons 1.11.0 REQUIRED)
 
+# the catalogs of po/, installed when gettext is there to compile them
+ki18n_install(po)
+
 install(FILES
     img/karton_logo.svg
     DESTINATION ${KDE_INSTALL_ICONDIR}/hicolor/scalable/apps
