From 73518890286a20e499d21bea4f31c569c3e466fa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Wed, 23 Sep 2026 16:16:48 +0200
Subject: [PATCH] demux_lavf: read the stereo 3D mode from the stream
 side data

libavcodec maps the stream side data onto every frame it allocates
through ff_get_buffer(), so this changes nothing for most decoders.
Decoders that build their frames by hand, v4l2m2m and rkmpp, never see
it, and the container fallback in fix_image_params() is all they get.
This also matches demux_mkv, which fills the field from StereoMode.

(cherry picked from commit 2a4eb8067ca68ec19adf23daf8ccbb1a05afd6ed)
---
 demux/demux_lavf.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/demux/demux_lavf.c b/demux/demux_lavf.c
index 7013dbd7dc..4ab2cd2921 100644
--- a/demux/demux_lavf.c
+++ b/demux/demux_lavf.c
@@ -37,6 +37,7 @@
 #include <libavutil/opt.h>
 #include <libavutil/pixdesc.h>
 #include <libavutil/replaygain.h>
+#include <libavutil/stereo3d.h>
 
 #include "audio/chmap_avchannel.h"
 
@@ -54,6 +55,7 @@
 #include "options/m_config.h"
 #include "options/m_option.h"
 #include "options/path.h"
+#include "video/csputils.h"
 
 #define INITIAL_PROBE_SIZE STREAM_BUFFER_SIZE
 #define PROBE_BUF_SIZE (10 * 1024 * 1024)
@@ -761,6 +763,9 @@ static void handle_new_stream(demuxer_t *demuxer, int i)
                 sh->codec->rotate = (((int)(-r) % 360) + 360) % 360;
         }
 
+        if ((sd = mp_av_stream_get_side_data(st, AV_PKT_DATA_STEREO3D)))
+            sh->codec->stereo_mode = mp_stereo3d_from_av((const AVStereo3D *)sd);
+
         if ((sd = mp_av_stream_get_side_data(st, AV_PKT_DATA_DOVI_CONF))) {
             const AVDOVIDecoderConfigurationRecord *cfg = (void *) sd;
             MP_VERBOSE(demuxer, "Found Dolby Vision config record: profile "
