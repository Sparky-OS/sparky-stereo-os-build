From d4eb19a4d59366b6110a007f90ae0a472cb2aa87 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 5 Oct 2026 04:51:23 -0300
Subject: [PATCH] vo_gpu: add a way to render only the OSD and subtitles

RENDER_FRAME_CONTROLS renders the OSD and subtitles alone, over a
transparent target, once and not per view of a 3D video, for a window
surface that lies above the video's.

Assisted-by: Claude Sonnet via Claude Code
---
 video/out/gpu/video.c | 17 +++++++++++------
 video/out/gpu/video.h |  3 +++
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/video/out/gpu/video.c b/video/out/gpu/video.c
index ec0e656c5e..31637f4505 100644
--- a/video/out/gpu/video.c
+++ b/video/out/gpu/video.c
@@ -2996,7 +2996,8 @@ static void pass_draw_osd(struct gl_video *p, int osd_flags, int frame_flags,
     if ((osd_flags & OSD_DRAW_SUB_ONLY) && (osd_flags & OSD_DRAW_OSD_ONLY))
         return;
 
-    mpgl_osd_generate(p->osd, rect, pts, p->image_params.stereo3d, osd_flags);
+    int stereo3d = frame_flags & RENDER_FRAME_CONTROLS ? 0 : p->image_params.stereo3d;
+    mpgl_osd_generate(p->osd, rect, pts, stereo3d, osd_flags);
 
     timer_pool_start(p->osd_timer);
     for (int n = 0; n < MAX_OSD_PARTS; n++) {
@@ -3418,16 +3419,19 @@ void gl_video_render_frame(struct gl_video *p, struct vo_frame *frame,
 
     p->broken_frame = false;
 
-    bool has_frame = !!frame->current;
+    bool controls = flags & RENDER_FRAME_CONTROLS;
+    bool has_frame = !!frame->current && !controls;
 
     struct m_color c = p->clear_color;
+    if (controls)
+        c = (struct m_color){0};
     float clear_color[4] = {c.r / 255.0, c.g / 255.0, c.b / 255.0, c.a / 255.0};
     clear_color[0] *= clear_color[3];
     clear_color[1] *= clear_color[3];
     clear_color[2] *= clear_color[3];
     p->ra->fns->clear(p->ra, fbo->tex, clear_color, &target_rc);
 
-    if (p->hwdec_overlay) {
+    if (p->hwdec_overlay && !controls) {
         if (has_frame) {
             float *color = p->hwdec_overlay->overlay_colorkey;
             p->ra->fns->clear(p->ra, fbo->tex, color, &p->dst_rect);
@@ -3519,10 +3523,10 @@ done:
         // If we haven't actually drawn anything so far, then we technically
         // need to consider this the start of a new pass. Let's call it a
         // redraw just because, since it's basically a blank frame anyway
-        if (!has_frame)
+        if (!has_frame && !controls)
             pass_info_reset(p, true);
 
-        int osd_flags = p->opts.blend_subs ? OSD_DRAW_OSD_ONLY : 0;
+        int osd_flags = p->opts.blend_subs && !controls ? OSD_DRAW_OSD_ONLY : 0;
         if (!(flags & RENDER_FRAME_SUBS))
             osd_flags |= OSD_DRAW_OSD_ONLY;
         if (!(flags & RENDER_FRAME_OSD))
@@ -3540,7 +3544,8 @@ done:
         p->ra->fns->clear(p->ra, fbo->tex, color, &target_rc);
     }
 
-    p->frames_rendered++;
+    if (!controls)
+        p->frames_rendered++;
     pass_report_performance(p);
 }
 
diff --git a/video/out/gpu/video.h b/video/out/gpu/video.h
index 996e46e6ac..1e26726343 100644
--- a/video/out/gpu/video.h
+++ b/video/out/gpu/video.h
@@ -191,6 +191,9 @@ enum {
     RENDER_FRAME_OSD = 1 << 1,
     RENDER_FRAME_VF_SUBS = 1 << 2,
     RENDER_SCREEN_COLOR = 1 << 3, // 3D LUT and dithering
+    // Only the OSD and subtitles, over a transparent target, once each for the
+    // window's surface above the video layer
+    RENDER_FRAME_CONTROLS = 1 << 4,
     RENDER_FRAME_DEF = RENDER_FRAME_SUBS | RENDER_FRAME_OSD | RENDER_SCREEN_COLOR,
 };
 
