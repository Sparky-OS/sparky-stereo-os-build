From 26a78135025f86dbd261da3c515e74e1658beffc Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 5 Oct 2026 03:19:36 -0300
Subject: [PATCH] vo_gpu_next: draw the video and the controls into
 separate layers with OpenGL

The same two layers as with Vulkan, for the contexts that go through
the OpenGL ra_ctx. libplacebo gets a second swapchain for the video
layer, and the surface of each is made current before its rendering,
since both belong to one GL context. The dither depth is that of the
video layer, which is what is dithered.

Assisted-by: Claude Sonnet via Claude Code
---
 DOCS/man/options.rst         |  4 ++--
 video/out/gpu_next/context.c | 26 ++++++++++++++++++++++++++
 video/out/gpu_next/context.h |  1 +
 video/out/vo_gpu_next.c      | 20 +++++++++++++++-----
 4 files changed, 44 insertions(+), 7 deletions(-)

diff --git a/DOCS/man/options.rst b/DOCS/man/options.rst
index 6e955fc1ba..73a3346467 100644
--- a/DOCS/man/options.rst
+++ b/DOCS/man/options.rst
@@ -1808,8 +1808,8 @@ Video
     ``--vf=format:stereo-in=<mode>`` (``sbsl`` and ``abl`` are the full size
     modes; ``--vf=format:stereo-in=help`` lists them). Where the video and
     the window have their own surfaces (``--vo=dmabuf-wayland``, and
-    ``--vo=gpu-next`` with Vulkan on a Wayland compositor that accepts the
-    declaration) only the video surface is declared, and the subtitles, the
+    ``--vo=gpu-next`` with Vulkan or OpenGL on a Wayland compositor that
+    accepts the declaration) only the video surface is declared, and the subtitles, the
     OSD and the on-screen controller stay in the window's surface, which the
     compositor shows the same in both eyes. Elsewhere they are drawn once per
     eye, at one eye's size. Videos that do not signal 3D are not touched.
diff --git a/video/out/gpu_next/context.c b/video/out/gpu_next/context.c
index 47e155c9fd..cc333968f6 100644
--- a/video/out/gpu_next/context.c
+++ b/video/out/gpu_next/context.c
@@ -168,6 +168,15 @@ struct gpu_ctx *gpu_ctx_create(struct vo *vo, struct ra_ctx_opts *ctx_opts)
         if (!ctx->swapchain)
             goto err_out;
 
+        if (ctx->ra_ctx->video_swapchain) {
+            ctx->video_swapchain = pl_opengl_create_swapchain(opengl, pl_opengl_swapchain_params(
+                .max_swapchain_depth = vo->opts->swapchain_depth,
+                .framebuffer.flipped = gl->flipped,
+            ));
+            if (!ctx->video_swapchain)
+                goto err_out;
+        }
+
         return ctx;
     }
 #elif HAVE_GL
@@ -193,6 +202,21 @@ bool gpu_ctx_resize(struct gpu_ctx *ctx, int w, int h)
     return pl_swapchain_resize(ctx->swapchain, &w, &h);
 }
 
+bool gpu_ctx_resize_video(struct gpu_ctx *ctx, int w, int h)
+{
+    struct ra_ctx *ra_ctx = ctx->ra_ctx;
+    if (!ra_ctx->fns->resize_video(ra_ctx, w, h))
+        return false;
+
+#if HAVE_VULKAN
+    if (ra_vk_ctx_get(ra_ctx))
+        // vulkan RA handles this by itself
+        return true;
+#endif
+
+    return pl_swapchain_resize(ctx->video_swapchain, &w, &h);
+}
+
 void gpu_ctx_destroy(struct gpu_ctx **ctxp)
 {
     struct gpu_ctx *ctx = *ctxp;
@@ -208,6 +232,8 @@ void gpu_ctx_destroy(struct gpu_ctx **ctxp)
         goto skip_common_pl_cleanup;
 #endif
 
+    if (ctx->video_swapchain)
+        pl_swapchain_destroy(&ctx->video_swapchain);
     if (ctx->swapchain)
         pl_swapchain_destroy(&ctx->swapchain);
 
diff --git a/video/out/gpu_next/context.h b/video/out/gpu_next/context.h
index c2fbaf728a..0dec9b6985 100644
--- a/video/out/gpu_next/context.h
+++ b/video/out/gpu_next/context.h
@@ -38,4 +38,5 @@ struct gpu_ctx {
 
 struct gpu_ctx *gpu_ctx_create(struct vo *vo, struct ra_ctx_opts *ctx_opts);
 bool gpu_ctx_resize(struct gpu_ctx *ctx, int w, int h);
+bool gpu_ctx_resize_video(struct gpu_ctx *ctx, int w, int h);
 void gpu_ctx_destroy(struct gpu_ctx **ctxp);
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index b8c53f4695..aef822c0ec 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -932,7 +932,8 @@ static void apply_target_options(struct priv *p, struct pl_frame *target,
     }
     int dither_depth = opts->dither_depth;
     if (dither_depth == 0) {
-        struct ra_swapchain *sw = p->ra_ctx->swapchain;
+        struct ra_swapchain *sw = p->ra_ctx->video_swapchain ? p->ra_ctx->video_swapchain
+                                                             : p->ra_ctx->swapchain;
         if (sw->fns->color_depth && sw->fns->color_depth(sw) != -1) {
             dither_depth = sw->fns->color_depth(sw);
         } else if (!pl_color_transfer_is_hdr(target->color.transfer)) {
@@ -1275,6 +1276,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
 
     // With a video layer, swframe is the video and ctlframe the controls over it
     bool layered = p->sw_video;
+    struct ra_swapchain *vsw = p->ra_ctx->video_swapchain;
     bool stereo = layered && (frame->current ?
                   frame->current->params.stereo3d == MP_STEREO3D_SBSL :
                   p->stereo_declared);
@@ -1289,7 +1291,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         if (w != p->video_w || h != p->video_h) {
             p->video_w = w;
             p->video_h = h;
-            pl_swapchain_resize(p->sw_video, &w, &h);
+            gpu_ctx_resize_video(p->context, w, h);
         }
         if (!pl_swapchain_start_frame(p->sw_video, &swframe)) {
             // Show the controls alone, the swapchain is waiting for them
@@ -1484,6 +1486,8 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     }
 
     // Render frame
+    if (layered)
+        vsw->fns->start_frame(vsw, NULL); // for contexts with a surface each
     if (!pl_render_image_mix(p->rr, &mix, &target, &params)) {
         MP_ERR(vo, "Failed rendering frame!\n");
         goto done;
@@ -1498,6 +1502,7 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
         ctlparams.background_color[1] = 0;
         ctlparams.background_color[2] = 0;
         ctlparams.background_transparency = 1;
+        sw->fns->start_frame(sw, NULL);
         if (!pl_render_image(p->rr, NULL, &ctltarget, &ctlparams)) {
             MP_ERR(vo, "Failed rendering controls!\n");
             goto done;
@@ -1530,10 +1535,14 @@ static bool draw_frame(struct vo *vo, struct vo_frame *frame)
     // fall through
 
 done:
+    if (layered && !valid)
+        vsw->fns->start_frame(vsw, NULL);
     if (!valid) // clear with purple to indicate error
         pl_tex_clear(gpu, swframe.fbo, (float[4]){ 0.5, 0.0, 1.0, 1.0 });
-    if (layered && !valid)
+    if (layered && !valid) {
+        sw->fns->start_frame(sw, NULL);
         pl_tex_clear(gpu, ctlframe.fbo, (float[4]){0});
+    }
 
     // The declaration changes with the frame that needs it
     if (layered && stereo != p->stereo_declared) {
@@ -1567,8 +1576,9 @@ static void flip_page(struct vo *vo)
         p->frame_pending = false;
     }
 
-    if (p->sw_video)
-        pl_swapchain_swap_buffers(p->sw_video);
+    struct ra_swapchain *vsw = p->ra_ctx->video_swapchain;
+    if (vsw)
+        vsw->fns->swap_buffers(vsw);
     sw->fns->swap_buffers(sw);
 }
 
