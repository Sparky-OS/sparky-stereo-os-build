FROM debian:testing
ENV DEBIAN_FRONTEND=noninteractive
COPY bin/dmo-setup.sh /usr/local/bin/dmo-setup.sh
RUN --mount=type=bind,from=https-only-apt,source=https-only-apt.sh,target=/run/https-only-apt.sh \
    --mount=type=bind,from=host-ca,source=ca-certificates.crt,target=/run/host-ca.crt \
    sh /run/https-only-apt.sh && /usr/local/bin/dmo-setup.sh && apt-get -y install --no-install-recommends build-essential devscripts quilt fakeroot git rsync file pkg-config lintian binutils >/dev/null && rm -rf /var/lib/apt/lists/*
