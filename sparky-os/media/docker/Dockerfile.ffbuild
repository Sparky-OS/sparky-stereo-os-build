FROM mdmo-base:1
ENV DEBIAN_FRONTEND=noninteractive
# dmo's ffmpeg-dmo Build-Depends: libnvidia-glvkspirv [amd64 i386] lives in Debian's non-free component
RUN sed -i 's/^Components: main$/Components: main contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources \
 && apt-get update -qq && apt-get -y dist-upgrade >/dev/null && apt-get -y build-dep ffmpeg-dmo > /build-dep-ffmpeg.log 2>&1; tail -3 /build-dep-ffmpeg.log; \
    apt-get -y purge libfdk-aac-dev libfdk-aac2 > /purge-fdk.log 2>&1; tail -2 /purge-fdk.log; \
    dpkg -l | awk '/^ii/{print $2" "$3}' > /pkgs-ffbuild.txt; rm -rf /var/lib/apt/lists/*; test -x /usr/bin/nasm && ! dpkg -s libfdk-aac-dev >/dev/null 2>&1
