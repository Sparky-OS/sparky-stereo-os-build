diff --git a/libavcodec/tests/get_format.c b/libavcodec/tests/get_format.c
new file mode 100644
index 0000000000..818bd79ea7
--- /dev/null
+++ b/libavcodec/tests/get_format.c
@@ -0,0 +1,157 @@
+/*
