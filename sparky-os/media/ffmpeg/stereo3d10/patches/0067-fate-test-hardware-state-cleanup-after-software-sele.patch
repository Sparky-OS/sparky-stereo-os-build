+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+
+#include "libavutil/hwcontext.h"
+#include "libavutil/pixdesc.h"
+#include "libavcodec/avcodec.h"
+#include "libavcodec/codec_internal.h"
+#include "libavcodec/decode.h"
+#include "libavcodec/hwaccel_internal.h"
+#include "libavcodec/hwconfig.h"
+#include "libavcodec/internal.h"
+
+typedef struct TestContext {
+    enum AVPixelFormat choice;
+    int query;
+    int fail_query;
+    int keep_frames;
+    int queries;
+    int initialized;
+    int uninitialized;
+} TestContext;
+
+static int frame_params(AVCodecContext *avctx, AVBufferRef *ref)
+{
+    TestContext *test = avctx->opaque;
+    AVHWFramesContext *frames = (AVHWFramesContext *)ref->data;
+
+    test->queries++;
+    if (!avctx->internal->hwaccel_priv_data)
+        return AVERROR_BUG;
+    if (test->fail_query)
+        return AVERROR(EINVAL);
+    frames->format    = AV_PIX_FMT_DRM_PRIME;
+    frames->sw_format = AV_PIX_FMT_YUV420P;
+    frames->width    = 16;
+    frames->height   = 16;
+    return 0;
+}
+
+static int hwaccel_init(AVCodecContext *avctx)
+{
+    TestContext *test = avctx->opaque;
+    test->initialized++;
+    return 0;
+}
+
+static int hwaccel_uninit(AVCodecContext *avctx)
+{
+    TestContext *test = avctx->opaque;
+    test->uninitialized++;
+    return 0;
+}
+
+static const FFHWAccel hwaccel = {
+    .p.name         = "test",
+    .p.pix_fmt      = AV_PIX_FMT_DRM_PRIME,
+    .priv_data_size = 1,
+    .frame_params   = frame_params,
+    .init           = hwaccel_init,
+    .uninit         = hwaccel_uninit,
+};
+
+static const AVCodecHWConfigInternal hwconfig = {
+    .public = {
+        .pix_fmt     = AV_PIX_FMT_DRM_PRIME,
+        .methods     = AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX |
+                       AV_CODEC_HW_CONFIG_METHOD_HW_FRAMES_CTX,
+        .device_type = AV_HWDEVICE_TYPE_DRM,
+    },
+    .hwaccel = &hwaccel,
+};
+
+static const FFCodec codec = {
+    .p.name = "test",
+    .hw_configs = (const AVCodecHWConfigInternal *const []) { &hwconfig, NULL },
+};
+
+static enum AVPixelFormat get_format(AVCodecContext *avctx,
+                                    const enum AVPixelFormat *formats)
+{
+    TestContext *test = avctx->opaque;
+    AVBufferRef *frames = NULL;
+    int ret;
+
+    if (test->query) {
+        ret = avcodec_get_hw_frames_parameters(avctx, avctx->hw_device_ctx,
+                                               formats[0], &frames);
+        if ((ret < 0) != test->fail_query)
+            return AV_PIX_FMT_NONE;
+        if (test->keep_frames)
+            avctx->hw_frames_ctx = frames;
+        else
+            av_buffer_unref(&frames);
+    }
+    return test->choice;
+}
+
+static int run_test(const char *name, enum AVPixelFormat choice,
+                    int query, int fail_query, int keep_frames)
+{
+    static const enum AVPixelFormat formats[] = {
+        AV_PIX_FMT_DRM_PRIME, AV_PIX_FMT_YUV420P, AV_PIX_FMT_NONE
+    };
+    TestContext test = { .choice = choice, .query = query,
+                         .fail_query = fail_query, .keep_frames = keep_frames };
+    AVCodecInternal internal = { 0 };
+    AVCodecContext avctx = { .codec = &codec.p, .internal = &internal,
+                             .opaque = &test, .get_format = get_format };
+    enum AVPixelFormat ret;
+
+    /* Frame parameter queries need no hardware with an uninitialized DRM device. */
+    avctx.hw_device_ctx = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_DRM);
+    if (!avctx.hw_device_ctx)
+        return 1;
+
+    ret = ff_get_format(&avctx, formats);
+    printf("%s: format=%s queries=%d private=%d hwaccel=%d frames=%d init=%d refs=%d\n",
+           name, ret == AV_PIX_FMT_NONE ? "none" : av_get_pix_fmt_name(ret),
+           test.queries, !!internal.hwaccel_priv_data, !!avctx.hwaccel,
+           !!avctx.hw_frames_ctx, test.initialized,
+           av_buffer_get_ref_count(avctx.hw_device_ctx));
+    ff_hwaccel_uninit(&avctx);
+    printf("  cleanup: uninit=%d refs=%d\n", test.uninitialized,
+           av_buffer_get_ref_count(avctx.hw_device_ctx));
+    av_buffer_unref(&avctx.hw_device_ctx);
+    return 0;
+}
+
+int main(void)
+{
+    av_log_set_level(AV_LOG_QUIET);
+    return run_test("software", AV_PIX_FMT_YUV420P, 0, 0, 0) ||
+           run_test("query/software", AV_PIX_FMT_YUV420P, 1, 0, 0) ||
+           run_test("query/frames/software", AV_PIX_FMT_YUV420P, 1, 0, 1) ||
+           run_test("failed-query/software", AV_PIX_FMT_YUV420P, 1, 1, 0) ||
+           run_test("query/none", AV_PIX_FMT_NONE, 1, 0, 1) ||
+           run_test("query/invalid", AV_PIX_FMT_RGB24, 1, 0, 1) ||
+           run_test("query/invalid-format", AV_PIX_FMT_NB, 1, 0, 1) ||
+           run_test("query/hardware", AV_PIX_FMT_DRM_PRIME, 1, 0, 1);
+}
