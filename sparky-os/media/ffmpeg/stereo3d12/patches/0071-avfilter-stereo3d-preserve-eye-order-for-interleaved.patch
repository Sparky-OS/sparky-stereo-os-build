diff --git a/tests/fate/filter-video.mak b/tests/fate/filter-video.mak
index 74dc41d..e834be7 100644
--- a/tests/fate/filter-video.mak
+++ b/tests/fate/filter-video.mak
@@ -624,6 +624,15 @@ FATE_STEREO3D-$(call FILTERDEMDEC, SCALE STEREO3D, IMAGE2, PGMYUV) += $(FATE_STE
 fate-filter-stereo3d: $(FATE_STEREO3D-yes)
 FATE_FILTER_VSYNTH-yes += $(FATE_STEREO3D-yes)
 
+# Analytic right-first columns: red left view, blue right view, different white boxes.
+FATE_STEREO3D_ICR-$(call ALLYES, NULLSRC_FILTER GEQ_FILTER FORMAT_FILTER SCALE_FILTER \
+                              STEREO3D_FILTER RAWVIDEO_ENCODER FRAMEMD5_MUXER \
+                              FILE_PROTOCOL PIPE_PROTOCOL) += fate-filter-stereo3d-icr-sbsl
+fate-filter-stereo3d-icr-sbsl: tests/data/filtergraphs/stereo3d-icr
+fate-filter-stereo3d-icr-sbsl: CMD = framemd5 -/filter_complex $(TARGET_PATH)/tests/data/filtergraphs/stereo3d-icr -frames:v 1 -pix_fmt rgb24
+FATE_FILTER-yes += $(FATE_STEREO3D_ICR-yes)
+fate-filter-stereo3d: $(FATE_STEREO3D_ICR-yes)
+
 FATE_FILTER_VSYNTH_VIDEO_FILTER-$(call ALLYES, SCALE_FILTER THUMBNAIL_FILTER) += fate-filter-thumbnail
