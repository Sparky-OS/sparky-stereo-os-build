Description: fate/filter: test more eye order selections of stereo3d
 Add the two graphs that cover the corrected selections of interleaved
 columns: icr to side by side with the right view first, and icl to icr
 with the pairing of the columns exchanged. Each of the old expressions
 restored alone makes one of them fail, and the existing tests still
 pass. The graphs need no sample.
 .
 The references are separate files, so that the exchanged eyes cannot
 match the hash of the other order.
 .
 Signed-off-by: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
 Assisted-by: Claude Sonnet 5.5 via Claude Code
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: other, https://code.ffmpeg.org/danielcamposramos/FFmpeg/commit/3cd1362c436bbdc6704ffc10c396ad03f1e87ecb
Forwarded: https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/25377
Last-Update: 2026-11-06

diff --git a/tests/fate/filter-video.mak b/tests/fate/filter-video.mak
index 8b87ba3..f3d88b4 100644
--- a/tests/fate/filter-video.mak
+++ b/tests/fate/filter-video.mak
@@ -633,6 +633,18 @@ fate-filter-stereo3d-icr-sbsl: CMD = framemd5 -/filter_complex $(TARGET_PATH)/te
 FATE_FILTER-yes += $(FATE_STEREO3D_ICR-yes)
 fate-filter-stereo3d: $(FATE_STEREO3D_ICR-yes)
 
+# Right-first columns to side by side with the right view first, and
+# columns to columns with the pairing of the columns exchanged.
+FATE_STEREO3D_ICR_MORE-$(call ALLYES, NULLSRC_FILTER GEQ_FILTER FORMAT_FILTER SCALE_FILTER \
+                              STEREO3D_FILTER RAWVIDEO_ENCODER FRAMEMD5_MUXER \
+                              FILE_PROTOCOL PIPE_PROTOCOL) += fate-filter-stereo3d-icr-sbsr fate-filter-stereo3d-icl-icr
+fate-filter-stereo3d-icr-sbsr: tests/data/filtergraphs/stereo3d-icr-sbsr
+fate-filter-stereo3d-icr-sbsr: CMD = framemd5 -/filter_complex $(TARGET_PATH)/tests/data/filtergraphs/stereo3d-icr-sbsr -frames:v 1 -pix_fmt rgb24
+fate-filter-stereo3d-icl-icr: tests/data/filtergraphs/stereo3d-icl-icr
+fate-filter-stereo3d-icl-icr: CMD = framemd5 -/filter_complex $(TARGET_PATH)/tests/data/filtergraphs/stereo3d-icl-icr -frames:v 1 -pix_fmt rgb24
+FATE_FILTER-yes += $(FATE_STEREO3D_ICR_MORE-yes)
+fate-filter-stereo3d: $(FATE_STEREO3D_ICR_MORE-yes)
+
 FATE_STEREO3D_IRR-$(call ALLYES, NULLSRC_FILTER GEQ_FILTER FORMAT_FILTER SCALE_FILTER \
                               SPLIT_FILTER HSTACK_FILTER STEREO3D_FILTER \
                               RAWVIDEO_ENCODER FRAMEMD5_MUXER FILE_PROTOCOL PIPE_PROTOCOL) += fate-filter-stereo3d-irr-mono
