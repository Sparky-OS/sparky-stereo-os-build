+// Note the self-contained flags of the messages in the access unit and, when
+// track is set, the arrangements that stay in force after it.
+static int h264_metadata_track_frame_packing(AVBSFContext *bsf,
+                                             CodedBitstreamFragment *au,
+                                             int track)
+{
+    H264MetadataContext *ctx = bsf->priv_data;
+    SEIRawMessage *message = NULL;
+
+    while (ff_cbs_sei_find_message(ctx->common.output, au,
+                                   SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                                   &message) == 0) {
+        const H264RawSEIFramePackingArrangement *payload = message->payload;
+        int err;
+
+        if (!payload->frame_packing_arrangement_cancel_flag)
+            ff_cbs_sei_frame_packing_note_flags(&ctx->frame_packing_state,
+                                                payload->frame0_self_contained_flag,
+                                                payload->frame1_self_contained_flag);
+        if (!track ||
+            !ff_cbs_sei_frame_packing_id_valid(payload->frame_packing_arrangement_id))
+            continue;
+        err = ff_cbs_sei_frame_packing_track(bsf, &ctx->frame_packing_state,
+                                             payload->frame_packing_arrangement_id,
+                                             payload->frame_packing_arrangement_cancel_flag,
+                                             payload->frame_packing_arrangement_repetition_period);
+        if (err < 0)
+            return err;
+    }
+
+    return 0;
+}
+
+// Cancel the arrangements that are in force, except the one with id 0, which
+// the message to be added replaces.
+static int h264_metadata_cancel_frame_packing(AVBSFContext *bsf,
+                                              CodedBitstreamFragment *au)
+{
+    H264MetadataContext *ctx = bsf->priv_data;
+    const SEIFramePackingState *state = &ctx->frame_packing_state;
+
+    for (int i = 0; i < state->nb_ids; i++) {
+        H264RawSEIFramePackingArrangement *cancel;
+        int err;
+
+        if (!state->ids[i])
+            continue;
+        cancel = av_refstruct_allocz(sizeof(*cancel));
+        if (!cancel)
+            return AVERROR(ENOMEM);
+        cancel->frame_packing_arrangement_id          = state->ids[i];
+        cancel->frame_packing_arrangement_cancel_flag = 1;
+        err = ff_cbs_sei_add_message(ctx->common.output, au, 1,
+                                     SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                                     cancel, cancel);
+        av_refstruct_unref(&cancel);
+        if (err < 0) {
+            av_log(bsf, AV_LOG_ERROR, "Failed to add frame packing "
+                   "arrangement cancellation to access unit.\n");
+            return err;
+        }
+    }
+
+    return 0;
+}
+
+// Table D-9, type 7: the cropped picture is divided in three both ways.
+static int h264_metadata_check_tile_size(AVBSFContext *bsf,
+                                         CodedBitstreamFragment *au)
+{
+    H264MetadataContext *ctx = bsf->priv_data;
+    int width = 0, height = 0;
+
+    for (int i = 0; i < au->nb_units; i++) {
+        const H264RawSlice *slice;
+        int sps;
+
+        if (au->units[i].type != H264_NAL_SLICE &&
+            au->units[i].type != H264_NAL_IDR_SLICE)
+            continue;
+        slice = au->units[i].content;
+        sps   = ctx->pps_sps[slice->header.pic_parameter_set_id];
+        if (sps >= 0) {
+            width  = ctx->sps_size[sps].width;
+            height = ctx->sps_size[sps].height;
+        }
+        break;
+    }
+
+    if (!width || !height) {
+        av_log(bsf, AV_LOG_ERROR, "The tile format frame packing arrangement "
+               "needs the size of the picture, but its sequence parameter set "
+               "has not been seen.\n");
+        return AVERROR(EINVAL);
+    }
+    if (width % 3 || height % 3) {
+        av_log(bsf, AV_LOG_ERROR, "The tile format frame packing arrangement "
+               "needs a cropped picture size that is a multiple of 3 both "
+               "ways, not %dx%d.\n", width, height);
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
+
+static int h264_metadata_handle_frame_packing(AVBSFContext *bsf,
+                                              AVPacket *pkt,
+                                              CodedBitstreamFragment *au,
+                                              int seek_point)
+{
+    H264MetadataContext *ctx = bsf->priv_data;
+    H264RawSEIFramePackingArrangement *fp = &ctx->frame_packing_payload;
+    SEIFramePackingParams params;
+    SEIRawMessage *message = NULL;
+    const AVPacketSideData *sd;
+    const AVStereo3D *stereo = NULL;
+    int err, packet_stereo = 0;
+
+    if (ctx->frame_packing == BSF_ELEMENT_EXTRACT) {
+        const H264RawSEIFramePackingArrangement *last = NULL;
+
+        while (ff_cbs_sei_find_message(ctx->common.output, au,
+                                       SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                                       &message) == 0) {
+            const H264RawSEIFramePackingArrangement *payload = message->payload;
+            unsigned int id = payload->frame_packing_arrangement_id;
+
+            if (id < 256 || (id >= 512 && id < (1U << 31)))
+                last = payload;
+        }
+        if (!last || last->frame_packing_arrangement_cancel_flag)
+            return 0;
+        // Mirroring a view and quincunx sampling other than the side by
+        // side and checkerboard layouts have no Stereo 3D description.
+        if (last->spatial_flipping_flag ||
+            (last->quincunx_sampling_flag &&
+             last->frame_packing_arrangement_type != SEI_FPA_H264_TYPE_CHECKERBOARD &&
+             last->frame_packing_arrangement_type != SEI_FPA_TYPE_SIDE_BY_SIDE))
+            return 0;
+
+        params = (SEIFramePackingParams) {
+            .type                         = last->frame_packing_arrangement_type,
+            .content_interpretation_type  = last->content_interpretation_type,
+            .quincunx_sampling_flag       = last->quincunx_sampling_flag,
+            .current_frame_is_frame0_flag = last->current_frame_is_frame0_flag,
+        };
+        return ff_cbs_sei_frame_packing_to_packet(pkt, &params);
+    }
+
+    if (ctx->frame_packing == BSF_ELEMENT_REMOVE) {
+        ff_cbs_sei_delete_message_type(ctx->common.output, au,
+                                       SEI_TYPE_FRAME_PACKING_ARRANGEMENT);
+        return 0;
+    }
+
+    for (int i = 0; i < au->nb_units; i++) {
+        // The persistence of an arrangement ends with its coded video
+        // sequence, which starts at an IDR picture and follows the end of a
+        // sequence.
+        if (au->units[i].type == H264_NAL_IDR_SLICE ||
+            au->units[i].type == H264_NAL_END_SEQUENCE) {
+            ff_cbs_sei_frame_packing_reset(&ctx->frame_packing_state);
+            break;
+        }
+    }
+
+    sd = av_packet_side_data_get(bsf->par_in->coded_side_data,
+                                 bsf->par_in->nb_coded_side_data,
+                                 AV_PKT_DATA_STEREO3D);
+    if (sd && sd->size >= sizeof(AVStereo3D))
+        stereo = (const AVStereo3D *)sd->data;
+    if (pkt) {
+        size_t size;
+        uint8_t *data = av_packet_get_side_data(pkt, AV_PKT_DATA_STEREO3D, &size);
+        if (data && size >= sizeof(AVStereo3D)) {
+            stereo = (const AVStereo3D *)data;
+            packet_stereo = 1;
+        }
+    }
+
+    err = ff_cbs_sei_frame_packing_params(bsf, AV_CODEC_ID_H264,
+                                          ctx->frame_packing_type,
+                                          ctx->frame_packing_view,
+                                          ctx->frame_packing_quincunx, stereo,
+                                          !ctx->frame_packing_frame,
+                                          &params);
+    if (err == AVERROR(ENOENT))
+        return h264_metadata_track_frame_packing(bsf, au, 1);
+    if (err < 0)
+        return err;
+
+    // The message of a frame sequence is needed on every frame, the others
+    // stay in force until the next one.
+    if (params.type != SEI_FPA_TYPE_INTERLEAVE_TEMPORAL &&
+        !seek_point && !packet_stereo &&
+        ff_cbs_sei_find_message(ctx->common.output, au,
+                                SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                                &message) < 0)
+        return 0;
+
+    if (params.type == SEI_FPA_H264_TYPE_TILE) {
+        err = h264_metadata_check_tile_size(bsf, au);
+        if (err < 0)
+            return err;
+    }
+
+    // The self-contained flags are the same in all the messages of a coded
+    // video sequence, and 0 for the types 0 and 1.
+    h264_metadata_track_frame_packing(bsf, au, 0);
+
+    *fp = (H264RawSEIFramePackingArrangement) {
+        .frame_packing_arrangement_type             = params.type,
+        .quincunx_sampling_flag                     = params.quincunx_sampling_flag,
+        .content_interpretation_type                = params.content_interpretation_type,
+        .current_frame_is_frame0_flag               = params.current_frame_is_frame0_flag,
+        .frame_packing_arrangement_repetition_period = params.persistence,
+    };
+    if (ctx->frame_packing_state.self_contained_seen &&
+        params.type != SEI_FPA_H264_TYPE_CHECKERBOARD &&
+        params.type != SEI_FPA_H264_TYPE_INTERLEAVE_COLUMN) {
+        fp->frame0_self_contained_flag = ctx->frame_packing_state.frame0_self_contained_flag;
+        fp->frame1_self_contained_flag = ctx->frame_packing_state.frame1_self_contained_flag;
+    }
+
+    ff_cbs_sei_frame_packing_note_flags(&ctx->frame_packing_state,
+                                        fp->frame0_self_contained_flag,
+                                        fp->frame1_self_contained_flag);
+    ff_cbs_sei_delete_message_type(ctx->common.output, au,
+                                   SEI_TYPE_FRAME_PACKING_ARRANGEMENT);
+    // The new message has the arrangement id 0 and replaces only that one,
+    // so the arrangements of earlier messages that were passed on end here.
+    err = h264_metadata_cancel_frame_packing(bsf, au);
+    if (err < 0)
+        return err;
+    err = ff_cbs_sei_add_message(ctx->common.output, au, 1,
+                                 SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                                 fp, NULL);
+    if (err < 0) {
+        av_log(bsf, AV_LOG_ERROR, "Failed to add frame packing arrangement "
+               "SEI message to access unit.\n");
+        return err;
+    }
+    ctx->frame_packing_state.nb_ids = 0;
+    err = ff_cbs_sei_frame_packing_track(bsf, &ctx->frame_packing_state, 0, 0,
+                                         params.persistence);
+    if (err < 0)
+        return err;
+
+    if (params.type == SEI_FPA_TYPE_INTERLEAVE_TEMPORAL)
+        ctx->frame_packing_frame = params.current_frame_is_frame0_flag;
+
+    return 0;
+}
+
+static void h264_metadata_save_sps_size(H264MetadataContext *ctx,
+                                        const H264RawSPS *sps)
+{
+    int crop_unit_x, crop_unit_y;
+
+    if (sps->separate_colour_plane_flag || sps->chroma_format_idc == 0) {
+        crop_unit_x = 1;
+        crop_unit_y = 2 - sps->frame_mbs_only_flag;
+    } else {
+        crop_unit_x = 1 + (sps->chroma_format_idc < 3);
+        crop_unit_y = (1 + (sps->chroma_format_idc < 2)) *
+                       (2 - sps->frame_mbs_only_flag);
+    }
+
+    ctx->sps_size[sps->seq_parameter_set_id].width  =
+        16 * (sps->pic_width_in_mbs_minus1 + 1);
+    ctx->sps_size[sps->seq_parameter_set_id].height =
+        16 * (sps->pic_height_in_map_units_minus1 + 1) *
+        (2 - sps->frame_mbs_only_flag);
+    if (sps->frame_cropping_flag) {
+        ctx->sps_size[sps->seq_parameter_set_id].width  -= crop_unit_x *
+            (sps->frame_crop_left_offset + sps->frame_crop_right_offset);
+        ctx->sps_size[sps->seq_parameter_set_id].height -= crop_unit_y *
+            (sps->frame_crop_top_offset + sps->frame_crop_bottom_offset);
+    }
+}
+
 static int h264_metadata_update_fragment(AVBSFContext *bsf, AVPacket *pkt,
                                          CodedBitstreamFragment *au)
 {
@@ -487,11 +785,19 @@ static int h264_metadata_update_fragment(AVBSFContext *bsf, AVPacket *pkt,
     has_sps = 0;
