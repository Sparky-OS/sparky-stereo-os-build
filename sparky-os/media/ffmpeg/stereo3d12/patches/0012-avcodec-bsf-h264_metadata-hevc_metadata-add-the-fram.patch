+// Note the self-contained flags of the messages in the access unit and, when
+// track is set, the arrangements that stay in force after it.
+static int h265_metadata_track_frame_packing(AVBSFContext *bsf,
+                                             CodedBitstreamFragment *au,
+                                             int track)
+{
+    H265MetadataContext *ctx = bsf->priv_data;
+    SEIRawMessage *message = NULL;
+
+    while (ff_cbs_sei_find_message(ctx->common.output, au,
+                                   SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                                   &message) == 0) {
+        const SEIRawFramePackingArrangement *payload = message->payload;
+        int err;
+
+        if (!payload->fp_arrangement_cancel_flag)
+            ff_cbs_sei_frame_packing_note_flags(&ctx->frame_packing_state,
+                                                payload->fp_frame0_self_contained_flag,
+                                                payload->fp_frame1_self_contained_flag);
