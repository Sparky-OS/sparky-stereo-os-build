+            !ff_cbs_sei_frame_packing_id_valid(payload->fp_arrangement_id))
+            continue;
+        err = ff_cbs_sei_frame_packing_track(bsf, &ctx->frame_packing_state,
+                                             payload->fp_arrangement_id,
+                                             payload->fp_arrangement_cancel_flag,
+                                             payload->fp_arrangement_persistence_flag);
+        if (err < 0)
+            return err;
+    }
+
+    return 0;
