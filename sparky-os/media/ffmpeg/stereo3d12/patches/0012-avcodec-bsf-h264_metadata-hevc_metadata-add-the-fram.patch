+
+// Cancel the arrangements that are in force. The one with id 0 is left when
+// the message to be added replaces it.
+static int h265_metadata_cancel_frame_packing(AVBSFContext *bsf,
+                                              CodedBitstreamFragment *au,
+                                              int cancel_zero)
+{
+    H265MetadataContext *ctx = bsf->priv_data;
+    const SEIFramePackingState *state = &ctx->frame_packing_state;
+
+    for (int i = 0; i < state->nb_ids; i++) {
+        SEIRawFramePackingArrangement *cancel;
+        int err;
+
+        if (!state->ids[i] && !cancel_zero)
+            continue;
+        cancel = av_refstruct_allocz(sizeof(*cancel));
+        if (!cancel)
+            return AVERROR(ENOMEM);
+        cancel->fp_arrangement_id          = state->ids[i];
+        cancel->fp_arrangement_cancel_flag = 1;
+        err = ff_cbs_sei_add_message(ctx->common.output, au, 1,
+                                     SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                                     cancel, cancel);
+        av_refstruct_unref(&cancel);
+        if (err < 0) {
+            av_log(bsf, AV_LOG_ERROR, "Failed to add frame packing "
+                   "arrangement cancellation to access unit.\n");
