diff --git a/libavcodec/cbs_sei.c b/libavcodec/cbs_sei.c
index 1c1747e..59d1d77 100644
--- a/libavcodec/cbs_sei.c
+++ b/libavcodec/cbs_sei.c
@@ -17,6 +17,7 @@
  */
 
 #include "libavutil/mem.h"
+#include "libavutil/stereo3d.h"
 #include "cbs.h"
 #include "cbs_internal.h"
 #include "cbs_h264.h"
@@ -737,3 +738,224 @@ const SEIMessageTypeDescriptor *ff_cbs_sei_find_type(CodedBitstreamContext *ctx,
 
     return NULL;
 }
+
+int ff_cbs_sei_frame_packing_params(void *log_ctx, enum AVCodecID codec_id,
+                                    int type, int content, int quincunx,
+                                    const AVStereo3D *stereo, int frame0,
+                                    SEIFramePackingParams *params)
+{
+    int explicit_type = type >= 0;
+
+    if (type < 0) {
+        if (!stereo)
+            return AVERROR(ENOENT);
+
+        switch (stereo->type) {
+        case AV_STEREO3D_CHECKERBOARD:
+            type = SEI_FPA_H264_TYPE_CHECKERBOARD;
+            break;
+        case AV_STEREO3D_COLUMNS:
+            type = SEI_FPA_H264_TYPE_INTERLEAVE_COLUMN;
+            break;
+        case AV_STEREO3D_LINES:
+            type = SEI_FPA_H264_TYPE_INTERLEAVE_ROW;
+            break;
+        case AV_STEREO3D_SIDEBYSIDE_QUINCUNX:
+            if (quincunx < 0)
+                quincunx = 1;
+            av_fallthrough;
+        case AV_STEREO3D_SIDEBYSIDE:
+            type = SEI_FPA_TYPE_SIDE_BY_SIDE;
+            break;
+        case AV_STEREO3D_TOPBOTTOM:
+            type = SEI_FPA_TYPE_TOP_BOTTOM;
+            break;
+        case AV_STEREO3D_FRAMESEQUENCE:
+            type = SEI_FPA_TYPE_INTERLEAVE_TEMPORAL;
+            break;
+        case AV_STEREO3D_2D:
+            type = SEI_FPA_H264_TYPE_2D;
+            break;
+        default:
+            av_log(log_ctx, AV_LOG_WARNING, "Stereo 3D type %s has no frame "
+                   "packing arrangement.\n", av_stereo3d_type_name(stereo->type));
+            return AVERROR(ENOENT);
+        }
+    }
+
+    if (codec_id == AV_CODEC_ID_H264 ? type > SEI_FPA_H264_TYPE_TILE :
+        (type < SEI_FPA_TYPE_SIDE_BY_SIDE || type > SEI_FPA_TYPE_INTERLEAVE_TEMPORAL)) {
+        // A layout of the stream that the codec cannot signal is left alone,
+        // one that was asked for is an error.
+        av_log(log_ctx, explicit_type ? AV_LOG_ERROR : AV_LOG_WARNING,
+               "Frame packing arrangement type %d is not defined for %s.\n",
+               type, codec_id == AV_CODEC_ID_H264 ? "H.264" : "H.265");
+        return explicit_type ? AVERROR(EINVAL) : AVERROR(ENOENT);
+    }
+
+    if (content < 0)
+        content = type == SEI_FPA_H264_TYPE_2D ? 0 :
+                  stereo && (stereo->flags & AV_STEREO3D_FLAG_INVERT) ? 2 : 1;
+    if (type == SEI_FPA_H264_TYPE_2D && content) {
+        av_log(log_ctx, AV_LOG_ERROR,
+               "A 2D frame packing arrangement requires content interpretation 0.\n");
+        return AVERROR(EINVAL);
+    }
+
+    if (type == SEI_FPA_TYPE_INTERLEAVE_TEMPORAL && stereo &&
+        stereo->type == AV_STEREO3D_FRAMESEQUENCE &&
+        (stereo->view == AV_STEREO3D_VIEW_LEFT ||
+         stereo->view == AV_STEREO3D_VIEW_RIGHT))
+        frame0 = (stereo->view == AV_STEREO3D_VIEW_LEFT) != (content == 2);
+
+    // Table D-9: the checkerboard is always quincunx sampled.
+    if (type == SEI_FPA_H264_TYPE_CHECKERBOARD)
+        quincunx = 1;
+    else if (quincunx < 0)
+        quincunx = type == SEI_FPA_TYPE_SIDE_BY_SIDE && stereo &&
+                   stereo->type == AV_STEREO3D_SIDEBYSIDE_QUINCUNX;
+    if (quincunx && type >= SEI_FPA_TYPE_INTERLEAVE_TEMPORAL) {
+        av_log(log_ctx, AV_LOG_ERROR,
+               "Frame packing arrangement type %d cannot be quincunx sampled.\n",
+               type);
+        return AVERROR(EINVAL);
+    }
+
+    *params = (SEIFramePackingParams) {
+        .type                         = type,
+        .content_interpretation_type  = content,
+        .quincunx_sampling_flag       = quincunx,
+        .current_frame_is_frame0_flag = type == SEI_FPA_TYPE_INTERLEAVE_TEMPORAL &&
+                                        frame0,
+        // The message of a temporal interleaving applies to one frame only.
+        .persistence                  = type != SEI_FPA_TYPE_INTERLEAVE_TEMPORAL,
+    };
+
+    return 0;
+}
+
+#define SEI_FRAME_PACKING_MAX_IDS 256
+
+int ff_cbs_sei_frame_packing_id_valid(uint32_t id)
+{
+    // The other values are reserved and decoders ignore them.
+    return id < 256 || (id >= 512 && id < (1U << 31));
+}
+
+int ff_cbs_sei_frame_packing_track(void *log_ctx, SEIFramePackingState *state,
+                                   uint32_t id, int cancel, int persistent)
+{
+    int i;
+
+    for (i = 0; i < state->nb_ids; i++) {
+        if (state->ids[i] == id)
+            break;
+    }
+
+    if (cancel || !persistent) {
+        if (i < state->nb_ids)
+            state->ids[i] = state->ids[--state->nb_ids];
+        return 0;
+    }
+    if (i < state->nb_ids)
+        return 0;
+
+    if (state->nb_ids >= SEI_FRAME_PACKING_MAX_IDS) {
+        av_log(log_ctx, AV_LOG_ERROR, "More than %d frame packing "
+               "arrangements are in force.\n", SEI_FRAME_PACKING_MAX_IDS);
+        return AVERROR(ENOSPC);
+    }
+    if (state->nb_ids >= state->alloc_size) {
+        unsigned int size = state->alloc_size ? 2 * state->alloc_size : 4;
+        uint32_t *ids = av_realloc_array(state->ids, size, sizeof(*ids));
+
+        if (!ids)
+            return AVERROR(ENOMEM);
+        state->ids        = ids;
+        state->alloc_size = size;
+    }
+    state->ids[state->nb_ids++] = id;
+    return 0;
+}
+
+void ff_cbs_sei_frame_packing_note_flags(SEIFramePackingState *state,
+                                         int frame0_self_contained_flag,
+                                         int frame1_self_contained_flag)
+{
+    if (state->self_contained_seen)
+        return;
+    state->self_contained_seen       = 1;
+    state->frame0_self_contained_flag = frame0_self_contained_flag;
+    state->frame1_self_contained_flag = frame1_self_contained_flag;
+}
+
+void ff_cbs_sei_frame_packing_reset(SEIFramePackingState *state)
+{
+    state->nb_ids             = 0;
+    state->self_contained_seen = 0;
+}
+
+void ff_cbs_sei_frame_packing_free(SEIFramePackingState *state)
+{
+    av_freep(&state->ids);
+    state->nb_ids     = 0;
+    state->alloc_size = 0;
+    state->self_contained_seen = 0;
+}
+
+int ff_cbs_sei_frame_packing_to_packet(AVPacket *pkt,
+                                      const SEIFramePackingParams *params)
+{
+    AVStereo3D *stereo;
+    enum AVStereo3DType type;
+    size_t size;
+    int err;
+
+    if (params->type != SEI_FPA_H264_TYPE_2D &&
+        (params->content_interpretation_type < 1 ||
+         params->content_interpretation_type > 2))
+        return 0;
+
+    switch (params->type) {
+    case SEI_FPA_H264_TYPE_CHECKERBOARD:
+        type = AV_STEREO3D_CHECKERBOARD;
+        break;
+    case SEI_FPA_H264_TYPE_INTERLEAVE_COLUMN:
+        type = AV_STEREO3D_COLUMNS;
+        break;
+    case SEI_FPA_H264_TYPE_INTERLEAVE_ROW:
+        type = AV_STEREO3D_LINES;
+        break;
+    case SEI_FPA_TYPE_SIDE_BY_SIDE:
+        type = params->quincunx_sampling_flag ? AV_STEREO3D_SIDEBYSIDE_QUINCUNX :
+                                              AV_STEREO3D_SIDEBYSIDE;
+        break;
+    case SEI_FPA_TYPE_TOP_BOTTOM:
+        type = AV_STEREO3D_TOPBOTTOM;
+        break;
+    case SEI_FPA_TYPE_INTERLEAVE_TEMPORAL:
+        type = AV_STEREO3D_FRAMESEQUENCE;
+        break;
+    case SEI_FPA_H264_TYPE_2D:
+        type = AV_STEREO3D_2D;
+        break;
+    default:
+        return 0;
+    }
+
+    stereo = av_stereo3d_alloc_size(&size);
+    if (!stereo)
+        return AVERROR(ENOMEM);
+    stereo->type = type;
+    if (type != AV_STEREO3D_2D && params->content_interpretation_type == 2)
+        stereo->flags = AV_STEREO3D_FLAG_INVERT;
+    if (type == AV_STEREO3D_FRAMESEQUENCE)
+        stereo->view = params->current_frame_is_frame0_flag !=
+                       (params->content_interpretation_type == 2) ?
+                       AV_STEREO3D_VIEW_LEFT : AV_STEREO3D_VIEW_RIGHT;
+
+    err = av_packet_add_side_data(pkt, AV_PKT_DATA_STEREO3D, (uint8_t *)stereo, size);
+    if (err < 0)
+        av_free(stereo);
+    return err;
+}
diff --git a/libavcodec/cbs_sei.h b/libavcodec/cbs_sei.h
index e3e3097..18ab8ce 100644
--- a/libavcodec/cbs_sei.h
+++ b/libavcodec/cbs_sei.h
@@ -275,4 +275,93 @@ int ff_cbs_sei_read_message(CodedBitstreamContext *ctx, struct GetBitContext *rw
 int ff_cbs_sei_write_message(CodedBitstreamContext *ctx, struct PutBitContext *rw,
                              SEIRawMessage *current);
 
+struct AVStereo3D;
+
+/**
+ * What a bitstream filter needs to write a frame packing arrangement SEI
+ * message, whichever codec it is for.
+ */
+typedef struct SEIFramePackingParams {
+    int type;                 ///< frame_packing_arrangement_type
+    int content_interpretation_type;
+    int quincunx_sampling_flag;
+    int current_frame_is_frame0_flag;
+    int persistence;          ///< 0 for the current frame only, 1 until a message
+                              ///< that ends it: the same frame_packing_arrangement_id
+                              ///< (or a cancellation), or the end of the coded video
+                              ///< sequence
+} SEIFramePackingParams;
+
+/**
+ * Work out the frame packing arrangement to signal.
+ *
+ * What is not given is taken from the Stereo 3D description.
+ *
+ * @param log_ctx  context for logging.
+ * @param codec_id AV_CODEC_ID_H264 or AV_CODEC_ID_HEVC.
+ * @param type     frame_packing_arrangement_type (H.264 Table D-9, H.265
+ *                 Table D.8), or a negative value to take it from stereo.
+ * @param content  content_interpretation_type (0 unspecified, 1 left view
+ *                 first, 2 right view first), or a negative value to take
+ *                 it from stereo.
+ * @param quincunx quincunx_sampling_flag, or a negative value to take it
+ *                 from stereo.
+ * @param stereo   Stereo 3D description, or NULL.
+ * @param frame0   current_frame_is_frame0_flag for temporal interleaving
+ *                 when stereo does not say which view the frame is.
+ * @return 0 on success, AVERROR(ENOENT) if there is nothing to signal (no
+ *         type given and no usable stereo), another negative value if the
+ *         parameters cannot be signalled in the codec.
+ */
+int ff_cbs_sei_frame_packing_params(void *log_ctx, enum AVCodecID codec_id,
+                                    int type, int content, int quincunx,
+                                    const struct AVStereo3D *stereo, int frame0,
+                                    SEIFramePackingParams *params);
+
+/**
+ * The frame packing arrangement messages whose persistence may still be in
+ * force, by frame_packing_arrangement_id, so that a bitstream filter that
+ * writes a new description can end them.
+ */
+typedef struct SEIFramePackingState {
+    uint32_t *ids;
+    int nb_ids;
+    unsigned int alloc_size;
+    // The self-contained flags, which are the same in every message of a
+    // coded video sequence, as the first message of the sequence had them.
+    int self_contained_seen;
+    int frame0_self_contained_flag;
+    int frame1_self_contained_flag;
+} SEIFramePackingState;
+
+/** Whether a decoder takes notice of a frame_packing_arrangement_id. */
+int ff_cbs_sei_frame_packing_id_valid(uint32_t id);
+
+/**
+ * Record a message seen in the bitstream.
+ *
+ * A cancellation and a message for the current frame only end the
+ * persistence of their id, a persistent message starts or replaces it.
+ *
+ * @return 0 on success, AVERROR(ENOSPC) if more arrangements are in force
+ *         than the state holds, another negative value on failure.
+ */
+int ff_cbs_sei_frame_packing_track(void *log_ctx, SEIFramePackingState *state,
+                                   uint32_t id, int cancel, int persistent);
+
+/** Record the self-contained flags of a message, unless a message of the
+ *  coded video sequence has set them. */
+void ff_cbs_sei_frame_packing_note_flags(SEIFramePackingState *state,
+                                         int frame0_self_contained_flag,
+                                         int frame1_self_contained_flag);
+
+/** Forget every arrangement, at the start of a coded video sequence. */
+void ff_cbs_sei_frame_packing_reset(SEIFramePackingState *state);
+
+void ff_cbs_sei_frame_packing_free(SEIFramePackingState *state);
+
+/** Attach a representable frame packing description to a packet. */
+int ff_cbs_sei_frame_packing_to_packet(AVPacket *pkt,
+                                      const SEIFramePackingParams *params);
+
 #endif /* AVCODEC_CBS_SEI_H */
