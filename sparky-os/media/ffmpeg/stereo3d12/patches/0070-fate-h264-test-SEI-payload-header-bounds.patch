+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavcodec/h264_sei.h"
+
+static uint8_t *put_header(uint8_t *p, uint64_t value)
+{
+    size_t count = value / 255;
+
+    memset(p, 255, count);
+    p += count;
+    *p++ = value % 255;
+    return p;
+}
+
+static int check(const char *name, uint64_t type, uint64_t size,
+                 int truncate)
+{
+    size_t capacity = type / 255 + size / 255 + 3;
+    uint8_t *buf = av_mallocz(capacity + AV_INPUT_BUFFER_PADDING_SIZE);
+    H264SEIContext sei = { 0 };
+    H264ParamSets ps = { 0 };
+    GetBitContext gb;
+    uint8_t *p;
+    int ret;
+
+    if (!buf)
+        return 1;
+    p = put_header(buf, type);
+    p = put_header(p, size);
+    *p++ = 0x80;
+    if (truncate) {
+        memset(buf, 255, 3);
+        p = buf + 3;
+    }
+    ret = init_get_bits8(&gb, buf, p - buf);
+    if (ret >= 0)
+        ret = ff_h264_sei_decode(&sei, &gb, &ps, NULL);
+    printf("%s: %d\n", name, ret);
+    ff_h264_sei_uninit(&sei);
+    av_free(buf);
+    return 0;
+}
+
+int main(void)
+{
+    av_log_set_level(AV_LOG_QUIET);
+    return check("empty unknown message", 200, 0, 0) ||
+           check("extended type", 511, 0, 0) ||
+           check("maximum signed type", INT_MAX, 0, 0) ||
+           check("type overflow", (uint64_t)INT_MAX + 1, 0, 0) ||
+           check("size overflow", 200, (uint64_t)INT_MAX + 1, 0) ||
+           check("size wrap", 200, (uint64_t)UINT_MAX + 1, 0) ||
+           check("truncated payload", 200, 2, 0) ||
+           check("unterminated type", 200, 0, 1);
+}
