+/* Packets with their own Stereo 3D descriptions, one after the other. */
+static void sequence(const char *label, const char *name, const AVCodecParameters *par,
+                     AVPacket **input, int count, const char *options,
+                     int stream_type, const int *packet_type)
+{
+    AVBSFContext *ctx = NULL;
+    AVPacket *pkt = av_packet_alloc();
+    int ret, hevc = par->codec_id == AV_CODEC_ID_HEVC;
+    printf("%s:", label);
+    if (!pkt || av_bsf_alloc(av_bsf_get_by_name(name), &ctx) < 0 ||
+        avcodec_parameters_copy(ctx->par_in, par) < 0)
+        exit(1);
+    av_packet_side_data_remove(ctx->par_in->coded_side_data,
+                              &ctx->par_in->nb_coded_side_data, AV_PKT_DATA_STEREO3D);
+    if (stream_type >= 0 && add_stereo(&ctx->par_in->coded_side_data,
+                                     &ctx->par_in->nb_coded_side_data,
+                                     stream_type, 0, 0) < 0)
+        exit(1);
+    ctx->time_base_in = (AVRational) { 1, 25 };
+    ret = av_opt_set_from_string(ctx->priv_data, options, NULL, "=", ":");
+    if (ret >= 0)
+        ret = av_bsf_init(ctx);
+    if (ret < 0) {
+        printf(" error\n");
+        goto end;
+    }
+    for (int i = 0; i < count; i++) {
+        if (av_packet_ref(pkt, input[i]) < 0)
+            exit(1);
+        av_packet_side_data_remove(pkt->side_data, &pkt->side_data_elems, AV_PKT_DATA_STEREO3D);
+        if (packet_type && packet_type[i] >= 0 &&
+            add_stereo(&pkt->side_data, &pkt->side_data_elems, packet_type[i], 0, 0) < 0)
+            exit(1);
+        ret = av_bsf_send_packet(ctx, pkt);
+        if (ret >= 0)
+            ret = av_bsf_receive_packet(ctx, pkt);
+        if (ret < 0) {
+            printf(" error\n");
+            break;
+        }
+        printf(i ? "  packet %d:" : " packet %d:", i);
+        describe(pkt->data, pkt->size, hevc);
+        av_packet_unref(pkt);
+    }
+end:
+    av_packet_free(&pkt);
+    av_bsf_free(&ctx);
+}
+
+/* What the filter leaves of the parameter sets and SEI of the extradata,
+ * and of the extradata that a packet brings. */
+static void extradata_test(const char *label, const char *name, const AVCodecParameters *par,
+                           const AVPacket *first, const uint8_t *extradata, int size,
+                           const char *options)
+{
+    AVBSFContext *ctx = NULL;
+    AVPacket *pkt = av_packet_alloc();
+    int ret, hevc = par->codec_id == AV_CODEC_ID_HEVC;
+    size_t side_size;
+    uint8_t *side;
+    printf("%s: initial", label);
+    if (!pkt || av_bsf_alloc(av_bsf_get_by_name(name), &ctx) < 0 ||
+        avcodec_parameters_copy(ctx->par_in, par) < 0)
+        exit(1);
+    av_freep(&ctx->par_in->extradata);
+    ctx->par_in->extradata = av_mallocz(size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!ctx->par_in->extradata)
+        exit(1);
+    memcpy(ctx->par_in->extradata, extradata, size);
+    ctx->par_in->extradata_size = size;
+    ctx->time_base_in = (AVRational) { 1, 25 };
+    ret = av_opt_set_from_string(ctx->priv_data, options, NULL, "=", ":");
+    if (ret >= 0)
+        ret = av_bsf_init(ctx);
+    if (ret < 0) {
+        printf(" error\n");
+        goto end;
+    }
+    describe(ctx->par_out->extradata, ctx->par_out->extradata_size, hevc);
+    printf("  new extradata:");
+    if (av_packet_ref(pkt, first) < 0)
+        exit(1);
+    side = av_packet_new_side_data(pkt, AV_PKT_DATA_NEW_EXTRADATA, size);
+    if (!side)
+        exit(1);
+    memcpy(side, extradata, size);
+    ret = av_bsf_send_packet(ctx, pkt);
+    if (ret >= 0)
+        ret = av_bsf_receive_packet(ctx, pkt);
+    if (ret < 0) {
+        printf(" error\n");
+        goto end;
+    }
+    side = av_packet_get_side_data(pkt, AV_PKT_DATA_NEW_EXTRADATA, &side_size);
+    if (side)
+        describe(side, side_size, hevc);
+    else
+        printf(" none\n");
+end:
+    av_packet_free(&pkt);
+    av_bsf_free(&ctx);
+}
+
+/* An arrangement written here, in a packet of its own, and extracted. */
+static void extract_fabricated(const char *label, const char *name, const AVCodecParameters *par,
+                               const AVPacket *first, int type, int quincunx, int flip)
+{
+    AVBSFContext *ctx = NULL;
+    AVPacket *src;
+    uint8_t nal[64];
+    int n, hevc = par->codec_id == AV_CODEC_ID_HEVC;
+    size_t size;
+    const AVStereo3D *st;
+    printf("%s:", label);
+    n = fabricate(hevc, 0, 0, type, quincunx, 1, flip, 1, nal);
+    src = rebuild(first, hevc, nal, n, 0);
+    if (av_bsf_alloc(av_bsf_get_by_name(name), &ctx) < 0 ||
+        avcodec_parameters_copy(ctx->par_in, par) < 0)
+        exit(1);
+    ctx->time_base_in = (AVRational) { 1, 25 };
+    if (av_opt_set(ctx->priv_data, "frame_packing", "extract", 0) < 0 ||
+        av_bsf_init(ctx) < 0 || av_bsf_send_packet(ctx, src) < 0 ||
+        av_bsf_receive_packet(ctx, src) < 0) {
+        printf(" error\n");
+        goto end;
+    }
+    st = (const AVStereo3D *)av_packet_get_side_data(src, AV_PKT_DATA_STEREO3D, &size);
+    if (st && size >= sizeof(*st))
+        printf(" stereo=%d,%d,%d\n", st->type, st->flags, st->view);
+    else
+        printf(" none\n");
+end:
+    av_packet_free(&src);
+    av_bsf_free(&ctx);
+}
+
+/* What an extraction can say about a message written here. */
+static void extraction_tests(const char *name, const AVCodecParameters *par,
+                             const AVPacket *first)
+{
+    int hevc = par->codec_id == AV_CODEC_ID_HEVC;
+    extract_fabricated("extract-plain-sbs", name, par, first, 3, 0, 0);
+    extract_fabricated("extract-flipped-sbs", name, par, first, 3, 0, 1);
+    extract_fabricated("extract-flipped-tb", name, par, first, 4, 0, 1);
+    extract_fabricated("extract-quincunx-sbs", name, par, first, 3, 1, 0);
+    extract_fabricated("extract-quincunx-tb", name, par, first, 4, 1, 0);
+    extract_fabricated("extract-flipped-quincunx-sbs", name, par, first, 3, 1, 1);
+    if (!hevc) {
+        extract_fabricated("extract-quincunx-columns", name, par, first, 1, 1, 0);
+        extract_fabricated("extract-quincunx-checkerboard", name, par, first, 0, 1, 0);
+    }
+}
+
+/* Arrangements that persist, and what a later description does to them. */
+static void state_tests(AVFormatContext *fmt, AVPacket **input, int hevc)
+{
+    const char *name = hevc ? "hevc_metadata" : "h264_metadata";
+    const AVCodecParameters *par = fmt->streams[0]->codecpar;
+    AVPacket *foreign[2];
+    uint8_t nal[64];
+    int n, later[2] = { -1, AV_STEREO3D_TOPBOTTOM };
+    int to_two_d[2] = { AV_STEREO3D_SIDEBYSIDE, AV_STEREO3D_2D };
+    int to_two_d_later[3] = { AV_STEREO3D_SIDEBYSIDE, -1, AV_STEREO3D_2D };
+    int to_other[3] = { AV_STEREO3D_SIDEBYSIDE, -1, AV_STEREO3D_TOPBOTTOM };
+
+    extraction_tests(name, par, input[0]);
+
+    /* A message with the id 1 in the first packet, none of the filter's. */
+    n = fabricate(hevc, 1, 0, 3, 0, 1, 0, 1, nal);
+    foreign[0] = rebuild(input[0], hevc, nal, n, 0);
+    foreign[1] = av_packet_clone(input[1]);
+    if (!foreign[1])
+        exit(1);
+    sequence("persistent-then-description", name, par, foreign, 2,
+             "frame_packing=insert", -1, later);
+    sequence("persistent-then-explicit", name, par, foreign, 2,
+             "frame_packing=insert:frame_packing_type=4", -1, later);
+    /* The self-contained flags are the same in every message of a coded
+     * video sequence. */
+    {
+        AVPacket *flags[3];
+        int layouts[3] = { -1, AV_STEREO3D_TOPBOTTOM, AV_STEREO3D_SIDEBYSIDE };
+
+        fabricated_self_contained = 3;
+        n = fabricate(hevc, 1, 0, 3, 0, 1, 0, 1, nal);
+        flags[0] = rebuild(input[0], hevc, nal, n, 0);
+        fabricated_self_contained = 0;
+        flags[1] = av_packet_clone(input[1]);
+        flags[2] = av_packet_clone(input[2]);
+        if (!flags[1] || !flags[2])
+            exit(1);
+        sequence("persistent-self-contained", name, par, flags, 3,
+                 "frame_packing=insert", -1, layouts);
+        for (int i = 0; i < 3; i++)
+            av_packet_free(&flags[i]);
+    }
+    av_packet_free(&foreign[0]);
+    n = fabricate(hevc, 1, 0, 3, 0, 1, 0, 1, nal);
+    foreign[0] = rebuild(input[0], hevc, nal, n, 0);
+    sequence("persistent-without-description", name, par, foreign, 2,
+             "frame_packing=insert", -1, NULL);
+
+    /* A cancellation of the id 1 ends it, so nothing is left to cancel. */
+    {
+        AVPacket *cancelled[3];
+        int description[3] = { -1, -1, AV_STEREO3D_TOPBOTTOM };
+
+        n = fabricate(hevc, 1, 0, 3, 0, 1, 0, 1, nal);
+        cancelled[0] = rebuild(input[0], hevc, nal, n, 0);
+        n = fabricate(hevc, 1, 1, 0, 0, 0, 0, 0, nal);
+        cancelled[1] = rebuild(input[1], hevc, nal, n, 0);
+        cancelled[2] = av_packet_clone(input[2]);
+        if (!cancelled[2])
+            exit(1);
+        sequence("cancelled-then-description", name, par, cancelled, 3,
+                 "frame_packing=insert", -1, description);
+        for (int i = 0; i < 3; i++)
+            av_packet_free(&cancelled[i]);
+    }
+    av_packet_free(&foreign[0]);
+    av_packet_free(&foreign[1]);
+
+    /* The arrangement of the extradata. */
+    n = fabricate(hevc, 1, 0, 3, 0, 1, 0, 1, nal);
+    foreign[0] = rebuild(input[0], hevc, nal, n, 0);
+    extradata_test("extradata-pass", name, par, foreign[0], foreign[0]->data,
+                   before_first_slice(foreign[0], hevc), "frame_packing=pass");
+    extradata_test("extradata-remove", name, par, foreign[0], foreign[0]->data,
+                   before_first_slice(foreign[0], hevc), "frame_packing=remove");
+    av_packet_free(&foreign[0]);
+
+    /* From a layout to none, and to another one. */
+    sequence("layout-then-2d", name, par, input, 2,
+             "frame_packing=insert", -1, to_two_d);
+    sequence("layout-then-2d-later", name, par, input, 3,
+             "frame_packing=insert", -1, to_two_d_later);
+    sequence("layout-then-other-later", name, par, input, 3,
+             "frame_packing=insert", -1, to_other);
+}
+
+/* VPS and SPS that declare general_non_packed_constraint_flag. */
+static int constraint_tests(AVFormatContext *fmt)
+{
+    const AVCodecParameters *par = fmt->streams[0]->codecpar;
+    AVPacket *input[3];
+    NAL nals[16];
+    int none[3] = { -1, -1, -1 };
+    int late[3] = { -1, AV_STEREO3D_SIDEBYSIDE, -1 };
+    int first[3] = { AV_STEREO3D_SIDEBYSIDE, -1, -1 };
+    int two_d[3] = { AV_STEREO3D_2D, -1, -1 };
+    int count, size;
+    for (int i = 0; i < 3; i++) {
+        input[i] = av_packet_alloc();
+        if (!input[i] || av_read_frame(fmt, input[i]) < 0)
+            return 1;
+    }
+    sequence("untouched", "hevc_metadata", par, input, 1, "frame_packing=pass", -1, none);
+    sequence("no-description", "hevc_metadata", par, input, 1, "frame_packing=insert", -1, none);
+    sequence("explicit-type", "hevc_metadata", par, input, 1,
+             "frame_packing=insert:frame_packing_type=3", -1, none);
+    sequence("stream-description", "hevc_metadata", par, input, 1,
+             "frame_packing=insert", AV_STEREO3D_TOPBOTTOM, none);
+    sequence("stream-2d", "hevc_metadata", par, input, 1,
+             "frame_packing=insert", AV_STEREO3D_2D, none);
+    sequence("packet-description-first", "hevc_metadata", par, input, 1,
+             "frame_packing=insert", -1, first);
+    sequence("packet-description-late", "hevc_metadata", par, input, 2,
+             "frame_packing=insert", -1, late);
+    sequence("packet-2d-first", "hevc_metadata", par, input, 1,
+             "frame_packing=insert", -1, two_d);
+    /* the parameter sets of the first packet as extradata */
+    count = split_nals(input[0]->data, input[0]->size, 1, nals, FF_ARRAY_ELEMS(nals));
+    size = 0;
+    for (int i = 0; i < count; i++) {
+        if (nals[i].type >= 32)
+            size = nals[i].end;
+        else
+            break;
+    }
+    extradata_test("extradata-explicit-type", "hevc_metadata", par, input[0],
+                   input[0]->data, size, "frame_packing=insert:frame_packing_type=3");
+    extradata_test("extradata-no-description", "hevc_metadata", par, input[0],
+                   input[0]->data, size, "frame_packing=insert");
+    for (int i = 0; i < 3; i++)
+        av_packet_free(&input[i]);
+    avformat_close_input(&fmt);
+    return 0;
+}
+
+/* New SEI units in access units on higher temporal sublayers. */
+static int sublayer_tests(AVFormatContext *fmt)
+{
+    const AVCodecParameters *par = fmt->streams[0]->codecpar;
+    AVPacket *input[8];
+    int every[8];
+    for (int i = 0; i < 8; i++) {
+        input[i] = av_packet_alloc();
+        if (!input[i] || av_read_frame(fmt, input[i]) < 0)
+            return 1;
+        every[i] = AV_STEREO3D_SIDEBYSIDE;
+    }
+    sequence("packet-description", "hevc_metadata", par, input, 8,
+             "frame_packing=insert", -1, every);
+    sequence("explicit-type", "hevc_metadata", par, input, 8,
+             "frame_packing=insert:frame_packing_type=4:frame_packing_view=2", -1, NULL);
+    for (int i = 0; i < 8; i++)
+        av_packet_free(&input[i]);
+    avformat_close_input(&fmt);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    static const int types[] = { AV_STEREO3D_CHECKERBOARD, AV_STEREO3D_COLUMNS,
+        AV_STEREO3D_LINES, AV_STEREO3D_SIDEBYSIDE, AV_STEREO3D_TOPBOTTOM,
+        AV_STEREO3D_FRAMESEQUENCE, AV_STEREO3D_2D, AV_STEREO3D_SIDEBYSIDE_QUINCUNX };
+    AVFormatContext *fmt = NULL;
+    AVPacket *input[3];
+    const char *name;
+    int hevc;
+    if (argc != 3)
+        return 1;
+    hevc = !strncmp(argv[1], "hevc", 4);
+    name = hevc ? "hevc_metadata" : "h264_metadata";
+    if (avformat_open_input(&fmt, argv[2], NULL, NULL) < 0 ||
+        avformat_find_stream_info(fmt, NULL) < 0)
+        return 1;
+    if (!strcmp(argv[1], "hevc-constraint"))
+        return constraint_tests(fmt);
+    if (!strcmp(argv[1], "hevc-sublayers"))
+        return sublayer_tests(fmt);
+    for (int i = 0; i < 3; i++) {
+        input[i] = av_packet_alloc();
+        if (!input[i] || av_read_frame(fmt, input[i]) < 0)
+            return 1;
+    }
+    for (int type = hevc ? 3 : 0; type <= (hevc ? 5 : 7); type++) {
+        for (int view = 0; view <= 2; view++) {
+            char label[64], options[128];
+            snprintf(label, sizeof(label), "type%d-view%d", type, view);
+            snprintf(options, sizeof(options), "frame_packing=insert:frame_packing_type=%d:frame_packing_view=%d%s", type, view,
+                     type == 7 ? ":crop_right=4:crop_bottom=4" : "");
+            test(label, name, fmt->streams[0]->codecpar, input, 1, options, -1, -1, 0, 0, 0);
+        }
+    }
+    if (!hevc) {
+        test("type7-uncropped", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=7", -1, -1, 0, 0, 0);
+        test("type7-width-14", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=7:crop_right=2", -1, -1, 0, 0, 0);
+        test("type7-height-14", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=7:crop_bottom=2", -1, -1, 0, 0, 0);
+    }
+    for (int i = 0; i < 8; i++) {
+        for (int invert = 0; invert < 2; invert++) {
+            char label[64];
+            snprintf(label, sizeof(label), "stereo%d-invert%d", i, invert);
+            test(label, name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert", types[i], -1, invert, 0, 0);
+        }
+    }
+    test("remove", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=remove", -1, -1, 0, 0, 0);
+    test("packet-wins", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert", AV_STEREO3D_TOPBOTTOM, AV_STEREO3D_SIDEBYSIDE, 1, 0, 0);
+    test("option-wins", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=4:frame_packing_view=1", AV_STEREO3D_SIDEBYSIDE, -1, 1, 0, 0);
+    test("quincunx", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=3:frame_packing_quincunx=1", -1, -1, 0, 0, 0);
+    test("invalid-temporal-quincunx", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=5:frame_packing_quincunx=1", -1, -1, 0, 0, 0);
+    for (int view = AV_STEREO3D_VIEW_LEFT; view <= AV_STEREO3D_VIEW_RIGHT; view++) {
+        test(view == AV_STEREO3D_VIEW_LEFT ? "packet-frame0" : "packet-frame1", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=5", -1, AV_STEREO3D_FRAMESEQUENCE, 0, view, 0);
+    }
+    test("packet-nonkey", name, fmt->streams[0]->codecpar, input, 2, "frame_packing=insert", -1, AV_STEREO3D_TOPBOTTOM, 0, 0, 0);
+    test("replace-cancel", name, fmt->streams[0]->codecpar, input, 3, "frame_packing=insert:frame_packing_type=3", -1, -1, 0, 0, 0);
+    test("pass", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=pass", -1, -1, 0, 0, 0);
+    test("no-description", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert", -1, -1, 0, 0, 0);
+    test("inferred-quincunx", name, fmt->streams[0]->codecpar, input, 1, "frame_packing=insert:frame_packing_type=3", AV_STEREO3D_SIDEBYSIDE_QUINCUNX, -1, 0, 0, 0);
+    test("temporal", name, fmt->streams[0]->codecpar, input, 2, "frame_packing=insert:frame_packing_type=5", -1, -1, 0, 0, 0);
+    test("temporal-flush", name, fmt->streams[0]->codecpar, input, 2, "frame_packing=insert:frame_packing_type=5", -1, -1, 0, 0, 1);
+
+    for (int invert = 0; invert < 2; invert++) {
+        for (int view = AV_STEREO3D_VIEW_PACKED; view <= AV_STEREO3D_VIEW_UNSPEC; view++) {
+            char label[64];
+            snprintf(label, sizeof(label), "temporal-view%d-invert%d", view, invert);
+            test(label, name, fmt->streams[0]->codecpar, input, 2,
+                 "frame_packing=insert:frame_packing_type=5", -1,
+                 AV_STEREO3D_FRAMESEQUENCE, invert, view, 0);
+        }
+    }
+    test("temporal-override-content", name, fmt->streams[0]->codecpar, input, 1,
+         "frame_packing=insert:frame_packing_type=5:frame_packing_view=1", -1,
+         AV_STEREO3D_FRAMESEQUENCE, 1, AV_STEREO3D_VIEW_LEFT, 0);
+    for (int invert = 0; invert < 2; invert++)
+        test(invert ? "temporal-right-unspec-inverted" : "temporal-right-unspec",
+             name, fmt->streams[0]->codecpar, input, 2,
+             "frame_packing=insert:frame_packing_type=5", -1,
+             AV_STEREO3D_FRAMESEQUENCE, invert, -1, 0);
+    extract_test("extract-original", name, fmt->streams[0]->codecpar, input, 3,
+                 "frame_packing=pass");
+    extract_test("extract-absent", name, fmt->streams[0]->codecpar, input, 1,
+                 "frame_packing=remove");
+    for (int type = hevc ? 3 : 0; type <= (hevc ? 5 : 7); type++) {
+        for (int content = 0; content < 3; content++) {
+            char label[64], options[128];
+            if (type == 6 && content)
+                continue;
+            snprintf(label, sizeof(label), "extract-type%d-content%d", type, content);
+            snprintf(options, sizeof(options), "frame_packing=insert:frame_packing_type=%d:frame_packing_view=%d%s", type, content,
+                     type == 7 ? ":crop_right=4:crop_bottom=4" : "");
+            extract_test(label, name, fmt->streams[0]->codecpar, input, type == 5 ? 2 : 1, options);
+        }
+    }
+    extract_test("extract-quincunx", name, fmt->streams[0]->codecpar, input, 1,
+                 "frame_packing=insert:frame_packing_type=3:frame_packing_quincunx=1");
+    if (!hevc) {
+        AVPacket *nonkey[] = { input[1], input[1] };
+        test("orientation-no-flush", name, fmt->streams[0]->codecpar, nonkey, 2,
+             "display_orientation=insert:rotate=90", -1, -1, 0, 0, 0);
+        test("orientation-flush", name, fmt->streams[0]->codecpar, nonkey, 2,
+             "display_orientation=insert:rotate=90", -1, -1, 0, 0, 1);
+    }
+    state_tests(fmt, input, hevc);
+    for (int i = 0; i < 3; i++)
+        av_packet_free(&input[i]);
+    avformat_close_input(&fmt);
+    return 0;
+}
