+/* Read the SEI independently of CBS and the decoders. */
+static unsigned bits(const uint8_t *data, int *pos, int n)
+{
+    unsigned value = 0;
+    while (n--) {
+        value = (value << 1) | ((data[*pos >> 3] >> (7 - (*pos & 7))) & 1);
+        ++*pos;
+    }
+    return value;
+}
+
+static unsigned ue(const uint8_t *data, int *pos)
+{
+    int n = 0;
+    while (!bits(data, pos, 1) && n < 31)
+        n++;
+    return (1U << n) - 1 + bits(data, pos, n);
+}
+
+static void show(const AVPacket *pkt, int hevc)
+{
+    int start = -1, seen_vcl = 0, found = 0;
+    uint8_t *rbsp = av_malloc(pkt->size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!rbsp)
+        exit(1);
+    for (int end = 0; end <= pkt->size; end++) {
+        int next = end + 3 <= pkt->size && !pkt->data[end] &&
+                   !pkt->data[end + 1] && pkt->data[end + 2] == 1;
+        if (!next && end != pkt->size)
+            continue;
+        if (start >= 0) {
+            int type = hevc ? (pkt->data[start] >> 1) & 63 : pkt->data[start] & 31;
+            int size = 0, zeros = 0;
+            if (hevc ? type < 32 : type >= 1 && type <= 5)
+                seen_vcl = 1;
+            if (hevc ? type == 39 || type == 40 : type == 6) {
+                for (int i = start + 1 + hevc; i < end; i++) {
+                    int b = pkt->data[i];
+                    if (zeros == 2 && b == 3) {
+                        zeros = 0;
+                        continue;
+                    }
+                    rbsp[size++] = b;
+                    zeros = b ? 0 : zeros + 1;
+                }
+                memset(rbsp + size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+                if (!size || rbsp[0] == 0x80) {
+                    printf(" empty-sei");
+                } else for (int i = 0; i < size && rbsp[i] != 0x80;) {
+                    unsigned payload = 0, length = 0;
+                    while (i < size && rbsp[i] == 255)
+                        payload += rbsp[i++];
+                    if (i >= size)
+                        exit(2);
+                    payload += rbsp[i++];
+                    while (i < size && rbsp[i] == 255)
+                        length += rbsp[i++];
+                    if (i >= size)
+                        exit(2);
+                    length += rbsp[i++];
+                    if (length > size - i)
+                        exit(2);
+                    if (payload == 45) {
+                        int pos = 0, cancel, type, q, content, frame0, persistence;
+                        const uint8_t *p = rbsp + i;
+                        ue(p, &pos);
+                        cancel = bits(p, &pos, 1);
+                        if (cancel || length < 4)
+                            exit(2);
+                        type = bits(p, &pos, 7);
+                        q = bits(p, &pos, 1);
+                        content = bits(p, &pos, 6);
+                        bits(p, &pos, 3);
+                        frame0 = bits(p, &pos, 1);
+                        bits(p, &pos, 2);
+                        if (!q && type != 5)
+                            bits(p, &pos, 16);
+                        bits(p, &pos, 8);
+                        persistence = hevc ? bits(p, &pos, 1) : ue(p, &pos);
+                        printf(" %d,%d,%d,%d,%d,%d", type, q, content, frame0, persistence, !seen_vcl);
+                        found++;
+                    }
+                    if (payload == 47) {
+                        printf(" orientation");
+                        found++;
+                    }
+                    i += length;
+                }
+            }
+        }
+        start = end + 3;
+    }
+    if (!found)
+        printf(" none");
+    putchar('\n');
+    av_free(rbsp);
+}
+
+typedef struct NAL {
+    int start, end, type, layer, tid;
+} NAL;
+
+/* Split an Annex B access unit. */
+static int split_nals(const uint8_t *data, int size, int hevc, NAL *nals, int max)
+{
+    int count = 0, start = -1;
+    for (int end = 0; end <= size; end++) {
+        int next = end + 3 <= size && !data[end] && !data[end + 1] && data[end + 2] == 1;
+        if (!next && end != size)
+            continue;
+        if (start >= 0 && start + 1 + hevc < end && count < max) {
+            int stop = end;
+            while (stop > start && !data[stop - 1])
+                stop--;
+            nals[count++] = (NAL) {
+                .start = start, .end = stop,
+                .type  = hevc ? (data[start] >> 1) & 63 : data[start] & 31,
+                .layer = hevc ? ((data[start] & 1) << 5) | (data[start + 1] >> 3) : 0,
+                .tid   = hevc ? (data[start + 1] & 7) - 1 : 0,
+            };
+        }
+        start = end + 3;
+    }
+    return count;
+}
+
+static int unescape(const uint8_t *data, int start, int end, uint8_t *rbsp)
+{
+    int size = 0, zeros = 0;
+    for (int i = start; i < end; i++) {
+        int b = data[i];
+        if (zeros == 2 && b == 3) {
+            zeros = 0;
+            continue;
+        }
+        rbsp[size++] = b;
+        zeros = b ? 0 : zeros + 1;
+    }
+    memset(rbsp + size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    return size;
+}
+
+typedef struct Arrangement {
+    unsigned id;
+    int cancel, type, quincunx, content, flip, frame0, self_contained, persistence;
+} Arrangement;
+
+static void read_arrangement(const uint8_t *p, int hevc, Arrangement *a)
+{
+    int pos = 0;
+    memset(a, 0, sizeof(*a));
+    a->id     = ue(p, &pos);
+    a->cancel = bits(p, &pos, 1);
+    if (a->cancel)
+        return;
+    a->type     = bits(p, &pos, 7);
+    a->quincunx = bits(p, &pos, 1);
+    a->content  = bits(p, &pos, 6);
+    a->flip     = bits(p, &pos, 1);
+    bits(p, &pos, 2);
+    a->frame0 = bits(p, &pos, 1);
+    a->self_contained = bits(p, &pos, 2);
+    if (!a->quincunx && a->type != 5)
+        bits(p, &pos, 16);
+    bits(p, &pos, 8);
+    a->persistence = hevc ? bits(p, &pos, 1) : ue(p, &pos);
+}
+
+/* Walk the access unit: every NAL unit that matters, the frame packing
+ * messages in it, and the flag of the profile_tier_level that forbids them. */
+static void describe(const uint8_t *data, int size, int hevc)
+{
+    NAL nals[64];
+    uint8_t *rbsp = av_malloc(size + AV_INPUT_BUFFER_PADDING_SIZE);
+    int count = split_nals(data, size, hevc, nals, FF_ARRAY_ELEMS(nals));
+    if (!rbsp)
+        exit(1);
+    for (int n = 0; n < count; n++) {
+        const NAL *nal = &nals[n];
+        int length = unescape(data, nal->start + 1 + hevc, nal->end, rbsp);
+        if (hevc && (nal->type == 32 || nal->type == 33)) {
+            /* general_non_packed_constraint_flag: after the 32 bits of the
+             * VPS or the 8 bits of the SPS that precede profile_tier_level,
+             * profile space, tier, profile, 32 compatibility flags and the
+             * progressive and interlaced flags. */
+            int pos = (nal->type == 32 ? 32 : 8) + 2 + 1 + 5 + 32 + 2;
+            printf(" %s(non_packed=%u)", nal->type == 32 ? "vps" : "sps", bits(rbsp, &pos, 1));
+        } else if (hevc ? nal->type < 32 : nal->type >= 1 && nal->type <= 5) {
+            printf(" vcl(t%d,l%d)", nal->tid, nal->layer);
+        } else if (hevc ? nal->type == 39 || nal->type == 40 : nal->type == 6) {
+            for (int i = 0; i < length && rbsp[i] != 0x80;) {
+                unsigned payload = 0, len = 0;
+                while (i < length && rbsp[i] == 255)
+                    payload += rbsp[i++];
+                payload += rbsp[i++];
+                while (i < length && rbsp[i] == 255)
+                    len += rbsp[i++];
+                len += rbsp[i++];
+                if (len > length - i)
+                    exit(2);
+                if (payload == 45) {
+                    Arrangement a;
+                    read_arrangement(rbsp + i, hevc, &a);
+                    if (a.cancel)
+                        printf(" sei(t%d,l%d)[id=%u,cancel]", nal->tid, nal->layer, a.id);
+                    else
+                        printf(" sei(t%d,l%d)[id=%u,type=%d,q=%d,c=%d,flip=%d,f0=%d,s=%d,p=%d]",
+                               nal->tid, nal->layer, a.id, a.type, a.quincunx,
+                               a.content, a.flip, a.frame0, a.self_contained, a.persistence);
+                } else {
+                    printf(" sei(payload %u)", payload);
+                }
+                i += len;
+            }
+        }
+    }
+    putchar('\n');
+    av_free(rbsp);
+}
+
+static int fabricated_self_contained;
+
+/* An arrangement SEI NAL unit written here, not by the filter under test. */
+static int fabricate(int hevc, unsigned id, int cancel, int type, int quincunx,
+                     int content, int flip, int persistence, uint8_t *out)
+{
+    uint8_t payload[16] = { 0 }, rbsp[32];
+    int pos = 0, size, n = 0, zeros = 0;
+#define PUT(value, count) do { \
+        for (int k = (count) - 1; k >= 0; k--, pos++) \
+            payload[pos >> 3] |= (((value) >> k) & 1) << (7 - (pos & 7)); \
+    } while (0)
+    /* ue(id), for the small ids used here */
+    if (id < 3) {
+        PUT(id == 0 ? 1 : id == 1 ? 2 : 3, id == 0 ? 1 : 3);
+    } else {
+        exit(1);
+    }
+    PUT(cancel, 1);
+    if (!cancel) {
+        PUT(type, 7);
+        PUT(quincunx, 1);
+        PUT(content, 6);
+        PUT(flip, 1);
+        PUT(0, 2);
+        PUT(0, 1);
+        PUT(fabricated_self_contained, 2);
+        if (!quincunx && type != 5)
+            PUT(0, 16);
+        PUT(0, 8);
+        if (hevc)
+            PUT(persistence, 1);
+        else if (persistence)
+            PUT(2, 3);
+        else
+            PUT(1, 1);
+    }
+    PUT(0, 1); /* extension, upsampled aspect ratio */
+    PUT(1, 1);
+    size = (pos + 7) >> 3;
+    rbsp[0] = 45;
+    rbsp[1] = size;
+    memcpy(rbsp + 2, payload, size);
+    rbsp[2 + size] = 0x80;
+    out[n++] = 0;
+    out[n++] = 0;
+    out[n++] = 0;
+    out[n++] = 1;
+    if (hevc) {
+        out[n++] = 39 << 1;
+        out[n++] = 1;
+    } else {
+        out[n++] = 6;
+    }
+    for (int i = 0; i < size + 3; i++) {
+        if (zeros == 2 && rbsp[i] <= 3) {
+            out[n++] = 3;
+            zeros = 0;
+        }
+        out[n++] = rbsp[i];
+        zeros = rbsp[i] ? 0 : zeros + 1;
+    }
+#undef PUT
+    return n;
+}
+
+/* The access unit without its SEI NAL units but those of other uses, with
+ * extra bytes in front of the first slice. */
+static AVPacket *rebuild(const AVPacket *src, int hevc, const uint8_t *extra,
+                         int extra_size, int keep_sei)
+{
+    NAL nals[64];
+    int count = split_nals(src->data, src->size, hevc, nals, FF_ARRAY_ELEMS(nals));
+    AVPacket *pkt = av_packet_alloc();
+    uint8_t *out = av_malloc(src->size + extra_size + AV_INPUT_BUFFER_PADDING_SIZE);
+    int n = 0, added = !extra_size;
+    if (!pkt || !out)
+        exit(1);
+    for (int i = 0; i < count; i++) {
+        int vcl = hevc ? nals[i].type < 32 : nals[i].type >= 1 && nals[i].type <= 5;
+        int sei = hevc ? nals[i].type == 39 : nals[i].type == 6;
+        if (vcl && !added) {
+            memcpy(out + n, extra, extra_size);
+            n += extra_size;
+            added = 1;
+        }
+        if (sei && !keep_sei)
+            continue;
+        out[n++] = 0;
+        out[n++] = 0;
+        out[n++] = 0;
+        out[n++] = 1;
+        memcpy(out + n, src->data + nals[i].start, nals[i].end - nals[i].start);
+        n += nals[i].end - nals[i].start;
+    }
+    memset(out + n, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    if (av_packet_from_data(pkt, out, n) < 0)
+        exit(1);
+    pkt->flags = src->flags;
+    pkt->pts = src->pts;
+    pkt->dts = src->dts;
+    return pkt;
+}
+
+/* The bytes in front of the first slice: parameter sets and SEI. */
+static int before_first_slice(const AVPacket *pkt, int hevc)
+{
+    NAL nals[64];
+    int count = split_nals(pkt->data, pkt->size, hevc, nals, FF_ARRAY_ELEMS(nals));
+    for (int i = 0; i < count; i++) {
+        if (hevc ? nals[i].type < 32 : nals[i].type >= 1 && nals[i].type <= 5)
+            return nals[i].start - 4;
+    }
+    return pkt->size;
+}
+
+static int detail;
+
+static int add_stereo(AVPacketSideData **sd, int *nb_sd, int type, int invert, int view)
+{
+    size_t size;
+    AVStereo3D *st = av_stereo3d_alloc_size(&size);
+    if (!st)
+        return AVERROR(ENOMEM);
+    st->type = type;
+    st->flags = invert ? AV_STEREO3D_FLAG_INVERT : 0;
+    st->view = view;
+    if (!av_packet_side_data_add(sd, nb_sd, AV_PKT_DATA_STEREO3D, st, size, 0)) {
+        av_free(st);
+        return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+
+static void test(const char *label, const char *name, const AVCodecParameters *par,
+                 AVPacket **input, int count, const char *options,
+                 int stream_type, int packet_type, int invert, int view, int flush)
+{
+    AVBSFContext *ctx = NULL;
+    AVPacket *pkt = av_packet_alloc();
+    int ret;
+    printf("%s:", label);
+    if (!pkt)
+        exit(1);
+    ret = av_bsf_alloc(av_bsf_get_by_name(name), &ctx);
+    if (ret < 0 || avcodec_parameters_copy(ctx->par_in, par) < 0)
+        exit(1);
+    av_packet_side_data_remove(ctx->par_in->coded_side_data,
+                              &ctx->par_in->nb_coded_side_data, AV_PKT_DATA_STEREO3D);
+    if (stream_type >= 0 && add_stereo(&ctx->par_in->coded_side_data,
+                                     &ctx->par_in->nb_coded_side_data,
+                                     stream_type, invert, view) < 0)
+        exit(1);
+    ctx->time_base_in = (AVRational) { 1, 25 };
+    ret = av_opt_set_from_string(ctx->priv_data, options, NULL, "=", ":");
+    if (ret >= 0)
+        ret = av_bsf_init(ctx);
+    if (ret < 0) {
+        printf(" error\n");
+        goto end;
+    }
+    for (int i = 0; i < count; i++) {
+        if (av_packet_ref(pkt, input[i]) < 0)
+            exit(1);
+        av_packet_side_data_remove(pkt->side_data, &pkt->side_data_elems, AV_PKT_DATA_STEREO3D);
+        if (packet_type >= 0 && add_stereo(&pkt->side_data, &pkt->side_data_elems,
+                                         packet_type, invert,
+                                         view < 0 ? (i ? AV_STEREO3D_VIEW_UNSPEC :
+                                                         AV_STEREO3D_VIEW_RIGHT) : view) < 0)
+            exit(1);
+        if (flush)
+            av_bsf_flush(ctx);
+        ret = av_bsf_send_packet(ctx, pkt);
+        if (ret >= 0)
+            ret = av_bsf_receive_packet(ctx, pkt);
+        if (ret < 0) {
+            printf(" error\n");
+            break;
+        }
+        if (detail)
+            describe(pkt->data, pkt->size, par->codec_id == AV_CODEC_ID_HEVC);
+        else
+            show(pkt, par->codec_id == AV_CODEC_ID_HEVC);
+        av_packet_unref(pkt);
+    }
+end:
+    av_packet_free(&pkt);
+    av_bsf_free(&ctx);
+}
+
+
+static void extract_test(const char *label, const char *name,
+                         const AVCodecParameters *par, AVPacket **input,
+                         int count, const char *prepare)
+{
+    AVBSFContext *ctx[2] = { NULL };
+    AVPacket *pkt = av_packet_alloc(), *original = av_packet_alloc();
+    int ret = 0;
+
+    printf("%s:", label);
+    if (!pkt || !original)
+        exit(1);
+    for (int j = 0; j < 2; j++) {
+        if (av_bsf_alloc(av_bsf_get_by_name(name), &ctx[j]) < 0 ||
+            avcodec_parameters_copy(ctx[j]->par_in, par) < 0)
+            exit(1);
+        ctx[j]->time_base_in = (AVRational) { 1, 25 };
+        ret = av_opt_set_from_string(ctx[j]->priv_data,
+                                    j ? "frame_packing=extract" : prepare,
+                                    NULL, "=", ":");
+        if (ret < 0 || (ret = av_bsf_init(ctx[j])) < 0)
+            goto end;
+    }
+    for (int i = 0; i < count; i++) {
+        const AVStereo3D *st;
+        size_t size;
+        if (av_packet_ref(pkt, input[i]) < 0)
+            exit(1);
+        for (int j = 0; j < 2; j++) {
+            ret = av_bsf_send_packet(ctx[j], pkt);
+            if (ret >= 0)
+                ret = av_bsf_receive_packet(ctx[j], pkt);
+            if (ret < 0)
+                goto end;
+            if (!j && av_packet_ref(original, pkt) < 0)
+                exit(1);
+        }
+        printf(" unchanged=%d", pkt->size == original->size &&
+               !memcmp(pkt->data, original->data, pkt->size));
+        st = (const AVStereo3D *)av_packet_get_side_data(pkt, AV_PKT_DATA_STEREO3D, &size);
+        if (st && size >= sizeof(*st))
+            printf(" stereo=%d,%d,%d\n", st->type, st->flags, st->view);
+        else
+            printf(" none\n");
+        av_packet_unref(original);
+        av_packet_unref(pkt);
+    }
+end:
+    if (ret < 0)
+        printf(" error\n");
+    av_bsf_free(&ctx[0]);
+    av_bsf_free(&ctx[1]);
+    av_packet_free(&pkt);
+    av_packet_free(&original);
+}
