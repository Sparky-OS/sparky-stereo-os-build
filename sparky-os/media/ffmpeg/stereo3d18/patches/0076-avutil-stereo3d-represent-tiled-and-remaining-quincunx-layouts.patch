diff --git a/libavutil/stereo3d.h b/libavutil/stereo3d.h
index c0a4ab3f2d393553a643cb91a453354b1b4eba54..249829e2f829fdfdee94aaf2f38d8cf04d6aed10 100644
--- a/libavutil/stereo3d.h
+++ b/libavutil/stereo3d.h
@@ -141,6 +141,35 @@ enum AVStereo3DType {
      * Video is stereoscopic but the packing is unspecified.
      */
     AV_STEREO3D_UNSPEC,
+
+    /**
+     * Views use the tile format of H.264, section D.2.26, type 7.
+     * Each cell below is one third of the cropped width and height.
+     * The first view occupies the four L cells. The second view has
+     * its left part in A and its right part in B above C. X is unused.
+     *
+     * @code{.unparsed}
+     *    LLA
+     *    LLA
+     *    BCX
+     * @endcode
+     */
+    AV_STEREO3D_TILED,
+
+    /**
+     * Views are on top of each other, with quincunx subsampling.
+     */
+    AV_STEREO3D_TOPBOTTOM_QUINCUNX,
+
+    /**
+     * Views are packed per line, with quincunx subsampling.
+     */
+    AV_STEREO3D_LINES_QUINCUNX,
+
+    /**
+     * Views are packed per column, with quincunx subsampling.
+     */
+    AV_STEREO3D_COLUMNS_QUINCUNX,
 };
 
