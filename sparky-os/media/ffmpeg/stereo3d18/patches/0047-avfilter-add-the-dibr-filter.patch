+/**
+ * @file
+ * Depth-image-based rendering: a picture and its depth map to full side by
+ * side, through libstereo-dibr.
+ */
+
+#include <float.h>
+#include <limits.h>
+#include <stereo-dibr.h>
+
+#include "config.h"
+#include "libavutil/mem.h"
+#include "libavutil/multiview.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#include "libavutil/stereo3d.h"
+#include "avfilter.h"
+#include "filters.h"
+#include "formats.h"
+#include "framesync.h"
+#include "video.h"
+
+enum DibrDepth {
+    DEPTH_AUTO = -1,
+};
+
+typedef struct DibrContext {
+    const AVClass *class;
+    FFFrameSync fs;
+
+    int view, warp, fill, smooth;
+    double sigma_h, sigma_v;
+    int radius;
+    int depth;
+    double range, zero, shift;
+    double z_near, z_far;
+
+    stereo_dibr *dibr;
+    float *table;
+    uint16_t *lut;
+    int table_size;
+    int last_kind;
+} DibrContext;
+
+/* Planar formats of one component per plane, 1 to 16 bits in native-endian
+ * bytes or words; for the depth, not RGB (its first plane is luma). */
+static int is_usable(const AVPixFmtDescriptor *desc, int depth_input)
+{
+    unsigned planes = 0;
+
+    if (desc->flags & (AV_PIX_FMT_FLAG_HWACCEL | AV_PIX_FMT_FLAG_BITSTREAM | AV_PIX_FMT_FLAG_PAL |
+                       AV_PIX_FMT_FLAG_FLOAT | AV_PIX_FMT_FLAG_BAYER | AV_PIX_FMT_FLAG_XYZ))
+        return 0;
+    if (!(desc->flags & AV_PIX_FMT_FLAG_PLANAR) && desc->nb_components > 1)
+        return 0;
+    if (!!(desc->flags & AV_PIX_FMT_FLAG_BE) != HAVE_BIGENDIAN && desc->comp[0].depth > 8)
+        return 0;
+    if (depth_input && (desc->flags & AV_PIX_FMT_FLAG_RGB))
+        return 0;
+    for (int i = 0; i < desc->nb_components; i++) {
+        const AVComponentDescriptor *c = &desc->comp[i];
+        if (c->offset || c->shift || c->depth > 16 || c->step != (c->depth > 8 ? 2 : 1) ||
+            (planes & (1u << c->plane)))
+            return 0;
+        planes |= 1u << c->plane;
+    }
+    return planes == (1u << desc->nb_components) - 1;
+}
+
+static int query_formats(const AVFilterContext *ctx,
+                         AVFilterFormatsConfig **cfg_in,
+                         AVFilterFormatsConfig **cfg_out)
+{
+    AVFilterFormats *pictures = NULL, *depths = NULL;
+    const AVPixFmtDescriptor *desc = NULL;
+    int ret;
+
+    while ((desc = av_pix_fmt_desc_next(desc))) {
+        enum AVPixelFormat fmt = av_pix_fmt_desc_get_id(desc);
+        if (is_usable(desc, 0) && (ret = ff_add_format(&pictures, fmt)) < 0)
+            return ret;
+        if (is_usable(desc, 1) && (ret = ff_add_format(&depths, fmt)) < 0)
+            return ret;
+    }
+    if ((ret = ff_formats_ref(pictures, &cfg_in[0]->formats)) < 0 ||
+        (ret = ff_formats_ref(pictures, &cfg_out[0]->formats)) < 0)
+        return ret;
+    return ff_formats_ref(depths, &cfg_in[1]->formats);
+}
+
+/* What the depth frame's samples mean: its side data (or the picture's), else the option. */
+static int convention(AVFilterContext *ctx, const AVFrame *picture, const AVFrame *depth,
+                      struct stereo_depth_convention *c, int bits)
+{
+    DibrContext *s = ctx->priv;
+    const AVFrameSideData *sd;
+
+    memset(c, 0, sizeof(*c));
+    c->bits  = bits;
+    c->zero  = s->zero;
+    c->range = s->range;
+    c->shift = s->shift;
+    c->kind  = s->depth == DEPTH_AUTO ? STEREO_DEPTH_NEARNESS : s->depth;
+    if (s->z_near > 0 && s->z_far > 0) {
+        c->z_present = 1;
+        c->z_near    = s->z_near;
+        c->z_far     = s->z_far;
+    }
+    if (s->depth != DEPTH_AUTO)
+        return 0;
+
+    /* H.264 H.13.2.3, H.265 G.14.3.4, HEIF auxC: the first view's parameters */
+    sd = av_frame_get_side_data(depth, AV_FRAME_DATA_DEPTH_REPRESENTATION_INFO);
+    if (!sd)
+        sd = av_frame_get_side_data(picture, AV_FRAME_DATA_DEPTH_REPRESENTATION_INFO);
+    if (sd) {
+        const AVDepthRepresentationInfo *info = (const AVDepthRepresentationInfo *)sd->data;
+        const AVDepthRepresentationView *v = info->nb_views ?
+                                             av_depth_representation_info_get_view(info, 0) : NULL;
+        int ret;
+
+        switch (info->type) {
+        case AV_DEPTH_REPRESENTATION_INVERSE_Z:
+            c->kind = STEREO_DEPTH_INVERSE_Z;
+            break;
+        case AV_DEPTH_REPRESENTATION_DISPARITY:
+            c->kind = STEREO_DEPTH_DISPARITY;
+            break;
+        case AV_DEPTH_REPRESENTATION_Z:
+            c->kind = STEREO_DEPTH_Z;
+            break;
+        case AV_DEPTH_REPRESENTATION_NONLINEAR_DISPARITY:
+            c->kind = STEREO_DEPTH_NONLINEAR_DISPARITY;
+            ret = av_depth_representation_nonlinear_lut(info, bits, s->lut);
+            if (ret < 0)
+                return ret;
+            c->lut = s->lut;
+            break;
+        default:
+            av_log(ctx, AV_LOG_WARNING, "Reserved depth representation type %d, "
+                   "read as larger samples nearer\n", info->type);
+            return 0;
+        }
+        if (v && info->z_near_present && info->z_far_present && !c->z_present) {
+            c->z_present = 1;
+            c->z_near    = av_multiview_real_to_double(&v->z_near);
+            c->z_far     = av_multiview_real_to_double(&v->z_far);
+        }
+        if (v && info->d_min_present && info->d_max_present) {
+            /* in luma samples of the view, the picture (H.265 G.14.3.4) */
+            c->d_present = 1;
+            c->d_min     = av_multiview_real_to_double(&v->d_min);
+            c->d_max     = av_multiview_real_to_double(&v->d_max);
+            c->d_width   = picture->width;
+        }
+        return 0;
+    }
+
+    /* ISO/IEC 23002-3, which is not freely available: our reading */
+    sd = av_frame_get_side_data(depth, AV_FRAME_DATA_AUXILIARY_VIDEO_INFO);
+    if (sd) {
+        const AVAuxiliaryVideoInfo *info = (const AVAuxiliaryVideoInfo *)sd->data;
+
+        if (info->type == AV_AUXILIARY_VIDEO_PARALLAX) {
+            c->kind           = STEREO_DEPTH_PARALLAX;
+            c->parallax_zero  = info->parallax_zero;
+            c->parallax_scale = info->parallax_scale;
+            c->wref           = info->wref;
+        } else if (info->nkfar + info->nknear > 0) {
+            /* kfar behind the screen, knear in front of it, both of the
+             * screen width: the screen sits where one gives way to the other */
+            c->zero = (double)info->nkfar / (info->nkfar + info->nknear);
+        }
+    }
+    return 0;
+}
+
+/* The planes of a frame for libstereo-dibr, starting x_offset luma samples
+ * in; a hole of the none fill is black: limited range black and neutral
+ * chroma for YUV (gray is full range), zero for RGB, opaque alpha. */
+static void fill_picture(struct stereo_dibr_picture *p, const AVPixFmtDescriptor *desc,
+                         uint8_t *const data[4], const int linesize[4], int w, int h,
+                         int x_offset, int full_range)
+{
+    const int rgb = desc->flags & AV_PIX_FMT_FLAG_RGB;
+
+    memset(p, 0, sizeof(*p));
+    p->width     = w;
+    p->height    = h;
+    p->nb_planes = desc->nb_components;
+    for (int k = 0; k < desc->nb_components; k++) {
+        const AVComponentDescriptor *c = &desc->comp[k];
+        struct stereo_dibr_plane *pl = &p->plane[c->plane];
+        const int alpha  = k == 3 || (k == 1 && desc->nb_components == 2);
+        const int chroma = !rgb && !alpha && (k == 1 || k == 2);
+
+        pl->bytes  = c->step;
+        pl->log2_w = chroma ? desc->log2_chroma_w : 0;
+        pl->log2_h = chroma ? desc->log2_chroma_h : 0;
+        pl->stride = linesize[c->plane];
+        pl->data   = data[c->plane] + (x_offset >> pl->log2_w) * pl->bytes;
+        if (alpha)
+            pl->hole = (1u << c->depth) - 1;
+        else if (chroma)
+            pl->hole = 1u << (c->depth - 1);
+        else if (rgb || full_range || desc->nb_components < 3)
+            pl->hole = 0;
+        else
+            pl->hole = 16u << FFMAX(c->depth - 8, 0);
+    }
+}
+
+static int do_dibr(FFFrameSync *fs)
+{
+    AVFilterContext *ctx = fs->parent;
+    DibrContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(outlink->format);
+    const AVPixFmtDescriptor *ddesc;
+    struct stereo_depth_convention c;
+    struct stereo_dibr_params p;
+    struct stereo_dibr_picture in, left, right;
+    struct stereo_dibr_depth dm;
+    AVFrame *picture, *depth, *out;
+    AVStereo3D *stereo;
+    int ret, bits, full;
+
+    ret = ff_framesync_dualinput_get(fs, &picture, &depth);
+    if (ret < 0)
+        return ret;
+
+    if (depth) {
+        ddesc = av_pix_fmt_desc_get(depth->format);
+        bits  = ddesc->comp[0].depth;
+        if ((ret = convention(ctx, picture, depth, &c, bits)) < 0)
+            goto fail;
+        if (c.kind != s->last_kind) {
+            av_log(ctx, AV_LOG_VERBOSE, "depth read as convention %d\n", c.kind);
+            s->last_kind = c.kind;
+        }
+        s->table_size = 1 << bits;
+        if (stereo_depth_parallax_table(&c, picture->width, s->table) < 0) {
+            ret = AVERROR(EINVAL);
+            goto fail;
+        }
+        dm.data   = depth->data[0];
+        dm.stride = depth->linesize[0];
+        dm.bytes  = ddesc->comp[0].step;
+        dm.width  = depth->width;
+        dm.height = depth->height;
+    } else {
+        /* no depth yet: both eyes see the picture at the screen */
+        static const uint8_t flat = 0;
+        s->table[0]   = 0.0f;
+        s->table_size = 1;
+        dm.data   = &flat;
+        dm.stride = 1;
+        dm.bytes  = 1;
+        dm.width  = 1;
+        dm.height = 1;
+    }
+
+    out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_frame_copy_props(out, picture);
+    if (ret < 0) {
+        av_frame_free(&out);
+        goto fail;
+    }
+    av_frame_remove_side_data(out, AV_FRAME_DATA_STEREO3D);
+
+    full = picture->color_range == AVCOL_RANGE_JPEG;
+    fill_picture(&in, desc, picture->data, picture->linesize, picture->width, picture->height, 0, full);
+    fill_picture(&left, desc, out->data, out->linesize, picture->width, picture->height, 0, full);
+    fill_picture(&right, desc, out->data, out->linesize, picture->width, picture->height,
+                 picture->width, full);
+
+    stereo_dibr_params_default(&p);
+    p.view    = s->view;
+    p.warp    = s->warp;
+    p.fill    = s->fill;
+    p.smooth  = s->smooth;
+    p.sigma_h = s->sigma_h;
+    p.sigma_v = s->sigma_v;
+    p.radius  = s->radius;
+    ret = stereo_dibr_render(s->dibr, &p, s->table, s->table_size, &in, &dm, &left, &right);
+    if (ret < 0) {
+        av_log(ctx, AV_LOG_ERROR, "libstereo-dibr failed: %d\n", ret);
+        av_frame_free(&out);
+        ret = ret == -2 ? AVERROR(ENOMEM) : AVERROR(EINVAL);
+        goto fail;
+    }
+
+    /* full side by side, the left eye first */
+    stereo = av_stereo3d_create_side_data(out);
+    if (!stereo) {
+        av_frame_free(&out);
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    stereo->type = AV_STEREO3D_SIDEBYSIDE;
+    stereo->view = AV_STEREO3D_VIEW_PACKED;
+
+    av_frame_free(&picture);
+    return ff_filter_frame(outlink, out);
+
+fail:
+    av_frame_free(&picture);
+    return ret;
+}
+
+static av_cold int init(AVFilterContext *ctx)
+{
+    DibrContext *s = ctx->priv;
+
+    s->dibr  = stereo_dibr_alloc();
+    s->table = av_malloc_array(1 << 16, sizeof(*s->table));
+    s->lut   = av_malloc_array(1 << 16, sizeof(*s->lut));
+    if (!s->dibr || !s->table || !s->lut)
+        return AVERROR(ENOMEM);
+    s->last_kind = -1;
+    s->fs.on_event = do_dibr;
+    return 0;
+}
+
+static int config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    DibrContext *s = ctx->priv;
+    AVFilterLink *mainlink = ctx->inputs[0];
+    FilterLink *ol = ff_filter_link(outlink);
+    FilterLink *ml = ff_filter_link(mainlink);
+    int ret;
+
+    if (mainlink->w > INT_MAX / 2) {
+        av_log(ctx, AV_LOG_ERROR, "Picture too wide\n");
+        return AVERROR(EINVAL);
+    }
+    if ((ret = ff_framesync_init_dualinput(&s->fs, ctx)) < 0)
+        return ret;
+
+    outlink->w = mainlink->w * 2;
+    outlink->h = mainlink->h;
+    outlink->time_base = mainlink->time_base;
+    outlink->sample_aspect_ratio = mainlink->sample_aspect_ratio;
+    ol->frame_rate = ml->frame_rate;
+
+    return ff_framesync_configure(&s->fs);
+}
+
+static int activate(AVFilterContext *ctx)
+{
+    DibrContext *s = ctx->priv;
+    return ff_framesync_activate(&s->fs);
+}
+
+static av_cold void uninit(AVFilterContext *ctx)
+{
+    DibrContext *s = ctx->priv;
+
+    ff_framesync_uninit(&s->fs);
+    stereo_dibr_free(s->dibr);
+    av_freep(&s->table);
+    av_freep(&s->lut);
+}
