diff --git a/libavformat/hevcdec.c b/libavformat/hevcdec.c
index ee5ba9a7531..a2d68c67596 100644
--- a/libavformat/hevcdec.c
+++ b/libavformat/hevcdec.c
@@ -35,17 +35,19 @@ static int hevc_probe(const AVProbeData *p)
         if ((code & 0xffffff00) == 0x100) {
             uint8_t nal2 = p->buf[i + 1];
             int type = (code & 0x7E) >> 1;
+            int layer_id = (code & 0x01) << 5 | nal2 >> 3;
 
             if (code & 0x80) // forbidden zero bit
                 return 0;
 
-            // nuh_layer_id, 0 for the base layer and up to 62 for the layers
-            // of multilayer streams (F.7.4.2.2); 63 is reserved
-            if ((code & 0x01) && (nal2 & 0xf8) == 0xf8)
+            // nuh_layer_id is 0 for the base layer and up to 62 for the
+            // layers of multilayer streams (7.4.2.2), 63 is reserved
+            if (layer_id == 63 || !(nal2 & 0x07))
                 return 0;
 
-            if (!(nal2 & 0x07)) // nuh_temporal_id_plus1
-                return 0;
+            // a stream is recognised by its base layer
+            if (layer_id)
+                continue;
 
             switch (type) {
             case HEVC_NAL_VPS:        vps++;  break;
