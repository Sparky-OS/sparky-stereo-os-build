Description: [PATCH 14/22] Expose the unmodified Dolby Vision RPU T35 buffers
Author: Damiano Galassi
Origin: other, https://github.com/HandBrake/HandBrake/blob/1.11.2/contrib/ffmpeg/A14-Expose-the-unmodified-Dolby-Vision-RPU-T35-buffers.patch
Bug: https://github.com/HandBrake/HandBrake/commit/8deff21ece692e4be4e448553b576487a059a191
Forwarded: not-needed
Comment: Backported to the edition FFmpeg 9.0.2; preserve public enum values.
Refreshed for FFmpeg 9.1 (deb-multimedia 10:9.1-dmo1), 2026-11-26: the value stays as published in +16 and +17, before FFmpeg 9.1's AV_FRAME_DATA_DOWNMIX_MATRIX and AV_FRAME_DATA_GAIN_MAP_PARAMS.

diff --git a/libavcodec/av1dec.c b/libavcodec/av1dec.c
index 315828e18a4f2bc14db59539092c67f346f71795..fa476776b4790e8a588145f67dc641ade7bb268e 100644
--- a/libavcodec/av1dec.c
+++ b/libavcodec/av1dec.c
@@ -1010,6 +1010,18 @@ static int export_itut_t35(AVCodecContext *avctx, AVFrame *frame,
     if (ret <= 0)
         return ret;
 
+    if (itut35.country_code == ITU_T_T35_COUNTRY_CODE_US &&
+        itut35.provider_code == ITU_T_T35_PROVIDER_CODE_DOLBY) {
+        AVBufferRef *rpu_buf = av_buffer_alloc(itut_t35->payload_size);
+        if (!rpu_buf)
+            return AVERROR(ENOMEM);
+        memcpy(rpu_buf->data, itut_t35->payload, itut_t35->payload_size);
+        if (!av_frame_new_side_data_from_buf(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER_T35, rpu_buf)) {
+            av_buffer_unref(&rpu_buf);
+            return AVERROR(ENOMEM);
+        }
+    }
+
     ret = ff_itut_t35_parse_payload_to_frame(&itut35, &aux, avctx, frame);
     if (ret < 0)
         return ret;
