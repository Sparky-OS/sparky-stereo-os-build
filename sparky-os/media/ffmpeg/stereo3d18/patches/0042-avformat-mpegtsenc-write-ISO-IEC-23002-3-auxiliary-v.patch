 #include "mpegts.h"
 #include "mux.h"
 
@@ -120,6 +121,7 @@ typedef struct MpegTSWrite {
 #define MPEGTS_FLAG_DISCONT         0x10
 #define MPEGTS_FLAG_NIT             0x20
 #define MPEGTS_FLAG_OMIT_RAI        0x40
+#define MPEGTS_FLAG_OMIT_SI_TRAILING_BITS 0x80
     int flags;
     int copyts;
     int tables_version;
@@ -467,6 +469,34 @@ static int get_dvb_stream_type(AVFormatContext *s, AVStream *st)
     return stream_type;
 }
 
+/* The supplemental information of a stream to mux as an ISO/IEC 23002-3
+ * auxiliary video stream, for the video codecs ISO/IEC 13818-1 Table 2-34
+ * assigns a stream type. */
+static const AVAuxiliaryVideoInfo *get_aux_video_info(AVStream *st)
+{
+    const AVPacketSideData *sd;
+
+    switch (st->codecpar->codec_id) {
+    case AV_CODEC_ID_MPEG1VIDEO:
+    case AV_CODEC_ID_MPEG2VIDEO:
+    case AV_CODEC_ID_MPEG4:
+    case AV_CODEC_ID_H264:
+    case AV_CODEC_ID_HEVC:
+    case AV_CODEC_ID_VVC:
+        break;
+    default:
+        return NULL;
+    }
+
+    sd = av_packet_side_data_get(st->codecpar->coded_side_data,
+                                 st->codecpar->nb_coded_side_data,
+                                 AV_PKT_DATA_AUXILIARY_VIDEO_INFO);
+    if (!sd || sd->size < sizeof(AVAuxiliaryVideoInfo))
+        return NULL;
+
+    return (const AVAuxiliaryVideoInfo *)sd->data;
+}
+
 static int get_m2ts_stream_type(AVFormatContext *s, AVStream *st)
 {
     int stream_type;
@@ -527,7 +557,7 @@ static int mpegts_write_pmt(AVFormatContext *s, MpegTSService *service)
 {
     MpegTSWrite *ts = s->priv_data;
     uint8_t data[SECTION_LENGTH], *q, *desc_length_ptr, *program_info_length_ptr;
-    int val, stream_type, i, err = 0;
+    int val, stream_type, coded_stream_type, i, err = 0;
 
     q = data;
     put16(&q, 0xe000 | service->pcr_pid);
@@ -556,6 +586,7 @@ static int mpegts_write_pmt(AVFormatContext *s, MpegTSService *service)
         const char default_language[] = "und";
         const char *language = lang && strlen(lang->value) >= 3 ? lang->value : default_language;
         enum AVCodecID codec_id = st->codecpar->codec_id;
+        const AVAuxiliaryVideoInfo *aux_info = NULL;
 
         if (s->nb_programs) {
             int k, found = 0;
@@ -577,6 +608,12 @@ static int mpegts_write_pmt(AVFormatContext *s, MpegTSService *service)
         }
 
         stream_type = ts->m2ts_mode ? get_m2ts_stream_type(s, st) : get_dvb_stream_type(s, st);
+        coded_stream_type = stream_type;
+
+        /* an auxiliary video stream, coded as aux_video_codedstreamtype of its
+         * descriptor says (ISO/IEC 13818-1 2.6.74 and 2.16) */
+        if (!ts->m2ts_mode && (aux_info = get_aux_video_info(st)))
+            stream_type = STREAM_TYPE_AUXILIARY_VIDEO;
 
         *q++ = stream_type;
         put16(&q, 0xe000 | ts_st->pid);
@@ -816,14 +853,14 @@ static int mpegts_write_pmt(AVFormatContext *s, MpegTSService *service)
             }
         break;
         case AVMEDIA_TYPE_VIDEO:
-            if (stream_type == STREAM_TYPE_VIDEO_DIRAC) {
+            if (coded_stream_type == STREAM_TYPE_VIDEO_DIRAC) {
                 put_registration_descriptor(&q, MKTAG('d', 'r', 'a', 'c'));
-            } else if (stream_type == STREAM_TYPE_VIDEO_VC1) {
+            } else if (coded_stream_type == STREAM_TYPE_VIDEO_VC1) {
                 put_registration_descriptor(&q, MKTAG('V', 'C', '-', '1'));
-            } else if (stream_type == STREAM_TYPE_VIDEO_HEVC && s->strict_std_compliance <= FF_COMPLIANCE_NORMAL) {
+            } else if (coded_stream_type == STREAM_TYPE_VIDEO_HEVC && s->strict_std_compliance <= FF_COMPLIANCE_NORMAL) {
                 put_registration_descriptor(&q, MKTAG('H', 'E', 'V', 'C'));
-            } else if (stream_type == STREAM_TYPE_VIDEO_CAVS || stream_type == STREAM_TYPE_VIDEO_AVS2 ||
-                       stream_type == STREAM_TYPE_VIDEO_AVS3) {
+            } else if (coded_stream_type == STREAM_TYPE_VIDEO_CAVS || coded_stream_type == STREAM_TYPE_VIDEO_AVS2 ||
+                       coded_stream_type == STREAM_TYPE_VIDEO_AVS3) {
                 put_registration_descriptor(&q, MKTAG('A', 'V', 'S', 'V'));
             }
             if (ts_st->nb_stream_groups) {
@@ -852,6 +889,20 @@ static int mpegts_write_pmt(AVFormatContext *s, MpegTSService *service)
                     }
                 }
             }
+            if (aux_info) {
+                uint8_t *len_ptr;
+
+                if (q - data > SECTION_LENGTH - 3 - FF_AUX_VIDEO_SI_WRITE_SIZE) {
+                    err = 1;
+                    break;
+                }
+                *q++ = AUXILIARY_VIDEO_STREAM_DESCRIPTOR;
+                len_ptr = q++;
+                *q++ = coded_stream_type;
+                q += ff_aux_video_si_write(q, aux_info,
+                                           !(ts->flags & MPEGTS_FLAG_OMIT_SI_TRAILING_BITS));
+                *len_ptr = q - len_ptr - 1;
+            }
             break;
         case AVMEDIA_TYPE_DATA:
             if (codec_id == AV_CODEC_ID_SMPTE_KLV) {
@@ -2506,6 +2557,8 @@ static const AVOption options[] = {
       0, AV_OPT_TYPE_CONST, { .i64 = MPEGTS_FLAG_NIT}, 0, INT_MAX, ENC, .unit = "mpegts_flags" },
     { "omit_rai", "Disable writing of random access indicator",
       0, AV_OPT_TYPE_CONST, { .i64 = MPEGTS_FLAG_OMIT_RAI }, 0, INT_MAX, ENC, .unit = "mpegts_flags" },
+    { "omit_si_trailing_bits", "Write the supplemental information of auxiliary video streams without rbsp_trailing_bits()",
+      0, AV_OPT_TYPE_CONST, { .i64 = MPEGTS_FLAG_OMIT_SI_TRAILING_BITS }, 0, INT_MAX, ENC, .unit = "mpegts_flags" },
     { "mpegts_copyts", "don't offset dts/pts", OFFSET(copyts), AV_OPT_TYPE_BOOL, { .i64 = -1 }, -1, 1, ENC },
     { "tables_version", "set PAT, PMT, SDT and NIT version", OFFSET(tables_version), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 31, ENC },
     { "omit_video_pes_length", "Omit the PES packet length for video packets",
