diff --git a/libavformat/mpegauxvideo.c b/libavformat/mpegauxvideo.c
index 60514a43efab25ac8a4b3f02f2947b74589483d7..c73b30a808bfb9ffcef8167a962b2d3c2e7836de 100644
--- a/libavformat/mpegauxvideo.c
+++ b/libavformat/mpegauxvideo.c
@@ -29,7 +29,8 @@
  * is the syntax as TSDuck reads it (AuxiliaryVideoStreamDescriptor), whose
  * parallax_params() HDMI 1.4a (Table H-4) confirms. An RBSP ends with
  * rbsp_trailing_bits() (ITU-T H.264 3.129), which TSDuck neither reads nor
- * writes: the reader accepts the messages with or without it.
+ * writes: the reader accepts the messages with or without it, and the writer
+ * writes it on request.
  */
 
 #include "libavutil/intreadwrite.h"
@@ -160,3 +161,36 @@ fail:
     av_log(logctx, AV_LOG_ERROR, "Truncated auxiliary video supplemental information\n");
     return ret;
 }
+
+int ff_aux_video_si_write(uint8_t *buf, const AVAuxiliaryVideoInfo *info,
+                          int trailing_bits)
+{
+    uint8_t *p = buf;
+    int depth = info->type == AV_AUXILIARY_VIDEO_DEPTH;
+
+    *p++ = depth ? AV_AUXILIARY_VIDEO_DEPTH : AV_AUXILIARY_VIDEO_PARALLAX;
+    *p++ = depth ? 5 : 11;
+
+    /* generic_params(), the reserved bits set as TSDuck sets them */
+    *p++ = info->aux_is_one_field << 7 |
+           (info->aux_is_one_field ? info->aux_is_bottom_field
+                                   : info->aux_is_interlaced) << 6 | 0x3f;
+    *p++ = info->position_offset_h;
+    *p++ = info->position_offset_v;
+
+    if (depth) {
+        *p++ = info->nkfar;
+        *p++ = info->nknear;
+    } else {
+        AV_WB16(p,     info->parallax_zero);
+        AV_WB16(p + 2, info->parallax_scale);
+        AV_WB16(p + 4, info->dref);
+        AV_WB16(p + 6, info->wref);
+        p += 8;
+    }
+
+    if (trailing_bits)
+        *p++ = 0x80;
+
+    return p - buf;
+}
diff --git a/libavformat/mpegauxvideo.h b/libavformat/mpegauxvideo.h
index 466f78c1629a1d93822f297991a5a643bf498e0a..9797e7fb7017895306d199a359b11c2360aa69dd 100644
--- a/libavformat/mpegauxvideo.h
+++ b/libavformat/mpegauxvideo.h
@@ -26,6 +26,12 @@
 #include "libavutil/multiview.h"
 #include "libavcodec/codec_par.h"
 
+/**
+ * The longest si_rbsp() ff_aux_video_si_write() writes: a parallax map's
+ * auxiliary video SI message and rbsp_trailing_bits().
+ */
+#define FF_AUX_VIDEO_SI_WRITE_SIZE 14
+
 /**
  * Read the si_rbsp() of an auxiliary video stream descriptor (ISO/IEC 13818-1
  * 2.6.74 and 2.6.75) and export its auxiliary video SI message as the
@@ -38,4 +44,15 @@
 int ff_aux_video_si_parse(void *logctx, AVCodecParameters *par,
                           const uint8_t *buf, int size);
 
+/**
+ * Write the si_rbsp() of an auxiliary video stream descriptor for info: one
+ * auxiliary video SI message, followed by rbsp_trailing_bits() when
+ * trailing_bits is set.
+ *
+ * @return the number of bytes written to buf, which has room for
+ *         FF_AUX_VIDEO_SI_WRITE_SIZE
+ */
+int ff_aux_video_si_write(uint8_t *buf, const AVAuxiliaryVideoInfo *info,
+                          int trailing_bits);
+
 #endif /* AVFORMAT_MPEGAUXVIDEO_H */
