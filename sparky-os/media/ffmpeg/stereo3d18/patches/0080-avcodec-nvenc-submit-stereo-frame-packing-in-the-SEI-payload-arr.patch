diff --git a/libavcodec/nvenc.c b/libavcodec/nvenc.c
index 6e7331405f379f754d4897755a7e3f697744a873..759b5212801383e6756e0354669e8f7f8adb4ac0 100644
--- a/libavcodec/nvenc.c
+++ b/libavcodec/nvenc.c
@@ -2123,6 +2123,12 @@ av_cold int ff_nvenc_encode_init(AVCodecContext *avctx)
     NvencContext *ctx = avctx->priv_data;
     int ret;
 
+    ret = ff_frame_packing_init(avctx, &ctx->frame_packing_state,
+                                ctx->extra_sei && ctx->frame_packing,
+                                "-frame_packing 0", 0);
+    if (ret < 0)
+        return ret;
+
     if (IS_HWACCEL(avctx->pix_fmt)) {
         AVHWFramesContext *frames_ctx;
         if (!avctx->hw_frames_ctx) {
@@ -2732,6 +2738,43 @@ static int prepare_sei_data_array(AVCodecContext *avctx, const AVFrame *frame)
     int sei_count = 0;
     int i, res;
 
+    if (ctx->frame_packing_state.enabled) {
+        FFFramePackingParams packing;
+        uint8_t data[16];
+        int64_t order = ctx->frame_idx_counter - 1;
+        int idr = !order ||
+                  (ctx->encode_config.gopLength != NVENC_INFINITE_GOPLENGTH &&
+                   order - ctx->frame_packing_last_idr >= ctx->encode_config.gopLength) ||
+                  (ctx->forced_idr == 1 && frame->pict_type == AV_PICTURE_TYPE_I);
+        int keyframe = idr || (ctx->forced_idr >= 0 && frame->pict_type == AV_PICTURE_TYPE_I);
+
+        if (idr)
+            ctx->frame_packing_last_idr = order;
+        res = ff_frame_packing_prepare(avctx, &ctx->frame_packing_state, frame,
+                                       keyframe, order, &packing);
+        if (res < 0)
+            return res;
+        if (res) {
+            NV_ENC_SEI_PAYLOAD *tmp;
+            int size = ff_frame_packing_payload(avctx->codec_id, &packing, data);
+
+            tmp = av_fast_realloc(ctx->sei_data, &ctx->sei_data_size, sizeof(*tmp));
+            if (!tmp)
+                return AVERROR(ENOMEM);
+            ctx->sei_data = tmp;
+            ctx->sei_data[0] = (NV_ENC_SEI_PAYLOAD) {
+                .payloadType = SEI_TYPE_FRAME_PACKING_ARRANGEMENT,
+                .payloadSize = size,
+                .payload = av_memdup(data, size),
+            };
+            if (!ctx->sei_data[0].payload)
+                return AVERROR(ENOMEM);
+            /* The mandatory payload is first and at most 16 bytes, so
+             * the HEVC 512-byte budget cannot discard it. */
+            sei_count = 1;
+        }
+    }
+
     if (ctx->a53_cc && av_frame_get_side_data(frame, AV_FRAME_DATA_A53_CC)) {
         void *a53_data = NULL;
         size_t a53_size = 0;
