Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: upstream, https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/43fe08263776548dce1bdf7a836bfacee527a027
From 43fe08263776548dce1bdf7a836bfacee527a027 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 04:19:06 -0300
Subject: [PATCH 32/48] fftools/ffprobe, avfilter/vf_showinfo: print the AuxId
 of auxiliary pictures

Assisted-by: Claude Opus 5.5 via Claude Code
---
Refreshed for FFmpeg 9.1 (deb-multimedia 10:9.1-dmo1), 2026-11-26: the context moved in FFmpeg 9.1; the lines this patch adds and removes are unchanged

diff --git a/fftools/ffprobe.c b/fftools/ffprobe.c
index 775034878639ac02183f0b7c91310ec872ebc71c..51ae648ff1580e5ed32762d1554e58075e765252 100644
--- a/fftools/ffprobe.c
+++ b/fftools/ffprobe.c
@@ -1860,6 +1860,8 @@ static void print_frame_side_data(AVTextFormatContext *tfc,
             print_gain_map_params(tfc, (const AVGainMapParams *)sd->data);
         } else if (sd->type == AV_FRAME_DATA_VIEW_ID) {
             print_int("view_id", *(int*)sd->data);
+        } else if (sd->type == AV_FRAME_DATA_AUXILIARY_ID) {
+            print_int("aux_id", *(int*)sd->data);
         } else if (print_multiview_side_data(tfc, 1, sd->type, sd->data)) {
         } else if (sd->type == AV_FRAME_DATA_EXIF) {
             print_int("size", sd->size);
diff --git a/libavfilter/vf_showinfo.c b/libavfilter/vf_showinfo.c
index 69b410e6a852c8c1d3e4d0fd3d4f866b6ce37b30..9810c9d1a5b0ccf088598963af299aa5fa0d6df1 100644
--- a/libavfilter/vf_showinfo.c
+++ b/libavfilter/vf_showinfo.c
@@ -933,6 +933,9 @@ static int filter_frame(AVFilterLink *inlink, AVFrame *frame)
         case AV_FRAME_DATA_VIEW_ID:
             av_log(ctx, AV_LOG_INFO, "view id: %d\n", *(int*)sd->data);
             break;
+        case AV_FRAME_DATA_AUXILIARY_ID:
+            av_log(ctx, AV_LOG_INFO, "AuxId: %d\n", *(int*)sd->data);
+            break;
         case AV_FRAME_DATA_3D_REFERENCE_DISPLAYS:
             dump_tdrdi(ctx, sd);
             break;
