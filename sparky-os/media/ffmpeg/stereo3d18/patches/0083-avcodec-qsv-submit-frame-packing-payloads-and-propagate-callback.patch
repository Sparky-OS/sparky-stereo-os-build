+static int qsv_hevc_check_frame_packing(AVCodecContext *avctx, const AVStereo3D *stereo)
+{
+    CodedBitstreamContext *cbs = NULL;
+    CodedBitstreamFragment headers = { 0 };
+    int ret, seen = 0;
+
+    ret = ff_cbs_init(&cbs, AV_CODEC_ID_HEVC, avctx);
+    if (ret < 0)
+        goto end;
+    ret = ff_cbs_read(cbs, &headers, NULL, avctx->extradata, avctx->extradata_size);
+    if (ret < 0)
+        goto end;
+    for (int i = 0; i < headers.nb_units; i++) {
+        const CodedBitstreamUnit *unit = &headers.units[i];
+        const H265RawProfileTierLevel *ptl;
+        int sublayers;
+
+        if (unit->type == HEVC_NAL_VPS) {
+            const H265RawVPS *vps = unit->content;
+            ptl = &vps->profile_tier_level;
+            sublayers = vps->vps_max_sub_layers_minus1;
+        } else if (unit->type == HEVC_NAL_SPS) {
+            const H265RawSPS *sps = unit->content;
+            ptl = &sps->profile_tier_level;
+            sublayers = sps->sps_max_sub_layers_minus1;
+        } else {
+            continue;
+        }
+        seen |= unit->type == HEVC_NAL_VPS ? 1 : 2;
+        if (ptl->general_non_packed_constraint_flag) {
+            ret = AVERROR(ENOSYS);
+            goto end;
+        }
+        for (int j = 0; j < sublayers; j++) {
+            if (ptl->sub_layer_profile_present_flag[j] &&
+                ptl->sub_layer_non_packed_constraint_flag[j]) {
+                ret = AVERROR(ENOSYS);
+                goto end;
+            }
+        }
+    }
+    if (seen != 3)
+        ret = AVERROR_INVALIDDATA;
+end:
+    ff_cbs_fragment_free(&headers);
+    ff_cbs_close(&cbs);
+    if (ret < 0)
+        av_log(avctx, AV_LOG_ERROR, "Cannot signal %s frame packing: QSV HEVC "
+               "parameter sets do not establish clear non-packed constraints; "
+               "use another encoder or -frame_packing 0 to disable the mark.\n",
+               av_stereo3d_type_name(stereo->type));
+    return ret;
+}
+
 static int qsv_hevc_set_encode_ctrl(AVCodecContext *avctx,
                                     const AVFrame *frame, mfxEncodeCtrl *enc_ctrl)
 {
     QSVHEVCEncContext *q = avctx->priv_data;
     AVFrameSideData *sd;
 
+    if (frame && q->qsv.frame_packing_state.enabled) {
+        const AVStereo3D *stereo;
+        const AVFrameSideData *packing_sd = av_frame_get_side_data(frame, AV_FRAME_DATA_STEREO3D);
+        int ret;
+
+        if (!packing_sd)
+            packing_sd = av_frame_side_data_get(avctx->decoded_side_data,
+                                                avctx->nb_decoded_side_data,
+                                                AV_FRAME_DATA_STEREO3D);
+        stereo = packing_sd ? (const AVStereo3D *)packing_sd->data : NULL;
+        if (stereo && stereo->type != AV_STEREO3D_2D) {
+            ret = qsv_hevc_check_frame_packing(avctx, stereo);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
     if (!frame || !QSV_RUNTIME_VERSION_ATLEAST(q->qsv.ver, 1, 25))
         return 0;
 
