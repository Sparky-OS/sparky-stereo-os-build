+            payload->Data[1] = size;
+            memcpy(payload->Data + 2, data, size);
+            payload->BufSize = size + 2;
+            payload->NumBit = payload->BufSize * 8;
+            payload->Type = SEI_TYPE_FRAME_PACKING_ARRANGEMENT;
+            enc_ctrl->Payload[enc_ctrl->NumPayload++] = payload;
+        }
     }
 
