Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: upstream, https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/715f46a7a2ad646e190b37a8401edf82e54862a8
From 715f46a7a2ad646e190b37a8401edf82e54862a8 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 04:55:29 -0300
Subject: [PATCH 44/48] fate/mpegts: test ISO/IEC 23002-3 auxiliary video
 streams

A transport stream with a texture, a depth map and a parallax map, the
maps as auxiliary video streams (stream type 0x1E) with an auxiliary
video stream descriptor each, the parallax map's without
rbsp_trailing_bits(): the streams and the frames, and the stream remuxed
with and without rbsp_trailing_bits().

The sample, mpegts/depth-aux.ts, needs to be uploaded to the FATE suite.

Assisted-by: Claude Opus 5.5 via Claude Code
---
Refreshed for FFmpeg 9.1 (deb-multimedia 10:9.1-dmo1), 2026-11-26: the three references lose the streams nested in the program, which FFmpeg 9.1 prints only when program_stream is selected (88f7fd9ec5, cuptu); the streams and their side data are unchanged.

diff --git a/tests/fate/mpegts.mak b/tests/fate/mpegts.mak
index 39600294dfe5485f155cf007df22859274882814..a7ddf8ae68a4705fdb432e973ad5323af6c2d3b9 100644
--- a/tests/fate/mpegts.mak
+++ b/tests/fate/mpegts.mak
@@ -65,6 +65,28 @@ fate-mpegts-lcevc-vvc-dual-track: CMD = stream_demux mpegts $(TARGET_SAMPLES)/lc
   "" "-c:v copy -map 0:1" \
   "-show_entries stream_group=index,id,nb_streams,type:stream=index,id,codec_name"
 
+# ISO/IEC 23002-3 auxiliary video streams (stream type 0x1E): a depth map, and
+# a parallax map without rbsp_trailing_bits(), each with an auxiliary video
+# stream descriptor (ISO/IEC 13818-1 2.6.74)
+FATE_MPEGTS_FFMPEG_FFPROBE-$(call FRAMECRC, MPEGTS, H264, H264_PARSER) += fate-mpegts-auxiliary-video
+fate-mpegts-auxiliary-video: CMD = stream_demux mpegts $(TARGET_SAMPLES)/mpegts/depth-aux.ts "" "-c:v copy -map 0" \
+  "-of compact -show_entries stream=index,codec_name,codec_tag_string:stream_side_data_list"
+
+# the supplemental information as decoded frames carry it
+FATE_MPEGTS_PROBE-$(call DEMDEC, MPEGTS, H264) += fate-mpegts-auxiliary-video-frame
+fate-mpegts-auxiliary-video-frame: SRC = $(TARGET_SAMPLES)/mpegts/depth-aux.ts
+fate-mpegts-auxiliary-video-frame: CMD = run ffprobe$(PROGSSUF)$(EXESUF) -v 0 -bitexact -of compact \
+    -select_streams 1 -show_entries frame=stream_index,pix_fmt:frame_side_data_list -read_intervals "%+\#1" -i "$(SRC)"
+
+# remuxed: both descriptors written with rbsp_trailing_bits(), then without
+FATE_MPEGTS_FFMPEG_FFPROBE-$(call REMUX, MPEGTS, H264_DECODER H264_PARSER) += fate-mpegts-auxiliary-video-remux
+fate-mpegts-auxiliary-video-remux: CMD = transcode mpegts $(TARGET_SAMPLES)/mpegts/depth-aux.ts mpegts \
+  "-map 0 -c copy" "-map 0 -c copy" "-of compact -show_entries stream=index,codec_tag_string:stream_side_data_list"
+
+FATE_MPEGTS_FFMPEG_FFPROBE-$(call REMUX, MPEGTS, H264_DECODER H264_PARSER) += fate-mpegts-auxiliary-video-remux-tsduck
+fate-mpegts-auxiliary-video-remux-tsduck: CMD = transcode mpegts $(TARGET_SAMPLES)/mpegts/depth-aux.ts mpegts \
+  "-map 0 -c copy -mpegts_flags omit_si_trailing_bits" "-map 0 -c copy" "-of compact -show_entries stream=index,codec_tag_string:stream_side_data_list"
+
 FATE_SAMPLES_FFPROBE += $(FATE_MPEGTS_PROBE-yes)
 FATE_SAMPLES_FFMPEG_FFPROBE += $(FATE_MPEGTS_FFMPEG_FFPROBE-yes)
 
