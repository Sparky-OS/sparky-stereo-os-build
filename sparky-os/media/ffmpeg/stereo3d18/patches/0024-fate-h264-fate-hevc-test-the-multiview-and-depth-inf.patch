Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: upstream, https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/325456cd3ecd85a6e7fb89ab0334f18d05940edc
From 325456cd3ecd85a6e7fb89ab0334f18d05940edc Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 03:46:36 -0300
Subject: [PATCH 24/48] fate/h264, fate/hevc: test the multiview and depth
 information SEI messages

Streams with every multiview and depth information message of their
codec in the first access unit, a non-linear depth representation that
replaces the first in the third, a new coded video sequence without
messages in the fifth, which ends them all, and a reserved depth
representation type in the seventh. In the H.264 stream, multiview
acquisition information in the second access unit ends the 3D reference
displays information (H.13.2.4); the H.265 stream cancels its
alternative depth information in the fourth, and its 3D reference
displays information ends at the IRAP access unit (G.14.3.3).

The samples, h264/depth-sei.h264 and hevc/depth-sei.hevc, need to be
uploaded to the FATE suite.

Assisted-by: Claude Opus 5.5 via Claude Code
---
Refreshed for FFmpeg 9.1 (deb-multimedia 10:9.1-dmo1), 2026-11-26: the context moved in FFmpeg 9.1; the lines this patch adds and removes are unchanged

diff --git a/tests/fate/h264.mak b/tests/fate/h264.mak
index d33241e07d0ff91e6b00ecf393fbbaa9cc145a1c..744d28e05992f114deec4563e3ecc28ed1ef06de 100644
--- a/tests/fate/h264.mak
+++ b/tests/fate/h264.mak
@@ -258,6 +258,11 @@ FATE_H264_FFPROBE-$(call PARSERDEMDEC, H264, H264, H264) += fate-h264-timecode-p
 FATE_H264_FFPROBE-$(call PARSERDEMDEC, H264, H264, H264) += fate-h264-skip-pred \
                                                             fate-h264-skip-pred-fields
 
+# multiview and depth information SEI messages (H.264 G.13, H.13, I.13): each
+# applies until the next of its type or the end of the coded video sequence
+fate-h264-depth-sei: CMD = threads=4 probeframes -show_entries frame=key_frame,side_data_list:frame_tags= -of compact $(TARGET_SAMPLES)/h264/depth-sei.h264
+FATE_H264_FFPROBE-$(call PARSERDEMDEC, H264, H264, H264) += fate-h264-depth-sei
+
 fate-h264-frame-packing-persistence: CMD = threads=4 probeframes -show_entries frame=side_data_list:frame_tags= -of compact $(TARGET_SAMPLES)/h264/frame-packing-persistence.h264
 FATE_H264_FFPROBE-$(call PARSERDEMDEC, H264, H264, H264) += fate-h264-frame-packing-persistence
 
diff --git a/tests/fate/hevc.mak b/tests/fate/hevc.mak
