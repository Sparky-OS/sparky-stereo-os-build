From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 04:58:06 -0300
Subject: [PATCH 46/48] fate/mpegps: test ISO/IEC 23002-3 auxiliary video
 streams

The streams of the mpegts auxiliary video test in a program stream, the
maps in PES packets with stream_id_extension 0x10 and 0x11 and described
in the program stream map.

The sample, mpegps/depth-aux.mpg, needs to be uploaded to the FATE
suite.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 tests/fate/mpegps.mak                 | 11 +++++++-
 tests/ref/fate/mpegps-auxiliary-video | 39 +++++++++++++++++++++++++++
 2 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 tests/ref/fate/mpegps-auxiliary-video

diff --git a/tests/fate/mpegps.mak b/tests/fate/mpegps.mak
index a6114b1a..c1530aab 100644
--- a/tests/fate/mpegps.mak
+++ b/tests/fate/mpegps.mak
@@ -3,5 +3,14 @@ FATE_MPEGPS-$(call REMUX, MPEG1SYSTEM MPEGPS) += fate-mpegps-remuxed-pcm-demux
 fate-mpegps-remuxed-pcm-demux: $(SAMPLES)/mpegps/pcm_aud.mpg
 fate-mpegps-remuxed-pcm-demux: CMD = stream_remux "mpeg" "$(TARGET_SAMPLES)/mpegps/pcm_aud.mpg" "" "mpeg" "-map 0:a:0" "" "-codec copy"
 
+# ISO/IEC 23002-3 auxiliary video streams in a program stream: a depth map
+# and a parallax map with stream_id_extension 0x10 and 0x11, which the
+# program stream map describes as stream type 0x1E with an auxiliary video
+# stream descriptor each (ISO/IEC 13818-1 2.16)
+FATE_MPEGPS_FFPROBE-$(call FRAMECRC, MPEGPS, H264, H264_PARSER) += fate-mpegps-auxiliary-video
+fate-mpegps-auxiliary-video: CMD = stream_demux mpeg $(TARGET_SAMPLES)/mpegps/depth-aux.mpg "" "-c:v copy -map 0" \
+  "-of compact -show_entries stream=index,id,codec_name:stream_side_data_list"
+
 FATE_SAMPLES_FFMPEG += $(FATE_MPEGPS-yes)
-fate-mpegps: $(FATE_MPEGPS-yes)
+FATE_SAMPLES_FFMPEG_FFPROBE += $(FATE_MPEGPS_FFPROBE-yes)
+fate-mpegps: $(FATE_MPEGPS-yes) $(FATE_MPEGPS_FFPROBE-yes)
