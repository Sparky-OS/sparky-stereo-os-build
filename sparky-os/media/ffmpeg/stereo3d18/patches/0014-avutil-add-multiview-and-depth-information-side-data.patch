diff --git a/libavutil/tests/multiview.c b/libavutil/tests/multiview.c
new file mode 100644
index 0000000000000000000000000000000000000000..4e18453c0f8300cdccfe72985ea1fe3b2dc5d1ed
--- /dev/null
+++ b/libavutil/tests/multiview.c
@@ -0,0 +1,141 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <inttypes.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "libavutil/mem.h"
+#include "libavutil/multiview.h"
+
+static void print_real(uint8_t sign, uint8_t exponent, uint8_t exponent_bits,
+                       uint8_t mantissa_bits, uint64_t mantissa)
+{
+    const AVMultiviewReal r = {
+        .sign          = sign,
+        .exponent      = exponent,
+        .exponent_bits = exponent_bits,
+        .mantissa_bits = mantissa_bits,
+        .mantissa      = mantissa,
+    };
+    const double x = av_multiview_real_to_double(&r);
+
+    if (isnan(x))
+        printf("s=%d e=%d/%d v=%d n=%"PRIu64": unspecified\n",
+               sign, exponent, exponent_bits, mantissa_bits, mantissa);
+    else
+        printf("s=%d e=%d/%d v=%d n=%"PRIu64": %.17g\n",
+               sign, exponent, exponent_bits, mantissa_bits, mantissa, x);
+}
+
+int main(void)
+{
+    AVMultiviewAcquisitionInfo *acq;
+    AVMultiviewViewPosition *pos;
+    AVDepthRepresentationInfo *dri;
+    AVDepthTiming *timing;
+    AVDepthSamplingInfo *sampling;
+    AVAlternativeDepthInfo *alt;
+    uint16_t lut[256];
+    size_t size;
+
+    printf("Testing av_multiview_real_to_double()\n");
+    print_real(0, 31, 6, 0, 0);
+    print_real(0, 32, 6, 1, 1);
+    print_real(1, 30, 7, 3, 4);
+    print_real(0, 0, 6, 2, 3);
+    print_real(1, 0, 7, 0, 0);
+    print_real(0, 62, 6, 62, (1ULL << 62) - 1);
+    print_real(0, 1, 7, 32, 0xffffffff);
+    print_real(0, 63, 6, 4, 1);
+    print_real(0, 127, 7, 4, 1);
+    print_real(0, 63, 7, 4, 1);
+
+    printf("Testing the allocators\n");
+    acq = av_multiview_acquisition_info_alloc(3, &size);
+    if (acq) {
+        printf("acquisition: cameras=%u size>=3=%s\n", acq->nb_cameras,
+               size >= 3 * acq->camera_size ? "yes" : "no");
+        for (unsigned i = 0; i < acq->nb_cameras; i++) {
+            AVMultiviewCamera *c = av_multiview_acquisition_info_get_camera(acq, i);
+            if ((uint8_t *)c != (uint8_t *)acq + acq->cameras_offset + i * acq->camera_size)
+                printf("camera %u: wrong offset\n", i);
+            c->translation[0].exponent = i;
+        }
+        av_free(acq);
+    }
+
+    pos = av_multiview_view_position_alloc(4, &size);
+    if (pos) {
+        uint16_t *p = av_multiview_view_position_get(pos);
+        for (unsigned i = 0; i < pos->nb_views; i++)
+            p[i] = pos->nb_views - 1 - i;
+        printf("view position: views=%u last=%u\n", pos->nb_views, p[pos->nb_views - 1]);
+        av_free(pos);
+    }
+
+    dri = av_depth_representation_info_alloc(2, &size);
+    if (dri) {
+        printf("depth representation: views=%u all_views_equal=%d\n",
+               dri->nb_views, dri->all_views_equal);
+        av_depth_representation_info_get_view(dri, 1)->view_id = 7;
+
+        /* one segment boundary moved by 20: the curve of equation G-10 of
+         * H.265 through (0, 0), (107, 147) and (255, 255) */
+        dri->type               = AV_DEPTH_REPRESENTATION_NONLINEAR_DISPARITY;
+        dri->nb_nonlinear_model = 3;
+        dri->nonlinear_model[0] = 0;
+        dri->nonlinear_model[1] = 20;
+        dri->nonlinear_model[2] = 0;
+        if (!av_depth_representation_nonlinear_lut(dri, 8, lut)) {
+            printf("nonlinear lut:");
+            for (int i = 0; i < 256; i += 15)
+                printf(" %d:%d", i, lut[i]);
+            printf("\n");
+        }
+        dri->type = AV_DEPTH_REPRESENTATION_DISPARITY;
+        printf("nonlinear lut for type 1: %s\n",
+               av_depth_representation_nonlinear_lut(dri, 8, lut) < 0 ? "refused" : "made");
+        av_free(dri);
+    }
+
+    timing = av_depth_timing_alloc(2, &size);
+    if (timing) {
+        av_depth_timing_get_offset(timing, 1)->offset_fp = 5;
+        printf("depth timing: offsets=%u\n", timing->nb_offsets);
+        av_free(timing);
+    }
+
+    sampling = av_depth_sampling_info_alloc(1, &size);
+    if (sampling) {
+        printf("depth sampling: positions=%u dttsr=%u/%u\n", sampling->nb_positions,
+               sampling->dttsr_x_mul, sampling->dttsr_y_mul);
+        av_depth_sampling_info_get_position(sampling, 0)->x_fp = 1;
+        av_free(sampling);
+    }
+
+    alt = av_alternative_depth_info_alloc(5, &size);
+    if (alt) {
+        av_alternative_depth_info_get_view(alt, 4)->z_near.exponent = 1;
+        printf("alternative depth: views=%u\n", alt->nb_views);
+        av_free(alt);
+    }
+
+    return 0;
+}
