+ */
+
+/*
+ * The elements the multiview and depth information SEI messages of H.264
+ * and H.265 share, included by their syntax templates.
+ */
+
+/* A mantissa of up to 64 bits, in two parts when it is longer than 32. */
+static int FUNC(multiview_mantissa)(CodedBitstreamContext *ctx, RWContext *rw,
+                                    uint64_t *mantissa, int length)
+{
+    uint32_t high = *mantissa >> 32, low = *mantissa;
+    int err;
+
+    if (length > 32) {
+        xu(length - 32, mantissa_high, high, 0, MAX_UINT_BITS(length - 32), 0);
+        xu(32, mantissa_low, low, 0, UINT32_MAX, 0);
+        *mantissa = (uint64_t)high << 32 | low;
+    } else if (length > 0) {
+        xu(length, mantissa, low, 0, MAX_UINT_BITS(length), 0);
+        *mantissa = low;
+    } else {
+        *mantissa = 0;
+    }
+
+    return 0;
+}
+
+/* A camera or display parameter: a sign, a 6-bit exponent and a mantissa
+ * whose length follows from the exponent and the precision (H.265 G.14.3.6,
+ * H.264 G.13.2.5). */
+static int FUNC(multiview_real)(CodedBitstreamContext *ctx, RWContext *rw,
+                                SEIRawMultiviewReal *current, int prec)
+{
+    int length, err;
+
+    flag(sign);
+    u(6, exponent, 0, 63);
+    length = current->exponent ? current->exponent + prec - 31 : prec - 30;
+
+    return FUNC(multiview_mantissa)(ctx, rw, &current->mantissa, FFMAX(length, 0));
+}
+
+/* depth_rep_info_element() (H.265 G.14.2.4.2) and
+ * depth_representation_sei_element() (H.264 H.13.1.3.1) */
+static int FUNC(depth_rep_element)(CodedBitstreamContext *ctx, RWContext *rw,
+                                   SEIRawDepthRepElement *current)
+{
+    int err;
+
+    flag(da_sign_flag);
+    u(7, da_exponent, 0, 127);
+    u(5, da_mantissa_len_minus1, 0, 31);
+    u(current->da_mantissa_len_minus1 + 1, da_mantissa,
+      0, MAX_UINT_BITS(current->da_mantissa_len_minus1 + 1));
+
+    return 0;
+}
+
+/* The intrinsic parameters of a camera. */
+static int FUNC(multiview_intrinsic)(CodedBitstreamContext *ctx, RWContext *rw,
+                                     SEIRawMultiviewCamera *current,
+                                     int prec_focal_length, int prec_principal_point,
+                                     int prec_skew_factor)
+{
+    int err;
+
+    CHECK(FUNC(multiview_real)(ctx, rw, &current->focal_length_x, prec_focal_length));
+    CHECK(FUNC(multiview_real)(ctx, rw, &current->focal_length_y, prec_focal_length));
+    CHECK(FUNC(multiview_real)(ctx, rw, &current->principal_point_x, prec_principal_point));
+    CHECK(FUNC(multiview_real)(ctx, rw, &current->principal_point_y, prec_principal_point));
+    if (prec_skew_factor >= 0)
+        CHECK(FUNC(multiview_real)(ctx, rw, &current->skew_factor, prec_skew_factor));
+
+    return 0;
+}
+
+/* The rotation and translation of a camera, row by row (equations G-13 and
+ * G-14 of H.265). */
+static int FUNC(multiview_extrinsic)(CodedBitstreamContext *ctx, RWContext *rw,
+                                     SEIRawMultiviewCamera *current,
+                                     int prec_rotation_param, int prec_translation_param)
+{
+    int err;
+
+    for (int j = 0; j < 3; j++) {
+        for (int k = 0; k < 3; k++)
+            CHECK(FUNC(multiview_real)(ctx, rw, &current->r[j][k], prec_rotation_param));
+        CHECK(FUNC(multiview_real)(ctx, rw, &current->t[j], prec_translation_param));
+    }
+
+    return 0;
+}
+
+/* The global view and depth information of an alternative depth
+ * information SEI message (H.264 H.13.1.6, H.265 I.14.2.3). */
+static int FUNC(alternative_depth_gvd)(CodedBitstreamContext *ctx, RWContext *rw,
+                                       SEIRawAlternativeDepthGVD *current)
+{
+    int err;
+
+    ue(num_constituent_views_gvd_minus1, 0, 3);
+    flag(depth_present_gvd_flag);
+    flag(z_gvd_flag);
+    flag(intrinsic_param_gvd_flag);
+    flag(rotation_gvd_flag);
+    flag(translation_gvd_flag);
+    if (current->z_gvd_flag) {
+        for (int i = 0; i <= current->num_constituent_views_gvd_minus1 + 1; i++) {
+            CHECK(FUNC(depth_rep_element)(ctx, rw, &current->z_near[i]));
+            CHECK(FUNC(depth_rep_element)(ctx, rw, &current->z_far[i]));
+        }
+    }
+    if (current->intrinsic_param_gvd_flag) {
+        ue(prec_gvd_focal_length, 0, 31);
+        ue(prec_gvd_principal_point, 0, 31);
+    }
+    if (current->rotation_gvd_flag)
+        ue(prec_gvd_rotation_param, 0, 31);
+    if (current->translation_gvd_flag)
+        ue(prec_gvd_translation_param, 0, 31);
+    for (int i = 0; i <= current->num_constituent_views_gvd_minus1 + 1; i++) {
+        SEIRawMultiviewCamera *c = &current->camera[i];
+
+        if (current->intrinsic_param_gvd_flag)
+            CHECK(FUNC(multiview_intrinsic)(ctx, rw, c, current->prec_gvd_focal_length,
+                                            current->prec_gvd_principal_point, -1));
+        if (current->rotation_gvd_flag)
+            for (int j = 0; j < 3; j++)
+                for (int k = 0; k < 3; k++)
+                    CHECK(FUNC(multiview_real)(ctx, rw, &c->r[j][k],
+                                               current->prec_gvd_rotation_param));
+        if (current->translation_gvd_flag)
+            CHECK(FUNC(multiview_real)(ctx, rw, &c->t[0], current->prec_gvd_translation_param));
+    }
+
+    return 0;
+}
