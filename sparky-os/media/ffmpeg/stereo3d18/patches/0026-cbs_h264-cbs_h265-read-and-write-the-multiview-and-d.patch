diff --git a/libavcodec/cbs_h264.h b/libavcodec/cbs_h264.h
index 3763f249..4f716879 100644
--- a/libavcodec/cbs_h264.h
+++ b/libavcodec/cbs_h264.h
@@ -322,6 +322,115 @@ typedef struct H264RawSEIDisplayOrientation {
     uint8_t display_orientation_extension_flag;
 } H264RawSEIDisplayOrientation;
 
+typedef struct H264RawSEIMultiviewSceneInfo {
+    uint16_t max_disparity;
+} H264RawSEIMultiviewSceneInfo;
+
+typedef struct H264RawSEIMultiviewAcquisitionInfo {
+    uint16_t num_views_minus1;
+    uint8_t  intrinsic_param_flag;
+    uint8_t  extrinsic_param_flag;
+    uint8_t  intrinsic_params_equal_flag;
+    uint8_t  prec_focal_length;
+    uint8_t  prec_principal_point;
+    uint8_t  prec_skew_factor;
+    uint8_t  prec_rotation_param;
+    uint8_t  prec_translation_param;
+    SEIRawMultiviewCamera camera[1024];
+} H264RawSEIMultiviewAcquisitionInfo;
+
+typedef struct H264RawSEIMultiviewViewPosition {
+    uint16_t num_views_minus1;
+    uint16_t view_position[1024];
+    uint8_t  multiview_view_position_extension_flag;
+} H264RawSEIMultiviewViewPosition;
+
+typedef struct H264RawSEIDepthRepresentationView {
+    uint16_t depth_info_view_id;
+    uint16_t z_axis_reference_view;
+    uint16_t disparity_reference_view;
+    SEIRawDepthRepElement z_near;
+    SEIRawDepthRepElement z_far;
+    SEIRawDepthRepElement d_min;
+    SEIRawDepthRepElement d_max;
+} H264RawSEIDepthRepresentationView;
+
+typedef struct H264RawSEIDepthRepresentationInfo {
+    uint8_t  all_views_equal_flag;
+    uint16_t num_views_minus1;
+    uint8_t  z_near_flag;
+    uint8_t  z_far_flag;
+    uint8_t  z_axis_equal_flag;
+    uint16_t common_z_axis_reference_view;
+    uint8_t  d_min_flag;
+    uint8_t  d_max_flag;
+    uint8_t  depth_representation_type;
+    H264RawSEIDepthRepresentationView view[1024];
+    uint8_t  depth_nonlinear_representation_num_minus1;
+    uint16_t depth_nonlinear_representation_model[64];
+} H264RawSEIDepthRepresentationInfo;
+
+typedef struct H264RawSEI3DReferenceDisplaysInfo {
+    uint8_t prec_ref_baseline;
+    uint8_t prec_ref_display_width;
+    uint8_t ref_viewing_distance_flag;
+    uint8_t prec_ref_viewing_dist;
+    uint8_t num_ref_displays_minus1;
+    SEIRawMultiviewReal ref_baseline[32];
+    SEIRawMultiviewReal ref_display_width[32];
+    SEIRawMultiviewReal ref_viewing_distance[32];
+    uint8_t  additional_shift_present_flag[32];
+    uint16_t num_sample_shift_plus512[32];
+    uint8_t three_dimensional_reference_displays_extension_flag;
+} H264RawSEI3DReferenceDisplaysInfo;
+
+typedef struct H264RawSEIDepthTimingOffset {
+    uint8_t  offset_len_minus1;
+    uint32_t depth_disp_delay_offset_fp;
+    uint8_t  depth_disp_delay_offset_dp;
+} H264RawSEIDepthTimingOffset;
+
+typedef struct H264RawSEIDepthTiming {
+    uint8_t per_view_depth_timing_flag;
+    /**
+     * The number of offsets: NumDepthViews of the MVCD sequence parameter set
+     * with per_view_depth_timing_flag, which is not read, so the offsets
+     * the payload holds; otherwise 1.
+     */
+    uint16_t nb_offsets;
+    H264RawSEIDepthTimingOffset offset[1024];
+} H264RawSEIDepthTiming;
+
+typedef struct H264RawSEIDepthGridPosition {
+    uint32_t depth_grid_pos_x_fp;
+    uint8_t  depth_grid_pos_x_dp;
+    uint8_t  depth_grid_pos_x_sign_flag;
+    uint32_t depth_grid_pos_y_fp;
+    uint8_t  depth_grid_pos_y_dp;
+    uint8_t  depth_grid_pos_y_sign_flag;
+} H264RawSEIDepthGridPosition;
+
+typedef struct H264RawSEIDepthSamplingInfo {
+    uint16_t dttsr_x_mul;
+    uint8_t  dttsr_x_dp;
+    uint16_t dttsr_y_mul;
+    uint8_t  dttsr_y_dp;
+    uint8_t  per_view_depth_grid_pos_flag;
+    uint16_t num_video_plus_depth_views_minus1;
+    uint16_t depth_grid_view_id[1024];
+    H264RawSEIDepthGridPosition position[1024];
+} H264RawSEIDepthSamplingInfo;
+
+typedef struct H264RawSEIConstrainedDepthParameterSetIdentifier {
+    uint32_t max_dps_id;
+    uint32_t max_dps_id_diff;
+} H264RawSEIConstrainedDepthParameterSetIdentifier;
+
+typedef struct H264RawSEIAlternativeDepthInfo {
+    uint32_t depth_type;
+    SEIRawAlternativeDepthGVD gvd;
+} H264RawSEIAlternativeDepthInfo;
+
 typedef struct H264RawSEI {
     H264RawNALUnitHeader nal_unit_header;
     SEIRawMessageList    message_list;
diff --git a/libavcodec/cbs_h264_syntax_template.c b/libavcodec/cbs_h264_syntax_template.c
index 9d0386c2..384ea0c9 100644
--- a/libavcodec/cbs_h264_syntax_template.c
+++ b/libavcodec/cbs_h264_syntax_template.c
@@ -27,6 +27,8 @@ static int FUNC(rbsp_trailing_bits)(CodedBitstreamContext *ctx, RWContext *rw)
     return 0;
 }
 
+#include "cbs_multiview_template.c"
+
 static int FUNC(nal_unit_header)(CodedBitstreamContext *ctx, RWContext *rw,
                                  H264RawNALUnitHeader *current,
                                  uint32_t valid_type_mask)
@@ -855,6 +857,265 @@ SEI_FUNC(sei_display_orientation, (CodedBitstreamContext *ctx, RWContext *rw,
     return 0;
 }
 
+SEI_FUNC(sei_multiview_scene_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                    H264RawSEIMultiviewSceneInfo *current,
+                                    SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Multiview Scene Information");
+
+    ue(max_disparity, 0, 1023);
+
+    return 0;
+}
+
+SEI_FUNC(sei_multiview_acquisition_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                          H264RawSEIMultiviewAcquisitionInfo *current,
+                                          SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Multiview Acquisition Information");
+
+    ue(num_views_minus1, 0, 1023);
+    flag(intrinsic_param_flag);
+    flag(extrinsic_param_flag);
+    if (current->intrinsic_param_flag) {
+        flag(intrinsic_params_equal_flag);
+        ue(prec_focal_length, 0, 31);
+        ue(prec_principal_point, 0, 31);
+        ue(prec_skew_factor, 0, 31);
+        for (int i = 0; i <= (current->intrinsic_params_equal_flag ? 0 : current->num_views_minus1); i++)
+            CHECK(FUNC(multiview_intrinsic)(ctx, rw, &current->camera[i],
+                                            current->prec_focal_length,
+                                            current->prec_principal_point,
+                                            current->prec_skew_factor));
+    }
+    if (current->extrinsic_param_flag) {
+        ue(prec_rotation_param, 0, 31);
+        ue(prec_translation_param, 0, 31);
+        for (int i = 0; i <= current->num_views_minus1; i++)
+            CHECK(FUNC(multiview_extrinsic)(ctx, rw, &current->camera[i],
+                                            current->prec_rotation_param,
+                                            current->prec_translation_param));
+    }
+
+    return 0;
+}
+
+SEI_FUNC(sei_multiview_view_position, (CodedBitstreamContext *ctx, RWContext *rw,
+                                       H264RawSEIMultiviewViewPosition *current,
+                                       SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Multiview View Position");
+
+    ue(num_views_minus1, 0, 1023);
+    for (int i = 0; i <= current->num_views_minus1; i++)
+        ues(view_position[i], 0, 1023, 1, i);
+    flag(multiview_view_position_extension_flag);
+
+    return 0;
+}
+
+SEI_FUNC(sei_depth_representation_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                         H264RawSEIDepthRepresentationInfo *current,
+                                         SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Depth Representation Information");
+
+    flag(all_views_equal_flag);
+    if (!current->all_views_equal_flag)
+        ue(num_views_minus1, 0, 1023);
+    else
+        infer(num_views_minus1, 0);
+    flag(z_near_flag);
+    flag(z_far_flag);
+    if (current->z_near_flag || current->z_far_flag) {
+        flag(z_axis_equal_flag);
+        if (current->z_axis_equal_flag)
+            ue(common_z_axis_reference_view, 0, 1023);
+    }
+    flag(d_min_flag);
+    flag(d_max_flag);
+    ue(depth_representation_type, 0, 15);
+    /* the data after a reserved type is kept as payload extension data */
+    if (current->depth_representation_type > 3)
+        return 0;
+    for (int i = 0; i <= current->num_views_minus1; i++) {
+        H264RawSEIDepthRepresentationView *v = &current->view[i];
+
+        xue(depth_info_view_id[i], v->depth_info_view_id, 0, 1023, 1, i);
+        if ((current->z_near_flag || current->z_far_flag) && !current->z_axis_equal_flag)
+            xue(z_axis_reference_view[i], v->z_axis_reference_view, 0, 1023, 1, i);
+        if (current->d_min_flag || current->d_max_flag)
+            xue(disparity_reference_view[i], v->disparity_reference_view, 0, 1023, 1, i);
+        if (current->z_near_flag)
+            CHECK(FUNC(depth_rep_element)(ctx, rw, &v->z_near));
+        if (current->z_far_flag)
+            CHECK(FUNC(depth_rep_element)(ctx, rw, &v->z_far));
+        if (current->d_min_flag)
+            CHECK(FUNC(depth_rep_element)(ctx, rw, &v->d_min));
+        if (current->d_max_flag)
+            CHECK(FUNC(depth_rep_element)(ctx, rw, &v->d_max));
+    }
+    if (current->depth_representation_type == 3) {
+        ue(depth_nonlinear_representation_num_minus1, 0, 62);
+        for (int i = 1; i <= current->depth_nonlinear_representation_num_minus1 + 1; i++)
+            ues(depth_nonlinear_representation_model[i], 0, 65535, 1, i);
+    }
+
+    return 0;
+}
+
+SEI_FUNC(sei_3d_reference_displays_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                          H264RawSEI3DReferenceDisplaysInfo *current,
+                                          SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Three Dimensional Reference Displays Information");
+
+    ue(prec_ref_baseline, 0, 31);
+    ue(prec_ref_display_width, 0, 31);
+    flag(ref_viewing_distance_flag);
+    if (current->ref_viewing_distance_flag)
+        ue(prec_ref_viewing_dist, 0, 31);
+    ue(num_ref_displays_minus1, 0, 31);
+    for (int i = 0; i <= current->num_ref_displays_minus1; i++) {
+        CHECK(FUNC(multiview_real)(ctx, rw, &current->ref_baseline[i],
+                                   current->prec_ref_baseline));
+        CHECK(FUNC(multiview_real)(ctx, rw, &current->ref_display_width[i],
+                                   current->prec_ref_display_width));
+        if (current->ref_viewing_distance_flag)
+            CHECK(FUNC(multiview_real)(ctx, rw, &current->ref_viewing_distance[i],
+                                       current->prec_ref_viewing_dist));
+        flags(additional_shift_present_flag[i], 1, i);
+        if (current->additional_shift_present_flag[i])
+            us(10, num_sample_shift_plus512[i], 0, 1023, 1, i);
+    }
+    flag(three_dimensional_reference_displays_extension_flag);
+
+    return 0;
+}
+
+SEI_FUNC(sei_depth_timing, (CodedBitstreamContext *ctx, RWContext *rw,
+                            H264RawSEIDepthTiming *current,
+                            SEIMessageState *sei))
+{
+    const int start = bit_position(rw);
+    int err;
+
+    HEADER("Depth Timing");
+
+    flag(per_view_depth_timing_flag);
+#ifdef READ
+    /* one offset per depth view, NumDepthViews of the MVCD sequence
+     * parameter set: the offsets the payload holds, 12 bits at least each */
+    current->nb_offsets = 0;
+    do {
+        H264RawSEIDepthTimingOffset *o = &current->offset[current->nb_offsets];
+
+        const int i = current->nb_offsets;
+
+        xu(5, offset_len_minus1[i], o->offset_len_minus1, 0, 31, 1, i);
+        xu(o->offset_len_minus1 + 1, depth_disp_delay_offset_fp[i], o->depth_disp_delay_offset_fp,
+           0, MAX_UINT_BITS(o->offset_len_minus1 + 1), 1, i);
+        xu(6, depth_disp_delay_offset_dp[i], o->depth_disp_delay_offset_dp, 0, 63, 1, i);
+        current->nb_offsets++;
+    } while (current->per_view_depth_timing_flag &&
+             current->nb_offsets < FF_ARRAY_ELEMS(current->offset) &&
+             8 * (int)sei->payload_size - (bit_position(rw) - start) >= 12);
+#else
+    for (int i = 0; i < (current->per_view_depth_timing_flag ? current->nb_offsets : 1); i++) {
+        H264RawSEIDepthTimingOffset *o = &current->offset[i];
+
+        xu(5, offset_len_minus1[i], o->offset_len_minus1, 0, 31, 1, i);
+        xu(o->offset_len_minus1 + 1, depth_disp_delay_offset_fp[i], o->depth_disp_delay_offset_fp,
+           0, MAX_UINT_BITS(o->offset_len_minus1 + 1), 1, i);
+        xu(6, depth_disp_delay_offset_dp[i], o->depth_disp_delay_offset_dp, 0, 63, 1, i);
+    }
+    (void)start;
+#endif
+
+    return 0;
+}
+
+static int FUNC(depth_grid_position)(CodedBitstreamContext *ctx, RWContext *rw,
+                                     H264RawSEIDepthGridPosition *current)
+{
+    int err;
+
+    u(20, depth_grid_pos_x_fp, 0, MAX_UINT_BITS(20));
+    u(4, depth_grid_pos_x_dp, 0, 15);
+    flag(depth_grid_pos_x_sign_flag);
+    u(20, depth_grid_pos_y_fp, 0, MAX_UINT_BITS(20));
+    u(4, depth_grid_pos_y_dp, 0, 15);
+    flag(depth_grid_pos_y_sign_flag);
+
+    return 0;
+}
+
+SEI_FUNC(sei_depth_sampling_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                   H264RawSEIDepthSamplingInfo *current,
+                                   SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Depth Sampling Information");
+
+    ub(16, dttsr_x_mul);
+    ub(4, dttsr_x_dp);
+    ub(16, dttsr_y_mul);
+    ub(4, dttsr_y_dp);
+    flag(per_view_depth_grid_pos_flag);
+    if (current->per_view_depth_grid_pos_flag) {
+        ue(num_video_plus_depth_views_minus1, 0, 1023);
+        for (int i = 0; i <= current->num_video_plus_depth_views_minus1; i++) {
+            ues(depth_grid_view_id[i], 0, 1023, 1, i);
+            CHECK(FUNC(depth_grid_position)(ctx, rw, &current->position[i]));
+        }
+    } else {
+        CHECK(FUNC(depth_grid_position)(ctx, rw, &current->position[0]));
+    }
+
+    return 0;
+}
+
+SEI_FUNC(sei_constrained_depth_parameter_set_identifier,
+         (CodedBitstreamContext *ctx, RWContext *rw,
+          H264RawSEIConstrainedDepthParameterSetIdentifier *current,
+          SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Constrained Depth Parameter Set Identifier");
+
+    ue(max_dps_id, 0, UINT32_MAX - 1);
+    ue(max_dps_id_diff, 0, UINT32_MAX - 1);
+
+    return 0;
+}
+
+SEI_FUNC(sei_alternative_depth_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                      H264RawSEIAlternativeDepthInfo *current,
+                                      SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Alternative Depth Information");
+
+    ue(depth_type, 0, UINT32_MAX - 1);
+    if (current->depth_type == 0)
+        CHECK(FUNC(alternative_depth_gvd)(ctx, rw, &current->gvd));
+
+    return 0;
+}
+
 static int FUNC(sei)(CodedBitstreamContext *ctx, RWContext *rw,
                      H264RawSEI *current)
 {
