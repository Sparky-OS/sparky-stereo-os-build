+SEI_FUNC(sei_depth_representation_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                         H265RawSEIDepthRepresentationInfo *current,
+                                         SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Depth Representation Information");
+
+    flag(z_near_flag);
+    flag(z_far_flag);
+    flag(d_min_flag);
+    flag(d_max_flag);
+    ue(depth_representation_type, 0, 15);
+    /* the data after a reserved type is kept as payload extension data */
+    if (current->depth_representation_type > 3)
+        return 0;
+    if (current->d_min_flag || current->d_max_flag)
+        ue(disparity_ref_view_id, 0, 1023);
+    if (current->z_near_flag)
+        CHECK(FUNC(depth_rep_element)(ctx, rw, &current->z_near));
+    if (current->z_far_flag)
+        CHECK(FUNC(depth_rep_element)(ctx, rw, &current->z_far));
+    if (current->d_min_flag)
+        CHECK(FUNC(depth_rep_element)(ctx, rw, &current->d_min));
+    if (current->d_max_flag)
+        CHECK(FUNC(depth_rep_element)(ctx, rw, &current->d_max));
+    if (current->depth_representation_type == 3) {
+        ue(depth_nonlinear_representation_num_minus1, 0, 62);
+        for (int i = 1; i <= current->depth_nonlinear_representation_num_minus1 + 1; i++)
+            ues(depth_nonlinear_representation_model[i], 0, 65535, 1, i);
+    }
+
+    return 0;
+}
+
+SEI_FUNC(sei_multiview_scene_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                    H265RawSEIMultiviewSceneInfo *current,
+                                    SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Multiview Scene Information");
+
+    se(min_disparity, -1024, 1023);
+    ue(max_disparity_range, 0, 2047);
+
+    return 0;
+}
+
+SEI_FUNC(sei_multiview_acquisition_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                          H265RawSEIMultiviewAcquisitionInfo *current,
+                                          SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Multiview Acquisition Information");
+
+    flag(intrinsic_param_flag);
+    flag(extrinsic_param_flag);
+    if (current->intrinsic_param_flag) {
+        flag(intrinsic_params_equal_flag);
+        ue(prec_focal_length, 0, 31);
+        ue(prec_principal_point, 0, 31);
+        ue(prec_skew_factor, 0, 31);
+        CHECK(FUNC(multiview_intrinsic)(ctx, rw, &current->camera,
+                                        current->prec_focal_length,
+                                        current->prec_principal_point,
+                                        current->prec_skew_factor));
+    }
+    if (current->extrinsic_param_flag) {
+        ue(prec_rotation_param, 0, 31);
+        ue(prec_translation_param, 0, 31);
+        CHECK(FUNC(multiview_extrinsic)(ctx, rw, &current->camera,
+                                        current->prec_rotation_param,
+                                        current->prec_translation_param));
+    }
+
+    return 0;
+}
+
+SEI_FUNC(sei_multiview_view_position, (CodedBitstreamContext *ctx, RWContext *rw,
+                                       H265RawSEIMultiviewViewPosition *current,
+                                       SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Multiview View Position");
+
+    ue(num_views_minus1, 0, 62);
+    for (int i = 0; i <= current->num_views_minus1; i++)
+        ues(view_position[i], 0, 62, 1, i);
+
+    return 0;
+}
+
+SEI_FUNC(sei_alternative_depth_info, (CodedBitstreamContext *ctx, RWContext *rw,
+                                      H265RawSEIAlternativeDepthInfo *current,
+                                      SEIMessageState *sei))
+{
+    int err;
+
+    HEADER("Alternative Depth Information");
+
+    flag(alternative_depth_info_cancel_flag);
+    if (current->alternative_depth_info_cancel_flag)
+        return 0;
+    u(2, depth_type, 0, 3);
+    if (current->depth_type == 0)
+        CHECK(FUNC(alternative_depth_gvd)(ctx, rw, &current->gvd));
+    if (current->depth_type == 1) {
+        se(min_offset_x_int, INT32_MIN + 1, INT32_MAX);
+        u(8, min_offset_x_frac, 0, 255);
+        se(max_offset_x_int, INT32_MIN + 1, INT32_MAX);
+        u(8, max_offset_x_frac, 0, 255);
+        flag(offset_y_present_flag);
+        if (current->offset_y_present_flag) {
+            se(min_offset_y_int, INT32_MIN + 1, INT32_MAX);
+            u(8, min_offset_y_frac, 0, 255);
+            se(max_offset_y_int, INT32_MIN + 1, INT32_MAX);
+            u(8, max_offset_y_frac, 0, 255);
+        }
+        flag(warp_map_size_present_flag);
+        if (current->warp_map_size_present_flag) {
+            ue(warp_map_width_minus2, 0, UINT32_MAX - 1);
+            ue(warp_map_height_minus2, 0, UINT32_MAX - 1);
+        }
+    }
+
+    return 0;
+}
