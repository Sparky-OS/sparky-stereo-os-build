+ */
+typedef struct H265RawSEIMultiviewAcquisitionInfo {
+    uint8_t intrinsic_param_flag;
+    uint8_t extrinsic_param_flag;
+    uint8_t intrinsic_params_equal_flag;
+    uint8_t prec_focal_length;
+    uint8_t prec_principal_point;
+    uint8_t prec_skew_factor;
+    uint8_t prec_rotation_param;
+    uint8_t prec_translation_param;
+    SEIRawMultiviewCamera camera;
+} H265RawSEIMultiviewAcquisitionInfo;
+
+typedef struct H265RawSEIMultiviewViewPosition {
+    uint8_t num_views_minus1;
+    uint8_t view_position[63];
+} H265RawSEIMultiviewViewPosition;
+
+typedef struct H265RawSEIAlternativeDepthInfo {
+    uint8_t  alternative_depth_info_cancel_flag;
+    uint8_t  depth_type;
+    SEIRawAlternativeDepthGVD gvd;
+    int32_t  min_offset_x_int;
+    uint8_t  min_offset_x_frac;
+    int32_t  max_offset_x_int;
+    uint8_t  max_offset_x_frac;
+    uint8_t  offset_y_present_flag;
+    int32_t  min_offset_y_int;
+    uint8_t  min_offset_y_frac;
+    int32_t  max_offset_y_int;
+    uint8_t  max_offset_y_frac;
+    uint8_t  warp_map_size_present_flag;
+    uint32_t warp_map_width_minus2;
+    uint32_t warp_map_height_minus2;
+} H265RawSEIAlternativeDepthInfo;
