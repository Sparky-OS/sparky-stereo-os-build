diff --git a/libavcodec/cbs_h265.h b/libavcodec/cbs_h265.h
index c5b437b2..dd246561 100644
--- a/libavcodec/cbs_h265.h
+++ b/libavcodec/cbs_h265.h
@@ -737,6 +737,65 @@ typedef struct H265RawSEI3DReferenceDisplaysInfo {
     uint8_t three_dimensional_reference_displays_extension_flag;
 } H265RawSEI3DReferenceDisplaysInfo;
 
+typedef struct H265RawSEIDepthRepresentationInfo {
+    uint8_t  z_near_flag;
+    uint8_t  z_far_flag;
+    uint8_t  d_min_flag;
+    uint8_t  d_max_flag;
+    uint8_t  depth_representation_type;
+    uint16_t disparity_ref_view_id;
+    SEIRawDepthRepElement z_near;
+    SEIRawDepthRepElement z_far;
+    SEIRawDepthRepElement d_min;
+    SEIRawDepthRepElement d_max;
+    uint8_t  depth_nonlinear_representation_num_minus1;
+    uint16_t depth_nonlinear_representation_model[64];
+} H265RawSEIDepthRepresentationInfo;
+
+typedef struct H265RawSEIMultiviewSceneInfo {
+    int16_t  min_disparity;
+    uint16_t max_disparity_range;
+} H265RawSEIMultiviewSceneInfo;
+
+/**
+ * Multiview acquisition information outside of a scalable nesting SEI
