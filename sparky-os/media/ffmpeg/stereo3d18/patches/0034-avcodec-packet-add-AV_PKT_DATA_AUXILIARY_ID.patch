Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: upstream, https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/01f1d48c63c39dbf020aa96d9fbf126ed5b4c532
From 01f1d48c63c39dbf020aa96d9fbf126ed5b4c532 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 04:21:14 -0300
Subject: [PATCH 34/48] avcodec/packet: add AV_PKT_DATA_AUXILIARY_ID

The stream twin of AV_FRAME_DATA_AUXILIARY_ID, for the auxiliary type an
ISOBMFF track or HEIF item signals, which then holds for every frame of
the stream.

Assisted-by: Claude Opus 5.5 via Claude Code
---
Refreshed for FFmpeg 9.1 (deb-multimedia 10:9.1-dmo1), 2026-11-26: the value stays as published in +15, before FFmpeg 9.1's AV_PKT_DATA_GAIN_MAP_PARAMS. FFmpeg 9.1 gives every packet side data type a handle (FF_PACKET_SIDE_DATA_HANDLES, read by the side_data bitstream filter and required by the packet_side_data_handle test); this patch adds the handles of its types and that test's reference in the edition's numbering.

diff --git a/libavcodec/avcodec.c b/libavcodec/avcodec.c
index 207127036afd48d5476d32db502b2b6f9a805bdf..e6e9788971349222c8e0398139f15abb07017f3a 100644
--- a/libavcodec/avcodec.c
+++ b/libavcodec/avcodec.c
@@ -75,6 +75,7 @@ const SideDataMap ff_sd_global_map[] = {
     { AV_PKT_DATA_DEPTH_SAMPLING_INFO,        AV_FRAME_DATA_DEPTH_SAMPLING_INFO },
     { AV_PKT_DATA_CONSTRAINED_DEPTH_PARAMETER_SET_ID, AV_FRAME_DATA_CONSTRAINED_DEPTH_PARAMETER_SET_ID },
     { AV_PKT_DATA_ALTERNATIVE_DEPTH_INFO,     AV_FRAME_DATA_ALTERNATIVE_DEPTH_INFO },
+    { AV_PKT_DATA_AUXILIARY_ID,               AV_FRAME_DATA_AUXILIARY_ID },
     { AV_PKT_DATA_NB },
 };
 
diff --git a/libavcodec/packet.c b/libavcodec/packet.c
index 89f27190fb3fabfe191015abed8394128f5fc06d..198d73d4ec6732820db812662ee8a09b20d665d6 100644
--- a/libavcodec/packet.c
+++ b/libavcodec/packet.c
@@ -321,6 +321,7 @@ const char *av_packet_side_data_name(enum AVPacketSideDataType type)
     case AV_PKT_DATA_DEPTH_SAMPLING_INFO:        return "Depth Sampling Information";
     case AV_PKT_DATA_CONSTRAINED_DEPTH_PARAMETER_SET_ID: return "Constrained Depth Parameter Set Identifier";
     case AV_PKT_DATA_ALTERNATIVE_DEPTH_INFO:     return "Alternative Depth Information";
+    case AV_PKT_DATA_AUXILIARY_ID:               return "Auxiliary Picture Type (AuxId)";
     }
     return NULL;
 }
diff --git a/libavcodec/packet.h b/libavcodec/packet.h
index d0ce975c92d3ab345b6befc0f90be4aa02985821..42bbdbdc512f13b9ed7bbf4238f34a66bc0ef6f1 100644
--- a/libavcodec/packet.h
+++ b/libavcodec/packet.h
@@ -431,6 +431,13 @@ enum AVPacketSideDataType {
      */
     AV_PKT_DATA_ALTERNATIVE_DEPTH_INFO,
 
+    /**
+     * The stream is an auxiliary picture stream: the data is an int, its AuxId
+     * (ITU-T H.265 Table F.2), 1 for alpha, 2 for depth, as the auxiliary type
+     * of an ISOBMFF track or HEIF item signals it.
+     */
+    AV_PKT_DATA_AUXILIARY_ID,
+
     /**
      * Parameters describing how to combine this gain map with its base image
      * to form an alternate rendition. The payload is the AVGainMapParams
diff --git a/libavcodec/packet_internal.h b/libavcodec/packet_internal.h
index f088e91c5c21406b38aa55a36c62bc5981f6f35a..c0975c9e33e0271fa5af5f388466023863cbcb04 100644
--- a/libavcodec/packet_internal.h
+++ b/libavcodec/packet_internal.h
@@ -88,6 +88,7 @@ int ff_side_data_set_prft(AVPacket *pkt, int64_t timestamp);
     HANDLE(DEPTH_SAMPLING_INFO,         "depth_sampling_info")               \
     HANDLE(CONSTRAINED_DEPTH_PARAMETER_SET_ID, "constrained_depth_parameter_set_id") \
     HANDLE(ALTERNATIVE_DEPTH_INFO,      "alternative_depth_info")            \
+    HANDLE(AUXILIARY_ID,                "auxiliary_id")                      \
     HANDLE(GAIN_MAP_PARAMS,             "gain_map_params")
 
 #endif // AVCODEC_PACKET_INTERNAL_H
diff --git a/libavutil/side_data.c b/libavutil/side_data.c
index 92ac69ce4ac5272a0ca5af5b103854ca1ebd992c..89dcac19e119e11cd0be5d290a1adb870ea28f20 100644
--- a/libavutil/side_data.c
+++ b/libavutil/side_data.c
@@ -72,7 +72,7 @@ static const AVSideDataDescriptor sd_props[] = {
     [AV_FRAME_DATA_DEPTH_SAMPLING_INFO]         = { "Depth sampling information",                   AV_SIDE_DATA_PROP_GLOBAL },
     [AV_FRAME_DATA_CONSTRAINED_DEPTH_PARAMETER_SET_ID] = { "Constrained depth parameter set identifier", AV_SIDE_DATA_PROP_GLOBAL },
     [AV_FRAME_DATA_ALTERNATIVE_DEPTH_INFO]      = { "Alternative depth information",                AV_SIDE_DATA_PROP_GLOBAL },
-    [AV_FRAME_DATA_AUXILIARY_ID]                = { "Auxiliary picture type (AuxId)" },
+    [AV_FRAME_DATA_AUXILIARY_ID]                = { "Auxiliary picture type (AuxId)",               AV_SIDE_DATA_PROP_GLOBAL },
 };
 
 const AVSideDataDescriptor *av_frame_side_data_desc(enum AVFrameSideDataType type)
diff --git a/tests/ref/fate/packet-side-data-handle b/tests/ref/fate/packet-side-data-handle
index 33cb2034d46b4c34234d9ad8fddb49428a8ff569..1c8c5bd586558cd7bdb44163bc0feeecf0b2b195 100644
--- a/tests/ref/fate/packet-side-data-handle
+++ b/tests/ref/fate/packet-side-data-handle
@@ -49,4 +49,5 @@
 48: depth_sampling_info
 49: constrained_depth_parameter_set_id
 50: alternative_depth_info
-51: gain_map_params
+51: auxiliary_id
+52: gain_map_params
