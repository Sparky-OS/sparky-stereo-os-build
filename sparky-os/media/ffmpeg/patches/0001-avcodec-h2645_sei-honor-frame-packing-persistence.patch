diff --git a/libavcodec/decode.c b/libavcodec/decode.c
index ba6ff8a..3f1dfac 100644
--- a/libavcodec/decode.c
+++ b/libavcodec/decode.c
@@ -2318,6 +2318,19 @@ int ff_decode_content_light_new(const AVCodecContext *avctx, AVFrame *frame,
     return *clm ? 0 : AVERROR(ENOMEM);
 }
 
+int ff_decode_stereo3d_new(const AVCodecContext *avctx, AVFrame *frame,
+                           AVStereo3D **stereo)
+{
+    if (side_data_pref(avctx, &frame->side_data, &frame->nb_side_data,
+                       AV_FRAME_DATA_STEREO3D)) {
+        *stereo = NULL;
+        return 0;
+    }
+
+    *stereo = av_stereo3d_create_side_data(frame);
+    return *stereo ? 0 : AVERROR(ENOMEM);
+}
