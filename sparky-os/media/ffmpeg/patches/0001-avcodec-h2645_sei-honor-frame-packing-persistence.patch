+
+int ff_h2645_sei_to_frame(AVFrame *frame, H2645SEI *sei,
+                          enum AVCodecID codec_id,
+                          AVCodecContext *avctx, const H2645VUI *vui,
+                          unsigned bit_depth_luma, unsigned bit_depth_chroma,
+                          int seed)
+{
+    H2645SEIFramePacking *fp = &sei->frame_packing;
+    FFITUTT35Meta *itut_t35 = &sei->itut_t35;
+    int ret;
+
+    /* H.264 and VVC export the arrangement where the pictures are output,
+     * as its lifetime follows the output order. */
+    if (codec_id == AV_CODEC_ID_HEVC) {
+        ret = ff_h2645_sei_frame_packing_to_frame(avctx, frame, fp, codec_id);
+        if (ret < 0)
+            return ret;
+
+        /* The arrangement outlives the message that carried it: a later
+         * message (or the cancel flag) supersedes the persistence flag.
+         * Mirror the film grain persistence handling below. */
+        if (fp->present)
+            fp->present = fp->arrangement_persistence_flag;
+    }
+
     if (sei->display_orientation.present &&
         (sei->display_orientation.anticlockwise_rotation ||
          sei->display_orientation.hflip ||
