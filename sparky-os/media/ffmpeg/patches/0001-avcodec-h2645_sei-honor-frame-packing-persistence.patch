diff --git a/libavcodec/h264_picture.c b/libavcodec/h264_picture.c
index aa3d262..87740a3 100644
--- a/libavcodec/h264_picture.c
+++ b/libavcodec/h264_picture.c
@@ -103,6 +103,28 @@ static void h264_copy_picture_params(H264Picture *dst, const H264Picture *src)
     dst->mb_height     = src->mb_height;
     dst->mb_stride     = src->mb_stride;
     dst->needs_fg      = src->needs_fg;
+    dst->frame_packing = src->frame_packing;
+}
+
+void ff_h264_update_output_frame_packing(H264Context *h, H264Picture *out)
+{
+    H2645SEIFramePacking *fp = &h->output_frame_packing;
+
+    /* An arrangement lasts until the next message or the end of the coded
+     * video sequence (H.264 D.2.26), both in output order. */
+    if (out->f->flags & AV_FRAME_FLAG_KEY)
+        fp->present = 0;
+    if (out->frame_packing.message_present)
+        *fp = out->frame_packing;
+
+    out->frame_packing = *fp;
+
+    if (fp->present) {
+        if (fp->arrangement_type == SEI_FPA_TYPE_INTERLEAVE_TEMPORAL)
+            fp->current_frame_is_frame0_flag = !fp->current_frame_is_frame0_flag;
+        if (!fp->arrangement_repetition_period)
+            fp->present = 0;
+    }
 }
 
 int ff_h264_ref_picture(H264Picture *dst, const H264Picture *src)
