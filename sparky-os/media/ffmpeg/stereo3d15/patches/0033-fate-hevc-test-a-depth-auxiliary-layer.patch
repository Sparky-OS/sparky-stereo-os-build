Date: Sat, 17 Oct 2026 04:19:06 -0300
Subject: [PATCH 33/48] fate/hevc: test a depth auxiliary layer

A 64x64 texture layer with a depth layer (AuxId 2), encoded by x265's
alpha path with the auxiliary type set to depth, and a depth
representation information message for the depth layer in the first
access unit: the texture pictures, the depth pictures as gray frames,
and both with their side data, the depth representation information on
the depth pictures until the IDR access unit of the second coded video
sequence. The depth pictures decode to the alpha planes of the same
coded pictures with AuxId 1.

The sample, hevc/depth-layer.hevc, needs to be uploaded to the FATE
suite.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 tests/fate/hevc.mak                     |  9 +++++++++
 tests/ref/fate/hevc-depth-layer         | 13 +++++++++++++
 tests/ref/fate/hevc-depth-layer-both    | 16 ++++++++++++++++
 tests/ref/fate/hevc-depth-layer-texture | 13 +++++++++++++
 4 files changed, 51 insertions(+)
 create mode 100644 tests/ref/fate/hevc-depth-layer
 create mode 100644 tests/ref/fate/hevc-depth-layer-both
 create mode 100644 tests/ref/fate/hevc-depth-layer-texture

diff --git a/tests/fate/hevc.mak b/tests/fate/hevc.mak
index 9d8821b1..7190fb67 100644
--- a/tests/fate/hevc.mak
+++ b/tests/fate/hevc.mak
@@ -279,6 +279,15 @@ FATE_HEVC_FFPROBE-$(call PARSERDEMDEC, HEVC, HEVC, HEVC, EXTRACT_EXTRADATA_BSF)
 fate-hevc-depth-sei: CMD = threads=4 probeframes -show_entries frame=key_frame,side_data_list:frame_tags= -of compact $(TARGET_SAMPLES)/hevc/depth-sei.hevc
 FATE_HEVC_FFPROBE-$(call PARSERDEMDEC, HEVC, HEVC, HEVC) += fate-hevc-depth-sei
 
+# a texture layer with a depth auxiliary layer (AuxId 2): the texture, the
+# depth pictures as gray frames, and both with their side data, the depth
+# representation information on the depth pictures until the second IDR
+fate-hevc-depth-layer-texture: CMD = framecrc -i $(TARGET_SAMPLES)/hevc/depth-layer.hevc
+fate-hevc-depth-layer: CMD = framecrc -depth_output depth -i $(TARGET_SAMPLES)/hevc/depth-layer.hevc
+FATE_HEVC-$(call FRAMECRC, HEVC, HEVC) += fate-hevc-depth-layer-texture fate-hevc-depth-layer
+fate-hevc-depth-layer-both: CMD = probeframes -depth_output both -show_entries frame=key_frame,pix_fmt,width,height,side_data_list:frame_tags= -of compact $(TARGET_SAMPLES)/hevc/depth-layer.hevc
+FATE_HEVC_FFPROBE-$(call PARSERDEMDEC, HEVC, HEVC, HEVC) += fate-hevc-depth-layer-both
+
 fate-hevc-frame-packing-persistence: CMD = threads=4 probeframes -show_entries frame=side_data_list:frame_tags= -of compact $(TARGET_SAMPLES)/hevc/frame-packing-persistence.hevc
 FATE_HEVC_FFPROBE-$(call PARSERDEMDEC, HEVC, HEVC, HEVC) += fate-hevc-frame-packing-persistence
 
