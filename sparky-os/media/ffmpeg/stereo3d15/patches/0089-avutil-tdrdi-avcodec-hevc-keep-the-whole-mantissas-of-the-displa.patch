--- a/libavutil/tdrdi.h
+++ b/libavutil/tdrdi.h
@@ -127,7 +127,8 @@ typedef struct AV3DReferenceDisplay {
     uint8_t exponent_ref_display_width;
 
     /**
-     * The mantissa part of the reference display width of the n-th reference display.
+     * The low 8 bits of the mantissa part of the reference display width of the n-th
+     * reference display, see whole_mantissa_ref_display_width.
      */
     uint8_t mantissa_ref_display_width;
 
@@ -137,7 +138,8 @@ typedef struct AV3DReferenceDisplay {
     uint8_t exponent_ref_viewing_distance;
 
     /**
-     * The mantissa part of the reference viewing distance of the n-th reference display.
+     * The low 8 bits of the mantissa part of the reference viewing distance of the n-th
+     * reference display, see whole_mantissa_ref_viewing_distance.
      */
     uint8_t mantissa_ref_viewing_distance;
 
@@ -166,6 +168,15 @@ typedef struct AV3DReferenceDisplay {
      * acquisition information (H.264 only, when ref_baseline_present is set).
      */
     AVMultiviewReal ref_baseline;
+    /**
+     * The whole mantissa parts of the reference display width and of the
+     * reference viewing distance of the n-th reference display. They are
+     * Max(0, exponent + prec - 31) bits long, up to 62 bits (H.265 G.14.3.3),
