diff --git a/libavcodec/amfenc.c b/libavcodec/amfenc.c
index 3ffca750d80..66ad4d7882b 100644
--- a/libavcodec/amfenc.c
+++ b/libavcodec/amfenc.c
@@ -34,6 +34,7 @@
 #include "libavutil/time.h"
 
 #include "amfenc.h"
+#include "libavutil/stereo3d.h"
 #include "encode.h"
 
 #define AMF_AV_FRAME_REF    L"av_frame_ref"
@@ -279,12 +280,39 @@ static int amf_copy_buffer(AVCodecContext *avctx, AVPacket *pkt, AMFBuffer *buff
 }
 
 // amfenc API implementation
+static int amf_check_frame_packing(AVCodecContext *avctx, const AVFrame *frame)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    const AVFrameSideData *sd;
+    const AVStereo3D *stereo;
+
+    if (!ctx->frame_packing)
+        return 0;
+    sd = frame ? av_frame_get_side_data(frame, AV_FRAME_DATA_STEREO3D) : NULL;
+    if (!sd)
+        sd = av_frame_side_data_get(avctx->decoded_side_data,
+                                   avctx->nb_decoded_side_data, AV_FRAME_DATA_STEREO3D);
+    if (!sd)
+        return 0;
+    stereo = (const AVStereo3D *)sd->data;
+    if (avctx->codec_id == AV_CODEC_ID_HEVC && stereo->type == AV_STEREO3D_2D)
+        return 0;
+    av_log(avctx, AV_LOG_ERROR, "Cannot signal %s frame packing: AMF exposes no "
+           "general SEI payload path; use another encoder or -frame_packing 0 "
+           "to disable the mark.\n", av_stereo3d_type_name(stereo->type));
+    return AVERROR(ENOSYS);
+}
+
 int ff_amf_encode_init(AVCodecContext *avctx)
 {
     int ret;
     AMFEncoderContext *ctx = avctx->priv_data;
     AVHWDeviceContext   *hwdev_ctx = NULL;
 
+    ret = amf_check_frame_packing(avctx, NULL);
+    if (ret < 0)
+        return ret;
+
     // hardcoded to current HW queue size - will auto-realloc if too small
     ctx->timestamp_list = av_fifo_alloc2(avctx->max_b_frames + 16, sizeof(int64_t),
                                          AV_FIFO_FLAG_AUTO_GROW);
@@ -602,6 +630,13 @@ int ff_amf_receive_packet(AVCodecContext *avctx, AVPacket *avpkt)
     }
 
     ret = ff_encode_get_frame(avctx, frame);
+    if (ret >= 0) {
+        ret = amf_check_frame_packing(avctx, frame);
+        if (ret < 0) {
+            av_frame_free(&frame);
+            return ret;
+        }
+    }
     if(ret < 0){
         if(ret != AVERROR_EOF){
             av_frame_free(&frame);
