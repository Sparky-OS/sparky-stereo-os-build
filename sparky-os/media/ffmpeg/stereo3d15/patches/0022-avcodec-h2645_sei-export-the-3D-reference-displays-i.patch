         if (i == H2645_SEI_MULTIVIEW_SCENE_INFO)
             last = HEVC_MAX_NUH_LAYER_ID;
         else if (i == H2645_SEI_MULTIVIEW_VIEW_POSITION ||
-                 i == H2645_SEI_ALTERNATIVE_DEPTH_INFO) {
+                 i == H2645_SEI_ALTERNATIVE_DEPTH_INFO ||
+                 i == H2645_SEI_3D_REFERENCE_DISPLAYS) {
