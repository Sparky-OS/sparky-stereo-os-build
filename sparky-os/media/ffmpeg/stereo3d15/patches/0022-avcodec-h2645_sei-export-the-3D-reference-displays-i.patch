+/* 3D reference displays information: H.264 H.13.2.4 (payloadType 51), with
+ * a reference baseline per display, and H.265 G.14.3.3 (payloadType 176),
+ * with a pair of views per display */
+static int decode_3d_reference_displays_info(H2645SEIMultiview *m, GetBitContext *gb,
+                                             enum AVCodecID codec_id)
+{
+    AV3DReferenceDisplaysInfo *tdrdi;
+    uint8_t prec_baseline = 0, prec_width, prec_dist = 0;
+    unsigned num_minus1;
+    int dist_flag;
+    size_t size;
+
+    if (codec_id == AV_CODEC_ID_H264 && read_prec(gb, &prec_baseline) < 0)
+        return AVERROR_INVALIDDATA;
+    if (read_prec(gb, &prec_width) < 0)
+        return AVERROR_INVALIDDATA;
+    dist_flag = get_bits1(gb);
+    if (dist_flag && read_prec(gb, &prec_dist) < 0)
+        return AVERROR_INVALIDDATA;
+    num_minus1 = get_ue_golomb_long(gb);
+    if (num_minus1 > 31)
+        return AVERROR_INVALIDDATA;
+
+    tdrdi = av_tdrdi_alloc(num_minus1 + 1, &size);
+    if (!tdrdi)
+        return AVERROR(ENOMEM);
+    tdrdi->prec_ref_display_width    = prec_width;
+    tdrdi->ref_viewing_distance_flag = dist_flag;
+    tdrdi->prec_ref_viewing_dist     = prec_dist;
+    tdrdi->ref_baseline_present      = codec_id == AV_CODEC_ID_H264;
+    tdrdi->prec_ref_baseline         = prec_baseline;
+
+    for (unsigned i = 0; i <= num_minus1; i++) {
+        AV3DReferenceDisplay *d = av_tdrdi_get_display(tdrdi, i);
+
+        if (codec_id == AV_CODEC_ID_HEVC) {
+            unsigned left = get_ue_golomb_long(gb), right = get_ue_golomb_long(gb);
+            if (left > 1023 || right > 1023)
+                goto invalid;
+            d->left_view_id  = left;
+            d->right_view_id = right;
+        } else {
+            read_camera_real(gb, &d->ref_baseline, prec_baseline);
+        }
+        read_camera_real(gb, &d->ref_display_width, prec_width);
+        d->exponent_ref_display_width = d->ref_display_width.exponent;
+        d->mantissa_ref_display_width = d->ref_display_width.mantissa;
+        if (dist_flag) {
+            read_camera_real(gb, &d->ref_viewing_distance, prec_dist);
+            d->exponent_ref_viewing_distance = d->ref_viewing_distance.exponent;
+            d->mantissa_ref_viewing_distance = d->ref_viewing_distance.mantissa;
+        }
+        d->additional_shift_present_flag = get_bits1(gb);
+        if (d->additional_shift_present_flag)
+            d->num_sample_shift = (int)get_bits(gb, 10) - 512;
+        if (get_bits_left(gb) < 0)
+            goto invalid;
+    }
+    /* three_dimensional_reference_displays_extension_flag: what follows a 1
+     * is ignored */
+
+    return wrap(m, H2645_SEI_3D_REFERENCE_DISPLAYS, tdrdi, size);
+invalid:
+    av_free(tdrdi);
+    return AVERROR_INVALIDDATA;
+}
+
 int ff_h2645_sei_multiview_decode(H2645SEIMultiview *m, enum SEIType type,
                                   enum AVCodecID codec_id, GetBitContext *gb,
                                   void *logctx)
@@ -597,6 +666,8 @@ int ff_h2645_sei_multiview_decode(H2645SEIMultiview *m, enum SEIType type,
             return decode_multiview_view_position(m, gb, codec_id);
         case SEI_TYPE_DEPTH_REPRESENTATION_INFO_4:
             return decode_depth_representation_info(m, gb, codec_id, logctx);
+        case SEI_TYPE_THREE_DIMENSIONAL_REFERENCE_DISPLAYS_INFO_4:
+            return decode_3d_reference_displays_info(m, gb, codec_id);
         case SEI_TYPE_DEPTH_TIMING:
             return decode_depth_timing(m, gb);
         case SEI_TYPE_DEPTH_SAMPLING_INFO:
@@ -608,6 +679,8 @@ int ff_h2645_sei_multiview_decode(H2645SEIMultiview *m, enum SEIType type,
         }
     } else if (codec_id == AV_CODEC_ID_HEVC) {
         switch (type) {
+        case SEI_TYPE_THREE_DIMENSIONAL_REFERENCE_DISPLAYS_INFO:
+            return decode_3d_reference_displays_info(m, gb, codec_id);
         case SEI_TYPE_DEPTH_REPRESENTATION_INFO_5:
             return decode_depth_representation_info(m, gb, codec_id, logctx);
         case SEI_TYPE_MULTIVIEW_SCENE_INFO_5:
@@ -631,8 +704,16 @@ void ff_h2645_sei_multiview_reset(H2645SEIMultiview *m)
 }
 
 int ff_h2645_sei_multiview_update(AVBufferRef *state[H2645_SEI_MULTIVIEW_NB],
-                                  H2645SEIMultiview *m, int new_sequence)
+                                  H2645SEIMultiview *m, enum AVCodecID codec_id,
+                                  int new_sequence, int irap)
 {
+    /* the 3D reference displays information ends at the next IRAP access
+     * unit (H.265 G.14.3.3), or IDR access unit or access unit with
+     * multiview acquisition information (H.264 H.13.2.4) */
+    if (!m->info[H2645_SEI_3D_REFERENCE_DISPLAYS] &&
+        (irap || (codec_id == AV_CODEC_ID_H264 && m->info[H2645_SEI_MULTIVIEW_ACQUISITION_INFO])))
+        av_buffer_unref(&state[H2645_SEI_3D_REFERENCE_DISPLAYS]);
+
     for (int i = 0; i < H2645_SEI_MULTIVIEW_NB; i++) {
         if (m->info[i]) {
             av_buffer_unref(&state[i]);
