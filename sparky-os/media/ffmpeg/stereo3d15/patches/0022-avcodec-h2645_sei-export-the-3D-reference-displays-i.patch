     ret = ff_h2645_sei_multiview_update(s->multiview[s->nuh_layer_id],
-                                        &s->multiview_pending[s->nuh_layer_id],
-                                        IS_IRAP(s) && s->no_rasl_output_flag);
+                                        &s->multiview_pending[s->nuh_layer_id], AV_CODEC_ID_HEVC,
+                                        IS_IRAP(s) && s->no_rasl_output_flag, IS_IRAP(s));
     if (ret < 0)
         return ret;
     ret = ff_h2645_sei_multiview_to_frame(s->avctx, out, s->multiview[s->nuh_layer_id]);
