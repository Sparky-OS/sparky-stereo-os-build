@@ -1276,6 +1276,7 @@ static int h264_export_frame_props(H264Context *h)
      * in decoding order, until the next message of its type or the end of
      * the coded video sequence (H.264 G.13.2, H.13.2 and I.13.2). */
     ret = ff_h2645_sei_multiview_update(h->multiview, &h->sei.common.multiview,
+                                        AV_CODEC_ID_H264, !!(out->flags & AV_FRAME_FLAG_KEY),
                                         !!(out->flags & AV_FRAME_FLAG_KEY));
     if (ret < 0)
         return ret;
@@ -2173,6 +2174,7 @@ int ff_h264_queue_decode_slice(H264Context *h, const H2645NAL *nal)
             /* a skipped picture still starts the information it carries */
             if (!sl->first_mb_addr)
                 ff_h2645_sei_multiview_update(h->multiview, &h->sei.common.multiview,
