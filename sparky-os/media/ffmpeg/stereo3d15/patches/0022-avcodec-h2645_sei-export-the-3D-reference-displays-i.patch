 };
 
@@ -221,10 +222,18 @@ void ff_h2645_sei_multiview_reset(H2645SEIMultiview *m);
 /**
  * Apply the decoded messages to the information a picture carries: each
  * replaces the one of its type, and at the start of a coded video sequence
- * the information of the types not received ends.
+ * the information of the types not received ends. The 3D reference displays
+ * information also ends at an IRAP access unit (H.265 G.14.3.3) or, in
+ * H.264, with new multiview acquisition information (H.13.2.4).
+ *
+ * @param new_sequence whether the picture starts a coded (layer-wise) video
+ *                     sequence
+ * @param irap         whether the picture is an IRAP (H.265) or IDR (H.264)
+ *                     picture
  */
 int ff_h2645_sei_multiview_update(AVBufferRef *state[H2645_SEI_MULTIVIEW_NB],
-                                  H2645SEIMultiview *m, int new_sequence);
+                                  H2645SEIMultiview *m, enum AVCodecID codec_id,
+                                  int new_sequence, int irap);
 
 /**
  * Attach the information a picture carries to its frame.
