Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: upstream, https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/3f368bd5ee1b3d2023bf90ddb1c0d4161a778084
From 3f368bd5ee1b3d2023bf90ddb1c0d4161a778084 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 04:32:16 -0300
Subject: [PATCH 36/48] avformat/movenc: write depth auxiliary images and
 tracks

A stream marked with AV_PKT_DATA_AUXILIARY_ID 2 is a depth image: write
urn:mpeg:mpegB:cicp:systems:auxiliary:depth as its auxiliary type in
AVIF (auxC, auxi) where alpha was always written, and in MP4 write it as
an auxiliary video track: an auxv handler, an AuxiliaryTypeInfoBox (auxi)
in its sample entry and an auxl reference to the first video track that
is not auxiliary.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 libavformat/movenc.c | 52 ++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 48 insertions(+), 4 deletions(-)

diff --git a/libavformat/movenc.c b/libavformat/movenc.c
index 6f93eb3e..7f3b7c2b 100644
--- a/libavformat/movenc.c
+++ b/libavformat/movenc.c
@@ -2783,13 +2783,27 @@ static int mov_write_ccst_tag(AVIOContext *pb)
     return update_size(pb, pos);
 }
 
-static int mov_write_aux_tag(AVIOContext *pb, const char *aux_type)
+/* The AuxId of a stream (ITU-T H.265 Table F.2), 0 when it is not auxiliary. */
+static int mov_stream_aux_id(const AVStream *st)
+{
+    const AVPacketSideData *sd = st ? av_packet_side_data_get(st->codecpar->coded_side_data,
+                                                              st->codecpar->nb_coded_side_data,
+                                                              AV_PKT_DATA_AUXILIARY_ID) : NULL;
+
+    return sd && sd->size >= sizeof(int) ? *(const int *)sd->data : 0;
+}
+
+/* auxC (HEIF items) or auxi (tracks): alpha, unless the stream is depth */
+static int mov_write_aux_tag(AVIOContext *pb, const char *aux_type, int aux_id)
 {
     int64_t pos = avio_tell(pb);
     avio_wb32(pb, 0); /* size */
     ffio_wfourcc(pb, aux_type);
     avio_wb32(pb, 0); /* Version & flags */
-    avio_write(pb, "urn:mpeg:mpegB:cicp:systems:auxiliary:alpha\0", 44);
+    if (aux_id == 2)
+        avio_write(pb, "urn:mpeg:mpegB:cicp:systems:auxiliary:depth\0", 44);
+    else
+        avio_write(pb, "urn:mpeg:mpegB:cicp:systems:auxiliary:alpha\0", 44);
     return update_size(pb, pos);
 }
 
@@ -3056,7 +3070,10 @@ static int mov_write_video_tag(AVFormatContext *s, AVIOContext *pb, MOVMuxContex
     if (track->mode == MODE_AVIF) {
         mov_write_ccst_tag(pb);
         if (mov->nb_streams > 0 && track == &mov->tracks[1])
-            mov_write_aux_tag(pb, "auxi");
+            mov_write_aux_tag(pb, "auxi", mov_stream_aux_id(track->st));
+    } else if (track->mode == MODE_MP4 && mov_stream_aux_id(track->st)) {
+        /* an auxiliary video track: AuxiliaryTypeInfoBox in the sample entry */
+        mov_write_aux_tag(pb, "auxi", mov_stream_aux_id(track->st));
     }
 
     return update_size(pb, pos);
@@ -3579,6 +3596,9 @@ static int mov_write_hdlr_tag(AVFormatContext *s, AVIOContext *pb, MOVTrack *tra
             if (track->mode == MODE_AVIF) {
                 hdlr_type = (track == &mov->tracks[0]) ? "pict" : "auxv";
                 descr     = "PictureHandler";
+            } else if (track->mode == MODE_MP4 && mov_stream_aux_id(track->st)) {
+                hdlr_type = "auxv";
+                descr     = "AuxiliaryVideoHandler";
             } else {
                 hdlr_type = "vide";
                 descr     = "VideoHandler";
@@ -3764,7 +3784,7 @@ static int mov_write_ipco_tag(AVIOContext *pb, MOVMuxContext *mov, AVFormatConte
         if (!i)
             mov_write_colr_tag(pb, &mov->tracks[0], 0);
         else
-            mov_write_aux_tag(pb, "auxC");
+            mov_write_aux_tag(pb, "auxC", mov_stream_aux_id(s->streams[i]));
     }
     return update_size(pb, pos);
 }
@@ -5366,6 +5386,30 @@ static int mov_write_moov_tag(AVIOContext *pb, MOVMuxContext *mov,
             if (ret < 0)
                 return ret;
         }
+    for (i = 0; i < mov->nb_tracks; i++) {
+        MOVTrack *track = &mov->tracks[i];
+
+        /* an auxiliary video track refers to the video it belongs to */
+        if (track->mode == MODE_MP4 && track->par->codec_type == AVMEDIA_TYPE_VIDEO &&
+            mov_stream_aux_id(track->st)) {
+            for (int j = 0; j < mov->nb_streams; j++) {
+                MOVTrack *main = &mov->tracks[j];
+                MovTag *tag;
+                int ret;
+
+                if (main == track || main->par->codec_type != AVMEDIA_TYPE_VIDEO ||
+                    mov_stream_aux_id(main->st))
+                    continue;
+                tag = mov_add_tref_tag(mov, track, MKTAG('a','u','x','l'));
+                if (!tag)
+                    return AVERROR(ENOMEM);
+                ret = mov_add_tref_id(mov, tag, main->track_id);
+                if (ret < 0)
+                    return ret;
+                break;
+            }
+        }
+    }
     for (i = 0; i < mov->nb_tracks; i++) {
         MOVTrack *track = &mov->tracks[i];
         if (track->tag == MKTAG('r','t','p',' ')) {
-- 
