Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: upstream, https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/4e89180868b5259c0002fab87539e19b3a4f296d
From 4e89180868b5259c0002fab87539e19b3a4f296d Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 04:19:06 -0300
Subject: [PATCH 31/48] avcodec/hevc: decode and output depth auxiliary layers

A stream with a depth auxiliary layer (AuxId 2, Table F.2) carries the
depth of its pictures, as with MPEG-C Part 3 or a 2D-plus-depth 3D
display, in the luma samples of the second layer. Add the depth_output
option: the texture pictures (the default, as before), the depth
pictures, output as gray frames of the luma plane, or both, the depth
pictures marked with AV_FRAME_DATA_AUXILIARY_ID; the depth
representation information applies to the depth pictures. The depth
layer may be monochrome or of another range than the texture, and needs
its size and bit depth.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 libavcodec/hevc/hevcdec.c | 64 +++++++++++++++++++++++++++++++++++++--
 libavcodec/hevc/hevcdec.h | 12 ++++++++
 libavcodec/hevc/refs.c    | 11 +++++++
 3 files changed, 85 insertions(+), 2 deletions(-)

diff --git a/libavcodec/hevc/hevcdec.c b/libavcodec/hevc/hevcdec.c
index 9f0cfb53..cb3b7062 100644
--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -446,9 +446,10 @@ int ff_hevc_is_alpha_video(const HEVCContext *s)
         return 0;
 
     /* decode_vps_ext() guarantees that SCALABILITY_AUXILIARY with AuxId other
-     * than alpha cannot reach here.
+     * than alpha or depth cannot reach here.
      */
-    ret = (s->vps->scalability_mask_flag & HEVC_SCALABILITY_AUXILIARY);
+    ret = (s->vps->scalability_mask_flag & HEVC_SCALABILITY_AUXILIARY) &&
+          vps->aux_id[1] == HEVC_AUX_ALPHA;
 
     av_log(s->avctx, AV_LOG_DEBUG, "Multi layer video, %s alpha video\n",
            ret ? "is" : "not");
@@ -456,6 +457,43 @@ int ff_hevc_is_alpha_video(const HEVCContext *s)
     return ret;
 }
 
+int ff_hevc_is_depth_video(const HEVCContext *s)
+{
+    const HEVCVPS *vps = s->vps;
+
+    return vps && vps->nb_layers == 2 && vps->layer_id_in_nuh[1] &&
+           (vps->scalability_mask_flag & HEVC_SCALABILITY_AUXILIARY) &&
+           vps->aux_id[1] == HEVC_AUX_DEPTH;
+}
+
+/* Output the luma plane of a depth picture as a gray frame. */
+static void depth_to_gray(AVFrame *frame)
+{
+    const AVFrameSideData *sd = av_frame_get_side_data(frame, AV_FRAME_DATA_AUXILIARY_ID);
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(frame->format);
+    enum AVPixelFormat gray;
+
+    if (!sd || *(const int *)sd->data != HEVC_AUX_DEPTH ||
+        !desc || (desc->flags & AV_PIX_FMT_FLAG_HWACCEL))
+        return;
+
+    switch (desc->comp[0].depth) {
+    case 8:  gray = AV_PIX_FMT_GRAY8;  break;
+    case 9:  gray = AV_PIX_FMT_GRAY9;  break;
+    case 10: gray = AV_PIX_FMT_GRAY10; break;
+    case 12: gray = AV_PIX_FMT_GRAY12; break;
+    case 14: gray = AV_PIX_FMT_GRAY14; break;
+    case 16: gray = AV_PIX_FMT_GRAY16; break;
+    default: return;
+    }
+
+    frame->format = gray;
+    for (int i = 1; i < FF_ARRAY_ELEMS(frame->data); i++) {
+        frame->data[i]     = NULL;
+        frame->linesize[i] = 0;
+    }
+}
+
 static int setup_multilayer(HEVCContext *s, const HEVCVPS *vps)
 {
     unsigned layers_active_output = 0, highest_layer;
@@ -463,6 +501,16 @@ static int setup_multilayer(HEVCContext *s, const HEVCVPS *vps)
     s->layers_active_output = 1;
     s->layers_active_decode = 1;
 
+    /* The depth layer of a texture and depth stream is decoded and output
+     * on request. */
+    if (ff_hevc_is_depth_video(s)) {
+        if (s->depth_output) {
+            s->layers_active_decode = 3;
+            s->layers_active_output = s->depth_output == 1 ? 2 : 3;
+        }
+        return 0;
+    }
+
     if (ff_hevc_is_alpha_video(s)) {
         const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(s->avctx->pix_fmt);
 
@@ -3301,6 +3349,12 @@ static int hevc_frame_start(HEVCContext *s, HEVCLayerContext *l,
                 pix_fmt == AV_PIX_FMT_YUVJ420P)
                 pix_fmt = sps_base->pix_fmt;
 
+            // A depth layer holds its samples in luma: it may be monochrome,
+            // or of another range, and is output as a gray frame
+            if (ff_hevc_is_depth_video(s) && sps->bit_depth == sps_base->bit_depth &&
+                (sps->chroma_format_idc == 0 || sps->chroma_format_idc == sps_base->chroma_format_idc))
+                pix_fmt = sps_base->pix_fmt;
+
             if (pix_fmt     != sps_base->pix_fmt ||
                 sps->width  != sps_base->width   ||
                 sps->height != sps_base->height) {
@@ -3951,6 +4005,7 @@ do_output:
     if (av_container_fifo_read(s->output_fifo, frame, 0) >= 0) {
         if (!(avctx->export_side_data & AV_CODEC_EXPORT_DATA_FILM_GRAIN))
             av_frame_remove_side_data(frame, AV_FRAME_DATA_FILM_GRAIN_PARAMS);
+        depth_to_gray(frame);
 
         return 0;
     }
@@ -4316,6 +4371,11 @@ static const AVOption options[] = {
         { "unspecified", .type = AV_OPT_TYPE_CONST, .default_val = { .i64 = AV_STEREO3D_VIEW_UNSPEC }, .unit = "view_pos" },
         { "left",        .type = AV_OPT_TYPE_CONST, .default_val = { .i64 = AV_STEREO3D_VIEW_LEFT },   .unit = "view_pos" },
         { "right",       .type = AV_OPT_TYPE_CONST, .default_val = { .i64 = AV_STEREO3D_VIEW_RIGHT },  .unit = "view_pos" },
+    { "depth_output", "Pictures to output from a stream with a depth auxiliary layer (AuxId 2)",
+        OFFSET(depth_output), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 2, PAR, .unit = "depth_output" },
+        { "texture", "the pictures of the base layer", 0, AV_OPT_TYPE_CONST, { .i64 = 0 }, .flags = PAR, .unit = "depth_output" },
+        { "depth",   "the depth pictures, as gray frames", 0, AV_OPT_TYPE_CONST, { .i64 = 1 }, .flags = PAR, .unit = "depth_output" },
+        { "both",    "both, the depth pictures marked with their AuxId", 0, AV_OPT_TYPE_CONST, { .i64 = 2 }, .flags = PAR, .unit = "depth_output" },
 
     { NULL },
 };
diff --git a/libavcodec/hevc/hevcdec.h b/libavcodec/hevc/hevcdec.h
index 8919111a..257e35fd 100644
--- a/libavcodec/hevc/hevcdec.h
+++ b/libavcodec/hevc/hevcdec.h
@@ -590,6 +590,12 @@ typedef struct HEVCContext {
     int         *view_ids;
     unsigned  nb_view_ids;
 
+    /**
+     * Which pictures to output when the stream has a depth auxiliary layer:
+     * those of the base layer (0), those of the depth layer (1), or both (2).
+     */
+    int depth_output;
+
     unsigned    *view_ids_available;
     unsigned  nb_view_ids_available;
 
@@ -744,6 +750,12 @@ void ff_hevc_hls_mvd_coding(HEVCLocalContext *lc, int x0, int y0, int log2_cb_si
 
 int ff_hevc_is_alpha_video(const HEVCContext *s);
 
+/**
+ * Whether the stream is a base layer with a depth auxiliary layer
+ * (AuxId 2, Table F.2).
+ */
+int ff_hevc_is_depth_video(const HEVCContext *s);
+
 extern const uint8_t ff_hevc_qpel_extra_before[4];
 extern const uint8_t ff_hevc_qpel_extra_after[4];
 extern const uint8_t ff_hevc_qpel_extra[4];
diff --git a/libavcodec/hevc/refs.c b/libavcodec/hevc/refs.c
index 74056b92..1fc3b9fc 100644
--- a/libavcodec/hevc/refs.c
+++ b/libavcodec/hevc/refs.c
@@ -157,6 +157,17 @@ static HEVCFrame *alloc_frame(HEVCContext *s, HEVCLayerContext *l)
             }
         }
 
+        // mark the pictures of a depth auxiliary layer
+        if (ff_hevc_is_depth_video(s) && vps->aux_id[s->cur_layer]) {
+            AVFrameSideData *sd = av_frame_side_data_new(&frame->f->side_data,
+                                                         &frame->f->nb_side_data,
+                                                         AV_FRAME_DATA_AUXILIARY_ID,
+                                                         sizeof(int), 0);
+            if (!sd)
+                goto fail;
+            *(int *)sd->data = vps->aux_id[s->cur_layer];
+        }
+
         ret = ff_thread_get_buffer(s->avctx, frame->f, AV_GET_BUFFER_FLAG_REF);
         if (ret < 0)
             goto fail;
-- 
