+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/stereo3d.h"
+#include "libavcodec/avcodec.h"
+#include "libavcodec/h2645_sei.h"
+
+int main(void)
+{
+    AVCodecContext *avctx = avcodec_alloc_context3(NULL);
+    AVFrame *frame = av_frame_alloc();
+    int ret = 0;
+
+    if (!avctx || !frame) {
+        ret = 1;
+        goto end;
+    }
+    for (int hevc = 0; hevc < 2; hevc++) {
+        for (int type = 0; type <= 7; type++) {
+            for (int quincunx = type == 0; quincunx <= (type < 5); quincunx++) {
+                for (int content = type == 6 ? 0 : 1; content <= (type == 6 ? 0 : 2); content++) {
+                    for (int frame0 = 0; frame0 <= (type == 5); frame0++) {
+                        H2645SEI sei = { 0 };
+                        AVFrameSideData *sd;
+                        const AVStereo3D *stereo;
+
+                        sei.frame_packing = (H2645SEIFramePacking) {
+                            .present = 1,
+                            .arrangement_type = type,
+                            .quincunx_sampling_flag = quincunx,
+                            .content_interpretation_type = content,
+                            .current_frame_is_frame0_flag = frame0,
+                        };
+                        av_frame_unref(frame);
+                        ret = ff_h2645_sei_frame_packing_to_frame(avctx, frame, &sei.frame_packing,
+                                                               hevc ? AV_CODEC_ID_HEVC : AV_CODEC_ID_H264);
+                        if (ret < 0)
+                            goto end;
+                        sd = av_frame_get_side_data(frame, AV_FRAME_DATA_STEREO3D);
+                        printf("%s type=%d q=%d content=%d frame0=%d:",
+                               hevc ? "HEVC" : "H264", type, quincunx, content, frame0);
+                        if (!sd) {
+                            printf(" none\n");
+                            continue;
+                        }
+                        stereo = (const AVStereo3D *)sd->data;
+                        printf(" %s flags=%d view=%s\n", av_stereo3d_type_name(stereo->type),
+                               stereo->flags, av_stereo3d_view_name(stereo->view));
+                    }
+                }
+            }
+        }
+    }
+end:
+    av_frame_free(&frame);
+    avcodec_free_context(&avctx);
+    return ret < 0 ? 1 : ret;
+}
