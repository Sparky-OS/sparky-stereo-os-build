diff --git a/tests/fate/filter-video.mak b/tests/fate/filter-video.mak
index 1b04816f..42cd3653 100644
--- a/tests/fate/filter-video.mak
+++ b/tests/fate/filter-video.mak
@@ -872,6 +872,42 @@ FATE_FILTER-$(call ALLYES, TESTSRC2_FILTER SPLIT_FILTER AVGBLUR_FILTER        \
 FATE_FILTER-$(call FILTERFRAMECRC, TESTSRC SCALE PREMULTIPLY, LAVFI_INDEV) += fate-filter-scale-premultiply
 fate-filter-scale-premultiply: CMD = framecrc -auto_conversion_filters -lavfi "testsrc,format=rgba,setparams=alpha_mode=premultiplied,format=rgba:alpha_modes=straight" -frames:v 10
 
+# dibr: a picture and its depth map to full side by side (libstereo-dibr). A
+# test picture with a near disc that moves over a far ramp, 2D-plus-depth: the
+# default (the picture as the left eye, forward warping, background
+# extension), then every other view, warp, fill and the smoothing
+DIBR_PICTURE = testsrc2=s=128x72:r=5:d=1,format=yuv420p
+DIBR_DEPTH = color=black:s=128x72:r=5:d=1,format=gray,geq=lum=if(lt(hypot(X-50-6*N\,Y-36)\,18)\,230\,20+X)
+FATE_DIBR-$(call FILTERFRAMECRC, TESTSRC2 COLOR GEQ FORMAT DIBR) += fate-filter-dibr fate-filter-dibr-center-backward-depth \
+    fate-filter-dibr-layered-telea fate-filter-dibr-gaussian-none
+fate-filter-dibr: CMD = framecrc -filter_complex "$(DIBR_PICTURE)[p];$(DIBR_DEPTH)[d];[p][d]dibr"
+fate-filter-dibr-center-backward-depth: CMD = framecrc -filter_complex "$(DIBR_PICTURE)[p];$(DIBR_DEPTH)[d];[p][d]dibr=view=center:warp=backward:fill=depth"
+fate-filter-dibr-layered-telea: CMD = framecrc -filter_complex "$(DIBR_PICTURE)[p];$(DIBR_DEPTH)[d];[p][d]dibr=warp=layered:fill=telea"
+fate-filter-dibr-gaussian-none: CMD = framecrc -filter_complex "$(DIBR_PICTURE)[p];$(DIBR_DEPTH)[d];[p][d]dibr=smooth=gaussian:fill=none:range=80:shift=-10"
+
+# 12-bit 4:4:4 with a 16-bit depth map at half the size, read the other way
+# round (larger samples farther)
+FATE_DIBR-$(call FILTERFRAMECRC, TESTSRC2 COLOR GEQ FORMAT DIBR) += fate-filter-dibr-12bit
+fate-filter-dibr-12bit: CMD = framecrc -filter_complex "testsrc2=s=128x72:r=5:d=1,format=yuv444p12[p];color=black:s=64x36:r=5:d=1,format=gray16,geq=lum=if(lt(hypot(X-25-3*N\,Y-18)\,9)\,4000\,60000-X*500)[d];[p][d]dibr=depth=farness" -pix_fmt yuv444p12
+
+# full side by side, marked as such
+FATE_FILTER_FFPROBE-$(call ALLYES, FFPROBE LAVFI_INDEV TESTSRC2_FILTER COLOR_FILTER FORMAT_FILTER DIBR_FILTER) += fate-filter-dibr-side-data
+fate-filter-dibr-side-data: CMD = probe -show_entries frame=width,height:frame_side_data_list -of compact -f lavfi "testsrc2=s=128x72:r=5:d=0.4[p];color=gray:s=128x72:r=5:d=0.4,format=gray[d];[p][d]dibr[out0]"
+
+# a transport stream's depth map and parallax map (ISO/IEC 23002-3), read
+# from their supplemental information, and an H.265 depth auxiliary layer
+# (AuxId 2) with its depth representation information, the picture as the
+# middle
+FATE_DIBR_SAMPLES-$(call FILTERDEMDEC, DIBR, MPEGTS, H264) += fate-filter-dibr-mpegts-depth fate-filter-dibr-mpegts-parallax
+fate-filter-dibr-mpegts-depth: CMD = framecrc -i $(TARGET_SAMPLES)/mpegts/depth-aux.ts -filter_complex "[0:v:0][0:v:1]dibr"
+fate-filter-dibr-mpegts-parallax: CMD = framecrc -i $(TARGET_SAMPLES)/mpegts/depth-aux.ts -filter_complex "[0:v:0][0:v:2]dibr"
+FATE_DIBR_SAMPLES-$(call FILTERDEMDEC, DIBR, HEVC, HEVC) += fate-filter-dibr-hevc-depth-layer
+fate-filter-dibr-hevc-depth-layer: CMD = framecrc -i $(TARGET_SAMPLES)/hevc/depth-layer.hevc -depth_output depth -i $(TARGET_SAMPLES)/hevc/depth-layer.hevc -filter_complex "[0:v][1:v]dibr=view=center"
+
+FATE_FILTER-yes += $(FATE_DIBR-yes)
+FATE_FILTER_SAMPLES-yes += $(FATE_DIBR_SAMPLES-yes)
+fate-filter-dibr-all: $(FATE_DIBR-yes) $(FATE_DIBR_SAMPLES-yes) $(filter fate-filter-dibr-%, $(FATE_FILTER_FFPROBE-yes))
+
 FATE_SAMPLES_FFPROBE += $(FATE_METADATA_FILTER-yes)
 FATE_SAMPLES_FFMPEG += $(FATE_FILTER_SAMPLES-yes)
 FATE_FFPROBE += $(FATE_FILTER_FFPROBE-yes)
