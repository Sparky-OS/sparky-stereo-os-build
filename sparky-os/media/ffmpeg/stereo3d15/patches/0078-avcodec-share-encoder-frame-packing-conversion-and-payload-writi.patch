+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_FRAME_PACKING_H
+#define AVCODEC_FRAME_PACKING_H
+
+#include "avcodec.h"
+#include "cbs_h264.h"
+#include "cbs_sei.h"
+
+typedef struct FFFramePacking {
+    int enabled;
+    int require_initial_layout;
+    int initial_layout;
+    int active;
+    int last_type;
+    int last_quincunx;
+    int last_content;
+    const char *disable_option;
+} FFFramePacking;
+
+typedef struct FFFramePackingParams {
+    int cancel;
+    int type;
+    int quincunx;
+    int content;
+    int frame0;
+} FFFramePackingParams;
+
+/* Return 1 if the sequence will carry frame packing, 0 if not, or an error. */
+int ff_frame_packing_init(AVCodecContext *avctx, FFFramePacking *state,
+                         int enabled, const char *disable_option,
+                         int require_initial_layout);
+
+/* Return 1 for a message, 0 for no message, or an error. */
+int ff_frame_packing_prepare(AVCodecContext *avctx, FFFramePacking *state,
+                            const AVFrame *frame, int keyframe,
+                            int64_t display_order, FFFramePackingParams *params);
+
+void ff_frame_packing_h264(const FFFramePackingParams *params,
+                           H264RawSEIFramePackingArrangement *sei);
+void ff_frame_packing_hevc(const FFFramePackingParams *params,
+                           SEIRawFramePackingArrangement *sei);
+
+/* Serialize the SEI payload only (no type/size header, NAL or escaping). */
+int ff_frame_packing_payload(enum AVCodecID codec, const FFFramePackingParams *p,
+                            uint8_t data[16]);
+
+#endif
diff --git a/libavcodec/tests/frame_packing.c b/libavcodec/tests/frame_packing.c
new file mode 100644
index 00000000000..115a973c27a
--- /dev/null
+++ b/libavcodec/tests/frame_packing.c
@@ -0,0 +1,107 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+
+#include "libavutil/stereo3d.h"
+#include "libavcodec/frame_packing.h"
+
+int main(void)
+{
+    AVCodecContext *ctx = avcodec_alloc_context3(NULL);
+    AVFrame *frame = av_frame_alloc();
+    FFFramePacking state;
+    FFFramePackingParams p;
+    AVStereo3D *st;
+    int ret;
+
+    if (!ctx || !frame)
+        return 1;
+    ctx->width = ctx->height = 192;
+    av_log_set_level(AV_LOG_QUIET);
+    st = av_stereo3d_create_side_data(frame);
+    if (!st)
+        return 1;
+    for (int hevc = 0; hevc < 2; hevc++) {
+        ctx->codec_id = hevc ? AV_CODEC_ID_HEVC : AV_CODEC_ID_H264;
+        for (int type = 0; type <= AV_STEREO3D_COLUMNS_QUINCUNX; type++) {
+            for (int invert = 0; invert < 2; invert++) {
+                st->type = type;
+                st->flags = invert ? AV_STEREO3D_FLAG_INVERT : 0;
+                st->view = AV_STEREO3D_VIEW_LEFT;
+                ret = ff_frame_packing_init(ctx, &state, 1, "-frame_packing 0", 0);
+                if (ret < 0)
+                    return 1;
+                ret = ff_frame_packing_prepare(ctx, &state, frame, 1, 0, &p);
+                printf("%s %s invert=%d: ", hevc ? "HEVC" : "H264",
+                       av_stereo3d_type_name(type), invert);
+                if (ret < 0) {
+                    printf("unsupported\n");
+                } else if (!ret) {
+                    printf("none\n");
+                } else {
+                    uint8_t bytes[16];
+                    int size = ff_frame_packing_payload(ctx->codec_id, &p, bytes);
+                    for (int i = 0; i < size; i++)
+                        printf("%02x", bytes[i]);
+                    printf("\n");
+                }
+            }
+        }
+        st->type = AV_STEREO3D_FRAMESEQUENCE;
+        st->flags = AV_STEREO3D_FLAG_INVERT;
+        ff_frame_packing_init(ctx, &state, 1, "-frame_packing 0", 0);
+        for (int n = 0; n < 4; n++) {
+            st->view = n & 1 ? AV_STEREO3D_VIEW_RIGHT : AV_STEREO3D_VIEW_LEFT;
+            ret = ff_frame_packing_prepare(ctx, &state, frame, !n, n, &p);
+            printf("%s temporal %d: message=%d frame0=%d content=%d\n",
+                   hevc ? "HEVC" : "H264", n, ret, p.frame0, p.content);
+        }
+    }
+    ctx->codec_id = AV_CODEC_ID_H264;
+    st->type = AV_STEREO3D_SIDEBYSIDE;
+    ff_frame_packing_init(ctx, &state, 1, "-frame_packing 0", 0);
+    printf("H264 cadence:");
+    for (int n = 0; n < 25; n++) {
+        ret = ff_frame_packing_prepare(ctx, &state, frame, n % 12 == 0, n, &p);
+        if (ret)
+            printf(" %d", n);
+    }
+    printf("\n");
+    av_frame_remove_side_data(frame, AV_FRAME_DATA_STEREO3D);
+    ret = ff_frame_packing_prepare(ctx, &state, frame, 0, 25, &p);
+    printf("H264 missing layout: message=%d cancel=%d\n", ret, p.cancel);
+    ret = ff_frame_packing_prepare(ctx, &state, frame, 0, 26, &p);
+    printf("H264 next unmarked frame: message=%d\n", ret);
+    st = av_stereo3d_create_side_data(frame);
+    st->type = AV_STEREO3D_TILED;
+    ctx->width = 190;
+    ret = ff_frame_packing_prepare(ctx, &state, frame, 1, 0, &p);
+    printf("Tiled invalid size: %s\n", ret < 0 ? "rejected" : "accepted");
+    ff_frame_packing_init(ctx, &state, 0, "-frame_packing 0", 0);
+    ret = ff_frame_packing_prepare(ctx, &state, frame, 1, 0, &p);
+    printf("Disabled tiled invalid size: message=%d\n", ret);
+    ctx->codec_id = AV_CODEC_ID_HEVC;
+    st->type = AV_STEREO3D_SIDEBYSIDE;
+    ff_frame_packing_init(ctx, &state, 1, "-frame_packing 0", 1);
+    ret = ff_frame_packing_prepare(ctx, &state, frame, 1, 0, &p);
+    printf("HEVC late layout: %s\n", ret < 0 ? "rejected" : "accepted");
+    av_frame_free(&frame);
+    avcodec_free_context(&ctx);
+    return 0;
+}
