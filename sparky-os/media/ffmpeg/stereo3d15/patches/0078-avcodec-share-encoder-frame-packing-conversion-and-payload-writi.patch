diff --git a/libavcodec/frame_packing.c b/libavcodec/frame_packing.c
new file mode 100644
index 00000000000..1a9fb629a0d
--- /dev/null
+++ b/libavcodec/frame_packing.c
@@ -0,0 +1,197 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "libavutil/stereo3d.h"
+#include "frame_packing.h"
+#include "put_bits.h"
+
+static const AVStereo3D *get_stereo(const AVCodecContext *avctx, const AVFrame *frame)
+{
+    const AVFrameSideData *sd = frame ? av_frame_get_side_data(frame, AV_FRAME_DATA_STEREO3D) : NULL;
+
+    if (!sd)
+        sd = av_frame_side_data_get(avctx->decoded_side_data, avctx->nb_decoded_side_data,
+                                   AV_FRAME_DATA_STEREO3D);
+    return sd ? (const AVStereo3D *)sd->data : NULL;
+}
+
+static int packing_params(AVCodecContext *avctx, const FFFramePacking *state,
+                          const AVStereo3D *st, FFFramePackingParams *p)
+{
+    /* Adapted from Mark Thompson's 2019 CBS frame packing helper. */
+    static const int type_map[] = {
+        [AV_STEREO3D_2D]                  = 6,
+        [AV_STEREO3D_SIDEBYSIDE]          = 3,
+        [AV_STEREO3D_TOPBOTTOM]           = 4,
+        [AV_STEREO3D_FRAMESEQUENCE]       = 5,
+        [AV_STEREO3D_CHECKERBOARD]        = 0,
+        [AV_STEREO3D_SIDEBYSIDE_QUINCUNX] = 3,
+        [AV_STEREO3D_LINES]               = 2,
+        [AV_STEREO3D_COLUMNS]             = 1,
+        [AV_STEREO3D_UNSPEC]              = -1,
+        [AV_STEREO3D_TILED]               = 7,
+        [AV_STEREO3D_TOPBOTTOM_QUINCUNX]   = 4,
+        [AV_STEREO3D_LINES_QUINCUNX]       = 2,
+        [AV_STEREO3D_COLUMNS_QUINCUNX]     = 1,
+    };
+
+    *p = (FFFramePackingParams) { 0 };
+    if (!st || (avctx->codec_id == AV_CODEC_ID_HEVC && st->type == AV_STEREO3D_2D))
+        return 0;
+    if ((unsigned)st->type >= FF_ARRAY_ELEMS(type_map) || type_map[st->type] < 0)
+        goto unsupported;
+    p->type = type_map[st->type];
+    if (avctx->codec_id == AV_CODEC_ID_HEVC && (p->type < 3 || p->type > 5))
+        goto unsupported;
+    if (p->type == 7 && (avctx->width % 3 || avctx->height % 3)) {
+        av_log(avctx, AV_LOG_ERROR, "Tiled frame packing requires cropped width and height "
+               "divisible by 3; use a compatible size or %s to disable the mark.\n",
+               state->disable_option);
+        return AVERROR(EINVAL);
+    }
+    p->quincunx = st->type == AV_STEREO3D_CHECKERBOARD ||
+                  st->type == AV_STEREO3D_SIDEBYSIDE_QUINCUNX ||
+                  st->type == AV_STEREO3D_TOPBOTTOM_QUINCUNX ||
+                  st->type == AV_STEREO3D_LINES_QUINCUNX ||
+                  st->type == AV_STEREO3D_COLUMNS_QUINCUNX;
+    p->content = st->type == AV_STEREO3D_2D ? 0 :
+                 st->flags & AV_STEREO3D_FLAG_INVERT ? 2 : 1;
+    p->frame0 = st->type == AV_STEREO3D_FRAMESEQUENCE && st->view == AV_STEREO3D_VIEW_LEFT;
+    return 1;
+
+unsupported:
+    av_log(avctx, AV_LOG_ERROR, "Cannot signal %s frame packing in %s; "
+           "choose a supported packing or %s to disable the mark.\n",
+           av_stereo3d_type_name(st->type), avcodec_get_name(avctx->codec_id),
+           state->disable_option);
+    return AVERROR(EINVAL);
+}
+
+int ff_frame_packing_init(AVCodecContext *avctx, FFFramePacking *s,
+                         int enabled, const char *disable_option,
+                         int require_initial_layout)
+{
+    FFFramePackingParams p;
+    int ret;
+
+    *s = (FFFramePacking) {
+        .enabled = enabled,
+        .disable_option = disable_option,
+        .require_initial_layout = require_initial_layout,
+    };
+    if (!enabled)
+        return 0;
+    ret = packing_params(avctx, s, get_stereo(avctx, NULL), &p);
+    if (ret < 0)
+        return ret;
+    s->initial_layout = ret;
+    return ret;
+}
+
+int ff_frame_packing_prepare(AVCodecContext *avctx, FFFramePacking *s,
+                            const AVFrame *frame, int keyframe,
+                            int64_t display_order, FFFramePackingParams *p)
+{
+    const AVStereo3D *st;
+    int ret, changed;
+
+    if (!s->enabled)
+        return 0;
+    st = get_stereo(avctx, frame);
+    ret = packing_params(avctx, s, st, p);
+    if (ret < 0)
+        return ret;
+    if (!ret) {
+        p->cancel = 1;
+        ret = s->active;
+        s->active = 0;
+        return ret;
+    }
+    if (s->require_initial_layout && !s->initial_layout) {
+        av_log(avctx, AV_LOG_ERROR, "%s frame packing arrived after HEVC parameter sets "
+               "declaring non-packed content; supply Stereo 3D decoded side data before "
+               "opening the encoder or %s to disable the mark.\n",
+               av_stereo3d_type_name(st->type), s->disable_option);
+        return AVERROR(EINVAL);
+    }
+    if (p->type == 5 && st->view != AV_STEREO3D_VIEW_LEFT && st->view != AV_STEREO3D_VIEW_RIGHT)
+        p->frame0 = !(display_order & 1);
+    changed = !s->active || p->type != s->last_type ||
+              p->quincunx != s->last_quincunx || p->content != s->last_content;
+    s->active = 1;
+    s->last_type = p->type;
+    s->last_quincunx = p->quincunx;
+    s->last_content = p->content;
+    return keyframe || changed || p->type == 5;
+}
+
+void ff_frame_packing_h264(const FFFramePackingParams *p,
+                           H264RawSEIFramePackingArrangement *sei)
+{
+    *sei = (H264RawSEIFramePackingArrangement) {
+        .frame_packing_arrangement_cancel_flag = p->cancel,
+        .frame_packing_arrangement_type = p->type,
+        .quincunx_sampling_flag = p->quincunx,
+        .content_interpretation_type = p->content,
+        .current_frame_is_frame0_flag = p->frame0,
+        .frame_packing_arrangement_repetition_period = p->type != 5,
+    };
+}
+
+void ff_frame_packing_hevc(const FFFramePackingParams *p,
+                           SEIRawFramePackingArrangement *sei)
+{
+    *sei = (SEIRawFramePackingArrangement) {
+        .fp_arrangement_cancel_flag = p->cancel,
+        .fp_arrangement_type = p->type,
+        .fp_quincunx_sampling_flag = p->quincunx,
+        .fp_content_interpretation_type = p->content,
+        .fp_current_frame_is_frame0_flag = p->frame0,
+        .fp_arrangement_persistence_flag = p->type != 5,
+    };
+}
+
+int ff_frame_packing_payload(enum AVCodecID codec, const FFFramePackingParams *p,
+                            uint8_t data[16])
+{
+    PutBitContext pb;
+
+    init_put_bits(&pb, data, 16);
+    put_bits(&pb, 1, 1); /* arrangement_id = 0, ue(v) */
+    put_bits(&pb, 1, p->cancel);
+    if (!p->cancel) {
+        put_bits(&pb, 7, p->type);
+        put_bits(&pb, 1, p->quincunx);
+        put_bits(&pb, 6, p->content);
+        put_bits(&pb, 3, 0); /* spatial flipping, frame 0 flipped, field views */
+        put_bits(&pb, 1, p->frame0);
+        put_bits(&pb, 2, 0); /* self-contained flags */
+        if (!p->quincunx && p->type != 5)
+            put_bits(&pb, 16, 0); /* grid positions */
+        put_bits(&pb, 8, 0); /* reserved byte */
+        if (codec == AV_CODEC_ID_H264)
+            put_bits(&pb, p->type == 5 ? 1 : 3, p->type == 5 ? 1 : 2);
+        else
+            put_bits(&pb, 1, p->type != 5);
+    }
+    put_bits(&pb, 1, 0); /* extension / upsampled aspect ratio */
+    if (put_bits_count(&pb) & 7)
+        put_bits(&pb, 1, 1); /* payload_bit_equal_to_one */
+    flush_put_bits(&pb);
+    return put_bytes_output(&pb);
+}
