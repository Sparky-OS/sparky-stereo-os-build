Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: upstream, https://git.ffmpeg.org/gitweb/ffmpeg.git/commit/1d8f52f0a1016292e301880afe132d60bfb8bc35
From 1d8f52f0a1016292e301880afe132d60bfb8bc35 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Sat, 17 Oct 2026 03:59:05 -0300
Subject: [PATCH 27/48] fate/cbs: test the multiview and depth information SEI
 messages

Read and write again the streams of the h264-depth-sei and hevc-depth-sei
tests, which come out as they went in. The H.265 stream's 3D reference
displays information has a 26-bit mantissa.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 tests/fate/cbs.mak                | 5 ++++-
 tests/ref/fate/cbs-h264-depth-sei | 1 +
 tests/ref/fate/cbs-hevc-depth-sei | 1 +
 3 files changed, 6 insertions(+), 1 deletion(-)
 create mode 100644 tests/ref/fate/cbs-h264-depth-sei
 create mode 100644 tests/ref/fate/cbs-hevc-depth-sei

diff --git a/tests/fate/cbs.mak b/tests/fate/cbs.mak
index d9200deb..bffd9f8a 100644
--- a/tests/fate/cbs.mak
+++ b/tests/fate/cbs.mak
@@ -85,7 +85,8 @@ FATE_CBS_H264_CONFORMANCE_SAMPLES = \
     CABACI3_Sony_B.jsv
 
 FATE_CBS_H264_SAMPLES = \
-    sei-1.h264
+    sei-1.h264 \
+    depth-sei.h264
 
 $(foreach N,$(FATE_CBS_H264_CONFORMANCE_SAMPLES),$(eval $(call FATE_CBS_TEST,h264,$(basename $(N)),h264,h264-conformance/$(N),h264)))
 $(foreach N,$(FATE_CBS_H264_SAMPLES),$(eval $(call FATE_CBS_TEST,h264,$(basename $(N)),h264,h264/$(N),h264)))
@@ -130,6 +131,8 @@ FATE_CBS_HEVC_SAMPLES =       \
     SLPPLP_A_VIDYO_2.bit
 
 $(foreach N,$(FATE_CBS_HEVC_SAMPLES),$(eval $(call FATE_CBS_TEST,hevc,$(basename $(N)),hevc,hevc-conformance/$(N),hevc)))
+# the multiview and depth information SEI messages
+$(eval $(call FATE_CBS_TEST,hevc,depth-sei,hevc,hevc/depth-sei.hevc,hevc))
 
 FATE_CBS_HEVC-$(call FATE_CBS_DEPS, HEVC, HEVC, HEVC, HEVC, HEVC) = $(FATE_CBS_hevc)
 
diff --git a/tests/ref/fate/cbs-h264-depth-sei b/tests/ref/fate/cbs-h264-depth-sei
new file mode 100644
index 00000000..202db670
--- /dev/null
+++ b/tests/ref/fate/cbs-h264-depth-sei
@@ -0,0 +1 @@
+786a953fa1d4c1dcd67b3fb171a42b50
diff --git a/tests/ref/fate/cbs-hevc-depth-sei b/tests/ref/fate/cbs-hevc-depth-sei
new file mode 100644
index 00000000..3b7b5f7a
--- /dev/null
+++ b/tests/ref/fate/cbs-hevc-depth-sei
@@ -0,0 +1 @@
+7654bf9d9e40a66c739d3db78ce3a2da
