 libavformat/mpegauxvideo.h |  41 ++++++++++
 libavformat/mpegts.c       |  27 +++++++
 libavformat/mpegts.h       |   2 +
 5 files changed, 233 insertions(+), 1 deletion(-)
 create mode 100644 libavformat/mpegauxvideo.c
