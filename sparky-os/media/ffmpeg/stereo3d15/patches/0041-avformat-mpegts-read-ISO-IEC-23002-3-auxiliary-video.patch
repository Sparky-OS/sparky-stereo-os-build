new file mode 100644
index 00000000..466f78c1
--- /dev/null
+++ b/libavformat/mpegauxvideo.h
@@ -0,0 +1,41 @@
+/*
+ * ISO/IEC 23002-3 auxiliary video supplemental information
+ *
