diff --git a/libavformat/mpegauxvideo.c b/libavformat/mpegauxvideo.c
new file mode 100644
index 00000000..60514a43
--- /dev/null
+++ b/libavformat/mpegauxvideo.c
@@ -0,0 +1,162 @@
+/*
+ * ISO/IEC 23002-3 auxiliary video supplemental information
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/*
+ * si_rbsp() holds SI messages, each a payload type and a payload size (coded
+ * as SEI messages code them, with 0xFF bytes for each 255), then the
+ * payload. Payload type 0 is a depth map and 1 a parallax map, each with
+ * generic_params() (3 bytes) and then depth_params() (2 bytes) or
+ * parallax_params() (8 bytes); other payload types are reserved and skipped.
+ *
+ * ISO/IEC 23002-3 (6.1 syntax, 6.2 semantics) is not freely available: this
+ * is the syntax as TSDuck reads it (AuxiliaryVideoStreamDescriptor), whose
+ * parallax_params() HDMI 1.4a (Table H-4) confirms. An RBSP ends with
+ * rbsp_trailing_bits() (ITU-T H.264 3.129), which TSDuck neither reads nor
+ * writes: the reader accepts the messages with or without it.
+ */
+
+#include "libavutil/intreadwrite.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavcodec/packet.h"
+
+#include "mpegauxvideo.h"
+
+static int read_value(const uint8_t **p, const uint8_t *end, unsigned *value)
+{
+    int byte;
+
+    *value = 0;
+    do {
+        if (*p >= end)
+            return AVERROR_INVALIDDATA;
+        byte    = *(*p)++;
+        *value += byte;
+    } while (byte == 0xff);
+
+    return 0;
+}
+
+int ff_aux_video_si_parse(void *logctx, AVCodecParameters *par,
+                          const uint8_t *buf, int size)
+{
+    const uint8_t *p = buf, *end = buf + size;
+    AVAuxiliaryVideoInfo *info = NULL;
+    size_t info_size;
+    int ret;
+
+    while (end - p >= 2) {
+        const uint8_t *msg;
+        unsigned payload_type, payload_size;
+
+        /* rbsp_trailing_bits() */
+        if (*p == 0x80) {
+            const uint8_t *q = p + 1;
+
+            while (q < end && !*q)
+                q++;
+            if (q == end)
+                break;
+        }
+
+        if ((ret = read_value(&p, end, &payload_type)) < 0 ||
+            (ret = read_value(&p, end, &payload_size)) < 0)
+            goto fail;
+        if (payload_size > end - p) {
+            av_log(logctx, AV_LOG_WARNING, "SI message of type %u overreads "
+                   "the supplemental information\n", payload_type);
+            break;
+        }
+        msg = p;
+        p  += payload_size;
+
+        if (payload_type != AV_AUXILIARY_VIDEO_DEPTH &&
+            payload_type != AV_AUXILIARY_VIDEO_PARALLAX)
+            continue;
+        if (info) {
+            av_log(logctx, AV_LOG_WARNING, "More than one auxiliary video SI "
+                   "message, keeping the first\n");
+            continue;
+        }
+        if (payload_size < (payload_type == AV_AUXILIARY_VIDEO_DEPTH ? 5 : 11)) {
+            av_log(logctx, AV_LOG_WARNING, "Auxiliary video SI message of type "
+                   "%u too short (%u bytes)\n", payload_type, payload_size);
+            continue;
+        }
+
+        info = av_auxiliary_video_info_alloc(&info_size);
+        if (!info)
+            return AVERROR(ENOMEM);
+        info->type = payload_type;
+
+        /* generic_params() */
+        info->aux_is_one_field = msg[0] >> 7;
+        if (info->aux_is_one_field) {
+            info->aux_is_bottom_field = msg[0] >> 6 & 1;
+            info->aux_is_interlaced   = 1;
+        } else {
+            info->aux_is_interlaced   = msg[0] >> 6 & 1;
+        }
+        info->position_offset_h = msg[1];
+        info->position_offset_v = msg[2];
+
+        if (payload_type == AV_AUXILIARY_VIDEO_DEPTH) {
+            /* depth_params() */
+            info->nkfar  = msg[3];
+            info->nknear = msg[4];
+        } else {
+            /* parallax_params() */
+            info->parallax_zero  = AV_RB16(msg + 3);
+            info->parallax_scale = AV_RB16(msg + 5);
+            info->dref           = AV_RB16(msg + 7);
+            info->wref           = AV_RB16(msg + 9);
+        }
+    }
+
+    if (!info) {
+        av_log(logctx, AV_LOG_WARNING, "Auxiliary video supplemental "
+               "information without an auxiliary video SI message\n");
+        return 0;
+    }
+
+    if (!av_packet_side_data_add(&par->coded_side_data, &par->nb_coded_side_data,
+                                 AV_PKT_DATA_AUXILIARY_VIDEO_INFO,
+                                 (uint8_t *)info, info_size, 0)) {
+        av_free(info);
+        return AVERROR(ENOMEM);
+    }
+
+    /* A depth map is a depth auxiliary picture (AuxId 2, H.265 Table F.2). */
+    if (info->type == AV_AUXILIARY_VIDEO_DEPTH) {
+        AVPacketSideData *sd = av_packet_side_data_new(&par->coded_side_data,
+                                                       &par->nb_coded_side_data,
+                                                       AV_PKT_DATA_AUXILIARY_ID,
+                                                       sizeof(int), 0);
+        if (!sd)
+            return AVERROR(ENOMEM);
+        *(int *)sd->data = 2;
+    }
+
+    return 0;
+
+fail:
+    av_log(logctx, AV_LOG_ERROR, "Truncated auxiliary video supplemental information\n");
+    return ret;
+}
