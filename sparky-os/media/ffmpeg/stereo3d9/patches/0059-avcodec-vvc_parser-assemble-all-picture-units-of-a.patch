+static void output_au(AVCodecParserContext *s, AVCodecContext *avctx)
+{
+    VVCParserContext *ctx = s->priv_data;
+
+    av_packet_move_ref(&ctx->last_au, &ctx->au);
+    set_parser_ctx(s, avctx, &ctx->au_info);
+    s->pts = ctx->last_au.pts;
+    s->dts = ctx->last_au.dts;
+    s->pos = ctx->last_au.pos;
+    s->offset = ctx->au_info.offset;
+    /* The input may already include a PU from the following AU. */
+    s->next_frame_offset = ctx->au_info.start;
+    ctx->au_complete = 0;
+}
+
+static void save_pu_timestamp(AVCodecParserContext *s)
+{
+    VVCParserContext *ctx = s->priv_data;
+    ParseContext *pc = &ctx->pc;
+    int64_t pts = s->pts, dts = s->dts, pos = s->pos, offset = s->offset;
+    int64_t frame_offset = s->frame_offset;
+    int64_t next_frame_offset = s->next_frame_offset;
+    int overread = pc->index + pc->overread;
+
+    ctx->pu_start = s->cur_offset - overread;
+    /* Capture at the PU start before its timestamp leaves the input history.
+     * Exclude timestamps already belonging to the preceding AU. */
+    s->frame_offset = ctx->au_info.start;
+    s->next_frame_offset = ctx->pu_start;
+    ff_fetch_timestamp(s, -overread, 0, 0);
+    ctx->pu_pts = s->pts;
+    ctx->pu_dts = s->dts;
+    ctx->pu_pos = s->pos;
+    ctx->pu_offset = s->offset;
+    s->pts = pts;
+    s->dts = dts;
+    s->pos = pos;
+    s->offset = offset;
+    s->frame_offset = frame_offset;
+    s->next_frame_offset = next_frame_offset;
+    ctx->pu_start_found = 1;
+}
