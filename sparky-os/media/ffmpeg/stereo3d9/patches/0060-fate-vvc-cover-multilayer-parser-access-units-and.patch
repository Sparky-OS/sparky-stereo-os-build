diff --git a/tests/api/api-vvc-parser-test.c b/tests/api/api-vvc-parser-test.c
new file mode 100644
index 0000000..ad8a4c9
--- /dev/null
+++ b/tests/api/api-vvc-parser-test.c
@@ -0,0 +1,137 @@
+/*
+ * VVC parser packet boundary and timestamp test
+ * Copyright (c) 2026 Daniel Campos Ramos
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "libavcodec/avcodec.h"
+#include "libavutil/file.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+
+static int positive_int(const char *arg)
+{
+    char *end;
+    long value;
+
+    errno = 0;
+    value = strtol(arg, &end, 10);
+    if (errno || !*arg || *end || value <= 0 ||
+        value > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE)
+        return -1;
+    return value;
+}
+
+static void show(const AVCodecParserContext *parser, int size)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(parser->format);
+    printf("%"PRId64" %d %"PRId64" %"PRId64" %"PRId64" %"PRId64
+           " %c %d %d %d %d %d %d\n",
+           parser->frame_offset, size, parser->pts, parser->dts,
+           parser->pos, parser->offset, av_get_picture_type_char(parser->pict_type),
+           parser->key_frame, desc ? desc->comp[0].depth : 0,
+           parser->width, parser->height, parser->coded_width, parser->coded_height);
+}
+
+int main(int argc, char **argv)
+{
+    AVCodecParserContext *parser = NULL;
+    AVCodecContext *ctx = NULL;
+    uint8_t *data = NULL, *buf = NULL, *out;
+    size_t size = 0, pos = 0;
+    int chunk, out_size, ret = 1, complete;
+
+    complete = argc >= 3 && !strcmp(argv[2], "complete");
+    if (argc < 4 || (chunk = complete ? 1 : positive_int(argv[2])) < 0) {
+        fprintf(stderr, "Usage: %s sample chunk_size|complete input_packet_sizes...\n",
+                argv[0]);
+        return 1;
+    }
+    if (av_file_map(argv[1], &data, &size, 0, NULL) < 0)
+        return 1;
+    if (complete) {
+        if (!size || size > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE)
+            goto end;
+        chunk = size;
+    }
+    buf = av_mallocz(chunk + AV_INPUT_BUFFER_PADDING_SIZE);
+    parser = av_parser_init(AV_CODEC_ID_VVC);
+    ctx = avcodec_alloc_context3(NULL);
+    if (!buf || !parser || !ctx)
+        goto end;
+    ctx->codec_id = AV_CODEC_ID_VVC;
+    ctx->codec_type = AVMEDIA_TYPE_VIDEO;
+    if (complete)
+        parser->flags |= PARSER_FLAG_COMPLETE_FRAMES;
+
+    /* The arguments describe input packets, not expected parser output.
+     * Only the first chunk of each input packet carries its timestamps. */
+    for (int i = 3; i < argc; i++) {
+        int length = positive_int(argv[i]);
+        size_t packet_end, start = pos;
+
+        if (length < 0 || length > size - pos)
+            goto end;
+        packet_end = pos + length;
+        while (pos < packet_end) {
+            int n = packet_end - pos < chunk ? packet_end - pos : chunk;
+            int off = 0;
+            int64_t pts = pos == start ? (int64_t)(i - 3) * 100 : AV_NOPTS_VALUE;
+            int64_t dts = pos == start ? (int64_t)(i - 3) * 100 - 50 : AV_NOPTS_VALUE;
+
+            memcpy(buf, data + pos, n);
+            memset(buf + n, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+            while (off < n) {
+                int used = av_parser_parse2(parser, ctx, &out, &out_size,
+                                            buf + off, n - off, pts, dts, pos);
+                if (used < 0 || (!used && !out_size))
+                    goto end;
+                if (out_size)
+                    show(parser, out_size);
+                off += used;
+            }
+            pos += n;
+        }
+    }
+    if (pos != size)
+        goto end;
+    do {
+        if (av_parser_parse2(parser, ctx, &out, &out_size, NULL, 0,
+                             AV_NOPTS_VALUE, AV_NOPTS_VALUE, pos) < 0)
+            goto end;
+        if (out_size)
+            show(parser, out_size);
+    } while (out_size);
+    ret = 0;
+
+end:
+    if (ret)
+        fprintf(stderr, "VVC parser probe failed at input offset %zu\n", pos);
+    av_parser_close(parser);
+    avcodec_free_context(&ctx);
+    av_free(buf);
+    av_file_unmap(data, size);
+    return ret;
+}
