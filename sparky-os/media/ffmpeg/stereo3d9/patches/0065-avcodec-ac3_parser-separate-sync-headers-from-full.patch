-    err = ff_ac3_parse_header(&s->gbc, &hdr);
+    err = ff_ac3_parse_header_full(&s->gbc, &hdr);
     if (err)
         return err;
 
@@ -1559,7 +1559,7 @@ dependent_frame:
         if ((ret = init_get_bits8(&s->gbc, buf + s->frame_size, buf_size - s->frame_size)) < 0)
             return ret;
 
-        err = ff_ac3_parse_header(&s->gbc, &hdr);
+        err = ff_ac3_parse_header_full(&s->gbc, &hdr);
         if (err)
             return err;
 
