diff --git a/libavcodec/ac3_parser.c b/libavcodec/ac3_parser.c
index 232c96d..ae3e89f 100644
--- a/libavcodec/ac3_parser.c
+++ b/libavcodec/ac3_parser.c
@@ -345,10 +345,6 @@ int ff_ac3_parse_header(GetBitContext *gbc, AC3HeaderInfo *hdr)
         hdr->frame_size = ff_ac3_frame_size_tab[frame_size_code][hdr->sr_code] * 2;
         hdr->frame_type = EAC3_FRAME_TYPE_AC3_CONVERT; //EAC3_FRAME_TYPE_INDEPENDENT;
         hdr->substreamid = 0;
-
-        int ret = ac3_parse_header(gbc, hdr);
-        if (ret < 0)
-            return ret;
     } else {
         /* Enhanced AC-3 */
         hdr->crc1 = 0;
@@ -381,10 +377,6 @@ int ff_ac3_parse_header(GetBitContext *gbc, AC3HeaderInfo *hdr)
         hdr->bit_rate = 8LL * hdr->frame_size * hdr->sample_rate /
                         (hdr->num_blocks * 256);
         hdr->channels = ff_ac3_channels_tab[hdr->channel_mode] + hdr->lfe_on;
-
-        int ret = eac3_parse_header(gbc, hdr);
-        if (ret < 0)
-            return ret;
     }
     hdr->channel_layout = ff_ac3_channel_layout_tab[hdr->channel_mode];
     if (hdr->lfe_on)
@@ -393,6 +385,19 @@ int ff_ac3_parse_header(GetBitContext *gbc, AC3HeaderInfo *hdr)
     return 0;
 }
 
+int ff_ac3_parse_header_full(GetBitContext *gbc, AC3HeaderInfo *hdr)
+{
+    int ret = ff_ac3_parse_header(gbc, hdr);
+
+    if (ret < 0)
+        return ret;
+
+    if (hdr->bitstream_id <= 10)
+        return ac3_parse_header(gbc, hdr);
+    else
+        return eac3_parse_header(gbc, hdr);
+}
+
 // TODO: Better way to pass AC3HeaderInfo fields to mov muxer.
 int avpriv_ac3_parse_header(AC3HeaderInfo **phdr, const uint8_t *buf,
                             size_t size)
@@ -410,7 +415,7 @@ int avpriv_ac3_parse_header(AC3HeaderInfo **phdr, const uint8_t *buf,
     err = init_get_bits8(&gb, buf, size);
     if (err < 0)
         return AVERROR_INVALIDDATA;
-    err = ff_ac3_parse_header(&gb, hdr);
+    err = ff_ac3_parse_header_full(&gb, hdr);
     if (err < 0)
         return AVERROR_INVALIDDATA;
 
@@ -431,7 +436,7 @@ int av_ac3_parse_header(const uint8_t *buf, size_t size,
     err = init_get_bits8(&gb, tmp, size);
     if (err < 0)
         return AVERROR_INVALIDDATA;
-    err = ff_ac3_parse_header(&gb, &hdr);
+    err = ff_ac3_parse_header_full(&gb, &hdr);
     if (err < 0)
         return AVERROR_INVALIDDATA;
 
@@ -457,10 +462,10 @@ static int ac3_sync(uint64_t state, int *need_next_header, int *new_frame_start)
         FFSWAP(uint8_t, tmp.u8[5], tmp.u8[6]);
     }
 
-    init_get_bits(&gbc, tmp.u8+8-AC3_HEADER_SIZE, 54);
+    init_get_bits(&gbc, tmp.u8+8-AC3_HEADER_SIZE, AC3_HEADER_SIZE * 8);
     err = ff_ac3_parse_header(&gbc, &hdr);
 
-    if(err < 0)
+    if (err < 0 || hdr.substreamid)
         return 0;
 
     *new_frame_start  = (hdr.frame_type != EAC3_FRAME_TYPE_DEPENDENT);
diff --git a/libavcodec/ac3_parser_internal.h b/libavcodec/ac3_parser_internal.h
index ab5df34..52c2b56 100644
--- a/libavcodec/ac3_parser_internal.h
+++ b/libavcodec/ac3_parser_internal.h
@@ -94,14 +94,21 @@ typedef enum {
 
 /**
  * Parse AC-3 frame header.
- * Parse the header up to the lfeon element, which is the first 52 or 54 bits
- * depending on the audio coding mode.
- * @param[in]  gbc BitContext containing the first 54 bits of the frame.
+ * Parse the header up to the lfeon element, which ends within the first 56 bits
+ * depending on the audio coding mode and bitstream identification.
+ * @param[in]  gbc BitContext containing the first 56 bits of the frame.
  * @param[out] hdr Pointer to struct where header info is written.
  * @return 0 on success and AC3_PARSE_ERROR_* values otherwise.
  */
 int ff_ac3_parse_header(GetBitContext *gbc, AC3HeaderInfo *hdr);
 
+/**
+ * Parse the complete AC-3 or E-AC-3 bit stream information.
+ * Unlike ff_ac3_parse_header(), this requires the full header, including
+ * optional metadata following lfeon.
+ */
+int ff_ac3_parse_header_full(GetBitContext *gbc, AC3HeaderInfo *hdr);
+
 int avpriv_ac3_parse_header(AC3HeaderInfo **hdr, const uint8_t *buf,
                             size_t size);
 
