diff --git a/libavcodec/vvc/dec.c b/libavcodec/vvc/dec.c
index 49186af..5bf2f71 100644
--- a/libavcodec/vvc/dec.c
+++ b/libavcodec/vvc/dec.c
@@ -1065,7 +1065,8 @@ static int decode_nal_units(VVCContext *s, VVCFrameContext *fc, AVPacket *avpkt)
         const CodedBitstreamUnit *unit = frame->units + i;
 
         if (unit->type == VVC_EOB_NUT || unit->type == VVC_EOS_NUT) {
-            s->last_eos = 1;
+            if (!nal->nuh_layer_id)
+                s->eos = 1;
         } else {
             ret = decode_nal_unit(s, fc, avpkt->buf, nal, unit);
