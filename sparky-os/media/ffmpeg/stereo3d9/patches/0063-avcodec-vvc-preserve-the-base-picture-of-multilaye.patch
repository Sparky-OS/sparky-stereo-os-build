diff --git a/libavcodec/vvc/dec.c b/libavcodec/vvc/dec.c
index 5bf2f71..b43d82b 100644
--- a/libavcodec/vvc/dec.c
+++ b/libavcodec/vvc/dec.c
@@ -748,9 +748,12 @@ static void decode_prefix_sei(VVCFrameContext *fc, VVCContext *s)
 
     for (int i = 0; i < frame->nb_units; i++) {
         const CodedBitstreamUnit *unit = frame->units + i;
+        const H266RawSEI *sei          = unit->content_ref;
 
-        if (unit->type == VVC_PREFIX_SEI_NUT) {
-            int ret = ff_vvc_sei_decode(&fc->sei, unit->content_ref, fc);
+        /* Keep layer-associated SEI with its picture (H.266 D.2.2). */
+        if (unit->type == VVC_PREFIX_SEI_NUT &&
+            (!sei || !sei->nal_unit_header.nuh_layer_id)) {
+            int ret = ff_vvc_sei_decode(&fc->sei, sei, fc);
             if (ret < 0)
                 return;
         }
@@ -1000,10 +1003,13 @@ static int decode_nal_unit(VVCContext *s, VVCFrameContext *fc, AVBufferRef *buf_
 
     s->temporal_id = nal->temporal_id;
 
+    /* Only layer 0 is supported. Skip other layers without discarding
+     * the base picture in the same access unit. */
     if (nal->nuh_layer_id > 0) {
-        avpriv_report_missing_feature(fc->log_ctx,
-                "Decoding of multilayer bitstreams");
-        return AVERROR_PATCHWELCOME;
+        av_log_once(s->avctx, AV_LOG_WARNING, AV_LOG_DEBUG, &s->multilayer_warning_shown,
+                    "Decoding of multilayer bitstreams is not implemented, "
+                    "decoding the base layer only.\n");
+        return 0;
     }
 
     switch (unit->type) {
