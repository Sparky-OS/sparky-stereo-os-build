-        next = hevc_find_frame_end(s, buf, buf_size);
-        if (ff_combine_frame(pc, next, &buf, &buf_size) < 0) {
+        uint64_t state64 = pc->state64;
+        int64_t end;
+        int found = hevc_find_frame_end(s, buf, buf_size, &end);
+        int overread;
+
+        /* av_parser_parse2() requires a return greater than -0x20000000. */
+        if ((found && end <= -0x20000000) ||
+            (ctx->au_start_found && ctx->au_start <= -0x20000000)) {
+            av_log(avctx, AV_LOG_ERROR, "HEVC access unit lookahead is too large\n");
+            pc->index = pc->overread = pc->frame_start_found = 0;
