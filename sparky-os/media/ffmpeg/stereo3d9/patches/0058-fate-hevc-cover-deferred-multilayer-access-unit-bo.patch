index 0000000..d76b6b9
--- /dev/null
+++ b/tests/api/api-hevc-parser-test.c
@@ -0,0 +1,123 @@
+/*
+ * HEVC parser packet boundary and timestamp test
+ * Copyright (c) 2026 Daniel Campos Ramos
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "libavcodec/avcodec.h"
+#include "libavutil/file.h"
+#include "libavutil/mem.h"
+
+static int positive_int(const char *arg)
+{
+    char *end;
+    long value;
+
+    errno = 0;
+    value = strtol(arg, &end, 10);
+    if (errno || !*arg || *end || value <= 0 ||
+        value > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE)
+        return -1;
+    return value;
+}
+
+static void show(const AVCodecParserContext *parser, int size)
+{
+    printf("%"PRId64" %d %"PRId64" %"PRId64" %"PRId64" %"PRId64"\n",
+           parser->frame_offset, size, parser->pts, parser->dts,
+           parser->pos, parser->offset);
+}
+
+int main(int argc, char **argv)
+{
+    AVCodecParserContext *parser = NULL;
+    AVCodecContext *ctx = NULL;
+    uint8_t *data = NULL, *buf = NULL, *out;
+    size_t size = 0, pos = 0;
+    int chunk, out_size, ret = 1;
+
+    if (argc < 4 || (chunk = positive_int(argv[2])) < 0) {
+        fprintf(stderr, "Usage: %s sample chunk_size input_packet_sizes...\n",
+                argv[0]);
+        return 1;
+    }
+    if (av_file_map(argv[1], &data, &size, 0, NULL) < 0)
+        return 1;
+    buf = av_mallocz(chunk + AV_INPUT_BUFFER_PADDING_SIZE);
+    parser = av_parser_init(AV_CODEC_ID_HEVC);
+    ctx = avcodec_alloc_context3(NULL);
+    if (!buf || !parser || !ctx)
+        goto end;
+    ctx->codec_id = AV_CODEC_ID_HEVC;
+
+    /* The arguments describe input packets, not expected parser output.
+     * Only the first chunk of each input packet carries its timestamps. */
+    for (int i = 3; i < argc; i++) {
+        int length = positive_int(argv[i]);
+        size_t packet_end, start = pos;
+
+        if (length < 0 || length > size - pos)
+            goto end;
+        packet_end = pos + length;
+        while (pos < packet_end) {
+            int n = packet_end - pos < chunk ? packet_end - pos : chunk;
+            int off = 0;
+            int64_t pts = pos == start ? (int64_t)(i - 3) * 100 : AV_NOPTS_VALUE;
+            int64_t dts = pos == start ? (int64_t)(i - 3) * 100 - 50 : AV_NOPTS_VALUE;
+
+            memcpy(buf, data + pos, n);
+            memset(buf + n, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+            while (off < n) {
+                int used = av_parser_parse2(parser, ctx, &out, &out_size,
+                                            buf + off, n - off, pts, dts, pos);
+                if (used < 0 || (!used && !out_size))
+                    goto end;
+                if (out_size)
+                    show(parser, out_size);
+                off += used;
+            }
+            pos += n;
+        }
+    }
+    if (pos != size)
+        goto end;
+    do {
+        if (av_parser_parse2(parser, ctx, &out, &out_size, NULL, 0,
+                             AV_NOPTS_VALUE, AV_NOPTS_VALUE, pos) < 0)
+            goto end;
+        if (out_size)
+            show(parser, out_size);
+    } while (out_size);
+    ret = 0;
+
+end:
+    if (ret)
+        fprintf(stderr, "HEVC parser probe failed at input offset %zu\n", pos);
+    av_parser_close(parser);
+    avcodec_free_context(&ctx);
+    av_free(buf);
+    av_file_unmap(data, size);
+    return ret;
+}
