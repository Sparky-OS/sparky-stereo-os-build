index 48aa85d..4964434 100644
--- a/tests/fate/hevc.mak
+++ b/tests/fate/hevc.mak
@@ -312,6 +312,13 @@ FATE_HEVC-$(call FRAMECRC, HEVC, HEVC, HEVC_PARSER SCALE_FILTER) += fate-hevc-sm
 fate-hevc-pir: CMD = framecrc -i $(TARGET_SAMPLES)/hevc/pir.hevc
 FATE_HEVC-$(call FRAMECRC, HEVC, HEVC, HEVC_PARSER) += fate-hevc-pir
 
+# Nonzero-layer prefix SEI at an AU boundary and PPS between pictures of one AU.
+fate-hevc-mv-au-boundaries: CMD = framecrc -i $(TARGET_SAMPLES)/hevc/mv-au-boundaries.hevc -c copy
+fate-hevc-mv-au-boundaries-decode: CMD = framecrc -i $(TARGET_SAMPLES)/hevc/mv-au-boundaries.hevc -map 0:view:all
+# One-byte input makes the deferred boundary coincide with END_NOT_FOUND (-100).
+fate-hevc-mv-au-boundaries-buffered: CMD = framecrc -raw_packet_size 1 -i $(TARGET_SAMPLES)/hevc/mv-au-boundaries-buffered.hevc -c copy
+FATE_HEVC-$(call FRAMECRC, HEVC, HEVC, HEVC_PARSER) += fate-hevc-mv-au-boundaries fate-hevc-mv-au-boundaries-decode fate-hevc-mv-au-boundaries-buffered
+
 # multiview stream, where the secondary layer has a nontrivial nuh_layer_id=6
 fate-hevc-mv-nuh-layer-id: CMD = framecrc -i $(TARGET_SAMPLES)/hevc/mv_nuh_layer_id.bit -map 0:view:all
 FATE_HEVC-$(call FRAMECRC, HEVC, HEVC, HEVC_PARSER) += fate-hevc-mv-nuh-layer-id
