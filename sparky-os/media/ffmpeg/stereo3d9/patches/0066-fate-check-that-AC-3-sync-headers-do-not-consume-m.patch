+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "libavcodec/ac3_parser_internal.h"
+#include "libavcodec/defs.h"
+
+int main(void)
+{
+    static const uint8_t headers[][7] = {
+        { 0x0b, 0x77, 0x00, 0x00, 0x22, 0x30, 0xe0 },
+        { 0x0b, 0x77, 0x00, 0x00, 0x22, 0x40, 0x00 },
+        { 0x0b, 0x77, 0x04, 0x7f, 0x3a, 0x87, 0xe1 },
+        { 0x0b, 0x77, 0x44, 0x7f, 0x3a, 0x87, 0xe1 },
+    };
+    uint8_t buf[64 + AV_INPUT_BUFFER_PADDING_SIZE];
+
+    /* The basic header must not depend on the following metadata. */
+    for (int i = 0; i < FF_ARRAY_ELEMS(headers); i++) {
+        for (int fill = 0; fill <= 255; fill += 255) {
+            AC3HeaderInfo hdr;
+            GetBitContext gb;
+            int ret;
+
+            memset(buf, fill, 64);
+            memset(buf + 64, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+            memcpy(buf, headers[i], sizeof(headers[i]));
+            init_get_bits8(&gb, buf, 64);
+            ret = ff_ac3_parse_header(&gb, &hdr);
+            printf("header %d tail %02x: ret %d bits %d bsid %d "
+                   "type %d size %d rate %d channels %d blocks %d\n",
+                   i, fill, ret, get_bits_count(&gb), hdr.bitstream_id,
+                   hdr.frame_type, hdr.frame_size, hdr.sample_rate,
+                   hdr.channels, hdr.num_blocks);
+        }
+    }
+    return 0;
+}
