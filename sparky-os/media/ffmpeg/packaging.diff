+# Fraunhofer's AAC encoder (libfdk-aac) is non-free: FFmpeg's LICENSE.md calls a GPL build
+# that enables it unredistributable. It stays out of the packages that are shipped; the build
+# profile pkg.ffmpeg-dmo.fdk (sparky-stereo-ffmpeg-fdk) turns it on for a build on one machine.
+ifneq (,$(filter pkg.ffmpeg-dmo.fdk,$(DEB_BUILD_PROFILES)))
+	CONFIG_ALL += --enable-libfdk-aac --enable-nonfree
+endif
+
 ifeq "$(DEB_BUILD_ARCH)" "amd64"
 	CONFIG_ALL += --enable-vaapi --enable-libvpl
