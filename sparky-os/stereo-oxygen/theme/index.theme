[Icon Theme]
Name=Stereo Oxygen
Comment=Oxygen, in stereo
Inherits=oxygen
Directories=plain/16x16/actions
X-StereoDirectories=stereo/32x32/places,stereo/32x32/devices,stereo/32x32/apps,stereo/32x32/categories,stereo/48x48/places,stereo/48x48/devices,stereo/48x48/apps,stereo/48x48/categories,stereo/128x128/places,stereo/128x128/devices,stereo/128x128/apps,stereo/128x128/categories,stereo/256x256/places,stereo/256x256/devices,stereo/256x256/apps,stereo/256x256/categories

[plain/16x16/actions]
Size=16
Context=Actions
Type=Fixed

[stereo/32x32/places]
X-StereoSize=32
Context=Places
Type=Fixed
X-StereoLayout=sbs-left-first

