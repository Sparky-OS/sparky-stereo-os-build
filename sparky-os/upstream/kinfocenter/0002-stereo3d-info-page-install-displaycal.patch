+    // Installs DisplayCAL through Stereo APTus' own entry action, which says apt's sizes first and every failure with its reason
+    Q_INVOKABLE void installDisplayCal()
+    {
+        if (m_displayCalState != QLatin1String("absent")) {
+            return;
+        }
+        setDisplayCal(QStringLiteral("installing"), m_displayCalLines, i18nc("@info:status", "Installing DisplayCAL…"));
+        auto *install = new QProcess(this);
+        install->setProcessChannelMode(QProcess::MergedChannels);
+        connect(install, &QProcess::finished, this, [this, install](int code, QProcess::ExitStatus status) {
+            const QString output = QString::fromUtf8(install->readAll()).trimmed();
+            install->deleteLater();
+            if (status == QProcess::NormalExit && code == 0) {
+                refreshDisplayCal();
+                return;
+            }
+            const QString reason = (code == 126 || code == 127) && output.isEmpty()
+                ? i18nc("@info", "Authorization was cancelled. Nothing was installed.")
+                : lastLines(output, 2);
+            setDisplayCal(QStringLiteral("absent"), m_displayCalLines, i18nc("@info %1 is the reason", "Installing DisplayCAL failed. %1", reason));
+        });
+        connect(install, &QProcess::errorOccurred, this, [this, install](QProcess::ProcessError) {
+            const QString reason = install->errorString();
+            install->deleteLater();
+            setDisplayCal(QStringLiteral("absent"), m_displayCalLines, i18nc("@info %1 is the reason", "Installing DisplayCAL failed. %1", reason));
+        });
+        install->start(QStringLiteral("pkexec"), {QString::fromLatin1(s_entryAction), QStringLiteral("displaycal"), QStringLiteral("install")});
+    }
+
+Q_SIGNALS:
+    void displayCalChanged();
 
 private:
+    // The action says what failed as its own sentence, and the engine may add lines after it: the last few lines are the reason
+    static QString lastLines(const QString &output, int count)
+    {
+        const QStringList lines = output.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+        return lines.mid(qMax(0, lines.size() - count)).join(QLatin1Char('\n'));
+    }
+    static constexpr const char *s_entryAction = "/usr/lib/sparky-aptus-stereo-appcenter/actions/entry";
+
+    void setDisplayCal(const QString &state, const QStringList &lines, const QString &message)
+    {
+        m_displayCalState = state;
+        m_displayCalLines = lines;
+        m_displayCalMessage = message;
+        Q_EMIT displayCalChanged();
+    }
+    // Installed: nothing else is asked. Otherwise Stereo APTus is asked for the entry's state and apt's sizes (a simulation, nothing changes).
+    void refreshDisplayCal()
+    {
+        if (KService::serviceByDesktopName(QStringLiteral("displaycal"))) {
+            setDisplayCal(QStringLiteral("installed"), {}, {});
+            return;
+        }
+        if (!QFile::exists(QString::fromLatin1(s_entryAction))) {
+            setDisplayCal(QStringLiteral("unavailable"),
+                          {},
+                          i18nc("@info", "Stereo APTus is not installed, so DisplayCAL cannot be offered from here. Install the package sparky-aptus-stereo-appcenter, or run: apt install displaycal"));
+            return;
+        }
+        setDisplayCal(QStringLiteral("unavailable"), {}, i18nc("@info:status", "Checking what DisplayCAL needs…"));
+        auto *status = new QProcess(this);
+        status->setProcessChannelMode(QProcess::SeparateChannels);
+        connect(status, &QProcess::finished, this, [this, status](int code) {
+            const QByteArray out = status->readAllStandardOutput();
+            const QString err = QString::fromUtf8(status->readAllStandardError()).trimmed();
+            status->deleteLater();
+            const QJsonObject entry = QJsonDocument::fromJson(out).object();
+            if (code != 0 || entry.isEmpty()) {
+                setDisplayCal(QStringLiteral("unavailable"), {}, i18nc("@info %1 is the reason", "Could not read what installing DisplayCAL needs: %1", err.isEmpty() ? QString::number(code) : err));
+                return;
+            }
+            if (entry.value(QStringLiteral("installed")).toBool()) {
+                setDisplayCal(QStringLiteral("installed"), {}, {});
+                return;
+            }
+            const QJsonObject tools = entry.value(QStringLiteral("tools")).toObject();
+            if (!entry.value(QStringLiteral("visible")).toBool()) {
+                setDisplayCal(QStringLiteral("unavailable"), {}, i18nc("@info", "No enabled package source offers DisplayCAL. Update the package lists (apt update) and open this page again."));
+            } else if (tools.contains(QStringLiteral("error"))) {
+                setDisplayCal(QStringLiteral("unavailable"), {}, tools.value(QStringLiteral("error")).toString());
+            } else {
+                QStringList lines;
+                for (const QJsonValue &line : tools.value(QStringLiteral("text")).toArray()) {
+                    lines << line.toString();
+                }
+                setDisplayCal(QStringLiteral("absent"), lines, {});
+            }
+        });
+        status->start(QString::fromLatin1(s_entryAction), {QStringLiteral("status"), QStringLiteral("displaycal")});
+    }
+
+    QString m_displayCalState;
+    QStringList m_displayCalLines;
+    QString m_displayCalMessage;
     CommandOutputContext *m_outputContext;
     QVariantList m_displays;
     QVariantList m_sections;
