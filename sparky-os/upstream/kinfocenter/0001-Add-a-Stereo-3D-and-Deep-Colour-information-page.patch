+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+
+#include <QProcess>
+#include <QVariantMap>
+
+#include <KIO/ApplicationLauncherJob>
+#include <KPluginFactory>
+#include <KQuickConfigModule>
+#include <KService>
+
+#include "CommandOutputContext.h"
+
+class KCMStereo3D : public KQuickConfigModule
+{
+    Q_OBJECT
+    Q_PROPERTY(CommandOutputContext *infoOutputContext READ outputContext CONSTANT FINAL)
+    Q_PROPERTY(QVariantList displays READ displays CONSTANT FINAL)
+    Q_PROPERTY(bool displayCalInstalled READ displayCalInstalled CONSTANT FINAL)
+public:
+    explicit KCMStereo3D(QObject *parent, const KPluginMetaData &data)
+        : KQuickConfigModule(parent, data)
+    {
+        m_outputContext = new CommandOutputContext(QStringLiteral("stereo-display-info"), {}, parent);
+
+        // One line per display: connector, look-up tag, EDID MD5, manufacturer name, colour profile
+        QProcess keys;
+        keys.start(QStringLiteral("stereo-display-info"), {QStringLiteral("--keys")});
+        keys.waitForFinished(10000);
+        const QStringList lines = QString::fromUtf8(keys.readAllStandardOutput()).split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+        for (const QString &line : lines) {
+            const QStringList fields = line.split(QLatin1Char('\t'));
+            if (fields.size() < 5) {
+                continue;
+            }
+            m_displays.append(QVariantMap{{QStringLiteral("connector"), fields[0]},
+                                          {QStringLiteral("tag"), fields[1]},
+                                          {QStringLiteral("md5"), fields[2]},
+                                          {QStringLiteral("manufacturer"), fields[3]},
+                                          {QStringLiteral("profile"), fields[4]}});
+        }
+    }
+    [[nodiscard]] CommandOutputContext *outputContext() const
+    {
+        return m_outputContext;
+    }
+    [[nodiscard]] QVariantList displays() const
+    {
+        return m_displays;
+    }
+    [[nodiscard]] bool displayCalInstalled() const
+    {
+        return KService::serviceByDesktopName(QStringLiteral("displaycal")) != nullptr;
+    }
+
+    // Opens Display settings, with the output's name as the argument
+    Q_INVOKABLE void openDisplaySettings(const QString &connector)
+    {
+        QProcess::startDetached(QStringLiteral("kcmshell6"), {QStringLiteral("kcm_kscreen"), QStringLiteral("--args"), connector});
+    }
+    Q_INVOKABLE void measureDisplay()
+    {
+        if (const KService::Ptr service = KService::serviceByDesktopName(QStringLiteral("displaycal"))) {
+            auto *job = new KIO::ApplicationLauncherJob(service);
+            job->start();
+        }
+    }
+
+private:
+    CommandOutputContext *m_outputContext;
+    QVariantList m_displays;
+};
+
+K_PLUGIN_CLASS_WITH_JSON(KCMStereo3D, "kcm_stereo3d.json")
+
+#include "main.moc"
diff --git a/kcms/stereo3d/ui/main.qml b/kcms/stereo3d/ui/main.qml
