diff --git a/kcms/stereo3d/main.cpp b/kcms/stereo3d/main.cpp
new file mode 100644
index 0000000..ea37eeb
--- /dev/null
+++ b/kcms/stereo3d/main.cpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+
+#include <QProcess>
+#include <QVariantMap>
+
+#include <KIO/ApplicationLauncherJob>
+#include <KPluginFactory>
+#include <KQuickConfigModule>
+#include <KService>
+
+#include "CommandOutputContext.h"
+
+class KCMStereo3D : public KQuickConfigModule
+{
+    Q_OBJECT
+    Q_PROPERTY(CommandOutputContext *infoOutputContext READ outputContext CONSTANT FINAL)
+    Q_PROPERTY(QVariantList sections READ sections CONSTANT FINAL)
+    Q_PROPERTY(bool displayCalInstalled READ displayCalInstalled CONSTANT FINAL)
+public:
+    explicit KCMStereo3D(QObject *parent, const KPluginMetaData &data)
+        : KQuickConfigModule(parent, data)
+    {
+        m_outputContext = new CommandOutputContext(QStringLiteral("stereo-display-info"), {}, parent);
+
+        // The same text in blocks, each after a line "@@ <kind> <name>": the stack, a card or a display
+        QProcess blocks;
+        blocks.start(QStringLiteral("stereo-display-info"), {QStringLiteral("--sections")});
+        blocks.waitForFinished(30000);
+        QVariantMap section;
+        QString body;
+        const auto flush = [this, &section, &body] {
+            if (!section.isEmpty()) {
+                section[QStringLiteral("text")] = body.trimmed();
+                m_sections.append(section);
+            }
+            body.clear();
+        };
+        const QStringList text = QString::fromUtf8(blocks.readAllStandardOutput()).split(QLatin1Char('\n'));
+        for (const QString &line : text) {
+            if (line.startsWith(QLatin1String("@@ "))) {
+                flush();
+                const QStringList marker = line.split(QLatin1Char(' '));
+                section = QVariantMap{{QStringLiteral("kind"), marker.value(1)}, {QStringLiteral("name"), marker.value(2)}};
+            } else {
+                body += line + QLatin1Char('\n');
+            }
+        }
+        flush();
+
+        // One line per display: connector, look-up tag, EDID MD5, manufacturer name, colour profile
+        QProcess keys;
+        keys.start(QStringLiteral("stereo-display-info"), {QStringLiteral("--keys")});
+        keys.waitForFinished(10000);
+        const QStringList lines = QString::fromUtf8(keys.readAllStandardOutput()).split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+        for (const QString &line : lines) {
+            const QStringList fields = line.split(QLatin1Char('\t'));
+            if (fields.size() < 5) {
+                continue;
+            }
+            m_displays.append(QVariantMap{{QStringLiteral("connector"), fields[0]},
+                                          {QStringLiteral("tag"), fields[1]},
+                                          {QStringLiteral("md5"), fields[2]},
+                                          {QStringLiteral("manufacturer"), fields[3]},
+                                          {QStringLiteral("profile"), fields[4]}});
+        }
+    }
+    [[nodiscard]] CommandOutputContext *outputContext() const
+    {
+        return m_outputContext;
+    }
+    [[nodiscard]] QVariantList sections() const
+    {
+        return m_sections;
+    }
+    // The look-up tag, MD5, manufacturer and colour profile of a connector, empty when it has none
+    Q_INVOKABLE QVariantMap displayInfo(const QString &connector) const
+    {
+        for (const QVariant &display : m_displays) {
+            if (display.toMap().value(QStringLiteral("connector")) == connector) {
+                return display.toMap();
+            }
+        }
+        return {};
+    }
+    [[nodiscard]] bool displayCalInstalled() const
+    {
+        return KService::serviceByDesktopName(QStringLiteral("displaycal")) != nullptr;
+    }
+
+    // Opens Display settings, with the output's name as the argument
+    Q_INVOKABLE void openDisplaySettings(const QString &connector)
+    {
+        QProcess::startDetached(QStringLiteral("kcmshell6"), {QStringLiteral("kcm_kscreen"), QStringLiteral("--args"), connector});
+    }
+    Q_INVOKABLE void measureDisplay()
+    {
+        if (const KService::Ptr service = KService::serviceByDesktopName(QStringLiteral("displaycal"))) {
+            auto *job = new KIO::ApplicationLauncherJob(service);
+            job->start();
+        }
+    }
+
+private:
+    CommandOutputContext *m_outputContext;
+    QVariantList m_displays;
+    QVariantList m_sections;
+};
+
+K_PLUGIN_CLASS_WITH_JSON(KCMStereo3D, "kcm_stereo3d.json")
+
+#include "main.moc"
diff --git a/kcms/stereo3d/ui/main.qml b/kcms/stereo3d/ui/main.qml
new file mode 100644
index 0000000..cdd718f
--- /dev/null
+++ b/kcms/stereo3d/ui/main.qml
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+import org.kde.kquickcontrolsaddons
+import org.kde.ki18n
+
+// The command's text is the page, in sections: each display's text is followed by its own row
+// with its look-up tag and buttons. Nothing goes online until a button is pressed.
+KCM.SimpleKCM {
+    id: root
+
+    Kirigami.Theme.colorSet: Kirigami.Theme.View
+    Kirigami.Theme.inherit: false
+
+    readonly property var output: kcm.infoOutputContext
+
+    Clipboard { id: clipboard }
+
+    // The collection files a display under its maker's name, else under the three-letter ID.
+    function linuxHardwareUrl(display) {
+        const maker = display.manufacturer !== "" ? display.manufacturer : display.tag.substring(0, 3)
+        return "https://github.com/linuxhw/EDID/tree/master/Digital/" + encodeURIComponent(maker) + "/" + display.tag
+    }
+
+    actions: [
+        Kirigami.Action {
+            enabled: root.output.error === ""
+            icon.name: "edit-copy-symbolic"
+            text: KI18n.i18ndc("kinfocenter", "@action:button copies all displayed text", "Copy to Clipboard")
+            onTriggered: clipboard.content = root.output.text
+        }
+    ]
+
+    ColumnLayout {
+        spacing: Kirigami.Units.largeSpacing
+
+        Kirigami.PlaceholderMessage {
+            Layout.fillWidth: true
+            visible: root.output.ready && root.output.error !== ""
+            text: root.output.error
+            explanation: root.output.explanation
+            icon.name: "action-unavailable-symbolic"
+        }
+
+        Repeater {
+            model: kcm.sections
+
+            ColumnLayout {
+                id: section
+
+                required property var modelData
+                readonly property var info: Object.assign({connector: "", tag: "", manufacturer: "", profile: ""}, modelData.kind === "display" ? kcm.displayInfo(modelData.name) : {})
+
+                Layout.fillWidth: true
+                visible: root.output.error === ""
+                spacing: 0
+
+                Kirigami.SelectableLabel {
+                    Layout.fillWidth: true
+                    leftPadding: Kirigami.Units.largeSpacing
+                    rightPadding: Kirigami.Units.largeSpacing
+                    text: section.modelData.text
+                    font.family: "monospace"
+                    wrapMode: TextEdit.Wrap
+                }
+
+                ColumnLayout {
+                    id: row
+
+                    readonly property var info: section.info
+
+                    Layout.fillWidth: true
+                    Layout.leftMargin: Kirigami.Units.largeSpacing
+                    Layout.rightMargin: Kirigami.Units.largeSpacing
+                    Layout.bottomMargin: Kirigami.Units.largeSpacing
+                    visible: info.tag !== ""
+                    spacing: 0
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: Kirigami.Units.smallSpacing
+
+                        QQC2.Label {
+                            text: KI18n.i18nc("@label %1 is a connector name", "%1:", row.info.connector)
+                        }
+                        QQC2.TextField {
+                            readOnly: true
+                            text: row.info.tag
+                            font.family: "monospace"
+                            Layout.preferredWidth: Kirigami.Units.gridUnit * 6
+                        }
+                        QQC2.ToolButton {
+                            id: copyButton
+                            icon.name: "edit-copy-symbolic"
+                            display: QQC2.AbstractButton.IconOnly
+                            text: KI18n.i18nc("@action:button", "Copy the look-up tag")
+                            onClicked: clipboard.content = row.info.tag
+                            QQC2.ToolTip.visible: hovered
+                            QQC2.ToolTip.text: text
+                        }
+                        QQC2.Label {
+                            text: KI18n.i18nc("@label followed by the names of two websites", "Look up:")
+                        }
+                        QQC2.Button {
+                            text: KI18n.i18nc("@action:button opens a website", "linux-hardware.org")
+                            onClicked: Qt.openUrlExternally(root.linuxHardwareUrl(row.info))
+                        }
+                        QQC2.Button {
+                            text: KI18n.i18nc("@action:button opens a website", "EDID.tv")
+                            onClicked: Qt.openUrlExternally("https://edid.tv/")
+                        }
+                    }
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        visible: row.info.profile !== ""
+                        spacing: Kirigami.Units.largeSpacing
+
+                        QQC2.Label {
+                            text: KI18n.i18nc("@label", "Colour profile:")
+                        }
+                        Kirigami.UrlButton {
+                            text: row.info.profile
+                            url: ""
+                            onClicked: kcm.openDisplaySettings(row.info.connector)
+                        }
+                        Kirigami.UrlButton {
+                            visible: kcm.displayCalInstalled
+                            text: KI18n.i18nc("@action:button opens DisplayCAL", "Measure this display")
+                            url: ""
+                            onClicked: kcm.measureDisplay()
+                        }
+                        QQC2.Label {
+                            visible: !kcm.displayCalInstalled
+                            enabled: false
+                            text: KI18n.i18nc("@info", "DisplayCAL is not installed")
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
