+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+import org.kde.kquickcontrolsaddons
+import org.kde.ki18n
+
+// The command's text is the page; under it, one row per display with its look-up tag and
+// buttons. Nothing goes online until a button is pressed.
+KCM.SimpleKCM {
+    id: root
+
+    Kirigami.Theme.colorSet: Kirigami.Theme.View
+    Kirigami.Theme.inherit: false
+
+    readonly property var output: kcm.infoOutputContext
+
+    Clipboard { id: clipboard }
+
+    function linuxHardwareUrl(display) {
+        if (display.manufacturer !== "") {
+            return "https://github.com/linuxhw/EDID/tree/master/Digital/" + encodeURIComponent(display.manufacturer) + "/" + display.tag
+        }
+        return "https://github.com/search?q=repo%3Alinuxhw%2FEDID+" + display.tag + "&type=code"
+    }
+
+    actions: [
+        Kirigami.Action {
+            enabled: root.output.error === ""
+            icon.name: "edit-copy-symbolic"
+            text: KI18n.i18ndc("kinfocenter", "@action:button copies all displayed text", "Copy to Clipboard")
+            onTriggered: clipboard.content = root.output.text
+        }
+    ]
+
+    ColumnLayout {
+        spacing: Kirigami.Units.largeSpacing
+
+        Kirigami.PlaceholderMessage {
+            Layout.fillWidth: true
+            visible: root.output.ready && root.output.error !== ""
+            text: root.output.error
+            explanation: root.output.explanation
+            icon.name: "action-unavailable-symbolic"
+        }
+
+        Kirigami.SelectableLabel {
+            Layout.fillWidth: true
+            visible: root.output.error === ""
+            padding: Kirigami.Units.largeSpacing
+            text: root.output.text
+            font.family: "monospace"
+            wrapMode: TextEdit.Wrap
+        }
+
+        ColumnLayout {
+            Layout.fillWidth: true
+            Layout.margins: Kirigami.Units.largeSpacing
+            spacing: Kirigami.Units.smallSpacing
+
+            Repeater {
+                model: kcm.displays
+
+                ColumnLayout {
+                    id: row
+
+                    required property var modelData
+
+                    Layout.fillWidth: true
+                    spacing: 0
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        spacing: Kirigami.Units.smallSpacing
+
+                        QQC2.Label {
+                            text: KI18n.i18nc("@label %1 is a connector name", "%1:", row.modelData.connector)
+                        }
+                        QQC2.TextField {
+                            readOnly: true
+                            text: row.modelData.tag
+                            font.family: "monospace"
+                            Layout.preferredWidth: Kirigami.Units.gridUnit * 6
+                        }
+                        QQC2.ToolButton {
+                            id: copyButton
+                            icon.name: "edit-copy-symbolic"
+                            display: QQC2.AbstractButton.IconOnly
+                            text: KI18n.i18nc("@action:button", "Copy the look-up tag")
+                            onClicked: clipboard.content = row.modelData.tag
+                            QQC2.ToolTip.visible: hovered
+                            QQC2.ToolTip.text: text
+                        }
+                        QQC2.Label {
+                            text: KI18n.i18nc("@label followed by the names of two websites", "Look up:")
+                        }
+                        QQC2.Button {
+                            text: KI18n.i18nc("@action:button opens a website", "linux-hardware.org")
+                            onClicked: Qt.openUrlExternally(root.linuxHardwareUrl(row.modelData))
+                        }
+                        QQC2.Button {
+                            text: KI18n.i18nc("@action:button opens a website", "EDID.tv")
+                            onClicked: Qt.openUrlExternally("https://edid.tv/")
+                        }
+                    }
+
+                    RowLayout {
+                        Layout.fillWidth: true
+                        visible: row.modelData.profile !== ""
+                        spacing: Kirigami.Units.largeSpacing
+
+                        QQC2.Label {
+                            text: KI18n.i18nc("@label", "Colour profile:")
+                        }
+                        Kirigami.UrlButton {
+                            text: row.modelData.profile
+                            url: ""
+                            onClicked: kcm.openDisplaySettings(row.modelData.connector)
+                        }
+                        Kirigami.UrlButton {
+                            visible: kcm.displayCalInstalled
+                            text: KI18n.i18nc("@action:button opens DisplayCAL", "Measure this display")
+                            url: ""
+                            onClicked: kcm.measureDisplay()
+                        }
+                        QQC2.Label {
+                            visible: !kcm.displayCalInstalled
+                            enabled: false
+                            text: KI18n.i18nc("@info", "DisplayCAL is not installed")
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
