+#pragma once
+
+#include <QQuickWindow>
+#include <QRectF>
+#include <QtQmlIntegration>
+
+#include "stereofilter.h"
+
+#include <memory>
+
+/**
+ * The video of a stereoscopic 3D file in a surface under the window's, declared to the compositor
+ * as stereo content (full side by side, left eye first) so that it shows each view to its eye,
+ * while the window's own surface keeps the controls over it, the same in both eyes.
+ *
+ * Qt creates subsurfaces only above their parent, so the layer is a wl_subsurface made here and
+ * placed below the window's surface. It is only used on Wayland, when the compositor has
+ * wl_subcompositor, wp_viewporter and the stereo content declaration.
+ */
+class StereoLayer : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+    // True if the compositor offers what the layer needs
+    Q_PROPERTY(bool supported READ isSupported CONSTANT)
+    Q_PROPERTY(QQuickWindow *window READ window WRITE setWindow NOTIFY windowChanged)
+    // Where the views come from
+    Q_PROPERTY(StereoFilter *filter READ filter WRITE setFilter NOTIFY filterChanged)
+    // The layer shows the video while it is active
+    Q_PROPERTY(bool active READ isActive WRITE setActive NOTIFY activeChanged)
+    // The rectangle of one view in the window, in logical pixels
+    Q_PROPERTY(QRectF rect READ rect WRITE setRect NOTIFY rectChanged)
+public:
+    explicit StereoLayer(QObject *parent = nullptr);
+    ~StereoLayer() override;
+
+    static bool isSupported();
+
+    QQuickWindow *window() const;
+    void setWindow(QQuickWindow *window);
+    StereoFilter *filter() const;
+    void setFilter(StereoFilter *filter);
+    bool isActive() const;
+    void setActive(bool active);
+    QRectF rect() const;
+    void setRect(const QRectF &rect);
+
+    // Opens the display settings, where the 3D mode of the screen is chosen
+    Q_INVOKABLE void openDisplaySettings() const;
+
+Q_SIGNALS:
+    void windowChanged();
+    void filterChanged();
+    void activeChanged();
+    void rectChanged();
+
+private:
+    void create();
+    void destroy();
+    void draw();
+
+    struct Private;
+    std::unique_ptr<Private> d;
+};
