--- /dev/null
+++ b/src/stereolayer.cpp
@@ -0,0 +1,448 @@
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "stereolayer.h"
+
+#include <cstring>
+
+#include <QGuiApplication>
+#include <QLoggingCategory>
+#include <QPainter>
+#include <QProcess>
+#include <QtGui/qpa/qplatformwindow_p.h>
+
+#include <sys/mman.h>
+#include <unistd.h>
+#include <wayland-client.h>
+
+#include <stereo-declare.h>
+
+#include "wayland-viewporter-client-protocol.h"
+
+Q_STATIC_LOGGING_CATEGORY(DragonStereoLayer, "dragon.stereolayer")
+
+namespace
+{
+struct Globals {
+    wl_compositor *compositor{nullptr};
+    wl_subcompositor *subcompositor{nullptr};
+    wl_shm *shm{nullptr};
+    wp_viewporter *viewporter{nullptr};
+    bool stereo{false};
+};
+
+void registryGlobal(void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+    auto *globals = static_cast<Globals *>(data);
+    if (!strcmp(interface, wl_compositor_interface.name)) {
+        globals->compositor = static_cast<wl_compositor *>(wl_registry_bind(registry, name, &wl_compositor_interface, qMin(version, 4u)));
+    } else if (!strcmp(interface, wl_subcompositor_interface.name)) {
+        globals->subcompositor = static_cast<wl_subcompositor *>(wl_registry_bind(registry, name, &wl_subcompositor_interface, 1));
+    } else if (!strcmp(interface, wl_shm_interface.name)) {
+        globals->shm = static_cast<wl_shm *>(wl_registry_bind(registry, name, &wl_shm_interface, 1));
+    } else if (!strcmp(interface, wp_viewporter_interface.name)) {
+        globals->viewporter = static_cast<wp_viewporter *>(wl_registry_bind(registry, name, &wp_viewporter_interface, 1));
+    } else if (!strcmp(interface, "kde_stereo_content_manager_v1")) {
+        globals->stereo = true;
+    }
+}
+
+void registryGlobalRemove(void *, wl_registry *, uint32_t)
+{
+}
+
+const wl_registry_listener registryListener = {registryGlobal, registryGlobalRemove};
+
+wl_display *waylandDisplay()
+{
+    if (QGuiApplication::platformName() != QLatin1String("wayland")) {
+        return nullptr;
+    }
+    auto *app = qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+    return app ? app->display() : nullptr;
+}
+
+// Reads the globals on a queue of its own, so that nothing is dispatched on the queue Qt uses
+wl_registry *readGlobals(wl_display *display, wl_event_queue *queue, Globals &globals)
+{
+    auto *wrapper = static_cast<wl_display *>(wl_proxy_create_wrapper(display));
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wrapper), queue);
+    wl_registry *registry = wl_display_get_registry(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    wl_registry_add_listener(registry, &registryListener, &globals);
+    wl_display_roundtrip_queue(display, queue);
+    return registry;
+}
+
+void destroyGlobals(Globals &globals)
+{
+    if (globals.compositor) {
+        wl_compositor_destroy(globals.compositor);
+    }
+    if (globals.subcompositor) {
+        wl_subcompositor_destroy(globals.subcompositor);
+    }
+    if (globals.shm) {
+        wl_shm_destroy(globals.shm);
+    }
+    if (globals.viewporter) {
+        wp_viewporter_destroy(globals.viewporter);
+    }
+}
+
+// A buffer of the layer in shared memory, which the compositor gives back with release
+struct Buffer {
+    wl_buffer *buffer{nullptr};
+    uchar *data{nullptr};
+    size_t size{0};
+    QSize pixels;
+    bool busy{false};
+};
+
+void bufferRelease(void *data, wl_buffer *)
+{
+    static_cast<Buffer *>(data)->busy = false;
+}
+
+const wl_buffer_listener bufferListener = {bufferRelease};
+
+void destroyBuffer(Buffer &buffer)
+{
+    if (buffer.buffer) {
+        wl_buffer_destroy(buffer.buffer);
+    }
+    if (buffer.data) {
+        munmap(buffer.data, buffer.size);
+    }
+    buffer = {};
+}
+
+bool createBuffer(Buffer &buffer, wl_shm *shm, wl_event_queue *queue, const QSize &pixels)
+{
+    const int stride = pixels.width() * 4;
+    const size_t size = size_t(stride) * pixels.height();
+    const int fd = memfd_create("dragon-stereo-layer", MFD_CLOEXEC);
+    if (fd < 0) {
+        return false;
+    }
+    if (ftruncate(fd, off_t(size)) < 0) {
+        close(fd);
+        return false;
+    }
+    void *data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        close(fd);
+        return false;
+    }
+    wl_shm_pool *pool = wl_shm_create_pool(shm, fd, int(size));
+    close(fd);
+    wl_buffer *wlBuffer = wl_shm_pool_create_buffer(pool, 0, pixels.width(), pixels.height(), stride, WL_SHM_FORMAT_XRGB8888);
+    wl_shm_pool_destroy(pool);
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wlBuffer), queue);
+    buffer.buffer = wlBuffer;
+    buffer.data = static_cast<uchar *>(data);
+    buffer.size = size;
+    buffer.pixels = pixels;
+    buffer.busy = false;
+    wl_buffer_add_listener(wlBuffer, &bufferListener, &buffer);
+    return true;
+}
+}
+
+struct StereoLayer::Private {
+    QPointer<QQuickWindow> window;
+    QPointer<QVideoSink> videoSink;
+    QMetaObject::Connection frameConnection;
+    bool active{false};
+    QRectF rect;
+    QVideoFrame frame;
+
+    wl_display *display{nullptr};
+    wl_event_queue *queue{nullptr};
+    wl_registry *registry{nullptr};
+    Globals globals;
+    wl_surface *surface{nullptr};
+    wl_subsurface *subsurface{nullptr};
+    wp_viewport *viewport{nullptr};
+    Buffer buffers[2];
+    bool declared{false};
+    bool stereoInitialized{false};
+    QRectF placed;
+};
+
+bool StereoLayer::isSupported()
+{
+    static const bool supported = [] {
+        wl_display *display = waylandDisplay();
+        if (!display) {
+            return false;
+        }
+        wl_event_queue *queue = wl_display_create_queue(display);
+        Globals globals;
+        wl_registry *registry = readGlobals(display, queue, globals);
+        const bool ok = globals.compositor && globals.subcompositor && globals.shm && globals.viewporter && globals.stereo;
+        destroyGlobals(globals);
+        wl_registry_destroy(registry);
+        wl_event_queue_destroy(queue);
+        return ok;
+    }();
+    return supported;
+}
+
+StereoLayer::StereoLayer(QObject *parent)
+    : QObject(parent)
+    , d(std::make_unique<Private>())
+{
+}
+
+StereoLayer::~StereoLayer()
+{
+    destroy();
+}
+
+QQuickWindow *StereoLayer::window() const
+{
+    return d->window;
+}
+
+void StereoLayer::setWindow(QQuickWindow *window)
+{
+    if (d->window == window) {
+        return;
+    }
+    destroy();
+    d->window = window;
+    // The window has to be created with an alpha buffer for the controls to be over the layer
+    if (window && isSupported() && !window->handle()) {
+        QSurfaceFormat format = window->format();
+        format.setAlphaBufferSize(8);
+        window->setFormat(format);
+    }
+    Q_EMIT windowChanged();
+    create();
+}
+
+QVideoSink *StereoLayer::videoSink() const
+{
+    return d->videoSink;
+}
+
+void StereoLayer::setVideoSink(QVideoSink *videoSink)
+{
+    if (d->videoSink == videoSink) {
+        return;
+    }
+    QObject::disconnect(d->frameConnection);
+    d->videoSink = videoSink;
+    if (videoSink) {
+        d->frameConnection = connect(videoSink, &QVideoSink::videoFrameChanged, this, [this](const QVideoFrame &frame) {
+            if (frame.isValid()) {
+                d->frame = frame;
+                draw();
+            }
+        });
+    }
+    Q_EMIT videoSinkChanged();
+}
+
+bool StereoLayer::isActive() const
+{
+    return d->active;
+}
+
+void StereoLayer::setActive(bool active)
+{
+    active = active && isSupported();
+    if (d->active == active) {
+        return;
+    }
+    d->active = active;
+    if (active) {
+        create();
+    } else {
+        destroy();
+    }
+    Q_EMIT activeChanged();
+}
+
+QRectF StereoLayer::rect() const
+{
+    return d->rect;
+}
+
+void StereoLayer::setRect(const QRectF &rect)
+{
+    if (d->rect == rect) {
+        return;
+    }
+    d->rect = rect;
+    Q_EMIT rectChanged();
+    draw();
+}
+
+void StereoLayer::openDisplaySettings() const
+{
+    QProcess::startDetached(QStringLiteral("kcmshell6"), {QStringLiteral("kcm_kscreen")});
+}
+
+void StereoLayer::create()
+{
+    if (d->surface || !d->active || !d->window) {
+        return;
+    }
+    auto *windowInterface = d->window->nativeInterface<QNativeInterface::Private::QWaylandWindow>();
+    if (!windowInterface || !windowInterface->surface()) {
+        return;
+    }
+
+    d->display = waylandDisplay();
+    d->queue = wl_display_create_queue(d->display);
+    d->registry = readGlobals(d->display, d->queue, d->globals);
+    if (stereo_declare_wayland_init(d->display, d->queue) != 0) {
+        destroy();
+        return;
+    }
+    d->stereoInitialized = true;
+    wl_display_roundtrip_queue(d->display, d->queue);
+    if (!stereo_supported_wayland()) {
+        destroy();
+        return;
+    }
+
+    d->surface = wl_compositor_create_surface(d->globals.compositor);
+    d->subsurface = wl_subcompositor_get_subsurface(d->globals.subcompositor, d->surface, windowInterface->surface());
+    wl_subsurface_place_below(d->subsurface, windowInterface->surface());
+    // The layer changes with the frames of the video, not with those of the window
+    wl_subsurface_set_desync(d->subsurface);
+    d->viewport = wp_viewporter_get_viewport(d->globals.viewporter, d->surface);
+
+    // The window's surface keeps the pointer: the layer takes no input
+    wl_region *empty = wl_compositor_create_region(d->globals.compositor);
+    wl_surface_set_input_region(d->surface, empty);
+    wl_region_destroy(empty);
+
+    draw();
+}
+
+void StereoLayer::destroy()
+{
+    if (d->declared) {
+        stereo_remove_wayland(d->surface);
+        d->declared = false;
+    }
+    if (d->stereoInitialized) {
+        stereo_declare_wayland_finish();
+        d->stereoInitialized = false;
+    }
+    if (d->viewport) {
+        wp_viewport_destroy(d->viewport);
+        d->viewport = nullptr;
+    }
+    if (d->subsurface) {
+        wl_subsurface_destroy(d->subsurface);
+        d->subsurface = nullptr;
+    }
+    if (d->surface) {
+        wl_surface_destroy(d->surface);
+        d->surface = nullptr;
+    }
+    for (Buffer &buffer : d->buffers) {
+        destroyBuffer(buffer);
+    }
+    destroyGlobals(d->globals);
+    d->globals = {};
+    if (d->registry) {
+        wl_registry_destroy(d->registry);
+        d->registry = nullptr;
+    }
+    if (d->queue) {
+        wl_event_queue_destroy(d->queue);
+        d->queue = nullptr;
+    }
+    if (d->display) {
+        wl_display_flush(d->display);
+        d->display = nullptr;
+    }
+    d->placed = {};
+}
+
+// Puts the views of the frame into the layer, each at the size of the rectangle, side by side with
+// the left eye first: the full side by side the compositor takes
+void StereoLayer::draw()
+{
+    if (!d->surface || !d->frame.isValid() || d->rect.isEmpty()) {
+        return;
+    }
+    // Nothing is listened to on the queue of the layer but the release of buffers
+    wl_display_dispatch_queue_pending(d->display, d->queue);
+
+    const QVideoFrameFormat::StereoMode mode = d->frame.surfaceFormat().stereoMode();
+    if (mode == QVideoFrameFormat::StereoMode_None) {
+        return;
+    }
+    const qreal ratio = d->window ? d->window->devicePixelRatio() : 1;
+    const QSize view(qMax(1, qRound(d->rect.width() * ratio)), qMax(1, qRound(d->rect.height() * ratio)));
+    const QSize pixels(view.width() * 2, view.height());
+
+    Buffer *buffer = nullptr;
+    for (Buffer &candidate : d->buffers) {
+        if (candidate.buffer && candidate.pixels != pixels && !candidate.busy) {
+            destroyBuffer(candidate);
+        }
+        if (candidate.busy) {
+            continue;
+        }
+        if (!candidate.buffer && !createBuffer(candidate, d->globals.shm, d->queue, pixels)) {
+            continue;
+        }
+        if (candidate.pixels == pixels) {
+            buffer = &candidate;
+            break;
+        }
+    }
+    if (!buffer) {
+        return;
+    }
+
+    const QImage image = d->frame.toImage();
+    if (image.isNull()) {
+        return;
+    }
+    const bool sideBySide = mode == QVideoFrameFormat::StereoMode_SideBySide || mode == QVideoFrameFormat::StereoMode_SideBySideRightFirst;
+    const bool rightFirst = mode == QVideoFrameFormat::StereoMode_SideBySideRightFirst || mode == QVideoFrameFormat::StereoMode_TopBottomRightFirst;
+    const QSize half = sideBySide ? QSize(image.width() / 2, image.height()) : QSize(image.width(), image.height() / 2);
+    const QRect first(QPoint(0, 0), half);
+    const QRect second(sideBySide ? QPoint(half.width(), 0) : QPoint(0, half.height()), half);
+
+    QImage target(buffer->data, pixels.width(), pixels.height(), pixels.width() * 4, QImage::Format_RGB32);
+    QPainter painter(&target);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform);
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    painter.drawImage(QRect(QPoint(0, 0), view), image, rightFirst ? second : first);
+    painter.drawImage(QRect(QPoint(view.width(), 0), view), image, rightFirst ? first : second);
+    painter.end();
+
+    const QRectF rect = d->rect;
+    if (rect != d->placed) {
+        wl_subsurface_set_position(d->subsurface, qRound(rect.x()), qRound(rect.y()));
+        wp_viewport_set_destination(d->viewport, qRound(rect.width()), qRound(rect.height()));
+        wl_region *opaque = wl_compositor_create_region(d->globals.compositor);
+        wl_region_add(opaque, 0, 0, qRound(rect.width()), qRound(rect.height()));
+        wl_surface_set_opaque_region(d->surface, opaque);
+        wl_region_destroy(opaque);
+        d->placed = rect;
+    }
+    if (!d->declared) {
+        const int result = stereo_declare_wayland(d->surface, STEREO_SBS_FULL, STEREO_CLASS_VIDEO, STEREO_VIDEO_CURRENT);
+        if (result < 0) {
+            qCWarning(DragonStereoLayer) << "declaring the stereo content failed:" << strerror(-result);
+        } else {
+            d->declared = true;
+        }
+    }
+    buffer->busy = true;
+    wl_surface_attach(d->surface, buffer->buffer, 0, 0);
+    wl_surface_damage_buffer(d->surface, 0, 0, pixels.width(), pixels.height());
+    wl_surface_commit(d->surface);
+    wl_display_flush(d->display);
+}
