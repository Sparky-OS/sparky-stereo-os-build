From 2bd1fa722a8b74793a83ebfe217bce97e0726416 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 5 Oct 2026 21:49:08 -0300
Subject: [PATCH 1/2] Show one view of a stereoscopic 3D video

A side by side or top and bottom video (the frame packing arrangement SEI of
H.264 and H.265, Matroska's StereoMode) was shown as it is stored: both views
squeezed into one picture. QtMultimedia now tells the packing of the frames
(QVideoFrameFormat::stereoMode), and Backend exposes it.

Show the left view, stretched to the shape of a view, which is what a screen
shows, and add a 3D Video menu to the application menu with the right view and
both views as stored. The stream does not say whether its views are half or
full size, so the shape of the frame decides: a side by side frame at least 2.5
times as wide as high, or a top and bottom frame at most 1.2 times as wide as
high, holds full size views.

Needs QtMultimedia with QVideoFrameFormat::stereoMode (Qt 6.12).

Assisted-by: Claude Sonnet via Claude Code
---
 src/backend.cpp         | 34 ++++++++++++++++++++++++++
 src/backend.h           | 40 +++++++++++++++++++++---------
 src/qml/ControlsBar.qml | 20 +++++++++++++++
 src/qml/PlayerPage.qml  | 54 +++++++++++++++++++++++++++++++++++------
 4 files changed, 130 insertions(+), 18 deletions(-)

diff --git a/src/backend.cpp b/src/backend.cpp
index bf86e2f..21897aa 100644
--- a/src/backend.cpp
+++ b/src/backend.cpp
@@ -3,6 +3,7 @@
 
 #include "backend.h"
 
+#include <QtMultimedia/QVideoFrame>
 #include <QtMultimedia/QVideoSink>
 
 using namespace Qt::StringLiterals;
@@ -11,6 +12,19 @@ BackendAttachedType::BackendAttachedType(QVideoSink *videoSink, QObject *parent)
     : QObject(parent)
     , m_videoSink(videoSink)
 {
+    if (!m_videoSink) {
+        return;
+    }
+    // The packing is that of the stream, so it is read from its frames; the frames after a stop are empty and say nothing
+    connect(m_videoSink, &QVideoSink::videoFrameChanged, this, [this](const QVideoFrame &frame) {
+        if (!frame.isValid()) {
+            return;
+        }
+        if (const auto stereoMode = frame.surfaceFormat().stereoMode(); stereoMode != m_stereoMode) {
+            m_stereoMode = stereoMode;
+            Q_EMIT stereoChanged();
+        }
+    });
 }
 
 bool BackendAttachedType::isFFmpeg() const
@@ -33,6 +47,26 @@ bool BackendAttachedType::isFFmpeg() const
     return true;
 }
 
+Backend::StereoPacking BackendAttachedType::stereoPacking() const
+{
+    switch (m_stereoMode) {
+    case QVideoFrameFormat::StereoMode_SideBySide:
+    case QVideoFrameFormat::StereoMode_SideBySideRightFirst:
+        return Backend::SideBySide;
+    case QVideoFrameFormat::StereoMode_TopBottom:
+    case QVideoFrameFormat::StereoMode_TopBottomRightFirst:
+        return Backend::TopBottom;
+    case QVideoFrameFormat::StereoMode_None:
+        break;
+    }
+    return Backend::Mono;
+}
+
+bool BackendAttachedType::isStereoRightFirst() const
+{
+    return m_stereoMode == QVideoFrameFormat::StereoMode_SideBySideRightFirst || m_stereoMode == QVideoFrameFormat::StereoMode_TopBottomRightFirst;
+}
+
 BackendAttachedType *Backend::qmlAttachedProperties(QObject *object)
 {
     auto videoSink = qobject_cast<QVideoSink *>(object);
diff --git a/src/backend.h b/src/backend.h
index 0a19952..731a4cc 100644
--- a/src/backend.h
+++ b/src/backend.h
@@ -3,31 +3,49 @@
 
 #pragma once
 
+#include <QtMultimedia/QVideoFrameFormat>
 #include <QtQmlIntegration>
 
 class QVideoSink;
+class BackendAttachedType;
+
+class Backend : public QObject
+{
+    Q_OBJECT
+    QML_ATTACHED(BackendAttachedType)
+    QML_ELEMENT
+public:
+    // How the frames of a stereoscopic 3D video hold the two views
+    enum StereoPacking {
+        Mono,
+        SideBySide,
+        TopBottom,
+    };
+    Q_ENUM(StereoPacking)
+
+    using QObject::QObject;
+
+    static BackendAttachedType *qmlAttachedProperties(QObject *object);
+};
 
 class BackendAttachedType : public QObject
 {
     Q_OBJECT
     QML_ANONYMOUS
     Q_PROPERTY(bool ffmpeg READ isFFmpeg CONSTANT)
+    Q_PROPERTY(Backend::StereoPacking stereoPacking READ stereoPacking NOTIFY stereoChanged)
+    Q_PROPERTY(bool stereoRightFirst READ isStereoRightFirst NOTIFY stereoChanged)
 public:
     explicit BackendAttachedType(QVideoSink *videoSink, QObject *parent = nullptr);
 
     [[nodiscard]] bool isFFmpeg() const;
+    [[nodiscard]] Backend::StereoPacking stereoPacking() const;
+    [[nodiscard]] bool isStereoRightFirst() const;
+
+Q_SIGNALS:
+    void stereoChanged();
 
 private:
     QVideoSink *m_videoSink;
-};
-
-class Backend : public QObject
-{
-    Q_OBJECT
-    QML_ATTACHED(BackendAttachedType)
-    QML_ELEMENT
-public:
-    using QObject::QObject;
-
-    static BackendAttachedType *qmlAttachedProperties(QObject *object);
+    QVideoFrameFormat::StereoMode m_stereoMode = QVideoFrameFormat::StereoMode_None;
 };
