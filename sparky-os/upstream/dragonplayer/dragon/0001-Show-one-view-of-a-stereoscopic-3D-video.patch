+        // The part of the video that is shown: all of it, or one view of a stereoscopic 3D video, which
+        // is half of its frame stretched to the shape of a view. A stream does not say whether its views
+        // are half or full size, so the shape of the frame decides: a frame at least 2.5 times as wide
+        // as high holds two full size views side by side, one at most 1.2 times as wide as high holds two
+        // full size views on top of each other.
+        Item {
+            id: videoView
+
+            readonly property bool oneView: videoPage.stereo && videoPage.stereoView !== PlayerPage.BothViews
+            readonly property bool sideBySide: video.videoSink.Backend.stereoPacking === Dragon.Backend.SideBySide
+            readonly property real frameAspect: video.sourceRect.height > 0 ? video.sourceRect.width / video.sourceRect.height : 1
+            readonly property bool fullSizeViews: sideBySide ? frameAspect >= 2.5 : frameAspect <= 1.2
+            readonly property real viewAspect: sideBySide ? (fullSizeViews ? frameAspect / 2 : frameAspect)
+                                                          : (fullSizeViews ? frameAspect * 2 : frameAspect)
+            readonly property real viewWidth: Math.min(videoContainer.width, videoContainer.height * viewAspect)
+            readonly property real viewHeight: Math.min(videoContainer.height, videoContainer.width / viewAspect)
+            // Which half of the frame holds the view that is shown
+            readonly property int slot: (videoPage.stereoView === PlayerPage.RightView) !== video.videoSink.Backend.stereoRightFirst ? 1 : 0
+            readonly property real contentWidth: oneView ? width : video.contentRect.width
+
+            clip: oneView
+            width: oneView ? viewWidth : videoContainer.width
+            height: oneView ? viewHeight : videoContainer.height
+            x: (videoContainer.width - width) / 2
+            y: (videoContainer.height - height) / 2
+
