@@ -125,6 +125,35 @@
             visible: video.stereoLayerFailure.length > 0
             text: i18nc("@info %1 is the reason the desktop gave", "This video is shown flat: the desktop refused to show it in 3D (%1).", video.stereoLayerFailure)
         }
+
+        Kirigami.InlineMessage {
+            id: noSoundMessage
+            Layout.fillWidth: true
+            type: Kirigami.MessageType.Information
+            showCloseButton: true
+            position: Kirigami.InlineMessage.Position.Header
+            text: Stereo.NoSound.text
+
+            // Said when the film is loaded and has a picture and no audio track (the layer's rule), for a while, and gone when the next film has sound
+            readonly property bool filmHasNoSound: Stereo.NoSound.saysFor(
+                player.mediaStatus === Multimedia.MediaPlayer.LoadedMedia
+                    || player.mediaStatus === Multimedia.MediaPlayer.BufferingMedia
+                    || player.mediaStatus === Multimedia.MediaPlayer.BufferedMedia
+                    || player.mediaStatus === Multimedia.MediaPlayer.StalledMedia,
+                player.hasVideo, player.audioTracks.length)
+            onFilmHasNoSoundChanged: {
+                visible = filmHasNoSound
+                if (filmHasNoSound) {
+                    noSoundTimer.restart()
+                }
+            }
+
+            Timer {
+                id: noSoundTimer
+                interval: 8000
+                onTriggered: noSoundMessage.visible = false
+            }
+        }
     }
 
     function cancelFullscreen() {
