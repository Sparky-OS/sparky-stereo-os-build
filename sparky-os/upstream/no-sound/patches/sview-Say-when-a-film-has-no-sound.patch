+    // A film with a picture and no audio track says so for a few seconds when it is loaded (the volume control stays usable
+    // and says so under the cursor), ORDER 579
+    if(myNoSound != NULL) {
+        const bool aNoSound = myPlugin->myVideo.get() != NULL
+                           && myPlugin->myVideo->hasVideoStream()
+                           && !myPlugin->myVideo->hasAudioStream();
+        const double aNow = double(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       std::chrono::steady_clock::now().time_since_epoch()).count());
+        if(aNoSound != myNoSoundLast) {
+            myNoSoundLast  = aNoSound;
+            myNoSoundUntil = aNoSound ? aNow + 6000.0 : 0.0;
+        }
+        if(aNoSound && aNow < myNoSoundUntil) {
+            myNoSound->setText(tr(NO_SOUND));
+            myNoSound->setPoint(StPointD_t(0.97, 0.9));
+            myNoSound->setOpacity(1.0f, false);
+        } else {
+            myNoSound->setText("");
+            myNoSound->setOpacity(0.0f, false);
