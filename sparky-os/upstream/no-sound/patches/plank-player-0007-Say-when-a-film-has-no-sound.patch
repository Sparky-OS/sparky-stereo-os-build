Description: Say that a film has no sound when it has a picture and no audio track: a banner for a few seconds and a line in the OSD, in the ten languages.
Author: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Origin: other, Sparky Stereo OS (ORDER 579)
Forwarded: not-needed
Last-Update: 2026-11-15
Assisted-by: Claude Sonnet 5.5 via Claude Code

--- a/app/qml/main.qml
+++ b/app/qml/main.qml
@@ -114,11 +114,50 @@
             }
         }
 
+        Rectangle {
+            id: noSoundBanner
+            // the film is loaded, has a picture and no audio track (Stereo::NoSound::applies in the edition's stereo layer, ORDER 579)
+            readonly property bool filmHasNoSound: (video.mediaStatus === MediaPlayer.LoadedMedia
+                                                    || video.mediaStatus === MediaPlayer.BufferedMedia
+                                                    || video.mediaStatus === MediaPlayer.BufferingMedia
+                                                    || video.mediaStatus === MediaPlayer.StalledMedia)
+                                                   && video.hasVideo && !video.hasAudio
+            property bool told: false
+            onFilmHasNoSoundChanged: {
+                told = filmHasNoSound
+                if (filmHasNoSound) {
+                    noSoundTimer.restart()
+                }
+            }
+            visible: told
+            anchors.top: stereoLayerFailureBanner.visible ? stereoLayerFailureBanner.bottom : parent.top
+            anchors.left: parent.left
+            anchors.right: parent.right
+            height: noSoundText.implicitHeight + 16
+            color: Kirigami.Theme.neutralBackgroundColor
+            border.color: Kirigami.Theme.neutralTextColor
+            border.width: 1
+            Timer {
+                id: noSoundTimer
+                interval: 8000
+                onTriggered: noSoundBanner.told = false
+            }
+            Controls.Label {
+                id: noSoundText
+                anchors.fill: parent
+                anchors.margins: 8
+                wrapMode: Text.WordWrap
+                color: Kirigami.Theme.textColor
+                text: i18nc("@info", "This film has no sound.")
+            }
+        }
+
         PlayerOSD {
             id: playerOSDItem
             anchors.bottom: parent.bottom
             height: parent.height * 0.10
             videoItem: video
+            noSound: noSoundBanner.filmHasNoSound
             menuOpened: mainMenu.opened || stereoMenu.opened
         }
     }
--- a/app/qml/PlayerOSD.qml
+++ b/app/qml/PlayerOSD.qml
@@ -16,6 +16,8 @@
     property bool menuOpened
     property var videoItem
     property bool pinned: false
+    // the film has a picture and no audio track: the OSD says so beside its buttons (ORDER 579)
+    property bool noSound: false
 
     onOpenedChanged: {
         if(opened){
@@ -106,6 +108,15 @@
                 }
             }
 
+            Controls.Label {
+                id: noSoundLabel
+                visible: osdControlsArea.noSound
+                text: i18nc("@info", "This film has no sound.")
+                color: Kirigami.Theme.textColor
+                elide: Text.ElideRight
+                Layout.maximumWidth: parent.width * 0.3
+            }
+
             SeekBar {
                 id: osdSeekBar
                 Layout.fillWidth: true
