@@ -673,6 +678,29 @@
 
     Q_EMIT audioTracksModelChanged();
     Q_EMIT subtitleTracksModelChanged();
+
+    // A film with a picture and no audio track says so, once when it is loaded (ORDER 579)
+    const bool noSound = hasPicture && ar == 0;
+    if (noSound != m_filmHasNoSound) {
+        m_filmHasNoSound = noSound;
+        Q_EMIT filmHasNoSoundChanged();
+    }
+    if (noSound && m_noSoundToldFor != m_currentUrl) {
+        m_noSoundToldFor = m_currentUrl;
+        Q_EMIT osdMessage(noSoundText());
+    } else if (!noSound) {
+        m_noSoundToldFor.clear();
+    }
+}
+
+bool MpvItem::filmHasNoSound() const
+{
+    return m_filmHasNoSound;
+}
+
+QString MpvItem::noSoundText() const
+{
+    return i18nc("@info:tooltip osd; a film that has a picture and no audio track", "This film has no sound.");
