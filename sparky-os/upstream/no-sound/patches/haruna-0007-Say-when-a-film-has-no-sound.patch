+    // A film with a picture and no audio track says so once when it is loaded (ORDER 579): the stereo layer's rule and sentence
+    property url noSoundToldFor
+    onCurrentUrlChanged: noSoundToldFor = ""
+    onTracksLoaded: function(hasPicture, audioTracks) {
+        const noSound = Stereo.NoSound.saysFor(true, hasPicture, audioTracks)
+        root.filmHasNoSound = noSound
+        if (noSound && noSoundToldFor !== root.currentUrl) {
+            noSoundToldFor = root.currentUrl
+            osd.message(Stereo.NoSound.text)
+        }
+    }
+
