diff --git a/3d-viewer/common_ogl/ogl_attr_list.cpp b/3d-viewer/common_ogl/ogl_attr_list.cpp
index 45c5360e..f16cc961 100644
--- a/3d-viewer/common_ogl/ogl_attr_list.cpp
