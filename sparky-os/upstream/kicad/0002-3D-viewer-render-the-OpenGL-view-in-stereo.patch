@@ -33,14 +33,18 @@
 
 
 const wxGLAttributes OGL_ATT_LIST::GetAttributesList( ANTIALIASING_MODE aAntiAliasingMode,
-                                                      bool              aAlpha )
+                                                      bool              aAlpha,
+                                                      bool              aStereo )
 {
     wxASSERT( aAntiAliasingMode <= ANTIALIASING_MODE::AA_8X );
 
-    auto makeAttribs = [aAlpha]( int aSamplers )
+    auto makeAttribs = [aAlpha]( int aSamplers, bool aWithStereo )
     {
         wxGLAttributes dispAttrs;
 
+        if( aWithStereo )
+            dispAttrs.Stereo();
+
         dispAttrs.RGBA()
                 .DoubleBuffer()
                 .Depth( 16 )
@@ -53,24 +57,27 @@ const wxGLAttributes OGL_ATT_LIST::GetAttributesList( ANTIALIASING_MODE aAntiAli
         return dispAttrs;
     };
 
+    // Fall back to a mono visual when the display does not offer a stereo one
+    const bool stereo = aStereo && wxGLCanvas::IsDisplaySupported( makeAttribs( -1, true ) );
+
     int maxSamples = -1;
 
     if( aAntiAliasingMode > ANTIALIASING_MODE::AA_NONE )
     {
         // Check if the canvas supports multisampling.
-        if( wxGLCanvas::IsDisplaySupported( makeAttribs( 0 ) ) )
+        if( wxGLCanvas::IsDisplaySupported( makeAttribs( 0, stereo ) ) )
         {
             static const int aaSamples[4] = { 0, 2, 4, 8 };
 
             // Check for possible sample sizes, start form the requested.
             maxSamples = aaSamples[static_cast<int>( aAntiAliasingMode )];
 
-            while( maxSamples > 0 && !wxGLCanvas::IsDisplaySupported( makeAttribs( maxSamples ) ) )
+            while( maxSamples > 0 && !wxGLCanvas::IsDisplaySupported( makeAttribs( maxSamples, stereo ) ) )
             {
                 maxSamples = maxSamples >> 1;
             }
         }
     }
 
-    return makeAttribs( maxSamples );
+    return makeAttribs( maxSamples, stereo );
 }
