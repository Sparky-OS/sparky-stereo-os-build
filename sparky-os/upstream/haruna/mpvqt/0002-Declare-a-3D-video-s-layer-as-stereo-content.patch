+    connect(d_ptr->m_mpvController, &MpvController::videoReconfig, this, [this]() {
+        d_ptr->updateVideoParams();
+    });
+    connect(this, &QQuickItem::widthChanged, this, [this]() {
+        d_ptr->updateVideoRect();
+    });
+    connect(this, &QQuickItem::heightChanged, this, [this]() {
+        d_ptr->updateVideoRect();
+    });
+
     connect(d_ptr->m_workerThread, &QThread::finished, d_ptr->m_mpvController, &MpvController::deleteLater);
 
     d_ptr->m_mpvController->moveToThread(d_ptr->m_workerThread);
@@ -85,6 +128,7 @@ void MpvAbstractItem::setVideoLayer(bool videoLayer)
     }
