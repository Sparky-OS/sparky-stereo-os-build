@@ -61,11 +68,87 @@ void MpvRenderer::synchronize(QQuickFramebufferObject *item)
 
         Q_EMIT mpvAItem->ready();
     }
+
+    m_videoLayerWanted = mpvAItem->d_ptr->m_videoLayer;
+    m_window = mpvAItem->window();
+    if (m_videoLayerWanted && m_window) {
+        // The surface of the window holds its frame, if the window has one
+        const QPoint origin = mpvAItem->mapToScene(QPointF(0, 0)).toPoint() + QPoint(m_window->frameMargins().left(), m_window->frameMargins().top());
