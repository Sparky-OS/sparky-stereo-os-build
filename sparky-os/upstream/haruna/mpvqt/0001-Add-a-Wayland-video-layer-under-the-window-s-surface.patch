+#define MPVVIDEOLAYER_H
+
+#include <memory>
+
+#include <QRect>
+#include <QSize>
+
+class QWindow;
+
+/**
+ * A surface under the surface of a Wayland window that holds the video, so that the window's
+ * surface can keep the controls with alpha over it.
+ *
+ * The layer is a synchronised subsurface placed below the window's surface, with an EGL surface
+ * of its own on the OpenGL context of the Qt Quick scene graph. All functions except
+ * isSupported() must be called on the render thread, with that context current.
+ */
+class MpvVideoLayer
+{
+public:
+    // True if the platform is Wayland and the compositor offers what the layer needs
+    static bool isSupported();
+    static std::unique_ptr<MpvVideoLayer> create(QWindow *window);
+
+    ~MpvVideoLayer();
+
+    // The rectangle of the video in the window, in logical pixels, and the window's scale
+    void resize(const QRect &rect, qreal devicePixelRatio);
+    QSize bufferSize() const;
+
+    // Draws into the layer's surface until swapBuffers(), which shows it with the window's next frame
+    void makeCurrent();
+    void swapBuffers();
+
+private:
+    MpvVideoLayer();
+
+    struct Private;
+    std::unique_ptr<Private> d;
+};
+
+#endif // MPVVIDEOLAYER_H
