diff --git a/src/mpvvideolayer.cpp b/src/mpvvideolayer.cpp
new file mode 100644
index 0000000..95125c4
--- /dev/null
+++ b/src/mpvvideolayer.cpp
@@ -0,0 +1,257 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+ *
+ * SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+ */
+
+#include "mpvvideolayer.h"
+
+#include <QGuiApplication>
+#include <QLoggingCategory>
+#include <QOpenGLContext>
+#include <QtGui/qpa/qplatformwindow_p.h>
+#include <QWindow>
+
+#include <EGL/egl.h>
+#include <wayland-client.h>
+#include <wayland-egl.h>
+
+#include "wayland-viewporter-client-protocol.h"
+
+Q_STATIC_LOGGING_CATEGORY(MpvQt_MpvVideoLayer, "MpvQt.MpvVideoLayer")
+
+namespace
+{
+struct Globals {
+    wl_compositor *compositor{nullptr};
+    wl_subcompositor *subcompositor{nullptr};
+    wp_viewporter *viewporter{nullptr};
+    bool stereo{false};
+};
+
+void registryGlobal(void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+    auto *globals = static_cast<Globals *>(data);
+    if (!strcmp(interface, wl_compositor_interface.name)) {
+        globals->compositor = static_cast<wl_compositor *>(wl_registry_bind(registry, name, &wl_compositor_interface, qMin(version, 4u)));
+    } else if (!strcmp(interface, wl_subcompositor_interface.name)) {
+        globals->subcompositor = static_cast<wl_subcompositor *>(wl_registry_bind(registry, name, &wl_subcompositor_interface, 1));
+    } else if (!strcmp(interface, wp_viewporter_interface.name)) {
+        globals->viewporter = static_cast<wp_viewporter *>(wl_registry_bind(registry, name, &wp_viewporter_interface, 1));
+    } else if (!strcmp(interface, "kde_stereo_content_manager_v1")) {
+        globals->stereo = true;
+    }
+}
+
+void registryGlobalRemove(void *, wl_registry *, uint32_t)
+{
+}
+
+const wl_registry_listener registryListener = {registryGlobal, registryGlobalRemove};
+
+wl_display *waylandDisplay()
+{
+    if (QGuiApplication::platformName() != QLatin1String("wayland")) {
+        return nullptr;
+    }
+    auto *app = qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+    return app ? app->display() : nullptr;
+}
+
+// Reads the globals on a queue of its own, so that nothing is dispatched on the queue Qt uses
+void readGlobals(wl_display *display, wl_event_queue *queue, Globals &globals, wl_registry **registryOut)
+{
+    auto *wrapper = static_cast<wl_display *>(wl_proxy_create_wrapper(display));
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wrapper), queue);
+    wl_registry *registry = wl_display_get_registry(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    wl_registry_add_listener(registry, &registryListener, &globals);
+    wl_display_roundtrip_queue(display, queue);
+    *registryOut = registry;
+}
+}
+
+struct MpvVideoLayer::Private {
+    wl_display *display{nullptr};
+    wl_event_queue *queue{nullptr};
+    wl_registry *registry{nullptr};
+    Globals globals;
+    wl_surface *surface{nullptr};
+    wl_subsurface *subsurface{nullptr};
+    wp_viewport *viewport{nullptr};
+    wl_egl_window *eglWindow{nullptr};
+    EGLDisplay eglDisplay{EGL_NO_DISPLAY};
+    EGLContext eglContext{EGL_NO_CONTEXT};
+    EGLSurface eglSurface{EGL_NO_SURFACE};
+    EGLSurface previousDraw{EGL_NO_SURFACE};
+    EGLSurface previousRead{EGL_NO_SURFACE};
+    QRect rect;
+    QSize bufferSize;
+};
+
+bool MpvVideoLayer::isSupported()
+{
+    static const bool supported = [] {
+        wl_display *display = waylandDisplay();
+        if (!display) {
+            return false;
+        }
+        wl_event_queue *queue = wl_display_create_queue(display);
+        Globals globals;
+        wl_registry *registry = nullptr;
+        readGlobals(display, queue, globals, &registry);
+        const bool ok = globals.compositor && globals.subcompositor && globals.viewporter && globals.stereo;
+        if (globals.compositor) {
+            wl_compositor_destroy(globals.compositor);
+        }
+        if (globals.subcompositor) {
+            wl_subcompositor_destroy(globals.subcompositor);
+        }
+        if (globals.viewporter) {
+            wp_viewporter_destroy(globals.viewporter);
+        }
+        wl_registry_destroy(registry);
+        wl_event_queue_destroy(queue);
+        return ok;
+    }();
+    return supported;
+}
+
+MpvVideoLayer::MpvVideoLayer()
+    : d(std::make_unique<Private>())
+{
+}
+
+std::unique_ptr<MpvVideoLayer> MpvVideoLayer::create(QWindow *window)
+{
+    QOpenGLContext *context = QOpenGLContext::currentContext();
+    auto *windowInterface = window ? window->nativeInterface<QNativeInterface::Private::QWaylandWindow>() : nullptr;
+    auto *eglInterface = context ? context->nativeInterface<QNativeInterface::QEGLContext>() : nullptr;
+    if (!windowInterface || !windowInterface->surface() || !eglInterface || !isSupported()) {
+        return nullptr;
+    }
+
+    std::unique_ptr<MpvVideoLayer> layer(new MpvVideoLayer);
+    Private *p = layer->d.get();
+    p->display = waylandDisplay();
+    p->queue = wl_display_create_queue(p->display);
+    readGlobals(p->display, p->queue, p->globals, &p->registry);
+    if (!p->globals.compositor || !p->globals.subcompositor || !p->globals.viewporter) {
+        return nullptr;
+    }
+
+    p->surface = wl_compositor_create_surface(p->globals.compositor);
+    p->subsurface = wl_subcompositor_get_subsurface(p->globals.subcompositor, p->surface, windowInterface->surface());
+    wl_subsurface_place_below(p->subsurface, windowInterface->surface());
+    wl_subsurface_set_sync(p->subsurface);
+    p->viewport = wp_viewporter_get_viewport(p->globals.viewporter, p->surface);
+
+    // The window's surface keeps the pointer: the layer takes no input
+    wl_region *empty = wl_compositor_create_region(p->globals.compositor);
+    wl_surface_set_input_region(p->surface, empty);
+    wl_region_destroy(empty);
+
+    p->eglDisplay = eglInterface->display();
+    p->eglContext = eglInterface->nativeContext();
+    EGLint configId = 0;
+    EGLConfig config = nullptr;
+    EGLint count = 0;
+    eglQueryContext(p->eglDisplay, p->eglContext, EGL_CONFIG_ID, &configId);
+    const EGLint attributes[] = {EGL_CONFIG_ID, configId, EGL_NONE};
+    if (!eglChooseConfig(p->eglDisplay, attributes, &config, 1, &count) || count < 1) {
+        qCWarning(MpvQt_MpvVideoLayer) << "no EGL config for the video layer";
+        return nullptr;
+    }
+
+    p->bufferSize = QSize(1, 1);
+    p->eglWindow = wl_egl_window_create(p->surface, 1, 1);
+    p->eglSurface = eglCreateWindowSurface(p->eglDisplay, config, reinterpret_cast<EGLNativeWindowType>(p->eglWindow), nullptr);
+    if (p->eglSurface == EGL_NO_SURFACE) {
+        qCWarning(MpvQt_MpvVideoLayer) << "creating the EGL surface of the video layer failed";
+        return nullptr;
+    }
+
+    // The swap must not wait for a frame callback: the layer is shown with the window's frame
+    const EGLSurface draw = eglGetCurrentSurface(EGL_DRAW);
+    const EGLSurface read = eglGetCurrentSurface(EGL_READ);
+    eglMakeCurrent(p->eglDisplay, p->eglSurface, p->eglSurface, p->eglContext);
+    eglSwapInterval(p->eglDisplay, 0);
+    eglMakeCurrent(p->eglDisplay, draw, read, p->eglContext);
+    return layer;
+}
+
+MpvVideoLayer::~MpvVideoLayer()
+{
+    if (d->eglSurface != EGL_NO_SURFACE) {
+        eglDestroySurface(d->eglDisplay, d->eglSurface);
+    }
+    if (d->eglWindow) {
+        wl_egl_window_destroy(d->eglWindow);
+    }
+    if (d->viewport) {
+        wp_viewport_destroy(d->viewport);
+    }
+    if (d->subsurface) {
+        wl_subsurface_destroy(d->subsurface);
+    }
+    if (d->surface) {
+        wl_surface_destroy(d->surface);
+    }
+    if (d->globals.compositor) {
+        wl_compositor_destroy(d->globals.compositor);
+    }
+    if (d->globals.subcompositor) {
+        wl_subcompositor_destroy(d->globals.subcompositor);
+    }
+    if (d->globals.viewporter) {
+        wp_viewporter_destroy(d->globals.viewporter);
+    }
+    if (d->registry) {
+        wl_registry_destroy(d->registry);
+    }
+    if (d->queue) {
+        wl_event_queue_destroy(d->queue);
+    }
+    wl_display_flush(d->display);
+}
+
+void MpvVideoLayer::resize(const QRect &rect, qreal devicePixelRatio)
+{
+    // Nothing is listened to on the queue of the layer, keep it empty
+    wl_display_dispatch_queue_pending(d->display, d->queue);
+
+    const QSize size(qMax(1, qRound(rect.width() * devicePixelRatio)), qMax(1, qRound(rect.height() * devicePixelRatio)));
+    if (rect.topLeft() != d->rect.topLeft()) {
+        wl_subsurface_set_position(d->subsurface, rect.x(), rect.y());
+    }
+    if (rect.size() != d->rect.size()) {
+        wp_viewport_set_destination(d->viewport, rect.width(), rect.height());
+        wl_region *opaque = wl_compositor_create_region(d->globals.compositor);
+        wl_region_add(opaque, 0, 0, rect.width(), rect.height());
+        wl_surface_set_opaque_region(d->surface, opaque);
+        wl_region_destroy(opaque);
+    }
+    if (size != d->bufferSize) {
+        wl_egl_window_resize(d->eglWindow, size.width(), size.height(), 0, 0);
+        d->bufferSize = size;
+    }
+    d->rect = rect;
+}
+
+QSize MpvVideoLayer::bufferSize() const
+{
+    return d->bufferSize;
+}
+
+void MpvVideoLayer::makeCurrent()
+{
+    d->previousDraw = eglGetCurrentSurface(EGL_DRAW);
+    d->previousRead = eglGetCurrentSurface(EGL_READ);
+    eglMakeCurrent(d->eglDisplay, d->eglSurface, d->eglSurface, d->eglContext);
+}
+
+void MpvVideoLayer::swapBuffers()
+{
+    eglSwapBuffers(d->eglDisplay, d->eglSurface);
+    eglMakeCurrent(d->eglDisplay, d->previousDraw, d->previousRead, d->eglContext);
+}
