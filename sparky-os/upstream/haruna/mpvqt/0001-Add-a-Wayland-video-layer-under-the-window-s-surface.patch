+
+void MpvRenderer::setVideoLayerActive(bool active)
+{
+    QPointer<MpvAbstractItem> item = m_mpvAItem;
+    QMetaObject::invokeMethod(
+        item.data(),
+        [item, active]() {
+            if (item && item->d_ptr->m_videoLayerActive != active) {
+                item->d_ptr->m_videoLayerActive = active;
+                Q_EMIT item->videoLayerActiveChanged();
+            }
+        },
+        Qt::QueuedConnection);
+}
+
+// Draws the video into the video layer instead of the item: the layer goes to the compositor
+// with the next frame of the window, the item stays transparent.
+bool MpvRenderer::renderVideoLayer(QOpenGLFramebufferObject *fbo)
+{
+#ifdef HAVE_VIDEO_LAYER
+    if (!m_videoLayerWanted) {
+        if (m_videoLayer) {
+            m_videoLayer.reset();
+            setVideoLayerActive(false);
+        }
+        return false;
+    }
+    if (!m_videoLayer && !m_videoLayerFailed) {
+        m_videoLayer = MpvVideoLayer::create(m_window);
+        m_videoLayerFailed = !m_videoLayer;
+        setVideoLayerActive(!m_videoLayerFailed);
+    }
+    if (!m_videoLayer) {
+        return false;
+    }
+
+    m_videoLayer->resize(m_videoRect, m_devicePixelRatio);
+
+    QOpenGLFunctions *gl = QOpenGLContext::currentContext()->functions();
+    gl->glClearColor(0, 0, 0, 0);
+    gl->glClear(GL_COLOR_BUFFER_BIT);
+
+    m_videoLayer->makeCurrent();
+    const QSize size = m_videoLayer->bufferSize();
+    mpv_opengl_fbo mpfbo;
+    mpfbo.fbo = 0;
+    mpfbo.w = size.width();
+    mpfbo.h = size.height();
+    mpfbo.internal_format = 0;
+    // the default framebuffer of a window surface has its origin at the bottom
+    int flip_y{1};
+    mpv_render_param params[] = {{MPV_RENDER_PARAM_OPENGL_FBO, &mpfbo}, {MPV_RENDER_PARAM_FLIP_Y, &flip_y}, {MPV_RENDER_PARAM_INVALID, nullptr}};
+    int result = mpv_render_context_render(m_mpvResourceManager->mpvRenderContext, params);
+    if (result < 0) {
+        qCWarning(MpvQt_MpvRenderer) << "mpv_render_context_render failed:" << MpvController::getError(result);
+    }
+    m_videoLayer->swapBuffers();
+    fbo->bind();
+    return true;
+#else
+    Q_UNUSED(fbo)
+    return false;
+#endif
 }
 
 void MpvRenderer::render()
 {
     QOpenGLFramebufferObject *fbo = framebufferObject();
+    if (renderVideoLayer(fbo)) {
+        return;
+    }
     mpv_opengl_fbo mpfbo;
     mpfbo.fbo = static_cast<int>(fbo->handle());
     mpfbo.w = fbo->width();
