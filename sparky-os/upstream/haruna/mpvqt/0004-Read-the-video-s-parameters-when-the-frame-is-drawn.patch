+        stereo = m_videoState->stereo;
+        depth = m_videoState->depth;
+        videoSize = m_videoState->size;
+    }
+    m_videoLayer->setDepth(depth);
+    m_videoLayer->resize(MpvVideoState::viewRect(m_itemSize, stereo, videoSize).translated(m_origin), m_devicePixelRatio, stereo);
+
     m_videoLayer->makeCurrent();
     if (!m_mpvResourceManager->mpvRenderContext) {
         m_mpvResourceManager->mpvRenderContext = createMpvRenderContext();
@@ -160,10 +171,10 @@ bool MpvRenderer::renderVideoLayer(QOpenGLFramebufferObject *fbo)
     mpfbo.internal_format = m_videoLayer->internalFormat();
     // the default framebuffer of a window surface has its origin at the bottom
     int flip_y{1};
-    int depth = m_videoLayer->surfaceDepth();
+    int surfaceDepth = m_videoLayer->surfaceDepth();
     mpv_render_param params[] = {{MPV_RENDER_PARAM_OPENGL_FBO, &mpfbo},
