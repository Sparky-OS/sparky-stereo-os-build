+namespace
+{
+struct LayerConfig {
+    EGLConfig config;
+    int depth; // bits per channel, 16 for half float
+};
+
+// The configs for the layer of a video of this many bits per channel, the deepest the display offers
+// up to it first, among those the context can draw into. The config of the context itself is the last.
+std::vector<LayerConfig> layerConfigs(EGLDisplay display, EGLConfig contextConfig, int depth)
+{
+    std::vector<LayerConfig> result;
+    if (depth > 8) {
+        EGLint renderable = 0;
+        eglGetConfigAttrib(display, contextConfig, EGL_RENDERABLE_TYPE, &renderable);
+        EGLint count = 0;
+        eglGetConfigs(display, nullptr, 0, &count);
+        std::vector<EGLConfig> configs(count);
+        eglGetConfigs(display, configs.data(), count, &count);
+        const char *extensions = eglQueryString(display, EGL_EXTENSIONS);
+        const bool floatConfigs = extensions && strstr(extensions, "EGL_EXT_pixel_format_float");
+
+        std::vector<LayerConfig> half;
+        std::vector<LayerConfig> ten;
+        for (int i = 0; i < count; ++i) {
+            EGLint surfaceType = 0;
+            EGLint configRenderable = 0;
+            EGLint red = 0;
+            EGLint green = 0;
+            EGLint blue = 0;
+            EGLint type = EGL_COLOR_COMPONENT_TYPE_FIXED_EXT;
+            eglGetConfigAttrib(display, configs[i], EGL_SURFACE_TYPE, &surfaceType);
+            eglGetConfigAttrib(display, configs[i], EGL_RENDERABLE_TYPE, &configRenderable);
+            eglGetConfigAttrib(display, configs[i], EGL_RED_SIZE, &red);
+            eglGetConfigAttrib(display, configs[i], EGL_GREEN_SIZE, &green);
+            eglGetConfigAttrib(display, configs[i], EGL_BLUE_SIZE, &blue);
+            if (floatConfigs) {
+                eglGetConfigAttrib(display, configs[i], EGL_COLOR_COMPONENT_TYPE_EXT, &type);
+            }
+            if (!(surfaceType & EGL_WINDOW_BIT) || (configRenderable & renderable) != renderable || red != green || red != blue) {
+                continue;
+            }
+            if (type == EGL_COLOR_COMPONENT_TYPE_FLOAT_EXT && red == 16) {
+                half.push_back({configs[i], 16});
+            } else if (type == EGL_COLOR_COMPONENT_TYPE_FIXED_EXT && red == 10) {
+                ten.push_back({configs[i], 10});
+            }
+        }
+        if (depth > 10) {
+            result.insert(result.end(), half.begin(), half.end());
+        }
+        result.insert(result.end(), ten.begin(), ten.end());
+    }
+    result.push_back({contextConfig, 8});
+    return result;
+}
+}
