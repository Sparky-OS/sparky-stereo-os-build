+
+void MpvVideoLayer::setDepth(int depth)
+{
+    if (depth == d->depth) {
+        return;
+    }
+    d->depth = depth;
+
+    // The first the context can draw into, the display may not take the format of every config
+    int chosen = 8;
+    for (const LayerConfig &candidate : layerConfigs(d->eglDisplay, d->contextConfig, depth)) {
+        if (createSurface(candidate.config)) {
+            chosen = candidate.depth;
+            break;
+        }
+    }
+    // mpv dithers to the depth of the framebuffer it is told about
+    constexpr int rgb10A2 = 0x8059;
+    constexpr int rgba16F = 0x881A;
+    d->surfaceDepth = chosen;
+    d->internalFormat = chosen == 16 ? rgba16F : chosen == 10 ? rgb10A2 : 0;
+    qCDebug(MpvQt_MpvVideoLayer) << "video layer depth" << chosen << "for a video of" << depth << "bits";
+}
