+// The bits per channel in the name of a pixel format of mpv: yuv420p10, p010, gbrp16, rgb48, x2rgb10, gbrapf32
+static int pixelFormatDepth(const QString &name)
+{
+    static const QRegularExpression packed(QStringLiteral("^p[024](10|12|16)$"));
+    static const QRegularExpression planar(QStringLiteral("[a-z](9|1[0-6])(?:le|be)?$"));
+    static const QRegularExpression packed2(QStringLiteral("^(?:x2)?(?:rgb|bgr)(10|12)(?:le|be)?$"));
+    static const QRegularExpression wide(QStringLiteral("^(?:rgb|bgr)(?:a)?(48|64)"));
+    static const QRegularExpression floating(QStringLiteral("f(16|32)(?:le|be)?$"));
+    // nv12, nv21 and nv24 have 8 bits, the number is the subsampling
+    if (name.startsWith(QLatin1String("nv"))) {
+        return 8;
+    }
+    if (floating.match(name).hasMatch()) {
+        return 16;
+    }
+    if (wide.match(name).hasMatch()) {
+        return 16;
+    }
+    for (const QRegularExpression *re : {&packed, &packed2, &planar}) {
+        const QRegularExpressionMatch match = re->match(name);
+        if (match.hasMatch()) {
+            return match.captured(1).toInt();
+        }
+    }
+    return 8;
+}
