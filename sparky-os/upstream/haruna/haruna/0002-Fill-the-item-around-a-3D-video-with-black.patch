From a05fca23026c3be30803c613a9a9e5dd202568f4 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 5 Oct 2026 06:55:55 -0300
Subject: [PATCH 2/2] Fill the item around a 3D video with black

A 3D video is shown at the size of one view, so the item is bigger than
the video's layer, which is where mpv used to draw its black bars.
Draw the bars next to MpvQt's videoRect.

Assisted-by: Claude Sonnet via Claude Code
---
 src/qml/MpvVideo.qml | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/qml/MpvVideo.qml b/src/qml/MpvVideo.qml
index fb9d0960..a7210964 100644
--- a/src/qml/MpvVideo.qml
+++ b/src/qml/MpvVideo.qml
@@ -67,6 +67,26 @@ MpvItem {
         root.window.openFile(uri, RecentFilesModel.OpenedFrom.ExternalApp)
     }
 
+    // A 3D video is shown at the size of one view, the rest of the item is black
+    Repeater {
+        model: root.stereoVideo ? [
+            Qt.rect(0, 0, root.width, root.videoRect.y),
+            Qt.rect(0, root.videoRect.y + root.videoRect.height, root.width, root.height - root.videoRect.y - root.videoRect.height),
+            Qt.rect(0, root.videoRect.y, root.videoRect.x, root.videoRect.height),
+            Qt.rect(root.videoRect.x + root.videoRect.width, root.videoRect.y, root.width - root.videoRect.x - root.videoRect.width, root.videoRect.height)
+        ] : []
+
+        Rectangle {
+            required property rect modelData
+
+            color: "black"
+            x: modelData.x
+            y: modelData.y
+            width: modelData.width
+            height: modelData.height
+        }
+    }
+
     Timer {
         id: hideCursorTimer
 
