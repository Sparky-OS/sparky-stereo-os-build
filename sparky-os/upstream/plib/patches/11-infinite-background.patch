  protected:
 
   int enabledClipPlanes ;
@@ -2586,6 +2587,8 @@
 void ssgCullAndDraw ( ssgBranch *root ) ;
 // Scene-unit zero-parallax distance; PLIB_SSG_CONVERGENCE remains an override.
 void ssgCullAndDraw ( ssgBranch *root, float convergence ) ;
