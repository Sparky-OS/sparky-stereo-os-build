+// The globe is shown in 3D where the compositor takes it, the window is translucent for the layer under it to show through
+// and the map is a globe that has a theme
+bool MarbleWidgetPrivate::stereo3DActive() const
+{
+    return m_stereo3D && m_stereoLayer && m_widget->isEnabled() && m_widget->window()->testAttribute(Qt::WA_TranslucentBackground)
+        && m_map.projection() == Spherical && m_model.mapTheme();
+}
+
+void MarbleWidgetPrivate::setStereo3D(bool enabled)
+{
+    if (enabled == m_stereo3D || (enabled && !MarbleWidget::isStereo3DSupported())) {
+        return;
+    }
+    m_stereo3D = enabled;
+    if (enabled) {
+        m_stereoLayer = new StereoLayer(m_widget);
+        // The layer follows the widget when it is moved by its window's layout
+        auto *timer = new QTimer(m_widget);
+        timer->setInterval(100);
+        m_widget->connect(timer, &QTimer::timeout, m_widget, [this]() {
+            m_stereoLayer->update();
+        });
+        timer->start();
+    } else {
+        delete m_stereoLayer;
+        m_stereoLayer = nullptr;
+    }
+    // The widget draws nothing of its own background, the 3D layer shows through it
+    m_widget->setAutoFillBackground(!enabled);
+    updateSystemBackgroundAttribute();
+    m_widget->update();
+}
+
+// The sky and the globe once for each eye into a view the size of the widget, which the layer under the window shows;
+// the interface is painted over a transparent hole in the widget, once, so it is on the screen plane in both eyes
+void MarbleWidgetPrivate::paintStereo3D()
+{
+    const qreal ratio = m_widget->devicePixelRatioF();
+    const QSize size = m_widget->size() * ratio;
+    for (QImage &eye : m_eyes) {
+        if (eye.size() != size) {
+            eye = QImage(size, QImage::Format_RGB32);
+            eye.setDevicePixelRatio(ratio);
+        }
+        eye.fill(Qt::black);
+    }
+
+    {
+        QPainter hole(m_widget);
+        hole.setCompositionMode(QPainter::CompositionMode_Source);
+        hole.fillRect(m_widget->rect(), Qt::transparent);
+    }
+
+    {
+        GeoPainter leftEye(&m_eyes[0], m_map.viewport(), m_map.mapQuality());
+        GeoPainter rightEye(&m_eyes[1], m_map.viewport(), m_map.mapQuality());
+        GeoPainter painter(m_widget, m_map.viewport(), m_map.mapQuality());
+        m_map.paintStereo(leftEye, rightEye, painter, qDegreesToRadians(m_stereo3DSeparation));
+    }
+    m_stereoLayer->showEyes(m_eyes[0], m_eyes[1]);
+}
+
+// A translucent window paints no background of its own: this paints it as an opaque window does,
+// except over the map widgets that show the globe in 3D
+class StereoWindowBackground : public QObject
+{
+public:
+    using QObject::QObject;
+
+    bool eventFilter(QObject *object, QEvent *event) override
+    {
+        if (event->type() != QEvent::Paint) {
+            return false;
+        }
+        auto *window = static_cast<QWidget *>(object);
+        QRegion background = static_cast<QPaintEvent *>(event)->region();
+        const QList<MarbleWidget *> maps = window->findChildren<MarbleWidget *>();
+        for (MarbleWidget *map : maps) {
+            if (map->stereo3D() && map->isVisible()) {
+                background -= QRect(map->mapTo(window, QPoint(0, 0)), map->size());
+            }
+        }
+        QPainter painter(window);
+        painter.setCompositionMode(QPainter::CompositionMode_Source);
+        painter.setClipRegion(background);
+        painter.fillRect(window->rect(), window->palette().brush(window->backgroundRole()));
+        painter.end();
+        // The window goes on to paint what is its own over it, as the separators of a main window
+        return false;
+    }
+};
+
+void MarbleWidget::prepareStereo3DWindow(QWidget *window)
+{
+    if (!isStereo3DSupported()) {
+        return;
+    }
+    window->setAttribute(Qt::WA_TranslucentBackground);
+    window->installEventFilter(new StereoWindowBackground(window));
+}
