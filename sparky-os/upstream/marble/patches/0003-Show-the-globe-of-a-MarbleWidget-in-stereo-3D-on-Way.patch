+
+namespace Marble
+{
+
+namespace
+{
+struct Globals {
+    wl_compositor *compositor = nullptr;
+    wl_subcompositor *subcompositor = nullptr;
+    wl_shm *shm = nullptr;
+    wp_viewporter *viewporter = nullptr;
+    bool stereo = false;
+};
+
+void registryGlobal(void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+    auto *globals = static_cast<Globals *>(data);
+    if (!strcmp(interface, wl_compositor_interface.name)) {
+        globals->compositor = static_cast<wl_compositor *>(wl_registry_bind(registry, name, &wl_compositor_interface, qMin(version, 4u)));
+    } else if (!strcmp(interface, wl_subcompositor_interface.name)) {
+        globals->subcompositor = static_cast<wl_subcompositor *>(wl_registry_bind(registry, name, &wl_subcompositor_interface, 1));
+    } else if (!strcmp(interface, wl_shm_interface.name)) {
+        globals->shm = static_cast<wl_shm *>(wl_registry_bind(registry, name, &wl_shm_interface, 1));
+    } else if (!strcmp(interface, wp_viewporter_interface.name)) {
+        globals->viewporter = static_cast<wp_viewporter *>(wl_registry_bind(registry, name, &wp_viewporter_interface, 1));
+    } else if (!strcmp(interface, "kde_stereo_content_manager_v1")) {
+        globals->stereo = true;
+    }
+}
+
+void registryGlobalRemove(void *, wl_registry *, uint32_t)
+{
+}
+
+const wl_registry_listener registryListener = {registryGlobal, registryGlobalRemove};
+
+wl_display *waylandDisplay()
+{
+    if (QGuiApplication::platformName() != QLatin1StringView("wayland")) {
+        return nullptr;
+    }
+    auto *app = qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+    return app ? app->display() : nullptr;
+}
+
+// Reads the globals on a queue of its own, so that nothing is dispatched on the queue Qt uses
+wl_registry *readGlobals(wl_display *display, wl_event_queue *queue, Globals &globals)
+{
+    auto *wrapper = static_cast<wl_display *>(wl_proxy_create_wrapper(display));
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wrapper), queue);
+    wl_registry *registry = wl_display_get_registry(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    wl_registry_add_listener(registry, &registryListener, &globals);
+    wl_display_roundtrip_queue(display, queue);
+    return registry;
+}
+
+void destroyGlobals(Globals &globals)
+{
+    if (globals.compositor) {
+        wl_compositor_destroy(globals.compositor);
+    }
+    if (globals.subcompositor) {
+        wl_subcompositor_destroy(globals.subcompositor);
+    }
+    if (globals.shm) {
+        wl_shm_destroy(globals.shm);
+    }
+    if (globals.viewporter) {
+        wp_viewporter_destroy(globals.viewporter);
+    }
+    globals = {};
+}
+
+// A buffer of the layer in shared memory, which the compositor gives back with release
+struct Buffer {
+    wl_buffer *buffer = nullptr;
+    uchar *data = nullptr;
+    size_t size = 0;
+    QSize pixels;
+    bool busy = false;
+};
+
+void bufferRelease(void *data, wl_buffer *)
+{
+    static_cast<Buffer *>(data)->busy = false;
+}
+
+const wl_buffer_listener bufferListener = {bufferRelease};
+
+void destroyBuffer(Buffer &buffer)
+{
+    if (buffer.buffer) {
+        wl_buffer_destroy(buffer.buffer);
+    }
+    if (buffer.data) {
+        munmap(buffer.data, buffer.size);
+    }
+    buffer = {};
+}
+
+bool createBuffer(Buffer &buffer, wl_shm *shm, wl_event_queue *queue, const QSize &pixels)
+{
+    const int stride = pixels.width() * 4;
+    const size_t size = size_t(stride) * pixels.height();
+    const int fd = memfd_create("marble-stereo-layer", MFD_CLOEXEC);
+    if (fd < 0) {
+        return false;
+    }
+    if (ftruncate(fd, off_t(size)) < 0) {
+        close(fd);
+        return false;
+    }
+    void *data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        close(fd);
+        return false;
+    }
+    wl_shm_pool *pool = wl_shm_create_pool(shm, fd, int(size));
+    close(fd);
+    wl_buffer *wlBuffer = wl_shm_pool_create_buffer(pool, 0, pixels.width(), pixels.height(), stride, WL_SHM_FORMAT_XRGB8888);
+    wl_shm_pool_destroy(pool);
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wlBuffer), queue);
+    buffer.buffer = wlBuffer;
+    buffer.data = static_cast<uchar *>(data);
+    buffer.size = size;
+    buffer.pixels = pixels;
+    buffer.busy = false;
+    wl_buffer_add_listener(wlBuffer, &bufferListener, &buffer);
+    return true;
+}
+
+}
+
+class StereoLayer::Private
+{
+public:
+    explicit Private(QWidget *area)
+        : m_area(area)
+    {
+    }
+
+    bool create();
+    void destroy();
+    void place();
+
+    QPointer<QWidget> m_area;
+    wl_display *m_display = nullptr;
+    wl_event_queue *m_queue = nullptr;
+    wl_registry *m_registry = nullptr;
+    Globals m_globals;
+    wl_surface *m_surface = nullptr;
+    wl_subsurface *m_subsurface = nullptr;
+    wp_viewport *m_viewport = nullptr;
+    Buffer m_buffers[2];
+    bool m_declared = false;
+    bool m_initialized = false;
+    bool m_shown = false;
+    QPoint m_placedPosition{-1, -1};
+    QSize m_placedSize;
+};
+
+bool StereoLayer::isSupported()
+{
+    static const bool supported = [] {
+        wl_display *display = waylandDisplay();
+        if (!display) {
+            return false;
+        }
+        wl_event_queue *queue = wl_display_create_queue(display);
+        Globals globals;
+        wl_registry *registry = readGlobals(display, queue, globals);
+        const bool ok = globals.compositor && globals.subcompositor && globals.shm && globals.viewporter && globals.stereo;
+        destroyGlobals(globals);
+        wl_registry_destroy(registry);
+        wl_event_queue_destroy(queue);
+        return ok;
+    }();
+    return supported;
+}
+
+bool StereoLayer::Private::create()
+{
+    QWidget *top = m_area ? m_area->window() : nullptr;
+    QWindow *window = top ? top->windowHandle() : nullptr;
+    auto *windowInterface = window ? window->nativeInterface<QNativeInterface::Private::QWaylandWindow>() : nullptr;
+    if (!windowInterface || !windowInterface->surface()) {
+        return false;
+    }
+    m_display = waylandDisplay();
+    m_queue = wl_display_create_queue(m_display);
+    m_registry = readGlobals(m_display, m_queue, m_globals);
+    if (stereo_declare_wayland_init(m_display, m_queue) != 0) {
+        destroy();
+        return false;
+    }
+    m_initialized = true;
+    wl_display_roundtrip_queue(m_display, m_queue);
+    if (!stereo_supported_wayland()) {
+        destroy();
+        return false;
+    }
+    m_surface = wl_compositor_create_surface(m_globals.compositor);
+    // Qt makes subsurfaces only above their parent, this one is placed below the window's surface
+    m_subsurface = wl_subcompositor_get_subsurface(m_globals.subcompositor, m_surface, windowInterface->surface());
+    wl_subsurface_place_below(m_subsurface, windowInterface->surface());
+    // The layer changes with the frames of the globe, not with those of the window
+    wl_subsurface_set_desync(m_subsurface);
+    m_viewport = wp_viewporter_get_viewport(m_globals.viewporter, m_surface);
+    // The window's surface keeps the pointer: the layer takes no input
+    wl_region *empty = wl_compositor_create_region(m_globals.compositor);
+    wl_surface_set_input_region(m_surface, empty);
+    wl_region_destroy(empty);
+    return true;
+}
+
+void StereoLayer::Private::destroy()
+{
+    if (m_declared) {
+        stereo_remove_wayland(m_surface);
+        m_declared = false;
+    }
+    if (m_initialized) {
+        stereo_declare_wayland_finish();
+        m_initialized = false;
+    }
+    if (m_viewport) {
+        wp_viewport_destroy(m_viewport);
+        m_viewport = nullptr;
+    }
+    if (m_subsurface) {
+        wl_subsurface_destroy(m_subsurface);
+        m_subsurface = nullptr;
+    }
+    if (m_surface) {
+        wl_surface_destroy(m_surface);
+        m_surface = nullptr;
+    }
+    for (Buffer &buffer : m_buffers) {
+        destroyBuffer(buffer);
+    }
+    destroyGlobals(m_globals);
+    if (m_registry) {
+        wl_registry_destroy(m_registry);
+        m_registry = nullptr;
+    }
+    if (m_queue) {
+        wl_event_queue_destroy(m_queue);
+        m_queue = nullptr;
+    }
+    if (m_display) {
+        wl_display_flush(m_display);
+        m_display = nullptr;
+    }
+    m_placedPosition = QPoint(-1, -1);
+    m_placedSize = {};
+    m_shown = false;
+}
+
+// The layer takes the rectangle of the widget in the window; the position takes effect with the window's next commit
+void StereoLayer::Private::place()
+{
+    const QPoint position = m_area->mapTo(m_area->window(), QPoint(0, 0));
+    const QSize size = m_area->size();
+    if (position != m_placedPosition) {
+        wl_subsurface_set_position(m_subsurface, position.x(), position.y());
+        m_placedPosition = position;
+        m_area->window()->update();
+    }
+    if (size != m_placedSize) {
+        wp_viewport_set_destination(m_viewport, size.width(), size.height());
+        wl_region *opaque = wl_compositor_create_region(m_globals.compositor);
+        wl_region_add(opaque, 0, 0, size.width(), size.height());
+        wl_surface_set_opaque_region(m_surface, opaque);
+        wl_region_destroy(opaque);
+        m_placedSize = size;
+    }
+}
+
+StereoLayer::StereoLayer(QWidget *area)
+    : d(new Private(area))
+{
+}
+
+StereoLayer::~StereoLayer()
+{
+    d->destroy();
+    delete d;
+}
+
+void StereoLayer::hide()
+{
+    if (d->m_surface && d->m_shown) {
+        wl_surface_attach(d->m_surface, nullptr, 0, 0);
+        wl_surface_commit(d->m_surface);
+        wl_display_flush(d->m_display);
+        d->m_shown = false;
+    }
+}
+
+void StereoLayer::update()
+{
+    if (!d->m_surface || !d->m_area) {
+        return;
+    }
+    if (!d->m_area->isVisible() || d->m_area->size().isEmpty()) {
+        hide();
+        return;
+    }
+    d->place();
+}
+
+void StereoLayer::showEyes(const QImage &left, const QImage &right)
+{
+    if (!d->m_area || !d->m_area->isVisible() || d->m_area->size().isEmpty() || left.isNull() || right.isNull() || left.size() != right.size()) {
+        return;
+    }
+    if (!d->m_surface && !d->create()) {
+        return;
+    }
+    // Nothing is listened to on the queue of the layer but the release of buffers
+    wl_display_dispatch_queue_pending(d->m_display, d->m_queue);
+
+    const QSize view = left.size();
+    const QSize pixels(view.width() * 2, view.height());
+
+    Buffer *buffer = nullptr;
+    for (Buffer &candidate : d->m_buffers) {
+        if (candidate.buffer && candidate.pixels != pixels && !candidate.busy) {
+            destroyBuffer(candidate);
+        }
+        if (candidate.busy) {
+            continue;
+        }
+        if (!candidate.buffer && !createBuffer(candidate, d->m_globals.shm, d->m_queue, pixels)) {
+            continue;
+        }
+        if (candidate.pixels == pixels) {
+            buffer = &candidate;
+            break;
+        }
+    }
+    if (!buffer) {
+        return;
+    }
+
+    const int stride = pixels.width() * 4;
+    for (int y = 0; y < view.height(); ++y) {
+        uchar *line = buffer->data + size_t(y) * stride;
+        memcpy(line, left.constScanLine(y), view.width() * 4);
+        memcpy(line + view.width() * 4, right.constScanLine(y), view.width() * 4);
+    }
+
+    d->place();
+    if (!d->m_declared) {
+        const int result = stereo_declare_wayland(d->m_surface, STEREO_SBS_FULL, STEREO_CLASS_VIDEO, STEREO_VIDEO_CURRENT);
+        if (result < 0) {
+            mDebug() << "declaring the stereo content failed:" << strerror(-result);
+        } else {
+            d->m_declared = true;
+        }
+    }
+    buffer->busy = true;
+    wl_surface_attach(d->m_surface, buffer->buffer, 0, 0);
+    wl_surface_damage_buffer(d->m_surface, 0, 0, pixels.width(), pixels.height());
+    wl_surface_commit(d->m_surface);
+    wl_display_flush(d->m_display);
+    d->m_shown = true;
+}
+
+}
+
