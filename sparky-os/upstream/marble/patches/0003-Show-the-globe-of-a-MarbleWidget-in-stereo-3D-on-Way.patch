+#ifndef MARBLE_STEREOLAYER_H
+#define MARBLE_STEREOLAYER_H
+
+class QImage;
+class QWidget;
+
+namespace Marble
+{
+
+/**
+ * @brief The 3D area of a window: a layer under the window's surface that shows both views of a widget through a compositor that takes stereo content.
+ *
+ * The views, side by side with the left eye first and each at the size of the widget, are in a surface under the window's own,
+ * a wl_subsurface placed below it at the rectangle of the widget and declared to the compositor as full side by side stereo content.
+ * The widget is transparent over it and the rest of the window stays as it is, the same in both eyes, so whatever is drawn over the
+ * widget is on the screen plane. It is used on Wayland when the compositor has wl_subcompositor, wp_viewporter, wl_shm and the
+ * stereo content declaration.
+ */
+class StereoLayer
+{
+public:
+    /** @param area The widget whose rectangle in its window the layer fills */
+    explicit StereoLayer(QWidget *area);
+    ~StereoLayer();
+
+    /** @brief True if the compositor offers what the layer needs */
+    static bool isSupported();
+
+    /** @brief Show the two views, both at the size of the widget in device pixels */
+    void showEyes(const QImage &left, const QImage &right);
+    /** @brief Follow the widget when it moves or changes size, and hide the layer while it is not shown */
+    void update();
+    /** @brief Take the views off the screen */
+    void hide();
+
+private:
+    class Private;
+    Private *const d;
+};
+
+}
