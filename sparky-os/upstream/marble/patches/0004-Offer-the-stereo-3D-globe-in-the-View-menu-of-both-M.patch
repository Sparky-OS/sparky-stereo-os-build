     d->ui_viewSettings.kcfg_labelLocalization->hide();
     d->ui_viewSettings.label_labelLocalization->hide();
+    d->ui_viewSettings.groupBox_stereo3D->setVisible(MarbleWidget::isStereo3DSupported());
 
     // navigation page
     auto w_navigationSettings = new QWidget(this);
