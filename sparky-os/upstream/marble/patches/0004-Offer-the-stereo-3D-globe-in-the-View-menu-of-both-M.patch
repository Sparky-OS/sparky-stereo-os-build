From 2489432ba1974845f399dc30350b6f6d6205684e Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Wed, 7 Oct 2026 01:27:24 -0300
Subject: [PATCH 4/4] Offer the stereo 3D globe in the View menu of both Marble
 applications

The entry is offered only where the compositor takes stereo content, and
the view settings get the separation of the two cameras (2 degrees by
default).

Assisted-by: Claude Sonnet via Claude Code
---
 src/apps/marble-kde/KdeMainWindow.cpp      |  3 ++
 src/apps/marble-kde/marble.kcfg            |  8 ++++
 src/apps/marble-kde/marble_part.cpp        | 27 +++++++++++++
 src/apps/marble-kde/marble_part.h          |  2 +
 src/apps/marble-kde/marble_part.rc         |  3 +-
 src/apps/marble-qt/QtMainWindow.cpp        | 28 ++++++++++++++
 src/apps/marble-qt/QtMainWindow.h          |  2 +
 src/lib/marble/MarbleViewSettingsWidget.ui | 44 ++++++++++++++++++++++
 src/lib/marble/QtMarbleConfigDialog.cpp    |  8 ++++
 src/lib/marble/QtMarbleConfigDialog.h      |  1 +
 10 files changed, 125 insertions(+), 1 deletion(-)

diff --git a/src/apps/marble-kde/KdeMainWindow.cpp b/src/apps/marble-kde/KdeMainWindow.cpp
index 4e0ce3f87..915ab8f40 100644
--- a/src/apps/marble-kde/KdeMainWindow.cpp
+++ b/src/apps/marble-kde/KdeMainWindow.cpp
@@ -38,6 +38,9 @@ MainWindow::MainWindow(const QString &marbleDataPath, QWidget *parent)
     : KXmlGuiWindow(parent)
     , m_savedSize(QSize(-1, -1))
 {
+    // The globe in stereo 3D is a layer under the window's surface, which shows through the map widget
+    MarbleWidget::prepareStereo3DWindow(this);
+
     m_part = new MarblePart(this, this, {}, {marbleDataPath});
 
     setCentralWidget(m_part->widget());
diff --git a/src/apps/marble-kde/marble.kcfg b/src/apps/marble-kde/marble.kcfg
index 6b04a631d..a076cc66c 100644
--- a/src/apps/marble-kde/marble.kcfg
+++ b/src/apps/marble-kde/marble.kcfg
@@ -34,6 +34,14 @@
   <entry key="showClouds" type="Bool" >
    <default>true</default>
   </entry>
+  <entry key="stereo3D" type="Bool" >
+   <default>false</default>
+  </entry>
+  <entry key="stereo3DSeparation" type="Double" >
+   <default>2.0</default>
+   <min>0.5</min>
+   <max>10.0</max>
+  </entry>
   <entry key="workOffline" type="Bool" >
    <default>false</default>
   </entry>
diff --git a/src/apps/marble-kde/marble_part.cpp b/src/apps/marble-kde/marble_part.cpp
index 43be2f100..feedd1a69 100644
--- a/src/apps/marble-kde/marble_part.cpp
+++ b/src/apps/marble-kde/marble_part.cpp
@@ -295,6 +295,13 @@ void MarblePart::setShowClouds(bool isChecked)
     m_showCloudsAction->setChecked(isChecked); // Sync state with the GUI
 }
 
+void MarblePart::setStereo3D(bool isChecked)
+{
+    m_controlView->marbleWidget()->setStereo3D(isChecked);
+
+    m_stereo3DAction->setChecked(isChecked); // Sync state with the GUI
+}
+
 void MarblePart::showPositionLabel(bool isChecked)
 {
     m_positionLabel->setVisible(isChecked);
@@ -423,6 +430,11 @@ void MarblePart::readSettings()
     m_controlView->marbleWidget()->setShowClouds(MarbleSettings::showClouds());
     m_showCloudsAction->setChecked(MarbleSettings::showClouds());
 
+    m_controlView->marbleWidget()->setStereo3DSeparation(MarbleSettings::stereo3DSeparation());
+    if (m_stereo3DAction) {
+        setStereo3D(MarbleSettings::stereo3D());
+    }
+
     workOffline(MarbleSettings::workOffline());
     m_workOfflineAction->setChecked(MarbleSettings::workOffline());
 
@@ -588,6 +600,9 @@ void MarblePart::writeSettings()
 
     MarbleSettings::setShowClouds(m_controlView->marbleWidget()->showClouds());
 
+    MarbleSettings::setStereo3D(m_controlView->marbleWidget()->stereo3D());
+    MarbleSettings::setStereo3DSeparation(m_controlView->marbleWidget()->stereo3DSeparation());
+
     MarbleSettings::setWorkOffline(m_workOfflineAction->isChecked());
 
     MarbleSettings::setStillQuality(m_controlView->marbleWidget()->mapQuality(Still));
@@ -761,6 +776,15 @@ void MarblePart::setupActions()
     m_showCloudsAction->setText(i18nc("Action for toggling clouds", "&Clouds"));
     connect(m_showCloudsAction, &QAction::triggered, this, &MarblePart::setShowClouds);
 
+    // Action: Show the globe in stereo 3D, where the compositor takes it
+    if (MarbleWidget::isStereo3DSupported()) {
+        m_stereo3DAction = new QAction(this);
+        actionCollection()->addAction(QStringLiteral("show_stereo3d"), m_stereo3DAction);
+        m_stereo3DAction->setCheckable(true);
+        m_stereo3DAction->setText(i18nc("Action for toggling the globe in stereo 3D", "Stereo &3D"));
+        connect(m_stereo3DAction, &QAction::triggered, this, &MarblePart::setStereo3D);
+    }
+
     // Action: Show Sunshade options
     m_controlSunAction = new QAction(this);
     actionCollection()->addAction(QStringLiteral("control_sun"), m_controlSunAction);
@@ -1298,6 +1322,7 @@ void MarblePart::editSettings()
     m_configDialog->addPage(w_viewSettings, i18n("View"), QStringLiteral("configure"));
 
     ui_viewSettings.label_labelLocalization->hide();
+    ui_viewSettings.groupBox_stereo3D->setVisible(MarbleWidget::isStereo3DSupported());
     ui_viewSettings.kcfg_labelLocalization->hide();
 
     // navigation page
@@ -1405,6 +1430,8 @@ void MarblePart::updateSettings()
     m_controlView->marbleWidget()->setMapQualityForViewContext((MapQuality)MarbleSettings::stillQuality(), Still);
     m_controlView->marbleWidget()->setMapQualityForViewContext((MapQuality)MarbleSettings::animationQuality(), Animation);
 
+    m_controlView->marbleWidget()->setStereo3DSeparation(MarbleSettings::stereo3DSeparation());
+
     m_controlView->marbleWidget()->setDefaultAngleUnit((AngleUnit)MarbleSettings::angleUnit());
     MarbleGlobal::getInstance()->locale()->setMeasurementSystem((MarbleLocale::MeasurementSystem)MarbleSettings::distanceUnit());
 
diff --git a/src/apps/marble-kde/marble_part.h b/src/apps/marble-kde/marble_part.h
