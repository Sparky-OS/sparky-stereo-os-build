+// The vertical perspective view has a camera at a finite distance: the eye's camera is moved sideways, its axis stays parallel to
+// the view axis, and the projection is off-axis (the angle is the one seen from the globe's center, positive to the right). The globe
+// is moved by the projection, the sky at infinity is moved by the parallax at infinity
+void MarbleMapPrivate::paintPerspectiveEye(GeoPainter &painter, qreal eyeAngle)
+{
+    m_viewport.setEyeAngle(eyeAngle);
+    const auto *projection = static_cast<const VerticalPerspectiveProjection *>(m_viewport.currentProjection());
+
+    painter.save();
+    painter.translate(projection->parallaxAtInfinity(&m_viewport), 0);
+    m_layerManager.renderLayers(&painter, &m_viewport, LayerManager::SkyLayers);
+    painter.restore();
+
+    m_layerManager.renderLayers(&painter, &m_viewport, LayerManager::GlobeLayers);
+    m_viewport.setEyeAngle(0);
+}
