     const qreal skyShift = d->m_viewport.radius() * qSin(halfSeparation);
     // The left eye last: what the layers keep of their last pass, for the mouse to pick, is the left eye's
-    d->paintEye(rightEye, -halfSeparation, skyShift);
-    d->paintEye(leftEye, halfSeparation, -skyShift);
+    if (d->m_viewport.projection() == VerticalPerspective) {
+        d->paintPerspectiveEye(rightEye, halfSeparation);
+        d->paintPerspectiveEye(leftEye, -halfSeparation);
+    } else {
+        d->paintEye(rightEye, -halfSeparation, skyShift);
+        d->paintEye(leftEye, halfSeparation, -skyShift);
+    }
     d->m_layerManager.renderLayers(&painter, &d->m_viewport, LayerManager::InterfaceLayers);
     d->updateRenderState(oldRenderStatus);
