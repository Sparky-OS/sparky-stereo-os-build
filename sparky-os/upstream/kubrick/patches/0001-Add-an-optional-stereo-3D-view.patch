@@ -112,6 +119,13 @@ private:
 
     void turnOnLighting     ();
 
+    // Stereo 3D: the one scene is drawn once per eye by two cameras, either
+    // side of the usual one, parallel and meeting at the cubes' distance.
+    bool isStereo           () const;
+    void applyEyeCamera     ();
+
+    int    stereoSeparation;	// Percent of the cubes' distance, 0 = off.
+
     Game * game;
     float bevelAmount;		// Fraction of bevelling on a cubie (eg. 0.1).
     QColor bgColor;		// Background color.
