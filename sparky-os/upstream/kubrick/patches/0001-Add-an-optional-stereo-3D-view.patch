diff --git a/src/main.cpp b/src/main.cpp
index 069c485..fb181db 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -6,6 +6,7 @@
 
 #include <QApplication>
 #include <QCommandLineParser>
+#include <QSurfaceFormat>
 
 #include <KAboutData>
 #include <KCrash>
@@ -38,9 +39,26 @@ int main(int argc, char **argv)
 
     QCommandLineParser parser;
     about.setupCommandLine(&parser);
+    parser.addOption(QCommandLineOption(QStringLiteral("stereo"),
+        i18n("Show the cubes in stereo 3D (needs a stereo-capable display)")));
+    parser.addOption(QCommandLineOption(QStringLiteral("stereo-separation"),
+        i18n("Distance between the two eyes in stereo 3D, in percent of the distance to the cubes (default 5)"),
+        QStringLiteral("percent"), QStringLiteral("5")));
     parser.process(app);
     about.processCommandLine(&parser);
 
+    int stereoSeparation = 0;
+    if (parser.isSet(QStringLiteral("stereo"))) {
+        stereoSeparation = qBound(1, parser.value(QStringLiteral("stereo-separation")).toInt(), 20);
+
+        // Ask for left and right buffers, before the window is created.
+        // QOpenGLWidget then calls paintGL() once for each, or only once
+        // when the platform cannot give stereo buffers.
+        QSurfaceFormat format = QSurfaceFormat::defaultFormat();
+        format.setStereo(true);
+        QSurfaceFormat::setDefaultFormat(format);
+    }
+
     KDBusService service;
 
     Kubrick * mainWindow = nullptr;
@@ -53,7 +71,7 @@ int main(int argc, char **argv)
 
         /// @todo do something with the command line args here
 
-        mainWindow = new Kubrick ();
+        mainWindow = new Kubrick (stereoSeparation);
         mainWindow->show ();
     }
 
