+#ifdef HAVE_STEREO_PREVIEW
+void MainWindow::paintEvent(QPaintEvent *event)
+{
+    if (!testAttribute(Qt::WA_TranslucentBackground)) {
+        KXmlGuiWindow::paintEvent(event);
+        return;
+    }
+    QRegion background(rect());
+    const QList<VideoWidget *> videos = findChildren<VideoWidget *>();
+    for (VideoWidget *video : videos) {
+        if (video->stereoLayerActive() && video->isVisible()) {
+            background -= QRect(video->mapTo(this, QPoint(0, 0)), video->size());
+        }
+    }
+    QPainter painter(this);
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    const auto rects = background.rects();
+    for (const QRect &r : rects) {
+        painter.fillRect(r, palette().window());
+    }
+}
+#endif
