+// The layer takes the rectangle of the area in the window; the position takes effect with the window's next commit
+void StereoLayer::Private::place()
+{
+    const QPoint position = area->mapTo(area->window(), QPoint(0, 0));
+    const QSize size = area->size();
+    if (position != placedPosition) {
+        wl_subsurface_set_position(subsurface, position.x(), position.y());
+        placedPosition = position;
+        area->window()->update();
+    }
+    if (size != placedSize) {
+        wp_viewport_set_destination(viewport, size.width(), size.height());
+        wl_region *opaque = wl_compositor_create_region(globals.compositor);
+        wl_region_add(opaque, 0, 0, size.width(), size.height());
+        wl_surface_set_opaque_region(surface, opaque);
+        wl_region_destroy(opaque);
+        placedSize = size;
+    }
+}
+
+// Nothing of the layer is shown while its area is not
+void StereoLayer::Private::hide()
+{
+    if (surface && shown) {
+        wl_surface_attach(surface, nullptr, 0, 0);
+        wl_surface_commit(surface);
+        wl_display_flush(display);
+        shown = false;
+    }
 }
 
