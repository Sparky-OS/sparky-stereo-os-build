+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include "utils/stereo3d.h"
+
+#include <QImage>
+#include <QObject>
+#include <QWidget>
+#include <memory>
+
+/** @class StereoLayer
+ *  @brief The 3D area of a window: a layer under the window's surface that shows a monitor's frames in 3D through a compositor that takes stereo content.
+ *
+ *  The two views of the frame, side by side with the left eye first and each at the size of the area, are in a surface under
+ *  the window's, a wl_subsurface placed below it (Qt creates subsurfaces only above their parent) at the rectangle of a widget
+ *  of the window, and declared to the compositor as full side by side stereo content. The widget is transparent over it and the rest of the
+ *  window stays as it is, the same in both eyes, so whatever is drawn over the area (the monitor's ruler and overlays) is on the screen plane.
+ *  It is used on Wayland when the compositor has wl_subcompositor, wp_viewporter, wl_shm and the stereo content declaration.
+ */
+class StereoLayer : public QObject
+{
+    Q_OBJECT
+public:
+    /** @param area The widget whose rectangle in its window the layer fills */
+    explicit StereoLayer(QWidget *area, QObject *parent = nullptr);
+    ~StereoLayer() override;
+
+    /** @brief True if the compositor offers what the layer needs */
+    static bool isSupported();
+
+    bool isActive() const;
+    void setActive(bool active);
+    /** @brief Show the two views, each scaled to the size of the area with black bars where its shape is not the area's */
+    void showEyes(const QImage &left, const QImage &right);
+    /** @brief Follow the area when it moves or changes size, and hide the layer while it is not shown */
+    void update();
+
+private:
+    struct Private;
+    std::unique_ptr<Private> d;
+};
