+# The 3D window of the monitors: where the compositor takes stereo content declarations, a layer under a window of its own
+option(STEREO_PREVIEW "Offer a 3D window to the monitors on Wayland compositors that take stereo content" ON)
+if(STEREO_PREVIEW AND UNIX AND NOT APPLE)
+    find_package(PkgConfig)
+    find_package(WaylandScanner)
+    find_package(Qt${QT_MAJOR_VERSION} ${QT_MIN_VERSION} OPTIONAL_COMPONENTS GuiPrivate)
+    if(PkgConfig_FOUND)
+        pkg_check_modules(WAYLAND_CLIENT IMPORTED_TARGET wayland-client)
+        pkg_check_modules(WAYLAND_PROTOCOLS wayland-protocols)
+        pkg_check_modules(STEREO_DECLARE IMPORTED_TARGET stereo-declare)
+    endif()
+    if(WaylandScanner_FOUND AND WAYLAND_CLIENT_FOUND AND WAYLAND_PROTOCOLS_FOUND AND STEREO_DECLARE_FOUND AND TARGET Qt${QT_MAJOR_VERSION}::GuiPrivate)
+        pkg_get_variable(WAYLAND_PROTOCOLS_DIR wayland-protocols pkgdatadir)
+        ecm_add_wayland_client_protocol(STEREO_WAYLAND_SOURCES
