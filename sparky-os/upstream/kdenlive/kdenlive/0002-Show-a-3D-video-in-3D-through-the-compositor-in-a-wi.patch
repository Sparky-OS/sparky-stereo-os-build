+/** @class StereoPreview
+ *  @brief A window that shows a monitor's frames in 3D through a compositor that takes stereo content.
+ *
+ *  The two views of the frame, side by side with the left eye first and each at the size of the window, are in a layer under the
+ *  window's surface, a wl_subsurface placed below it (Qt creates subsurfaces only above their parent) and declared to the compositor
+ *  as full side by side stereo content. The window itself is transparent over it. It is used on Wayland when the compositor has
+ *  wl_subcompositor, wp_viewporter, wl_shm and the stereo content declaration.
+ */
+class StereoPreview : public QObject
+{
+    Q_OBJECT
+public:
+    explicit StereoPreview(const QString &title, QObject *parent = nullptr);
+    ~StereoPreview() override;
+
+    /** @brief True if the compositor offers what the layer needs */
+    static bool isSupported();
+
+    bool isVisible() const;
+    void setVisible(bool visible);
+    /** @brief Show a frame of a video that packs its two views as @p format; the frame is shown as it is when it does not */
+    void showFrame(const QImage &frame, const Stereo3D::Format &format);
+
+Q_SIGNALS:
+    /** @brief The user closed the window */
+    void closed();
+
+private:
+    struct Private;
+    std::unique_ptr<Private> d;
+};
