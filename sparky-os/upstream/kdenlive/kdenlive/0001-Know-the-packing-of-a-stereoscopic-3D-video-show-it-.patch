+int Monitor::stereoPreviewSetting() const
+{
+    return m_id == Kdenlive::ClipMonitor ? KdenliveSettings::stereo3d_clip_preview() : KdenliveSettings::stereo3d_preview();
+}
+
+void Monitor::setStereoPreviewSetting(int mode)
+{
+    if (m_id == Kdenlive::ClipMonitor) {
+        KdenliveSettings::setStereo3d_clip_preview(mode);
+    } else {
+        KdenliveSettings::setStereo3d_preview(mode);
+    }
+}
+
+Stereo3D::Format Monitor::stereoFormat() const
+{
+    if (m_id == Kdenlive::ClipMonitor) {
+        if (!m_controller) {
+            return {};
+        }
+        const Stereo3D::Packing packing = Stereo3D::fromMltName(m_controller->getProducerProperty(QStringLiteral("meta.media.stereo3d.type")));
+        return {packing, m_controller->getProducerIntProperty(QStringLiteral("meta.media.stereo3d.invert")) == 1};
+    }
+    if (m_id == Kdenlive::ProjectMonitor && pCore->currentDoc()) {
+        return pCore->currentDoc()->stereo3DFormat();
+    }
+    return {};
+}
+
+void Monitor::updateStereoPreview()
+{
+    const Stereo3D::Format format = stereoFormat();
+    m_glMonitor->setStereoPreview(format, stereoPreviewSetting() == 1);
+    if (m_stereoProject && pCore->currentDoc()) {
+        // Show what the project says
+        const KdenliveDoc *doc = pCore->currentDoc();
+        QSignalBlocker blocker(m_stereoProject);
+        const QString value = doc->isStereo3DAutomatic() ? QStringLiteral("auto")
+                              : format.isStereo()        ? Stereo3D::mltName(format.packing)
+                                                         : QStringLiteral("none");
+        const QList<QAction *> actions = m_stereoProject->actions();
+        for (QAction *a : actions) {
+            if (a->data().toString() == value) {
+                m_stereoProject->setCurrentAction(a);
+            }
+        }
+        m_stereoRightFirst->setChecked(format.rightFirst);
+    }
+}
