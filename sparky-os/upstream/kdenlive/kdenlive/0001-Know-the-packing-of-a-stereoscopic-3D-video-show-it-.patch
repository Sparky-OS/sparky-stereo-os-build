new file mode 100644
index 0000000..0c43a6c
--- /dev/null
+++ b/src/utils/stereo3d.cpp
@@ -0,0 +1,195 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "stereo3d.h"
+
+#include <KLocalizedString>
+#include <QPainter>
+#include <cstring>
+
+namespace Stereo3D {
+
+QString mltName(Packing packing)
+{
+    switch (packing) {
+    case Packing::SideBySide:
+        return QStringLiteral("side_by_side");
+    case Packing::TopBottom:
+        return QStringLiteral("top_and_bottom");
+    case Packing::FrameSequence:
+        return QStringLiteral("frame_sequence");
+    case Packing::Checkerboard:
+        return QStringLiteral("checkerboard");
+    case Packing::SideBySideQuincunx:
+        return QStringLiteral("side_by_side_quincunx");
+    case Packing::Lines:
+        return QStringLiteral("lines");
+    case Packing::Columns:
+        return QStringLiteral("columns");
+    case Packing::None:
+        break;
+    }
+    return {};
+}
+
+Packing fromMltName(const QString &name)
+{
+    for (Packing packing : packings()) {
+        if (mltName(packing) == name) {
+            return packing;
+        }
+    }
+    return Packing::None;
+}
+
+QList<Packing> packings()
+{
+    return {Packing::SideBySide, Packing::TopBottom,  Packing::SideBySideQuincunx, Packing::Lines,
+            Packing::Columns,    Packing::Checkerboard, Packing::FrameSequence};
+}
+
+QString packingText(Packing packing)
+{
+    switch (packing) {
+    case Packing::SideBySide:
+        return i18nc("Stereoscopic 3D packing", "Side by side");
+    case Packing::TopBottom:
+        return i18nc("Stereoscopic 3D packing", "Top and bottom");
+    case Packing::FrameSequence:
+        return i18nc("Stereoscopic 3D packing, the frames are the views in turn", "Frame sequential");
+    case Packing::Checkerboard:
+        return i18nc("Stereoscopic 3D packing", "Checkerboard");
+    case Packing::SideBySideQuincunx:
+        return i18nc("Stereoscopic 3D packing", "Side by side, quincunx sampling");
+    case Packing::Lines:
+        return i18nc("Stereoscopic 3D packing, the views are in alternate rows", "Row interleaved");
+    case Packing::Columns:
+        return i18nc("Stereoscopic 3D packing, the views are in alternate columns", "Column interleaved");
+    case Packing::None:
+        break;
+    }
+    return i18nc("Not stereoscopic 3D", "None");
+}
+
+QString description(const Format &format)
+{
+    if (!format.isStereo()) {
+        return packingText(Packing::None);
+    }
+    return i18nc("Stereoscopic 3D packing and the eye whose view comes first", "%1, %2", packingText(format.packing),
+                 format.rightFirst ? i18n("right eye first") : i18n("left eye first"));
+}
+
+QSize storedViewSize(const QSize &frame, Packing packing)
+{
+    switch (packing) {
+    case Packing::SideBySide:
+    case Packing::SideBySideQuincunx:
+    case Packing::Columns:
+    case Packing::Checkerboard:
+        return QSize(frame.width() / 2, frame.height());
+    case Packing::TopBottom:
+    case Packing::Lines:
+        return QSize(frame.width(), frame.height() / 2);
+    default:
+        return frame;
+    }
+}
+
+bool fullSizeViews(const QSize &frame, Packing packing)
+{
+    const double aspect = frame.height() > 0 ? double(frame.width()) / frame.height() : 1.;
+    switch (packing) {
+    case Packing::SideBySide:
+    case Packing::SideBySideQuincunx:
+        return aspect >= 2.5;
+    case Packing::TopBottom:
+        return aspect <= 1.2;
+    default:
+        return false;
+    }
+}
+
+QSize viewSize(const QSize &frame, Packing packing)
+{
+    switch (packing) {
+    case Packing::SideBySide:
+    case Packing::SideBySideQuincunx:
+        return fullSizeViews(frame, packing) ? QSize(frame.width() / 2, frame.height()) : frame;
+    case Packing::TopBottom:
+        return fullSizeViews(frame, packing) ? QSize(frame.width(), frame.height() / 2) : frame;
+    default:
+        return frame;
+    }
+}
+
+QImage view(const QImage &frame, Packing packing, int slot)
+{
+    const QImage source = frame.format() == QImage::Format_RGB32 ? frame : frame.convertToFormat(QImage::Format_RGB32);
+    const int width = source.width();
+    const int height = source.height();
+    QImage result;
+    switch (packing) {
+    case Packing::SideBySide:
+    case Packing::SideBySideQuincunx:
+        result = source.copy(slot * (width / 2), 0, width / 2, height);
+        break;
+    case Packing::TopBottom:
+        result = source.copy(0, slot * (height / 2), width, height / 2);
+        break;
+    case Packing::Lines:
+        // The first view is in the first row
+        result = QImage(width, height / 2, QImage::Format_RGB32);
+        for (int y = 0; y < result.height(); ++y) {
+            std::memcpy(result.scanLine(y), source.constScanLine(2 * y + slot), size_t(width) * 4);
+        }
+        break;
+    case Packing::Columns:
+        // The first view is in the first column
+        result = QImage(width / 2, height, QImage::Format_RGB32);
+        for (int y = 0; y < height; ++y) {
+            const auto *in = reinterpret_cast<const quint32 *>(source.constScanLine(y));
+            auto *out = reinterpret_cast<quint32 *>(result.scanLine(y));
+            for (int x = 0; x < result.width(); ++x) {
+                out[x] = in[2 * x + slot];
+            }
+        }
+        break;
+    case Packing::Checkerboard:
+        // The first view is at the top left pixel: its pixels are those where x + y has the parity of the slot
+        result = QImage(width / 2, height, QImage::Format_RGB32);
+        for (int y = 0; y < height; ++y) {
+            const auto *in = reinterpret_cast<const quint32 *>(source.constScanLine(y));
+            auto *out = reinterpret_cast<quint32 *>(result.scanLine(y));
+            for (int x = 0; x < result.width(); ++x) {
+                out[x] = in[2 * x + ((slot + y) & 1)];
+            }
+        }
+        break;
+    default:
+        // A frame sequence has one view in each frame
+        result = source;
+        break;
+    }
+    const QSize size = viewSize(source.size(), packing);
+    return result.size() == size ? result : result.scaled(size, Qt::IgnoreAspectRatio, Qt::SmoothTransformation);
+}
+
+QImage fullSideBySide(const QImage &frame, const Format &format)
+{
+    if (!format.isStereo() || format.packing == Packing::FrameSequence) {
+        return {};
+    }
+    const QImage first = view(frame, format.packing, 0);
+    const QImage second = view(frame, format.packing, 1);
+    QImage result(first.width() * 2, first.height(), QImage::Format_RGB32);
+    QPainter painter(&result);
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    painter.drawImage(0, 0, format.rightFirst ? second : first);
+    painter.drawImage(first.width(), 0, format.rightFirst ? first : second);
+    return result;
+}
+}
