new file mode 100644
index 0000000..fce6fd4
--- /dev/null
+++ b/src/utils/stereo3d.h
@@ -0,0 +1,63 @@
+/*
+    SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QImage>
+#include <QSize>
+#include <QString>
+
+/** @brief The stereoscopic 3D packings of a video: how its frames hold the two views.
+ *  They are the frame packing arrangement types of H.264 (Table D-8) and H.265 (Table D.8), which
+ *  Matroska's StereoMode (RFC 9559, 5.1.4.1.28.3) and FFmpeg's AVStereo3D share. The names are those
+ *  of the "meta.media.stereo3d.type" property of MLT's avformat producer and of the "stereo3d" property
+ *  of its consumer. */
+namespace Stereo3D {
+
+enum class Packing {
+    None,
+    SideBySide,
+    TopBottom,
+    FrameSequence,
+    Checkerboard,
+    SideBySideQuincunx,
+    Lines,
+    Columns,
+};
+
+struct Format
+{
+    Packing packing = Packing::None;
+    /** @brief The right eye's view comes first (content_interpretation_type 2, the "right eye first" StereoMode values) */
+    bool rightFirst = false;
+
+    bool isStereo() const { return packing != Packing::None; }
+    bool operator==(const Format &other) const { return packing == other.packing && rightFirst == other.rightFirst; }
+};
+
+/** @brief The MLT name of a packing, empty for none */
+QString mltName(Packing packing);
+Packing fromMltName(const QString &name);
+/** @brief The packing as the user reads it, for example "Side by side, left eye first" */
+QString description(const Format &format);
+/** @brief The packings a user can choose from, in the order of the tables */
+QList<Packing> packings();
+QString packingText(Packing packing);
+
+/** @brief The size of one view of a frame, from the frame's size. The stream does not say whether the views of a side by side or top
+ *  and bottom frame are half or full size, so the shape of the frame decides: a side by side frame at least 2.5 times as wide as high,
+ *  or a top and bottom frame at most 1.2 times as wide as high, holds full size views. */
+QSize viewSize(const QSize &frame, Packing packing);
+/** @brief The size of the samples one view has in the frame: half the frame in the direction its packing halves it */
+QSize storedViewSize(const QSize &frame, Packing packing);
+/** @brief Whether the views of the frame are full size (not squeezed to fit the frame) */
+bool fullSizeViews(const QSize &frame, Packing packing);
+
+/** @brief One view of a frame, slot 0 is the first view of the packing and 1 the second, at the size of a view */
+QImage view(const QImage &frame, Packing packing, int slot);
+/** @brief The two views of a frame as one image, side by side, the left eye first: the full side by side that our compositor takes */
+QImage fullSideBySide(const QImage &frame, const Format &format);
+}
