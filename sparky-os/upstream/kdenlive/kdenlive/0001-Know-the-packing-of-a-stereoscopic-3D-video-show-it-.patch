+Stereo3D::Format KdenliveDoc::stereo3DFormat() const
+{
+    const QString value = getDocumentProperty(QStringLiteral("stereo3d"));
+    if (value == QLatin1String("none")) {
+        return {};
+    }
+    if (!value.isEmpty()) {
+        return {Stereo3D::fromMltName(value), getDocumentProperty(QStringLiteral("stereo3d_invert")) == QLatin1String("1")};
+    }
+    const std::vector<QString> ids = pCore->projectItemModel()->getAllClipIds();
+    for (const QString &id : ids) {
+        const std::shared_ptr<ProjectClip> clip = pCore->projectItemModel()->getClipByBinID(id);
+        if (!clip) {
+            continue;
+        }
+        const Stereo3D::Packing packing = Stereo3D::fromMltName(clip->getProducerProperty(QStringLiteral("meta.media.stereo3d.type")));
+        if (packing != Stereo3D::Packing::None) {
+            return {packing, clip->getProducerIntProperty(QStringLiteral("meta.media.stereo3d.invert")) == 1};
+        }
+    }
+    return {};
+}
+
+void KdenliveDoc::setStereo3DFormat(const Stereo3D::Format &format, bool automatic)
+{
+    if (automatic) {
+        setDocumentProperty(QStringLiteral("stereo3d"), QString());
+        setDocumentProperty(QStringLiteral("stereo3d_invert"), QString());
+        return;
+    }
+    setDocumentProperty(QStringLiteral("stereo3d"), format.isStereo() ? Stereo3D::mltName(format.packing) : QStringLiteral("none"));
+    setDocumentProperty(QStringLiteral("stereo3d_invert"), format.rightFirst ? QStringLiteral("1") : QStringLiteral("0"));
+}
+
+bool KdenliveDoc::isStereo3DAutomatic() const
+{
+    return getDocumentProperty(QStringLiteral("stereo3d")).isEmpty();
+}
