From 44540eba65118538260c94a7427c732a201c3b53 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 15 Oct 2026 08:30:48 -0300
Subject: [PATCH 25/26] egl: wayland: do not wait for frame callbacks in
 eglSwapBuffers

With a swap interval of 1 the swap blocks until the compositor sends a
frame callback. A window that is minimized, on another desktop or closing
gets none, so the video output thread never returns from the swap, the
picture pool runs dry, the decoder waits for a picture, and stopping the
input waits for the decoder: the player cannot quit. The video output
already paces the pictures by their timestamps, so ask for no wait.

Assisted-by: Claude Sonnet via Claude Code
---
 modules/video_output/opengl/egl.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/modules/video_output/opengl/egl.c b/modules/video_output/opengl/egl.c
index ab20fb4..93400cb 100644
--- a/modules/video_output/opengl/egl.c
+++ b/modules/video_output/opengl/egl.c
@@ -411,6 +411,19 @@ static int Open (vlc_object_t *obj, const struct gl_api *api)
     }
     sys->context = ctx;
 
+#ifdef USE_PLATFORM_WAYLAND
+    /* With a swap interval of 1, eglSwapBuffers() waits for the compositor's
+     * frame callback, and a window that is minimized, on another desktop or
+     * closing gets none: the swap never returns, the picture pool runs dry and
+     * the player cannot stop. The video output paces the pictures itself. */
+    if (eglMakeCurrent(sys->display, sys->surface, sys->surface, ctx) == EGL_TRUE)
+    {
+        eglSwapInterval(sys->display, 0);
+        eglMakeCurrent(sys->display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                       EGL_NO_CONTEXT);
+    }
+#endif
+
     /* Initialize OpenGL callbacks */
     gl->ext = VLC_GL_EXT_EGL;
     gl->makeCurrent = MakeCurrent;
