From e5e4411c4f93c86be2e6c6252bf6ea1e8c8e9789 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 5 Oct 2026 07:42:35 -0300
Subject: [PATCH 11/11] es_format: print the multiview mode of a video format

The mode of a stereoscopic video was not in any debug message, so a
video output could not be told from the log which layout it was given.

Assisted-by: Claude Sonnet via Claude Code
---
 src/misc/es_format.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/misc/es_format.c b/src/misc/es_format.c
index c2a09132d1..8045df6ad2 100644
--- a/src/misc/es_format.c
+++ b/src/misc/es_format.c
@@ -434,13 +434,13 @@ void video_format_Print( vlc_object_t *p_this,
                          const char *psz_text, const video_format_t *fmt )
 {
     msg_Dbg( p_this,
-             "%s sz %ix%i, of (%i,%i), vsz %ix%i, 4cc %4.4s, sar %i:%i, msk r0x%x g0x%x b0x%x",
+             "%s sz %ix%i, of (%i,%i), vsz %ix%i, 4cc %4.4s, sar %i:%i, msk r0x%x g0x%x b0x%x, multiview %i",
              psz_text,
              fmt->i_width, fmt->i_height, fmt->i_x_offset, fmt->i_y_offset,
              fmt->i_visible_width, fmt->i_visible_height,
              (char*)&fmt->i_chroma,
              fmt->i_sar_num, fmt->i_sar_den,
-             fmt->i_rmask, fmt->i_gmask, fmt->i_bmask );
+             fmt->i_rmask, fmt->i_gmask, fmt->i_bmask, fmt->multiview_mode );
 }
 
 void es_format_Init( es_format_t *fmt,
-- 
