+#ifdef QT_VLC_WAYLAND
+/* Gives the video surface its place on the main window's surface, while the
+ * widget that holds its place is shown and the main window has a surface. */
+void VideoWidget::wlAttach()
+{
+    if( !wlVideo || wlVideo->subsurface || !stable || !stable->isVisible() )
+        return;
+    QWindow *top = stable->window()->windowHandle();
+    if( !top )
+        return;
+    if( top != wlTopWindow )
+    {
+        /* a main window made again (its flags changed) is a new QWindow */
+        if( wlTopWindow )
+            wlTopWindow->removeEventFilter( this );
+        wlTopWindow = top;
+        top->installEventFilter( this );
+    }
+    struct wl_surface *parent = static_cast<struct wl_surface *>(
+        QGuiApplication::platformNativeInterface()->nativeResourceForWindow( "surface", top ) );
+    if( !parent )
+        return; /* hidden: Qt makes its surface again before the next expose */
+    wlVideo->subsurface = wl_subcompositor_get_subsurface( wlVideo->subcompositor,
+                                                           wlVideo->surface, parent );
+    if( !wlVideo->subsurface )
+        return;
+    wl_subsurface_set_desync( wlVideo->subsurface );
+    wlPlace();
+}
+
+/* Takes the video surface off the main window: the widget that holds its place
+ * is hidden, and the main window may destroy its surface next. The surface
+ * stays the video output's, which may draw on it meanwhile. */
+void VideoWidget::wlDetach()
+{
+    if( !wlVideo || !wlVideo->subsurface )
+        return;
+    wl_subsurface_destroy( wlVideo->subsurface );
+    wlVideo->subsurface = NULL;
+}
+
+void VideoWidget::wlPlace()
+{
+    if( !wlVideo || !wlVideo->subsurface || !stable || !stable->isVisible() )
+        return;
+    QWidget *top = stable->window();
+    /* where Qt places its own sub-surfaces: the frame of a client-side
+     * decoration lies in the surface too */
+    const QPoint at = stable->mapTo( top, QPoint( 0, 0 ) );
+    const QMargins frame = top->windowHandle() ? top->windowHandle()->frameMargins() : QMargins();
+    wl_subsurface_set_position( wlVideo->subsurface, at.x() + frame.left(), at.y() + frame.top() );
+    wl_display_dispatch_queue_pending( wlVideo->display, wlVideo->queue );
+    /* a sub-surface's position applies with its parent's next commit */
+    stable->update();
+}
+#endif
