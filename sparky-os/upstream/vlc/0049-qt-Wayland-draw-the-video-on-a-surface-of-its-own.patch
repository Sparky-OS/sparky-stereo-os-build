+#ifdef QT_VLC_WAYLAND
+/* The video output draws on a wl_surface of its own, never on a Qt window's:
+ * Qt 5 destroys a window's wl_surface whenever it hides the window (its
+ * container hidden, a new parent, the page that holds it turned), while the
+ * video output thread goes on drawing on it, and the compositor ends the
+ * connection ("invalid object"). As VLC 4's Wayland compositor does, the
+ * surface is made here, and is a sub-surface of the main window's surface
+ * while the video widget is shown; only that role follows Qt's windows. */
+struct WaylandVideo
+{
+    struct wl_display *display;
+    struct wl_event_queue *queue;
+    struct wl_compositor *compositor;
+    struct wl_subcompositor *subcompositor;
+    struct wl_surface *surface;
+    struct wl_subsurface *subsurface;
+    int scale;
+};
+
+static void WaylandGlobal(void *data, struct wl_registry *registry, uint32_t name,
+                          const char *interface, uint32_t version)
+{
+    WaylandVideo *wl = static_cast<WaylandVideo *>(data);
+
+    /* version 4: damage_buffer, and no preferred scale events to dispatch */
+    if (!strcmp(interface, "wl_compositor") && version >= 4)
+        wl->compositor = static_cast<struct wl_compositor *>(
+            wl_registry_bind(registry, name, &wl_compositor_interface, 4));
+    else if (!strcmp(interface, "wl_subcompositor"))
+        wl->subcompositor = static_cast<struct wl_subcompositor *>(
+            wl_registry_bind(registry, name, &wl_subcompositor_interface, 1));
+}
+
+static void WaylandGlobalRemove(void *, struct wl_registry *, uint32_t)
+{
+}
+
+static void WaylandVideoClose(WaylandVideo *wl, bool surface_done)
+{
+    if (wl->subsurface)
+        wl_subsurface_destroy(wl->subsurface);
+    wl->subsurface = NULL;
+    /* An orphaned video output may still draw: then its surface, and the
+     * queue the surface belongs to, stay until the connection ends. */
+    if (!surface_done)
+        return;
+    if (wl->surface)
+        wl_surface_destroy(wl->surface);
+    if (wl->subcompositor)
+        wl_subcompositor_destroy(wl->subcompositor);
+    if (wl->compositor)
+        wl_compositor_destroy(wl->compositor);
+    wl_event_queue_destroy(wl->queue);
+    delete wl;
+}
+
+static WaylandVideo *WaylandVideoOpen(struct wl_display *display, int scale)
+{
+    WaylandVideo *wl = new WaylandVideo();
+    wl->display = display;
+    wl->scale = scale;
+    wl->queue = wl_display_create_queue(display);
+    if (!wl->queue)
+    {
+        delete wl;
+        return NULL;
+    }
+
+    struct wl_display *wrapper = static_cast<struct wl_display *>(
+        wl_proxy_create_wrapper(display));
+    if (!wrapper)
+    {
+        WaylandVideoClose(wl, true);
+        return NULL;
+    }
+    wl_proxy_set_queue(reinterpret_cast<struct wl_proxy *>(wrapper), wl->queue);
+    struct wl_registry *registry = wl_display_get_registry(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    if (!registry)
+    {
+        WaylandVideoClose(wl, true);
+        return NULL;
+    }
+    static const struct wl_registry_listener listener = {
+        WaylandGlobal, WaylandGlobalRemove
+    };
+    wl_registry_add_listener(registry, &listener, wl);
+    wl_display_roundtrip_queue(display, wl->queue);
+    wl_registry_destroy(registry);
+    if (!wl->compositor || !wl->subcompositor)
+    {
+        WaylandVideoClose(wl, true);
+        return NULL;
+    }
+
+    wl->surface = wl_compositor_create_surface(wl->compositor);
+    if (!wl->surface)
+    {
+        WaylandVideoClose(wl, true);
+        return NULL;
+    }
+    /* The pointer goes through to the main window, where the video widget
+     * takes it as on X11. */
+    struct wl_region *none = wl_compositor_create_region(wl->compositor);
+    if (none)
+    {
+        wl_surface_set_input_region(wl->surface, none);
+        wl_region_destroy(none);
+    }
+    wl_surface_set_buffer_scale(wl->surface, scale);
+    wl_surface_commit(wl->surface);
+    return wl;
+}
+
+/* the buffer scale Qt gives the surfaces of the window that holds the widget */
+static int WaylandScale(const QWidget *widget)
+{
+    const QWindow *top = widget->window()->windowHandle();
+    const QPlatformWindow *platform = top ? top->handle() : NULL;
+    return qMax(1, qRound(platform ? platform->devicePixelRatio()
+                                   : widget->devicePixelRatioF()));
+}
+#endif
