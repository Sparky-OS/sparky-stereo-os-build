From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Fri, 6 Nov 2026 19:30:00 -0300
Subject: [PATCH] opengl: declare the video child of an X11 window to Stereo
 KWin, and take the declaration back when the video closes

On X11 (also through Xwayland) the video of the Qt interface is a child
window of the interface's window, and the video output declared that child
with stereo_declare_x11(), as if it were a top-level window. Stereo KWin
shows the two views of a child one for each eye only when its top-level
window lists it (_KDE_NET_WM_STEREO_CONTENT_CHILDREN, support version 5), so
the declaration was ignored and a 3D video showed one view in both eyes.

Declare the child with stereo_declare_x11_child() (libstereo-declare 1.7.0)
on the nearest ancestor the window manager manages (it carries WM_STATE,
ICCCM 4.1.3.1), and take it back with stereo_remove_x11_child() when the
video output closes, which is also when a 3D video gives way to a 2D one in
the same window. A video window that the window manager manages itself (VLC
without the Qt interface's embedded video) keeps stereo_declare_x11() and
stereo_remove_x11(), as before: the compositor makes such a window hold both
views. Xlib errors from windows that are already gone are ignored for these
calls only.

An X11 child is its own buffer, at the size the interface gave it, and
Stereo KWin shows the views of a declared child in the halves of that
buffer, each at the place of the window. The video output draws one view in
each half; the compositor expands each back once.

When the desktop does not take the declaration (no support version 5, no
managed ancestor, an X error), say so: a message in VLC's log with the
reason, and a dialog, instead of a 3D video shown with one view as if it
worked. The dialog's strings are in the languages of the edition in 3d-0048.

Nothing in VLC upstream declares stereo windows; the change is for VLC
Stereo only.

Assisted-by: Claude Sonnet 5.5 via Claude Code
---
--- a/modules/video_output/opengl/display.c
+++ b/modules/video_output/opengl/display.c
@@ -34,6 +34,8 @@
 #include <vlc_opengl.h>
 #ifdef HAVE_STEREO_DECLARE
 # include <vlc_xlib.h>
+# include <errno.h>
+# include <vlc_dialog.h>
 # include <stereo-declare.h>
 # ifdef VLC_GL_WAYLAND
 #  include <wayland-client.h>
@@ -87,6 +89,7 @@ struct vout_display_sys_t
     picture_pool_t *pool;
 #ifdef HAVE_STEREO_DECLARE
     Display *x11; /* connection the video window is declared with, if any */
+    Window x11_toplevel; /* the window that lists the video window as its child, if it is one */
 # ifdef VLC_GL_WAYLAND
     struct wl_event_queue *stereo_queue;
     struct wp_viewport *viewport;
@@ -127,6 +130,109 @@ static void SetViewSize(vout_display_sys
         logical_height > 0 ? logical_height : 1);
 }
 #endif
+static bool x11_error;
+
+static int IgnoreX11Error (Display *dpy, XErrorEvent *ev)
+{
+    (void) dpy; (void) ev;
+    x11_error = true;
+    return 0;
+}
+
+/**
+ * The managed top-level window that holds the video window: the video window
+ * itself when the window manager manages it (it carries WM_STATE, ICCCM
+ * 4.1.3.1), else its nearest managed ancestor, else the ancestor just below
+ * the root. None when the tree cannot be read.
+ */
+static Window X11Toplevel (Display *x11, Window window)
+{
+    Atom wm_state = XInternAtom (x11, "WM_STATE", True);
+
+    for (Window w = window;;)
+    {
+        Window root, parent, *children;
+        unsigned count;
+
+        if (wm_state != None)
+        {
+            Atom type;
+            int format;
+            unsigned long n, after;
+            unsigned char *data = NULL;
+            if (XGetWindowProperty (x11, w, wm_state, 0, 2, False, wm_state,
+                                    &type, &format, &n, &after, &data) == Success
+             && data != NULL)
+            {
+                XFree (data);
+                if (type == wm_state)
+                    return w;
+            }
+        }
+        if (!XQueryTree (x11, w, &root, &parent, &children, &count))
+            return None;
+        XFree (children);
+        if (parent == None || parent == root)
+            return w;
+        w = parent;
+    }
+}
+
+/**
+ * Declares the video window. A child of the interface's window is declared as
+ * a stereo child of its top-level window, which lists it, so that the
+ * compositor shows its two views, one for each eye, in the place of the video
+ * and everything else the same in both eyes (parent is that top-level
+ * window); a window of its own is declared as a stereo window (parent is
+ * None). Returns 0 or a negative errno value.
+ */
+static int DeclareX11 (Display *x11, Window video, Window *parent)
+{
+    XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+    x11_error = false;
+    int err = 0;
+    unsigned support = stereo_supported_x11 (x11);
+    Window top = X11Toplevel (x11, video);
+    *parent = None;
+    if (top == None)
+        err = -ENOENT;
+    else if (top == video)
+        /* a window of its own: the compositor makes it hold both views */
+        err = support < 3 ? -ENOTSUP
+            : stereo_declare_x11 (x11, video, STEREO_SBS_FULL,
+                                  STEREO_CLASS_VIDEO, STEREO_VIDEO_CURRENT);
+    else if (support < 5)
+        err = -ENOTSUP;
+    else
+    {
+        err = stereo_declare_x11_child (x11, top, video, STEREO_SBS_FULL,
+                                        STEREO_CLASS_VIDEO,
+                                        STEREO_VIDEO_CURRENT, 0, 0);
+        if (err == 0)
+            *parent = top;
+    }
+    XSync (x11, False);
+    if (err == 0 && x11_error)
+        err = -EIO;
+    XSetErrorHandler (previous);
+    return err;
+}
+
+/**
+ * Takes the video window out of the list of its top-level window, if it is a
+ * child, and deletes its declaration. The windows may be gone already.
+ */
+static void RemoveX11 (Display *x11, Window toplevel, Window video)
+{
+    XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+    if (toplevel != None)
+        stereo_remove_x11_child (x11, toplevel, video);
+    else
+        stereo_remove_x11 (x11, video);
+    XSync (x11, False);
+    XSetErrorHandler (previous);
+}
+
 /**
  * Declares the video window to the compositor as full side by side stereo
  * content, left eye first, while a stereoscopic video plays. The compositor
@@ -219,15 +325,23 @@ static void DeclareStereo (vout_display_
     if (x11 == NULL)
         return;
 
-    if (stereo_supported_x11 (x11) >= 3
-     && stereo_declare_x11 (x11, surface->handle.xid, STEREO_SBS_FULL,
-                            STEREO_CLASS_VIDEO, STEREO_VIDEO_CURRENT) == 0)
+    /* The compositor only shows the views of a child window that its
+     * top-level window lists */
+    int err = DeclareX11 (x11, surface->handle.xid, &sys->x11_toplevel);
+    if (err == 0)
     {
         sys->x11 = x11;
         sys->stereo = true;
+        return;
     }
-    else
-        XCloseDisplay (x11);
+    XCloseDisplay (x11);
+    msg_Err (vd, "the desktop did not take the stereo declaration of the "
+                 "video window (%s): this 3D video is shown with one view only",
+             vlc_strerror_c (-err));
+    vlc_dialog_display_error (vd, _("3D video shown flat"),
+        _("The desktop does not take stereo video windows on X11 (Stereo KWin "
+          "does), so only one view of this 3D video is shown. VLC's messages "
+          "say why."));
 }
 
 /**
@@ -237,9 +351,10 @@ static void RemoveStereo (vout_display_s
 {
     if (sys->x11 != NULL)
     {
-        stereo_remove_x11 (sys->x11, surface->handle.xid);
+        RemoveX11 (sys->x11, sys->x11_toplevel, surface->handle.xid);
         XCloseDisplay (sys->x11);
         sys->x11 = NULL;
+        sys->x11_toplevel = None;
     }
 # ifdef VLC_GL_WAYLAND
     if (sys->stereo_queue != NULL)
@@ -280,6 +395,7 @@ static int Open (vlc_object_t *obj)
     sys->pool = NULL;
 #ifdef HAVE_STEREO_DECLARE
     sys->x11 = NULL;
+    sys->x11_toplevel = None;
     sys->stereo = false;
 # ifdef VLC_GL_WAYLAND
     sys->stereo_queue = NULL;
@@ -460,6 +576,23 @@ static void PlaceOnSurface(vout_display_
     *width = cfg->display.width * (sys->stereo ? 2 : 1);
     *height = cfg->display.height;
     *stride = sys->stereo ? cfg->display.width : 0;
+    if (sys->x11 != NULL && sys->x11_toplevel != None)
+    {
+        /* The video window of an X11 window is its own buffer, at the size
+         * the interface gave it, and the compositor shows the two views of a
+         * declared child in the halves of that buffer, each at the place of
+         * the window: draw one view in each half, the compositor stretches
+         * each back once */
+        unsigned half = cfg->display.width / 2;
+        if (half == 0 || cfg->display.width == 0)
+            return;
+        double k = (double)half / cfg->display.width;
+        *width = cfg->display.width;
+        *stride = half;
+        place->x = lround(place->x * k);
+        place->width = __MAX(1u, (unsigned)lround(place->width * k));
+        return;
+    }
     /* Only a viewport tells the compositor the size the views are shown at:
      * an X11 window is its own buffer, at the window's size */
     bool viewport = false;
