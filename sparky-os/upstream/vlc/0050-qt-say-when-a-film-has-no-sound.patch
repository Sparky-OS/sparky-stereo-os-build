+
+/* The real elementary streams of a kind: the choices of its variable, without the "Disable" entry (-1) the input adds to each (ORDER 579) */
+static int CountEs( input_thread_t *p_input, const char *psz_var )
+{
+    vlc_value_t val, text;
+    if( var_Change( p_input, psz_var, VLC_VAR_GETCHOICES, &val, &text ) )
+        return 0;
+    int i_count = 0;
+    for( int i = 0; i < val.p_list->i_count; i++ )
+        if( val.p_list->p_values[i].i_int >= 0 )
+            i_count++;
+    var_FreeList( &val, &text );
+    return i_count;
+}
+
+/* The film has a picture and no audio track now (the rule of Stereo::NoSound::applies, ORDER 579) */
+bool InputManager::NoSoundNow()
+{
+    return hasInput() && CountEs( p_input, "video-es" ) > 0 && CountEs( p_input, "audio-es" ) == 0;
+}
+
+/* A film with a picture and no audio track says so (ORDER 579): the volume control's tooltip, and the picture's own
+ * message once. The rule is the one of Stereo::NoSound::applies in the edition's stereo layer: the tracks are known, there
+ * is a picture and no audio track. The volume control stays usable. */
+void InputManager::UpdateNoSound()
+{
+    bool b_new = NoSoundNow();
+    if( b_new == b_no_sound )
+        return;
+    b_no_sound = b_new;
+    if( !b_new )
+        b_no_sound_told = false;
+    emit noSoundChanged( b_new );
+    UpdateVout();
+}
+
+/* The message of a film without sound, on a subpicture channel of its own, for five seconds (ORDER 579) */
+void InputManager::ShowNoSoundNotice()
+{
+    if( !NoSoundNow() )
+        return;
+    size_t i_vout;
+    vout_thread_t **pp_vout;
+    if( input_Control( p_input, INPUT_GET_VOUTS, &pp_vout, &i_vout ) )
+        return;
+    if( i_vout > 0 )
+    {
+        int i_channel = vout_RegisterSubpictureChannel( pp_vout[0] );
+        vout_OSDText( pp_vout[0], i_channel, SUBPICTURE_ALIGN_TOP | SUBPICTURE_ALIGN_LEFT, 5 * CLOCK_FREQ, _( "This film has no sound." ) );
+    }
+    for( size_t i = 0; i < i_vout; i++ )
+        vlc_object_release( (vlc_object_t*)pp_vout[i] );
+    free( pp_vout );
 }
 
