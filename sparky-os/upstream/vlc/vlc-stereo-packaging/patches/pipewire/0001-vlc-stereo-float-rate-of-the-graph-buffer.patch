 static int Start(audio_output_t *aout, audio_sample_format_t *restrict fmt)
 {
     struct aout_sys_t *sys = aout->sys;
+    unsigned int minimum = var_InheritInteger(aout, "pipewire-audio-rate");
 
-    sys->stream = vlc_pw_stream_create(aout, fmt);
-    return (sys->stream != NULL) ? VLC_SUCCESS : -errno;
+    if (minimum == 0) { /* the rate of the stream */
+        sys->stream = vlc_pw_stream_create(aout, fmt, fmt->i_rate);
+        return (sys->stream != NULL) ? VLC_SUCCESS : -errno;
+    }
+
+    /* The rate that the graph runs at, if it is not lower than the minimum:
+     * the player's resampler is then the only one that touches the audio,
+     * and none when the rates agree. */
+    sys->stream = vlc_pw_stream_create(aout, fmt, 0);
+    if (sys->stream != NULL && vlc_pw_stream_get_rate(sys->stream) < minimum) {
+        vlc_pw_stream_destroy(sys->stream);
+        sys->stream = vlc_pw_stream_create(aout, fmt, minimum);
+    }
+    if (sys->stream == NULL)
+        return -errno;
+
+    fmt->i_rate = vlc_pw_stream_get_rate(sys->stream);
+    return VLC_SUCCESS;
 }
 
