+static bool rate_allowed(const struct aout_sys_t *sys, unsigned int rate)
+{
+    for (size_t i = 0; i < sys->clock.n_allowed; i++)
+        if (sys->clock.allowed[i] == rate)
+            return true;
+    return false;
+}
+
 static int Start(audio_output_t *aout, audio_sample_format_t *restrict fmt)
 {
     struct aout_sys_t *sys = aout->sys;
+    unsigned int minimum = var_InheritInteger(aout, "pipewire-audio-rate");
+
+    if (minimum == 0) { /* the rate of the stream */
+        sys->stream = vlc_pw_stream_create(aout, fmt, fmt->i_rate, false);
+        return (sys->stream != NULL) ? VLC_SUCCESS : -errno;
+    }
+
+    /* The rate that the graph runs at, if it is not lower than the minimum:
+     * the player's resampler is then the only one that touches the audio,
+     * and none when the rates agree. The rate of the graph is the one that
+     * the server publishes: the forced one, or else its default, or else the
+     * rate of the stream when the graph can switch to it. */
+    unsigned int target = 0;
+    bool switch_rate = false;
 
-    sys->stream = vlc_pw_stream_create(aout, fmt);
-    return (sys->stream != NULL) ? VLC_SUCCESS : -errno;
+    vlc_pw_lock(sys->context);
+    if (sys->clock.force_rate != 0)
+        target = sys->clock.force_rate;
+    else if (fmt->i_rate >= minimum && rate_allowed(sys, fmt->i_rate)) {
+        target = fmt->i_rate;
+        switch_rate = target != sys->clock.rate;
+    } else
+        target = sys->clock.rate;
+    vlc_pw_unlock(sys->context);
+
+    if (target == 0) { /* no settings: what an unconstrained stream gets */
+        sys->stream = vlc_pw_stream_create(aout, fmt, 0, false);
+        if (sys->stream != NULL
+         && vlc_pw_stream_get_rate(sys->stream) < minimum) {
+            vlc_pw_stream_destroy(sys->stream);
+            sys->stream = vlc_pw_stream_create(aout, fmt, minimum, false);
+        }
+    } else
+        sys->stream = vlc_pw_stream_create(aout, fmt,
+                                           target < minimum ? minimum : target,
+                                           switch_rate);
+    if (sys->stream == NULL)
+        return -errno;
+
+    fmt->i_rate = vlc_pw_stream_get_rate(sys->stream);
+    return VLC_SUCCESS;
 }
 
