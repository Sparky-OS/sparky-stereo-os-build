+/**
+ * The clock of the graph: clock.force-rate when it is not zero, otherwise
+ * clock.rate, and clock.allowed-rates, which says whether the graph can run at
+ * the rate of a stream. The server publishes them in its "settings" metadata.
+ */
+static int settings_property(void *data, uint32_t subject, const char *key,
+                             const char *type, const char *value)
+{
+    struct aout_sys_t *sys = data;
+
+    (void) type;
+    if (subject != PW_ID_CORE || key == NULL)
+        return 0;
+
+    if (!strcmp(key, "clock.force-rate"))
+        sys->clock.force_rate = (value != NULL) ? strtoul(value, NULL, 10) : 0;
+    else if (!strcmp(key, "clock.rate"))
+        sys->clock.rate = (value != NULL) ? strtoul(value, NULL, 10) : 0;
+    else if (!strcmp(key, "clock.allowed-rates")) {
+        sys->clock.n_allowed = 0;
+        while (value != NULL && *value != '\0') {
+            char *end;
+            unsigned long rate = strtoul(value, &end, 10);
+
+            if (end == value) { /* a bracket or a space */
+                value++;
+                continue;
+            }
+            if (sys->clock.n_allowed < ARRAY_SIZE(sys->clock.allowed))
+                sys->clock.allowed[sys->clock.n_allowed++] = rate;
+            value = end;
+        }
+    }
+    return 0;
+}
+
+static const struct pw_metadata_events settings_events = {
+    PW_VERSION_METADATA_EVENTS,
+    .property = settings_property,
+};
