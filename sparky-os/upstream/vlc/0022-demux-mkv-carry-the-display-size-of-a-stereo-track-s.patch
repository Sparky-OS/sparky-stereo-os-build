From 1fb2d4f8fcad7cae277b17bf62b3417bbd834956 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Wed, 14 Oct 2026 23:32:06 -0300
Subject: [PATCH 1/3] demux: mkv: carry the display size of a stereo track's
 plane

The size of one view of a packed 3D frame is Matroska's DisplayWidth and
DisplayHeight (RFC 9559 section 18.10), but the demuxer folds it into the
sample aspect ratio, so nothing later can tell whether a side by side track
holds full or half views. Keep the size, in pixels, in the video format.

Assisted-by: Claude Sonnet via Claude Code
---
 include/vlc_es.h                             | 2 ++
 modules/demux/mkv/matroska_segment_parse.cpp | 7 +++++++
 2 files changed, 9 insertions(+)

diff --git a/include/vlc_es.h b/include/vlc_es.h
index ad5d0d7..933139e 100644
--- a/include/vlc_es.h
+++ b/include/vlc_es.h
@@ -360,6 +360,8 @@ struct video_format_t
     video_chroma_location_t chroma_location;      /**< YCbCr chroma location */
 
     video_multiview_mode_t multiview_mode;        /** Multiview mode, 2D, 3D */
+    unsigned int i_stereo_plane_width;            /**< size of one view of a packed 3D frame as the container states it (Matroska DisplayWidth), 0 if not stated */
+    unsigned int i_stereo_plane_height;           /**< likewise for the height */
 
     video_projection_mode_t projection_mode;            /**< projection mode */
     vlc_viewpoint_t pose;
diff --git a/modules/demux/mkv/matroska_segment_parse.cpp b/modules/demux/mkv/matroska_segment_parse.cpp
index a458bca..1f6d417 100644
--- a/modules/demux/mkv/matroska_segment_parse.cpp
+++ b/modules/demux/mkv/matroska_segment_parse.cpp
@@ -549,6 +549,13 @@ void matroska_segment_c::ParseTrackEntry( const KaxTrackEntry *m )
             if (i_display_unit == 0 && i_display_height == 0)
                 i_display_height = tk->fmt.video.i_height;
 
+            /* The size of one plane of a packed 3D frame (RFC 9559, section 18.10) */
+            if (i_display_unit == 0)
+            {
+                tk->fmt.video.i_stereo_plane_width  = i_display_width;
+                tk->fmt.video.i_stereo_plane_height = i_display_height;
+            }
+
             if (i_display_height && i_display_width)
             {
                 switch (i_display_unit)
