diff --git a/modules/video_output/opengl/vout_helper.c b/modules/video_output/opengl/vout_helper.c
index 95e1de5..e5af6e5 100644
--- a/modules/video_output/opengl/vout_helper.c
+++ b/modules/video_output/opengl/vout_helper.c
@@ -1997,9 +1997,12 @@ int vout_display_opengl_Display(vout_display_opengl_t *vgl,
     }
 
     /* Read once for both views, so that a change cannot give both eyes the
-     * same view */
+     * same view. The decoder already applied the correction stored with the
+     * file when the input opened (stereo-swap-eyes-base): show the
+     * difference. */
     const bool swap_eyes = stereo
-                        && var_InheritBool(vgl->gl, "stereo-swap-eyes");
+        && var_InheritBool(vgl->gl, "stereo-swap-eyes")
+           != var_InheritBool(vgl->gl, "stereo-swap-eyes-base");
     for (unsigned eye = 0; eye < (stereo ? 2 : 1); eye++)
     {
         int ret = DisplayView(vgl, source, eye, swap_eyes);
diff --git a/src/input/decoder.c b/src/input/decoder.c
index 91af4ad..73357e1 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -530,22 +530,13 @@ static char *StereoFileName( decoder_t *p_dec )
 }
 
 /* The correction the user stored with a local file whose eyes are the wrong
- * way round. */
+ * way round, as it was when the input opened: a correction made while it
+ * plays is the video output's to show. */
 static bool StereoFileSwap( decoder_t *p_dec )
 {
     input_thread_t *p_input = p_dec->p_owner->p_input;
-    input_item_t *p_item = p_input != NULL ? input_GetItem( p_input ) : NULL;
-
-    if( p_item == NULL || p_item->psz_uri == NULL )
-        return false;
-
-    char *psz_path = vlc_uri2path( p_item->psz_uri );
-    if( psz_path == NULL )
-        return false;
 
-    bool b_swap = stereo_policy_file_swap_eyes( psz_path ) == 1;
-    free( psz_path );
-    return b_swap;
+    return p_input != NULL && var_GetBool( p_input, "stereo-file-swap" );
 }
 
