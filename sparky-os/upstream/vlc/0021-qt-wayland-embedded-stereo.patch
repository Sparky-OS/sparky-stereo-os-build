From: Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>
Subject: [PATCH] qt, opengl: embed full stereo views in a native Wayland child

Keep video in the main player window. Qt owns the native child and input,
the video output declares and sizes its two-eye buffer through its own
Wayland event queue, and KWin composes the surrounding 2D controls once.
The viewport destination is one logical view, including the Qt scale.

Assisted-by: OpenAI Codex

--- a/configure.ac
+++ b/configure.ac
@@ -3934,6 +3934,12 @@
       QT_PATH="$(eval $PKG_CONFIG --variable=exec_prefix Qt5Core)"
       QT_HOST_PATH="$(eval $PKG_CONFIG --variable=host_bins Qt5Core)"
       QT_VERSION="$(eval $PKG_CONFIG --modversion Qt5Gui)"
+      qt5_headers="$($PKG_CONFIG --variable=includedir Qt5Gui)"
+      AS_IF([test -f "${qt5_headers}/QtGui/${QT_VERSION}/QtGui/qpa/qplatformnativeinterface.h"], [
+        QT_GUI_PRIVATE_CFLAGS="-I${qt5_headers}/QtGui/${QT_VERSION}/QtGui -I${qt5_headers}/QtGui/${QT_VERSION} -I${qt5_headers}/QtCore/${QT_VERSION}"
+        AC_SUBST([QT_GUI_PRIVATE_CFLAGS])
+        have_qt_gui_private="yes"
+      ])
       AC_PATH_PROGS(MOC, [moc-qt5 moc], moc, ["${QT_HOST_PATH}" "${QT_PATH}/bin"])
       AC_PATH_PROGS(RCC, [rcc-qt5 rcc], rcc, ["${QT_HOST_PATH}" "${QT_PATH}/bin"])
       AC_PATH_PROGS(UIC, [uic-qt5 uic], uic, ["${QT_HOST_PATH}" "${QT_PATH}/bin"])
