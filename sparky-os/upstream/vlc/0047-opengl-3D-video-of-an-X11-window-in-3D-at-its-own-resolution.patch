+/**
+ * After the OpenGL surface is gone: the window of the video output's own and
+ * the connection.
+ */
+static void CloseX11 (vout_display_sys_t *sys, vout_window_t *surface)
+{
+    if (sys->x11 == NULL)
+        return;
+    XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+    if (sys->x11_view != None)
+    {
+        XDestroyWindow (sys->x11, sys->x11_view);
+        var_Destroy (surface, "gl-x11-window");
+        sys->x11_view = None;
+    }
+    XSync (sys->x11, False);
+    XSetErrorHandler (previous);
+    XCloseDisplay (sys->x11);
+    sys->x11 = NULL;
+}
+
+/**
+ * The OpenGL surface's size, and the size of the window of the video
+ * output's own, which is the surface on X11.
+ */
+static void ResizeSurface (vout_display_sys_t *sys, unsigned width, unsigned height)
+{
+    vlc_gl_Resize (sys->gl, width, height);
+    if (sys->x11_view != None && width > 0 && height > 0)
+    {
+        XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+        XResizeWindow (sys->x11, sys->x11_view, width, height);
+        XSync (sys->x11, False);
+        XSetErrorHandler (previous);
+    }
+}
+
+/**
+ * The size one view is shown at, for the window of the video output's own.
+ */
+static void SetX11ViewSize (vout_display_sys_t *sys, unsigned width, unsigned height)
+{
+    if (sys->x11_mode != X11_OWN || width == 0 || height == 0)
+        return;
+    XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+    stereo_declare_x11_one_view_size (sys->x11, sys->x11_view, width, height);
+    XSync (sys->x11, False);
+    XSetErrorHandler (previous);
+}
+#else
+static void ResizeSurface (vout_display_sys_t *sys, unsigned width, unsigned height)
+{
+    vlc_gl_Resize (sys->gl, width, height);
+}
 #endif
 
