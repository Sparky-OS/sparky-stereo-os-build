+static int IgnoreX11Error (Display *dpy, XErrorEvent *ev)
+{
+    (void) dpy; (void) ev;
+    x11_error = true;
+    return 0;
+}
+
+/**
+ * The managed top-level window that holds the video window: the video window
+ * itself when the window manager manages it (it carries WM_STATE, ICCCM
+ * 4.1.3.1), else its nearest managed ancestor, else the ancestor just below
+ * the root. None when the tree cannot be read.
+ */
+static Window X11Toplevel (Display *x11, Window window)
+{
+    Atom wm_state = XInternAtom (x11, "WM_STATE", True);
+
+    for (Window w = window;;)
+    {
+        Window root, parent, *children;
+        unsigned count;
+
+        if (wm_state != None)
+        {
+            Atom type;
+            int format;
+            unsigned long n, after;
+            unsigned char *data = NULL;
+            if (XGetWindowProperty (x11, w, wm_state, 0, 2, False, wm_state,
+                                    &type, &format, &n, &after, &data) == Success
+             && data != NULL)
+            {
+                XFree (data);
+                if (type == wm_state)
+                    return w;
+            }
+        }
+        if (!XQueryTree (x11, w, &root, &parent, &children, &count))
+            return None;
+        XFree (children);
+        if (parent == None || parent == root)
+            return w;
+        w = parent;
+    }
+}
+
+static bool StereoMultiview (const video_format_t *fmt)
+{
+    switch (fmt->multiview_mode)
+    {
+        case MULTIVIEW_STEREO_SBS:
+        case MULTIVIEW_STEREO_SBS_RIGHT_FIRST:
+        case MULTIVIEW_STEREO_TB:
+        case MULTIVIEW_STEREO_TB_RIGHT_FIRST:
+        case MULTIVIEW_STEREO_ROW:
+        case MULTIVIEW_STEREO_ROW_RIGHT_FIRST:
+        case MULTIVIEW_STEREO_COL:
+        case MULTIVIEW_STEREO_COL_RIGHT_FIRST:
+        case MULTIVIEW_STEREO_CHECKERBOARD:
+        case MULTIVIEW_STEREO_CHECKERBOARD_RIGHT_FIRST:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static void FlatNotice (vout_display_t *vd, const char *why)
+{
+    msg_Err (vd, "the desktop did not take the stereo declaration of the "
+                 "video window (%s): this 3D video is not shown in 3D",
+             why);
+    vlc_dialog_display_error (vd, _("3D video shown flat"),
+        _("The desktop does not take stereo video windows (Stereo KWin does), "
+          "so this 3D video is not shown in 3D. VLC's messages say why."));
+}
+
+static void ReducedNotice (vout_display_t *vd, const char *why)
+{
+    msg_Warn (vd, "the desktop does not place the views of a video window one "
+                  "by one (%s): this 3D video is shown at half its width", why);
+    vlc_dialog_display_error (vd, _("3D video shown at reduced width"),
+        _("The desktop does not place a video window's views one by one "
+          "(Stereo KWin does), so each view of this 3D video is shown at half "
+          "its width. VLC's messages say why."));
+}
+
+/**
+ * Before the OpenGL surface exists: a video window that is a child of the
+ * interface's window gets a window of the video output's own, inside it, to
+ * draw on, when the desktop places the views of a child one by one (support
+ * version 8). The window holds the two views at the resolution they have, and
+ * the video window of the interface, whose size the interface reads, is left
+ * alone. The OpenGL modules draw on it through "gl-x11-window".
+ */
+static void PrepareX11 (vout_display_t *vd, vout_window_t *surface)
+{
+    vout_display_sys_t *sys = vd->sys;
+
+    if (surface->type != VOUT_WINDOW_TYPE_XID || !StereoMultiview (&vd->fmt)
+     || !vlc_xlib_init (VLC_OBJECT(vd)))
+        return;
+
+    Display *x11 = XOpenDisplay (surface->display.x11);
+    if (x11 == NULL)
+        return;
+    sys->x11 = x11;
+
+    XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+    x11_error = false;
+    sys->x11_support = stereo_supported_x11 (x11);
+    Window top = X11Toplevel (x11, surface->handle.xid);
+    if (top != None && top != surface->handle.xid && sys->x11_support >= 8)
+    {
+        XSetWindowAttributes swa;
+        swa.event_mask = 0; /* the pointer and keys go on to the video window */
+        unsigned w = __MAX(vd->cfg->display.width, 1u) * 2;
+        unsigned h = __MAX(vd->cfg->display.height, 1u);
+        Window view = XCreateWindow (x11, surface->handle.xid, 0, 0, w, h, 0,
+                                     CopyFromParent, InputOutput,
+                                     CopyFromParent, CWEventMask, &swa);
+        XMapWindow (x11, view);
+        XSync (x11, False);
+        if (!x11_error)
+        {
+            sys->x11_view = view;
+            var_Create (surface, "gl-x11-window", VLC_VAR_INTEGER);
+            var_SetInteger (surface, "gl-x11-window", view);
+        }
+        else
+            XDestroyWindow (x11, view);
+    }
+    XSetErrorHandler (previous);
+}
+
+/**
+ * Declares the video window of an X11 window. A child of the interface's
+ * window is declared as a stereo child of its top-level window, which lists
+ * it, so that the compositor shows its two views, one for each eye, in the
+ * place of the video and everything else the same in both eyes: the window of
+ * the video output's own with the size one view is shown at (support version
+ * 8), else the video window with one view in each half of it; a window of its
+ * own is declared as a stereo window. Returns 0 or a negative errno value.
+ */
+static int DeclareX11 (vout_display_t *vd, vout_window_t *surface)
+{
+    vout_display_sys_t *sys = vd->sys;
+    Display *x11 = sys->x11;
+    const Window video = surface->handle.xid;
+    XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+    x11_error = false;
+    int err = 0;
+    Window top = X11Toplevel (x11, video);
+    unsigned w = __MAX(vd->cfg->display.width, 1u);
+    unsigned h = __MAX(vd->cfg->display.height, 1u);
+
+    sys->x11_mode = X11_NONE;
+    sys->x11_toplevel = None;
+    if (top == None)
+        err = -ENOENT;
+    else if (top == video)
+    {
+        /* a window of its own: the compositor makes it hold both views */
+        err = sys->x11_support < 3 ? -ENOTSUP
+            : stereo_declare_x11 (x11, video, STEREO_SBS_FULL,
+                                  STEREO_CLASS_VIDEO, STEREO_VIDEO_CURRENT);
+        if (err == 0)
+            sys->x11_mode = X11_TOPLEVEL;
+    }
+    else if (sys->x11_view != None)
+    {
+        err = stereo_declare_x11_child (x11, top, sys->x11_view,
+                                        STEREO_SBS_FULL, STEREO_CLASS_VIDEO,
+                                        STEREO_VIDEO_CURRENT, w, h);
+        if (err == 0)
+            sys->x11_mode = X11_OWN;
+    }
+    else if (sys->x11_support < 5)
+        err = -ENOTSUP;
+    else
+    {
+        err = stereo_declare_x11_child (x11, top, video, STEREO_SBS_FULL,
+                                        STEREO_CLASS_VIDEO,
+                                        STEREO_VIDEO_CURRENT, 0, 0);
+        if (err == 0)
+            sys->x11_mode = X11_HALVES;
+    }
+    if (err == 0)
+        sys->x11_toplevel = (sys->x11_mode == X11_TOPLEVEL) ? None : top;
+    XSync (x11, False);
+    if (err == 0 && x11_error)
+        err = -EIO;
+    XSetErrorHandler (previous);
+    return err;
+}
+
+/**
+ * Takes the video window out of the list of its top-level window, if it is a
+ * child, and deletes its declaration. The windows may be gone already.
+ */
+static void RemoveX11 (Display *x11, Window toplevel, Window video)
+{
+    XErrorHandler previous = XSetErrorHandler (IgnoreX11Error);
+    if (toplevel != None)
+        stereo_remove_x11_child (x11, toplevel, video);
+    else
+        stereo_remove_x11 (x11, video);
+    XSync (x11, False);
+    XSetErrorHandler (previous);
+}
