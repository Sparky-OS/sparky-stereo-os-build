+/**
+ * @file x11-window.h
+ * @brief The X11 window an OpenGL surface is drawn on
+ */
+#ifndef VLC_GL_X11_WINDOW_H
+#define VLC_GL_X11_WINDOW_H 1
+
+#include <vlc_common.h>
+#include <vlc_vout_window.h>
+
+/**
+ * The window the surface is drawn on: the window of its own that the OpenGL
+ * video output made inside the video window and told in "gl-x11-window",
+ * else the video window itself.
+ */
+static inline unsigned long vlc_gl_x11_window(vout_window_t *wnd)
+{
+    vlc_object_t *obj = VLC_OBJECT(wnd);
+
+    if (var_Type(obj, "gl-x11-window") & VLC_VAR_INTEGER)
+    {
+        unsigned long xid = var_GetInteger(obj, "gl-x11-window");
+        if (xid != 0)
+            return xid;
+    }
+    return wnd->handle.xid;
+}
+
+#endif
