From 5f9ff3be27527612ca6dd3a24764139721975284 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 5 Oct 2026 13:57:25 -0300
Subject: [PATCH 16/17] soxr: prefer it to the other audio resamplers

The SoX resampler had the lowest priority of the resamplers, so it was
only used when asked for by name and the default pick was libsamplerate,
the band-limited or the plain resampler. Raise it above libsamplerate so
that the very high quality default applies without a command line
option. --audio-resampler still selects any resampler.

Assisted-by: Claude Sonnet via Claude Code
---
 modules/audio_filter/resampler/soxr.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/modules/audio_filter/resampler/soxr.c b/modules/audio_filter/resampler/soxr.c
index 749d5ae8c9..b4b2ef46d9 100644
--- a/modules/audio_filter/resampler/soxr.c
+++ b/modules/audio_filter/resampler/soxr.c
@@ -75,7 +75,7 @@ vlc_module_begin ()
     set_callbacks( OpenConverter, Close )
 
     add_submodule()
-    set_capability( "audio resampler", 0 )
+    set_capability( "audio resampler", 60 )
     set_callbacks( OpenResampler, Close )
     add_shortcut( "soxr" )
 vlc_module_end ()
