From f792b5eb0b6d90b82379ac25e4dafe6847047137 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Thu, 15 Oct 2026 08:30:48 -0300
Subject: [PATCH 26/26] upnp: take the event pointer's constness from
 Upnp_FunPtr

libupnp 1.8 made the event pointer const and later releases (1.18) went
back to void *. Deriving the type from Upnp_FunPtr builds with both
without -fpermissive.

Assisted-by: Claude Sonnet via Claude Code
---
 modules/services_discovery/upnp.hpp | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/modules/services_discovery/upnp.hpp b/modules/services_discovery/upnp.hpp
index 352079c..aaf4c98 100644
--- a/modules/services_discovery/upnp.hpp
+++ b/modules/services_discovery/upnp.hpp
@@ -35,11 +35,11 @@
 
 #include <vlc_common.h>
 
-#if UPNP_VERSION < 10800
-typedef void* UpnpEventPtr;
-#else
-typedef const void* UpnpEventPtr;
-#endif
+/* libupnp changed the constness of the event pointer between releases:
+ * take it from Upnp_FunPtr itself. */
+template <typename R, typename T, typename E, typename C>
+E UpnpEventPtrOf( R (*)( T, E, C ) );
+typedef decltype( UpnpEventPtrOf( static_cast<Upnp_FunPtr>( nullptr ) ) ) UpnpEventPtr;
 
 namespace SD
 {
