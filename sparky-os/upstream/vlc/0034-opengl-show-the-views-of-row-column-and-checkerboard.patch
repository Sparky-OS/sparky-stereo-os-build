--- a/src/video_output/video_output.c
+++ b/src/video_output/video_output.c
@@ -1028,6 +1028,12 @@ static int ThreadDisplayRenderPicture(vout_thread_t *vout, bool is_forced)
             case MULTIVIEW_STEREO_SBS_RIGHT_FIRST:
