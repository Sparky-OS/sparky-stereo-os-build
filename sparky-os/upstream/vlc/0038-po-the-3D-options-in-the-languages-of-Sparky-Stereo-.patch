+
+#: src/libvlc-module.c
+msgid "Column interleaved, right eye first"
+msgstr "Spaltenweise verschachtelt, rechtes Auge zuerst"
+
+#: src/libvlc-module.c
+msgid "Checkerboard"
+msgstr "Schachbrett"
+
+#: src/libvlc-module.c
+msgid "Checkerboard, right eye first"
+msgstr "Schachbrett, rechtes Auge zuerst"
+
+#: src/libvlc-module.c
+msgid "Frame sequential"
+msgstr "Bildsequenziell"
+
+#: src/libvlc-module.c
+msgid "Frame sequential, right eye first"
+msgstr "Bildsequenziell, rechtes Auge zuerst"
