+// Copyright (C) 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QQUICKVIDEOSTEREOLAYER_P_H
+#define QQUICKVIDEOSTEREOLAYER_P_H
+
+//
+//  W A R N I N G
+//  -------------
+//
+// This file is not part of the Qt API.  It exists purely as an
+// implementation detail.  This header file may change from version to
+// version without notice, or even be removed.
+//
+// We mean it.
+//
+
+#include <QtCore/qrect.h>
+#include <QtGui/qimage.h>
+#include <QtMultimedia/qvideoframeformat.h>
+#include <QtMultimediaQuick/private/qquickvideostereo_p.h>
+
+#include <memory>
+
+QT_BEGIN_NAMESPACE
+
+class QWindow;
+
+// The 3D area of a window as a surface of its own, under the window's: a Wayland subsurface that
+// holds both views of a stereoscopic 3D video side by side, left first, and is declared to the
+// compositor as full side by side stereo content (kde_stereo_content_manager_v1) so that the
+// compositor shows each view to its eye, while the window's own surface keeps the controls over
+// it, the same in both eyes (the separation of the 2D part from the 3D area).
+//
+// The window has to have an alpha buffer from its creation, and its scene graph has to leave the
+// area transparent, for the layer to be seen under the window's surface. The functions may be
+// called from any thread, but not at the same time.
+class QQuickVideoStereoLayer
+{
+public:
+    // Whether this compositor has what the layer needs: wl_subcompositor, wp_viewporter, wl_shm and
+    // the stereo content declaration
+    static bool isSupported();
+    static std::unique_ptr<QQuickVideoStereoLayer> create(QWindow *window);
+
+    ~QQuickVideoStereoLayer();
+
+    // The buffer format of the layer: the one asked for if wl_shm offers it, else the deepest
+    // wl_shm offers that is not deeper, else 8 bits
+    QQuickVideoStereo::BufferFormat chooseFormat(QQuickVideoStereo::BufferFormat wanted) const;
+
+    // The rectangle of one view in the window's surface, in logical pixels
+    void setRect(const QRect &rect);
+
+    // Shows the two views, each as large as the image; both images have the same size
+    void present(const QImage &left, const QImage &right, QQuickVideoStereo::BufferFormat format);
+    // Takes the layer off the screen until the next present()
+    void hide();
+
+    // The color description of the video, for the compositor where it takes one
+    struct Color
+    {
+        QVideoFrameFormat::ColorSpace space = QVideoFrameFormat::ColorSpace_Undefined;
+        QVideoFrameFormat::ColorTransfer transfer = QVideoFrameFormat::ColorTransfer_Unknown;
+        QVideoFrameFormat::ColorRange range = QVideoFrameFormat::ColorRange_Unknown;
+        float maxLuminance = -1; // of the mastering display, cd/m2, if the stream says
+    };
+    void setColor(const Color &color);
+    // Whether the compositor takes color descriptions
+    bool hasColorManagement() const;
+    // Whether a video with this color description can be shown in a layer: SDR video in the
+    // primaries of BT.709 needs no description, the other needs the compositor to take it;
+    // otherwise the layer would show its code values as sRGB
+    static bool canDescribe(const Color &color);
+
+private:
+    QQuickVideoStereoLayer();
+    struct Private;
+    std::unique_ptr<Private> d;
+};
+
+QT_END_NAMESPACE
+
+#endif
diff --git a/src/multimediaquick/qquickvideostereopresenter.cpp b/src/multimediaquick/qquickvideostereopresenter.cpp
new file mode 100644
index 000000000..a501c7531
--- /dev/null
+++ b/src/multimediaquick/qquickvideostereopresenter.cpp
@@ -0,0 +1,152 @@
+// Copyright (C) 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qquickvideostereopresenter_p.h"
+
+#include <QtMultimedia/private/qvideoframeconverter_p.h>
+#include <QtCore/qloggingcategory.h>
+#include <QtCore/qfloat16.h>
+
+#include <algorithm>
+#include <vector>
+
+QT_BEGIN_NAMESPACE
+
+Q_STATIC_LOGGING_CATEGORY(qLcStereoPresenter, "qt.multimedia.video.stereopresenter")
+
+using namespace QQuickVideoStereo;
+using Mode = QVideoFrameFormat::StereoMode;
+
+QQuickVideoStereoPresenter::QQuickVideoStereoPresenter(QWindow *window)
+    : m_window(window)
+{
+    start();
+    QMutexLocker lock(&m_mutex);
+    while (!m_created)
+        m_condition.wait(&m_mutex);
+}
+
+QQuickVideoStereoPresenter::~QQuickVideoStereoPresenter()
+{
+    {
+        QMutexLocker lock(&m_mutex);
+        m_stopping = true;
+        m_condition.wakeAll();
+    }
+    wait();
+}
+
+void QQuickVideoStereoPresenter::setRect(const QRect &rect)
+{
+    if (m_valid)
+        m_layer->setRect(rect);
+}
+
+void QQuickVideoStereoPresenter::hide()
+{
+    if (m_valid)
+        m_layer->hide();
+}
+
+void QQuickVideoStereoPresenter::submit(Job job)
+{
+    QMutexLocker lock(&m_mutex);
+    // only the newest frame is kept, when the video is faster than the conversion
+    m_pending = std::move(job);
+    m_hasPending = true;
+    m_condition.wakeAll();
+}
+
+void QQuickVideoStereoPresenter::run()
+{
+    m_layer = QQuickVideoStereoLayer::create(m_window);
+    {
+        QMutexLocker lock(&m_mutex);
+        m_valid = m_layer != nullptr;
+        m_created = true;
+        m_condition.wakeAll();
+    }
+    while (m_valid) {
+        Job job;
+        {
+            QMutexLocker lock(&m_mutex);
+            while (!m_hasPending && !m_stopping)
+                m_condition.wait(&m_mutex);
+            if (m_stopping)
+                break;
+            job = std::move(m_pending);
+            m_pending = {};
+            m_hasPending = false;
+        }
+        process(job);
+    }
+    m_layer.reset();
+}
+
+void QQuickVideoStereoPresenter::process(Job &job)
+{
+    const QVideoFrameFormat format = job.frame.surfaceFormat();
+    const QImage image = qImageFromVideoFrame(
+            job.frame, job.wide ? QVideoFrameImageDepth::Float32 : QVideoFrameImageDepth::Float16);
+    if (image.isNull())
+        return;
+    job.frame = {};
+
+    // which of the packing's views is for the left eye
+    const bool rightFirst = job.packing.rightEyeFirst != job.swapEyes;
+    QImage left, right;
+    if (job.packing.mode == Mode::FrameSequence) {
+        // each frame is one view (frameView is the eye of the first), the other frame is the other eye's
+        const QImage other = qImageFromVideoFrame(
+                job.otherFrame, job.wide ? QVideoFrameImageDepth::Float32 : QVideoFrameImageDepth::Float16);
+        QImage mine = extractView(image, job.packing, 0, job.scaling);
+        QImage theirs = extractView(other, job.packing, 0, job.scaling);
+        if (mine.isNull() || theirs.isNull() || mine.size() != theirs.size())
+            return;
+        left = job.frameView == 0 ? mine : theirs;
+        right = job.frameView == 0 ? theirs : mine;
+    } else {
+        left = extractView(image, job.packing, rightFirst ? 1 : 0, job.scaling);
+        right = extractView(image, job.packing, rightFirst ? 0 : 1, job.scaling);
+    }
+    if (left.isNull() || right.isNull())
+        return;
+
+    const BufferFormat bufferFormat = m_layer->chooseFormat(job.format);
+    m_layer->setColor({ format.colorSpace(), format.colorTransfer(), format.colorRange(), format.maxLuminance() });
+    m_layer->present(left, right, bufferFormat);
+
+    if (qLcStereoPresenter().isDebugEnabled()) {
+        // the number of different levels of red in each view as the buffer holds them
+        auto halfBits = [](float v) {
+            const qfloat16 h(v);
+            quint16 bits;
+            memcpy(&bits, &h, sizeof bits);
+            return int(bits);
+        };
+        auto levels = [bufferFormat, halfBits](const QImage &view) {
+            std::vector<bool> seen(65536, false);
+            for (int y = 0; y < view.height(); ++y) {
+                const float *line = reinterpret_cast<const float *>(view.constScanLine(y));
+                for (int x = 0; x < view.width(); ++x) {
+                    const float v = std::clamp(line[x * 4], 0.f, 1.f);
+                    const int q = bufferFormat == BufferFormat::Xrgb8888 ? int(v * 255.f + 0.5f)
+                            : bufferFormat == BufferFormat::Xrgb2101010 ? int(v * 1023.f + 0.5f)
+                            : bufferFormat == BufferFormat::Xbgr16161616 ? int(v * 65535.f + 0.5f)
+                            : halfBits(v);
+                    seen[q] = true;
+                }
+            }
+            return std::count(seen.begin(), seen.end(), true);
+        };
+        qCDebug(qLcStereoPresenter) << "frame" << format.frameSize() << "image" << image.size() << "packing"
+                                    << int(job.packing.mode) << int(job.packing.size) << "right first" << job.packing.rightEyeFirst << "swap" << job.swapEyes << "frame eye" << job.frameView << "stereo view" << int(format.stereoView()) << "view" << left.size() << "format"
+                                    << (bufferFormat == BufferFormat::Xrgb8888 ? "XRGB8888"
+                                        : bufferFormat == BufferFormat::Xrgb2101010 ? "XRGB2101010"
+                                        : bufferFormat == BufferFormat::Xbgr16161616 ? "XBGR16161616" : "XBGR16161616F")
+                                    << "pixel format" << format.pixelFormat() << "levels of red, left" << levels(left)
+                                    << "right" << levels(right);
+    }
+}
+
+QT_END_NAMESPACE
