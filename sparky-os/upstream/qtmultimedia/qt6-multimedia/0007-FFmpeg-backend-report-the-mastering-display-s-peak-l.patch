From 7faaee5fb202cfbdbc3179f220b423247b1e8f9c Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Wed, 7 Oct 2026 19:44:30 -0300
Subject: [PATCH 4/4] FFmpeg backend: report the mastering display's peak
 luminance in nits

QVideoFrameFormat::maxLuminance() is the maximum luminance of the mastering display in
nits, and the shaders divide it by 100 (SDR white) to tone map PQ and HLG video to
the output. The FFmpeg backend filled it by multiplying AVMasteringDisplayMetadata's
max_luminance by 10000, which would be right for ST 2086's unit of 0.0001 cd/m2, but
FFmpeg's field is a rational in cd/m2 already (10000000/10000 for a display of
1000 cd/m2): a video mastered at 1000 nits reported 10000000, so the tone mapper
was given a peak 10^4 times too high.

Use the rational as it is, and only when has_luminance says it is set. The test plays
a HEVC file made with x265's --master-display "...L(10000000,1)" and expects 1000.
It failed before with 1e+07.

Assisted-by: Claude Sonnet via Claude Code
---
 .../multimedia/ffmpeg/qffmpegvideobuffer.cpp  |   5 +++-
 .../qvideoframebackend/CMakeLists.txt         |   1 +
 .../testdata/mastering_1000nits.mp4           | Bin 0 -> 6938 bytes
 .../tst_qvideoframebackend.cpp                |  25 ++++++++++++++++++
 4 files changed, 30 insertions(+), 1 deletion(-)
 create mode 100644 tests/auto/integration/qvideoframebackend/testdata/mastering_1000nits.mp4

diff --git a/src/plugins/multimedia/ffmpeg/qffmpegvideobuffer.cpp b/src/plugins/multimedia/ffmpeg/qffmpegvideobuffer.cpp
index 1c7702a84..de4fe3d6a 100644
--- a/src/plugins/multimedia/ffmpeg/qffmpegvideobuffer.cpp
+++ b/src/plugins/multimedia/ffmpeg/qffmpegvideobuffer.cpp
@@ -190,7 +190,10 @@ float QFFmpegVideoBuffer::maxNits()
         // TODO: Longer term we might want to also support HDR10+ dynamic metadata
         if (sd->type == AV_FRAME_DATA_MASTERING_DISPLAY_METADATA) {
             auto *data = reinterpret_cast<AVMasteringDisplayMetadata *>(sd->data);
-            auto maybeLum = QFFmpeg::mul(qreal(10'000.), data->max_luminance);
+            // max_luminance is a rational in cd/m2 (nits) already, valid with has_luminance
+            if (!data->has_luminance)
+                continue;
+            auto maybeLum = QFFmpeg::mul(qreal(1.), data->max_luminance);
             if (maybeLum)
                 maxNits = float(maybeLum.value());
         }
