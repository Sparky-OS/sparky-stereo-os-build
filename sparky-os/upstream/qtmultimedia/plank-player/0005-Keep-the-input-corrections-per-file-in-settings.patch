--- /dev/null
+++ b/app/stereostate.h
@@ -0,0 +1,25 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QObject>
+#include <QSettings>
+#include <QUrl>
+
+class StereoState : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(QString failurePath READ failurePath NOTIFY failurePathChanged)
+public:
+    using QObject::QObject;
+    QString failurePath() const { return m_failurePath; }
+    Q_INVOKABLE bool stereoSwap(const QUrl &url);
+    Q_INVOKABLE int stereoInput(const QUrl &url, int automatic);
+    Q_INVOKABLE void setStereoSwap(const QUrl &url, bool swap);
+    Q_INVOKABLE void setStereoInput(const QUrl &url, int input, int automatic);
+Q_SIGNALS:
+    void failurePathChanged();
+private:
+    void checkStatus(QSettings &settings);
+    QString m_failurePath;
+};
--- /dev/null
+++ b/app/stereostate.cpp
@@ -0,0 +1,68 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "stereostate.h"
+#include <QCryptographicHash>
+
+static QString stereoKey(const QUrl &url)
+{
+    return QStringLiteral("StereoVideo/") + QString::fromLatin1(QCryptographicHash::hash(url.toEncoded(), QCryptographicHash::Sha256).toHex());
+}
+
+void StereoState::checkStatus(QSettings &settings)
+{
+    settings.sync();
+    const QString path = settings.status() == QSettings::NoError ? QString() : settings.fileName();
+    if (m_failurePath != path) {
+        m_failurePath = path;
+        Q_EMIT failurePathChanged();
+    }
+}
+
+bool StereoState::stereoSwap(const QUrl &url)
+{
+    if (url.isEmpty())
+        return false;
+    QSettings settings;
+    settings.setFallbacksEnabled(false);
+    const bool swap = settings.value(stereoKey(url), false).toBool();
+    checkStatus(settings);
+    return swap;
+}
+
+int StereoState::stereoInput(const QUrl &url, int automatic)
+{
+    if (url.isEmpty())
+        return automatic;
+    QSettings settings;
+    settings.setFallbacksEnabled(false);
+    const int input = settings.value(stereoKey(url) + QStringLiteral(".input"), automatic).toInt();
+    checkStatus(settings);
+    return input;
+}
+
+void StereoState::setStereoSwap(const QUrl &url, bool swap)
+{
+    if (url.isEmpty())
+        return;
+    QSettings settings;
+    settings.setFallbacksEnabled(false);
+    if (swap)
+        settings.setValue(stereoKey(url), true);
+    else
+        settings.remove(stereoKey(url));
+    checkStatus(settings);
+}
+
+void StereoState::setStereoInput(const QUrl &url, int input, int automatic)
+{
+    if (url.isEmpty())
+        return;
+    QSettings settings;
+    settings.setFallbacksEnabled(false);
+    const QString key = stereoKey(url) + QStringLiteral(".input");
+    if (input != automatic)
+        settings.setValue(key, input);
+    else
+        settings.remove(key);
+    checkStatus(settings);
+}
