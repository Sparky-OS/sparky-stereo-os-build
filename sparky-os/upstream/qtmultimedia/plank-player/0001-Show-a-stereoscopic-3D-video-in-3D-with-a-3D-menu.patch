 app/qml/PlayerOSD.qml  |  17 +++++-
 app/qml/StereoMenu.qml | 135 +++++++++++++++++++++++++++++++++++++++++
 app/qml/main.qml       |  17 +++++-
 4 files changed, 167 insertions(+), 3 deletions(-)
 create mode 100644 app/qml/StereoMenu.qml

