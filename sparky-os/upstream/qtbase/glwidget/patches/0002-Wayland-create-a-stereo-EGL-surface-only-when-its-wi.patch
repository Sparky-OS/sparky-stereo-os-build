From cb9b60b90f057251907753ca888d87076c391e22 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Wed, 7 Oct 2026 19:22:30 -0300
Subject: [PATCH 2/2] Wayland: create a stereo EGL surface only when its window
 is shown

A stereo window has no wp_viewport of Qt's own: the EGL implementation
gives the surface one, sized from the buffers it allocated. Qt created
the wl_egl_window when the window's context was first made current, in
the case of a dialog before it was shown and sized, at the 100x30 of a
widget that has a parent. The EGL implementation drew and committed its
first frame at that size, and the compositor, which takes the window to
be no larger than its surface, configured the window to 100x30 and kept
it: the dialog was a title bar.

Do not create the EGL window of a stereo window that is not visible yet;
making the context current without a surface works, and the next
makeCurrent() after the window is shown creates the surface at the
size the window has then. Windows with a format that is not stereo, and
platforms without stereo surfaces, are unchanged.

Co-Authored-By: Claude Sonnet <noreply@anthropic.com>
---
 .../hardwareintegration/wayland-egl/qwaylandeglwindow.cpp    | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
index 0b1d06d6..a30d719c 100644
--- a/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
+++ b/src/plugins/platforms/wayland/plugins/hardwareintegration/wayland-egl/qwaylandeglwindow.cpp
@@ -106,6 +106,11 @@ void QWaylandEglWindow::updateSurface(bool create)
                 m_resize = true;
             }
         } else if (create && mSurface) {
+            // The EGL implementation sizes a stereo surface itself, from the window it is created with and
+            // not from the size Qt gives the surface later: wait until the window is shown and has its size
+            if (!window()->isVisible() && m_clientBufferIntegration->supportsStereo(window()->requestedFormat()))
+                return;
+
             wl_egl_window *eglWindow = wl_egl_window_create(mSurface->object(), sizeWithMargins.width(), sizeWithMargins.height());
             if (Q_UNLIKELY(!eglWindow)) {
                 qCWarning(lcQpaWayland, "Could not create wl_egl_window with size %dx%d\n", sizeWithMargins.width(), sizeWithMargins.height());
