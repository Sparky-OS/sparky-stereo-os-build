+        assert 177<=px[3]<=180,(hover,i,px.tolist())
+        assert tuple(px[:3])==((255,0,0) if hover==i else (0,0,0)),(hover,i,px.tolist())
+    # Composite actual overlay over a distinct ordinary video witness.
