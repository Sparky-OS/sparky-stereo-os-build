+        if (!widget->grabFramebuffer(mode == 2 ? QOpenGLWidget::RightBuffer : QOpenGLWidget::LeftBuffer).save(dir + "/second.png"))
+            qFatal("cannot save second view");
+        app.quit();
+    });
+    return app.exec();
