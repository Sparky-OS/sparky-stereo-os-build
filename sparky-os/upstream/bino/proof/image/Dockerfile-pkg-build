FROM debian:testing
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources; grep -c deb-src /etc/apt/sources.list.d/debian.sources; apt-get -y update >/dev/null 2>&1 && apt-get -y install build-essential devscripts fakeroot dpkg-dev quilt ca-certificates 2>&1 | tail -1 && apt-get -y build-dep bino 2>&1 | tail -2; apt-get -y install cmake ninja-build qt6-base-dev qt6-multimedia-dev qt6-tools-dev qt6-l10n-tools libgl-dev 2>&1 | tail -1
