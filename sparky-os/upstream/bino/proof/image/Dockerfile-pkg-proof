FROM debian:testing
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -y update >/dev/null && apt-get -y install ca-certificates >/dev/null 2>&1
COPY deb-multimedia-keyring.pgp /usr/share/keyrings/
COPY dmo.sources /etc/apt/sources.list.d/dmo.sources
COPY sparky-stereo /etc/apt/preferences.d/sparky-stereo
RUN --mount=type=bind,from=repo,target=/repo echo 'deb [trusted=yes] file:/repo ./' > /etc/apt/sources.list.d/zrepo.list \
 && apt-get -y update 2>&1 | tail -2 \
 && echo "=== apt-cache policy bino" && apt-cache policy bino \
 && echo "=== apt-get -s install bino=1:2.8-dmo1 (deb-multimedia's)" ; (apt-get -s install bino=1:2.8-dmo1 2>&1 | tail -6; true) \
 && echo "=== apt-get -s install bino (plain)" && apt-get -s install bino 2>&1 | grep -E "^Inst bino|^E:" ; \
    apt-get -y install kwin-wayland=4:6.7.4-2+stereo3d13+1 xwayland=2:24.1.13-1+stereo3d1 libgl1-mesa-dri=26.1.6-1+stereo3d7 libglx-mesa0=26.1.6-1+stereo3d7 libegl-mesa0 libgbm1 x11-utils dbus python3 python3-pil python3-numpy libstereo-declare1 fonts-dejavu-core bino 2>&1 | tail -3; \
    echo "=== installed"; dpkg-query -W bino ffmpeg libxcb-cursor0 libqt6multimedia6 libqt6gui6; apt-cache policy bino | head -4; grep Exec= /usr/share/applications/org.bino3d.bino.desktop; rm -f /etc/apt/sources.list.d/zrepo.list
COPY capture.cpp /tmp/capture.cpp
RUN apt-get -y update >/dev/null 2>&1; apt-get -y install qt6-base-dev g++ pkg-config 2>&1 | tail -1; g++ -fPIC -O1 -o /usr/local/bin/capture /tmp/capture.cpp $(pkg-config --cflags --libs Qt6Gui Qt6DBus); apt-get -y purge qt6-base-dev g++ >/dev/null 2>&1; ls /usr/local/bin/capture
