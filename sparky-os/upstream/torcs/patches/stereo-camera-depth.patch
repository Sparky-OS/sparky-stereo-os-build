+
+void cGrScreen::updateStereoConvergence(void)
+{
+	const bool cockpit = curCamHead == 0;
+	stereoConvergence = (float)GfParmGetNum(grHandle, GR_SCT_GRAPHIC,
+		cockpit ? "stereo cockpit convergence" : "stereo chase convergence",
+		(char*)NULL, cockpit ? 1.2 : 2.0);
+	if (!(stereoConvergence > 0.0f && stereoConvergence < 1.0e6f))
+		stereoConvergence = cockpit ? 1.2f : 2.0f;
+}
 
