+void KisViewManager::slotUpdateStereo3DActions()
+{
+    KisCanvas2 *kisCanvas = canvasBase();
+    if (!kisCanvas) return;
+
+    const bool pair = kisCanvas->stereoPairAvailable();
+    d->stereo3DAction->setEnabled(pair);
+    d->stereo3DRightViewAction->setEnabled(pair);
+
+    if (!pair && kisCanvas->stereoPairEnabled()) {
+        // the document stopped being a pair (resized, or the mark removed)
+        kisCanvas->setStereoPair(false, kisCanvas->stereoPaintOnRightView());
+        QSignalBlocker b(d->stereo3DAction);
+        d->stereo3DAction->setChecked(false);
+    } else if (kisCanvas->stereoPairEnabled()) {
+        // the eye order may have changed with the document's keywords
+        kisCanvas->setStereoPair(true, kisCanvas->stereoPaintOnRightView());
+    }
+}
+
+void KisViewManager::slotStereo3DChanged()
+{
+    KisCanvas2 *kisCanvas = canvasBase();
+    if (!kisCanvas) return;
+
+    const bool enable = d->stereo3DAction->isChecked();
+    const bool rightView = d->stereo3DRightViewAction->isChecked();
+
+    KisConfig cfg(false);
+    if (cfg.stereo3DCanvas() != enable) {
+        cfg.setStereo3DCanvas(enable);
+    }
+
+    if (enable && !QSurfaceFormat::defaultFormat().stereo()) {
+        // the surface is decided when Krita starts: the setting is kept for the next start
+        showFloatingMessage(i18n("Stereo 3D is on from the next start of Krita: the canvas needs a stereo surface, "
+                                 "and Krita asks for one only when it starts."), QIcon(), 8000);
+        return;
+    }
+
+    kisCanvas->setStereoPair(enable, rightView);
+
+    if (enable) {
+        showFloatingMessage(rightView ? i18n("Stereo 3D: painting on the right view")
+                                      : i18n("Stereo 3D: painting on the left view"), QIcon());
+    }
+}
