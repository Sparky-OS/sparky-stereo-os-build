+void KisCoordinatesConverter::setStereoView(const QRect &rect)
+{
+    if (rect == m_d->stereoView) return;
+
+    const bool wasStereo = !m_d->stereoView.isNull();
+    const QPointF oldWidgetStillPoint = imageToWidget(QRectF(m_d->viewBounds()).center());
+
+    m_d->stereoView = rect;
+    recalculateZoomLevelLimits();
+    recalculateTransformations();
+
+    if (wasStereo && !rect.isNull()) {
+        // the other eye's view of the same picture: keep it where it was on the widget
+        const QPointF newWidgetStillPoint = imageToWidget(QRectF(m_d->viewBounds()).center());
+        m_d->documentOffset = snapToDevicePixel(m_d->documentOffset + newWidgetStillPoint - oldWidgetStillPoint);
+        recalculateTransformations();
+        resetPreferredTransformationCenter();
+    } else if (!m_d->canvasWidgetSize.isEmpty()) {
+        // a pair shown as one eye's picture, or back: fit the page again
+        setZoom(KoZoomMode::ZOOM_PAGE, 777.7, resolutionX(), resolutionY(), std::nullopt);
+    }
+}
+
+QRect KisCoordinatesConverter::stereoView() const
+{
+    return m_d->stereoView;
+}
+
+QRect KisCoordinatesConverter::stereoPaintedRect() const
+{
+    return !m_d->stereoEyeView.isNull() ? m_d->stereoEyeView : m_d->stereoView;
+}
+
+void KisCoordinatesConverter::beginStereoEyeView(const QRect &eyeRect)
+{
+    KIS_SAFE_ASSERT_RECOVER_RETURN(m_d->stereoEyeView.isNull());
+    KIS_SAFE_ASSERT_RECOVER_RETURN(!m_d->stereoView.isNull());
+
+    // the other eye's part of the picture, drawn where the shown part is: the same widget
+    // position, the content of the other half
+    const QPoint shift = eyeRect.topLeft() - m_d->stereoView.topLeft();
+    m_d->stereoSavedImageToDocument = m_d->imageToDocument;
+    m_d->imageToDocument = QTransform::fromTranslate(-shift.x(), -shift.y()) * m_d->imageToDocument;
+    m_d->stereoEyeView = eyeRect;
+}
+
+void KisCoordinatesConverter::endStereoEyeView()
+{
+    if (m_d->stereoEyeView.isNull()) return;
+
+    m_d->imageToDocument = m_d->stereoSavedImageToDocument;
+    m_d->stereoEyeView = QRect();
+}
