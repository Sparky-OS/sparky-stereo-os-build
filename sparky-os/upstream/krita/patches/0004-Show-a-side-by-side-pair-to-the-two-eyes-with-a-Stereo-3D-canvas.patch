+bool KisCanvas2::imageLooksLikeStereoPair(KisImageSP image, const KisDocument *document, bool *rightEyeFirst)
+{
+    if (rightEyeFirst) {
+        *rightEyeFirst = false;
+    }
+    if (!image || image->width() < 2 || (image->width() & 1)) {
+        return false;
+    }
+
+    // the document says so: "stereo", "3D" or "side by side" among its keywords, subject or title
+    bool marked = false;
+    if (document && document->documentInfo()) {
+        const KoDocumentInfo *info = document->documentInfo();
+        const QString text = (info->aboutInfo("keyword") + " " + info->aboutInfo("subject") + " " +
+                              info->aboutInfo("title") + " " + info->aboutInfo("description")).toLower();
+        static const QRegularExpression mark(QStringLiteral("\\b(stereo|stereoscopic|3d|sbs|side[- ]by[- ]side)\\b"));
+        static const QRegularExpression rightFirst(QStringLiteral("\\b(right[- ]eye[- ]first|right[- ]first|cross[- ]?eyed|rl)\\b"));
+        marked = text.contains(mark);
+        if (marked && rightEyeFirst) {
+            *rightEyeFirst = text.contains(rightFirst);
+        }
+    }
+
+    // or the size does: at least twice as wide as high (two pictures of the shape of a picture side by side)
+    return marked || image->width() >= 2 * image->height();
+}
+
+bool KisCanvas2::stereoPairAvailable() const
+{
+    return imageLooksLikeStereoPair(image(), m_d->view ? m_d->view->document() : nullptr);
+}
+
+bool KisCanvas2::stereoPairEnabled() const
+{
+    return m_d->stereoPair;
+}
+
+bool KisCanvas2::stereoPaintOnRightView() const
+{
+    return m_d->stereoPaintOnRightView;
+}
+
+QRect KisCanvas2::stereoEyeRect(bool rightEye) const
+{
+    const QRect bounds = image()->bounds();
+    const int half = bounds.width() / 2;
+    const bool secondHalf = rightEye != m_d->stereoRightEyeFirst;
+    return QRect(bounds.x() + (secondHalf ? half : 0), bounds.y(), half, bounds.height());
+}
+
+void KisCanvas2::setStereoPair(bool enabled, bool paintOnRightView)
+{
+    bool rightEyeFirst = false;
+    enabled = enabled && m_d->currentCanvasIsOpenGL && imageLooksLikeStereoPair(image(), m_d->view ? m_d->view->document() : nullptr, &rightEyeFirst);
+
+    m_d->stereoRightEyeFirst = rightEyeFirst;
+    m_d->stereoPair = enabled;
+    m_d->stereoPaintOnRightView = paintOnRightView;
+
+    m_d->view->canvasController()->setStereoView(enabled ? stereoEyeRect(paintOnRightView) : QRect());
+    updateCanvas();
+}
