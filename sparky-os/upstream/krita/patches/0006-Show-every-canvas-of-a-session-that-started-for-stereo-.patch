     QRect canvasImageDirtyRect;
     KisOpenGLCanvasRenderer *renderer;
     QScopedPointer<KisStereoCanvasLayer> stereoLayer;
+    QScopedPointer<KisStereoCanvasLayer> monoLayer;
+    KisStereoCanvasLayer *activeLayer = nullptr;
+    bool stereoLayerTimerConnected = false;
     QTimer stereoLayerTimer;
     bool stereoLayerShown = false;
     QScopedPointer<KisOpenGLSync> glSyncObject;
@@ -281,28 +284,54 @@ void KisOpenGLCanvas2::paintGL()
      * of its own below the window instead, the same way, and the widget is transparent over it:
      * the decorations and the brush outline are on the screen plane, the same in both eyes.
      */
-    const bool stereoLayerWanted = !format().stereo() && canvas()->stereoPairEnabled() && KisStereoCanvasLayer::isSupported();
-    if (stereoLayerWanted && !d->stereoLayer) {
-        d->stereoLayer.reset(new KisStereoCanvasLayer(this, context()));
+    const bool layerPossible = !format().stereo() && KisStereoCanvasLayer::isSupported();
+    const bool stereoLayerWanted = layerPossible && canvas()->stereoPairEnabled();
+    /**
+     * The window of a session that started for stereo has an alpha channel, and the surfaces
+     * with alpha are 8 bits per channel: the canvases that are not a stereo pair are shown through
+     * a layer too (with one buffer), so that they keep the depth of the canvas surface.
+     */
+    const bool monoLayerWanted = layerPossible && !stereoLayerWanted && KisStereoCanvasLayer::layerStarted();
+
+    KisStereoCanvasLayer *layer = nullptr;
+    if (stereoLayerWanted) {
+        if (!d->stereoLayer) {
+            d->stereoLayer.reset(new KisStereoCanvasLayer(this, context(), true));
+        }
+        layer = d->stereoLayer.data();
+    } else if (monoLayerWanted) {
+        if (!d->monoLayer) {
+            d->monoLayer.reset(new KisStereoCanvasLayer(this, context(), false));
+        }
+        layer = d->monoLayer.data();
+    }
+    d->activeLayer = layer;
+    if (layer && !d->stereoLayerTimerConnected) {
+        d->stereoLayerTimerConnected = true;
         d->stereoLayerTimer.setInterval(100);
         connect(&d->stereoLayerTimer, &QTimer::timeout, this, [this] {
-            if (d->stereoLayer) {
-                d->stereoLayer->follow();
+            if (d->activeLayer) {
+                d->activeLayer->follow();
             }
         });
     }
-    if (!stereoLayerWanted && d->stereoLayer) {
-        d->stereoLayerTimer.stop();
+    if (d->stereoLayer && d->stereoLayer.data() != layer) {
         d->stereoLayer->hide();
     }
-    if (!stereoLayerWanted && d->stereoLayerShown) {
-        d->stereoLayerShown = false;
-        window()->update();
+    if (d->monoLayer && d->monoLayer.data() != layer) {
+        d->monoLayer->hide();
+    }
+    if (!layer) {
+        d->stereoLayerTimer.stop();
+        if (d->stereoLayerShown) {
+            d->stereoLayerShown = false;
+            window()->update();
+        }
     }
 
     bool stereoLayerShown = false;
-    if (stereoLayerWanted && d->stereoLayer->isReady()) {
-        stereoLayerShown = paintStereoLayer();
+    if (layer && layer->isReady()) {
+        stereoLayerShown = paintStereoLayer(layer, stereoLayerWanted);
         if (!stereoLayerShown) {
             // the layer is not on the screen yet: the window shows what is painted on, meanwhile
             QTimer::singleShot(50, this, qOverload<>(&QWidget::update));
@@ -378,11 +407,14 @@ void KisOpenGLCanvas2::paintGL()
     }
 }
 
-bool KisOpenGLCanvas2::paintStereoLayer()
+bool KisOpenGLCanvas2::paintStereoLayer(KisStereoCanvasLayer *layer, bool stereo)
 {
     // each eye's picture goes to a texture of the renderer, and from there to the layer's buffers
     GLuint textures[2] = {0, 0};
-    for (int eye = 0; eye < 2; eye++) {
+    if (!stereo) {
+        textures[0] = textures[1] = d->renderer->paintCanvasToEyeTexture(0);
+    }
+    for (int eye = 0; stereo && eye < 2; eye++) {
         const QRect eyeRect = canvas()->stereoEyeRect(eye == 1);
         const bool eyeViewActive = eyeRect != coordinatesConverter()->stereoView();
         if (eyeViewActive) {
@@ -396,7 +428,7 @@ bool KisOpenGLCanvas2::paintStereoLayer()
 
     // the layer works in a context of its own, and the textures are still being drawn
     context()->functions()->glFinish();
-    const bool shown = d->stereoLayer->present(textures[0], textures[1], coordinatesConverter()->viewportDevicePixelSize());
+    const bool shown = layer->present(textures[0], textures[1], coordinatesConverter()->viewportDevicePixelSize());
     if (shown && !d->stereoLayerTimer.isActive()) {
         d->stereoLayerTimer.start();
     }
@@ -530,6 +562,9 @@ void KisOpenGLCanvas2::hideEvent(QHideEvent *e)
