+GLuint KisOpenGLCanvasRenderer::paintCanvasToEyeTexture(int eye)
+{
+    QScopedPointer<QOpenGLFramebufferObject> &fbo = d->eyeFBO[eye];
+    if (!fbo || fbo->size() != d->viewportDevicePixelSize) {
+        QOpenGLFramebufferObjectFormat format;
+        format.setInternalTextureFormat(d->canvasBridge->internalTextureFormat());
+        fbo.reset(new QOpenGLFramebufferObject(d->viewportDevicePixelSize, format));
+    }
+
+    fbo->bind();
+    renderCanvasGL(QRect());
+    fbo->release();
+    QOpenGLFramebufferObject::bindDefault();
+
+    return fbo->texture();
+}
