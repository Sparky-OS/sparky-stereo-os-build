diff --git a/libs/ui/opengl/KisStereoCanvasLayer.cpp b/libs/ui/opengl/KisStereoCanvasLayer.cpp
new file mode 100644
index 0000000..4636ade
--- /dev/null
+++ b/libs/ui/opengl/KisStereoCanvasLayer.cpp
@@ -0,0 +1,247 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "KisStereoCanvasLayer.h"
+
+#include <QGuiApplication>
+#include <QOpenGLContext>
+#include <QOpenGLExtraFunctions>
+#include <QSurfaceFormat>
+#include <QWidget>
+#include <QWindow>
+
+#include <kis_debug.h>
+
+#ifdef KRITA_HAS_STEREO_CANVAS_LAYER
+#include <QtGui/qpa/qplatformwindow_p.h>
+#include <wayland-client.h>
+#endif
+
+namespace {
+bool g_layerStarted = false;
+}
+
+struct KisStereoCanvasLayer::Private
+{
+    QPointer<QWidget> area;
+    QPointer<QOpenGLContext> shareContext;
+    QPointer<QWindow> window;
+    QOpenGLContext *context {nullptr};
+    QOpenGLExtraFunctions funcs;
+    GLuint framebuffers[2] {0, 0};
+    bool failed {false};
+    bool placedBelow {false};
+    QRect placed;
+
+    bool create();
+    void placeBelowParent();
+};
+
+bool KisStereoCanvasLayer::isSupported()
+{
+#ifdef KRITA_HAS_STEREO_CANVAS_LAYER
+    return QGuiApplication::platformName().startsWith(QLatin1String("wayland"));
+#else
+    return false;
+#endif
+}
+
+bool KisStereoCanvasLayer::stereoCanvasAvailable()
+{
+    return g_layerStarted || QSurfaceFormat::defaultFormat().stereo();
+}
+
+void KisStereoCanvasLayer::setLayerStarted(bool started)
+{
+    g_layerStarted = started;
+}
+
+KisStereoCanvasLayer::KisStereoCanvasLayer(QWidget *area, QOpenGLContext *shareContext)
+    : d(new Private)
+{
+    d->area = area;
+    d->shareContext = shareContext;
+}
+
+KisStereoCanvasLayer::~KisStereoCanvasLayer()
+{
+    if (d->context) {
+        QOpenGLContext *current = QOpenGLContext::currentContext();
+        QSurface *currentSurface = current ? current->surface() : nullptr;
+        if (d->window && d->framebuffers[0] && d->context->makeCurrent(d->window)) {
+            d->funcs.glDeleteFramebuffers(2, d->framebuffers);
+        }
+        if (current && currentSurface && current != d->context) {
+            current->makeCurrent(currentSurface);
+        }
+    }
+    delete d->context;
+    // the window is a child of the main window's, which takes it along when it goes first
+    delete d->window.data();
+    delete d;
+}
+
+bool KisStereoCanvasLayer::Private::create()
+{
+    if (window) {
+        return !failed;
+    }
+    failed = true;
+
+    QWidget *top = area ? area->window() : nullptr;
+    QWindow *parent = top ? top->windowHandle() : nullptr;
+    if (!parent || !shareContext || shareContext->isOpenGLES()) {
+        // stereo buffers are a desktop OpenGL thing
+        return false;
+    }
+
+    // the canvas's own surface format (deep colour included), with left and right buffers
+    QSurfaceFormat format = QSurfaceFormat::defaultFormat();
+    format.setStereo(true);
+    format.setRenderableType(QSurfaceFormat::OpenGL);
+
+    window = new QWindow(parent);
+    window->setSurfaceType(QSurface::OpenGLSurface);
+    window->setFormat(format);
+    window->setFlag(Qt::WindowTransparentForInput);
+
+    context = new QOpenGLContext;
+    context->setFormat(format);
+    context->setShareContext(shareContext);
+    if (!context->create()) {
+        warnOpenGL << "the stereo canvas layer could not create its OpenGL context";
+        return false;
+    }
+
+    window->create();
+    placeBelowParent();
+    failed = !window->format().stereo();
+    if (failed) {
+        warnOpenGL << "the stereo canvas layer got no left and right buffers: Qt's platform has no stereo surfaces";
+    }
+    return !failed;
+}
+
+// Qt puts a subsurface above its parent; the layer goes below it, so that the window's own
+// surface, its interface and the overlays of the canvas, is drawn over the picture
+void KisStereoCanvasLayer::Private::placeBelowParent()
+{
+#ifdef KRITA_HAS_STEREO_CANVAS_LAYER
+    if (!window || !window->parent()) {
+        return;
+    }
+    auto *own = window->nativeInterface<QNativeInterface::Private::QWaylandWindow>();
+    auto *parent = window->parent()->nativeInterface<QNativeInterface::Private::QWaylandWindow>();
+    if (!own || !parent || !parent->surface()) {
+        return;
+    }
+    if (wl_subsurface *role = own->surfaceRole<wl_subsurface>()) {
+        wl_subsurface_place_below(role, parent->surface());
+        placedBelow = true;
+    }
+#endif
+}
+
+bool KisStereoCanvasLayer::isReady()
+{
+    return d->create();
+}
+
+void KisStereoCanvasLayer::follow()
+{
+    if (!d->window || d->failed || !d->area) {
+        return;
+    }
+
+    if (!d->area->isVisible() || d->area->size().isEmpty() || !d->area->window()->isVisible()) {
+        hide();
+        return;
+    }
+
+    if (!d->placedBelow) {
+        d->placeBelowParent();
+    }
+
+    const QRect rect(d->area->mapTo(d->area->window(), QPoint(0, 0)), d->area->size());
+    if (rect != d->placed) {
+        d->window->setGeometry(rect);
+        d->placed = rect;
+        dbgOpenGL << "stereo canvas layer at" << rect << "below the window, format stereo" << d->window->format().stereo()
+                  << "red bits" << d->window->format().redBufferSize();
+        // the position takes effect with the parent's next commit
+        d->area->window()->update();
+    }
+    if (!d->window->isVisible()) {
+        d->window->show();
+    }
+}
+
+void KisStereoCanvasLayer::hide()
+{
+    if (d->window && d->window->isVisible()) {
+        d->window->hide();
+        d->placed = QRect();
+    }
+}
+
+bool KisStereoCanvasLayer::present(GLuint leftTexture, GLuint rightTexture, const QSize &size)
+{
+#ifndef KRITA_HAS_STEREO_CANVAS_LAYER
+    Q_UNUSED(leftTexture);
+    Q_UNUSED(rightTexture);
+    Q_UNUSED(size);
+    return false;
+#else
+    if (!d->create()) {
+        return false;
+    }
+
+    follow();
+    if (!d->window->isExposed()) {
+        return false;
+    }
+
+    QOpenGLContext *current = QOpenGLContext::currentContext();
+    QSurface *currentSurface = current ? current->surface() : nullptr;
+
+    if (!d->context->makeCurrent(d->window)) {
+        return false;
+    }
+
+    if (!d->framebuffers[0]) {
+        d->funcs.initializeOpenGLFunctions();
+        d->funcs.glGenFramebuffers(2, d->framebuffers);
+    }
+
+    const QSize target = d->window->size() * d->window->devicePixelRatio();
+    const GLuint textures[2] = {leftTexture, rightTexture};
+    const GLenum buffers[2] = {GL_BACK_LEFT, GL_BACK_RIGHT};
+
+    for (int eye = 0; eye < 2; eye++) {
+        d->funcs.glBindFramebuffer(GL_READ_FRAMEBUFFER, d->framebuffers[eye]);
+        d->funcs.glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textures[eye], 0);
+        d->funcs.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+        d->funcs.glDrawBuffers(1, &buffers[eye]);
+        d->funcs.glDisable(GL_SCISSOR_TEST);
+        d->funcs.glBlitFramebuffer(0, 0, size.width(), size.height(),
+                                   0, 0, target.width(), target.height(),
+                                   GL_COLOR_BUFFER_BIT, size == target ? GL_NEAREST : GL_LINEAR);
+    }
+    d->funcs.glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    d->funcs.glDrawBuffers(1, &buffers[0]);
+
+    // the textures are shared with the canvas's context, which draws into them again at its next frame
+    d->funcs.glFinish();
+    d->context->swapBuffers(d->window);
+
+    if (current && currentSurface) {
+        current->makeCurrent(currentSurface);
+    } else {
+        d->context->doneCurrent();
+    }
+    return true;
+#endif
+}
diff --git a/libs/ui/opengl/KisStereoCanvasLayer.h b/libs/ui/opengl/KisStereoCanvasLayer.h
new file mode 100644
index 0000000..4d5b02a
--- /dev/null
+++ b/libs/ui/opengl/KisStereoCanvasLayer.h
@@ -0,0 +1,76 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_STEREO_CANVAS_LAYER_H
+#define KIS_STEREO_CANVAS_LAYER_H
+
+#include <QObject>
+#include <QPointer>
+#include <QSize>
+#include <qopengl.h>
+
+#include "kritaui_export.h"
+
+class QOpenGLContext;
+class QWidget;
+
+/**
+ * KisStereoCanvasLayer is the 3D area of a "Stereo 3D" canvas under Qt's Wayland platform.
+ *
+ * The canvas is a widget of the main window, so its surface is the window's own and that
+ * one is never stereo: a window whose surface is stereo has its whole interface doubled with
+ * the picture. The layer is a surface of its own instead, a subsurface placed below the
+ * window's surface at the rectangle of the canvas widget, with left and right buffers. The
+ * compositor shows it to each eye in place, and the window, translucent where the canvas is,
+ * stays one picture at one eye's size, the same in both eyes.
+ *
+ * The canvas renders each eye into a texture of its own context, and present() copies the two
+ * textures into the left and the right buffer of the layer. The layer has the deep surface
+ * format of the canvas, so a stereo canvas is as deep as a mono one.
+ */
+class KRITAUI_EXPORT KisStereoCanvasLayer : public QObject
+{
+    Q_OBJECT
+
+public:
+    /**
+     * @param area the canvas widget: the layer follows its rectangle
+     * @param shareContext the canvas's context: the textures given to present() live in it
+     */
+    KisStereoCanvasLayer(QWidget *area, QOpenGLContext *shareContext);
+    ~KisStereoCanvasLayer() override;
+
+    /// Qt's Wayland platform, and a build that can place a subsurface below its window
+    static bool isSupported();
+
