+void KisMainWindow::paintEvent(QPaintEvent *e)
+{
+    if (!testAttribute(Qt::WA_TranslucentBackground)) {
+        KXmlGuiWindow::paintEvent(e);
+        return;
+    }
+
+    // A window with an alpha buffer paints its own background, except where a stereo canvas
+    // shows the layer below the window through it
+    QRegion background(rect());
+    const QList<KisOpenGLCanvas2 *> canvases = findChildren<KisOpenGLCanvas2 *>();
+    for (KisOpenGLCanvas2 *canvas : canvases) {
+        if (canvas->showsStereoLayer() && canvas->isVisible()) {
+            background -= QRect(canvas->mapTo(this, QPoint(0, 0)), canvas->size());
+        }
+    }
+    QPainter painter(this);
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    for (const QRect &r : background) {
+        painter.fillRect(r, palette().window());
+    }
+}
