 libs/ui/canvas/kis_canvas2.cpp          | 58 ++++++++++++++++---------
 libs/ui/canvas/kis_canvas2.h            |  8 ++++
 libs/ui/opengl/KisStereoCanvasLayer.cpp |  5 +++
 libs/ui/opengl/KisStereoCanvasLayer.h   |  4 ++
 libs/ui/opengl/kis_opengl_canvas2.cpp   |  6 +++
