+            if UserSettings.Get(group="display", key="nvizStereo", subkey="enabled"):
+                stereoAttribs = [*attribs[:-1], WX_GL_STEREO, 0]
+                if glcanvas.GLCanvas.IsDisplaySupported(stereoAttribs):
