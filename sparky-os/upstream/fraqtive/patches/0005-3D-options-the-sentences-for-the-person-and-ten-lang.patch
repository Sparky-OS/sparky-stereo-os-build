@@ -676,12 +692,23 @@ void FraqtiveMainWindow::view2d()
 
     action( "view2d" )->setChecked( true );
     action( "view3d" )->setChecked( false );
+    m_ui.mainContainer->setMessage( QString() );
 }
 
 void FraqtiveMainWindow::view3d()
 {
     if ( !qobject_cast<MeshView*>( m_ui.mainContainer->view() ) ) {
+        QOpenGLContext probe;
+        if ( !probe.create() ) {
+            QMessageBox::warning( this, tr( "3D View" ), tr( "The 3D view needs OpenGL, which could not be started on this computer." ) );
+            action( "view3d" )->setChecked( false );
+            return;
+        }
+
         MeshView* view = new MeshView( m_ui.mainContainer, m_model->presenter() );
+        connect( view, SIGNAL( stereoStatusChanged( const QString& ) ), m_ui.mainContainer, SLOT( setMessage( const QString& ) ) );
+        view->setStereoEnabled( action( "enable3d" )->isChecked() );
+        m_ui.mainContainer->setViewScale( fraqtive()->configuration()->value( "RenderScalePercent", 100 ).toInt() / 100.0 );
 
         m_model->presenter()->setView( view );
         m_ui.mainContainer->setView( view );
@@ -696,3 +723,40 @@ void FraqtiveMainWindow::view3d()
     action( "view2d" )->setChecked( false );
     action( "view3d" )->setChecked( true );
 }
+
+void FraqtiveMainWindow::enable3d()
+{
+    bool enabled = action( "enable3d" )->isChecked();
+    fraqtive()->configuration()->setValue( "Enable3D", enabled );
+    if ( MeshView* meshView = qobject_cast<MeshView*>( m_ui.mainContainer->view() ) )
+        meshView->setStereoEnabled( enabled );
+}
+
+void FraqtiveMainWindow::chooseRenderResolution()
+{
+    // The size each eye is drawn at, as a share of the size of the 3D area; Stereo KWin resizes it once, at the output. Only
+    // shares up to 100 % are offered: the edition's Qt composes the widgets that overlap a stereo window larger than its area
+    // into it, so a larger window cannot be handed over yet.
+    QStringList items;
+    items << "50 %" << "75 %" << "100 %";
+    int percent[] = { 50, 75, 100 };
+    int current = fraqtive()->configuration()->value( "RenderScalePercent", 100 ).toInt();
+    int index = 2; // 100 %
+    for ( int i = 0; i < 3; i++ ) {
+        if ( percent[ i ] == current )
+            index = i;
+    }
+    bool ok = false;
+    QString item = QInputDialog::getItem( this, tr( "Render Resolution per Eye" ), tr( "Size of each eye's picture, as a share of the 3D area:" ), items, index, false, &ok );
+    if ( !ok )
+        return;
+    int value = percent[ items.indexOf( item ) ];
+    fraqtive()->configuration()->setValue( "RenderScalePercent", value );
+    m_ui.mainContainer->setViewScale( value / 100.0 );
+}
+
+void FraqtiveMainWindow::openDisplaySettings()
+{
+    if ( !QProcess::startDetached( "kcmshell6", QStringList() << "kcm_kscreen" ) )
+        QMessageBox::warning( this, tr( "Display Settings" ), tr( "Display Settings could not be opened (kcmshell6 was not found)." ) );
+}
