--- a/src/viewcontainer.cpp
+++ b/src/viewcontainer.cpp
@@ -19,12 +19,31 @@
 #include "viewcontainer.h"
 
 #include <QVBoxLayout>
+#include <QLabel>
+#include <QEvent>
+
+#include "meshview.h"
 
 ViewContainer::ViewContainer( QWidget* parent ) : QWidget( parent ),
-    m_view( NULL )
+    m_view( NULL ),
+    m_viewScale( 1.0 )
 {
     m_layout = new QVBoxLayout( this );
     m_layout->setContentsMargins( 0, 0, 0, 0 );
+
+    m_message = new QLabel( this );
+    m_message->setWordWrap( true );
+    m_message->setMargin( 4 );
+    m_message->setAutoFillBackground( true );
+    m_message->setBackgroundRole( QPalette::ToolTipBase );
+    m_message->setForegroundRole( QPalette::ToolTipText );
+    m_message->setSizePolicy( QSizePolicy::Preferred, QSizePolicy::Maximum );
+    m_message->hide();
+    m_layout->addWidget( m_message );
+
+    m_slot = new QWidget( this );
+    m_slot->installEventFilter( this );
+    m_layout->addWidget( m_slot, 1 );
 }
 
 ViewContainer::~ViewContainer()
@@ -36,8 +55,45 @@ void ViewContainer::setView( QWidget* view )
     if ( m_view != view ) {
         delete m_view;
         m_view = view;
-        m_layout->addWidget( view );
+        view->setParent( m_slot );
+        view->show();
+        placeView();
+    }
+}
+
+void ViewContainer::setViewScale( double scale )
+{
+    m_viewScale = scale;
+    placeView();
+}
+
+bool ViewContainer::eventFilter( QObject* watched, QEvent* e )
+{
+    if ( watched == m_slot && e->type() == QEvent::Resize )
+        placeView();
+    return QWidget::eventFilter( watched, e );
+}
+
+void ViewContainer::placeView()
+{
+    if ( !m_view )
+        return;
+    QSize area = m_slot->size();
+    MeshView* meshView = qobject_cast<MeshView*>( m_view );
+    if ( !meshView ) {
+        m_view->setGeometry( QRect( QPoint( 0, 0 ), area ) );
+        return;
     }
+    // the window of the 3D view has the render resolution (a share of the area) and says the size it is shown at
+    QSize render( qMax( 1, qRound( area.width() * m_viewScale ) ), qMax( 1, qRound( area.height() * m_viewScale ) ) );
+    meshView->setShownSize( m_viewScale == 1.0 ? QSize() : area );
+    m_view->setGeometry( QRect( QPoint( 0, 0 ), render ) );
+}
+
+void ViewContainer::setMessage( const QString& text )
+{
+    m_message->setText( text );
+    m_message->setVisible( !text.isEmpty() );
 }
 
 QSize ViewContainer::sizeHint() const
