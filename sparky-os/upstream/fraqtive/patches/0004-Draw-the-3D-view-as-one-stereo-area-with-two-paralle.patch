+* (at your option) any later version.
+**************************************************************************/
+
+#include "stereofit.h"
+
+#include <math.h>
+
+#ifndef M_PI
+# define M_PI 3.14159265358979323846
+#endif
+
+double stereoDepth( const SceneGeometry& scene, double x, double y, double z )
+{
+    double r = scene.rotation * M_PI / 180.0;
+    double a = scene.angle * M_PI / 180.0;
+    z = scene.heightScale * ( z + scene.averageHeight );
+    double ry = x * sin( r ) + y * cos( r );
+    return scene.cameraDistance - ( ry * sin( a ) + z * cos( a ) );
+}
+
+double stereoDisparity( double focal, double zeroParallax, double depth )
+{
+    return focal * ( 1.0 / zeroParallax - 1.0 / depth );
+}
+
+double stereoFitOffset( const float* vertices, int count, const SceneGeometry& scene, double focal, double sunkPixels, double poppedPixels,
+                        double* farthest, double* nearest )
+{
+    double far = 0.0, near = 0.0;
+    double limit = scene.maximumDepth - 0.001;
+
+    for ( int i = 0; i < count; i++ ) {
+        double z = vertices[ 3 * i + 2 ];
+        if ( z + limit < 0.0 )
+            continue;
+        double depth = stereoDepth( scene, vertices[ 3 * i ], vertices[ 3 * i + 1 ], z );
+        if ( depth < scene.nearClipping || depth > scene.farClipping )
+            continue;
+        double disparity = stereoDisparity( focal, scene.cameraDistance, depth );
+        if ( disparity > far )
+            far = disparity;
+        if ( disparity < near )
+            near = disparity;
+    }
+
+    if ( farthest )
+        *farthest = far;
+    if ( nearest )
+        *nearest = near;
+
+    double offset = 1e9;
+    if ( far > 0.0 && sunkPixels / far < offset )
+        offset = sunkPixels / far;
+    if ( near < 0.0 && poppedPixels / -near < offset )
+        offset = poppedPixels / -near;
+    return offset < 1e9 ? offset : 0.0;
+}
diff --git a/src/stereofit.h b/src/stereofit.h
new file mode 100644
index 0000000..98084e9
--- /dev/null
+++ b/src/stereofit.h
@@ -0,0 +1,42 @@
+/**************************************************************************
+* This file is part of the Fraqtive program
+* Copyright (C) 2026 Daniel Campos Ramos
+*
+* This program is free software: you can redistribute it and/or modify
+* it under the terms of the GNU General Public License as published by
