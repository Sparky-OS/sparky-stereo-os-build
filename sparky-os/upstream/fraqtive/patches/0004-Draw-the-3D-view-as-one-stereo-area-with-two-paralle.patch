+/**************************************************************************
+* This file is part of the Fraqtive program
+* Copyright (C) 2026 Daniel Campos Ramos
+*
+* This program is free software: you can redistribute it and/or modify
+* it under the terms of the GNU General Public License as published by
+* the Free Software Foundation, either version 3 of the License, or
+* (at your option) any later version.
+**************************************************************************/
+
+#ifndef STEREOFIT_H
+#define STEREOFIT_H
+
+// The two parallel cameras of the 3D view. The cameras sit half the offset to each side of the view and each frustum is shifted
+// so that the plane at zeroParallax distance stays at the screen; a point at depth Z then has the screen disparity
+// (right eye minus left eye, positive behind the screen) focal * offset * ( 1 / zeroParallax - 1 / Z ), focal being the
+// focal length in pixels of one view.
+
+struct SceneGeometry
+{
+    double maximumDepth;
+    double averageHeight;
+    double heightScale;
+    double rotation; // degrees about the z axis
+    double angle;    // degrees about the x axis
+    double cameraDistance;
+    double nearClipping;
+    double farClipping;
+};
+
+// the depth of a model point from the camera plane
+double stereoDepth( const SceneGeometry& scene, double x, double y, double z );
+
+// the disparity of a point at that depth, for an offset of one
+double stereoDisparity( double focal, double zeroParallax, double depth );
+
+// The largest offset for which every visible vertex stays inside the limits (pixels of one view). Returns 0 when the mesh
+// holds no vertex in front of or behind the screen; farthest and nearest get the extreme disparities for an offset of one.
+double stereoFitOffset( const float* vertices, int count, const SceneGeometry& scene, double focal, double sunkPixels, double poppedPixels,
+                        double* farthest, double* nearest );
+
+#endif
