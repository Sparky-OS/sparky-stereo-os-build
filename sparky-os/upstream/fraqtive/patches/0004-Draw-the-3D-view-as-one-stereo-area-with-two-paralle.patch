+
+void MeshView::applyShownSize()
+{
+    QWindow* handle = windowHandle();
+    if ( !handle )
+        return;
+    handle->setProperty( "_q_stereo_view_size", m_shownSize );
+
+    if ( QGuiApplication::platformName() == QLatin1String( "xcb" ) ) {
+        QPlatformNativeInterface* native = QGuiApplication::platformNativeInterface();
+        Display* display = native ? (Display*)native->nativeResourceForIntegration( "display" ) : NULL;
+        if ( !display )
+            return;
+        Atom atom = XInternAtom( display, "_KDE_NET_WM_STEREO_CONTENT_ONE_VIEW_SIZE", False );
+        if ( m_shownSize.isEmpty() ) {
+            XDeleteProperty( display, (Window)handle->winId(), atom );
+        } else {
+            qreal ratio = devicePixelRatioF();
+            unsigned long size[ 2 ] = { (unsigned long)qRound( m_shownSize.width() * ratio ), (unsigned long)qRound( m_shownSize.height() * ratio ) };
+            XChangeProperty( display, (Window)handle->winId(), atom, XA_CARDINAL, 32, PropModeReplace, (const unsigned char*)size, 2 );
+        }
+        XFlush( display );
+    }
+}
