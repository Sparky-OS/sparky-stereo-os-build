+// The camera maths of the 3D view against an independent pinhole projection: for thousands of random vertices and views, the
+// disparity the program predicts (stereofit.cpp) must equal the difference of the two projected positions computed here with the
+// OpenGL matrices written out; the fitted offset must put the extreme vertices exactly on the limits; the vertical disparity is 0.
+// Build: g++ -O1 -I../src -o stereofit-test stereofit-test.cpp ../src/stereofit.cpp && ./stereofit-test
+#include "stereofit.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <vector>
+
+struct P { double x, y; };
+
+static P project( const SceneGeometry& s, double fx, double fy, double cx, double W, double H, double x, double y, double z )
+{
+    double r = s.rotation * M_PI / 180.0, a = s.angle * M_PI / 180.0;
+    double px = x, py = y, pz = s.heightScale * ( z + s.averageHeight );              // T(0,0,avg) then S(1,1,hs)
+    double qx = px * cos( r ) - py * sin( r ), qy = px * sin( r ) + py * cos( r ), qz = pz; // Rz
+    double ex = qx, ey = qy * cos( a ) - qz * sin( a ), ez = qy * sin( a ) + qz * cos( a ); // Rx
+    ez -= s.cameraDistance;                                                              // T(0,0,-C)
+    ex -= cx;                                                                            // T(-cx,0,0) (the camera moves by cx)
+    double N = s.nearClipping, l = -fx - cx * N / s.cameraDistance, rr = fx - cx * N / s.cameraDistance;
+    double xn = ( 2 * N / ( rr - l ) ) * ex / -ez - ( rr + l ) / ( rr - l );
+    double yn = ( N / fy ) * ey / -ez;
+    return { ( xn + 1 ) * 0.5 * W, ( yn + 1 ) * 0.5 * H };
+}
+
+int main()
+{
+    srand( 743 );
+    double worst = 0, worstFit = 0, vertical = 0;
+    int checked = 0, fitChecked = 0;
+    for ( int trial = 0; trial < 200; trial++ ) {
+        SceneGeometry s = { 1.0 + rand() % 5, ( rand() % 100 ) / 50.0 - 1.0, 0.2 + ( rand() % 100 ) / 40.0, rand() % 360 - 180.0, -45.0 + rand() % 20, 40.0, 10.0, 70.0 };
+        double W = 400 + rand() % 1500, H = 300 + rand() % 800, fyv = tan( 0.5 * ( 20 + rand() % 40 ) * M_PI / 180.0 ) * s.nearClipping, fxv = fyv * W / H;
+        double focal = 0.5 * W * s.nearClipping / fxv;
+        std::vector<float> v;
+        for ( int i = 0; i < 2000; i++ ) {
+            v.push_back( ( rand() % 2000 - 1000 ) / 100.0f ); v.push_back( ( rand() % 2000 - 1000 ) / 100.0f ); v.push_back( -( rand() % 100 ) / 100.0f * s.maximumDepth );
+        }
+        double e = 0.37 + ( rand() % 100 ) / 100.0;
+        for ( size_t i = 0; i < v.size(); i += 3 ) {
+            double Z = stereoDepth( s, v[i], v[i + 1], v[i + 2] );
+            if ( Z < s.nearClipping || Z > s.farClipping )
+                continue;
+            P l = project( s, fxv, fyv, -0.5 * e, W, H, v[i], v[i + 1], v[i + 2] ), r = project( s, fxv, fyv, 0.5 * e, W, H, v[i], v[i + 1], v[i + 2] );
+            double d = r.x - l.x, predicted = e * stereoDisparity( focal, s.cameraDistance, Z );
+            if ( fabs( d - predicted ) > worst ) worst = fabs( d - predicted );
+            if ( fabs( r.y - l.y ) > vertical ) vertical = fabs( r.y - l.y );
+            checked++;
+        }
+        // the fitted offset puts the extreme vertices on the limits
+        double sunk = 3 + rand() % 10, popped = 1 + rand() % 6, far, near;
+        double off = stereoFitOffset( v.data(), (int)( v.size() / 3 ), s, focal, sunk, popped, &far, &near );
+        if ( off > 0 ) {
+            double maxD = 0, minD = 0;
+            for ( size_t i = 0; i < v.size(); i += 3 ) {
+                double Z = stereoDepth( s, v[i], v[i + 1], v[i + 2] );
+                if ( v[i + 2] + s.maximumDepth - 0.001 < 0 || Z < s.nearClipping || Z > s.farClipping ) continue;
+                P l = project( s, fxv, fyv, -0.5 * off, W, H, v[i], v[i + 1], v[i + 2] ), r = project( s, fxv, fyv, 0.5 * off, W, H, v[i], v[i + 1], v[i + 2] );
+                double d = r.x - l.x; if ( d > maxD ) maxD = d; if ( d < minD ) minD = d;
+            }
+            if ( maxD > sunk + 1e-6 || -minD > popped + 1e-6 ) { printf( "FAIL fit leaves the limits: %f %f against %f %f\n", maxD, -minD, sunk, popped ); return 1; }
+            double hit = ( maxD > 0 ? maxD / sunk : 0 ) > ( minD < 0 ? -minD / popped : 0 ) ? maxD / sunk : -minD / popped;
+            if ( 1.0 - hit > worstFit ) worstFit = 1.0 - hit;
+            fitChecked++;
+        }
+    }
+    printf( "%d vertices: largest difference between the program's disparity and the projected one %.2e px, largest vertical disparity %.2e px\n", checked, worst, vertical );
+    printf( "%d fits: every vertex inside the limits, the binding limit reached to within %.2e of itself\n", fitChecked, worstFit );
+    return worst < 1e-6 && vertical < 1e-6 && worstFit < 1e-6 ? 0 : 1;
+}
