+// The person's limits, in pixels of a view 1920 wide, from Stereo KWin through libstereo-declare; never invented here. The
+// limits belong to the window, so they are asked with the top level's surface.
+int MeshView::readDepthLimits( double* sunk, double* popped )
+{
+    QWindow* topLevel = window()->windowHandle();
+    QPlatformNativeInterface* native = QGuiApplication::platformNativeInterface();
+    if ( !topLevel || !native )
+        return -ENODATA;
+
+    if ( QGuiApplication::platformName() == QLatin1String( "xcb" ) ) {
+        // X11 (Xwayland): the limits are a property of the declared child window, which is the 3D area's own window
+        Display* xdisplay = (Display*)native->nativeResourceForIntegration( "display" );
+        QWindow* child = windowHandle();
+        if ( !xdisplay || !child )
+            return -ENODATA;
+        XSelectInput( xdisplay, (Window)child->winId(), PropertyChangeMask );
+        struct stereo_depth_limits xlimits;
+        int xresult = stereo_depth_x11_get_limits( xdisplay, (Window)child->winId(), &xlimits );
+        if ( xresult == 0 ) {
+            *sunk = xlimits.sunk;
+            *popped = xlimits.popped;
+        }
+        return xresult;
+    }
+
+    struct wl_display* display = (struct wl_display*)native->nativeResourceForIntegration( "wl_display" );
+    struct wl_surface* surface = (struct wl_surface*)native->nativeResourceForWindow( "surface", topLevel );
+    if ( !display || !surface )
+        return -ENOTSUP;
+
+    static bool initialized = false;
+    if ( !initialized ) {
+        stereo_declare_wayland_init( display, NULL );
+        initialized = true;
+    }
+
+    struct stereo_depth_limits limits;
+    int result = stereo_depth_wayland_get_limits( surface, &limits );
+    if ( result == 0 ) {
+        *sunk = limits.sunk;
+        *popped = limits.popped;
+    }
+    return result;
+}
+
+void MeshView::pollLimits()
+{
+    applyShownSize();
+    double sunk = 0.0, popped = 0.0;
+    int result = m_stereoSurface ? readDepthLimits( &sunk, &popped ) : -ENOTSUP;
+    bool changed = result != m_limitsResult || ( result == 0 && ( sunk != m_sunkLimit || popped != m_poppedLimit ) );
+    m_limitsResult = result;
+    m_haveLimits = result == 0;
+    if ( m_haveLimits ) {
+        m_sunkLimit = sunk;
+        m_poppedLimit = popped;
+    }
+
+    // the first answers come while the connection to the compositor is still being set up: tell the person only after a moment
+    bool settled = m_sinceStart.elapsed() > 2500;
+    QString text;
+    if ( !m_stereoEnabled )
+        text = QString();
+    else if ( m_stereoSurface && !context() )
+        text = QString();
+    else if ( m_stereoSurface && context() && !context()->format().stereo() )
+        text = tr( "The 3D view is shown flat: this computer cannot give a window with two views." );
+    else if ( settled && result == -ENOTSUP )
+        text = tr( "The 3D view is shown flat: the compositor does not tell the depth limits of the screen." );
+    else if ( m_haveLimits && m_sunkLimit <= 0.0 && m_poppedLimit <= 0.0 )
+        text = tr( "The 3D view is shown flat: the depth limits of the screen are zero." );
+    else if ( settled && result == -ENODATA )
+        text = tr( "The 3D view is shown flat: the compositor has not told the depth limits of the screen yet." );
+    setStereoStatus( text );
+
+    if ( changed )
+        update();
+}
+
+// The largest camera offset for which every vertex of the visible mesh stays inside the person's limits, one rule and no setting.
+// The limits are pixels of a view 1920 wide and are scaled to the width of this view.
+double MeshView::eyeOffset( double viewWidth, double halfFrustumWidth )
+{
+    if ( !m_stereoEnabled || !m_haveLimits || m_resolution.isEmpty() || !m_vertexArray )
+        return 0.0;
+
+    SceneGeometry scene;
+    scene.maximumDepth = m_maximumDepth;
+    scene.averageHeight = m_averageHeight;
+    scene.heightScale = m_settings.heightScale();
+    scene.rotation = m_rotation - m_animationState.rotation() * 360.0;
+    scene.angle = m_angle;
+    scene.cameraDistance = CameraDistance;
+    scene.nearClipping = NearClipping;
+    scene.farClipping = FarClipping;
+
+    double focal = 0.5 * viewWidth * NearClipping / halfFrustumWidth;
+    double scale = viewWidth / 1920.0;
+    double farthest = 0.0, nearest = 0.0;
+    double offset = stereoFitOffset( m_vertexArray, m_resolution.width() * m_resolution.height(), scene, focal, m_sunkLimit * scale, m_poppedLimit * scale, &farthest, &nearest );
+    if ( fabs( offset - m_offset ) > 0.01 * offset ) {
+        m_offset = offset;
+        qCDebug( lcStereo, "view %.0f px wide, offset %.5f, predicted disparity (right minus left, px): farthest %+.3f nearest %+.3f, limits sunk %.3f popped %.3f px",
+                 viewWidth, offset, offset * farthest, offset * nearest, m_sunkLimit * scale, m_poppedLimit * scale );
+    }
+    return offset;
 }
 
