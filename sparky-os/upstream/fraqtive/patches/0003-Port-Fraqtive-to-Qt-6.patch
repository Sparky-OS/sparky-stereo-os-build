diff --git a/configure b/configure
index ba506e7..104ac9c 100755
--- a/configure
+++ b/configure
@@ -57,7 +57,7 @@ if test -n "$QMAKE"; then
     exit 1
   fi
 else
-  for i in qmake qmake-qt4; do
+  for i in qmake qmake6 qmake-qt4; do
     if which $i >/dev/null 2>/dev/null; then
       paths="$paths `which $i`"
     fi
@@ -81,7 +81,7 @@ for i in $paths; do
   if test "$version" != "**Unknown**"; then
     major=`echo $version | sed -e "s/\([0-9][0-9]*\).*/\1/"`
     minor=`echo $version | sed -e "s/[0-9][0-9]*\.\([0-9][0-9]*\).*/\1/"`
