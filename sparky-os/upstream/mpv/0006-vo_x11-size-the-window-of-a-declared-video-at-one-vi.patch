From 1da1b11a67ed695154e0f1ec9de70138090e5d6c Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 5 Oct 2026 01:50:49 -0300
Subject: [PATCH 06/19] vo_x11: size the window of a declared video at one view

A compositor that holds both views of a declared X11 window doubles the
window the program asks for, and tells the program its one view size
(declaration version 3). The video is full side by side, so the window
was asked for at twice the size of one view. Ask for one view instead:
the width of the video's display size, halved, goes into autofit,
--window-scale and --geometry, so no --geometry is needed.

Assisted-by: Claude Sonnet via Claude Code
---
 video/out/vo.h         | 4 ++++
 video/out/win_state.c  | 2 ++
 video/out/x11_common.c | 1 +
 3 files changed, 7 insertions(+)

diff --git a/video/out/vo.h b/video/out/vo.h
index feedc0ee38..c6eda09c32 100644
--- a/video/out/vo.h
+++ b/video/out/vo.h
@@ -519,6 +519,10 @@ struct vo {
     int dheight;
     float monitor_par;
 
+    // the video is declared as full side by side stereo content, so the window
+    // size is that of one view
+    bool stereo_content;
+
     // current GPU context (--vo=gpu and --vo=gpu-next only)
     const char *context_name;
 
diff --git a/video/out/win_state.c b/video/out/win_state.c
index f812dcdd2b..28e5695fbc 100644
--- a/video/out/win_state.c
+++ b/video/out/win_state.c
@@ -107,6 +107,8 @@ void vo_calc_window_geometry(struct vo *vo, struct mp_vo_opts *opts,
     mp_image_params_get_dsize(&params, &d_w, &d_h);
     if ((vo->driver->caps & VO_CAP_ROTATE90) && params.rotate % 180 == 90)
         MPSWAP(int, d_w, d_h);
+    if (vo->stereo_content)
+        d_w /= 2;
     d_w = MPCLAMP(d_w * opts->window_scale * dpi_scale, 1, 16000);
     d_h = MPCLAMP(d_h * opts->window_scale * dpi_scale, 1, 16000);
 
diff --git a/video/out/x11_common.c b/video/out/x11_common.c
index e2c1962e1e..702cf709bc 100644
--- a/video/out/x11_common.c
+++ b/video/out/x11_common.c
@@ -2113,6 +2113,7 @@ int vo_x11_control(struct vo *vo, int *events, int request, void *arg)
 #if HAVE_STEREO_DECLARE
     case VOCTRL_SET_STEREO_CONTENT: {
         bool active = *(bool *)arg;
+        vo->stereo_content = active;
         int ret = active ?
             stereo_declare_x11(vo->x11->display, vo->x11->window,
                                STEREO_SBS_FULL, STEREO_CLASS_VIDEO,
-- 
