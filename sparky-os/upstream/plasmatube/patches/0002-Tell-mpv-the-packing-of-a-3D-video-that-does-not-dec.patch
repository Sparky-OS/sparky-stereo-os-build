+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <QtTest/QtTest>
+
+#include "utils/stereokeywords.h"
+
+using namespace Qt::StringLiterals;
+
+class StereoKeywordsTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void testPacking_data()
+    {
+        QTest::addColumn<QStringList>("keywords");
+        QTest::addColumn<QString>("packing");
+
+        QTest::newRow("none") << QStringList{u"music"_s, u"live"_s} << QString();
+        QTest::newRow("empty") << QStringList{} << QString();
+        QTest::newRow("lr") << QStringList{u"yt3d:enable=LR"_s} << u"sbs2l"_s;
+        QTest::newRow("rl") << QStringList{u"yt3d:enable=RL"_s} << u"sbs2r"_s;
+        QTest::newRow("lonr") << QStringList{u"yt3d:enable=LonR"_s} << u"ab2l"_s;
+        QTest::newRow("ronl") << QStringList{u"yt3d:enable=RonL"_s} << u"ab2r"_s;
+        QTest::newRow("true") << QStringList{u"yt3d:enable=true"_s} << u"sbs2l"_s;
+        QTest::newRow("false") << QStringList{u"yt3d:enable=false"_s} << QString();
+        QTest::newRow("case and space") << QStringList{u" YT3D:Enable=lr "_s} << u"sbs2l"_s;
+        QTest::newRow("swap") << QStringList{u"yt3d:enable=true"_s, u"yt3d:swap=true"_s} << u"sbs2r"_s;
+        QTest::newRow("swap first") << QStringList{u"yt3d:swap=true"_s, u"yt3d:enable=LonR"_s} << u"ab2r"_s;
+        QTest::newRow("swap alone") << QStringList{u"yt3d:swap=true"_s} << QString();
+        QTest::newRow("rectangles side by side") << QStringList{u"yt3d:left=0_0_0.5_1"_s, u"yt3d:right=0.5_0_1_1"_s} << u"sbs2l"_s;
+        QTest::newRow("rectangles side by side, right first") << QStringList{u"yt3d:left=0.5_0_1_1"_s, u"yt3d:right=0_0_0.5_1"_s} << u"sbs2r"_s;
+        QTest::newRow("rectangles over under") << QStringList{u"yt3d:left=0_0_1_0.5"_s, u"yt3d:right=0_0.5_1_1"_s} << u"ab2l"_s;
+        QTest::newRow("rectangles over under, right first") << QStringList{u"yt3d:right=0_0_1_0.5"_s, u"yt3d:left=0_0.5_1_1"_s} << u"ab2r"_s;
+        QTest::newRow("rectangles of another shape") << QStringList{u"yt3d:left=0_0_1_0.4"_s, u"yt3d:right=0_0.6_1_1"_s} << QString();
+        QTest::newRow("enable wins over rectangles") << QStringList{u"yt3d:left=0_0_1_0.5"_s, u"yt3d:right=0_0.5_1_1"_s, u"yt3d:enable=LR"_s} << u"sbs2l"_s;
+        QTest::newRow("aspect is ignored") << QStringList{u"yt3d:enable=LR"_s, u"yt3d:aspect=16:9"_s} << u"sbs2l"_s;
+    }
+
+    void testPacking()
+    {
+        QFETCH(QStringList, keywords);
+        QFETCH(QString, packing);
+
+        QCOMPARE_EQ(StereoKeywords::stereoInput(keywords), packing);
+    }
+};
+
+QTEST_MAIN(StereoKeywordsTest)
+#include "stereokeywordstest.moc"
