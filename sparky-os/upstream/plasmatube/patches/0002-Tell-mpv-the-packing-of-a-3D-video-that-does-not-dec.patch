+void MpvObject::setStereoInput(const QString &stereoInput)
+{
+    m_stereoInput = stereoInput;
+}
+
+// mpv unpacks 3D video that says it is 3D (the frame packing SEI, Matroska's StereoMode). For a video that does not, say
+// which packing it has: the one its keywords declare, else side by side when the frame is wider than any single picture
+// (at least 2.5 times as wide as high, as mpv decides full from half size views). The half size name is given, mpv
+// takes full size views from the shape of the frame.
+void MpvObject::updateStereoFilter()
+{
+    const QVariantMap params = getProperty(QStringLiteral("video-params")).toMap();
+    if (params.isEmpty()) {
+        return;
+    }
+
+    QString stereoFilter;
+    const QString declared = params.value(QStringLiteral("stereo-in")).toString();
+    if (declared.isEmpty() || declared == QStringLiteral("mono")) {
+        QString stereoInput = m_stereoInput;
+        if (stereoInput.isEmpty() && params.value(QStringLiteral("dw")).toDouble() >= 2.5 * params.value(QStringLiteral("dh")).toDouble()) {
+            stereoInput = QStringLiteral("sbs2l");
+        }
+        if (!stereoInput.isEmpty()) {
+            stereoFilter = QStringLiteral("format:stereo-in=") + stereoInput;
+        }
+    }
+
+    if (stereoFilter != m_stereoFilter) {
+        m_stereoFilter = stereoFilter;
+        setProperty(QStringLiteral("vf"), stereoFilter);
+    }
+}
+
 qreal MpvObject::position() const
 {
     return m_position;
