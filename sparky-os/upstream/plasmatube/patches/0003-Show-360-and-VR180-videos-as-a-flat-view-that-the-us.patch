+
+void MpvObject::pan(qreal yaw, qreal pitch)
+{
+    if (!m_panorama) {
+        return;
+    }
+
+    m_yaw = std::remainder(m_yaw + yaw, 360.0);
+    m_pitch = std::clamp(m_pitch + pitch, -85.0, 85.0);
+
+    if (paused()) {
+        // a filter command takes effect with the next frame, a new filter shows the picture again
+        setProperty(QStringLiteral("vf"), viewFilter());
+        return;
+    }
+
+    for (const auto &[command, value] : {std::pair{"yaw", m_yaw}, std::pair{"pitch", m_pitch}}) {
+        Q_EMIT this->command(QStringList() << QStringLiteral("vf-command") << QStringLiteral("vr") << QLatin1String(command)
+                                           << QString::number(value, 'f', 2) << QStringLiteral("v360"));
+    }
+}
+
+QString MpvObject::viewFilter() const
+{
+    return m_viewGraph + QStringLiteral(":yaw=%1:pitch=%2]").arg(QString::number(m_yaw, 'f', 2), QString::number(m_pitch, 'f', 2)) + m_viewTail;
+}
+
+// The filter that turns a 360 or VR180 video into a flat view of the direction the user looks in, or nothing. The video
+// says how it maps the sphere (the track's demux-projection, from MP4 sv3d or Matroska's Projection), else the API's
+// projectionType does. Both eyes of a stereo video are turned to the same direction and handed on as full side by side;
+// a mono video stays one picture. The layout is what the stream declares (the stereo-in parameter of video-params), else
+// the shape of the frame: an equirectangular sphere is twice as wide as high, so a square frame holds two on top of each
+// other, and VR180's half sphere is as wide as high, so a frame twice as wide holds two side by side.
+QString MpvObject::panoramaFilter(const QVariantMap &params, QString *key)
+{
+    QString projection;
+    const QVariantList tracks = getProperty(QStringLiteral("track-list")).toList();
+    for (const QVariant &track : tracks) {
+        const QVariantMap map = track.toMap();
+        if (map.value(QStringLiteral("type")).toString() == QStringLiteral("video") && map.value(QStringLiteral("selected")).toBool()) {
+            projection = map.value(QStringLiteral("demux-projection")).toString();
+        }
+    }
+
+    if (projection.isEmpty()) {
+        projection = m_projectionType == QStringLiteral("EQUIRECTANGULAR") ? QStringLiteral("equirectangular")
+            : m_projectionType == QStringLiteral("MESH")                    ? QStringLiteral("half-equirectangular")
+                                                                           : QString();
+    }
+
+    // The half sphere of a mesh is read as an equirectangular one
+    QString input;
+    if (projection == QStringLiteral("equirectangular")) {
+        input = QStringLiteral("e");
+    } else if (projection == QStringLiteral("half-equirectangular") || projection == QStringLiteral("mesh")) {
+        input = QStringLiteral("hequirect");
+    } else {
+        return {};
+    }
+
+    const qreal shape = params.value(QStringLiteral("dw")).toDouble() / std::max(params.value(QStringLiteral("dh")).toDouble(), 1.0);
+    const QString declared = params.value(QStringLiteral("stereo-in")).toString();
+    QString layout = QStringLiteral("2d");
+    QString swap;
+    if (declared.startsWith(QStringLiteral("ab")) || declared.startsWith(QStringLiteral("sbs"))) {
+        layout = declared.startsWith(QStringLiteral("ab")) ? QStringLiteral("tb") : QStringLiteral("sbs");
+        if (declared.endsWith(u'r')) {
+            // the right eye comes first
+            swap = layout == QStringLiteral("tb") ? QStringLiteral("stereo3d=in=abr:out=abl,") : QStringLiteral("stereo3d=in=sbsr:out=sbsl,");
+        }
+    } else if (input == QStringLiteral("e") && shape > 0.9 && shape < 1.15) {
+        layout = QStringLiteral("tb");
+    } else if (input == QStringLiteral("hequirect") && shape > 1.8 && shape < 2.3) {
+        layout = QStringLiteral("sbs");
+    }
+
+    // 100 degrees across one view of 16:9, which is a comfortable view on a television. With reset_rot the yaw and pitch
+    // that a filter command sets are the view's direction, not a turn added to the last one.
+    const QString view = QStringLiteral("v360=input=%1:output=flat:w=1280:h=720:h_fov=100:v_fov=67.7:in_stereo=%2:out_stereo=%3:reset_rot=1")
+                             .arg(input, layout, layout == QStringLiteral("2d") ? QStringLiteral("2d") : QStringLiteral("sbs"));
+    m_viewGraph = QStringLiteral("@vr:lavfi=[%1%2").arg(swap, view);
+    m_viewTail = layout == QStringLiteral("2d") ? QString() : QStringLiteral(",format:stereo-in=sbsl");
+    *key = m_viewGraph + m_viewTail;
+
+    return viewFilter();
+}
+
 // mpv unpacks 3D video that says it is 3D (the frame packing SEI, Matroska's StereoMode). For a video that does not, say
 // which packing it has: the one its keywords declare, else side by side when the frame is wider than any single picture
 // (at least 2.5 times as wide as high, as mpv decides full from half size views). The half size name is given, mpv
-// takes full size views from the shape of the frame.
+// takes full size views from the shape of the frame. A 360 or VR180 video is turned to a flat view first.
 void MpvObject::updateStereoFilter()
 {
     const QVariantMap params = getProperty(QStringLiteral("video-params")).toMap();
@@ -60,20 +162,33 @@ void MpvObject::updateStereoFilter()
         return;
     }
 
-    QString stereoFilter;
-    const QString declared = params.value(QStringLiteral("stereo-in")).toString();
-    if (declared.isEmpty() || declared == QStringLiteral("mono")) {
-        QString stereoInput = m_stereoInput;
-        if (stereoInput.isEmpty() && params.value(QStringLiteral("dw")).toDouble() >= 2.5 * params.value(QStringLiteral("dh")).toDouble()) {
-            stereoInput = QStringLiteral("sbs2l");
-        }
-        if (!stereoInput.isEmpty()) {
-            stereoFilter = QStringLiteral("format:stereo-in=") + stereoInput;
+    QString key;
+    QString stereoFilter = panoramaFilter(params, &key);
+    const bool panorama = !stereoFilter.isEmpty();
+    if (panorama != m_panorama) {
+        m_panorama = panorama;
+        // v360 works on frames in memory: decode on the GPU if there is one, and copy the frames back
+        setProperty(QStringLiteral("hwdec"), panorama ? QStringLiteral("auto-copy-safe") : QStringLiteral("auto-safe"));
+        Q_EMIT panoramaChanged();
+    }
+
+    if (!panorama) {
+        key.clear();
+        const QString declared = params.value(QStringLiteral("stereo-in")).toString();
+        if (declared.isEmpty() || declared == QStringLiteral("mono")) {
+            QString stereoInput = m_stereoInput;
+            if (stereoInput.isEmpty() && params.value(QStringLiteral("dw")).toDouble() >= 2.5 * params.value(QStringLiteral("dh")).toDouble()) {
+                stereoInput = QStringLiteral("sbs2l");
+            }
+            if (!stereoInput.isEmpty()) {
+                stereoFilter = QStringLiteral("format:stereo-in=") + stereoInput;
+            }
         }
+        key = stereoFilter;
     }
 
-    if (stereoFilter != m_stereoFilter) {
-        m_stereoFilter = stereoFilter;
+    if (key != m_stereoFilter) {
+        m_stereoFilter = key;
         setProperty(QStringLiteral("vf"), stereoFilter);
     }
 }
