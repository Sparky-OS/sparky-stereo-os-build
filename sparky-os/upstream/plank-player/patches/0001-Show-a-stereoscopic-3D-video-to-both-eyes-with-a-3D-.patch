diff --git a/CMakeLists.txt b/CMakeLists.txt
index b342dba..a284c9e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,6 +50,35 @@ ecm_find_qmlmodule(QtQuick.Templates 2.15)
 ecm_find_qmlmodule(QtMultimedia 2.15)
 ecm_find_qmlmodule(Qt5Compat.GraphicalEffects 2.15)
 
+# Stereoscopic 3D video: the packing of the frames comes from Qt Multimedia with QVideoFrameFormat::StereoMode, and the
+# views go to the compositor as stereo content (libstereo-declare) when the compositor takes it; each part is used where it
+# is found and Plank Player plays as before without it
+include(CheckCXXSourceCompiles)
+set(CMAKE_REQUIRED_LIBRARIES Qt6::Multimedia)
+set(CMAKE_REQUIRED_FLAGS "-fPIC")
+check_cxx_source_compiles("
+#include <QVideoFrameFormat>
+int main() { return int(QVideoFrameFormat::StereoMode::TopBottom); }" HAVE_STEREO_MODE)
+unset(CMAKE_REQUIRED_LIBRARIES)
+unset(CMAKE_REQUIRED_FLAGS)
+
+find_package(Qt6 ${QT_MIN_VERSION} CONFIG OPTIONAL_COMPONENTS GuiPrivate)
+find_package(WaylandScanner)
+find_package(PkgConfig)
+if(PkgConfig_FOUND)
+    pkg_check_modules(WAYLAND_CLIENT IMPORTED_TARGET wayland-client)
+    pkg_check_modules(WAYLAND_PROTOCOLS wayland-protocols)
+    pkg_check_modules(STEREO_DECLARE IMPORTED_TARGET stereo-declare)
+endif()
+if(HAVE_STEREO_MODE AND Qt6GuiPrivate_FOUND AND WaylandScanner_FOUND AND WAYLAND_CLIENT_FOUND AND WAYLAND_PROTOCOLS_FOUND AND STEREO_DECLARE_FOUND)
+    set(HAVE_STEREO_LAYER TRUE)
+    # The generated code of the viewporter protocol is C
+    enable_language(C)
+    pkg_get_variable(WAYLAND_PROTOCOLS_DIR wayland-protocols pkgdatadir)
+endif()
+add_feature_info("Stereoscopic 3D video" HAVE_STEREO_MODE "the packing of the frames, from Qt Multimedia")
+add_feature_info("Stereo content layer" HAVE_STEREO_LAYER "the views as stereo content for the compositor")
+
 add_subdirectory(app)
 add_subdirectory(icons)
 
