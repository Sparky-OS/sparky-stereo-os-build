diff --git a/app/stereo.cpp b/app/stereo.cpp
new file mode 100644
index 0000000..d54da8a
--- /dev/null
+++ b/app/stereo.cpp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "stereo.h"
+
+#include <cstring>
+
+namespace Stereo
+{
+using Mode = QVideoFrameFormat::StereoMode;
+
+bool isPacked(Mode mode)
+{
+    return mode != Mode::None && mode != Mode::AnaglyphCyanRed && mode != Mode::AnaglyphGreenMagenta;
+}
+
+QSize viewSize(const QSize &frameSize, Mode mode, ViewSize views)
+{
+    const qreal aspect = frameSize.height() > 0 ? qreal(frameSize.width()) / frameSize.height() : 1;
+    switch (mode) {
+    case Mode::SideBySide:
+    case Mode::SideBySideQuincunx:
+        return views == ViewSize::Full || (views == ViewSize::Auto && aspect >= 2.5) ? QSize(frameSize.width() / 2, frameSize.height()) : frameSize;
+    case Mode::TopBottom:
+        return views == ViewSize::Full || (views == ViewSize::Auto && aspect <= 1.2) ? QSize(frameSize.width(), frameSize.height() / 2) : frameSize;
+    default:
+        return frameSize;
+    }
+}
+
+QImage slot(const QImage &frame, Mode mode, int slot, const QSize &viewSize)
+{
+    const QImage source = frame.format() == QImage::Format_RGB32 ? frame : frame.convertToFormat(QImage::Format_RGB32);
+    const int width = source.width();
+    const int height = source.height();
+    QImage view;
+    switch (mode) {
+    case Mode::SideBySide:
+    case Mode::SideBySideQuincunx:
+        view = source.copy(slot * (width / 2), 0, width / 2, height);
+        break;
+    case Mode::TopBottom:
+        view = source.copy(0, slot * (height / 2), width, height / 2);
+        break;
+    case Mode::RowInterleaved:
+        // The first view is in the first row
+        view = QImage(width, height / 2, QImage::Format_RGB32);
+        for (int y = 0; y < view.height(); ++y) {
+            std::memcpy(view.scanLine(y), source.constScanLine(2 * y + slot), size_t(width) * 4);
+        }
+        break;
+    case Mode::ColumnInterleaved:
+        // The first view is in the first column
+        view = QImage(width / 2, height, QImage::Format_RGB32);
+        for (int y = 0; y < height; ++y) {
+            const auto *in = reinterpret_cast<const quint32 *>(source.constScanLine(y));
+            auto *out = reinterpret_cast<quint32 *>(view.scanLine(y));
+            for (int x = 0; x < view.width(); ++x) {
+                out[x] = in[2 * x + slot];
+            }
+        }
+        break;
+    case Mode::Checkerboard:
+        // The first view is at the top left pixel, the pixels of a view are those where x + y has its parity
+        view = QImage(width / 2, height, QImage::Format_RGB32);
+        for (int y = 0; y < height; ++y) {
+            const auto *in = reinterpret_cast<const quint32 *>(source.constScanLine(y));
+            auto *out = reinterpret_cast<quint32 *>(view.scanLine(y));
+            for (int x = 0; x < view.width(); ++x) {
+                out[x] = in[2 * x + ((slot + y) & 1)];
+            }
+        }
+        break;
+    default:
+        view = source;
+        break;
+    }
+    return view.size() == viewSize ? view : view.scaled(viewSize, Qt::IgnoreAspectRatio, Qt::SmoothTransformation);
+}
+}
diff --git a/app/stereo.h b/app/stereo.h
new file mode 100644
index 0000000..d43f0e7
--- /dev/null
+++ b/app/stereo.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#pragma once
+
+#include <QImage>
+#include <QSize>
+#include <QtMultimedia/QVideoFrameFormat>
+
+/**
+ * The views of a stereoscopic 3D video, which a frame holds in one of the packings of
+ * QVideoFrameFormat::StereoMode (the frame packing arrangement types of H.264 Table D-8 and
+ * H.265 Table D.8, Matroska's StereoMode).
+ */
+namespace Stereo
+{
+// True for the packings that hold two views to take apart. Anaglyph holds them mixed in one
+// picture, which is shown as it is.
+[[nodiscard]] bool isPacked(QVideoFrameFormat::StereoMode mode);
+
+// Whether the views of a side by side or top and bottom frame are half or full size
+enum class ViewSize {
+    Auto,
+    Half,
+    Full,
+};
+
+// The size one view is shown at, from the size of the frame. The stream does not say whether the
+// views of a side by side or top and bottom frame are half or full size, so the shape of the frame
+// decides: a side by side frame at least 2.5 times as wide as high, or a top and bottom frame at
+// most 1.2 times as wide as high, holds full size views. The views of the other packings are
+// taken from the frame at its own shape.
+[[nodiscard]] QSize viewSize(const QSize &frameSize, QVideoFrameFormat::StereoMode mode, ViewSize views = ViewSize::Auto);
+
+// The first (slot 0) or the second (slot 1) view of a frame, at the given size of a view. For a
+// frame sequence that is the frame itself.
+[[nodiscard]] QImage slot(const QImage &frame, QVideoFrameFormat::StereoMode mode, int slot, const QSize &viewSize);
+}
diff --git a/app/stereofilter.cpp b/app/stereofilter.cpp
new file mode 100644
index 0000000..79cf212
--- /dev/null
+++ b/app/stereofilter.cpp
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "stereofilter.h"
+
+#ifdef HAVE_STEREO_MODE
+#include "stereo.h"
+
+using Mode = QVideoFrameFormat::StereoMode;
+#endif
+
+StereoFilter::StereoFilter(QObject *parent)
+    : QObject(parent)
+    , m_sink(new QVideoSink(this))
+{
+    // The frames come from the playback thread, and are handled in this one
+    connect(m_sink, &QVideoSink::videoFrameChanged, this, [this](const QVideoFrame &frame) {
+        process(frame);
+    });
+    connect(m_sink, &QVideoSink::subtitleTextChanged, this, [this](const QString &text) {
+        if (m_output) {
+            m_output->setSubtitleText(text);
+        }
+    });
+}
+
+QVideoSink *StereoFilter::videoSink() const
+{
+    return m_sink;
+}
+
+QVideoSink *StereoFilter::output() const
+{
+    return m_output;
+}
+
+void StereoFilter::setOutput(QVideoSink *output)
+{
+    if (m_output == output) {
+        return;
+    }
+    m_output = output;
+    Q_EMIT outputChanged();
+    process(m_frame);
+}
+
+StereoFilter::View StereoFilter::view() const
+{
+    return m_view;
+}
+
+void StereoFilter::setView(View view)
+{
+    if (m_view == view) {
+        return;
+    }
+    m_view = view;
+    Q_EMIT viewChanged();
+    process(m_frame);
+}
+
+StereoFilter::Input StereoFilter::input() const
+{
+    return m_input;
+}
+
+void StereoFilter::setInput(Input input)
+{
+    if (m_input == input) {
+        return;
+    }
+    m_input = input;
+    m_sequence = 0;
+    Q_EMIT inputChanged();
+    process(m_frame);
+}
+
+bool StereoFilter::swapEyes() const
+{
+    return m_swapEyes;
+}
+
+void StereoFilter::setSwapEyes(bool swap)
+{
+    if (m_swapEyes == swap) {
+        return;
+    }
+    m_swapEyes = swap;
+    m_sequence = 0;
+    Q_EMIT inputChanged();
+    process(m_frame);
+}
+
+bool StereoFilter::isStereo() const
+{
+    return m_stereo;
+}
+
+bool StereoFilter::isAnaglyph() const
+{
+    return m_anaglyph;
+}
+
+qreal StereoFilter::viewAspect() const
+{
+    return m_viewAspect;
+}
+
+void StereoFilter::process(const QVideoFrame &frame)
+{
+    [[maybe_unused]] const bool repeat = frame.isValid() && frame == m_frame;
+    m_frame = frame;
+    if (!m_output) {
+        return;
+    }
+    if (!frame.isValid()) {
+        m_sequence = 0;
+        m_left = m_right = QImage();
+        m_output->setVideoFrame(frame);
+        return;
+    }
+
+#ifndef HAVE_STEREO_MODE
+    // Qt Multimedia without the packing of the frames: the video is shown as it is
+    m_output->setVideoFrame(frame);
+#else
+    const QVideoFrameFormat format = frame.surfaceFormat();
+    Mode mode = format.stereoMode();
+    Stereo::ViewSize views = Stereo::ViewSize::Auto;
+    switch (m_input) {
+    case AutoInput:
+        break;
+    case SideBySideHalf:
+    case SideBySideFull:
+        mode = Mode::SideBySide;
+        views = m_input == SideBySideFull ? Stereo::ViewSize::Full : Stereo::ViewSize::Half;
+        break;
+    case TopBottomHalf:
+    case TopBottomFull:
+        mode = Mode::TopBottom;
+        views = m_input == TopBottomFull ? Stereo::ViewSize::Full : Stereo::ViewSize::Half;
+        break;
+    case RowInterleaved:
+        mode = Mode::RowInterleaved;
+        break;
+    case ColumnInterleaved:
+        mode = Mode::ColumnInterleaved;
+        break;
+    case Checkerboard:
+        mode = Mode::Checkerboard;
+        break;
+    case FrameSequence:
+        mode = Mode::FrameSequence;
+        break;
+    case AnaglyphCyanRed:
+        mode = Mode::AnaglyphCyanRed;
+        break;
+    case AnaglyphGreenMagenta:
+        mode = Mode::AnaglyphGreenMagenta;
+        break;
+    case NotStereo:
+        mode = Mode::None;
+        break;
+    }
+    // Neither the stream nor the user says it is 3D: a frame at least 2.5 times as wide as high is taken as full size views side by side
+    if (mode == Mode::None && m_input == AutoInput && frame.height() > 0 && qreal(frame.width()) / frame.height() >= 2.5) {
+        mode = Mode::SideBySide;
+        views = Stereo::ViewSize::Full;
+    }
+    const QSize size = Stereo::viewSize(frame.size(), mode, views);
+    const qreal aspect = size.height() > 0 ? qreal(size.width()) / size.height() : 1;
+    if (int(mode) != m_mode || aspect != m_viewAspect) {
+        if (int(mode) != m_mode) {
+            m_sequence = 0;
+            m_left = m_right = QImage();
+        }
+        m_mode = int(mode);
+        m_stereo = Stereo::isPacked(mode);
+        m_anaglyph = mode == Mode::AnaglyphCyanRed || mode == Mode::AnaglyphGreenMagenta;
+        m_viewAspect = aspect;
+        Q_EMIT stereoChanged();
+    }
+
+    if (!Stereo::isPacked(mode) || m_view == BothViews) {
+        m_output->setVideoFrame(frame);
+        return;
+    }
+
+    // The eye the frame, or its first or second view, is for: the views come in the order the stream gives, left first unless it says otherwise
+    const bool rightFirst = format.stereoFlags().testFlag(QVideoFrameFormat::StereoFlag::RightEyeFirst) != m_swapEyes;
+    const bool wantRight = m_view == RightView;
+    if (m_view == Stereo3DView) {
+        if (mode == Mode::FrameSequence) {
+            bool isRight = rightFirst != (m_sequence % 2 == 1);
+            if (format.stereoView() != QVideoFrameFormat::StereoView::Packed && m_input == AutoInput) {
+                isRight = (format.stereoView() == QVideoFrameFormat::StereoView::Right) != m_swapEyes;
+            } else if (!repeat) {
+                ++m_sequence;
+            }
+            // Each frame brings its eye; a pair is shown when its second frame has come, so that both eyes are from the same moment
+            const bool first = m_left.isNull() && m_right.isNull();
+            (isRight ? m_right : m_left) = frame.toImage();
+            if (m_left.isNull()) {
+                m_left = m_right;
+            }
+            if (m_right.isNull()) {
+                m_right = m_left;
+            }
+            if (first || isRight != rightFirst) {
+                Q_EMIT eyes(m_left, m_right);
+            }
+        } else {
+            const QImage image = frame.toImage();
+            Q_EMIT eyes(Stereo::slot(image, mode, rightFirst ? 1 : 0, size), Stereo::slot(image, mode, rightFirst ? 0 : 1, size));
+        }
+        return;
+    }
+    if (mode == Mode::FrameSequence) {
+        bool isRight = rightFirst != (m_sequence % 2 == 1);
+        if (format.stereoView() != QVideoFrameFormat::StereoView::Packed && m_input == AutoInput) {
+            isRight = (format.stereoView() == QVideoFrameFormat::StereoView::Right) != m_swapEyes;
+        } else if (!repeat) {
+            ++m_sequence;
+        }
+        if (isRight == wantRight) {
+            m_output->setVideoFrame(frame);
+        }
+        return;
+    }
+
+    const QImage view = Stereo::slot(frame.toImage(), mode, wantRight != rightFirst ? 1 : 0, size);
+    QVideoFrame result(view);
+    result.setStartTime(frame.startTime());
+    result.setEndTime(frame.endTime());
+    m_output->setVideoFrame(result);
+#endif
+}
diff --git a/app/stereofilter.h b/app/stereofilter.h
new file mode 100644
index 0000000..e1152a6
--- /dev/null
+++ b/app/stereofilter.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#pragma once
+
+#include <QPointer>
+#include <QtMultimedia/QVideoFrame>
+#include <QtMultimedia/QVideoSink>
+
+/**
+ * Sits between the media player and the video output. A stereoscopic 3D video, whatever its
+ * packing (QVideoFrameFormat::StereoMode), goes to the output as the one view that is chosen, at
+ * the shape of a view, or as it is stored; anything else goes through untouched.
+ */
+class StereoFilter : public QObject
+{
+    Q_OBJECT
+    // What the media player draws into
+    Q_PROPERTY(QVideoSink *videoSink READ videoSink CONSTANT)
+    // What shows the video
+    Q_PROPERTY(QVideoSink *output READ output WRITE setOutput NOTIFY outputChanged)
+    Q_PROPERTY(View view READ view WRITE setView NOTIFY viewChanged)
+    // How the video packs its views, when the stream does not say or says it wrong; Auto takes the stream's word
+    Q_PROPERTY(Input input READ input WRITE setInput NOTIFY inputChanged)
+    // The eyes are the other way round
+    Q_PROPERTY(bool swapEyes READ swapEyes WRITE setSwapEyes NOTIFY inputChanged)
+    // The video holds two views in a packing that can be taken apart
+    Q_PROPERTY(bool stereo READ isStereo NOTIFY stereoChanged)
+    // The video holds two views mixed into one picture, which is shown as it is
+    Q_PROPERTY(bool anaglyph READ isAnaglyph NOTIFY stereoChanged)
+    // The shape of one view
+    Q_PROPERTY(qreal viewAspect READ viewAspect NOTIFY stereoChanged)
+public:
+    enum View {
+        LeftView,
+        RightView,
+        BothViews,
+        // Both views, one for each eye, to the stereoLayer
+        Stereo3DView,
+    };
+    Q_ENUM(View)
+
+    // The packings of H.264 Table D-8 and H.265 Table D.8, the half and full size views of side by side and top and
+    // bottom told apart, the anaglyphs of Matroska's StereoMode, and the video that is not stereoscopic
+    enum Input {
+        AutoInput,
+        SideBySideHalf,
+        SideBySideFull,
+        TopBottomHalf,
+        TopBottomFull,
+        RowInterleaved,
+        ColumnInterleaved,
+        Checkerboard,
+        FrameSequence,
+        AnaglyphCyanRed,
+        AnaglyphGreenMagenta,
+        NotStereo,
+    };
+    Q_ENUM(Input)
+
+    explicit StereoFilter(QObject *parent = nullptr);
+
+    // Invoked by the media player to find what to draw into
+    Q_INVOKABLE QVideoSink *videoSink() const;
+    QVideoSink *output() const;
+    void setOutput(QVideoSink *output);
+    View view() const;
+    void setView(View view);
+    Input input() const;
+    void setInput(Input input);
+    bool swapEyes() const;
+    void setSwapEyes(bool swap);
+    bool isStereo() const;
+    bool isAnaglyph() const;
+    qreal viewAspect() const;
+
+Q_SIGNALS:
+    // The two views of the frame that came in, at the shape of a view, left and right
+    void eyes(const QImage &left, const QImage &right);
+    void outputChanged();
+    void viewChanged();
+    void inputChanged();
+    void stereoChanged();
+
+private:
+    void process(const QVideoFrame &frame);
+
+    QVideoSink *m_sink;
+    QPointer<QVideoSink> m_output;
+    View m_view = LeftView;
+    Input m_input = AutoInput;
+    bool m_swapEyes = false;
+    QVideoFrame m_frame;
+    // The QVideoFrameFormat::StereoMode the frames are taken as
+    int m_mode = 0;
+    qreal m_viewAspect = 1;
+    // The frames of a frame sequence that do not say which eye they are for come in turns
+    int m_sequence = 0;
+    QImage m_left;
+    QImage m_right;
+    bool m_stereo = false;
+    bool m_anaglyph = false;
+};
diff --git a/app/stereolayer.cpp b/app/stereolayer.cpp
new file mode 100644
index 0000000..9d53bc4
--- /dev/null
+++ b/app/stereolayer.cpp
@@ -0,0 +1,496 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+
+#include "stereolayer.h"
+
+#ifdef HAVE_STEREO_LAYER
+#include <cstring>
+
+#include <QGuiApplication>
+#include <QLoggingCategory>
+#include <QPainter>
+#include <QtGui/qpa/qplatformwindow_p.h>
+
+#include <sys/mman.h>
+#include <unistd.h>
+#include <wayland-client.h>
+
+#include <stereo-declare.h>
+
+#include "wayland-viewporter-client-protocol.h"
+
+Q_STATIC_LOGGING_CATEGORY(PlankStereoLayer, "plank.stereolayer")
+
+namespace
+{
+struct Globals {
+    wl_compositor *compositor{nullptr};
+    wl_subcompositor *subcompositor{nullptr};
+    wl_shm *shm{nullptr};
+    wp_viewporter *viewporter{nullptr};
+    bool stereo{false};
+};
+
+void registryGlobal(void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+    auto *globals = static_cast<Globals *>(data);
+    if (!strcmp(interface, wl_compositor_interface.name)) {
+        globals->compositor = static_cast<wl_compositor *>(wl_registry_bind(registry, name, &wl_compositor_interface, qMin(version, 4u)));
+    } else if (!strcmp(interface, wl_subcompositor_interface.name)) {
+        globals->subcompositor = static_cast<wl_subcompositor *>(wl_registry_bind(registry, name, &wl_subcompositor_interface, 1));
+    } else if (!strcmp(interface, wl_shm_interface.name)) {
+        globals->shm = static_cast<wl_shm *>(wl_registry_bind(registry, name, &wl_shm_interface, 1));
+    } else if (!strcmp(interface, wp_viewporter_interface.name)) {
+        globals->viewporter = static_cast<wp_viewporter *>(wl_registry_bind(registry, name, &wp_viewporter_interface, 1));
+    } else if (!strcmp(interface, "kde_stereo_content_manager_v1")) {
+        globals->stereo = true;
+    }
+}
+
+void registryGlobalRemove(void *, wl_registry *, uint32_t)
+{
+}
+
+const wl_registry_listener registryListener = {registryGlobal, registryGlobalRemove};
+
+wl_display *waylandDisplay()
+{
+    if (QGuiApplication::platformName() != QLatin1String("wayland")) {
+        return nullptr;
+    }
+    auto *app = qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>();
+    return app ? app->display() : nullptr;
+}
+
+// Reads the globals on a queue of its own, so that nothing is dispatched on the queue Qt uses
+wl_registry *readGlobals(wl_display *display, wl_event_queue *queue, Globals &globals)
+{
+    auto *wrapper = static_cast<wl_display *>(wl_proxy_create_wrapper(display));
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wrapper), queue);
+    wl_registry *registry = wl_display_get_registry(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    wl_registry_add_listener(registry, &registryListener, &globals);
+    wl_display_roundtrip_queue(display, queue);
+    return registry;
+}
+
+void destroyGlobals(Globals &globals)
+{
+    if (globals.compositor) {
+        wl_compositor_destroy(globals.compositor);
+    }
+    if (globals.subcompositor) {
+        wl_subcompositor_destroy(globals.subcompositor);
+    }
+    if (globals.shm) {
+        wl_shm_destroy(globals.shm);
+    }
+    if (globals.viewporter) {
+        wp_viewporter_destroy(globals.viewporter);
+    }
+}
+
+// A buffer of the layer in shared memory, which the compositor gives back with release
+struct Buffer {
+    wl_buffer *buffer{nullptr};
+    uchar *data{nullptr};
+    size_t size{0};
+    QSize pixels;
+    bool busy{false};
+};
+
+void bufferRelease(void *data, wl_buffer *)
+{
+    static_cast<Buffer *>(data)->busy = false;
+}
+
+const wl_buffer_listener bufferListener = {bufferRelease};
+
+void destroyBuffer(Buffer &buffer)
+{
+    if (buffer.buffer) {
+        wl_buffer_destroy(buffer.buffer);
+    }
+    if (buffer.data) {
+        munmap(buffer.data, buffer.size);
+    }
+    buffer = {};
+}
+
+bool createBuffer(Buffer &buffer, wl_shm *shm, wl_event_queue *queue, const QSize &pixels)
+{
+    const int stride = pixels.width() * 4;
+    const size_t size = size_t(stride) * pixels.height();
+    const int fd = memfd_create("plank-stereo-layer", MFD_CLOEXEC);
+    if (fd < 0) {
+        return false;
+    }
+    if (ftruncate(fd, off_t(size)) < 0) {
+        close(fd);
+        return false;
+    }
+    void *data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        close(fd);
+        return false;
+    }
+    wl_shm_pool *pool = wl_shm_create_pool(shm, fd, int(size));
+    close(fd);
+    wl_buffer *wlBuffer = wl_shm_pool_create_buffer(pool, 0, pixels.width(), pixels.height(), stride, WL_SHM_FORMAT_XRGB8888);
+    wl_shm_pool_destroy(pool);
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wlBuffer), queue);
+    buffer.buffer = wlBuffer;
+    buffer.data = static_cast<uchar *>(data);
+    buffer.size = size;
+    buffer.pixels = pixels;
+    buffer.busy = false;
+    wl_buffer_add_listener(wlBuffer, &bufferListener, &buffer);
+    return true;
+}
+}
+
+struct StereoLayer::Private {
+    QPointer<QQuickWindow> window;
+    QPointer<StereoFilter> filter;
+    QMetaObject::Connection eyesConnection;
+    bool active{false};
+    QRectF rect;
+    QImage left;
+    QImage right;
+
+    wl_display *display{nullptr};
+    wl_event_queue *queue{nullptr};
+    wl_registry *registry{nullptr};
+    Globals globals;
+    wl_surface *surface{nullptr};
+    wl_subsurface *subsurface{nullptr};
+    wp_viewport *viewport{nullptr};
+    Buffer buffers[2];
+    bool declared{false};
+    bool stereoInitialized{false};
+    QRectF placed;
+};
+
+bool StereoLayer::isSupported()
+{
+    static const bool supported = [] {
+        wl_display *display = waylandDisplay();
+        if (!display) {
+            return false;
+        }
+        wl_event_queue *queue = wl_display_create_queue(display);
+        Globals globals;
+        wl_registry *registry = readGlobals(display, queue, globals);
+        const bool ok = globals.compositor && globals.subcompositor && globals.shm && globals.viewporter && globals.stereo;
+        destroyGlobals(globals);
+        wl_registry_destroy(registry);
+        wl_event_queue_destroy(queue);
+        return ok;
+    }();
+    return supported;
+}
+
+StereoLayer::StereoLayer(QObject *parent)
+    : QObject(parent)
+    , d(std::make_unique<Private>())
+{
+}
+
+StereoLayer::~StereoLayer()
+{
+    destroy();
+}
+
+QQuickWindow *StereoLayer::window() const
+{
+    return d->window;
+}
+
+void StereoLayer::setWindow(QQuickWindow *window)
+{
+    if (d->window == window) {
+        return;
+    }
+    destroy();
+    d->window = window;
+    // The window has to be created with an alpha buffer for the controls to be over the layer
+    if (window && isSupported() && !window->handle()) {
+        QSurfaceFormat format = window->format();
+        format.setAlphaBufferSize(8);
+        window->setFormat(format);
+    }
+    Q_EMIT windowChanged();
+    create();
+}
+
+StereoFilter *StereoLayer::filter() const
+{
+    return d->filter;
+}
+
+void StereoLayer::setFilter(StereoFilter *filter)
+{
+    if (d->filter == filter) {
+        return;
+    }
+    QObject::disconnect(d->eyesConnection);
+    d->filter = filter;
+    if (filter) {
+        d->eyesConnection = connect(filter, &StereoFilter::eyes, this, [this](const QImage &left, const QImage &right) {
+            d->left = left;
+            d->right = right;
+            draw();
+        });
+    }
+    Q_EMIT filterChanged();
+}
+
+bool StereoLayer::isActive() const
+{
+    return d->active;
+}
+
+void StereoLayer::setActive(bool active)
+{
+    active = active && isSupported();
+    if (d->active == active) {
+        return;
+    }
+    d->active = active;
+    if (active) {
+        create();
+    } else {
+        destroy();
+    }
+    Q_EMIT activeChanged();
+}
+
+QRectF StereoLayer::rect() const
+{
+    return d->rect;
+}
+
+void StereoLayer::setRect(const QRectF &rect)
+{
+    if (d->rect == rect) {
+        return;
+    }
+    d->rect = rect;
+    Q_EMIT rectChanged();
+    draw();
+}
+
+void StereoLayer::create()
+{
+    if (d->surface || !d->active || !d->window) {
+        return;
+    }
+    auto *windowInterface = d->window->nativeInterface<QNativeInterface::Private::QWaylandWindow>();
+    if (!windowInterface || !windowInterface->surface()) {
+        return;
+    }
+
+    d->display = waylandDisplay();
+    d->queue = wl_display_create_queue(d->display);
+    d->registry = readGlobals(d->display, d->queue, d->globals);
+    if (stereo_declare_wayland_init(d->display, d->queue) != 0) {
+        destroy();
+        return;
+    }
+    d->stereoInitialized = true;
+    wl_display_roundtrip_queue(d->display, d->queue);
+    if (!stereo_supported_wayland()) {
+        destroy();
+        return;
+    }
+
+    d->surface = wl_compositor_create_surface(d->globals.compositor);
+    d->subsurface = wl_subcompositor_get_subsurface(d->globals.subcompositor, d->surface, windowInterface->surface());
+    wl_subsurface_place_below(d->subsurface, windowInterface->surface());
+    // The layer changes with the frames of the video, not with those of the window
+    wl_subsurface_set_desync(d->subsurface);
+    d->viewport = wp_viewporter_get_viewport(d->globals.viewporter, d->surface);
+
+    // The window's surface keeps the pointer: the layer takes no input
+    wl_region *empty = wl_compositor_create_region(d->globals.compositor);
+    wl_surface_set_input_region(d->surface, empty);
+    wl_region_destroy(empty);
+
+    draw();
+}
+
+void StereoLayer::destroy()
+{
+    if (d->declared) {
+        stereo_remove_wayland(d->surface);
+        d->declared = false;
+    }
+    if (d->stereoInitialized) {
+        stereo_declare_wayland_finish();
+        d->stereoInitialized = false;
+    }
+    if (d->viewport) {
+        wp_viewport_destroy(d->viewport);
+        d->viewport = nullptr;
+    }
+    if (d->subsurface) {
+        wl_subsurface_destroy(d->subsurface);
+        d->subsurface = nullptr;
+    }
+    if (d->surface) {
+        wl_surface_destroy(d->surface);
+        d->surface = nullptr;
+    }
+    for (Buffer &buffer : d->buffers) {
+        destroyBuffer(buffer);
+    }
+    destroyGlobals(d->globals);
+    d->globals = {};
+    if (d->registry) {
+        wl_registry_destroy(d->registry);
+        d->registry = nullptr;
+    }
+    if (d->queue) {
+        wl_event_queue_destroy(d->queue);
+        d->queue = nullptr;
+    }
+    if (d->display) {
+        wl_display_flush(d->display);
+        d->display = nullptr;
+    }
+    d->placed = {};
+}
+
+// Puts the views into the layer, each at the size of the rectangle, side by side with the left
+// eye first: the full side by side the compositor takes
+void StereoLayer::draw()
+{
+    if (!d->surface || d->left.isNull() || d->right.isNull() || d->rect.isEmpty()) {
+        return;
+    }
+    // Nothing is listened to on the queue of the layer but the release of buffers
+    wl_display_dispatch_queue_pending(d->display, d->queue);
+
+    const qreal ratio = d->window ? d->window->devicePixelRatio() : 1;
+    const QSize view(qMax(1, qRound(d->rect.width() * ratio)), qMax(1, qRound(d->rect.height() * ratio)));
+    const QSize pixels(view.width() * 2, view.height());
+
+    Buffer *buffer = nullptr;
+    for (Buffer &candidate : d->buffers) {
+        if (candidate.buffer && candidate.pixels != pixels && !candidate.busy) {
+            destroyBuffer(candidate);
+        }
+        if (candidate.busy) {
+            continue;
+        }
+        if (!candidate.buffer && !createBuffer(candidate, d->globals.shm, d->queue, pixels)) {
+            continue;
+        }
+        if (candidate.pixels == pixels) {
+            buffer = &candidate;
+            break;
+        }
+    }
+    if (!buffer) {
+        return;
+    }
+
+    QImage target(buffer->data, pixels.width(), pixels.height(), pixels.width() * 4, QImage::Format_RGB32);
+    QPainter painter(&target);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform);
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    painter.drawImage(QRect(QPoint(0, 0), view), d->left);
+    painter.drawImage(QRect(QPoint(view.width(), 0), view), d->right);
+    painter.end();
+
+    const QRectF rect = d->rect;
+    if (rect != d->placed) {
+        wl_subsurface_set_position(d->subsurface, qRound(rect.x()), qRound(rect.y()));
+        wp_viewport_set_destination(d->viewport, qRound(rect.width()), qRound(rect.height()));
+        wl_region *opaque = wl_compositor_create_region(d->globals.compositor);
+        wl_region_add(opaque, 0, 0, qRound(rect.width()), qRound(rect.height()));
+        wl_surface_set_opaque_region(d->surface, opaque);
+        wl_region_destroy(opaque);
+        d->placed = rect;
+    }
+    if (!d->declared) {
+        const int result = stereo_declare_wayland(d->surface, STEREO_SBS_FULL, STEREO_CLASS_VIDEO, STEREO_VIDEO_CURRENT);
+        if (result < 0) {
+            qCWarning(PlankStereoLayer) << "declaring the stereo content failed:" << strerror(-result);
+        } else {
+            d->declared = true;
+        }
+    }
+    buffer->busy = true;
+    wl_surface_attach(d->surface, buffer->buffer, 0, 0);
+    wl_surface_damage_buffer(d->surface, 0, 0, pixels.width(), pixels.height());
+    wl_surface_commit(d->surface);
+    wl_display_flush(d->display);
+}
+#else
+
+// Without wl_subcompositor, wp_viewporter and the stereo content declaration at build time the layer is never supported
+struct StereoLayer::Private {
+};
+
+bool StereoLayer::isSupported()
+{
+    return false;
+}
+
+StereoLayer::StereoLayer(QObject *parent)
+    : QObject(parent)
+{
+}
+
+StereoLayer::~StereoLayer() = default;
+
+QQuickWindow *StereoLayer::window() const
+{
+    return nullptr;
+}
