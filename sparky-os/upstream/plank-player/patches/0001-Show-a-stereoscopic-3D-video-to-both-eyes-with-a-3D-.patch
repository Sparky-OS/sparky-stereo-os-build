+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick 2.15
+import QtQuick.Layouts 1.15
+import org.kde.kirigami 2.19 as Kirigami
+import QtQuick.Controls 2.15 as Controls
+import org.kde.plank.stereo 1.0
+
+// How a stereoscopic 3D video is shown, and how its views are packed when the video does not say, or says it wrong
+Controls.Popup {
+    id: stereoMenuArea
+    width: parent.width / 2
+    height: parent.height / 2
+    x: (parent.width - width) / 2
+    y: (parent.height - height) / 2
+    dim: true
+
+    // The StereoFilter of the video
+    property var filter
+    property bool layerSupported: false
+
+    readonly property var entries: {
+        var list = []
+        if (layerSupported) {
+            list.push({ group: i18nc("@title:group 3D video view selector", "View"), text: i18nc("@action:button stereoscopic 3D view selector, shown in 3D by the display", "3D"), kind: "view", value: StereoFilter.Stereo3DView, needsStereo: true })
+        }
+        list.push({ group: i18nc("@title:group 3D video view selector", "View"), text: i18nc("@action:button stereoscopic 3D view selector", "Left View"), kind: "view", value: StereoFilter.LeftView, needsStereo: true })
+        list.push({ group: i18nc("@title:group 3D video view selector", "View"), text: i18nc("@action:button stereoscopic 3D view selector", "Right View"), kind: "view", value: StereoFilter.RightView, needsStereo: true })
+        list.push({ group: i18nc("@title:group 3D video view selector", "View"), text: i18nc("@action:button stereoscopic 3D view selector, both views as the video holds them", "Both Views"), kind: "view", value: StereoFilter.BothViews, needsStereo: false })
+        var formats = [
+            { text: i18nc("@action:button 3D video input format, from what the video says", "Automatic"), value: StereoFilter.AutoInput },
+            { text: i18nc("@action:button 3D video input format", "Side by Side, Half Size Views"), value: StereoFilter.SideBySideHalf },
+            { text: i18nc("@action:button 3D video input format", "Side by Side, Full Size Views"), value: StereoFilter.SideBySideFull },
+            { text: i18nc("@action:button 3D video input format", "Top and Bottom, Half Size Views"), value: StereoFilter.TopBottomHalf },
+            { text: i18nc("@action:button 3D video input format", "Top and Bottom, Full Size Views"), value: StereoFilter.TopBottomFull },
+            { text: i18nc("@action:button 3D video input format", "Row Interleaved"), value: StereoFilter.RowInterleaved },
+            { text: i18nc("@action:button 3D video input format", "Column Interleaved"), value: StereoFilter.ColumnInterleaved },
+            { text: i18nc("@action:button 3D video input format", "Checkerboard"), value: StereoFilter.Checkerboard },
+            { text: i18nc("@action:button 3D video input format", "Frame Sequential"), value: StereoFilter.FrameSequence },
+            { text: i18nc("@action:button 3D video input format, red and cyan anaglyph, shown as it is", "Anaglyph, Red and Cyan"), value: StereoFilter.AnaglyphCyanRed },
+            { text: i18nc("@action:button 3D video input format, green and magenta anaglyph, shown as it is", "Anaglyph, Green and Magenta"), value: StereoFilter.AnaglyphGreenMagenta },
+            { text: i18nc("@action:button 3D video input format, the video is not 3D", "Not 3D"), value: StereoFilter.NotStereo }
+        ]
+        for (var i = 0; i < formats.length; ++i) {
+            list.push({ group: i18nc("@title:group 3D video input format selector", "Input Format"), text: formats[i].text, kind: "input", value: formats[i].value, needsStereo: false })
+        }
+        list.push({ group: i18nc("@title:group 3D video eye selector", "Eyes"), text: i18nc("@action:button 3D video, the left and right views are the other way round", "Swap Eyes"), kind: "swap", value: 0, needsStereo: false })
+        return list
+    }
+
+    onOpened: {
+        stereoMenuList.currentIndex = 0
+        stereoMenuList.forceActiveFocus()
+    }
+
+    Controls.Overlay.modeless: Rectangle {
+        color: Qt.rgba(Kirigami.Theme.backgroundColor.r, Kirigami.Theme.backgroundColor.g, Kirigami.Theme.backgroundColor.b, 0.77)
+    }
+
+    Item {
+        width: parent.width
+        height: parent.height
+
+        RowLayout {
+            id: headerAreaStereo
+            anchors.top: parent.top
+            anchors.left: parent.left
+            anchors.right: parent.right
+            height: Kirigami.Units.gridUnit * 2
+
+            Controls.Label {
+                Layout.fillWidth: true
+                Layout.leftMargin: Kirigami.Units.largeSpacing
+                elide: Text.ElideRight
+                text: i18nc("@title:window", "3D Video")
+            }
+
+            Controls.Label {
+                text: i18n("Press 'esc' or the [←] Back button to close")
+                Layout.alignment: Qt.AlignRight
+            }
+        }
+
+        Kirigami.Separator {
+            id: headerSeparatorStereo
+            anchors.top: headerAreaStereo.bottom
+            width: parent.width
+            height: 1
+        }
+
+        ListView {
+            id: stereoMenuList
+            anchors.top: headerSeparatorStereo.bottom
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.bottom: parent.bottom
+            anchors.margins: Kirigami.Units.largeSpacing
+            model: stereoMenuArea.entries
+            keyNavigationEnabled: true
+            highlightFollowsCurrentItem: true
+            spacing: Kirigami.Units.smallSpacing
+            clip: true
+
+            section.property: "group"
+            section.delegate: Controls.Label {
+                width: stereoMenuList.width
+                height: Kirigami.Units.gridUnit * 2
+                verticalAlignment: Text.AlignVCenter
+                font.bold: true
+                text: section
+            }
+
+            delegate: MenuButton {
+                required property var modelData
+                readonly property bool selected: modelData.kind === "view" ? stereoMenuArea.filter.view === modelData.value
+                                                                  || (modelData.value === StereoFilter.BothViews && stereoMenuArea.filter.anaglyph)
+                                                 : modelData.kind === "input" ? stereoMenuArea.filter.input === modelData.value
+                                                 : stereoMenuArea.filter.swapEyes
+                // An anaglyph video holds both views mixed into one picture, which is shown as it is
+                text: modelData.kind === "view" && modelData.value === StereoFilter.BothViews && stereoMenuArea.filter.anaglyph
+                      ? i18nc("@action:button stereoscopic 3D view selector, an anaglyph video holds both views mixed into one picture", "Anaglyph, Shown as It Is") : modelData.text
+                enabled: !modelData.needsStereo || stereoMenuArea.filter.stereo
+                icon.name: selected ? "dialog-ok-apply" : ""
+
+                onClicked: (mouse)=> {
+                    if (modelData.kind === "view") {
+                        stereoMenuArea.filter.view = modelData.value
+                    } else if (modelData.kind === "input") {
+                        stereoMenuArea.filter.input = modelData.value
+                    } else {
+                        stereoMenuArea.filter.swapEyes = !stereoMenuArea.filter.swapEyes
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/app/qml/StereoVideo.qml b/app/qml/StereoVideo.qml
new file mode 100644
index 0000000..a6e1c8e
--- /dev/null
+++ b/app/qml/StereoVideo.qml
@@ -0,0 +1,96 @@
+// SPDX-FileCopyrightText: 2026 Daniel Campos Ramos <Capitain_Jack@yahoo.com>
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick 2.15
+import QtMultimedia
+import org.kde.plank.stereo 1.0
+
+// A Video that shows a stereoscopic 3D video to the compositor as stereo content (both views, in a layer under the
+// window) or as one of its views; everything else is shown as Video shows it.
+Item {
+    id: stereoVideo
+
+    property var appWindow
+    property alias fillMode: videoOut.fillMode
+    property alias playbackState: player.playbackState
+    property alias duration: player.duration
+    property alias position: player.position
+    property alias source: player.source
+    property alias filter: stereoFilter
+    // The video is in the layer under the window: the window is transparent over it
+    readonly property bool layerActive: stereoLayer.active
+    readonly property bool layerSupported: stereoLayer.supported
+
+    function play() {
+        player.play()
+    }
+
+    function pause() {
+        player.pause()
+    }
+
+    function stop() {
+        player.stop()
+    }
+
+    function seek(offset) {
+        player.position = offset
+    }
+
+    VideoOutput {
+        id: videoOut
+        anchors.fill: parent
+        visible: !stereoLayer.active
+    }
+
+    StereoFilter {
+        id: stereoFilter
+        output: videoOut.videoSink
+        view: stereoLayer.supported ? StereoFilter.Stereo3DView : StereoFilter.LeftView
+    }
+
+    // A 3D video goes to the compositor as stereo content, both views in a layer under the window
+    StereoLayer {
+        id: stereoLayer
+        window: stereoVideo.appWindow
+        filter: stereoFilter
+        active: stereoFilter.stereo && stereoFilter.view === StereoFilter.Stereo3DView
+        rect: viewRect.mapToItem(null, 0, 0, viewRect.width, viewRect.height)
+    }
+
+    // The rectangle of one view, as large as it can be in the item
+    Item {
+        id: viewRect
+        readonly property bool stretch: stereoVideo.fillMode === VideoOutput.Stretch
+        width: stretch ? stereoVideo.width : Math.min(stereoVideo.width, stereoVideo.height * stereoFilter.viewAspect)
+        height: stretch ? stereoVideo.height : Math.min(stereoVideo.height, stereoVideo.width / stereoFilter.viewAspect)
+        x: (stereoVideo.width - width) / 2
+        y: (stereoVideo.height - height) / 2
+    }
+
+    // What the layer does not cover is black
+    Repeater {
+        model: stereoLayer.active ? 4 : 0
+        Rectangle {
+            required property int index
+            color: "black"
+            x: index === 3 ? viewRect.x + viewRect.width : 0
+            y: index === 1 ? viewRect.y + viewRect.height : index === 2 || index === 3 ? viewRect.y : 0
+            width: index === 2 ? viewRect.x : index === 3 ? stereoVideo.width - x : stereoVideo.width
+            height: index === 0 ? viewRect.y : index === 1 ? stereoVideo.height - y : viewRect.height
+        }
+    }
+
+    MediaPlayer {
+        id: player
+        videoOutput: stereoFilter
+        audioOutput: AudioOutput {
+        }
+        // The choice of the packing is for the file it was made for
+        onSourceChanged: {
+            stereoFilter.input = StereoFilter.AutoInput
+            stereoFilter.swapEyes = false
+        }
+    }
+}
