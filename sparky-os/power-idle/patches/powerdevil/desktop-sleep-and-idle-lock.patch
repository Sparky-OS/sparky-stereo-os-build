 unsigned int ProfileDefaults::defaultAutoSuspendAction(bool isVM, bool canSuspend)
+{
+    return defaultAutoSuspendAction(QString(), isVM, canSuspend);
+}
+
+unsigned int ProfileDefaults::defaultAutoSuspendAction(const QString &profileGroup, bool isVM, bool canSuspend)
 {
     if (!defaultAutoSuspendWhenIdle(isVM, canSuspend)) {
         return qToUnderlying(PowerButtonAction::NoAction);
     }
+    if (profileGroup == QStringLiteral("AC")) {
+        const QDBusInterface upower(QStringLiteral("org.freedesktop.UPower"),
+                                    QStringLiteral("/org/freedesktop/UPower"),
+                                    QStringLiteral("org.freedesktop.UPower"),
+                                    QDBusConnection::systemBus());
+        if (!upower.property("LidIsPresent").toBool()) {
+            return qToUnderlying(PowerButtonAction::NoAction);
+        }
+    }
     return defaultAutoSuspendType();
 }
 
