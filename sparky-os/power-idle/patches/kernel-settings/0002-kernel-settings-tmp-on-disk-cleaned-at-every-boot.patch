--- a/sparky-os/packages/sparky-stereo-kernel-settings/build.sh
+++ b/sparky-os/packages/sparky-stereo-kernel-settings/build.sh
@@ -8,7 +8,7 @@ OUT=${OUT:?Set OUT to the workspace output directory}
 VERSION=20261010.2~sparky9~0
 PACKAGE=sparky-stereo-kernel-settings
 DEPENDS='libpam-modules, systemd, systemd-zram-generator, udev'
-FILES='etc/security/limits.d/20-sparky-audio.conf usr/lib/modules-load.d/sparky-stereo.conf usr/lib/sysctl.d/70-sparky-stereo.conf usr/lib/systemd/zram-generator.conf.d/50-sparky-stereo.conf usr/lib/tmpfiles.d/sparky-thp.conf usr/lib/udev/rules.d/60-sparky-block.rules usr/lib/udev/rules.d/70-sparky-ntsync.rules usr/lib/udev/rules.d/99-sparky-audio.rules'
+FILES='etc/security/limits.d/20-sparky-audio.conf usr/lib/modules-load.d/sparky-stereo.conf usr/lib/sysctl.d/70-sparky-stereo.conf usr/lib/systemd/zram-generator.conf.d/50-sparky-stereo.conf usr/lib/tmpfiles.d/sparky-thp.conf usr/lib/tmpfiles.d/sparky-tmp.conf usr/lib/udev/rules.d/60-sparky-block.rules usr/lib/udev/rules.d/70-sparky-ntsync.rules usr/lib/udev/rules.d/99-sparky-audio.rules'
 mkdir -p "$OUT"
 WORK=$(mktemp -d "$OUT/.kernel-settings.XXXXXX")
 trap 'rm -rf "$WORK"' EXIT
@@ -34,6 +34,28 @@ Description: Kernel tunables for Sparky Stereo OS
   where the hardware needs it.
 EOT
 printf '%s\n' /etc/security/limits.d/20-sparky-audio.conf >"$D/DEBIAN/conffiles"
+cat >"$D/DEBIAN/postinst" <<'EOT'
+#!/bin/sh
+set -e
+# /tmp on disk (Daniel), the way Debian's trixie release notes describe it (5.1.6: systemctl mask tmp.mount, then reboot).
+# Once, when this version first arrives; an administrator's own tmp.mount is left alone, and unmasking it is respected.
+if [ "$1" = configure ] && dpkg --compare-versions "${2:-0}" lt 20261010.2~sparky9~0 && [ ! -e /etc/systemd/system/tmp.mount ]; then
+	systemctl mask tmp.mount >/dev/null 2>&1 || ln -s /dev/null /etc/systemd/system/tmp.mount
+	mkdir -p /var/lib/sparky-stereo-kernel-settings
+	: >/var/lib/sparky-stereo-kernel-settings/tmp-mount-masked
+fi
+EOT
+cat >"$D/DEBIAN/postrm" <<'EOT'
+#!/bin/sh
+set -e
+if [ "$1" = purge ] && [ -e /var/lib/sparky-stereo-kernel-settings/tmp-mount-masked ]; then
+	if [ "$(readlink /etc/systemd/system/tmp.mount 2>/dev/null)" = /dev/null ]; then
+		rm -f /etc/systemd/system/tmp.mount
+	fi
+	rm -rf /var/lib/sparky-stereo-kernel-settings
+fi
+EOT
+chmod 755 "$D/DEBIAN/postinst" "$D/DEBIAN/postrm"
 (cd "$D" && find etc usr -type f -print0 | sort -z | xargs -0 md5sum >DEBIAN/md5sums)
 dpkg-deb --root-owner-group -Zxz -b "$D" "$OUT/${PACKAGE}_${VERSION}_all.deb"
 
diff --git a/sparky-os/packages/sparky-stereo-kernel-settings/tests/tmp-on-disk-test.sh b/sparky-os/packages/sparky-stereo-kernel-settings/tests/tmp-on-disk-test.sh
new file mode 100755
index 0000000..2c7aab1
--- /dev/null
+++ b/sparky-os/packages/sparky-stereo-kernel-settings/tests/tmp-on-disk-test.sh
@@ -0,0 +1,58 @@
+#!/bin/bash
+# Created by Daniel Ramos (Capitain Jack) 2026/10/10
+# Copyright 2026 under the GNU GPL3 License
+# Last update 2026/10/10
+#
+# /tmp on disk, as root in a disposable container: the package's maintainer
+# scripts (DEB = the built package) mask tmp.mount once and leave an
+# administrator's choice alone; systemd-tmpfiles applies the package's
+# D line before systemd's own tmp.conf and so empties /tmp at boot.
+set -u
+DEB=${DEB:?built package}
+OUT=${OUT:?results folder}
+mkdir -p "$OUT"
+W=$(mktemp -d)
+PASS=0 FAIL=0
+check() {
+	if [[ $2 == "$3" ]]; then echo "PASS $1"; PASS=$((PASS + 1)); else echo "FAIL $1: got '$2', expected '$3'"; FAIL=$((FAIL + 1)); fi
+}
+dpkg-deb -e "$DEB" "$W/control"
+dpkg-deb -x "$DEB" "$W/data"
+unit=/etc/systemd/system/tmp.mount
+mark=/var/lib/sparky-stereo-kernel-settings/tmp-mount-masked
+rm -f "$unit" "$mark"
+
+sh "$W/control/postinst" configure ""
+check fresh-install-masks "$(readlink "$unit")" /dev/null
+check fresh-install-marks "$([ -e $mark ] && echo yes)" yes
+systemctl unmask tmp.mount >/dev/null 2>&1 || rm -f "$unit"
+sh "$W/control/postinst" configure 20261010.2~sparky9~0
+check upgrade-keeps-unmask "$(readlink "$unit" || echo none)" none
+rm -f "$unit" "$mark"
+printf '[Mount]\nWhat=tmpfs\n' >"$unit"
+sh "$W/control/postinst" configure 20261010.1~sparky9~0
+check admin-unit-untouched "$(head -1 "$unit")" "[Mount]"
+check admin-unit-no-mark "$([ -e $mark ] && echo yes || echo no)" no
+rm -f "$unit"
+sh "$W/control/postinst" configure 20261010.1~sparky9~0
+check upgrade-from-older-masks "$(readlink "$unit")" /dev/null
+sh "$W/control/postrm" purge
+check purge-removes-own-mask "$(readlink "$unit" || echo none)" none
+
+# systemd-tmpfiles at boot on a fixture root: Debian's tmp.conf (systemd 262: "Q /tmp 1777 root root 10d") alone keeps
+# /tmp's files; with the package's sparky-tmp.conf, the boot run empties /tmp.
+boot() {
+	local root=$W/root-$1
+	mkdir -p "$root/usr/lib/tmpfiles.d" "$root/tmp"
+	cp /usr/lib/tmpfiles.d/tmp.conf "$root/usr/lib/tmpfiles.d/tmp.conf"
+	[[ $1 == package ]] && cp "$W/data/usr/lib/tmpfiles.d/sparky-tmp.conf" "$root/usr/lib/tmpfiles.d/"
+	echo left >"$root/tmp/from-last-boot"
+	systemd-tmpfiles --root="$root" --create --remove --boot >"$OUT/tmpfiles-$1.log" 2>&1
+	[[ -e $root/tmp/from-last-boot ]] && echo kept || echo removed
+}
+check control-debian-tmp-conf-keeps-files "$(boot debian)" kept
+check package-empties-tmp-at-boot "$(boot package)" removed
+grep -h "^[^#]" /usr/lib/tmpfiles.d/tmp.conf "$W/data/usr/lib/tmpfiles.d/sparky-tmp.conf" >"$OUT/tmpfiles-lines.txt"
+echo "SUMMARY: $PASS passed, $FAIL failed" | tee "$OUT/summary.txt"
+chown -R "${OWNER:-1000:1000}" "$OUT"
+((FAIL == 0))
diff --git a/sparky-os/packages/sparky-stereo-kernel-settings/usr/lib/tmpfiles.d/sparky-tmp.conf b/sparky-os/packages/sparky-stereo-kernel-settings/usr/lib/tmpfiles.d/sparky-tmp.conf
new file mode 100644
index 0000000..f61c8af
--- /dev/null
+++ b/sparky-os/packages/sparky-stereo-kernel-settings/usr/lib/tmpfiles.d/sparky-tmp.conf
@@ -0,0 +1,5 @@
+# Sparky Stereo OS: /tmp on disk (Daniel), cleaned at every boot as Debian's default was before trixie and of files
+# unused for 10 days as it is now (Debian trixie release notes 5.1.6 and 5.2.1). The package masks tmp.mount once.
+# This file sorts before systemd's tmp.conf, so its line is the one applied (tmpfiles.d(5)); override it with
+# /etc/tmpfiles.d/sparky-tmp.conf.
+D /tmp 1777 root root 10d
