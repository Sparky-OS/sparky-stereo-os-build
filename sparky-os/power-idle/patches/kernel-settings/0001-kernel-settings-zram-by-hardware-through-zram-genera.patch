--- /dev/null
+++ b/sparky-os/packages/sparky-stereo-kernel-settings/tests/guest/anon-dump.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: 2026 Daniel Ramos (Capitain Jack)
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Guest only, root: copy the resident anonymous memory of one user's
+processes (the pages zram would hold) into OUT, up to LIMIT MiB.
+
+anon-dump.py UID OUT LIMIT_MIB
+"""
+import os
+import sys
+
+uid, out, limit = int(sys.argv[1]), sys.argv[2], int(sys.argv[3]) << 20
+page = os.sysconf("SC_PAGE_SIZE")
+written = 0
+with open(out, "wb") as target:
+    for pid in sorted(int(name) for name in os.listdir("/proc") if name.isdigit()):
+        try:
+            if os.stat(f"/proc/{pid}").st_uid != uid:
+                continue
+            maps = open(f"/proc/{pid}/maps").read().splitlines()
+            memory = os.open(f"/proc/{pid}/mem", os.O_RDONLY)
+            pagemap = os.open(f"/proc/{pid}/pagemap", os.O_RDONLY)
+        except OSError:
+            continue
+        for line in maps:
+            fields = line.split()
+            if "w" not in fields[1] or (len(fields) > 5 and not fields[5].startswith("[heap")):
+                continue
+            start, end = (int(value, 16) for value in fields[0].split("-"))
+            for address in range(start, end, page):
+                if written >= limit:
+                    break
+                entry = int.from_bytes(os.pread(pagemap, 8, address // page * 8), "little")
+                if not entry & (1 << 63):
+                    continue
+                try:
+                    data = os.pread(memory, page, address)
+                except OSError:
+                    continue
+                target.write(data)
+                written += len(data)
+        os.close(memory)
+        os.close(pagemap)
+print(written)
diff --git a/sparky-os/packages/sparky-stereo-kernel-settings/tests/guest/zram-algorithms.sh b/sparky-os/packages/sparky-stereo-kernel-settings/tests/guest/zram-algorithms.sh
new file mode 100755
index 0000000..c3ba617
--- /dev/null
+++ b/sparky-os/packages/sparky-stereo-kernel-settings/tests/guest/zram-algorithms.sh
@@ -0,0 +1,51 @@
+#!/bin/bash
+# Created by Daniel Ramos (Capitain Jack) 2026/10/10
+# Copyright 2026 under the GNU GPL3 License
+# Last update 2026/10/10
+#
+# Guest only, root: compress the same real anonymous memory with each zram
+# algorithm (a fresh zram device each, written and read back with direct
+# I/O, so the kernel compresses in dd's own context) and report CPU time per
+# page and the compression ratio from mm_stat.
+#   zram-algorithms.sh UID LIMIT_MIB [algorithms...]
+set -u
+export LC_ALL=C
+uid=$1 limit=$2
+shift 2
+algorithms=${*:-lz4 zstd}
+here=$(cd "$(dirname "$0")" && pwd)
+data=/dev/shm/anon.img
+bytes=$(python3 "$here/anon-dump.py" "$uid" "$data" "$limit")
+pages=$((bytes / 4096))
+mhz=$(awk -F: '/^cpu MHz/ { print int($2); exit }' /proc/cpuinfo)
+model=$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo)
+echo "{\"pages\": $pages, \"cpu\": \"$model\", \"cpu_mhz\": $mhz, \"results\": ["
+first=1
+TIMEFORMAT='%3R %3U %3S'
+for algorithm in $algorithms; do
+	for run in 1 2 3; do
+		id=$(cat /sys/class/zram-control/hot_add)
+		dev=/sys/block/zram$id
+		if ! echo "$algorithm" >$dev/comp_algorithm; then
+			echo "$id" >/sys/class/zram-control/hot_remove
+			echo "no $algorithm in this kernel" >&2
+			continue
+		fi
+		echo $((bytes + (64 << 20))) >$dev/disksize
+		write=$( { time dd if=$data of=/dev/zram$id bs=1M oflag=direct status=none; } 2>&1)
+		read -r orig compr used _ _ same _ <$dev/mm_stat
+		read_back=$( { time dd if=/dev/zram$id of=/dev/null bs=1M iflag=direct status=none; } 2>&1)
+		echo 1 >$dev/reset
+		echo "$id" >/sys/class/zram-control/hot_remove
+		set -- $write
+		wsys=$3 wreal=$1
+		set -- $read_back
+		rsys=$3 rreal=$1
+		((first)) || echo ","
+		first=0
+		printf '{"algorithm": "%s", "run": %d, "write_real_s": %s, "write_sys_s": %s, "read_real_s": %s, "read_sys_s": %s, "orig_bytes": %s, "compr_bytes": %s, "mem_used_bytes": %s, "same_pages": %s}' \
+			"$algorithm" "$run" "$wreal" "$wsys" "$rreal" "$rsys" "$orig" "$compr" "$used" "$same"
+	done
+done
+echo "]}"
+rm -f $data
diff --git a/sparky-os/packages/sparky-stereo-kernel-settings/tests/guest/zram-pressure.sh b/sparky-os/packages/sparky-stereo-kernel-settings/tests/guest/zram-pressure.sh
new file mode 100755
index 0000000..5e94ff0
--- /dev/null
+++ b/sparky-os/packages/sparky-stereo-kernel-settings/tests/guest/zram-pressure.sh
@@ -0,0 +1,45 @@
+#!/bin/bash
+# Created by Daniel Ramos (Capitain Jack) 2026/10/10
+# Copyright 2026 under the GNU GPL3 License
+# Last update 2026/10/10
+#
+# Guest only, as root, on a 4 GB machine where Automatic switched zram on,
+# swappiness 1, no other swap: grow compressible memory 1.5 GiB past what is
+# available. With zram the allocation completes and zram holds the excess;
+# the control (zram switched off) reaches the OOM killer.
+#   zram-pressure.sh MEMGROW OUT
+set -u
+memgrow=$1 out=$2
+shift 2
+mkdir -p "$out"
+run() {
+	local name=$1 since avail status
+	since=$(date '+%F %T')
+	avail=$(awk '$1 == "MemAvailable:" { print int($2 / 1024) }' /proc/meminfo)
+	systemd-run --scope -q --slice=system.slice python3 "$memgrow" 256 $((avail + 1536)) 5 mixed >"$out/$name.grow" 2>&1 &
+	local pid=$! peak=0
+	while kill -0 $pid 2>/dev/null; do
+		read -r orig compr used _ </sys/block/zram0/mm_stat 2>/dev/null || orig=0
+		((orig > peak)) && peak=$orig
+		sleep 0.5
+	done
+	wait $pid
+	status=$?
+	printf '{"run": "%s", "swappiness": %s, "start_avail_mib": %s, "target_mib": %s, "allocator_status": %s, "reached": %s, "zram_peak_orig_bytes": %s, "oom_kills": %s}\n' \
+		"$name" "$(cat /proc/sys/vm/swappiness)" "$avail" $((avail + 1536)) "$status" \
+		"$(grep -q reached "$out/$name.grow" && echo true || echo false)" "$peak" \
+		"$(journalctl -q -k --since "$since" --no-pager | grep -c 'Killed process')"
+}
+sync; sleep 3
+[[ ${1:-} == --control-only ]] || run zram-on
+for try in 1 2 3 4 5 6; do
+	sleep 5
+	swapoff /dev/zram0 && break
+done
+if grep -q /dev/zram0 /proc/swaps; then
+	echo '{"run": "control-zram-off", "error": "zram could not be switched off"}'
+	exit 1
+fi
+sync; sleep 3
+run control-zram-off
+swapon -p 100 /dev/zram0
