+++ b/po/de/kcm_powerdevilprofilesconfig.po
@@ -1141,3 +1141,13 @@ msgstr "Benutzerdefinierte Dauer"
 
 #~ msgid "Edit Profile"
 #~ msgstr "Profil bearbeiten"
+
+#: kcm/ui/GlobalConfig.qml:429
+msgctxt "@text:button Name of KCM"
+msgid "Graphics"
+msgstr "Grafik"
+
+#: kcm/ui/GlobalConfig.qml:430
+#, kde-format
+msgid "Open \"Graphics\" settings page"
+msgstr "Einstellungsseite „Grafik“ öffnen"
