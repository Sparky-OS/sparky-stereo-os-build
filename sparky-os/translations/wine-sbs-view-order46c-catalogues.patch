diff --git a/po/es.po b/po/es.po
--- /dev/null
+++ b/po/es.po
@@ -0,0 +1,22 @@
+msgid ""
+msgstr ""
+"Project-Id-Version: wine-sbs-view (Sparky Stereo OS)\n"
+"PO-Revision-Date: 2026-11-20 21:30+0000\n"
+"Language-Team: es\n"
+"Language: es\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+msgid "Select a visible image window with even width and the display depth.\n"
+msgstr "Seleccione una ventana de imagen visible con ancho par y la profundidad de color de la pantalla.\n"
+
+msgid "Stereo SBS image"
+msgstr "Imagen SBS estereoscópica"
+
+msgid "Stereo declaration version 6, Composite and Damage are required.\n"
+msgstr "Se requieren la declaración estereoscópica versión 6, Composite y Damage.\n"
+
+msgid "Usage: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelect a full side by side image window with the left eye first and no controls.\n"
+msgstr "Uso: wine-sbs-view X11_IMAGE_WINDOW_ID\nSeleccione una ventana de imagen en lado a lado completo, con el ojo izquierdo primero y sin controles.\n"
diff --git a/Makefile b/Makefile
index d31b8969..17936ad3 100644
