+# Plasma Keyboard's strings in Japanese, begun by Sparky Stereo OS for Plasma Keyboard as Fcitx 5's keyboard (row 71).
+# This file is distributed under the same license as the plasma-keyboard package.
+msgid ""
+msgstr ""
+"Project-Id-Version: plasma-keyboard\n"
+"Report-Msgid-Bugs-To: https://bugs.kde.org\n"
+"PO-Revision-Date: 2026-11-25 00:00+0000\n"
+"Last-Translator: Sparky Stereo OS\n"
+"Language-Team: Japanese\n"
+"Language: ja\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=1; plural=0;\n"
+
+# Sparky Stereo OS: Plasma Keyboard as Fcitx 5's keyboard (row 71); a first draft with AI assistance
+#, kde-format
+msgctxt "@info:status"
+msgid "Fcitx 5 does not answer. The keys type plain text, without conversion."
+msgstr "Fcitx 5 が応答しません。キーは変換せずにそのまま入力します。"
+
+#, kde-format
+msgctxt "@info:status"
+msgid "Another program is already the on-screen keyboard of Fcitx 5."
+msgstr "別のプログラムがすでに Fcitx 5 のスクリーンキーボードになっています。"
+
+#, kde-format
+msgctxt "@info:tooltip"
+msgid "Input method: touch to choose another"
+msgstr "入力メソッド：タッチして別のものを選択"
+
+#, kde-format
+msgctxt "@action:button"
+msgid "Previous candidates"
+msgstr "前の候補"
+
+#, kde-format
+msgctxt "@action:button"
+msgid "Next candidates"
+msgstr "次の候補"
+
+#, kde-format
+msgctxt "@info"
+msgid "Types the keys of the on-screen keyboard while Fcitx 5 does not answer"
+msgstr "Fcitx 5 が応答しない間、スクリーンキーボードのキーを入力します"
+
+#, kde-format
+msgctxt "@info:shell"
+msgid "Run as the on-screen keyboard of Fcitx 5, when Fcitx 5 is KWin's input method"
+msgstr "Fcitx 5 が KWin の入力メソッドのとき、Fcitx 5 のスクリーンキーボードとして実行します"
