diff --git a/debian/direct-wifi-translations/es/krdp-direct-wifi.po b/debian/direct-wifi-translations/es/krdp-direct-wifi.po
new file mode 100644
--- /dev/null
+++ b/debian/direct-wifi-translations/es/krdp-direct-wifi.po
@@ -0,0 +1,80 @@
+msgid ""
+msgstr ""
+"Project-Id-Version: krdp\n"
+"PO-Revision-Date: 2026-11-20 00:00+0000\n"
+"Last-Translator: Sparky Stereo OS\n"
+"Language-Team: Sparky Stereo OS\n"
+"Language: es\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+msgid "Connect"
+msgstr "Conectar"
+
+msgid "Connecting… Accept the Wi-Fi Direct invitation on your phone."
+msgstr "Conectando… Acepte la invitación de Wi-Fi Direct en el teléfono."
+
+msgid "Direct Wi-Fi connected. Approve the phone in Throw, then choose what to share."
+msgstr "Wi-Fi Direct conectado. Autorice el teléfono en Lanzar y elija qué compartir."
+
+msgid "Direct Wi-Fi stopped."
+msgstr "Se ha detenido Wi-Fi Direct."
+
+msgid "Direct Wi-Fi: %1"
+msgstr "Wi-Fi Direct: %1"
+
+msgid "Direct connection ended. Start on the phone and scan again."
+msgstr "La conexión directa ha terminado. Iníciela en el teléfono y vuelva a buscar."
+
+msgid "Direct pairing failed before an IP address was assigned. Check the phone invitation, then scan again."
+msgstr "El emparejamiento directo ha fallado antes de que se asignara una dirección IP. Compruebe la invitación en el teléfono y vuelva a buscar."
+
+msgid "Disconnect and quit"
+msgstr "Desconectar y salir"
+
+msgid "Looking for a Wi-Fi Direct adapter…"
+msgstr "Buscando un adaptador de Wi-Fi Direct…"
+
+msgid "No Wi-Fi Direct adapter found. Check that Wi-Fi is enabled."
+msgstr "No se ha encontrado un adaptador de Wi-Fi Direct. Compruebe que la Wi-Fi está activada."
+
+msgid "No phones found yet."
+msgstr "Aún no se ha encontrado ningún teléfono."
+
+msgid "On your phone, open Flat Headset, choose Direct Wi-Fi to computer, and start waiting. Then scan and select your phone here."
+msgstr "En el teléfono, abra Flat Headset, elija Wi-Fi Direct al equipo y active la espera. Después, busque y seleccione aquí el teléfono."
+
+msgid "Refresh"
+msgstr "Actualizar"
+
+msgid "Scan"
+msgstr "Buscar"
+
+msgid "Scan finished. Select your phone, or scan again."
+msgstr "Búsqueda terminada. Seleccione el teléfono o vuelva a buscar."
+
+msgid "Scanning for phones…"
+msgstr "Buscando teléfonos…"
+
+msgid "Show connection"
+msgstr "Mostrar la conexión"
+
+msgid "Start Direct Wi-Fi in Flat Headset on your phone, then scan here."
+msgstr "Inicie Wi-Fi Direct en Flat Headset en el teléfono y luego busque aquí."
+
+msgid "Starting scan…"
+msgstr "Iniciando la búsqueda…"
+
+msgid "Stop"
+msgstr "Detener"
+
+msgid "This adapter is busy or unavailable. Finish its other direct connection first."
+msgstr "El adaptador está ocupado o no está disponible. Termine primero la otra conexión directa."
+
+msgid "Throw via Direct Wi-Fi"
+msgstr "Lanzar por Wi-Fi Direct"
+
+msgid "Wi-Fi adapter"
+msgstr "Adaptador Wi-Fi"
