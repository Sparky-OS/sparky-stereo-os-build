diff --git a/po/de/dolphin.po b/po/de/dolphin.po
--- a/po/de/dolphin.po
+++ b/po/de/dolphin.po
@@ -9310,3 +9310,84 @@
 #~ msgctxt "@item:inrange Size"
 #~ msgid "Large"
 #~ msgstr "Groß"
+
+msgid "Activate the pane of a split view under the mouse pointer"
+msgstr "Teilansicht unter dem Mauszeiger aktivieren"
+
+msgid "Background of the inactive pane of a split view"
+msgstr "Hintergrund der inaktiven Teilansicht"
+
+msgid "Show previews of stereo files in 3D on stereo screens"
+msgstr "Vorschauen von Stereodateien auf Stereobildschirmen in 3D anzeigen"
+
+msgctxt "@action:button"
+msgid "Run in a terminal"
+msgstr "Im Terminal ausführen"
+
+msgctxt "@action:inmenu"
+msgid "Format…"
+msgstr "Formatieren…"
+
+msgctxt "@action:inmenu"
+msgid "Run in a terminal…"
+msgstr "Im Terminal ausführen…"
+
+msgctxt "@action:inmenu"
+msgid "Swap Eyes"
+msgstr "Linkes und rechtes Auge vertauschen"
+
+msgctxt "@info"
+msgid "<para><emphasis>Opaque</emphasis> keeps both panes solid, whichever is active.</para><para><emphasis>Translucent</emphasis> lets what is behind the window show through the inactive pane, on either side; the active pane stays solid.</para>"
+msgstr "<para><emphasis>Deckend</emphasis> hält beide Teilansichten undurchsichtig, unabhängig davon, welche aktiv ist.</para><para><emphasis>Durchscheinend</emphasis> lässt den Hintergrund des Fensters durch die inaktive Teilansicht scheinen. Die aktive bleibt undurchsichtig.</para>"
+
+msgctxt "@info"
+msgid "<para>Stereo pictures and videos hold a view for each eye.</para><para><emphasis>As 3D</emphasis> shows each eye its own view on a stereo screen; <emphasis>Flat</emphasis> shows the left view. Screens that are not stereo always show it flat.</para>"
+msgstr "<para>Stereobilder und -videos enthalten eine Ansicht pro Auge.</para><para><emphasis>In 3D</emphasis> zeigt jedem Auge seine Ansicht auf einem Stereobildschirm. <emphasis>Flach</emphasis> zeigt die linke Ansicht. Andere Bildschirme zeigen stets die flache Ansicht.</para>"
+
+msgctxt "@info"
+msgid "<para>The pane under the mouse pointer becomes the active one without a click, after the delay the window focus waits in the window behavior settings.</para><para>Fewer clicks and less mouse travel mean less strain from repeated movements (repetitive strain injury), and mouse buttons that last longer, so less electronic waste. It may also help in VR and headset views.</para>"
+msgstr "<para>Die Teilansicht unter dem Mauszeiger wird ohne Klick aktiv, sobald die in den Fenstereinstellungen festgelegte Wartezeit für den Fokus abgelaufen ist.</para><para>Weniger Klicks und Mausbewegungen können die Belastung durch wiederholte Bewegungen verringern und Maustasten länger haltbar machen. Dadurch fällt weniger Elektroschrott an. Das kann auch in VR und bei der Anzeige im Headset helfen.</para>"
+
+msgctxt "@info"
+msgid "Inactive pane background"
+msgstr "Hintergrund der inaktiven Teilansicht"
+
+msgctxt "@info"
+msgid "Show each eye the other view of the selected stereo files"
+msgstr "Jedem Auge die andere Ansicht der ausgewählten Stereodateien zeigen"
+
+msgctxt "@info"
+msgid "The eyes of <filename>%1</filename> cannot be swapped: its file system keeps no extended attributes."
+msgstr "Die Augenansichten von <filename>%1</filename> können nicht vertauscht werden. Das Dateisystem speichert keine erweiterten Attribute."
+
+msgctxt "@info:whatsthis"
+msgid "A stereo picture or video holds a view for each eye. When a file has them the wrong way round, this swaps them, and the file keeps the correction."
+msgstr "Ein Stereobild oder -video enthält eine Ansicht pro Auge. Sind sie in einer Datei vertauscht, korrigiert diese Aktion die Reihenfolge und speichert die Korrektur für die Datei."
+
+msgctxt "@item:inlistbox Inactive pane background"
+msgid "Opaque"
+msgstr "Deckend"
+
+msgctxt "@item:inlistbox Inactive pane background"
+msgid "Translucent"
+msgstr "Durchscheinend"
+
+msgctxt "@item:inlistbox Preview stereo files"
+msgid "As 3D"
+msgstr "In 3D"
+
+msgctxt "@item:inlistbox Preview stereo files"
+msgid "Flat"
+msgstr "Flach"
+
+msgctxt "@label:listbox"
+msgid "Preview stereo files:"
+msgstr "Vorschau von Stereodateien:"
+
+msgctxt "@option:check Split view"
+msgid "Activate the pane under the mouse pointer"
+msgstr "Teilansicht unter dem Mauszeiger aktivieren"
+
+msgctxt "@title:window"
+msgid "Run in a terminal"
+msgstr "Im Terminal ausführen"
