diff --git a/debian/direct-wifi-translations/pl/krdp-direct-wifi.po b/debian/direct-wifi-translations/pl/krdp-direct-wifi.po
--- a/debian/direct-wifi-translations/pl/krdp-direct-wifi.po
+++ b/debian/direct-wifi-translations/pl/krdp-direct-wifi.po
@@ -3,7 +3,7 @@
 msgstr "Project-Id-Version: krdp-direct-wifi\nLanguage: pl\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"
 
 msgid "Throw via Direct Wi-Fi"
-msgstr "Throw przez bezpośrednie Wi-Fi"
+msgstr "Throw (przerzucić) przez bezpośrednie Wi-Fi"
 
 msgid "On your phone, open Flat Headset, choose Direct Wi-Fi to computer, and start waiting. Then scan and select your phone here."
 msgstr "Na telefonie otwórz Flat Headset, wybierz bezpośrednie Wi-Fi do komputera i rozpocznij oczekiwanie. Następnie wyszukaj i wybierz telefon tutaj."
@@ -54,7 +54,7 @@
 msgstr "Łączenie… Zaakceptuj zaproszenie Wi-Fi Direct na telefonie."
 
 msgid "Direct Wi-Fi connected. Approve the phone in Throw, then choose what to share."
-msgstr "Połączono przez bezpośrednie Wi-Fi. Zatwierdź telefon w Throw i wybierz, co udostępnić."
+msgstr "Połączono przez bezpośrednie Wi-Fi. Zatwierdź telefon w funkcji Throw (przerzucić), a potem wybierz, co udostępnić."
 
 msgid "Direct connection ended. Start on the phone and scan again."
 msgstr "Połączenie bezpośrednie zakończone. Uruchom na telefonie i wyszukaj ponownie."
