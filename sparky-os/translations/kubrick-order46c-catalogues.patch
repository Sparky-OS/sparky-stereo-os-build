diff --git a/po/es/kubrick.po b/po/es/kubrick.po
--- a/po/es/kubrick.po
+++ b/po/es/kubrick.po
@@ -1037,3 +1037,20 @@
 #, kde-format
 msgid "Author"
 msgstr "Autor"
+
+msgid "Distance between the two eyes in stereo 3D, in percent of the distance to the cubes (default 5)"
+msgstr "Distancia entre los dos ojos en 3D estereoscópico, en porcentaje de la distancia a los cubos (predeterminado: 5)"
+
+msgid "Show the cubes in stereo 3D (needs a stereo-capable display)"
+msgstr "Mostrar los cubos en 3D estereoscópico (requiere una pantalla con capacidad estereoscópica)"
+
+msgid "The cubes are shown in stereo 3D the next time Kubrick starts"
+msgstr "Los cubos se mostrarán en 3D estereoscópico la próxima vez que se inicie Kubrick"
+
+msgctxt "@info:tooltip"
+msgid "Show the cubes in stereo 3D, or flat"
+msgstr "Mostrar los cubos en 3D estereoscópico o en plano"
+
+msgctxt "@option:check"
+msgid "&Stereo 3D"
+msgstr "&3D estereoscópico"
