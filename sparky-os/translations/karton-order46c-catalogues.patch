+msgid ""
+msgstr ""
+"Project-Id-Version: karton (Sparky Stereo OS)\n"
+"PO-Revision-Date: 2026-11-20 21:30+0000\n"
+"Language-Team: es\n"
+"Language: es\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+msgid "The graphics card did not hand over the picture. Close this window and open the viewer again. If the picture is still missing, send in the Karton log lines about the GL scanout."
+msgstr "La tarjeta gráfica no entregó la imagen. Cierre esta ventana y vuelva a abrir el visor. Si el problema continúa, envíe las líneas del registro de Karton sobre la salida directa de GL."
+
+msgid "The picture of the virtual machine cannot be shown here."
+msgstr "No se puede mostrar aquí la imagen de la máquina virtual."
+
+msgid "This window cannot take the picture from the graphics card. Use the Wayland session, and start Karton without forcing it to run on X11."
+msgstr "Esta ventana no puede obtener la imagen de la tarjeta gráfica. Use una sesión de Wayland e inicie Karton sin forzar X11."
