diff --git a/po/de/stereo-create.po b/po/de/stereo-create.po
--- /dev/null
+++ b/po/de/stereo-create.po
@@ -0,0 +1,198 @@
+msgid ""
+msgstr ""
+"Project-Id-Version: stereo-create (Sparky Stereo OS)\n"
+"PO-Revision-Date: 2026-11-20 21:30+0000\n"
+"Language-Team: de\n"
+"Language: de\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Amber/Blue Anaglyph"
+msgstr "Bernsteinblau-Anaglyphe"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Frame as JPS"
+msgstr "Einzelbild als JPS"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Frame as MPO"
+msgstr "Einzelbild als MPO"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Frame as Red/Cyan Anaglyph"
+msgstr "Einzelbild als Rot-Cyan-Anaglyphe"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Full Side by Side Video (MKV)"
+msgstr "Video nebeneinander in voller Breite (MKV)"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Green/Magenta Anaglyph"
+msgstr "Grün-Magenta-Anaglyphe"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Half Side by Side Video for 3D TVs (MKV)"
+msgstr "Video nebeneinander in halber Breite für 3D-Fernseher (MKV)"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "JPS (cross view)"
+msgstr "JPS (Kreuzblick)"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "MPO"
+msgstr "MPO"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "PNS (cross view)"
+msgstr "PNS (Kreuzblick)"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Proof Pair (MPO and Red/Cyan Anaglyph)"
+msgstr "Prüfpaar (MPO und Rot-Cyan-Anaglyphe)"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Red/Cyan Anaglyph Video"
+msgstr "Rot-Cyan-Anaglyphenvideo"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Red/Cyan Anaglyph for CRT Screens"
+msgstr "Rot-Cyan-Anaglyphe für Röhrenbildschirme"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Red/Cyan Anaglyph"
+msgstr "Rot-Cyan-Anaglyphe"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Side by Side PNG"
+msgstr "PNG nebeneinander"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Side by Side Video (MP4)"
+msgstr "Video nebeneinander (MP4)"
+
+msgctxt "@action:inmenu Create stereo"
+msgid "Top and Bottom Video for 3D TVs (MKV)"
+msgstr "Video übereinander für 3D-Fernseher (MKV)"
+
+msgctxt "@action:inmenu"
+msgid "Create Stereo"
+msgstr "Stereo erstellen"
+
+msgctxt "@info %1 is a file format, %2 an error message"
+msgid "Cannot write %1: %2"
+msgstr "%1 kann nicht geschrieben werden: %2"
+
+msgctxt "@info %1 is a file name, %2 an error message"
+msgid "%1: %2"
+msgstr "%1: %2"
+
+msgctxt "@info %1 is a file name, %2 an error message"
+msgid "Cannot save %1: %2"
+msgstr "%1 kann nicht gespeichert werden: %2"
+
+msgctxt "@info %1 is a program"
+msgid "Cannot start %1."
+msgstr "%1 kann nicht gestartet werden."
+
+msgctxt "@info %1 is a program, %2 its message"
+msgid "%1 failed: %2"
+msgstr "%1 ist fehlgeschlagen: %2"
+
+msgctxt "@info %1 is an error message"
+msgid "FFmpeg failed: %1"
+msgstr "FFmpeg ist fehlgeschlagen: %1"
+
+msgctxt "@info"
+msgid "An anaglyph needs a video in standard dynamic range; this one is HDR."
+msgstr "Für eine Anaglyphe ist ein Video mit Standarddynamikumfang erforderlich. Dieses Video ist HDR."
+
+msgctxt "@info"
+msgid "Makes stereo pictures and videos in other stereo formats."
+msgstr "Erstellt Stereobilder und -videos in anderen Stereoformaten."
+
+msgctxt "@info"
+msgid "No frame could be read at that time."
+msgstr "Zu diesem Zeitpunkt konnte kein Einzelbild gelesen werden."
+
+msgctxt "@info"
+msgid "Not a stereo picture or video."
+msgstr "Kein Stereobild oder -video."
+
+msgctxt "@info"
+msgid "Sparky Stereo OS, Daniel Ramos's edition of SparkyLinux (by Paweł \"pavroo\" Pijanowski)"
+msgstr "Sparky Stereo OS, Daniel Ramos’ Ausgabe von SparkyLinux (von Paweł „pavroo“ Pijanowski)"
+
+msgctxt "@info"
+msgid "The JPS writer gave no JPEG data."
+msgstr "Der JPS-Schreiber hat keine JPEG-Daten geliefert."
+
+msgctxt "@info"
+msgid "The stereo-create program cannot be started."
+msgstr "Das Programm stereo-create kann nicht gestartet werden."
+
+msgctxt "@info"
+msgid "The video has no frame rate to keep."
+msgstr "Die Bildrate des Videos ist nicht verfügbar."
+
+msgctxt "@info"
+msgid "The views of the picture cannot be read."
+msgstr "Die Ansichten des Bildes können nicht gelesen werden."
+
+msgctxt "@info"
+msgid "This is made from a picture, not a video."
+msgstr "Diese Ausgabe wird aus einem Bild erzeugt."
+
+msgctxt "@info"
+msgid "This is made from a video, not a picture."
+msgstr "Diese Ausgabe wird aus einem Video erzeugt."
+
+msgctxt "@info"
+msgid "This stereo packing cannot be converted yet."
+msgstr "Dieses Stereoformat kann noch nicht umgewandelt werden."
+
+msgctxt "@info:shell %1 is a list of names"
+msgid "Choose what to make with --to: %1."
+msgstr "Ausgabe mit --to wählen: %1."
+
+msgctxt "@info:shell %1 is a list of names"
+msgid "What to make: one of %1."
+msgstr "Ausgabeformat: eines von %1."
+
+msgctxt "@info:shell"
+msgid "Do not show the progress in the notification area."
+msgstr "Fortschritt nicht im Benachrichtigungsbereich anzeigen."
+
+msgctxt "@info:shell"
+msgid "JPEG quality, 1 to 100 (default 92)."
+msgstr "JPEG-Qualität, 1 bis 100 (Standard: 92)."
+
+msgctxt "@info:shell"
+msgid "Only tell whether each file is stereo, and how."
+msgstr "Nur prüfen, ob und in welchem Stereoformat jede Datei vorliegt."
+
+msgctxt "@info:shell"
+msgid "Stereo pictures or videos."
+msgstr "Stereobilder oder -videos."
+
+msgctxt "@info:shell"
+msgid "The time of a frame grab in seconds (default: a third of the video)."
+msgstr "Zeitpunkt für das Einzelbild in Sekunden (Standard: ein Drittel des Videos)."
+
+msgctxt "@info:shell"
+msgid "Write anaglyphs as PNG instead of JPEG."
+msgstr "Anaglyphen als PNG statt JPEG speichern."
+
+msgctxt "@label the file a stereo file is made from"
+msgid "Source"
+msgstr "Quelle"
+
+msgctxt "@title job, %1 is a kind of file such as MPO"
+msgid "Creating %1"
+msgstr "%1 wird erstellt"
+
+msgctxt "@title"
+msgid "Create Stereo"
+msgstr "Stereo erstellen"
