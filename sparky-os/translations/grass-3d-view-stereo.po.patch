--- /dev/null
+++ b/locale/po/grasswxpy_zh_TW.po
@@ -0,0 +1,39 @@
+# Traditional Chinese translation of the GRASS GIS wxGUI: the sentences Sparky Stereo OS adds.
+# This file is distributed under the same license as the GRASS GIS package.
+msgid ""
+msgstr ""
+"Project-Id-Version: grasswxpy_zh_TW\n"
+"Report-Msgid-Bugs-To: \n"
+"Language: zh_TW\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=1; plural=0;\n"
+
+#. Sparky Stereo OS: the 3D view in stereo
+msgid "Enable 3D (applies to 3D views opened afterwards)"
+msgstr "啟用 3D（套用於之後開啟的 3D 檢視）"
+
+#. Sparky Stereo OS: the 3D view in stereo
+msgid "This screen offers no quad buffer, so the 3D view stays 2D. Stereo KWin offers one only on a screen in a 3D mode."
+msgstr "此螢幕不提供 quad buffer，因此 3D 檢視維持 2D。Stereo KWin 只在處於 3D 模式的螢幕上提供 quad buffer。"
+
+#. Sparky Stereo OS: the 3D view in stereo
+msgid "3D display settings..."
+msgstr "3D 顯示設定..."
+
+#. Sparky Stereo OS: the 3D view in stereo
+msgid "Display Settings could not be opened."
+msgstr "無法開啟顯示設定。"
+
+#. Sparky Stereo OS: the 3D view in stereo
+msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
+msgstr "3D 深度：此桌面未提供深度限制，因此兩眼顯示相同的畫面"
+
+#. Sparky Stereo OS: the 3D view in stereo
+msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
+msgstr "3D 深度：桌面尚未提供深度限制，暫時兩眼顯示相同的畫面"
+
+#. Sparky Stereo OS: the 3D view in stereo
+msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
+msgstr "3D 深度：此視窗無法讀取桌面的深度限制，因此兩眼顯示相同的畫面"
