+++ b/po/de/plasma_shell_org.kde.plasma.desktop.po
@@ -1241,3 +1241,18 @@
 
 #~ msgid "Are you sure you want to delete this activity?"
 #~ msgstr "Möchten Sie diese Aktivität wirklich löschen?"
+
+#. Stereo 3D (Sparky Stereo OS), what a sunk wallpaper loses at the sides on a screen in a 3D mode
+#: contents/configuration/ConfigurationContainmentAppearance.qml
+#, kde-format
+msgctxt "@info %1 is a number of pixels, %2 how many of them at each side"
+msgid "%1 pixel of the wallpaper's width will be lost to the sunk effect, %2 at each side."
+msgid_plural "%1 pixels of the wallpaper's width will be lost to the sunk effect, %2 at each side."
+msgstr[0] "%1 Pixel der Breite des Hintergrundbilds geht durch den Absenkeffekt verloren, %2 an jeder Seite."
