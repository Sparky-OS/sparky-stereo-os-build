diff --git a/po/es/dragonplayer.po b/po/es/dragonplayer.po
--- a/po/es/dragonplayer.po
+++ b/po/es/dragonplayer.po
@@ -213,3 +213,291 @@
 msgctxt "@action:button"
 msgid "Open Video File or Network Stream"
 msgstr "Abrir archivo o transmisión de vídeo"
+
+msgctxt "@action:button 3D video input format selector"
+msgid "Input Format"
+msgstr "Formato de entrada"
+
+msgctxt "@action:button 3D video input format"
+msgid "Checkerboard"
+msgstr "Tablero de ajedrez"
+
+msgctxt "@action:button 3D video input format"
+msgid "Column Interleaved"
+msgstr "Entrelazado en columnas"
+
+msgctxt "@action:button 3D video input format"
+msgid "Frame Sequential"
+msgstr "Secuencial de fotogramas"
+
+msgctxt "@action:button 3D video input format"
+msgid "Row Interleaved"
+msgstr "Entrelazado en filas"
+
+msgctxt "@action:button 3D video input format"
+msgid "Side by Side, Full Size Views"
+msgstr "Lado a lado, vistas de tamaño completo"
+
+msgctxt "@action:button 3D video input format"
+msgid "Side by Side, Half Size Views"
+msgstr "Lado a lado, vistas de tamaño medio"
+
+msgctxt "@action:button 3D video input format"
+msgid "Side by Side, Quincunx"
+msgstr "Lado a lado, quincunce"
+
+msgctxt "@action:button 3D video input format"
+msgid "Top and Bottom, Full Size Views"
+msgstr "Arriba y abajo, vistas de tamaño completo"
+
+msgctxt "@action:button 3D video input format"
+msgid "Top and Bottom, Half Size Views"
+msgstr "Arriba y abajo, vistas de tamaño medio"
+
+msgctxt "@action:button 3D video input format, 2D plus depth with graphics over it (HDMI 1.4a)"
+msgid "Picture, Depth Map and Graphics"
+msgstr "Imagen, mapa de profundidad y gráficos"
+
+msgctxt "@action:button 3D video input format, 2D plus depth with the background it hides"
+msgid "Picture and Depth Map over a Background"
+msgstr "Imagen y mapa de profundidad sobre un fondo"
+
+msgctxt "@action:button 3D video input format, 2D plus depth"
+msgid "Depth Map above Its Picture"
+msgstr "Mapa de profundidad sobre su imagen"
+
+msgctxt "@action:button 3D video input format, 2D plus depth"
+msgid "Depth Map and Picture, Side by Side"
+msgstr "Mapa de profundidad e imagen, lado a lado"
+
+msgctxt "@action:button 3D video input format, 2D plus depth"
+msgid "Picture above Its Depth Map"
+msgstr "Imagen sobre su mapa de profundidad"
+
+msgctxt "@action:button 3D video input format, 2D plus depth: the views are drawn from the depth map"
+msgid "Picture and Depth Map, Side by Side"
+msgstr "Imagen y mapa de profundidad, lado a lado"
+
+msgctxt "@action:button 3D video input format, from what the video says"
+msgid "Automatic"
+msgstr "Automático"
+
+msgctxt "@action:button 3D video input format, green and magenta anaglyph, shown as it is"
+msgid "Anaglyph, Green and Magenta"
+msgstr "Anaglifo, verde y magenta"
+
+msgctxt "@action:button 3D video input format, red and cyan anaglyph, shown as it is"
+msgid "Anaglyph, Red and Cyan"
+msgstr "Anaglifo, rojo y cian"
+
+msgctxt "@action:button 3D video input format, the video is not 3D"
+msgid "Not 3D"
+msgstr "Sin 3D"
+
+msgctxt "@action:button 3D video, 2D plus depth: the two views are drawn from the depth map, else the picture is shown alone"
+msgid "Draw the Views from Depth Maps"
+msgstr "Dibujar las vistas a partir de mapas de profundidad"
+
+msgctxt "@action:button 3D video, the left and right views are the other way round"
+msgid "Swap Left and Right Eyes"
+msgstr "Intercambiar los ojos izquierdo y derecho"
+
+msgctxt "@action:button offers to write the 3D correction of this video into the file"
+msgid "Save the 3D Correction into the File…"
+msgstr "Guardar la corrección 3D en el archivo…"
+
+msgctxt "@action:button opens the 3D video settings"
+msgid "3D Video Settings…"
+msgstr "Configuración de vídeo 3D…"
+
+msgctxt "@action:button stereoscopic 3D view selector"
+msgid "3D Video"
+msgstr "Vídeo 3D"
+
+msgctxt "@action:button stereoscopic 3D view selector"
+msgid "Left View"
+msgstr "Vista izquierda"
+
+msgctxt "@action:button stereoscopic 3D view selector"
+msgid "Right View"
+msgstr "Vista derecha"
+
+msgctxt "@action:button stereoscopic 3D view selector, both views as the video holds them"
+msgid "Both Views, as Stored"
+msgstr "Ambas vistas, tal como están almacenadas"
+
+msgctxt "@action:button stereoscopic 3D view selector, shown in 3D by the display"
+msgid "3D"
+msgstr "3D"
+
+msgctxt "@action:button"
+msgid "Display Settings…"
+msgstr "Configuración de pantalla…"
+
+msgctxt "@info %1 a word for the problem"
+msgid "The file could not be changed (%1)."
+msgstr "No se ha podido modificar el archivo (%1)."
+
+msgctxt "@info %1 file name"
+msgid "The 3D correction is saved in the file %1. Dragon no longer keeps it for this video."
+msgstr "La corrección 3D se ha guardado en el archivo %1. Dragon ya no la conserva para este vídeo."
+
+msgctxt "@info %1 file name"
+msgid "The file %1 already says this. Dragon no longer needs to keep the correction for this video."
+msgstr "El archivo %1 ya lo indica. Dragon ya no necesita conservar la corrección para este vídeo."
+
+msgctxt "@info %1 file name"
+msgid "This changes the file %1 so that it carries the correction. Dragon then no longer keeps it for this video, and other programs show the video the same way."
+msgstr "Esto modifica el archivo %1 para que contenga la corrección. Dragon ya no la conservará para este vídeo, y otros programas mostrarán el vídeo de la misma manera."
+
+msgctxt "@info %1 is the reason the desktop gave"
+msgid "This video is shown flat: the desktop refused to show it in 3D (%1)."
+msgstr "El vídeo se muestra en plano porque el escritorio rechazó el modo 3D (%1)."
+
+msgctxt "@info %1 the input format chosen"
+msgid "Input format: %1"
+msgstr "Formato de entrada: %1"
+
+msgctxt "@info %1 what the system said"
+msgid "The file could not be written: %1"
+msgstr "No se ha podido escribir el archivo: %1"
+
+msgctxt "@info"
+msgid "This file's format has no 3D mark that Dragon writes. Matroska, WebM, MP4 and MOV files can carry the correction."
+msgstr "El formato de este archivo no tiene una marca 3D que Dragon escriba. Los archivos Matroska, WebM, MP4 y MOV pueden contener la corrección."
+
+msgctxt "@info"
+msgid "A size as large as the frame is what a file without a size says, so the shape of this video decides, and it gives the other size of views than the one you chose."
+msgstr "Un tamaño tan grande como el fotograma es lo que indica un archivo sin tamaño, así que decide la forma de este vídeo, y esta da un tamaño de vistas distinto del que eligió."
+
+msgctxt "@info"
+msgid "Half or full size views are a choice of side by side and top and bottom only."
+msgstr "El tamaño medio o completo de las vistas solo se puede elegir con lado a lado y arriba y abajo."
+
+msgctxt "@info"
+msgid "MP4 files have no field for whether the views are half or full size, and for this video the shape gives the other size than the one you chose. A Matroska (.mkv) file can carry it."
+msgstr "Los archivos MP4 no tienen un campo para indicar si las vistas son de tamaño medio o completo, y en este vídeo la forma da un tamaño distinto del que eligió. Un archivo Matroska (.mkv) puede contenerlo."
+
+msgctxt "@info"
+msgid "MP4 files have no mark for a picture packed with its depth map. A Matroska (.mkv) file can carry it."
+msgstr "Los archivos MP4 no tienen una marca para una imagen empaquetada con su mapa de profundidad. Un archivo Matroska (.mkv) puede contenerla."
+
+msgctxt "@info"
+msgid "Matroska files are changed with mkvpropedit, from the package mkvtoolnix, and it is not installed."
+msgstr "Los archivos Matroska se modifican con mkvpropedit, del paquete mkvtoolnix, y no está instalado."
+
+msgctxt "@info"
+msgid "Only a file on this computer can be changed, and this video is not one."
+msgstr "Solo se puede modificar un archivo de este equipo, y este vídeo no lo es."
+
+msgctxt "@info"
+msgid "The file did not show the layout when it was read back after writing. It was put back as it was."
+msgstr "El archivo no mostró la disposición al leerlo de nuevo tras escribirlo. Se ha restaurado a su estado anterior."
+
+msgctxt "@info"
+msgid "The file was not changed. The correction stays with this video in Dragon."
+msgstr "No se ha modificado el archivo. La corrección permanece con este vídeo en Dragon."
+
+msgctxt "@info"
+msgid "The header of the file has no room for the mark without moving the video data. Copy the streams into a new file to make room, for example with: ffmpeg -i in.mp4 -c copy out.mp4"
+msgstr "La cabecera del archivo no tiene espacio para la marca sin mover los datos de vídeo. Copie los flujos en un archivo nuevo para hacer sitio, por ejemplo con: ffmpeg -i in.mp4 -c copy out.mp4"
+
+msgctxt "@info"
+msgid "The mark for both eyes laced in one block (Matroska StereoMode 13 and 14) is true only when each block of the video holds both eyes, and the blocks of this file do not, so the mark was not written."
+msgstr "La marca de ambos ojos entrelazados en un bloque (Matroska StereoMode 13 y 14) solo es cierta cuando cada bloque del vídeo contiene ambos ojos, y los bloques de este archivo no lo hacen, por lo que no se ha escrito la marca."
+
+msgctxt "@info"
+msgid "The structure of the file could not be read."
+msgstr "No se ha podido leer la estructura del archivo."
+
+msgctxt "@info"
+msgid "The swap of left and right eyes cannot be written for this layout."
+msgstr "El intercambio de los ojos izquierdo y derecho no se puede escribir para esta disposición."
+
+msgctxt "@info"
+msgid "The swap of left and right eyes cannot be written for this layout; it stays with this video in Dragon."
+msgstr "El intercambio de los ojos izquierdo y derecho no se puede escribir para esta disposición; permanece con este vídeo en Dragon."
+
+msgctxt "@info"
+msgid "The video stream itself declares its 3D layout (frame packing), and that comes before any mark in the file, so a mark in the file would not change how the video is shown."
+msgstr "El propio flujo de vídeo declara su disposición 3D (empaquetado de fotogramas), y esta tiene prioridad sobre cualquier marca del archivo, por lo que una marca en el archivo no cambiaría cómo se muestra el vídeo."
+
+msgctxt "@info"
+msgid "The video track has more than one sample description, which the mark cannot cover."
+msgstr "La pista de vídeo tiene más de una descripción de muestra, que la marca no puede cubrir."
+
+msgctxt "@info"
+msgid "The video track that is playing could not be found in the file."
+msgstr "No se ha encontrado en el archivo la pista de vídeo que se está reproduciendo."
+
+msgctxt "@info"
+msgid "This build of Dragon cannot write the 3D correction into a file. The correction stays with this video in Dragon."
+msgstr "Esta compilación de Dragon no puede escribir la corrección 3D en un archivo. La corrección permanece con este vídeo en Dragon."
+
+msgctxt "@info"
+msgid "This file format has no mark for the chosen input format or eye order."
+msgstr "Este formato de archivo no tiene una marca para el formato de entrada o el orden de los ojos elegidos."
+
+msgctxt "@info"
+msgid "WebM files can only say mono, side by side or top and bottom, with either eye first. A Matroska (.mkv) file can carry the other layouts."
+msgstr "Los archivos WebM solo pueden indicar mono, lado a lado o arriba y abajo, con cualquiera de los dos ojos primero. Un archivo Matroska (.mkv) puede contener las demás disposiciones."
+
+msgctxt "@info:tooltip"
+msgid "For a video whose views are the wrong way round. Kept for this video; the screen's own swap is in the display settings."
+msgstr "Para un vídeo cuyas vistas están al revés. Se conserva para este vídeo; el intercambio propio de la pantalla está en la configuración de pantalla."
+
+msgctxt "@info:tooltip"
+msgid "Shows 3D videos in 3D, whatever their packing, as full side by side views for the screen's 3D mode. When off, a 3D video is shown as it is stored."
+msgstr "Muestra los vídeos 3D en 3D, sea cual sea su empaquetado, como vistas completas lado a lado para el modo 3D de la pantalla. Si está desactivado, un vídeo 3D se muestra tal como está almacenado."
+
+msgctxt "@info:tooltip"
+msgid "The screen's 3D mode is chosen in KDE's display settings."
+msgstr "El modo 3D de la pantalla se elige en la configuración de pantalla de KDE."
+
+msgctxt "@info:tooltip"
+msgid "How the video holds its views, when it does not say so or says it wrong: every packing, and the depth layouts, where the views are drawn from a depth map. Kept for this video."
+msgstr "Cómo contiene el vídeo sus vistas, cuando no lo indica o lo indica mal: todos los empaquetados y las disposiciones de profundidad, en las que las vistas se dibujan a partir de un mapa de profundidad. Se conserva para este vídeo."
+
+msgctxt "@info:tooltip"
+msgid "Writes the input format and the swap of this video into the file itself, after you confirm. The file is read back, and put back as it was if it does not show the layout."
+msgstr "Escribe el formato de entrada y el intercambio de ojos de este vídeo en el propio archivo, después de que usted lo confirme. El archivo se lee de nuevo y se restaura a su estado anterior si no muestra la disposición."
+
+msgctxt "@label"
+msgid "Screen:"
+msgstr "Pantalla:"
+
+msgctxt "@label:listbox"
+msgid "Input format:"
+msgstr "Formato de entrada:"
+
+msgctxt "@option:check"
+msgid "Enable 3D"
+msgstr "Activar 3D"
+
+msgctxt "@option:check"
+msgid "Swap left and right eyes"
+msgstr "Intercambiar los ojos izquierdo y derecho"
+
+msgctxt "@title:group"
+msgid "3D video"
+msgstr "Vídeo 3D"
+
+msgctxt "@title:group"
+msgid "This video"
+msgstr "Este vídeo"
+
+msgctxt "@title:window"
+msgid "3D Correction Saved"
+msgstr "Corrección 3D guardada"
+
+msgctxt "@title:window"
+msgid "3D Video Settings"
+msgstr "Configuración de vídeo 3D"
+
+msgctxt "@title:window"
+msgid "Save the 3D Correction into the File?"
+msgstr "¿Guardar la corrección 3D en el archivo?"
+
+msgctxt "@title:window"
+msgid "The 3D Correction Was Not Saved"
+msgstr "No se ha guardado la corrección 3D"
