+++ b/po/pl/kcm_kscreen.po
@@ -1022,3 +1022,59 @@ msgstr "Aby zmieniać układ ekranów, przeciągnij je"
 
 #~ msgid "Unify outputs"
 #~ msgstr "Połącz wyjścia"
+
+#. Virtual stereo output modes
+msgid "Anaglyph"
+msgstr "Anaglif"
+
+#. Virtual stereo output modes
+msgid "Other stereo formats"
+msgstr "Inne formaty stereoskopowe"
+
+#. Virtual stereo output modes
+msgid "Lists anaglyph modes for modern screens and CRTs after applying. Changes colours: best for viewing, renders and presentations; choose a full-colour format for colour-coded work such as CAD drawing."
+msgstr "Po zastosowaniu wyświetla tryby anaglifowe dla współczesnych ekranów i monitorów CRT. Zmienia kolory: najlepiej nadaje się do oglądania, renderów i prezentacji; do pracy z oznaczeniami kolorystycznymi, np. rysowania CAD, wybierz format zachowujący pełne kolory."
+
+#. Virtual stereo output modes
+msgid "Lists half side by side and top and bottom for displays switched to 3D by hand, plus native-resolution rows, columns and checkerboard for other stereo screens, after applying."
+msgstr "Po zastosowaniu wyświetla tryby obok siebie i góra–dół w połowie rozdzielczości dla ekranów ręcznie przełączanych na 3D oraz wiersze, kolumny i szachownicę w rozdzielczości natywnej dla innych ekranów stereoskopowych."
+
+#. Virtual stereo output modes
+msgid "%1 (3D anaglyph, modern screens)"
+msgstr "%1 (anaglif 3D, współczesne ekrany)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D anaglyph, CRT)"
+msgstr "%1 (anaglif 3D, CRT)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D side by side, turn the display's 3D on by hand)"
+msgstr "%1 (3D obok siebie, włącz 3D na ekranie ręcznie)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D top and bottom, turn the display's 3D on by hand)"
+msgstr "%1 (3D góra–dół, włącz 3D na ekranie ręcznie)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D rows, left eye first)"
+msgstr "%1 (3D wiersze, najpierw lewe oko)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D rows, right eye first)"
+msgstr "%1 (3D wiersze, najpierw prawe oko)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D columns, left eye first)"
+msgstr "%1 (3D kolumny, najpierw lewe oko)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D columns, right eye first)"
+msgstr "%1 (3D kolumny, najpierw prawe oko)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D checkerboard, left eye first)"
+msgstr "%1 (3D szachownica, najpierw lewe oko)"
+
+#. Virtual stereo output modes
+msgid "%1 (3D checkerboard, right eye first)"
+msgstr "%1 (3D szachownica, najpierw prawe oko)"
