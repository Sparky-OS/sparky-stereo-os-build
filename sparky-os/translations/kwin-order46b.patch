diff --git a/po/es/kcm_kwinstereodepth.po b/po/es/kcm_kwinstereodepth.po
new file mode 100644
--- /dev/null
+++ b/po/es/kcm_kwinstereodepth.po
@@ -0,0 +1,78 @@
+msgid ""
+msgstr ""
+"Project-Id-Version: kwin\n"
+"PO-Revision-Date: 2026-11-20 00:00+0000\n"
+"Last-Translator: Sparky Stereo OS\n"
+"Language-Team: Sparky Stereo OS\n"
+"Language: es\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+msgid "How far the desktop's effects reach while they play, in the same pixels. Effects may be bolder than where the windows sit, so these are separate. Zero keeps an effect flat on that side."
+msgstr "Hasta dónde llegan los efectos del escritorio mientras se reproducen, en los mismos píxeles. Los efectos pueden ser más atrevidos que la posición de las ventanas, por eso estos valores van aparte. Cero mantiene el efecto plano en ese lado."
+
+msgid "How far the desktop's windows and menus reach behind and in front of the screen on a display in one of its 3D modes. The values are the distance between what the two eyes see, in pixels on a screen 1920 pixels wide, and grow and shrink with the screen. Zero switches that side off."
+msgstr "Hasta dónde llegan, detrás y delante de la pantalla, las ventanas y los menús del escritorio en una pantalla en uno de sus modos 3D. Los valores son la distancia entre lo que ven los dos ojos, en píxeles sobre una pantalla de 1920 píxeles de ancho, y crecen y disminuyen con la pantalla. Cero desactiva ese lado."
+
+msgid "Inactive windows and the wallpaper sink behind the screen by up to this much. More depth: the background drifts further apart."
+msgstr "Las ventanas inactivas y el fondo de escritorio se hunden detrás de la pantalla hasta esta distancia. Más profundidad: las dos imágenes del fondo se separan más."
+
+msgid "Menus, dialogs and tooltips of the active window come forward by up to this much. More pop-out: things near the screen's edges and long reading get harder."
+msgstr "Los menús, los diálogos y las descripciones emergentes de la ventana activa avanzan hacia delante hasta esta distancia. Más efecto emergente: lo que está cerca de los bordes de la pantalla y la lectura prolongada resultan más difíciles."
+
+msgid "Menus, tooltips and notifications on a screen that shows 3D keep at least this far from the screen's edges, so a popped-out menu is never cut by the edge."
+msgstr "Los menús, las descripciones emergentes y las notificaciones de una pantalla en 3D mantienen al menos esta distancia respecto a los bordes. Así no se recorta un menú que sobresale de la pantalla."
+
+msgctxt "@info"
+msgid "Videos with pop effects are not expected to be comfortable with widgets or other things over it."
+msgstr "Es probable que los vídeos con efectos que sobresalen de la pantalla no resulten cómodos con widgets u otros elementos encima."
+
+msgctxt "@info %1 is a number of pixels, %2 how many of them at each side"
+msgid "%1 pixel of the wallpaper's width will be lost to the sunk effect, %2 at each side."
+msgid_plural "%1 pixels of the wallpaper's width will be lost to the sunk effect, %2 at each side."
+msgstr[0] "Se perderá %1 píxel del ancho del fondo de escritorio por el efecto de hundimiento, %2 a cada lado."
+msgstr[1] "Se perderán %1 píxeles del ancho del fondo de escritorio por el efecto de hundimiento, %2 a cada lado."
+
+msgctxt "@info %1 is a number of pixels, %2 how many of them at each side, %3 a screen's name"
+msgid "%3: %1 pixel of the wallpaper's width will be lost to the sunk effect, %2 at each side."
+msgid_plural "%3: %1 pixels of the wallpaper's width will be lost to the sunk effect, %2 at each side."
+msgstr[0] "%3: se perderá %1 píxel del ancho del fondo de escritorio por el efecto de hundimiento, %2 a cada lado."
+msgstr[1] "%3: se perderán %1 píxeles del ancho del fondo de escritorio por el efecto de hundimiento, %2 a cada lado."
+
+msgctxt "@label no border"
+msgid "Off"
+msgstr "Desactivado"
+
+msgctxt "@label no depth"
+msgid "Off"
+msgstr "Desactivado"
+
+msgctxt "@label no pop-out"
+msgid "Off"
+msgstr "Desactivado"
+
+msgctxt "@label pixels"
+msgid "%1 pixel"
+msgstr "%1 píxel"
+
+msgctxt "@label:slider"
+msgid "Background depth:"
+msgstr "Profundidad del fondo:"
+
+msgctxt "@label:slider"
+msgid "Effects, behind the screen:"
+msgstr "Efectos, detrás de la pantalla:"
+
+msgctxt "@label:slider"
+msgid "Effects, in front of the screen:"
+msgstr "Efectos, delante de la pantalla:"
+
+msgctxt "@label:slider"
+msgid "Pop-out:"
+msgstr "Emergente:"
+
+msgctxt "@label:slider"
+msgid "Popup border:"
+msgstr "Margen de elementos emergentes:"
