diff --git a/po/fr/kalzium.po b/po/fr/kalzium.po
--- a/po/fr/kalzium.po
+++ b/po/fr/kalzium.po
@@ -16110,3 +16110,19 @@

 #~ msgid "One Colour"
 #~ msgstr "Une couleur"
+
+# Sparky Stereo OS: the added strings
+msgid "Show the molecule viewer in stereo 3D (needs a stereo-capable display)"
+msgstr "Affiche la visionneuse de molécules en stéréo 3D (nécessite un écran prenant en charge la stéréo)"
+
+msgid "Show the molecule viewer in stereo 3D on a desktop that shows stereo content"
+msgstr "Affiche la visionneuse de molécules en stéréo 3D sur un bureau qui affiche du contenu stéréoscopique"
+
+msgid "True to show the molecules in stereo 3D, false to show them flat"
+msgstr "Vrai pour afficher les molécules en stéréo 3D, faux pour les afficher à plat"
+
+msgid "Show the molecule in stereo 3D, or flat"
+msgstr "Affiche la molécule en stéréo 3D, ou à plat"
+
+msgid "Stereo 3D"
+msgstr "Stéréo 3D"
diff --git a/po/ja/kalzium.po b/po/ja/kalzium.po
--- a/po/ja/kalzium.po
+++ b/po/ja/kalzium.po
@@ -9187,3 +9187,19 @@

 #~ msgid "This system does not support OpenGL."
 #~ msgstr "このシステムは OpenGL をサポートしていません。"
+
+# Sparky Stereo OS: the added strings
+msgid "Show the molecule viewer in stereo 3D (needs a stereo-capable display)"
+msgstr "分子ビューアーをステレオ 3D で表示します (ステレオ対応ディスプレイが必要です)"
+
+msgid "Show the molecule viewer in stereo 3D on a desktop that shows stereo content"
+msgstr "ステレオコンテンツを表示するデスクトップで、分子ビューアーをステレオ 3D で表示します"
+
+msgid "True to show the molecules in stereo 3D, false to show them flat"
+msgstr "ステレオ 3D で分子を表示する場合は true、平面で表示する場合は false"
+
+msgid "Show the molecule in stereo 3D, or flat"
+msgstr "分子をステレオ 3D または平面で表示します"
+
+msgid "Stereo 3D"
+msgstr "ステレオ 3D"


