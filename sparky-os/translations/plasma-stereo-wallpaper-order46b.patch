@@ -0,0 +1,26 @@
+msgid ""
+msgstr ""
+"Project-Id-Version: plasma-stereo-wallpaper\n"
+"PO-Revision-Date: 2026-11-20 00:00+0000\n"
+"Last-Translator: Sparky Stereo OS\n"
+"Language-Team: Sparky Stereo OS\n"
+"Language: es\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+msgid "The Stereo Image wallpaper cannot use the wallpaper you selected"
+msgstr "El fondo de escritorio Imagen estéreo no puede usar el fondo seleccionado"
+
+msgid "The Stereo Image wallpaper could not load the picture you selected"
+msgstr "El fondo de escritorio Imagen estéreo no ha podido cargar la imagen seleccionada"
+
+msgid "The file %1 could not be loaded. Your selection is kept. Choose another wallpaper in the wallpaper settings, or use the default wallpaper now."
+msgstr "No se ha podido cargar el archivo %1. Se mantiene su selección. Elija otro fondo en los ajustes del fondo de escritorio o use ahora el fondo predeterminado."
+
+msgid "The kind of source %1 is not known to the wallpaper. Your selection is kept. Choose another wallpaper in the wallpaper settings, or use the default wallpaper now."
+msgstr "El fondo de escritorio no reconoce el tipo de origen %1. Se mantiene su selección. Elija otro fondo en los ajustes del fondo de escritorio o use ahora el fondo predeterminado."
+
+msgid "Use the default wallpaper"
+msgstr "Usar el fondo predeterminado"
