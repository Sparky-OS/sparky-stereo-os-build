--- /dev/null
+++ b/po/fr/kcm_stereo3d.po
@@ -0,0 +1,62 @@
+# French translations for kcm_stereo3d package.
+# This file is put in the public domain.
+#
+msgid ""
+msgstr ""
+"Project-Id-Version: kcm_stereo3d\n"
+"Report-Msgid-Bugs-To: https://bugs.kde.org\n"
+"POT-Creation-Date: 2026-10-23 02:10+0000\n"
+"PO-Revision-Date: 2026-10-23 02:10-0300\n"
+"Last-Translator: Daniel Campos Ramos <Capitain_Jack@yahoo.com>\n"
+"Language-Team: French <kde-francophonie@kde.org>\n"
+"Language: fr\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n > 1);\n"
+
+#: kcms/stereo3d/kcm_stereo3d.json
+msgctxt "Name for kcm_stereo3d"
+msgid "Stereo 3D and Deep Colour"
+msgstr "Stéréo 3D et profondeur de couleur"
+
+#: kcms/stereo3d/kcm_stereo3d.json
+msgctxt "Description for kcm_stereo3d"
+msgid "Stereo 3D and deep colour of each display"
+msgstr "Stéréo 3D et profondeur de couleur de chaque écran"
+
+#: kcms/stereo3d/ui/main.qml:21
+msgctxt "@action:button copies all displayed text"
+msgid "Copy to Clipboard"
+msgstr "Copier dans le presse-papiers"
+
+#: kcms/stereo3d/ui/main.qml:80
+#, kde-format
+msgctxt "@label %1 is a connector name"
+msgid "%1:"
+msgstr "%1 :"
+
+#: kcms/stereo3d/ui/main.qml:87
+msgctxt "@action:button"
+msgid "Copy the look-up tag"
+msgstr "Copier l'étiquette de recherche"
+
+#: kcms/stereo3d/ui/main.qml:94
+msgctxt "@label followed by the names of two websites"
+msgid "Look up:"
+msgstr "Rechercher :"
+
+#: kcms/stereo3d/ui/main.qml:97
+msgctxt "@action:button opens a website"
+msgid "linux-hardware.org"
+msgstr "linux-hardware.org"
+
+#: kcms/stereo3d/ui/main.qml:102
+msgctxt "@action:button opens a website"
+msgid "EDID.tv"
+msgstr "EDID.tv"
+
+#: kcms/stereo3d/ui/main.qml:130
+msgctxt "@label"
+msgid "Colour profile:"
+msgstr "Profil de couleur :"
+
+#: kcms/stereo3d/ui/main.qml:136
+msgctxt "@action:button opens DisplayCAL"
+msgid "Measure this display"
+msgstr "Mesurer cet écran"
+
+#: kcms/stereo3d/ui/main.qml:143
+msgctxt "@info"
+msgid "DisplayCAL is not installed"
+msgstr "DisplayCAL n'est pas installé"
