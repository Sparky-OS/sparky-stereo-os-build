+# Korean translation of OpenSCAD: the stereo 3D view's sentences only (Sparky Stereo OS).
+# A first draft with AI assistance, pending review by native speakers.
+msgid ""
+msgstr ""
+"Project-Id-Version: OpenSCAD 2026.11\n"
+"PO-Revision-Date: 2026-11-23 06:00+0000\n"
+"Last-Translator: Daniel Ramos (Capitain Jack) <Capitain_Jack@yahoo.com>\n"
+"Language-Team: none\n"
+"Language: ko\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=1; plural=0;\n"
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "3D display settings..."
+msgstr "3D 디스플레이 설정..."
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "Display Settings could not be opened."
+msgstr "디스플레이 설정을 열 수 없습니다."
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "3D depth: this desktop offers no depth limits, so both eyes show the same picture"
+msgstr "3D 깊이: 이 데스크톱은 깊이 한계를 제공하지 않아 두 눈에 같은 화면을 보여 줍니다"
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "3D depth: the desktop has not delivered the depth limits yet, both eyes show the same picture for now"
+msgstr "3D 깊이: 데스크톱이 아직 깊이 한계를 전달하지 않아 지금은 두 눈에 같은 화면을 보여 줍니다"
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "3D depth: this window cannot read the desktop's depth limits, so both eyes show the same picture"
+msgstr "3D 깊이: 이 창은 데스크톱의 깊이 한계를 읽을 수 없어 두 눈에 같은 화면을 보여 줍니다"
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "Enable 3D (applies to new windows)"
+msgstr "3D 켜기 (새 창에 적용)"
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "This desktop offers no stereo buffers, so the 3D view stays 2D."
+msgstr "이 데스크톱은 스테레오 버퍼를 제공하지 않아 3D 보기는 2D로 유지됩니다."
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "3D: this view got no stereo buffers, so it is shown in 2D"
+msgstr "3D: 이 보기는 스테레오 버퍼를 받지 못해 2D로 표시됩니다"
+
+#: src/gui/Stereo3dView.cc src/gui/Preferences.ui
+msgid "3D depth: the depth of this view could not be read, so both eyes show the same picture"
+msgstr "3D 깊이: 이 보기의 깊이를 읽을 수 없어 두 눈에 같은 화면을 보여 줍니다"
