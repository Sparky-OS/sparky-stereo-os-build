+# Translation of kcm_kwinstereodepth.po into zh_CN.
+# The 3D Depth settings page of Sparky Stereo OS.
+msgid ""
+msgstr ""
+"Project-Id-Version: kcm_kwinstereodepth\n"
+"PO-Revision-Date: 2026-10-16 03:00-0300\n"
+"Last-Translator: Sparky Stereo OS\n"
