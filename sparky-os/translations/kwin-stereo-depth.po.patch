diff --git a/po/de/kcm_kwinstereodepth.po b/po/de/kcm_kwinstereodepth.po
--- a/po/de/kcm_kwinstereodepth.po
+++ b/po/de/kcm_kwinstereodepth.po
@@ -0,0 +1,67 @@
+# Translation of kcm_kwinstereodepth.po into de.
+# The 3D Depth settings page of Sparky Stereo OS.
+msgid ""
+msgstr ""
+"Project-Id-Version: kcm_kwinstereodepth\n"
+"PO-Revision-Date: 2026-10-16 03:00-0300\n"
+"Last-Translator: Sparky Stereo OS\n"
+"Language-Team: de\n"
+"Language: de\n"
+"MIME-Version: 1.0\n"
+"Content-Type: text/plain; charset=UTF-8\n"
+"Content-Transfer-Encoding: 8bit\n"
+"Plural-Forms: nplurals=2; plural=(n != 1);\n"
+
+#: ui/main.qml
+msgid "How far the desktop's windows and menus reach behind and in front of the screen on a display in one of its 3D modes. The values are the distance between what the two eyes see, in pixels on a screen 1920 pixels wide, and grow and shrink with the screen. Zero switches that side off."
+msgstr "Wie weit die Fenster und Menüs der Arbeitsfläche hinter und vor den Bildschirm reichen, wenn ein Anzeigegerät in einem seiner 3D-Modi läuft. Die Werte sind der Abstand zwischen dem, was die beiden Augen sehen, in Pixeln auf einem 1920 Pixel breiten Bildschirm, und wachsen und schrumpfen mit dem Bildschirm. Null schaltet diese Seite ab."
+
+#: ui/main.qml
+msgctxt "@label:slider"
+msgid "Background depth:"
+msgstr "Tiefe des Hintergrunds:"
+
+#: ui/main.qml
+msgctxt "@label no depth"
+msgid "Off"
+msgstr "Aus"
+
+#: ui/main.qml
+#, kde-format
+msgctxt "@label pixels"
+msgid "%1 pixel"
+msgid_plural "%1 pixels"
+msgstr[0] "%1 Pixel"
+msgstr[1] "%1 Pixel"
+
+#: ui/main.qml
+msgid "Inactive windows and the wallpaper sink behind the screen by up to this much. More depth: the background drifts further apart."
+msgstr "Inaktive Fenster und das Hintergrundbild sinken bis zu diesem Wert hinter den Bildschirm. Mehr Tiefe: Die beiden Bilder des Hintergrunds rücken weiter auseinander."
+
+#: ui/main.qml
+msgctxt "@label:slider"
+msgid "Pop-out:"
+msgstr "Hervortreten:"
+
+#: ui/main.qml
+msgctxt "@label no pop-out"
+msgid "Off"
+msgstr "Aus"
+
+#: ui/main.qml
+msgid "Menus, dialogs and tooltips of the active window come forward by up to this much. More pop-out: things near the screen's edges and long reading get harder."
+msgstr "Menüs, Dialoge und Kurzinfos des aktiven Fensters kommen bis zu diesem Wert nach vorn. Mehr Hervortreten: Dinge nahe den Bildschirmrändern und langes Lesen werden anstrengender."
+
+#: ui/main.qml
+msgid "How far the desktop's effects reach while they play, in the same pixels. Effects may be bolder than where the windows sit, so these are separate. Zero keeps an effect flat on that side."
+msgstr "Wie weit die Effekte der Arbeitsfläche reichen, während sie ablaufen, in denselben Pixeln. Effekte dürfen kühner sein als die Lage der Fenster, deshalb sind diese Werte getrennt. Null hält einen Effekt auf dieser Seite flach."
+
+#: ui/main.qml
+msgctxt "@label:slider"
+msgid "Effects, behind the screen:"
+msgstr "Effekte, hinter dem Bildschirm:"
+
+#: ui/main.qml
+msgctxt "@label:slider"
+msgid "Effects, in front of the screen:"
+msgstr "Effekte, vor dem Bildschirm:"
diff --git a/po/fr/kcm_kwinstereodepth.po b/po/fr/kcm_kwinstereodepth.po
