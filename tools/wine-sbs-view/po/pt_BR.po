msgid "Usage: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelect a full side by side image window with the left eye first and no controls.\n"
msgstr "Uso: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelecione uma janela de imagem lado a lado, com o olho esquerdo primeiro e sem controles.\n"

msgid "Stereo declaration version 6, Composite and Damage are required.\n"
msgstr "São necessários a declaração estéreo versão 6, Composite e Damage.\n"

msgid "Select a visible image window with even width and the display depth.\n"
msgstr "Selecione uma janela de imagem visível com largura par e a profundidade da tela.\n"

msgid "Stereo SBS image"
msgstr "Imagem estéreo SBS"
