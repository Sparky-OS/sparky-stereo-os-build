msgid "Usage: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelect a full side by side image window with the left eye first and no controls.\n"
msgstr "Usage: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelect a full side by side image window with the left eye first and no controls.\n"

msgid "Stereo declaration version 6, Composite and Damage are required.\n"
msgstr "Stereo declaration version 6, Composite and Damage are required.\n"

msgid "Select a visible image window with even width and the display depth.\n"
msgstr "Select a visible image window with even width and the display depth.\n"

msgid "Stereo SBS image"
msgstr "Stereo SBS image"
