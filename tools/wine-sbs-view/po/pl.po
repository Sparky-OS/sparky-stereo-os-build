msgid "Usage: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelect a full side by side image window with the left eye first and no controls.\n"
msgstr "Użycie: wine-sbs-view X11_IMAGE_WINDOW_ID\nWybierz okno obrazu obok siebie, z lewym okiem jako pierwszym i bez elementów sterujących.\n"

msgid "Stereo declaration version 6, Composite and Damage are required.\n"
msgstr "Wymagane są deklaracja stereo w wersji 6 oraz rozszerzenia Composite i Damage.\n"

msgid "Select a visible image window with even width and the display depth.\n"
msgstr "Wybierz widoczne okno obrazu o parzystej szerokości i głębi ekranu.\n"

msgid "Stereo SBS image"
msgstr "Obraz stereo SBS"
