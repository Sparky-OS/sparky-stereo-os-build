msgid "Usage: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelect a full side by side image window with the left eye first and no controls.\n"
msgstr ""
"Uso: wine-sbs-view X11_IMAGE_WINDOW_ID\n"
"Seleccione una ventana de imagen en lado a lado completo, con el ojo "
"izquierdo primero y sin controles.\n"

msgid "Stereo declaration version 6, Composite and Damage are required.\n"
msgstr ""
"Se requieren la declaración estereoscópica versión 6, Composite y "
"Damage.\n"

msgid "Select a visible image window with even width and the display depth.\n"
msgstr ""
"Seleccione una ventana de imagen visible con ancho par y la "
"profundidad de color de la pantalla.\n"

msgid "Stereo SBS image"
msgstr "Imagen SBS estereoscópica"
