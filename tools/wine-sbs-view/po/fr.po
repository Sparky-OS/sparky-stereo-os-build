msgid "Usage: wine-sbs-view X11_IMAGE_WINDOW_ID\nSelect a full side by side image window with the left eye first and no controls.\n"
msgstr "Utilisation : wine-sbs-view X11_IMAGE_WINDOW_ID\nSélectionnez une fenêtre d’image côte à côte, avec l’œil gauche en premier et sans commandes.\n"

msgid "Stereo declaration version 6, Composite and Damage are required.\n"
msgstr "La déclaration stéréo version 6, Composite et Damage sont nécessaires.\n"

msgid "Select a visible image window with even width and the display depth.\n"
msgstr "Sélectionnez une fenêtre d’image visible de largeur paire et de même profondeur que l’écran.\n"

msgid "Stereo SBS image"
msgstr "Image stéréo SBS"
